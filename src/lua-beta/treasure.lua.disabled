require "movement"

Treasure = { chests = {} }

package.loaded["treasure"] = Treasure


Treasure.globalPool     = {}
Treasure.playerQueues   = {}
Treasure.activeChests   = {}
Treasure.counters       = {}
Treasure.leaving        = {}
Treasure.distributionIndex = 0

local ITEM_LEVEL_RANGE    = 3

local CHEST_LIFETIME_MS   = 300000

local RECYCLE_MIN_QUALITY = 2
local QUEST_ITEM_CLASS    = 12
local BUYBACK_SLOTS       = 12
local PLAYER_EVENT_ON_SELL_ITEM = 74
local GAMEOBJECT_EVENT_ON_REMOVE = 13

function Treasure.getOnlinePlayers()
    local players = {}
    for _, player in ipairs(GetPlayersInWorld() or {}) do
        local guid = player:GetGUIDLow()
        if not player:IsBot() and not Treasure.leaving[guid] then
            players[#players + 1] = { player = player, level = player:GetLevel(), guid = guid }
        end
    end
    return players
end

function Treasure.findEligiblePlayer(itemLevel, seller)
    local eligible = {}

    for _, info in ipairs(Treasure.getOnlinePlayers()) do
        if math.abs(info.level - itemLevel) <= ITEM_LEVEL_RANGE and info.guid ~= seller then
            local queue = Treasure.playerQueues[info.guid]
            eligible[#eligible + 1] = { info = info, queueSize = queue and #queue or 0 }
        end
    end

    if #eligible == 0 then
        return nil
    end

    local minQueueSize = eligible[1].queueSize
    for _, entry in ipairs(eligible) do minQueueSize = math.min(minQueueSize, entry.queueSize) end
    local tied = {}
    for _, entry in ipairs(eligible) do
        if entry.queueSize == minQueueSize then tied[#tied + 1] = entry.info end
    end

    Treasure.distributionIndex = Treasure.distributionIndex + 1
    return tied[((Treasure.distributionIndex - 1) % #tied) + 1]
end

function Treasure.distributeToQueue(itemId, itemLevel, count, seller)
    local target = Treasure.findEligiblePlayer(itemLevel, seller)

    if not target then
        return false
    end

    local queue = Treasure.playerQueues[target.guid] or {}
    Treasure.playerQueues[target.guid] = queue
    queue[#queue + 1] = { itemId = itemId, itemLevel = itemLevel, count = count or 1, seller = seller }

    print("[Treasure] Queued item " .. itemId .. " (lvl " .. itemLevel .. ") for " .. target.player:GetName())
    return true
end

function Treasure.processGlobalPool()
    local remaining = {}

    for _, item in ipairs(Treasure.globalPool) do
        local distributed = Treasure.distributeToQueue(item.itemId, item.itemLevel, item.count, item.seller)
        if not distributed then
            table.insert(remaining, item)
        end
    end

    Treasure.globalPool = remaining

    if #remaining > 0 then
        print("[Treasure] " .. #remaining .. " items waiting in global pool (no eligible players)")
    end
end

function Treasure.addToPool(itemId, itemLevel, count, seller)
    count = count or 1
    itemLevel = itemLevel or 1

    local distributed = Treasure.distributeToQueue(itemId, itemLevel, count, seller)

    if not distributed then
        table.insert(Treasure.globalPool, {
            itemId    = itemId,
            itemLevel = itemLevel,
            count     = count,
            seller    = seller,
        })
        print("[Treasure] Item " .. itemId .. " (lvl " .. itemLevel .. ") added to global pool (no eligible players)")
    end
end

function Treasure.getPlayerQueue(playerGUID)
    local queue = Treasure.playerQueues[playerGUID] or {}
    Treasure.playerQueues[playerGUID] = {}
    return queue
end

function Treasure.returnToPool(chestGUID)
    local chestData = Treasure.activeChests[chestGUID]
    if not chestData or not chestData.queueItems then
        return
    end

    local returned = 0
    for _, item in ipairs(chestData.queueItems) do
        Treasure.addToPool(item.itemId, item.itemLevel, item.count, item.seller)
        returned = returned + 1
    end

    if returned > 0 then
        print("[Treasure] Returned " .. returned .. " items from despawned chest to pool")
    end

    if ObjectVariables and ObjectVariables.cleanupGameObjectByLocation then
        ObjectVariables.cleanupGameObjectByLocation(
            chestData.mapId,
            chestData.instanceId,
            chestGUID
        )
    end

    Treasure.activeChests[chestGUID] = nil
end

function Treasure.onChestRemove(_event, chest)
    if Treasure.activeChests[chest:GetGUIDLow()] then
        Treasure.returnToPool(chest:GetGUIDLow())
    end
end

function Treasure.expireChest(_eventId, _delay, _repeats, chest)
    chest:RemoveFromWorld(false)
end


