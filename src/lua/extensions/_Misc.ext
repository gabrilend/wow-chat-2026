-- filename.ext files are loaded before normal .lua files

-- Issue 332 Debug: Test if print works at script load time
print("[_Misc.ext] Script loading - print test at " .. os.date())
print("[_Misc.ext] type(print) = " .. type(print))

-- Randomize random
math.randomseed(tonumber(tostring(os.time()):reverse():sub(1,6)))

