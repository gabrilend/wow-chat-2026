Buddies.CloseFollow.InCombat = 0

#    Buddies.ForwardPass
#        Read in buddies_forward_pass.cpp, buddies_talents.cpp (int32).
#        Switch: Buddies.ForwardPass (0 off, the default; 1 on), read each time.
#        Default: 0

Buddies.ForwardPass = 0

#    Buddies.ForwardPass.Replay
#        Read in buddies_forward_pass.cpp (int32).
#        Buddies.ForwardPass.Replay: 1 writes each party's fights down
#        Default: 0

Buddies.ForwardPass.Replay = 0

#    Buddies.ForwardPass.Threads
#        Read in buddies_forward_pass.cpp (int32).
#        Buddies.ForwardPass.Threads: how many worker threads (default 2), read
#        Default: 2

Buddies.ForwardPass.Threads = 2

#    Buddies.MapStream.Port
#        Read in buddies_map_stream.cpp (int32).
#        Default: DEFAULT_PORT

Buddies.MapStream.Port = DEFAULT_PORT

#    Buddies.PaintDir
#        Read in buddies_path.cpp (std::string).
#        Buddies.PaintDir, else "buddy-paint/realm-<RealmID>" beside the server
#        Default: 

Buddies.PaintDir = 

#    Buddies.Sidestep
#        Read in buddies_sidestep.cpp (int32).
#        Switch: Buddies.Sidestep (0 off, the default; 1 a share of the circle,
#        Default: 0

Buddies.Sidestep = 0

#    Buddies.TalentWeights
#        Read in buddies_talents.cpp (int32).
#        Default: 0

Buddies.TalentWeights = 0

#    Buddies.TalentWeights.Broad
#        Read in buddies_talents.cpp (int32).
#        Default: 100

Buddies.TalentWeights.Broad = 100

