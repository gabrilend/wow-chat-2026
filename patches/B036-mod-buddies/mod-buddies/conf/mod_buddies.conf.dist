# mod_buddies.conf.dist - GENERATED by scripts/generate-buddies-conf from the buddy module's sources:
# every setting it reads, at its default, with the notes beside it in the code. Don't edit; change the
# code and run it again. The server's build installs it beside the other modules' settings; set a value
# in mod_buddies.conf (or worldserver.conf) to change it.

[worldserver]

#    Buddies.AlteracWeather
#        Read in buddies_weather.cpp (int32).
#        Switch: Buddies.AlteracWeather (0 off, the default; 1 on), read each pass.
#        Default: 0

Buddies.AlteracWeather = 0

#    Buddies.CloseFollow.InCombat
#        Read in buddies_follow.cpp (int32).
#        Buddies.CloseFollow.InCombat at 1) while the leader fights. A ring
