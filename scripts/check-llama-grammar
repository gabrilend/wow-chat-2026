#!/usr/bin/env luajit

local DIR       = arg[1] or "/mnt/kaun/wow-chat-2026"
local LLAMA_DIR = arg[2] or "/home/ritz/programming/ai-stuff/neocities-modernization/libs/llama.cpp"
local MODEL     = arg[3] or "/home/ritz/programming/ai-stuff/neocities-modernization/assets/models/nomic-embed-text-v1.5.Q8_0.gguf"

local ffi = require("ffi")

ffi.cdef[[
typedef struct llama_model   llama_model;
typedef struct llama_vocab   llama_vocab;
typedef struct llama_sampler llama_sampler;
typedef bool (*llama_progress_callback)(float progress, void * user_data);
struct llama_model_params {
    void *        devices;
    const void *  tensor_buft_overrides;
    int32_t       n_gpu_layers;
    int32_t       split_mode;
    int32_t       load_mode;
    int32_t       lazy_mode;
    int32_t       main_gpu;
    const float * tensor_split;
    llama_progress_callback progress_callback;
    void *        progress_callback_user_data;
    const void *  kv_overrides;
    bool vocab_only;
    bool check_tensors;
    bool use_extra_bufts;
    bool no_host;
    bool no_alloc;
    bool load_mtp;
};
void                      llama_backend_init(void);
void                      llama_backend_free(void);
struct llama_model_params llama_model_default_params(void);
llama_model *             llama_model_load_from_file(const char * path, struct llama_model_params params);
void                      llama_model_free(llama_model * model);
const llama_vocab *       llama_model_get_vocab(const llama_model * model);
llama_sampler *           llama_sampler_init_grammar(const llama_vocab * vocab, const char * grammar_str, const char * grammar_root);
void                      llama_sampler_free(llama_sampler * smpl);
]]

local function quoted_alternatives(names)
    local parts = {}
    for i, name in ipairs(names) do parts[i] = '"\\"' .. name .. '\\""' end
    return table.concat(parts, " | ")
end

local GUIDANCE = [[
root       ::= "{" ws "\"party_intent\":" ws sentence "," ws "\"directives\":" ws "[" ws ( directive ( "," ws directive )* )? "]" ws "}"
directive  ::= "{" ws "\"bot\":" ws bot "," ws "\"strategies_add\":" ws strategies "," ws "\"strategies_remove\":" ws strategies "," ws "\"multiplier_overrides\":" ws overrides "," ws "\"focus\":" ws ( target | "null" ) "," ws "\"stance\":" ws stance ws "}" ws
strategies ::= "[" ws ( strategy ( "," ws strategy )* )? "]" ws
overrides  ::= "{" ws ( override ( "," ws override )* )? "}" ws
override   ::= action ":" ws multiplier ws
multiplier ::= [01] "." [0-9] | "2.0"
sentence   ::= "\"" [^"\\\n]{1,120} "\""
stance     ::= "\"front_line\"" | "\"back_line\"" | "\"flanking\"" | "\"follow_tank\""
strategy   ::= ]] .. quoted_alternatives({ "tank", "heal", "dps", "dps aoe", "cc" }) .. "\n" .. [[
action     ::= ]] .. quoted_alternatives({ "melee", "heal party member", "taunt" }) .. "\n" .. [[
bot        ::= ]] .. quoted_alternatives({ "Tankzilla", "Lumen", "Brisk" }) .. "\n" .. [[
target     ::= ]] .. quoted_alternatives({ "Tankzilla", "Lumen", "Brisk", "Gnoll Brute" }) .. "\n" .. [[
ws         ::= [ \t\n]{0,4}
]]

local CHAT = 'root ::= [A-Z] [^\\n".!?\\[\\]()<>]{0,180} [.!?]\n'

local function bare_alternatives(names)
    local parts = {}
    for i, name in ipairs(names) do parts[i] = '"' .. name .. '"' end
    return table.concat(parts, " | ")
end
local COMMANDS = 'root    ::= line ( "\\n" line ){0,5}\n' ..
                 'line    ::= "/p " command | "/w " bot " " command\n' ..
                 'command ::= ' .. bare_alternatives({ "maintenance", "follow", "stay", "attack", "co +dps aoe" }) .. '\n' ..
                 'bot     ::= ' .. bare_alternatives({ "Tankzilla", "Lumen", "Brisk" }) .. '\n'

local CASES = {
    { "guidance (916h step 6)",      GUIDANCE,                               true  },
    { "chat line (916l)",            CHAT,                                   true  },
    { "bot commands (917c)",         COMMANDS,                               true  },
    { "undefined rule",              'root ::= "{" missing-rule "}"\n',      false },
    { "underscore in a rule name",   'root ::= a_b\na_b ::= "x"\n',          false },
}

local lib = ffi.load(LLAMA_DIR .. "/lib/libllama.so")
lib.llama_backend_init()

local params      = lib.llama_model_default_params()
params.vocab_only = true
local model       = lib.llama_model_load_from_file(MODEL, params)
if model == nil then
    io.stderr:write("check-llama-grammar: the library loaded from " .. LLAMA_DIR ..
        "/lib, but it could not read the model's word list from " .. MODEL ..
        " (does the file exist and is it a .gguf?). No grammar was checked.\n")
    os.exit(1)
end
local vocab = lib.llama_model_get_vocab(model)

local lines, failures = {}, 0
for _, case in ipairs(CASES) do
    local name, text, want = case[1], case[2], case[3]
    local sampler = lib.llama_sampler_init_grammar(vocab, text, "root")
    local got     = sampler ~= nil
    if got then lib.llama_sampler_free(sampler) end
    if got ~= want then failures = failures + 1 end
    lines[#lines + 1] = string.format("  %-28s parsed=%-5s expected=%-5s %s",
        name, tostring(got), tostring(want), got == want and "ok" or "FAIL")
end

lib.llama_model_free(model)
lib.llama_backend_free()

print("check-llama-grammar (" .. DIR .. ")")
print(table.concat(lines, "\n"))
print(string.format("%d of %d cases as expected", #CASES - failures, #CASES))
os.exit(failures == 0 and 0 or 1)
