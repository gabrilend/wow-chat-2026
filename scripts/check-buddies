#!/usr/bin/env luajit

local DIR, OWNER = "/mnt/kaun/wow-chat-2026", nil
do
    local i = 1
    while i <= #arg do
        if arg[i] == "--owner" then i = i + 1; OWNER = arg[i] else DIR = arg[i] end
        i = i + 1
    end
end
local PROFILE = io.open(DIR .. "/.profile"):read("*l")
local CHARS, WORLD = "acore_characters_" .. PROFILE, "acore_world_" .. PROFILE
local MYSQL = DIR .. "/mysql/installed-files/bin/mysql --defaults-file=" .. DIR .. "/mysql/conf/client.cnf --socket=" .. DIR ..
              "/mysql/databases/mysql.sock -N -B "

local function rows(db, sql)
    local f = os.tmpname()
    local h = assert(io.open(f, "w")); h:write(sql); h:close()
    local p = io.popen(MYSQL .. db .. " < " .. f .. " 2>&1; echo __status $?")
    local out = {}
    for line in p:lines() do
        if line:match("^__status ") then
            if line ~= "__status 0" then error("query failed: " .. sql) end
        elseif not line:find("Using a password", 1, true) then
            local r = {}
            for field in (line .. "\t"):gmatch("([^\t]*)\t") do r[#r + 1] = field end
            if line:match("^ERROR") then error(line .. " in: " .. sql) end
            out[#out + 1] = r
        end
    end
    p:close(); os.remove(f)
    return out
end

local TANKS   = { [1] = true, [2] = true, [6] = true, [11] = true }
local HEALERS = { [2] = true, [5] = true, [7] = true, [11] = true }
local SIDE = { [1] = 1, [3] = 1, [4] = 1, [7] = 1, [11] = 1, [2] = 2, [5] = 2, [6] = 2, [8] = 2, [10] = 2 }
local WEAPON_SKILLS = "43, 44, 45, 46, 54, 55, 95, 118, 136, 160, 162, 172, 173, 176, 226, 228, 229, 473"
local ARMOUR = { [0] = "head", [2] = "shoulders", [4] = "chest", [5] = "waist", [6] = "legs", [7] = "feet",
                 [8] = "wrists", [9] = "hands", [14] = "back" }
local JEWELLERY = { [1] = "necklace", [10] = "ring", [11] = "ring", [12] = "trinket", [13] = "trinket" }

local function u32(s, at) local a, b, c, d = s:byte(at, at + 3); return a + b * 256 + c * 65536 + d * 16777216 end
local GEM_ENCHANT = {}
do
    local f = io.open(DIR .. "/data-files/dbc/GemProperties.dbc", "rb")
    if f then
        local d = f:read("*a"); f:close()
        local n, size = u32(d, 5), u32(d, 13)
        for i = 0, n - 1 do local at = 21 + i * size; GEM_ENCHANT[u32(d, at)] = u32(d, at + 4) end
    end
end
local TEST_ENCHANTS = {}
for _, r in ipairs(rows(WORLD, "SELECT GemProperties FROM item_template WHERE class = 3 AND GemProperties > 0 AND (name LIKE 'Test %' OR name LIKE '% Test %' OR name LIKE '%[PH]%')")) do
    local e = GEM_ENCHANT[tonumber(r[1])]
    if e then TEST_ENCHANTS[e] = true end
end

local where = OWNER and string.format(" AND o.name = '%s'", OWNER:gsub("[^%a]", "")) or ""
local buddies = rows(CHARS, [[
SELECT c.guid, c.name, c.class, c.race, c.level, r.class, r.profile, r.role, r.stage, o.name, o.level
  FROM buddy_roster r JOIN characters c ON c.guid = r.buddy JOIN characters o ON o.guid = r.owner
 WHERE r.buddy <> 0]] .. where .. " ORDER BY o.name, r.slot")

local broken, total = 0, 0
for _, b in ipairs(buddies) do
    local guid, name, class, race, level = b[1], b[2], tonumber(b[3]), tonumber(b[4]), tonumber(b[5])
    local rclass, plan, role, stage, owner, olevel = tonumber(b[6]), tonumber(b[7]), tonumber(b[8]), tonumber(b[9]), b[10], tonumber(b[11])
    local problems = {}
    local function bad(rule, text) problems[#problems + 1] = rule .. " " .. text end
    total = total + 1

    if rclass ~= class then bad("1 class:", "the roster says class " .. rclass .. ", the character is class " .. class) end
    if not plan or plan < 1 or plan > 10 then bad("2 plan:", "talent plan " .. tostring(plan) .. " (1-10)") end
    if role == 1 and not TANKS[class] then bad("2 role:", "a tank, and class " .. class .. " has no tank tree") end
    if role == 2 and not HEALERS[class] then bad("2 role:", "a healer, and class " .. class .. " cannot heal") end
    if stage == 0 and level > olevel then bad("3 level:", string.format("level %d with its owner (level %d)", level, olevel)) end

    local low = {}
    for _, s in ipairs(rows(CHARS, "SELECT skill, value, max FROM character_skills WHERE guid = " .. guid .. " AND skill IN (" .. WEAPON_SKILLS .. ") AND value < max")) do
        low[#low + 1] = s[1] .. " at " .. s[2] .. "/" .. s[3]
    end
    if #low > 0 then bad("5 skills:", table.concat(low, ", ")) end

    local worn = {}
    for _, w in ipairs(rows(CHARS, [[
SELECT ci.slot, ii.itemEntry, it.name, it.class, it.subclass, it.FlagsExtra, ii.enchantments,
       (it.socketColor_1 > 0) + (it.socketColor_2 > 0) + (it.socketColor_3 > 0)
  FROM character_inventory ci JOIN item_instance ii ON ii.guid = ci.item
  JOIN ]] .. WORLD .. [[.item_template it ON it.entry = ii.itemEntry
 WHERE ci.guid = ]] .. guid .. " AND ci.bag = 0 AND ci.slot < 23")) do
        worn[tonumber(w[1])] = { entry = w[2], name = w[3], class = tonumber(w[4]), sub = tonumber(w[5]), flags = tonumber(w[6]),
                                 ench = w[7], sockets = tonumber(w[8]) }
    end

    local tier = 1
    for _, t in ipairs({ 10, 20, 30, 40, 50, 60 }) do if level >= t then tier = t end end
    local empty = {}
    for _, r in ipairs(rows(WORLD, string.format([[
SELECT g.slot FROM gearset_item g WHERE g.profile = 'buddy-white-%d' AND g.key1 = %d
   AND g.key2 = (SELECT MAX(key2) FROM gearset_item WHERE profile = 'buddy-white-%d' AND key1 = %d AND key2 <= %d)]],
        tier, class * 100 + (plan or 0), tier, class * 100 + (plan or 0), level))) do
        local slot = tonumber(r[1])
        if ARMOUR[slot] and not worn[slot] then empty[#empty + 1] = ARMOUR[slot] end
    end
    table.sort(empty)
    if #empty > 0 then bad("7 armour:", "nothing on " .. table.concat(empty, ", ") .. " (its kit fills them)") end

    local mh = worn[15]
    local function weapon(w) return w and w.class == 2 and w.sub ~= 20 and w.sub ~= 14 end
    if not weapon(mh) then
        local carried = rows(CHARS, "SELECT COUNT(*) FROM character_inventory ci JOIN item_instance ii ON ii.guid = ci.item JOIN " .. WORLD ..
            ".item_template it ON it.entry = ii.itemEntry WHERE ci.guid = " .. guid .. " AND (ci.bag <> 0 OR ci.slot >= 23)" ..
            " AND it.class = 2 AND it.subclass NOT IN (14, 20)")
        if tonumber(carried[1][1]) == 0 then
            bad("8 weapon:", (mh and ("its main hand holds " .. mh.name .. ", and it carries") or "nothing in its main hand, and it carries") .. " no weapon")
        end
    end

    if level >= 18 then
        local missing = {}
        for slot, label in pairs(JEWELLERY) do if not worn[slot] then missing[#missing + 1] = label .. " (slot " .. slot .. ")" end end
        if #missing > 0 then table.sort(missing); bad("10 jewellery:", "no " .. table.concat(missing, ", ")) end
        for slot in pairs(JEWELLERY) do
            local w = worn[slot]
            local side = SIDE[race]
            if w and ((w.flags % 2 == 1 and side ~= 2) or (math.floor(w.flags / 2) % 2 == 1 and side ~= 1)) then
                bad("10 jewellery:", w.name .. " is the other side's")
            end
        end
        if worn[10] and worn[11] and worn[10].entry == worn[11].entry then
            bad("10 jewellery:", "the same " .. worn[10].name .. " on both fingers")
        end
    end

    for slot, w in pairs(worn) do
        if w.sockets and w.sockets > 0 then
            local n = {}
            for v in w.ench:gmatch("%d+") do n[#n + 1] = tonumber(v) end
            for s = 1, w.sockets do
                local id = n[4 + s * 3] or 0
                if id == 0 then bad("11 gems:", w.name .. " has an empty socket")
                elseif TEST_ENCHANTS[id] then bad("11 gems:", w.name .. " holds a test gem (enchantment " .. id .. ")") end
            end
        end
    end

    if class == 4 and level >= 20 then
        local p = rows(CHARS, "SELECT COUNT(*) FROM character_inventory ci JOIN item_instance ii ON ii.guid = ci.item JOIN " .. WORLD ..
                              ".item_template it ON it.entry = ii.itemEntry WHERE ci.guid = " .. guid ..
                              " AND (it.name LIKE 'Instant Poison%' OR it.name LIKE 'Deadly Poison%')")
        if tonumber(p[1][1]) == 0 then bad("12 tools:", "a rogue with no poisons") end
    end
    if class == 3 and worn[17] and worn[17].class == 2 then
        local wants = (worn[17].sub == 3) and 3 or ((worn[17].sub == 2 or worn[17].sub == 18) and 2 or nil)
        if wants then
            local has, wrong = false, nil
            for slot = 19, 22 do
                local w = worn[slot]
                if w and w.class == 11 then
                    if w.sub == wants then has = true else wrong = w.name end
                end
            end
            if not has then
                bad("12 tools:", "no " .. (wants == 3 and "ammo pouch" or "quiver") .. " for its " .. worn[17].name ..
                    (wrong and (" (it wears " .. wrong .. ", the other kind)") or ""))
            end
        end
    end

    local bags = 0
    for slot = 19, 22 do if worn[slot] then bags = bags + 1 end end

    local head = string.format("%-10s %-10s class %2d level %2d plan %2s role %s stage %d bags %d", owner, name, class, level,
        tostring(plan), tostring(role), stage, bags)
    if #problems == 0 then print(head .. "  ok")
    else
        broken = broken + 1
        print(head)
        for _, p in ipairs(problems) do print("    " .. p) end
    end
end
print(string.format("check-buddies: %d of %d buddies keep every checked rule", total - broken, total))
os.exit(broken == 0 and 0 or 1)
