#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-fight-replay
# profiles:   all
# priority:   10
# kind:       test
# about:      a fight written down step by step and read back gives the same forward-pass verdicts when replayed
# quick-test: yes
# ==== end of header ====
# test-buddy-fight-replay - compiles and runs
# tests/buddy-fight-replay/replay-check.cpp against the buddy module's
# fight replays (issue 625n), with no server.
#
# Usage: scripts/test-buddy-fight-replay [DIR]   (--help: this text)

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    sed -n '10,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
DIR="${1:-/mnt/kaun/wow-chat-2026}"
OUT="${DIR}/tmp/tmp"
mkdir -p "${OUT}"
g++ -std=c++17 -O1 -Wall -Wextra -Werror -I"${DIR}/patches/B036-mod-buddies/mod-buddies/src" \
    "${DIR}/tests/buddy-fight-replay/replay-check.cpp" -o "${OUT}/buddy-fight-replay" || exit 1
nice -n 19 "${OUT}/buddy-fight-replay"
# ==== footer of test-buddy-fight-replay ====
# lines:      28
# ==== end of footer ====
