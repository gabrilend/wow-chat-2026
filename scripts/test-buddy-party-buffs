#!/usr/bin/env luajit
-- ==== header: 8 lines, footer: 3 lines ====
-- id:         test-buddy-party-buffs
-- profiles:   all
-- priority:   10
-- kind:       test
-- about:      check how a party's auras, blessings, judgements and totems
-- quick-test: yes
-- ==== end of header ====
-- test-buddy-party-buffs - check how a party's auras, blessings, judgements
-- and totems are shared out among its paladins, shamans, hunters and
-- priests (issue 617c5).
--
-- For a general audience: with several buff-givers in a party, each should
-- give something different, the party's needs should be filled most
-- needed first, and two buffs the game won't let stack (a paladin's fire
-- resistance aura and a shaman's fire resistance totem) count as one. This
-- test plays the issue's own cases (three paladins give three auras; a
-- stated wish beats a talent; Sanctuary goes to a tank first; Might never
-- to a caster; a healer low on mana gets Wisdom and goes back to Kings
-- after; two shamans never double a totem), the checklist (a resistance
-- only when its school matters, given once whoever gives it; Mana Spring
-- makes Wisdom unneeded), players planned around, judgements only of the
-- ones a paladin knows, the ways a wish is said and the sentences that are
-- not wishes, and then hundreds of random parties, each checked against a
-- referee written from the issue: every line filled that can be, in order,
-- talented givers first.
--
-- Usage: scripts/test-buddy-party-buffs [PROJECT_DIR] [RUNS]
--   RUNS  random parties (default 600)
-- Exit status 0 if all pass.

local DIR  = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end
local RUNS = tonumber(arg[2]) or 600

local Buffs = dofile(DIR .. "/src/lua-basic/lib/buddy-party-buffs.lua")

local fails, checks = {}, 0
local function check(ok, what)
    checks = checks + 1
    if not ok and #fails < 25 then fails[#fails + 1] = what end
end

-- {{{ people
local function set(...) local t = {} for _, k in ipairs({ ... }) do t[k] = true end return t end
local function merge(a, b) local t = {} for k in pairs(a) do t[k] = true end for k in pairs(b or {}) do t[k] = true end return t end
local ALL_BLESS = set("kings", "might", "wisdom")
local ALL_AURAS = set("devotion", "concentration", "retribution", "fire resistance", "frost resistance", "shadow resistance")
local ALL_JUDGE = set("judgement of light", "judgement of wisdom", "judgement of justice")
local function paladin(name, extra, improved, opts)
    local g = { name = name, class = "paladin", knows = merge(merge(merge(ALL_BLESS, ALL_AURAS), ALL_JUDGE), extra), improved = improved or {} }
    for k, v in pairs(opts or {}) do g[k] = v end
    return g
end
local TOTEMS_ALL = set("strength of earth", "stoneskin", "flametongue", "frost resistance", "searing",
                       "mana spring", "healing stream", "fire resistance", "windfury", "wrath of air",
                       "nature resistance", "grounding")
local function shaman(name, extra, improved) return { name = name, class = "shaman", knows = merge(TOTEMS_ALL, extra), improved = improved or {} } end
local function hunter(name) return { name = name, class = "hunter", knows = set("aspect of the wild"), improved = {} } end
local function priest(name) return { name = name, class = "priest", knows = set("shadow protection"), improved = {} } end
local function who(name, role, mana, extra)
    local r = { name = name, role = role, mana = mana, health = 1 }
    for k, v in pairs(extra or {}) do r[k] = v end
    return r
end
local function count(t) local n = 0 for _ in pairs(t) do n = n + 1 end return n end
local function line(plan, name) for _, l in ipairs(plan.checklist) do if l.category == name then return l end end end
-- }}}

-- {{{ the issue's own cases
do
    -- three paladins give three auras
    local p = Buffs.plan({ givers = { paladin("A"), paladin("B"), paladin("C") },
                           receivers = { who("T", "tank"), who("H", "healer", 1), who("M", "melee") } })
    local a = p.auras
    check(count(a) == 3 and a.A ~= a.B and a.B ~= a.C and a.A ~= a.C, "three paladins don't give three auras")
    check(set(a.A, a.B, a.C).devotion and set(a.A, a.B, a.C).concentration and set(a.A, a.B, a.C).retribution,
          "three paladins don't give devotion, concentration and retribution")
    for _, r in ipairs({ "T", "H", "M" }) do
        local got = {}
        for _, b in pairs(p.blessings[r]) do got[b] = (got[b] or 0) + 1 end
        for b, n in pairs(got) do check(n == 1, r .. " gets " .. b .. " twice") end
        check(count(p.blessings[r]) == 2, r .. " gets " .. count(p.blessings[r]) .. " blessings from three paladins, not the 2 it can use")
    end

    -- a stated wish beats a talent
    local sanc = paladin("S", set("sanctuary"))
    local q = Buffs.plan({ givers = { sanc }, receivers = { who("T", "tank", nil, { wish = "kings" }) } })
    check(q.blessings.T.S == "kings", "the tank's wish lost to Sanctuary: " .. tostring(q.blessings.T.S))
    -- Sanctuary goes to a tank first; never to anyone else first
    local r = Buffs.plan({ givers = { sanc }, receivers = { who("T", "tank"), who("M", "melee"), who("H", "healer", 1) } })
    check(r.blessings.T.S == "sanctuary", "the tank doesn't get Sanctuary first")
    check(r.blessings.M.S == "might" and r.blessings.H.S == "kings", "Sanctuary's paladin gives the others the wrong thing")
    -- an improved Might goes first to weapon users, never to a caster
    local imp = paladin("I", nil, set("might"))
    local s = Buffs.plan({ givers = { imp }, receivers = { who("C", "caster", 1), who("M", "melee"), who("R", "ranged", 1) } })
    check(s.blessings.C.I == "kings", "a caster got " .. tostring(s.blessings.C.I))
    check(s.blessings.M.I == "might" and s.blessings.R.I == "might", "improved Might isn't given to weapon users")
    for _, roles in ipairs({ "caster", "healer" }) do
        for n = 1, 4 do
            local gs = {}
            for k = 1, n do gs[k] = paladin("P" .. k, nil, set("might")) end
            local pl = Buffs.plan({ givers = gs, receivers = { who("X", roles, 0.9) } })
            for _, b in pairs(pl.blessings.X) do check(b ~= "might", "Might given to a " .. roles .. " by " .. n .. " paladins") end
        end
    end
    -- unless asked for
    local w = Buffs.plan({ givers = { paladin("P") }, receivers = { who("C", "caster", 1, { wish = "might" }) } })
    check(w.blessings.C.P == "might", "a caster's own wish for Might wasn't granted")
    -- of two paladins, the one whose talents improve the wished blessing gives it
    local two = Buffs.plan({ givers = { paladin("P"), paladin("Q", nil, set("wisdom")) }, receivers = { who("H", "healer", 1, { wish = "wisdom" }) } })
    check(two.blessings.H.Q == "wisdom" and two.blessings.H.P == "kings", "the talented paladin didn't place the wished Wisdom")

    -- a healer low on mana gets Wisdom, and Kings again once it has mana
    local healer = who("H", "healer", 0.2)
    local low = Buffs.plan({ givers = { paladin("P") }, receivers = { healer } })
    check(low.blessings.H.P == "wisdom", "the low-mana healer doesn't get Wisdom")
    healer.mana = 0.9
    check(Buffs.plan({ givers = { paladin("P") }, receivers = { healer } }).blessings.H.P == "kings", "the healer doesn't go back to Kings")
    healer.mana = 0.35
    check(Buffs.plan({ givers = { paladin("P") }, receivers = { healer } }).blessings.H.P == "kings", "35% mana counts as low")
    healer.mana = 0.34
    check(Buffs.plan({ givers = { paladin("P") }, receivers = { healer } }).blessings.H.P == "wisdom", "34% mana isn't low")
    check(Buffs.plan({ givers = { paladin("P") }, receivers = { who("W", "melee") } }).blessings.W.P == "might", "a warrior doesn't get Might")

    -- two shamans never double a totem, and give a mixed party both air totems
    local ts = Buffs.plan({ givers = { shaman("X"), shaman("Y") }, receivers = { who("M", "melee"), who("C", "caster", 1) } })
    for _, el in ipairs(Buffs.ELEMENTS) do
        check(ts.totems.X[el] ~= nil and ts.totems.X[el] ~= ts.totems.Y[el], "two shamans doubled or skipped " .. el)
    end
    local air = set(ts.totems.X.air, ts.totems.Y.air)
    check(air.windfury and air["wrath of air"], "a mixed party doesn't get Windfury and Wrath of Air")
    check(set(ts.totems.X.water, ts.totems.Y.water)["mana spring"], "no mana spring for a caster")
    check(set(ts.totems.X.fire, ts.totems.Y.fire).flametongue and set(ts.totems.X.fire, ts.totems.Y.fire).searing,
          "two shamans' fire totems aren't Flametongue and Searing")
    -- Totem of Wrath and Flametongue don't stack (one line): the shaman with
    -- Totem of Wrath gives it, the other something else
    local t3 = Buffs.plan({ givers = { shaman("X"), shaman("Z", set("totem of wrath")) }, receivers = { who("C", "caster", 1) } })
    check(t3.totems.Z.fire == "totem of wrath" and t3.totems.X.fire == "searing", "Totem of Wrath isn't the talented shaman's, or Flametongue doubles it")
    -- one shaman, a lone warrior: no caster totems
    local solo = Buffs.plan({ givers = { shaman("X") }, receivers = { who("W", "melee") } })
    check(solo.totems.X.earth == "strength of earth" and solo.totems.X.fire == "searing" and solo.totems.X.water == "healing stream"
          and solo.totems.X.air == "windfury", "a warrior's shaman put down the wrong totems")
end
-- }}}

-- {{{ the checklist: threats, categories across classes
do
    local party = { givers = { paladin("A"), shaman("X") }, receivers = { who("T", "tank"), who("C", "caster", 1) }, resist = { fire = true } }
    local p = Buffs.plan(party)
    local fire = (p.auras.A == "fire resistance" and 1 or 0) + (p.totems.X.water == "fire resistance" and 1 or 0)
    check(fire == 1, "fire matters: " .. fire .. " fire resistances up, wanted exactly one")
    check(p.auras.A == "devotion" and p.totems.X.water == "fire resistance", "the shaman's totem should take fire, leaving the paladin's devotion")
    check(line(p, "fire resistance").by == "X", "the checklist doesn't say the shaman gives fire resistance")
    party.resist = {}
    local q = Buffs.plan(party)
    check(q.auras.A == "devotion" and q.totems.X.water ~= "fire resistance", "a fire resistance with no fire that matters")
    check(line(q, "fire resistance") == nil, "the checklist wants fire resistance with no fire that matters")
    local g2 = Buffs.plan({ givers = { paladin("A"), paladin("B") }, receivers = party.receivers, resist = { frost = true, shadow = true } })
    check(set(g2.auras.A, g2.auras.B)["shadow resistance"] and set(g2.auras.A, g2.auras.B)["frost resistance"], "two resistances called for, not both given")
    local one = Buffs.plan({ givers = { paladin("A") }, receivers = party.receivers, resist = { frost = 0.3, shadow = 0.7 } })
    check(one.auras.A == "shadow resistance", "the school that matters more isn't first")
    local same = Buffs.plan({ givers = { paladin("A") }, receivers = party.receivers, resist = { frost = true, shadow = true } })
    check(same.auras.A == "frost resistance", "two schools that matter alike aren't taken in the list's order")
    -- against casters
    party.resist, party.enemy = {}, "casters"
    local c = Buffs.plan(party)
    check(c.auras.A == "concentration", "against casters the aura is " .. tostring(c.auras.A))
    check(c.totems.X.earth ~= "stoneskin", "Stoneskin Totem against casters")
    local cm = Buffs.plan({ givers = { shaman("X"), shaman("Y") }, receivers = { who("C", "caster", 1) }, enemy = "casters" })
    check(set(cm.totems.X.air, cm.totems.Y.air).grounding, "no grounding totem against casters")
    local nm = Buffs.plan({ givers = { shaman("X"), shaman("Y") }, receivers = { who("C", "caster", 1) } })
    check(not set(nm.totems.X.air, nm.totems.Y.air).grounding, "a grounding totem against no casters")
    -- nature: a shaman, or a hunter's aspect, whichever leaves more of the list filled
    local nz = Buffs.plan({ givers = { shaman("X") }, receivers = { who("C", "caster", 1) }, resist = { nature = true } })
    check(nz.totems.X.air == "nature resistance", "nature matters and no nature resistance totem")
    local nh = Buffs.plan({ givers = { shaman("X"), hunter("H") }, receivers = { who("M", "melee") }, resist = { nature = true } })
    check(nh.aspects.H == "aspect of the wild" and nh.totems.X.air == "windfury", "the hunter's aspect didn't take nature, leaving Windfury")
    local nn = Buffs.plan({ givers = { hunter("H") }, receivers = { who("M", "melee") } })
    check(nn.aspects.H == nil, "a hunter was given an aspect with no nature that matters")
    -- shadow: a priest's prayer, or a paladin's aura
    local sp = Buffs.plan({ givers = { paladin("A"), priest("Pr") }, receivers = { who("T", "tank") }, resist = { shadow = true } })
    check(sp.prayers.Pr == "shadow protection" and sp.auras.A == "devotion", "the priest's prayer didn't take shadow, leaving devotion")
    local fr = Buffs.plan({ givers = { shaman("X") }, receivers = { who("C", "caster", 1) }, resist = { frost = true } })
    check(fr.totems.X.fire == "frost resistance", "frost matters and no frost resistance totem")
    -- Mana Spring and Wisdom are one line: with the totem down, Wisdom isn't given unless asked for
    local ms = Buffs.plan({ givers = { paladin("P"), shaman("X") }, receivers = { who("H", "healer", 0.2) } })
    check(ms.totems.X.water == "mana spring" and ms.blessings.H.P == "kings", "Wisdom given beside Mana Spring: " .. tostring(ms.blessings.H.P))
    local mw = Buffs.plan({ givers = { paladin("P"), shaman("X") }, receivers = { who("H", "healer", 1, { wish = "wisdom" }) } })
    check(mw.blessings.H.P == "wisdom", "a wished Wisdom wasn't given beside Mana Spring")
    -- a line nobody can fill is on the checklist, missing
    local nobody = Buffs.plan({ givers = { paladin("P", nil, nil) }, receivers = { who("M", "melee") }, resist = { nature = true } })
    check(line(nobody, "nature resistance") and line(nobody, "nature resistance").by == nil, "a line nobody can fill isn't on the checklist as missing")
    check(nobody.checklist[1].category == "nature resistance", "the checklist isn't most needed first")
end
-- }}}

-- {{{ players are planned around, not planned
do
    local owner = { name = "Owner", class = "paladin", player = true, knows = merge(ALL_BLESS, ALL_AURAS),
                    gives = { aura = "devotion", blessings = { T = "kings", M = "kings" }, judgement = "light" } }
    local p = Buffs.plan({ givers = { owner, paladin("B") }, receivers = { who("T", "tank"), who("M", "melee") } })
    check(p.auras.Owner == nil and p.blessings.T.Owner == nil and p.judgements.Owner == nil, "the player was given a plan")
    check(p.auras.B ~= "devotion", "a buddy doubled the owner's devotion aura")
    check(line(p, "armor").by == "Owner", "the checklist doesn't tick off the owner's devotion")
    check(p.blessings.T.B ~= "kings" and p.blessings.M.B ~= "kings", "a buddy doubled the owner's Kings")
    check(p.blessings.M.B == "might", "the buddy didn't fill the melee's Might beside the owner's Kings")
    check(p.judgements.B == "wisdom", "the buddy's judgement doubles the owner's Light: " .. tostring(p.judgements.B))
    local sp = { name = "Sham", class = "shaman", player = true, knows = TOTEMS_ALL, gives = { air = "windfury" } }
    local q = Buffs.plan({ givers = { sp, shaman("X") }, receivers = { who("M", "melee"), who("C", "caster", 1) } })
    check(q.totems.Sham == nil and q.totems.X.air == "wrath of air", "the buddy shaman doubled the player's Windfury")
    local pm = { name = "Sham", class = "shaman", player = true, knows = TOTEMS_ALL, gives = { water = "mana spring" } }
    local r = Buffs.plan({ givers = { pm, paladin("P") }, receivers = { who("H", "healer", 0.2) } })
    check(r.blessings.H.P == "kings", "a player's Mana Spring didn't make Wisdom unneeded")
    local ph = { name = "Hunt", class = "hunter", player = true, knows = set("aspect of the wild"), gives = { aspect = "aspect of the wild" } }
    local s = Buffs.plan({ givers = { ph, shaman("X") }, receivers = { who("M", "melee") }, resist = { nature = true } })
    check(s.totems.X.air == "windfury" and line(s, "nature resistance").by == "Hunt", "a player hunter's Aspect of the Wild wasn't counted")
end
-- }}}

-- {{{ judgements, announcements, wishes
do
    local hurt = { receivers = { who("T", "tank", 0.9, { health = 0.3 }) } }
    check(Buffs.judgements(hurt)[1] == "light", "a hurt party isn't judged with Light first")
    local dry = { receivers = { who("H", "healer", 0.1, { health = 0.9 }) } }
    check(Buffs.judgements(dry)[1] == "wisdom", "a party out of mana isn't judged with Wisdom first")
    check(table.concat(Buffs.judgements(dry, { wisdom = true }), ",") == "light,justice", "a taken judgement isn't skipped")
    local four = Buffs.plan({ givers = { paladin("A"), paladin("B"), paladin("C"), paladin("D") }, receivers = dry.receivers })
    check(count(four.judgements) == 3 and set(four.judgements.A, four.judgements.B, four.judgements.C, four.judgements.D).wisdom
          and set(four.judgements.A, four.judgements.B, four.judgements.C, four.judgements.D).light
          and set(four.judgements.A, four.judgements.B, four.judgements.C, four.judgements.D).justice, "four paladins' judgements are wrong")
    -- only judgements it knows (a young paladin knows Light alone)
    local young = function(n) local g = paladin(n); g.knows["judgement of wisdom"], g.knows["judgement of justice"] = nil, nil; return g end
    local yj = Buffs.plan({ givers = { young("A"), young("B") }, receivers = dry.receivers })
    check(count(yj.judgements) == 1 and (yj.judgements.A == "light" or yj.judgements.B == "light"), "a paladin was given a judgement it doesn't know")
    local mix = Buffs.plan({ givers = { young("A"), paladin("B") }, receivers = dry.receivers })
    check(mix.judgements.A == "light" and mix.judgements.B == "wisdom", "the judgements aren't shared by what each paladin knows")

    local talk = Buffs.plan({ givers = { paladin("A", nil, set("devotion"), { aura = "retribution" }), paladin("B", nil, nil, { aura = "retribution" }) },
                              receivers = { who("T", "tank") } })
    check(talk.auras.A == "devotion" and talk.auras.B == "retribution", "the improved devotion isn't the talented paladin's")
    local said = table.concat(talk.said, "|")
    check(said:find("A: I have the improved devotion aura", 1, true) ~= nil, "the improved aura isn't announced")
    check(said:find("A: switching to devotion aura.", 1, true) ~= nil, "the switch isn't announced")
    check(not said:find("B:", 1, true), "a paladin keeping its aura said something")

    local cases = {   -- the owner's ways of saying it (2026-11-05), and sentences that are not wishes
        { "kings",                       "wish",  "kings" },
        { "Kings please",                "wish",  "kings" },
        { "can you do might instead?",   "wish",  "might" },
        { "can I get wisdom",            "wish",  "wisdom" },
        { "can I have BoW?",             "wish",  "wisdom" },
        { "could I get blessing of kings?", "wish", "kings" },
        { "might instead",               "wish",  "might" },
        { "not now, kings please",       "wish",  "kings" },
        { "no Might",                    "avoid", "might" },
        { "please don't give me sanctuary", "avoid", "sanctuary" },
        { "don’t give me might",         "avoid", "might" },
        { "anything is fine",            "clear", true },
        { "No preference.",              "clear", true },
        { "you might want to heal",      nil,     nil },
        { "I need a new bow",            nil,     nil },
        { "I need a new bow please",     nil,     nil },
        { "can I have a bow?",           nil,     nil },
        { "anything but might",          nil,     nil },
        { "no idea what kings do",       nil,     nil },
        { "who has no kings",            nil,     nil },
        { "can I get 'kings'?",          "wish",  "kings" },
        { "hello there",                 nil,     nil },
        { "kingsfoil",                   nil,     nil },
    }
    for _, c in ipairs(cases) do
        local wsh = Buffs.parse_wish(c[1])
        if c[2] then check(wsh and wsh[c[2]] == c[3], "\"" .. c[1] .. "\" heard wrong")
        else check(wsh == nil, "\"" .. c[1] .. "\" heard as a wish") end
    end
    local r = who("H", "healer", 1)
    Buffs.hear(r, Buffs.parse_wish("wisdom please"))
    check(r.wish == "wisdom", "a heard wish isn't kept")
    Buffs.hear(r, Buffs.parse_wish("no wisdom"))
    check(r.wish == nil and r.avoid.wisdom, "a no to the wished blessing didn't drop it")
    Buffs.hear(r, Buffs.parse_wish("can I get wisdom"))
    check(r.wish == "wisdom" and not r.avoid.wisdom, "a new wish didn't lift the no")
    Buffs.hear(r, Buffs.parse_wish("no kings"))
    check(r.wish == "wisdom" and r.avoid.kings, "a no to another blessing dropped the wish")
    Buffs.hear(r, Buffs.parse_wish("anything"))
    check(r.wish == nil and next(r.avoid) == nil, "clearing left something")
    Buffs.hear(r, nil)
    check(r.wish == nil, "nothing heard changed the receiver")
    local avoider = Buffs.plan({ givers = { paladin("P") }, receivers = { who("M", "melee", nil, { avoid = set("might") }) } })
    check(avoider.blessings.M.P == "kings", "a no to Might wasn't kept")
end
-- }}}

-- {{{ the referee, written from 617c5
-- The checklist's lines and who can fill them, from the issue's table (not
-- the module's): name, the school it resists or nil, the condition, and the
-- (class, slot, spell) that fill it, best first.
local LINES = {
    { "fire resistance",   "fire",   nil, { { "paladin", "aura", "fire resistance" },   { "shaman", "water", "fire resistance" } } },
    { "frost resistance",  "frost",  nil, { { "paladin", "aura", "frost resistance" },  { "shaman", "fire",  "frost resistance" } } },
    { "shadow resistance", "shadow", nil, { { "paladin", "aura", "shadow resistance" }, { "priest", "prayer", "shadow protection" } } },
    { "nature resistance", "nature", nil, { { "shaman", "air", "nature resistance" },   { "hunter", "aspect", "aspect of the wild" } } },
    { "armor",             nil, "not casters", { { "paladin", "aura", "devotion" } } },
    { "concentration",     nil, "casters",     { { "paladin", "aura", "concentration" } } },
    { "retribution",       nil, nil,           { { "paladin", "aura", "retribution" } } },
    { "strength and agility", nil, "weapons",  { { "shaman", "earth", "strength of earth" } } },
    { "stoneskin",         nil, "not casters", { { "shaman", "earth", "stoneskin" } } },
    { "spell power",       nil, "casters",     { { "shaman", "fire", "totem of wrath" }, { "shaman", "fire", "flametongue" } } },
    { "searing",           nil, nil,           { { "shaman", "fire", "searing" } } },
    { "mana regeneration", nil, "mana",        { { "shaman", "water", "mana spring" } } },
    { "healing stream",    nil, nil,           { { "shaman", "water", "healing stream" } } },
    { "melee haste",       nil, "weapons",     { { "shaman", "air", "windfury" } } },
    { "spell haste",       nil, "casters",     { { "shaman", "air", "wrath of air" } } },
    { "grounding",         nil, "vs casters",  { { "shaman", "air", "grounding" } } },
}
local SLOTS = { paladin = { "aura" }, shaman = { "earth", "fire", "water", "air" }, hunter = { "aspect" }, priest = { "prayer" } }
local function ref_lines(party)
    local roles = {}
    for _, r in ipairs(party.receivers) do roles[r.role] = true end
    local mana = false
    for _, r in ipairs(party.receivers) do if r.mana then mana = true end end
    local ok = { ["casters"] = roles.healer or roles.caster, ["weapons"] = roles.tank or roles.melee or roles.ranged,
                 ["mana"] = mana, ["not casters"] = party.enemy ~= "casters", ["vs casters"] = party.enemy == "casters" }
    local res, rest = {}, {}
    for k, l in ipairs(LINES) do
        local m = (party.resist or {})[l[2] or ""]
        if l[2] then if m then res[#res + 1] = { l, m == true and 1 or m, k } end
        elseif l[3] == nil or ok[l[3]] then rest[#rest + 1] = l end
    end
    table.sort(res, function(a, b) if a[2] ~= b[2] then return a[2] > b[2] end return a[3] < b[3] end)
    local out = {}
    for _, x in ipairs(res) do out[#out + 1] = x[1] end
    for _, l in ipairs(rest) do out[#out + 1] = l end
    return out
end
-- Whether every line in `ls` can be given at once by distinct slots
-- (`can(line)` lists the slot keys that could), by augmenting paths.
local function feasible(ls, can)
    local owner = {}
    local function try(l, seen)
        for _, s in ipairs(can(l)) do
            if not seen[s] then
                seen[s] = true
                if owner[s] == nil or try(owner[s], seen) then owner[s] = l; return true end
            end
        end
        return false
    end
    for _, l in ipairs(ls) do if not try(l, {}) then return false end end
    return true
end
-- The best score (improved, then best spells) of any way to give exactly
-- `ls`, by trying them all; nil when there are too many ways to try.
local function best_score(ls, options)
    local product = 1
    for _, l in ipairs(ls) do product = product * math.max(1, #options(l)) end
    if product > 20000 then return nil end
    local used, best = {}, nil
    local function go(k, imp, top)
        if k > #ls then
            if not best or imp > best[1] or (imp == best[1] and top > best[2]) then best = { imp, top } end
            return
        end
        for _, o in ipairs(options(ls[k])) do
            if not used[o.slot] then
                used[o.slot] = true
                go(k + 1, imp + (o.improved and 1 or 0), top + (o.best and 1 or 0))
                used[o.slot] = nil
            end
        end
    end
    go(1, 0, 0)
    return best
end
-- }}}

-- {{{ random parties against the referee
local ROLES = { "tank", "healer", "caster", "melee", "ranged" }
local AURA_NAMES = { "devotion", "concentration", "retribution", "fire resistance", "frost resistance", "shadow resistance" }
local BLESS_NAMES = { "kings", "might", "wisdom", "sanctuary" }
local JUDGE_NAMES = { "judgement of light", "judgement of wisdom", "judgement of justice" }
local TOTEM_NAMES = {}
for t in pairs(TOTEMS_ALL) do TOTEM_NAMES[#TOTEM_NAMES + 1] = t end
TOTEM_NAMES[#TOTEM_NAMES + 1] = "totem of wrath"
table.sort(TOTEM_NAMES)
local seen = { improved = 0, missing = 0, crossed = 0, scored = 0 }
for run = 1, RUNS do
    math.randomseed(run * 613 + 11)
    local R = math.random
    local function some(names, p) local t = {} for _, n in ipairs(names) do if R() < p then t[n] = true end end return t end
    local party = { givers = {}, receivers = {}, resist = {}, enemy = R(3) == 1 and "casters" or nil }
    for _, school in ipairs({ "fire", "frost", "shadow", "nature" }) do
        if R(3) == 1 then party.resist[school] = R(2) == 1 and true or R(9) / 10 end
    end
    for k = 1, R(4) - 1 do
        local g = { name = "P" .. k, class = "paladin", knows = some(BLESS_NAMES, 0.8), improved = {} }
        for a in pairs(some(AURA_NAMES, 0.8)) do g.knows[a] = true end
        for j in pairs(some(JUDGE_NAMES, 0.7)) do g.knows[j] = true end
        for b in pairs(g.knows) do if R(4) == 1 then g.improved[b] = true end end
        if R(4) == 1 then g.player = true; g.gives = { aura = AURA_NAMES[R(#AURA_NAMES)], blessings = {}, judgement = Buffs.JUDGEMENTS[R(3)] } end
        party.givers[#party.givers + 1] = g
    end
    for k = 1, R(3) - 1 do
        local g = { name = "S" .. k, class = "shaman", knows = some(TOTEM_NAMES, 0.85), improved = {} }
        for t in pairs(g.knows) do if R(5) == 1 then g.improved[t] = true end end
        if R(4) == 1 then g.player = true; g.gives = { air = "windfury", water = "mana spring" } end
        party.givers[#party.givers + 1] = g
    end
    if R(3) == 1 then
        local g = hunter("H1")
        if R(4) == 1 then g.player = true; g.gives = { aspect = "aspect of the wild" } end
        party.givers[#party.givers + 1] = g
    end
    if R(3) == 1 then party.givers[#party.givers + 1] = priest("Pr1") end
    for k = 1, R(5) do
        local role = ROLES[R(5)]
        local r = { name = "R" .. k, role = role, health = R(),
                    mana = (role == "healer" or role == "caster" or role == "ranged") and R() or nil,
                    wish = R(4) == 1 and BLESS_NAMES[R(4)] or nil, avoid = some(BLESS_NAMES, 0.1) }
        party.receivers[#party.receivers + 1] = r
        for _, g in ipairs(party.givers) do
            if g.player and g.class == "paladin" and R(2) == 1 then g.gives.blessings[r.name] = BLESS_NAMES[R(4)] end
        end
    end
    local where = "run " .. run
    local p = Buffs.plan(party)
    local players, buddies, pals = {}, {}, {}
    for _, g in ipairs(party.givers) do
        if g.player then players[#players + 1] = g else buddies[#buddies + 1] = g end
        if not g.player and g.class == "paladin" then pals[#pals + 1] = g end
    end
    for _, g in ipairs(players) do
        check(p.auras[g.name] == nil and p.judgements[g.name] == nil and p.totems[g.name] == nil and p.aspects[g.name] == nil,
              where .. ": a player was planned")
    end

    -- the party-wide lines: what the plan gives, slot by slot
    local lines = ref_lines(party)
    local held = {}
    for _, g in ipairs(players) do
        for _, slot in ipairs(SLOTS[g.class]) do
            local spell = g.gives[slot]
            for _, l in ipairs(lines) do
                for _, w in ipairs(l[4]) do if w[1] == g.class and w[2] == slot and w[3] == spell then held[l] = true end end
            end
        end
    end
    local function given(g, slot)
        if g.class == "shaman" then return p.totems[g.name] and p.totems[g.name][slot] end
        if g.class == "paladin" then return p.auras[g.name] end
        if g.class == "hunter" then return p.aspects[g.name] end
        return p.prayers[g.name]
    end
    local filled, imp, top = {}, 0, 0
    for _, g in ipairs(buddies) do
        for _, slot in ipairs(SLOTS[g.class]) do
            local spell = given(g, slot)
            if spell then
                check(g.knows[spell], where .. ": " .. g.name .. " doesn't know " .. spell)
                local hit
                for _, l in ipairs(lines) do
                    for k, w in ipairs(l[4]) do if w[1] == g.class and w[2] == slot and w[3] == spell then hit = { l, k } end end
                end
                check(hit ~= nil, where .. ": " .. g.name .. "'s " .. spell .. " fills no line the party wants")
                if hit then
                    check(not filled[hit[1]] and not held[hit[1]], where .. ": " .. hit[1][1] .. " given twice")
                    filled[hit[1]] = true
                    if g.improved[spell] then imp = imp + 1 end
                    local first = true
                    for b = 1, hit[2] - 1 do if hit[1][4][b][1] == g.class and hit[1][4][b][2] == slot then first = false end end
                    if first then top = top + 1 end
                    if hit[1][2] and g.class ~= "paladin" then seen.crossed = seen.crossed + 1 end
                end
            end
        end
    end
    -- every line that can be filled, in order: a line left missing can't be
    -- filled beside the filled lines above it
    local function can(l)
        local out = {}
        for _, g in ipairs(buddies) do
            for _, slot in ipairs(SLOTS[g.class]) do
                for _, w in ipairs(l[4]) do
                    if w[1] == g.class and w[2] == slot and g.knows[w[3]] then out[#out + 1] = g.name .. "/" .. slot; break end
                end
            end
        end
        return out
    end
    local above = {}
    for _, l in ipairs(lines) do
        if not held[l] then
            if filled[l] then above[#above + 1] = l
            else
                local try = { l }
                for _, a in ipairs(above) do try[#try + 1] = a end
                check(not feasible(try, can), where .. ": " .. l[1] .. " could be filled too, and isn't")
                seen.missing = seen.missing + 1
            end
        end
    end
    -- the checklist: every line, who gives it
    check(#p.checklist == #lines, where .. ": the checklist has " .. #p.checklist .. " lines, the referee " .. #lines)
    for k, l in ipairs(lines) do
        local c = p.checklist[k]
        check(c and c.category == l[1], where .. ": checklist line " .. k .. " is " .. tostring(c and c.category) .. ", wanted " .. l[1])
        if c then check((c.by ~= nil) == (held[l] or filled[l] or false), where .. ": checklist line " .. l[1] .. " says the wrong giver") end
    end
    -- talented givers first, then the best spells: the most of any way to give these lines
    local chosen = {}
    for _, l in ipairs(lines) do if filled[l] then chosen[#chosen + 1] = l end end
    local bs = best_score(chosen, function(l)
        local out = {}
        for _, g in ipairs(buddies) do
            for _, slot in ipairs(SLOTS[g.class]) do
                for k, w in ipairs(l[4]) do
                    if w[1] == g.class and w[2] == slot and g.knows[w[3]] then
                        local first = true
                        for b = 1, k - 1 do if l[4][b][1] == g.class and l[4][b][2] == slot then first = false end end
                        out[#out + 1] = { slot = g.name .. "/" .. slot, improved = g.improved[w[3]], best = first }
                        break
                    end
                end
            end
        end
        return out
    end)
    if bs then
        seen.scored = seen.scored + 1
        check(imp == bs[1] and top == bs[2], where .. ": " .. imp .. " improved and " .. top .. " best spells, the referee finds " .. bs[1] .. " and " .. bs[2])
        if imp > 0 then seen.improved = seen.improved + 1 end
    end

    -- blessings: valid, distinct, never a player's again, never said no to,
    -- and as many as the referee's ranked wishes allow, in order
    local mana_regen = false
    for _, l in ipairs(lines) do if l[1] == "mana regeneration" and (held[l] or filled[l]) then mana_regen = true end end
    for _, g in ipairs(players) do if g.class == "shaman" and g.gives.water == "mana spring" then mana_regen = true end end
    for _, r in ipairs(party.receivers) do
        local from_players = {}
        for _, g in ipairs(players) do local b = g.class == "paladin" and g.gives.blessings[r.name]; if b then from_players[b] = true end end
        local mine = {}
        for gname, b in pairs(p.blessings[r.name]) do
            local g
            for _, x in ipairs(pals) do if x.name == gname then g = x end end
            check(g ~= nil, where .. ": " .. gname .. " isn't a buddy paladin")
            check(not mine[b], where .. ": " .. r.name .. " gets " .. b .. " twice")
            check(not from_players[b], where .. ": " .. r.name .. " gets a player's " .. b .. " again")
            check(not r.avoid[b], where .. ": " .. r.name .. " said no to " .. b)
            check(not (b == "wisdom" and mana_regen and r.wish ~= "wisdom"), where .. ": " .. r.name .. " gets Wisdom beside Mana Spring")
            if g then check(g.knows[b], where .. ": " .. gname .. " doesn't know " .. b) end
            mine[b] = true
        end
        if r.wish and not r.avoid[r.wish] and not from_players[r.wish] then
            local someone = false
            for _, g in ipairs(pals) do if g.knows[r.wish] then someone = true end end
            check(not someone or mine[r.wish], where .. ": " .. r.name .. "'s wish for " .. r.wish .. " wasn't granted")
        end
        for b, _ in pairs(mine) do
            check(b == r.wish or Buffs.BLESSINGS[b][r.role] or false, where .. ": " .. r.name .. " (a " .. r.role .. ") gets " .. b .. " unasked")
        end
    end

    -- judgements: distinct, known, never a player's
    local jt = {}
    for _, g in ipairs(players) do if g.class == "paladin" and g.gives.judgement then jt[g.gives.judgement] = true end end
    local js = {}
    for _, g in ipairs(pals) do
        local j = p.judgements[g.name]
        if j then
            check(not js[j] and not jt[j], where .. ": judgement " .. j .. " twice")
            check(g.knows["judgement of " .. j], where .. ": " .. g.name .. " judges with " .. j .. ", which it doesn't know")
            js[j] = true
        end
    end
    local open = {}
    for _, j in ipairs(Buffs.JUDGEMENTS) do if not jt[j] then open[#open + 1] = j end end
    local function canj(j) local out = {} for _, g in ipairs(pals) do if g.knows["judgement of " .. j] then out[#out + 1] = g.name end end return out end
    for _, j in ipairs(open) do
        if not js[j] then
            local try = { j }
            for x in pairs(js) do try[#try + 1] = x end
            check(not feasible(try, canj), where .. ": judgement " .. j .. " could be on the target too")
        end
    end
end
check(seen.improved > 0 and seen.missing > 0 and seen.crossed > 0 and seen.scored > RUNS / 2,
      "random parties never showed an improved giver, a missing line, a resistance from a non-paladin, or too few were scored")
-- }}}

print(string.format("test-buddy-party-buffs: %d checks, %d failures", checks, #fails))
for _, f in ipairs(fails) do print("  FAIL: " .. f) end
print(#fails == 0 and "Result: all checks passed." or ("Result: " .. #fails .. " failure(s) shown."))
os.exit(#fails == 0 and 0 or 1)
-- ==== footer of test-buddy-party-buffs ====
-- lines:      599
-- ==== end of footer ====
