#!/usr/bin/env luajit
-- ==== header: 8 lines, footer: 3 lines ====
-- id:         test-buddy-party-buffs
-- profiles:   all
-- priority:   10
-- kind:       test
-- about:      check how a party's auras, blessings, judgements and totems
-- quick-test: yes
-- ==== end of header ====
-- test-buddy-party-buffs - check how a party's auras, blessings, judgements
-- and totems are shared out among its paladins and shamans (issue 617c5).
--
-- For a general audience: with several paladins and shamans in a party,
-- each should give something different and give it to whoever needs it
-- most. This test plays the issue's own cases (three paladins give three
-- auras; a stated wish beats a talent; Sanctuary goes to a tank first;
-- Might never to a caster; a healer low on mana gets Wisdom and goes back
-- to Kings after; two shamans never double a totem), the threats (fire
-- damage calls for the fire resistance aura; casters rule out Stoneskin),
-- a player paladin's own choices left alone, the words of a wish, and then
-- thousands of random parties, each checked against a referee that tries
-- every way of handing the buffs out.
--
-- Usage: scripts/test-buddy-party-buffs [PROJECT_DIR] [RUNS]
--   RUNS  random parties (default 600)
-- Exit status 0 if all pass.

local DIR  = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end
local RUNS = tonumber(arg[2]) or 600

local Buffs = dofile(DIR .. "/src/lua-basic/lib/buddy-party-buffs.lua")

local fails, checks = {}, 0
local function check(ok, what)
    checks = checks + 1
    if not ok and #fails < 25 then fails[#fails + 1] = what end
end

-- {{{ people
local ALL_BLESS = { kings = true, might = true, wisdom = true }
local ALL_AURAS = { devotion = true, concentration = true, retribution = true,
                    ["fire resistance"] = true, ["frost resistance"] = true, ["shadow resistance"] = true }
local function set(...) local t = {} for _, k in ipairs({ ... }) do t[k] = true end return t end
local function merge(a, b) local t = {} for k in pairs(a) do t[k] = true end for k in pairs(b or {}) do t[k] = true end return t end
local function paladin(name, extra, improved, opts)
    local g = { name = name, class = "paladin", knows = merge(merge(ALL_BLESS, ALL_AURAS), extra), improved = improved or {} }
    for k, v in pairs(opts or {}) do g[k] = v end
    return g
end
local TOTEMS_ALL = set("strength of earth", "stoneskin", "flametongue", "frost resistance", "searing",
                       "mana spring", "healing stream", "fire resistance", "windfury", "wrath of air",
                       "nature resistance", "grounding")
local function shaman(name, extra) return { name = name, class = "shaman", knows = merge(TOTEMS_ALL, extra), improved = {} } end
local function who(name, role, mana, extra)
    local r = { name = name, role = role, mana = mana, health = 1 }
    for k, v in pairs(extra or {}) do r[k] = v end
    return r
end
local function count(t) local n = 0 for _ in pairs(t) do n = n + 1 end return n end
-- }}}

-- {{{ the issue's own cases
do
    -- three paladins give three auras
    local p = Buffs.plan({ givers = { paladin("A"), paladin("B"), paladin("C") },
                           receivers = { who("T", "tank"), who("H", "healer", 1), who("M", "melee") } })
    local a = p.auras
    check(count(a) == 3 and a.A ~= a.B and a.B ~= a.C and a.A ~= a.C, "three paladins don't give three auras")
    check(a.A == "devotion" or a.B == "devotion" or a.C == "devotion", "no devotion in a party fighting melee")
    for _, r in ipairs({ "T", "H", "M" }) do
        local got = {}
        for _, b in pairs(p.blessings[r]) do got[b] = (got[b] or 0) + 1 end
        for b, n in pairs(got) do check(n == 1, r .. " gets " .. b .. " twice") end
        check(count(p.blessings[r]) == 2, r .. " gets " .. count(p.blessings[r]) .. " blessings from three paladins, not the 2 it can use")
    end

    -- a stated wish beats a talent
    local sanc = paladin("S", set("sanctuary"))
    local q = Buffs.plan({ givers = { sanc }, receivers = { who("T", "tank", nil, { wish = "kings" }) } })
    check(q.blessings.T.S == "kings", "the tank's wish lost to Sanctuary: " .. tostring(q.blessings.T.S))
    -- Sanctuary goes to a tank first; never to anyone else first
    local r = Buffs.plan({ givers = { sanc }, receivers = { who("T", "tank"), who("M", "melee"), who("H", "healer", 1) } })
    check(r.blessings.T.S == "sanctuary", "the tank doesn't get Sanctuary first")
    check(r.blessings.M.S == "might" and r.blessings.H.S == "kings", "Sanctuary's paladin gives the others the wrong thing")
    -- an improved Might goes first to weapon users, never to a caster
    local imp = paladin("I", nil, set("might"))
    local s = Buffs.plan({ givers = { imp }, receivers = { who("C", "caster", 1), who("M", "melee"), who("R", "ranged", 1) } })
    check(s.blessings.C.I == "kings", "a caster got " .. tostring(s.blessings.C.I))
    check(s.blessings.M.I == "might" and s.blessings.R.I == "might", "improved Might isn't given to weapon users")
    for _, roles in ipairs({ "caster", "healer" }) do
        for n = 1, 4 do
            local gs = {}
            for k = 1, n do gs[k] = paladin("P" .. k, nil, set("might")) end
            local pl = Buffs.plan({ givers = gs, receivers = { who("X", roles, 0.9) } })
            for _, b in pairs(pl.blessings.X) do check(b ~= "might", "Might given to a " .. roles .. " by " .. n .. " paladins") end
        end
    end
    -- unless asked for
    local w = Buffs.plan({ givers = { paladin("P") }, receivers = { who("C", "caster", 1, { wish = "might" }) } })
    check(w.blessings.C.P == "might", "a caster's own wish for Might wasn't granted")

    -- a healer low on mana gets Wisdom, and Kings again once it has mana
    local healer = who("H", "healer", 0.2)
    local low = Buffs.plan({ givers = { paladin("P") }, receivers = { healer } })
    check(low.blessings.H.P == "wisdom", "the low-mana healer doesn't get Wisdom")
    healer.mana = 0.9
    local back = Buffs.plan({ givers = { paladin("P") }, receivers = { healer } })
    check(back.blessings.H.P == "kings", "the healer doesn't go back to Kings")
    healer.mana = 0.35
    check(Buffs.plan({ givers = { paladin("P") }, receivers = { healer } }).blessings.H.P == "kings", "35% mana counts as low")
    healer.mana = 0.34
    check(Buffs.plan({ givers = { paladin("P") }, receivers = { healer } }).blessings.H.P == "wisdom", "34% mana isn't low")
    local warrior = who("W", "melee", nil)
    check(Buffs.plan({ givers = { paladin("P") }, receivers = { warrior } }).blessings.W.P == "might", "a warrior doesn't get Might")

    -- two shamans never double a totem, and give a mixed party both air totems
    local two = Buffs.plan({ givers = { shaman("X"), shaman("Y") },
                             receivers = { who("M", "melee"), who("C", "caster", 1) } })
    for _, el in ipairs(Buffs.ELEMENTS) do
        check(two.totems.X[el] ~= nil and two.totems.X[el] ~= two.totems.Y[el], "two shamans doubled or skipped " .. el)
    end
    local air = set(two.totems.X.air, two.totems.Y.air)
    check(air.windfury and air["wrath of air"], "a mixed party doesn't get Windfury and Wrath of Air")
    check(two.totems.X.water == "mana spring" or two.totems.Y.water == "mana spring", "no mana spring for a caster")
    -- a talented totem goes to the shaman that has it
    local tw = shaman("Z", set("totem of wrath"))
    local t3 = Buffs.plan({ givers = { shaman("X"), tw }, receivers = { who("C", "caster", 1) } })
    check(t3.totems.Z.fire == "totem of wrath" and t3.totems.X.fire == "flametongue", "Totem of Wrath isn't the talented shaman's")
    -- one shaman, a lone warrior: no caster totems
    local solo = Buffs.plan({ givers = { shaman("X") }, receivers = { who("W", "melee") } })
    check(solo.totems.X.fire == "searing" and solo.totems.X.water == "healing stream" and solo.totems.X.air == "windfury",
          "a warrior's shaman put down a caster's totem")
end
-- }}}

-- {{{ threats
do
    local party = { givers = { paladin("A"), shaman("X") }, receivers = { who("T", "tank"), who("C", "caster", 1) },
                    damage = { fire = 0.5, physical = 0.5 } }
    local p = Buffs.plan(party)
    check(p.auras.A == "fire resistance", "half the damage fire and no fire resistance aura: " .. tostring(p.auras.A))
    check(p.totems.X.water == "fire resistance", "half the damage fire and no fire resistance totem")
    party.damage = { fire = 0.40 }
    check(Buffs.plan(party).auras.A == "fire resistance", "40% fire didn't call for fire resistance")
    party.damage = { fire = 0.39 }
    check(Buffs.plan(party).auras.A == "devotion", "39% fire called for fire resistance")
    party.damage = { frost = 0.6, shadow = 0.7 }
    local g2 = Buffs.plan({ givers = { paladin("A"), paladin("B") }, receivers = party.receivers, damage = party.damage })
    check(set(g2.auras.A, g2.auras.B)["shadow resistance"] and set(g2.auras.A, g2.auras.B)["frost resistance"], "two resistances called for, not both given")
    local one = Buffs.plan({ givers = { paladin("A") }, receivers = party.receivers, damage = party.damage })
    check(one.auras.A == "shadow resistance", "the larger threat's resistance isn't first")
    party.damage, party.enemy = {}, "casters"
    local c = Buffs.plan(party)
    check(c.auras.A == "concentration", "against casters the aura is " .. tostring(c.auras.A))
    check(c.totems.X.earth ~= "stoneskin", "Stoneskin Totem against casters")
    local cm = Buffs.plan({ givers = { shaman("X"), shaman("Y") }, receivers = { who("C", "caster", 1) }, enemy = "casters" })
    check(set(cm.totems.X.air, cm.totems.Y.air).grounding, "no grounding totem against casters")
    local nm = Buffs.plan({ givers = { shaman("X"), shaman("Y") }, receivers = { who("C", "caster", 1) } })
    check(not set(nm.totems.X.air, nm.totems.Y.air).grounding, "a grounding totem against no casters")
    local nz = Buffs.plan({ givers = { shaman("X") }, receivers = { who("C", "caster", 1) }, damage = { nature = 0.8 } })
    check(nz.totems.X.air == "nature resistance", "nature damage and no nature resistance totem")
    local fr = Buffs.plan({ givers = { shaman("X") }, receivers = { who("C", "caster", 1) }, damage = { frost = 0.8 } })
    check(fr.totems.X.fire == "frost resistance", "frost damage and no frost resistance totem")
end
-- }}}

-- {{{ players are planned around, not planned
do
    local owner = { name = "Owner", class = "paladin", player = true, knows = merge(ALL_BLESS, ALL_AURAS),
                    gives = { aura = "devotion", blessings = { T = "kings", M = "kings" }, judgement = "light" } }
    local p = Buffs.plan({ givers = { owner, paladin("B") }, receivers = { who("T", "tank"), who("M", "melee") } })
    check(p.auras.Owner == nil and p.blessings.T.Owner == nil and p.judgements.Owner == nil, "the player was given a plan")
    check(p.auras.B ~= "devotion", "a buddy doubled the owner's devotion aura")
    check(p.blessings.T.B ~= "kings" and p.blessings.M.B ~= "kings", "a buddy doubled the owner's Kings")
    check(p.blessings.M.B == "might", "the buddy didn't fill the melee's Might beside the owner's Kings")
    check(p.judgements.B == "wisdom", "the buddy's judgement doubles the owner's Light: " .. tostring(p.judgements.B))
    local sp = { name = "Sham", class = "shaman", player = true, knows = TOTEMS_ALL, gives = { air = "windfury" } }
    local q = Buffs.plan({ givers = { sp, shaman("X") }, receivers = { who("M", "melee"), who("C", "caster", 1) } })
    check(q.totems.Sham == nil and q.totems.X.air == "wrath of air", "the buddy shaman doubled the player's Windfury")
end
-- }}}

-- {{{ judgements, announcements, wishes
do
    local hurt = { receivers = { who("T", "tank", 0.9, { health = 0.3 }) } }
    check(Buffs.judgements(hurt)[1] == "light", "a hurt party isn't judged with Light first")
    local dry = { receivers = { who("H", "healer", 0.1, { health = 0.9 }) } }
    check(Buffs.judgements(dry)[1] == "wisdom", "a party out of mana isn't judged with Wisdom first")
    check(table.concat(Buffs.judgements(dry, { wisdom = true }), ",") == "light,justice", "a taken judgement isn't skipped")
    local three = Buffs.plan({ givers = { paladin("A"), paladin("B"), paladin("C"), paladin("D") }, receivers = dry.receivers })
    check(three.judgements.A == "wisdom" and three.judgements.B == "light" and three.judgements.C == "justice" and three.judgements.D == nil,
          "four paladins' judgements are wrong")

    local talk = Buffs.plan({ givers = { paladin("A", nil, set("devotion"), { aura = "retribution" }), paladin("B", nil, nil, { aura = "retribution" }) },
                              receivers = { who("T", "tank") } })
    check(talk.auras.A == "devotion" and talk.auras.B == "retribution", "the improved devotion isn't the talented paladin's")
    local said = table.concat(talk.said, "|")
    check(said:find("A: I have the improved devotion aura", 1, true) ~= nil, "the improved aura isn't announced")
    check(said:find("A: switching to devotion aura.", 1, true) ~= nil, "the switch isn't announced")
    check(not said:find("B:", 1, true), "a paladin keeping its aura said something")

    local cases = {
        { "Kings please",          "wish",  "kings" },
        { "can I have BoW?",       "wish",  "wisdom" },
        { "might",                 "wish",  "might" },
        { "no Might",              "avoid", "might" },
        { "please don't give me sanctuary", "avoid", "sanctuary" },
        { "not kings, wisdom",     "avoid", "kings" },
        { "anything is fine",      "clear", true },
        { "No preference.",        "clear", true },
        { "hello there",           nil,     nil },
        { "kingsfoil",             nil,     nil },
    }
    for _, c in ipairs(cases) do
        local w = Buffs.parse_wish(c[1])
        if c[2] then check(w and w[c[2]] == c[3], "\"" .. c[1] .. "\" heard wrong")
        else check(w == nil, "\"" .. c[1] .. "\" heard as a wish") end
    end
    local r = who("H", "healer", 1)
    Buffs.hear(r, Buffs.parse_wish("wisdom please"))
    check(r.wish == "wisdom", "a heard wish isn't kept")
    Buffs.hear(r, Buffs.parse_wish("no wisdom"))
    check(r.wish == nil and r.avoid.wisdom, "a no to the wished blessing didn't drop it")
    Buffs.hear(r, Buffs.parse_wish("wisdom after all"))
    check(r.wish == "wisdom" and not r.avoid.wisdom, "a new wish didn't lift the no")
    Buffs.hear(r, Buffs.parse_wish("no kings"))
    check(r.wish == "wisdom" and r.avoid.kings, "a no to another blessing dropped the wish")
    Buffs.hear(r, Buffs.parse_wish("anything"))
    check(r.wish == nil and next(r.avoid) == nil, "clearing left something")
    Buffs.hear(r, nil)
    check(r.wish == nil, "nothing heard changed the receiver")
    local avoider = Buffs.plan({ givers = { paladin("P") }, receivers = { who("M", "melee", nil, { avoid = set("might") }) } })
    check(avoider.blessings.M.P == "kings", "a no to Might wasn't kept")
end
-- }}}

-- {{{ the referee, written from 617c5
local USE = { kings = set("tank", "healer", "caster", "melee", "ranged"), might = set("tank", "melee", "ranged"),
              wisdom = set("healer", "caster", "ranged"), sanctuary = set("tank") }
local USUAL = { healer = { "kings", "wisdom" }, caster = { "kings", "wisdom" }, melee = { "might", "kings" },
                ranged = { "might", "kings", "wisdom" }, tank = { "sanctuary", "kings", "might" } }
local function ref_wishes(r, pals)
    local out, seen = {}, {}
    local function add(b) if b and not seen[b] and not (r.avoid or {})[b] then seen[b] = true; out[#out + 1] = b end end
    add(r.wish)
    for _, b in ipairs({ "kings", "might", "wisdom", "sanctuary" }) do
        for _, p in ipairs(pals) do
            if USE[b][r.role] and p.knows[b] and (p.improved[b] or b == "sanctuary") then add(b) end   -- Sanctuary: rare
        end
    end
    if r.mana and r.mana < 0.35 and USE.wisdom[r.role] then add("wisdom") end
    for _, b in ipairs(USUAL[r.role]) do add(b) end
    for _, b in ipairs({ "kings", "might", "wisdom", "sanctuary" }) do if USE[b][r.role] then add(b) end end
    return out
end
-- The best way to hand `list` (ranked) to `givers`: try every assignment
-- (each giver one buff it knows, or none, no buff twice); the best gives
-- the buffs whose ranks, as a yes/no list, are largest first; ties go to
-- the most handed to an improving giver. Returns the chosen set and that count.
local function ref_best(givers, list)
    local rank = {}
    for k, b in ipairs(list) do rank[b] = k end
    local best, best_imp, best_set = nil, -1, {}
    local pick, used = {}, {}
    local function score()
        local v = {}
        for k = 1, #list do v[k] = 0 end
        local imp = 0
        for g, b in pairs(pick) do v[rank[b]] = 1; if givers[g].improved[b] then imp = imp + 1 end end
        return v, imp
    end
    local function better(v, imp)
        if not best then return true end
        for k = 1, #v do if v[k] ~= best[k] then return v[k] > best[k] end end
        return imp > best_imp
    end
    local function go(g)
        if g > #givers then
            local v, imp = score()
            if better(v, imp) then
                best, best_imp, best_set = v, imp, {}
                for _, b in pairs(pick) do best_set[b] = true end
            end
            return
        end
        go(g + 1)
        for _, b in ipairs(list) do
            if not used[b] and givers[g].knows[b] then
                used[b], pick[g] = true, b
                go(g + 1)
                used[b], pick[g] = nil, nil
            end
        end
    end
    go(1)
    return best_set, best_imp
end
-- }}}

-- {{{ random parties against the referee
local ROLES = { "tank", "healer", "caster", "melee", "ranged" }
local AURA_NAMES = { "devotion", "concentration", "retribution", "fire resistance", "frost resistance", "shadow resistance" }
local BLESS_NAMES = { "kings", "might", "wisdom", "sanctuary" }
local TOTEM_NAMES = {}
for t in pairs(TOTEMS_ALL) do TOTEM_NAMES[#TOTEM_NAMES + 1] = t end
TOTEM_NAMES[#TOTEM_NAMES + 1] = "totem of wrath"
table.sort(TOTEM_NAMES)
local seen_imp_blessing, seen_full = 0, 0
for run = 1, RUNS do
    math.randomseed(run * 613 + 11)
    local R = math.random
    local function some(names, p) local t = {} for _, n in ipairs(names) do if R() < p then t[n] = true end end return t end
    local party = { givers = {}, receivers = {}, damage = {}, enemy = R(3) == 1 and "casters" or nil }
    for _, school in ipairs({ "physical", "fire", "frost", "shadow", "nature" }) do if R(2) == 1 then party.damage[school] = R() end end
    local np, ns = R(5) - 1, R(4) - 1
    for k = 1, np do
        local g = { name = "P" .. k, class = "paladin", knows = some(BLESS_NAMES, 0.8), improved = {} }
        for a, v in pairs(some(AURA_NAMES, 0.8)) do g.knows[a] = v end
        for b in pairs(g.knows) do if R(4) == 1 then g.improved[b] = true end end
        if R(4) == 1 then
            g.player = true
            g.gives = { aura = AURA_NAMES[R(#AURA_NAMES)], blessings = {}, judgement = Buffs.JUDGEMENTS[R(3)] }
        end
        party.givers[#party.givers + 1] = g
    end
    for k = 1, ns do
        local g = { name = "S" .. k, class = "shaman", knows = some(TOTEM_NAMES, 0.85), improved = {} }
        if R(4) == 1 then g.player = true; g.gives = { air = "windfury", water = "mana spring" } end
        party.givers[#party.givers + 1] = g
    end
    for k = 1, R(5) do
        local role = ROLES[R(5)]
        local r = { name = "R" .. k, role = role, health = R(),
                    mana = (role == "healer" or role == "caster" or role == "ranged") and R() or nil,
                    wish = R(4) == 1 and BLESS_NAMES[R(4)] or nil, avoid = some(BLESS_NAMES, 0.1) }
        party.receivers[#party.receivers + 1] = r
        for _, g in ipairs(party.givers) do
            if g.player and g.class == "paladin" and R(2) == 1 then g.gives.blessings[r.name] = BLESS_NAMES[R(4)] end
        end
    end
    local where = "run " .. run
    local p = Buffs.plan(party)
    local pals, shamans, players = {}, {}, {}
    for _, g in ipairs(party.givers) do
        if g.player then players[#players + 1] = g
        elseif g.class == "paladin" then pals[#pals + 1] = g else shamans[#shamans + 1] = g end
    end
    for _, g in ipairs(players) do
        check(p.auras[g.name] == nil and p.judgements[g.name] == nil and p.totems[g.name] == nil, where .. ": a player was planned")
    end

    -- auras: distinct, known, not a player's, the best set the referee finds
    local held, auras_list = {}, {}
    for _, g in ipairs(players) do if g.class == "paladin" and g.gives.aura then held[g.gives.aura] = true end end
    local resist = {}
    for _, a in ipairs({ { "fire resistance", "fire" }, { "frost resistance", "frost" }, { "shadow resistance", "shadow" } }) do
        if (party.damage[a[2]] or 0) >= 0.4 then resist[#resist + 1] = { a[1], party.damage[a[2]] } end
    end
    table.sort(resist, function(x, y) if x[2] ~= y[2] then return x[2] > y[2] end return x[1] < y[1] end)
    for _, x in ipairs(resist) do if not held[x[1]] then auras_list[#auras_list + 1] = x[1] end end
    local castery = false
    for _, r in ipairs(party.receivers) do if r.role == "healer" or r.role == "caster" then castery = true end end
    if party.enemy ~= "casters" and not held.devotion then auras_list[#auras_list + 1] = "devotion" end
    if castery and not held.concentration then auras_list[#auras_list + 1] = "concentration" end
    if not held.retribution then auras_list[#auras_list + 1] = "retribution" end
    local want_set, want_imp = ref_best(pals, auras_list)
    local got, got_imp = {}, 0
    for _, g in ipairs(pals) do
        local a = p.auras[g.name]
        if a then
            check(not got[a], where .. ": aura " .. a .. " twice")
            check(g.knows[a], where .. ": " .. g.name .. " doesn't know " .. a)
            got[a] = true
            if g.improved[a] then got_imp = got_imp + 1 end
        end
    end
    for a in pairs(want_set) do check(got[a], where .. ": aura " .. a .. " should be up") end
    check(count(got) == count(want_set), where .. ": " .. count(got) .. " auras, the referee wants " .. count(want_set))
    check(got_imp == want_imp, where .. ": " .. got_imp .. " improved auras, the referee finds " .. want_imp)

    -- blessings: per receiver, against the referee's wishes and best hand-out
    for _, r in ipairs(party.receivers) do
        local given = {}
        for _, g in ipairs(players) do local b = g.gives.blessings and g.gives.blessings[r.name]; if b then given[b] = true end end
        local list = {}
        for _, b in ipairs(ref_wishes(r, pals)) do if not given[b] then list[#list + 1] = b end end
        local ws, wi = ref_best(pals, list)
        local mine, imp = {}, 0
        for gname, b in pairs(p.blessings[r.name]) do
            local g
            for _, x in ipairs(pals) do if x.name == gname then g = x end end
            check(g ~= nil, where .. ": " .. gname .. " isn't a buddy paladin")
            check(not mine[b], where .. ": " .. r.name .. " gets " .. b .. " twice")
            check(not given[b], where .. ": " .. r.name .. " gets a player's " .. b .. " again")
            check(not r.avoid[b], where .. ": " .. r.name .. " said no to " .. b)
            if g then check(g.knows[b], where .. ": " .. gname .. " doesn't know " .. b) end
            if g and g.improved[b] then imp = imp + 1 end
            mine[b] = true
        end
        for b in pairs(ws) do check(mine[b], where .. ": " .. r.name .. " should get " .. b) end
        check(count(mine) == count(ws), where .. ": " .. r.name .. " gets " .. count(mine) .. ", the referee " .. count(ws))
        check(imp == wi, where .. ": " .. r.name .. "'s improved blessings " .. imp .. ", the referee " .. wi)
        if wi > 0 then seen_imp_blessing = seen_imp_blessing + 1 end
        if #pals >= 3 then seen_full = seen_full + 1 end
    end

    -- judgements: distinct, none a player's
    local jt = {}
    for _, g in ipairs(players) do if g.class == "paladin" and g.gives.judgement then jt[g.gives.judgement] = true end end
    local js = {}
    for _, g in ipairs(pals) do
        local j = p.judgements[g.name]
        if j then check(not js[j] and not jt[j], where .. ": judgement " .. j .. " twice"); js[j] = true end
    end
    check(count(js) == math.min(#pals, 3 - count(jt)), where .. ": " .. count(js) .. " judgements")

    -- totems: per element distinct, known, never one a player put down,
    -- never Stoneskin against casters, Grounding only against them
    for _, el in ipairs(Buffs.ELEMENTS) do
        local down, these = {}, {}
        for _, g in ipairs(players) do if g.class == "shaman" and g.gives[el] then down[g.gives[el]] = true end end
        for _, s in ipairs(shamans) do
            local t = p.totems[s.name][el]
            if t then
                check(not these[t] and not down[t], where .. ": " .. el .. " totem " .. t .. " twice")
                check(s.knows[t], where .. ": " .. s.name .. " doesn't know " .. t)
                check(not (t == "stoneskin" and party.enemy == "casters"), where .. ": stoneskin against casters")
                check(not (t == "grounding" and party.enemy ~= "casters"), where .. ": grounding against no casters")
                these[t] = true
            end
        end
    end
end
check(seen_imp_blessing > 0 and seen_full > 0, "random parties never had an improved blessing or three paladins")
-- }}}

print(string.format("test-buddy-party-buffs: %d checks, %d failures", checks, #fails))
for _, f in ipairs(fails) do print("  FAIL: " .. f) end
print(#fails == 0 and "Result: all checks passed." or ("Result: " .. #fails .. " failure(s) shown."))
os.exit(#fails == 0 and 0 or 1)
-- ==== footer of test-buddy-party-buffs ====
-- lines:      444
-- ==== end of footer ====
