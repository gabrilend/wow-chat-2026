  </section>
  <!--EMBED:join-leave.js-->]=],
    before = "Five buddies roam with the owner's waypoint rule while the owner (white) walks across the area. Rings round the owner, drawn at half the real distances so the drawn area can show them: green, join inside 60 yards; gold, 74 (the range kill experience is shared in, and past it a buddy joins the far buddies' own party); red, leave outside 75. A white ring marks a buddy in the owner's group (it holds four), a gold ring one in the far party.",
    after = "A buddy joins the owner's group when it drifts inside 60 yards and a seat is free, nearest first, and leaves only once past 75, so a grouped buddy is almost never outside the 74-yard experience range, and the gap between the rings keeps a buddy at the edge from flickering in and out. Past 74 an ungrouped buddy is in the far party with the other far buddies, sharing their own kills' experience; back inside 74 it leaves that party, and inside 60 joins the owner's again. Between 60 and 74, or nearer while the owner's group is full, it is in no group. Buddies don't steer toward the owner: grouping follows wherever their roaming takes them.",
    setup = function(rand)
        local params = { reading = "waypoints", headings = 16, turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, near = 10, crowd = 5, orbit = 2.5 }
        return { sims = { Roam.new(AREA, place_buddies(5, rand), params, rand) }, owner = { 14, 50 } }
    end,
    after_tick = function(st, t)
        local path = { { 14, 50 }, { 60, 18 }, { 110, 40 }, { 70, 84 }, { 14, 50 } }
        local seg = (t - 1) / FRAMES * (#path - 1)
        local i = math.floor(seg) + 1
        local k = seg - (i - 1)
        local a, b = path[i], path[math.min(i + 1, #path)]
        st.owner = { a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k }
        Roam.grouping(st.sims[1].buddies, st.owner[1], st.owner[2], HALF_JOIN, HALF_LEAVE, 4, HALF_FAR)
    end,
