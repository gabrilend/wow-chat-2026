        local ox, oy = px(st.owner[1]), py(st.owner[2])
        ring(f, ox, oy, HALF_JOIN * SCALE, 16, true)
        ring(f, ox, oy, HALF_FAR * SCALE, 15)
        ring(f, ox, oy, HALF_LEAVE * SCALE, 17, true)
    end,
    overlay = function(f, st)
        disc(f, px(st.owner[1]), py(st.owner[2]), 5, 5)
        for _, b in ipairs(st.sims[1].buddies) do
            if b.far then ring(f, px(b.x), py(b.y), 7, 15) end
        end
    end,
}

-- 7. walking round rocks
SCENES[#SCENES + 1] = {
    name = "07-round-the-rocks",
    title = "Walking round the rocks",
    before = "A crowded start in the **rock**iest corner, with long trails. No path is planned: each tick a buddy **simply** refuses any step that would enter a rock (keeping a yard and a half clear) or leave the area.",
    after = "Twelve headings are **enough** to slide round rocks of this size; the trails curve along the rock edges. What this **can't** do is find the way out of a dead end (a cave mouth, a U of rocks): in game those areas would need the server's own pathfinding for the step, which is the next thing to decide once the reading is chosen.",
    trail = 90,
    setup = function(rand)
        return { sims = { Roam.new(AREA, place_buddies(6, rand, { 72, 44 }), { reading = "far-lists" }, rand) } }
    end,
}
-- {{{ local function spread
-- Measured, not written in: run six buddies for 6000 ticks (the first 500
-- left out, while they spread from the start) and report the average yards
-- to each one's nearest other buddy, and how often that is under 6 yards
-- (standing on top of each other, as it would look in game). The captions
-- of the waypoint scenes quote these, so they stay true when the model
-- changes.
local function spread(params, area)
    area = area or AREA
    local rand = lcg(11)
    local bs = place_buddies(6, rand, nil, area)
    local s = Roam.new(area, bs, params, rand)
    local sum, n, close = 0, 0, 0
    local fifths = { 0, 0, 0, 0, 0 }             -- waypoint shares, by fifth of the way out
    local pressed, seen = 0, 0                   -- ticks within a yard of an obstacle's no-go margin
    local last_wp = {}
    local walked, climbed, on_road, perched = 0, 0, 0, 0   -- yards, yards up or down, yards on road, ticks on an obstacle
    local was = {}
    local tunnel_wps, tunnel_who = 0, {}
    for tick = 1, 6000 do
        Roam.tick(s, rand)
        for _, b in ipairs(bs) do
            if b.wp and b.wp ~= last_wp[b.id] then
                last_wp[b.id] = b.wp
                -- the tunnel map: waypoints past its mouth, and who went
                if area.tunnel_x and b.wp.x > area.tunnel_x then
                    tunnel_wps = tunnel_wps + 1
                    tunnel_who[b.id] = true
                end
                local k = math.min(5, math.floor(b.share * 5 - 1e-9) + 1)   -- the rule's own Y (a rock may move the waypoint itself)
                fifths[k] = fifths[k] + 1
            end
            local gap = math.huge
            for _, w in ipairs(area.walls) do gap = math.min(gap, math.sqrt((b.x - w[1]) ^ 2 + (b.y - w[2]) ^ 2) - w[3] - s.margin) end
            if gap < 1 then pressed = pressed + 1 end
            seen = seen + 1
            if area.height then
                local h = area.height(b.x, b.y)
                local p = was[b.id]
                if p then
                    local ds = math.sqrt((b.x - p.x) ^ 2 + (b.y - p.y) ^ 2)
                    walked, climbed = walked + ds, climbed + math.abs(h - p.h)
                    if area.road(b.x, b.y) then on_road = on_road + ds end
                end
                if h - area.ground(b.x, b.y) > 0.5 then perched = perched + 1 end
                was[b.id] = { x = b.x, y = b.y, h = h }
            end
        end
        if tick > 500 then
            for _, b in ipairs(bs) do
                local nn = math.huge
                for _, o in ipairs(bs) do if o ~= b then nn = math.min(nn, math.sqrt((o.x - b.x) ^ 2 + (o.y - b.y) ^ 2)) end end
                sum, n = sum + nn, n + 1
                if nn < 6 then close = close + 1 end
            end
        end
    end
    local crowded, moves, pierced = 0, 0, 0
    for _, b in ipairs(bs) do crowded, moves, pierced = crowded + (b.crowded or 0), moves + (b.crowd_moves or 0), pierced + (b.pierced or 0) end
    local picks = 0
    for i = 1, 5 do picks = picks + fifths[i] end
    for i = 1, 5 do fifths[i] = picks > 0 and 100 * fifths[i] / picks or 0 end
    local went = 0
    for _ in pairs(tunnel_who) do went = went + 1 end
    return { nearest = sum / n, close = 100 * close / n, crowded = crowded, fifths = fifths, pressed = 100 * pressed / seen,
             moves = picks > 0 and 100 * moves / picks or 0, pierced = picks > 0 and 100 * pierced / picks or 0, tunnel = picks > 0 and 100 * tunnel_wps / picks or 0, went = went,
             climb = walked > 0 and 100 * climbed / walked or 0, road = walked > 0 and 100 * on_road / walked or 0, perched = 100 * perched / seen }
end
local SPREAD = {
    a     = spread({ reading = "far-lists" }),
    d     = spread({ reading = "waypoints", headings = 16 }),
    blend = spread({ reading = "waypoints", headings = 16, avoid = 20 }),
    no_orbit   = spread({ reading = "waypoints", headings = 16, turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, near = 10, orbit = 0 }, AREA_CLUTTERED),
    -- the owner's rule (2026-09-27): Y 1..100 moved +-1..20 points, X a
    -- tenth of a circle, 10 yards off the centre
    orbit_walk = spread({ reading = "waypoints", headings = 16, turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, near = 10, orbit = 2.5 }, AREA_CLUTTERED),
    planned    = spread({ reading = "waypoints", turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, near = 10, body = 0.61 }, AREA_CLUTTERED),
    -- the owner's 5-yard crowding rule (2026-09-27), against the same without
    crowd      = spread({ reading = "waypoints", turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, near = 10, body = 0.61, crowd = 5 }, AREA_CLUTTERED),
    tunnel     = spread({ reading = "waypoints", turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, near = 10, body = 0.61, crowd = 5 }, AREA_TUNNEL),
    pierce     = spread({ reading = "waypoints", turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, near = 10, body = 0.61, crowd = 5, pierce = 25 }, AREA_CLUTTERED),
    tunnel_open = spread({ reading = "waypoints", turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, near = 10, body = 0.61, crowd = 5, openings = 20 }, AREA_TUNNEL),
}
local function fifths(r)
    return string.format("%.0f%%, %.0f%%, %.0f%%, %.0f%%, %.0f%%", r.fifths[1], r.fifths[2], r.fifths[3], r.fifths[4], r.fifths[5])
end
-- }}}

-- {{{ local function draw_waypoints
-- The waypoint readings: a dashed line from each buddy to its waypoint and
-- a small cross on the waypoint, in the buddy's colour.
local function draw_waypoints(f, st)
    for _, s in ipairs(st.sims) do
        for _, b in ipairs(s.buddies) do
            if b.wp then
                local c = BUDDY[(b.id - 1) % #BUDDY + 1]
                local x, y = px(b.wp.x), py(b.wp.y)
                -- by a turning point when the area's walls are in the way
                -- (the straight walker; a planned path shows its own dots)
                if b.via and not b.path then
                    local vx, vy = px(b.via.x), py(b.via.y)
                    line(f, px(b.x), py(b.y), vx, vy, c, true)
                    line(f, vx, vy, x, y, c, true)
                    ring(f, vx, vy, 3, c)
                else
                    line(f, px(b.x), py(b.y), x, y, c, true)
                end
                line(f, x - 3, y - 3, x + 3, y + 3, c)
                line(f, x - 3, y + 3, x + 3, y - 3, c)
            end
        end
    end
end
-- }}}

