-- }}}

-- the settings the owner chose on 2026-09-27, shared by scenes 11-15:
-- X (the bearing) turns a tenth of a circle a waypoint; Y (the percent of
-- the way out, 1..100) moves 1 to 20 points in or out at even odds, and no
-- waypoint is nearer the centre than 10 yards; one landing within 5 yards
-- of another buddy moves 10 points toward the middle of the way out
local OWNER_Y = { reading = "waypoints", turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, y_min = 1, near = 10, crowd = 5 }
local function with(extra)
    local p = {}
    for k, v in pairs(OWNER_Y) do p[k] = v end
    for k, v in pairs(extra) do p[k] = v end
    return p
end

-- {{{ local function draw_paths
-- Planned walking: the rest of each buddy's planned path as dots, one per
-- test point, in its colour.
local function draw_paths(f, st)
    for _, s in ipairs(st.sims) do
        for _, b in ipairs(s.buddies) do
            if b.path then
                local c = BUDDY[(b.id - 1) % #BUDDY + 1]
                for i = b.path_i, #b.path do plot(f, px(b.path[i].x), py(b.path[i].y), c) end
            end
        end
    end
end
-- }}}

