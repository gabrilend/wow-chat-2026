-- 18. monsters
-- The monsters of the cluttered map, each with its aggro radius against a
-- buddy of its level (the server: 20 yards, one less for each level the
-- buddy is above it); a few are higher or lower level.
local MOBS = {
    { 20, 20, 12 }, { 50, 12, 10 }, { 82, 16, 11 }, { 112, 48, 12 }, { 90, 62, 9 }, { 72, 86, 10 },
    { 40, 60, 11 }, { 12, 62, 10 }, { 56, 44, 9 }, { 106, 30, 10 }, { 30, 84, 12 },
}
local FIGHT_TICKS, RESPAWN_TICKS = 40, 400
local function fresh_mobs()
    local list = {}
    for _, m in ipairs(MOBS) do list[#list + 1] = { x = m[1], y = m[2], r = m[3], alive = true } end
    return list
end
-- A buddy inside a living monster's radius is noticed: the two fight for
-- FIGHT_TICKS (the buddy stands), the monster dies and comes back after
-- RESPAWN_TICKS. Returns the fights begun this tick.
local function fights(st, t)
    local begun = 0
    for _, m in ipairs(st.mobs) do
        if not m.alive and m.back_at and t >= m.back_at then m.alive, m.back_at, m.foe = true, nil, nil end
        if m.alive then
            for _, s in ipairs(st.sims) do
                for _, b in ipairs(s.buddies) do
                    if m.alive and (b.busy or 0) == 0 and (b.x - m.x) ^ 2 + (b.y - m.y) ^ 2 < m.r * m.r then
                        m.alive, m.foe, m.fight_end, m.back_at = false, b, t + FIGHT_TICKS, t + RESPAWN_TICKS
                        b.busy = FIGHT_TICKS
                        begun = begun + 1
                    end
                end
            end
        end
    end
    return begun
end
-- fights per 100 waypoints over a long run, with the nudge or without
local function measure_fights(lure)
    local rand = lcg(13)
    local st = { mobs = fresh_mobs() }
    local bs = place_buddies(6, rand, nil, AREA_CLUTTERED)
    local s = Roam.new(AREA_CLUTTERED, bs, with({ body = 0.61, mobs = lure and st.mobs or {} }), rand)
    st.sims = { s }
    local n, picks, last = 0, 0, {}
    for t = 1, 6000 do
        Roam.tick(s, rand)
        n = n + fights(st, t)
        for _, b in ipairs(bs) do if b.wp ~= last[b.id] then last[b.id], picks = b.wp, picks + 1 end end
    end
    return 100 * n / picks
end
SCENES[#SCENES + 1] = {
    name = "18-monsters",
    title = "Drawing the monsters' attention",
    before = "Monsters (red) with their aggro radius (dashed): a buddy that comes **inside** it is noticed and attacked. The owner: \"bots will try to move within aggro range of monsters that they are near, nudging their waypoints to move the tangent line between them and the mob's aggro radius somewhere interior to the radius\". When the line to a buddy's next waypoint passes within 25 yards outside a living monster's radius, the trip **bends** through a point 70% of the way in from the edge of that radius, on the side the line passes; a ring marks that point. A fight here is the buddy standing **still** for a few seconds while the monster falls; it comes back later.",
    after = "Buddies now bend their laps to **brush** past monsters near their way and pull them, instead of passing them by, and after the fight carry on round. Only the **first** monster along each trip bends it, so a buddy isn't dragged from one to the next across the area. Measured over a long run: %.1f fights per 100 waypoints with the nudge, %.1f without (a fight then only when a lap happens to cross a radius). In game the radius comes from the **server** itself (each creature's aggro range against that buddy), and only monsters that attack on sight count.",
    frames = 640,
    trail = 90,
    area = AREA_CLUTTERED,
    setup = function(rand)
        local st = { mobs = fresh_mobs() }
        st.sims = { Roam.new(AREA_CLUTTERED, place_buddies(6, rand, nil, AREA_CLUTTERED), with({ body = 0.61, mobs = st.mobs }), rand) }
        return st
    end,
    after_tick = function(st, t) fights(st, t) end,
    under = function(f, st, t)
        for _, m in ipairs(st.mobs) do
            if m.alive then
                ring(f, px(m.x), py(m.y), m.r * SCALE, 17, true)
                disc(f, px(m.x), py(m.y), 3, 13)
            elseif m.foe and m.fight_end and t < m.fight_end then
                line(f, px(m.x), py(m.y), px(m.foe.x), py(m.foe.y), 13)
                disc(f, px(m.x), py(m.y), 3, 13)
            else
                local x, y = px(m.x), py(m.y)
                line(f, x - 2, y - 2, x + 2, y + 2, 19); line(f, x - 2, y + 2, x + 2, y - 2, 19)
            end
        end
        draw_paths(f, st)
        for _, b in ipairs(st.sims[1].buddies) do
            if b.via and b.via_kind == "lure" and b.path and b.path_i <= #b.path then ring(f, px(b.via.x), py(b.via.y), 3, 20) end
        end
    end,
}
