-- {{{ exploring as painting: the hall, the four systems side by side (19)
-- A bigger arena, built to show the systems apart (the owner, 2026-09-27:
-- "Don't be afraid to re-implement the arena"): a main hall with an L-leg
-- (the entrance at the leg's foot), a dead-end passage off the leg, and a
-- tunnel from the hall to a side room that leads on down a second tunnel
-- to a far room. About 240 by 170 yards. The centre is the outline's own
-- centre of area (as the in-game table's middle is an average over the
-- area), which in an L falls near the hall's lower wall.
local HALL_OUTLINE = {
    { 10, 10 }, { 150, 10 }, { 150, 40 }, { 200, 40 }, { 200, 20 }, { 250, 20 }, { 250, 80 }, { 228, 80 }, { 228, 140 }, { 250, 140 },
    { 250, 180 }, { 200, 180 }, { 200, 140 }, { 220, 140 }, { 220, 80 }, { 200, 80 }, { 200, 50 }, { 150, 50 }, { 150, 90 }, { 80, 90 },
    { 80, 140 }, { 150, 140 }, { 150, 150 }, { 80, 150 }, { 80, 180 }, { 10, 180 },
}
local HALL = {
    outline = HALL_OUTLINE,
    walls   = { { 50, 40, 6 }, { 110, 65, 5 }, { 40, 130, 5 }, { 230, 50, 4 }, { 225, 162, 3 } },
    centre  = centroid(HALL_OUTLINE),
}
local HALL_ENTRANCE = { 45, 176 }
local HALL_CELL     = 2
local HALL_DISC     = Roam.paint_grid(HALL, HALL_CELL)   -- the squished circle, worked out once
Roam.paint_disc_map(HALL_DISC, 4000)

local PAINT_SYSTEMS = {
    { mode = "pinwheel", name = "A: today's pinwheel" },
    { mode = "choose",   name = "B: pinwheel choosing by paint" },
    { mode = "least",    name = "C: least paint, walls paint, no pinwheel" },
    { mode = "disc",     name = "D: squished-circle pinwheel with paint" },
}

-- a clan of four on the hall, starting at the entrance, for one system
local function paint_sim(mode, rand, wall_paint)
    local g = Roam.paint_grid(HALL, HALL_CELL)
    g.du, g.dv, g.rim, g.disc_clear = HALL_DISC.du, HALL_DISC.dv, HALL_DISC.rim, HALL_DISC.disc_clear
    local bs = {}
    for k = 1, 4 do bs[k] = { id = k, x = HALL_ENTRANCE[1] - 10 + k * 4, y = HALL_ENTRANCE[2] - 4 } end
    return Roam.new(HALL, bs, { reading = "paint", paint_mode = mode, grid = g, entrance = HALL_ENTRANCE, wall_paint = wall_paint,
        turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, near = 10, crowd = 5, openings = 20 }, rand)
end

-- Measured, not written in: each system for 6000 ticks (about six
-- minutes of play) from the same start: explored ground (seen from within
-- 20 yards) at four times, time within 3 yards of a wall, and the share of
-- steps onto ground someone stood on in the last 25 seconds.
local function paint_measure(mode, wall_paint)
    local rand = lcg(5)
    local s = paint_sim(mode, rand, wall_paint)
    local r = { cov = {} }
    for t = 1, 6000 do
        Roam.tick(s, rand)
        if t == 300 or t == 600 or t == 1500 or t == 6000 then r.cov[#r.cov + 1] = 100 * Roam.paint_coverage(s.grid) end
    end
    r.wall = 100 * s.stats.near_wall / s.stats.ticks
    r.revisit = 100 * s.stats.revisits / s.stats.entries
    -- in tunnels: yards off the middle line, on average (0 = dead centre)
    r.tunnel = s.stats.tunnel_ticks > 0 and s.stats.tunnel_off / s.stats.tunnel_ticks or 0
    r.tunnel_share = 100 * s.stats.tunnel_ticks / s.stats.ticks
    return r
end
local PAINT_MEASURE = {}
for _, sys in ipairs(PAINT_SYSTEMS) do PAINT_MEASURE[sys.mode] = paint_measure(sys.mode, true) end
PAINT_MEASURE.least_bare = paint_measure("least", false)
PAINT_MEASURE.rooms      = paint_measure("rooms", true)
PAINT_MEASURE.rooms_bare = paint_measure("rooms", false)

-- {{{ local function render_paint_panels
-- The four systems in a 2x2 grid of panels, each with the paint shaded
-- as heat (nothing, faint, ... hot) and a coverage bar under it (the share
-- explored). Panel number = the count of white dots in its top-left corner.
local PANEL_SCALE, PANEL_W, PANEL_H, PANEL_GAP, BAR_H = 1.2, 312, 228, 6, 6
local function render_paint_panels(scene)
    local systems = scene.systems or PAINT_SYSTEMS
    local saveW, saveH, saveS, saveX, saveY = W, H, SCALE, OX, OY
    W = PANEL_W * 2 + PANEL_GAP * 3
    H = (PANEL_H + BAR_H + 4) * 2 + PANEL_GAP * 3
    SCALE = PANEL_SCALE
    local rand = lcg(scene.seed or 7)
    local panels = {}
    for k, sys in ipairs(systems) do
        local col, row = (k - 1) % 2, math.floor((k - 1) / 2)
        local p = { sys = sys, sim = paint_sim(sys.mode, rand, sys.walls ~= false),
                    x0 = PANEL_GAP + col * (PANEL_W + PANEL_GAP), y0 = PANEL_GAP + row * (PANEL_H + BAR_H + 4 + PANEL_GAP) }
        -- each pixel of the panel: which cell it shows (-1 outside the
        -- hall), worked out once
        p.map = {}
        local g = p.sim.grid
        for y = 0, PANEL_H - 1 do
            for x = 0, PANEL_W - 1 do
                local wx, wy = x / SCALE, y / SCALE
                local i = Roam.paint_cell_of(g, wx, wy)
                p.map[y * PANEL_W + x] = (i and g.inside[i]) and i or -1
            end
        end
        panels[k] = p
    end
    local frames = {}
    for t = 1, scene.frames do
        local f = new_frame()
        for k, p in ipairs(panels) do
            Roam.tick(p.sim, rand)
            local g = p.sim.grid
            OX, OY = p.x0, p.y0
            -- the floor: rock, or paint as heat (palette 32-39)
            for y = 0, PANEL_H - 1 do
                local row = (p.y0 + y) * W + p.x0
                for x = 0, PANEL_W - 1 do
                    local i = p.map[y * PANEL_W + x]
                    if i >= 0 then
                        if not g.open[i] then f[row + x] = 3
                        else
                            -- the buddies' paint as heat; where the walls'
                            -- paint is the greater, its blue-grey fringe
                            local v, w = g.buddy[i], g.wallp[i]
                            if w > v then f[row + x] = 42 + math.min(2, math.floor(3 * w / (w + 150)))
                            else f[row + x] = v == 0 and 1 or 32 + math.min(7, math.floor(8 * v / (v + 300))) end
                        end
                    end
                end
            end
            local o = HALL.outline
            for i = 1, #o do
                local j = i % #o + 1
                line(f, px(o[i][1]), py(o[i][2]), px(o[j][1]), py(o[j][2]), 2)
            end
            -- the entrance (white square) and, for the pinwheels, the centre (plus)
            local ex, ey = px(HALL_ENTRANCE[1]), py(HALL_ENTRANCE[2])
            for yy = -2, 2 do for xx = -2, 2 do plot(f, ex + xx, ey + yy, 5) end end
            if p.sys.mode == "pinwheel" or p.sys.mode == "choose" then
                local cx, cy = px(p.sim.cx), py(p.sim.cy)
                line(f, cx - 4, cy, cx + 4, cy, 20); line(f, cx, cy - 4, cx, cy + 4, 20)
            end
            -- rooms: each room's middle (plus); a buddy heading for another
            -- place (a room or a tunnel) gets a thin line to its middle
            if p.sys.mode == "rooms" then
                for _, room in ipairs(g.rooms) do
                    local cx, cy = px(room.cx), py(room.cy)
                    line(f, cx - 4, cy, cx + 4, cy, 20); line(f, cx, cy - 4, cx, cy + 4, 20)
                end
                for _, b in ipairs(p.sim.buddies) do
                    if b.heading then
                        local room = g.places[b.heading]   -- a room or a tunnel (Roam.paint_rooms: g.places)
                        line(f, px(b.x), py(b.y), px(room.cx), py(room.cy), BUDDY[(b.id - 1) % #BUDDY + 1], true)
                    end
                end
            end
            -- buddies, their goals and paths
            for _, b in ipairs(p.sim.buddies) do
                local c = BUDDY[(b.id - 1) % #BUDDY + 1]
                if b.path then for i = b.path_i, #b.path do plot(f, px(b.path[i].x), py(b.path[i].y), c) end end
                if b.goal then
                    local gx, gy = px(b.goal.x), py(b.goal.y)
                    line(f, gx - 2, gy - 2, gx + 2, gy + 2, c); line(f, gx - 2, gy + 2, gx + 2, gy - 2, c)
                end
                disc(f, px(b.x), py(b.y), 3, c)
            end
            -- the panel's number as dots, and its coverage bar
            for d = 1, k do disc(f, p.x0 + 4 + (d - 1) * 6, p.y0 + 4, 1, 5) end
            local cov = Roam.paint_coverage(g)
            local by = p.y0 + PANEL_H + 2
            for yy = 0, BAR_H - 1 do
                for xx = 0, PANEL_W - 1 do f[(by + yy) * W + p.x0 + xx] = xx < cov * PANEL_W and 20 or 19 end
            end
        end
        frames[t] = f
    end
    local path = OUT_DIR .. "/" .. scene.name .. ".gif"
    local bytes = gif.write(path, { width = W, height = H, palette_bytes = palette, frames = frames, delay_cs = DELAY_CS })
    print(string.format("  %-26s %4d frames, %7d bytes (%dx%d)", scene.name .. ".gif", scene.frames, bytes, W, H))
    scene.W, scene.H = W, H
    W, H, SCALE, OX, OY = saveW, saveH, saveS, saveX, saveY
end
-- }}}

local function pm(mode) local r = PAINT_MEASURE[mode]
    return string.format("%.0f%%, %.0f%%, %.0f%% and %.0f%% explored after about 20 seconds, 40 seconds, 1.5 minutes and 6 minutes; %.1f%% of its time within 3 yards of a wall; %.0f%% of its steps onto ground walked in the last 25 seconds; in tunnels %.1f%% of its time, on average %.1f yards off a tunnel's middle line",
        r.cov[1], r.cov[2], r.cov[3], r.cov[4], r.wall, r.revisit, r.tunnel_share, r.tunnel) end
SCENES[#SCENES + 1] = {
    name = "19-painting-compared",
    title = "Exploring as painting: four systems side by side",
    before = "The owner's painting idea, tried **four** ways on one new arena, all four clans of four starting at the same entrance (white square, at the foot of the L). The arena: a main hall with an **L**-shaped leg, a dead-end passage off the leg, and a tunnel from the hall to a side room that leads down a second tunnel to a far room. Each buddy lays paint on what it can **see**, most where it stands, less out to 60 yards; the floor is shaded by how much paint it has (dark: none; warm: much). In every panel the walls paint their **own** fringe too, within 5 yards of themselves, topped up every 3 seconds (blue-grey where the walls' paint is the greater); regenerated 2026-09-27 after the owner saw no wall paint in the first version, where the walls' paint was too weak to matter and was not drawn. The bar under each panel is how much of the arena has been **seen** from within 20 yards. Panels (counted by the white dots in each corner): 1, top left, today's pinwheel (the owner's rules), paint only drawn; 2, top right, the same pinwheel choosing by paint: of its proposal and eight near it, the least painted, farthest from the entrance, wins; 3, bottom left, no pinwheel at all: of 30 random spots 12 to 70 yards off, the least painted wins, and walls paint the ground within 5 yards of themselves every 3 seconds; 4, bottom right, the pinwheel run in the squished circle (the arena mapped onto a disc, see below) choosing by paint. Paths run through **un**painted ground where they can (3 and 4, and 2), and round walls on their own.",
    after = "What the panels show, measured over six minutes of each system from the same start (the generator prints these): 1, today's pinwheel: %s. 2, choosing by paint: %s. 3, least paint and wall paint: %s. 4, the squished circle: %s. The two plain pinwheels **never** reach the tunnels: every waypoint sits on a straight line from the centre, and from the L's centre no straight line runs down the tunnel, so the side and far rooms stay dark whatever paint says. The squished circle **fixes** that: its rim is the whole outline in order, so the tunnels and the dead end are stretches of the circle's edge, and a pinwheel lap in the disc walks into every room; with paint choosing among nearby disc points, it explores everything with the fewest revisits. Least paint alone explores **fast**est but wanders: it has no laps, doubles back more, and its route is hard to predict. For least paint the walls' paint changes **little** in time near walls (%.1f%% without it): its spots are already chosen 3 yards off walls and its paths keep 1.5 yards off; where it matters is the room orbit's tunnels (the next comparison but one, 21). The disc map is made by laying the outline round a circle by distance along it and settling every inner cell at the average of its neighbours (a harmonic map); onto a convex shape like a circle such a map **never** folds, so each point of the disc names one place in the arena (the property in docs/reference/jacobian-conjecture/).",
    render = render_paint_panels,
    frames = 520,
}
SCENES[19].after = string.format(SCENES[19].after, pm("pinwheel"), pm("choose"), pm("least"), pm("disc"), PAINT_MEASURE.least_bare.wall)
-- }}}

-- {{{ rooms and tunnels (21)
-- The owner, after 19: panel 3 (least paint) looked the most natural; the
-- pinwheels' trouble was the whole area's midpoint; rooms should have
-- their own. The same hall and start, four systems: the one the owner
-- liked, the room orbit with paint and walls' paint, the squished circle,
-- and the room orbit without the walls' paint (what the walls' paint does
-- in the tunnels). Shown after the cluster pull (20), so the gallery's
-- numbers stay in order.
local ROOMS_SCENE = {
    name = "21-rooms-and-tunnels",
    title = "Rooms and tunnels: orbiting each room's middle",
    before = "The owner, after the last comparison: \"the third one I think looked the most natural. Don't forget to add the 'paint from walls' behavior! [...] their midpoint is the midpoint of the entire area, when it should be the midpoint of the room that they're in [...] we should identify rooms, as in, not tunnels, and we should orbit around those until the paint system tells us to be drawn toward a tunnel. If the walls extrude paint, then characters will be encouraged to walk through the center of the tunnel, not glide along it's walls.\" The hall is split by how **far** each spot is from the outline: places at least 7 yards deep (14 across) are room middles, the ground within 7 yards of them joins their room, and what is left, the narrow places, is tunnel. Here that makes **three** rooms (the hall with its L, the side room, the far room, each middle marked with a plus) and three tunnels (hall to side room, side room to far room, and the dead end). Panels: 1, least paint with the walls' paint (the one the owner liked); 2, the room orbit: the owner's pinwheel round the middle of the room the buddy is in, in that room's own coordinates, choosing by paint, until the room is 80% explored; then the paint draws it to the least explored place, a room or a tunnel (the dead end too), farther from the entrance weighing more (a thin line to that place while it goes); once every place is past 80%, to the least explored one if it is clearly less explored than where it is, so the last corners get seen; 3, the squished circle with paint; 4, the room orbit without the walls' paint. Walls' paint shows **blue**-grey.",
    after = "Measured over six minutes each from the same start: 1, least paint: %s. 2, the room orbit: %s. 3, the squished circle: %s. 4, the room orbit without the walls' paint: %s. The room orbit reaches **every** room and tunnel, the dead end included, which the whole-area pinwheel of the last comparison never did: each room's own middle sees its own walls, and the paint, not the lap, decides when to go on. Its laps round each room's middle keep it **off** the walls. Panels 2 and 4 show what the walls' paint **does**: with it, a buddy spends less time near walls and walks nearer a tunnel's middle line; it also makes buddies share those middle lines, so more of their steps land on ground walked just before. A first version counted a room as **done** at 80%% and never drew buddies into tunnels: it stopped at 88%% explored, with the dead end and the rooms' last corners unseen.",
    render = render_paint_panels,
    systems = {
        { mode = "least", name = "least paint, walls' paint" },
        { mode = "rooms", name = "room orbit with paint and walls' paint" },
        { mode = "disc",  name = "squished circle with paint" },
        { mode = "rooms", name = "room orbit, no walls' paint", walls = false },
    },
    frames = 520,
}
ROOMS_SCENE.after = string.format(ROOMS_SCENE.after, pm("least"), pm("rooms"), pm("disc"), pm("rooms_bare"))
-- }}}

-- {{{ fighting together: a cluster pull (20)
-- A drawn simulation of the fighting the owner described (617e5), not the
-- game's combat: hit points, damage and cast times are round numbers
-- chosen so the whole sequence fits in the animation. The field: open
-- ground about 240 by 170 yards; two clusters of monsters (monsters within
-- 14 yards of each other are linked: pulling one brings them all) and one
-- elite boss. The clan: a tank (red), a healer (green), a mage (blue), a
-- rogue (yellow, instant attacks only), and a hunter (purple) roaming on
-- its own until it sees its clanmates fighting.
local FIELD_OUTLINE = { { 5, 5 }, { 255, 5 }, { 255, 185 }, { 5, 185 } }
local FIELD = { outline = FIELD_OUTLINE, walls = { { 160, 110, 6 }, { 60, 60, 5 } } }
local LINK, AGGRO, REACH = 16, 10, 4            -- yards: linked monsters, a monster noticing, melee reach
                                                -- (4, wider than the game's, so monsters stay visible round the tank)
-- The blender (the owner, 2026-09-27: "gather nearby enemies, using their
-- ranged taunt abilities to pull them closer so they can be AoE'd down.
-- Think like a blender reaching out and pulling foes into it's maw"):
-- bringing a pack back or holding it, the tank taunts any idle monster
-- within BLENDER_REACH (a ranged taunt's range) into the fight, with its
-- pack, while the fight stays within what it can hold.
local BLENDER_REACH, BLENDER_MAX, BLENDER_EVERY = 30, 6, 60   -- yards; monsters held at most; ticks between taunts
local BLENDER_HEALTH = 50                                        -- the tank's health (of 100) needed to take on more

local function cluster_sim()
    local st = { t = 0, flashes = {} }
    local function unit(role, x, y, color, hp, speed)
        return { role = role, x = x, y = y, color = color, hp = hp, max = hp, speed = speed, cast = 0, hop = 0 }
    end
    st.tank   = unit("tank",   40, 160,  6, 100, 1.4)
    st.healer = unit("healer", 28, 170, 12, 80, 1.3)
    st.mage   = unit("mage",   52, 172,  9, 70, 1.3)
    st.rogue  = unit("rogue",  46, 164,  7, 80, 1.5)
    st.hunter = unit("hunter", 210, 150, 10, 80, 1.5)
    st.buddies = { st.tank, st.healer, st.mage, st.rogue, st.hunter }
    st.hunter.lap = 0
    -- monsters are faster than every buddy (the owner, 2026-09-27: "in the
    -- simulations, the enemies should move faster than the player, so they
    -- can always hit"): 1.6 against the buddies' 1.3 to 1.5 (1.15 before)
    local function mob(x, y, hp, elite) return { x = x, y = y, hp = hp, max = hp, speed = 1.6, elite = elite, state = "idle" } end
    st.mobs = {
        mob(112, 64, 100), mob(126, 60, 100), mob(120, 76, 100), mob(133, 72, 100),   -- cluster 1
        mob(204, 50, 100), mob(217, 54, 100), mob(210, 66, 100),                      -- cluster 2
        mob(92, 118, 420, true),                                                      -- the boss
    }
    st.plan = { { 1, 2, 3, 4 }, { 5, 6, 7 }, { 8 } }   -- what the tank pulls, in order (each group found by the link rule)
    st.step = 1
    return st
end

local function dist(a, b) return math.sqrt((a.x - b.x) ^ 2 + (a.y - b.y) ^ 2) end
local function walk(u, x, y, speed)
    local d = math.sqrt((x - u.x) ^ 2 + (y - u.y) ^ 2)
    if d <= speed then u.x, u.y = x, y return true end
    u.x, u.y = u.x + (x - u.x) / d * speed, u.y + (y - u.y) / d * speed
    return false
end
local function flash(st, kind, a, b, ticks, extra) st.flashes[#st.flashes + 1] = { kind = kind, a = a, b = b, until_t = st.t + ticks, extra = extra } end
local function engaged(st)
    local list = {}
    for _, m in ipairs(st.mobs) do if m.hp > 0 and m.state ~= "idle" then list[#list + 1] = m end end
    return list
end

-- the linked group of a monster: every idle monster within LINK yards of
-- one already in it (the "leash"/link reach of a pack)
local function linked(st, first)
    local group, seen = { first }, { [first] = true }
    local k = 1
    while group[k] do
        for _, m in ipairs(st.mobs) do
            if not seen[m] and m.hp > 0 and m.state == "idle" and dist(m, group[k]) <= LINK then seen[m] = true; group[#group + 1] = m end
        end
        k = k + 1
    end
    return group
end

local function cluster_tick(st, rand)
    st.t = st.t + 1
    local T, Hh, M, R, P = st.tank, st.healer, st.mage, st.rogue, st.hunter
    local fight = engaged(st)
    -- the tank: go to the next pack, notice it, bring it back to the
    -- gathering spot, hold it there
    local target_ids = st.plan[st.step]
    if target_ids then
        local alive = {}
        for _, id in ipairs(target_ids) do if st.mobs[id].hp > 0 then alive[#alive + 1] = st.mobs[id] end end
        if #alive == 0 then st.step, st.gather, T.phase = st.step + 1, nil, nil
        else
            if not st.gather then
                -- the gathering spot: 35 yards back from the pack, toward the clan
                local cx, cy = 0, 0
                for _, m in ipairs(alive) do cx, cy = cx + m.x, cy + m.y end
                cx, cy = cx / #alive, cy / #alive
                local vx, vy = T.x - cx, T.y - cy
                local l = math.sqrt(vx * vx + vy * vy)
                st.gather = { x = cx + vx / l * 35, y = cy + vy / l * 35 }
                T.phase = "go"
            end
            if T.phase == "go" then
                if walk(T, alive[1].x, alive[1].y, T.speed) or dist(T, alive[1]) <= AGGRO then
                    for _, m in ipairs(linked(st, alive[1])) do m.state, m.target = "chase", T end
                    T.phase = "back"
                end
            elseif T.phase == "back" then
                if walk(T, st.gather.x, st.gather.y, T.speed) then T.phase = "hold" end
            elseif T.phase == "hold" and #fight == 0 then
                -- the pulled ones are down but some of this pack were
                -- left behind (out of link reach): go again
                st.gather, T.phase = nil, nil
            end
        end
    end
    -- the blender: reach out and taunt the nearest idle monster in range
    -- (and its linked pack) while bringing a pack back or holding it
    if (T.phase == "back" or T.phase == "hold") and (T.pull_ready or 0) <= st.t and T.hp > BLENDER_HEALTH then
        local best, bd
        for _, m in ipairs(st.mobs) do
            if m.hp > 0 and m.state == "idle" then
                local d = dist(T, m)
                if d <= BLENDER_REACH and (not bd or d < bd) then best, bd = m, d end
            end
        end
        if best then
            local pack = linked(st, best)
            if #engaged(st) + #pack <= BLENDER_MAX then
                for _, m in ipairs(pack) do m.state, m.target = "chase", T end
                flash(st, "pull", T, best, 14)
                T.pull_ready = st.t + BLENDER_EVERY
            end
        end
    end
    -- monsters chase their target and hit it in reach (slowed by frost)
    for _, m in ipairs(st.mobs) do
        if m.hp > 0 and m.target then
            local sp = m.speed * ((m.slow_until or 0) > st.t and 0.4 or 1)
            if dist(m, m.target) > REACH then walk(m, m.target.x, m.target.y, sp)
            else m.state = "fight"; m.target.hp = math.max(1, m.target.hp - (m.elite and 0.3 or 0.12)) end
        end
    end
    -- the group comes to the gathering spot when the tank holds
    local g = st.gather or { x = T.x, y = T.y }
    if T.phase == "hold" or #fight > 0 then
        if (M.blink_until or 0) <= st.t and not M.peeled then walk(M, g.x - 14, g.y + 10, M.speed) end
        walk(Hh, g.x - 20, g.y + 16, Hh.speed)
    end
    local fighting_near = #fight > 0 and (T.phase == "hold" or T.phase == "back")
    -- the healer: heal the tank when it is hurt (a 25-tick cast)
    if Hh.cast > 0 then Hh.cast = Hh.cast - 1; if Hh.cast == 0 then T.hp = math.min(T.max, T.hp + 30); flash(st, "heal", Hh, T, 8) end
    elseif T.hp < 80 and dist(Hh, T) < 40 then Hh.cast = 25 end
    -- the mage: area spells on a pack, single spells otherwise; on a boss,
    -- both about equally; a monster that turns on it gets a frostbolt
    -- (slowed), then it blinks away and the tank takes it back
    local peeler
    for _, m in ipairs(fight) do if m.target == M then peeler = m end end
    if peeler and not M.peeled then
        M.peeled = true; M.cast = 0
        flash(st, "frost", M, peeler, 10); peeler.slow_until = st.t + 90; peeler.hp = peeler.hp - 22
        M.blink_at = st.t + 10
    end
    if M.blink_at and st.t >= M.blink_at then
        local from = { x = M.x, y = M.y }
        local ax, ay = M.x - (M.peel_x or M.x), M.y - (M.peel_y or M.y)
        local l = math.sqrt(ax * ax + ay * ay); if l < 0.1 then ax, ay, l = -1, 0.3, 1.04 end
        M.x, M.y = M.x + ax / l * 18, M.y + ay / l * 18
        flash(st, "blink", from, { x = M.x, y = M.y }, 12)
        M.blink_at, M.blink_until = nil, st.t + 30
        for _, m in ipairs(fight) do if m.target == M then m.target = T; flash(st, "taunt", T, m, 8) end end
        M.peeled = false
    end
    if not fighting_near and M.cast > 0 then M.cast = 0 end   -- nothing left to cast at: the cast stops
    if fighting_near and not M.blink_at and (M.blink_until or 0) <= st.t then
        if M.cast > 0 then
            M.cast = M.cast - 1
            if M.spell == "aoe" then
                for _, m in ipairs(st.mobs) do
                    if m.hp > 0 and (m.x - M.aoe.x) ^ 2 + (m.y - M.aoe.y) ^ 2 <= 64 then
                        m.hp = m.hp - 1.1
                        -- the pack's last monster notices the mage once, the first time the storm lands
                        if not st.peeled_once and m == st.mobs[4] and M.cast < 40 then m.target, st.peeled_once = M, true; M.peel_x, M.peel_y = m.x, m.y end
                    end
                end
            elseif M.cast == 0 then
                local tgt = T.target_mob
                if tgt and tgt.hp > 0 then tgt.hp = tgt.hp - 24; flash(st, "frost", M, tgt, 6) end
            end
        else
            local cx, cy, n = 0, 0, 0
            for _, m in ipairs(fight) do cx, cy, n = cx + m.x, cy + m.y, n + 1 end
            cx, cy = cx / math.max(n, 1), cy / math.max(n, 1)
            local packed = 0
            for _, m in ipairs(fight) do if (m.x - cx) ^ 2 + (m.y - cy) ^ 2 <= 64 then packed = packed + 1 end end
            local boss = false
            for _, m in ipairs(fight) do if m.elite then boss = true end end
            local aoe = packed >= 2 or (boss and rand() < 0.5)
            -- in range first (30 yards): out of it, walk in
            if (M.x - cx) ^ 2 + (M.y - cy) ^ 2 > 900 then walk(M, cx, cy, M.speed)
            elseif aoe then M.spell, M.cast, M.aoe = "aoe", 50, { x = cx, y = cy } else M.spell, M.cast = "bolt", 20 end
        end
    end
    -- the tank's current target: the monster hitting it with the least health
    T.target_mob = nil
    for _, m in ipairs(fight) do if m.target == T and (not T.target_mob or m.hp < T.target_mob.hp) then T.target_mob = m end end
    -- the rogue: instant attacks only, so it keeps moving: at its target's
    -- side, hopping to a new spot now and then; fan of knives on a pack
    if fighting_near and T.target_mob then
        local tg = T.target_mob
        if (R.next_hop or 0) <= st.t then
            local a = rand() * 2 * math.pi
            R.spot = { x = tg.x + math.cos(a) * 2, y = tg.y + math.sin(a) * 2 }
            R.next_hop, R.hop = st.t + 22 + math.floor(rand() * 10), 5
        end
        walk(R, R.spot.x, R.spot.y, R.speed)
        if dist(R, tg) <= REACH + 1 then tg.hp = tg.hp - 0.7 end
        if st.t % 30 == 0 then
            local near = 0
            for _, m in ipairs(fight) do if dist(m, R) <= 8 then near = near + 1 end end
            if near >= 3 then for _, m in ipairs(fight) do if dist(m, R) <= 8 then m.hp = m.hp - 6 end end; flash(st, "fan", R, R, 6) end
        end
    elseif T.phase ~= "hold" then walk(R, T.x - 6, T.y + 4, R.speed) end
    if R.hop > 0 then R.hop = R.hop - 1 end
    -- the hunter: its own lap until a clanmate within 90 yards is
    -- fighting; then it comes to help and shoots the tank's target
    local helping = false
    for _, b in ipairs({ T, M, R, Hh }) do
        for _, m in ipairs(fight) do if m.target == b and dist(P, b) <= 90 then helping = true end end
    end
    if helping and T.target_mob then
        P.helping = true
        if dist(P, T.target_mob) > 25 then walk(P, T.target_mob.x, T.target_mob.y, P.speed)
        else T.target_mob.hp = T.target_mob.hp - 0.5; if st.t % 12 == 0 then flash(st, "shot", P, T.target_mob, 4) end end
    elseif not P.helping then
        P.lap = P.lap + 0.012
        walk(P, 200 + math.cos(P.lap) * 22, 150 + math.sin(P.lap) * 14, P.speed * 0.6)
    elseif #fight == 0 then walk(P, T.x + 10, T.y + 8, P.speed) end
    -- the dead
    for _, m in ipairs(st.mobs) do if m.hp <= 0 and m.state ~= "dead" then m.state, m.target = "dead", nil end end
end

local function render_cluster(scene)
    local saveW, saveH, saveS, saveX, saveY = W, H, SCALE, OX, OY
    W, H, SCALE, OX, OY = 540, 400, 2.0, 10, 15
    local rand = lcg(scene.seed or 3)
    local st = cluster_sim()
    local base = base_map(FIELD)
    local frames = {}
    for t = 1, scene.frames do
        cluster_tick(st, rand)
        local f = new_frame()
        copy(f, base)
        -- links between monsters of a pack not yet pulled
        for i, a in ipairs(st.mobs) do
            if a.hp > 0 and a.state == "idle" then
                ring(f, px(a.x), py(a.y), AGGRO * SCALE, 17, true)
                for j = i + 1, #st.mobs do
                    local b = st.mobs[j]
                    if b.hp > 0 and b.state == "idle" and dist(a, b) <= LINK then line(f, px(a.x), py(a.y), px(b.x), py(b.y), 21, true) end
                end
            end
        end
        if st.gather then
            local gx, gy = px(st.gather.x), py(st.gather.y)
            ring(f, gx, gy, 6, 20, true)
        end
        -- the mage's area spell
        if st.mage.cast > 0 and st.mage.spell == "aoe" then
            local ax, ay = px(st.mage.aoe.x), py(st.mage.aoe.y)
            for yy = -16, 16, 3 do for xx = -16, 16, 3 do if xx * xx + yy * yy <= 256 then plot(f, ax + xx + (t % 3), ay + yy, 40) end end end
            ring(f, ax, ay, 16, 40)
        end
        for _, fl in ipairs(st.flashes) do
            if fl.until_t >= st.t then
                local colour = ({ heal = 12, frost = 41, blink = 5, taunt = 6, shot = 10, fan = 7, pull = 15 })[fl.kind]
                if fl.kind == "fan" then ring(f, px(fl.a.x), py(fl.a.y), 8 * SCALE, 7)
                else line(f, px(fl.a.x), py(fl.a.y), px(fl.b.x), py(fl.b.y), colour, fl.kind == "blink") end
            end
        end
        for _, m in ipairs(st.mobs) do
            local x, y = px(m.x), py(m.y)
            if m.hp > 0 then
                disc(f, x, y, m.elite and 5 or 3, 13)
                if (m.slow_until or 0) > st.t then ring(f, x, y, (m.elite and 5 or 3) + 2, 41) end
                if m.state ~= "idle" then
                    local w = m.elite and 14 or 8
                    for xx = 0, w - 1 do plot(f, x - w / 2 + xx, y - 7, xx < w * m.hp / m.max and 12 or 19) end
                end
            else
                line(f, x - 2, y - 2, x + 2, y + 2, 19); line(f, x - 2, y + 2, x + 2, y - 2, 19)
            end
        end
        for _, b in ipairs(st.buddies) do
            local x, y = px(b.x), py(b.y)
            disc(f, x, y, 4, b.color)
            if b.hop and b.hop > 0 then ring(f, x, y - 3, 6, b.color) end
            if b.cast > 0 then ring(f, x, y, 7, 20, true) end
            if b == st.tank then for xx = 0, 9 do plot(f, x - 5 + xx, y - 8, xx < 10 * b.hp / b.max and 12 or 19) end end
            if b == st.hunter and b.helping and #engaged(st) > 0 and dist(b, st.tank) > 30 then line(f, x, y, px(st.tank.x), py(st.tank.y), 10, true) end
        end
        frames[t] = f
    end
    local path = OUT_DIR .. "/" .. scene.name .. ".gif"
    local bytes = gif.write(path, { width = W, height = H, palette_bytes = palette, frames = frames, delay_cs = DELAY_CS })
    print(string.format("  %-26s %4d frames, %7d bytes (%dx%d)", scene.name .. ".gif", scene.frames, bytes, W, H))
    -- what happened, so the caption can be checked against it
    local kinds = {}
    for _, fl in ipairs(st.flashes) do kinds[fl.kind] = (kinds[fl.kind] or 0) + 1 end
    local dead = 0
    for _, m in ipairs(st.mobs) do if m.hp <= 0 then dead = dead + 1 end end
    print(string.format("    events: heal %d, frost %d, blink %d, taunt %d, pull %d, shot %d, fan %d; monsters down %d of %d",
        kinds.heal or 0, kinds.frost or 0, kinds.blink or 0, kinds.taunt or 0, kinds.pull or 0, kinds.shot or 0, kinds.fan or 0, dead, #st.mobs))
    scene.W, scene.H = W, H
    W, H, SCALE, OX, OY = saveW, saveH, saveS, saveX, saveY
end

SCENES[#SCENES + 1] = {
    name = "20-cluster-pull",
    title = "Fighting together: pulling a pack",
    before = "Monsters move **faster** than every buddy (the owner: \"the enemies should move faster than the player, so they can always hit\"). The owner's fighting design (617e5), drawn as a **simple** simulation, not the game's combat: health, damage and casting times are round numbers picked so the whole sequence fits. Monsters (red) within 16 yards of each other are one pack (faint lines join them; dashed circles are how near a buddy must come to be noticed): pulling one brings them **all**. The tank (red) walks up to a pack, is noticed, and brings the **whole** pack back to a gathering spot (dashed white circle) 35 yards toward its clan; while bringing it back and holding it there, it reaches out and taunts any other monster within 30 yards into the fight (a gold line), the owner's \"blender reaching out and pulling foes into it's maw\", as long as the fight stays within what it can hold (six monsters, its health above half). The mage (blue) casts an **area** spell (blue storm) when two or more monsters stand together, single frostbolts otherwise; the rogue (yellow, instant attacks only) keeps moving at its target's side, hopping (a ring over it) now and then, and fans its knives (a yellow ring) when three are round it; the healer (green) heals the tank (green line). The hunter (purple) roams on its **own** until it sees its clanmates fighting within 90 yards, then comes to help (dashed line) and shoots the tank's target.",
    after = "The elite boss stands about 25 yards from the first pack's gathering spot, so the tank taunts it **in** while bringing the first pack back, and the first fight takes the pack and the boss together, down in the same area spells (in the first version the tank left the boss for a third fight of its own). Then the **second** pack. With the first pack, the storm draws one monster onto the mage: it frostbolts it (a blue ring: slowed), **blinks** away (dashed white line), and the tank takes it back (red line), the owner's \"blink to try and get distance, ideally after doing a frostbolt to slow them down\". While the boss is in the fight the mage weighs area and single spells about **equally**, as the owner put it (\"unless there's a boss or something, in which case they'll prefer AoE and single-target spells roughly equally\"). What this **needs** from the game, for 617e5: finding packs by the server's own link and assist ranges, a gathering spot clear of other packs, and the damage dealers' area-spell thresholds lowered for buddies; playerbots already has area and single-target strategies to weigh.",
    render = render_cluster,
    frames = 760,
}
-- }}}

SCENES[#SCENES + 1] = ROOMS_SCENE

-- {{{ the kraken: a battle pattern (22, 23)
-- The owner, 2026-09-27 (617e5): "picture a kraken sitting at the base of a
-- massive whirlpool. It has tentacles that reach out and grab nearby ships
-- and pulls them into it's insatiable maw." A drawn simulation of that
-- pattern, not the game's combat: health, damage, speeds and cast times are
-- round numbers picked so a whole run fits in the animation.
--   the maw       - the spot where the pack is held and the area spells land
--                   (a blue ring, AOE yards across its middle)
--   the tank      - stays within TANK_ROOM of the maw, leaning toward the
--                   nearest outside monster; reaches it with its taunt
--                   (TAUNT yards: a gold tentacle line), and steps to the
--                   maw's far side from a newly taken monster until that one
--                   is inside the maw
--   the tentacles - the tank's taunts, and the ranged damage dealers' pulls:
--                   a mage or hunter orbits the maw (instants on the move),
--                   goes out to a monster the tank can't reach, hits it once
--                   and slows it (a pale blue ring), then leads it to the far
--                   side of a NEIGHBOURING quadrant of the maw (never the
--                   opposite one), blinking or disengaging when it comes too
--                   close, and keeps kiting round the maw until the tank
--                   takes it (the owner: "until the tank picks them up")
--   moving on     - when every monster held is dead and the maw is empty, the
--                   whole formation goes to the next pack
-- The quadrants are drawn faintly round the maw. Counts of what happened are
-- kept, and the caption reads them (they are not typed in).
local KF = { outline = { { 5, 5 }, { 300, 5 }, { 300, 222 }, { 5, 222 } }, walls = { { 128, 190, 6 }, { 214, 132, 5 } } }
-- the patrols of 22: L-shaped routes, each three points, walked back and
-- forth; chosen to cross the ground where the stops' fights happen, so the
-- patrols blunder in
local PATROLS_22 = {
    { { 30, 60 }, { 120, 60 }, { 120, 110 } },
    { { 212, 136 }, { 212, 60 }, { 272, 60 } },
    { { 140, 196 }, { 206, 196 }, { 206, 140 } },
    { { 286, 96 }, { 286, 196 }, { 232, 196 } },
    { { 40, 176 }, { 146, 176 }, { 146, 116 } },
    { { 236, 18 }, { 292, 18 }, { 292, 80 } },
    { { 18, 118 }, { 18, 40 }, { 90, 40 } },
}
local K = {
    AOE = 10, TANK_ROOM = 6, TAUNT = 30, ORBIT = 24, PULL_SCAN = 70, HOLD_MAX = 8,
    PATROL = 0.5,   -- a patrol's walking pace (the fights' pace is 1.3 to 1.45)
    TAUNT_EVERY = 40, LINK = 12, AGGRO = 7, REACH = 3.5, MAW_BACK = 20,
    SLOW = 0.6, SLOW_TICKS = 140, ESCAPE = 8, JUMP = 14, JUMP_EVERY = 90,
    TRAVEL = 1.8,   -- between stops the formation runs (a faster pace, so the drawing spends its time on the fights)
}
local function kd(a, b) return math.sqrt((a.x - b.x) ^ 2 + (a.y - b.y) ^ 2) end
local function kwalk(u, x, y, speed)
    local d = math.sqrt((x - u.x) ^ 2 + (y - u.y) ^ 2)
    if d <= speed then u.x, u.y = x, y return true end
    u.x, u.y = u.x + (x - u.x) / d * speed, u.y + (y - u.y) / d * speed
    return false
end
-- In the dungeon (26) the ground has walls: KGRID is its paint grid, and
-- every move goes through kmove, which walks straight where the line is
-- clear and otherwise along a grid path (Roam.paint_path, kept for a while
-- and remade when the target has moved). KGRID is nil for the open fields of
-- 22 and 23, where kmove is kwalk exactly, so those runs are unchanged.
local KGRID, KNOW = nil, 0
local function kmove(u, x, y, speed)
    if not KGRID then return kwalk(u, x, y, speed) end
    if Roam.paint_line_clear(KGRID, u.x, u.y, x, y) then u.gp = nil return kwalk(u, x, y, speed) end
    if not u.gp or KNOW - u.gp_t > 25 or (u.gp_goal.x - x) ^ 2 + (u.gp_goal.y - y) ^ 2 > 36 then
        u.gp, u.gp_i, u.gp_t, u.gp_goal = Roam.paint_path(KGRID, u.x, u.y, x, y, 0), 1, KNOW, { x = x, y = y }
    end
    if not u.gp then return false end
    local p = u.gp[u.gp_i]
    if kwalk(u, p.x, p.y, speed) then
        u.gp_i = u.gp_i + 1
        if u.gp_i > #u.gp then u.gp = nil return true end
    end
    return false
end
local function kflash(st, kind, a, b, ticks) st.flashes[#st.flashes + 1] = { kind = kind, a = { x = a.x, y = a.y }, b = b, until_t = st.t + ticks } end
local function kcount(st, what) st.counts[what] = (st.counts[what] or 0) + 1 end

-- {{{ local function kraken_sim
-- `owner_tanks`: the owner (white) is the tank; the buddies run the pattern
-- round it only at a pack of 3 or more standing within area-spell reach of
-- each other (the owner: "only if 3 or more monsters are near each other and
-- AoE-able"); at anything smaller they just fight beside it.
local function kraken_sim(owner_tanks)
    local st = { t = 0, flashes = {}, counts = {}, owner_tanks = owner_tanks }
    local function unit(role, x, y, color, hp, speed) return { role = role, x = x, y = y, color = color, hp = hp, max = hp, speed = speed, cast = 0, hop = 0, jump_ready = 0 } end
    st.tank   = unit("tank",   36, 196, owner_tanks and 5 or 6, 100, 1.4)
    st.healer = unit("healer", 24, 206, 12, 80, 1.3)
    st.mage   = unit("mage",   48, 208, 9, 70, 1.35)
    st.hunter = unit("hunter", 30, 186, 10, 80, 1.35)
    st.rogue  = unit("rogue",  44, 190, 7, 80, 1.45)
    st.buddies = { st.tank, st.healer, st.mage, st.hunter, st.rogue }
    st.mage.dir, st.hunter.dir = 1, -1
    -- monsters are faster than every buddy (the owner, 2026-09-27: "in the
    -- simulations, the enemies should move faster than the player, so they
    -- can always hit"): 1.6 against the buddies' 1.3 to 1.45 (1.35 before,
    -- as fast as the ranged buddies). No puller out-walks a monster: a slow
    -- (x0.6: 0.96), a blink, a disengage or the tank's taunt is what saves it
    local function mob(x, y, hp) return { x = x, y = y, hp = hp or 100, max = hp or 100, speed = 1.6, state = "idle" } end
    -- a patrol: starts at its route's first point and walks it (an L: three
    -- points) to the end and back, at K.PATROL
    local function patrol(route) local m = mob(route[1][1], route[1][2]); m.route, m.route_i, m.route_dir = route, 2, 1; return m end
    st.patrol = patrol
    if owner_tanks then
        st.mobs = {
            mob(96, 150),                                                 -- a lone one: an ordinary fight
            mob(176, 96), mob(186, 90), mob(182, 104), mob(192, 100),     -- a pack of four: the kraken
            mob(152, 70), mob(214, 122),                                  -- outliers, for the tentacles
        }
    else
        -- a third are patrols (the owner, 2026-09-27: "can we make 1/3rd of
        -- the monsters be patrols that wander? Just on a set path, an L shape
        -- is enough for this size map."): 14 standing, 7 walking L-shaped
        -- routes back and forth. Six outliers of the first version made way
        -- for them.
        st.mobs = {
            mob(76, 128), mob(86, 122), mob(82, 136),                     -- stop 1: a pack of three
            mob(110, 156),                                                --   one within the taunt
            mob(170, 74), mob(181, 68), mob(177, 84), mob(188, 79),       -- stop 2: a pack of four
            mob(146, 44), mob(152, 36),                                   --   a pair beyond the taunt
            mob(252, 166), mob(264, 160), mob(258, 176, 260),             -- stop 3: two and a tougher one
            mob(226, 200),                                                --   an outlier
        }
        for _, r in ipairs(PATROLS_22) do st.mobs[#st.mobs + 1] = patrol(r) end
    end
    st.phase = "travel"
    return st
end
-- }}}

-- {{{ kraken helpers
-- the linked pack of an idle monster (idle monsters within LINK yards of
-- one already in it)
local function kpack(st, first)
    local group, seen, k = { first }, { [first] = true }, 1
    while group[k] do
        for _, m in ipairs(st.mobs) do
            if not seen[m] and m.hp > 0 and m.state == "idle" and kd(m, group[k]) <= K.LINK then seen[m] = true; group[#group + 1] = m end
        end
        k = k + 1
    end
    return group
end
local function kheld(st)
    local list = {}
    for _, m in ipairs(st.mobs) do if m.hp > 0 and m.state ~= "idle" then list[#list + 1] = m end end
    return list
end
local function kwake(st, m, who)
    for _, p in ipairs(kpack(st, m)) do p.state, p.target = "chase", who end
end
-- the next stop: the nearest idle monster's pack; the maw MAW_BACK yards
-- short of the pack's middle, toward the formation. Returns the pack too.
local function knext_stop(st)
    local T, best, bd = st.tank, nil, nil
    -- standing monsters first: a patrol walks away from a stop chosen on it;
    -- once only patrols are left, the nearest of them
    for pass = 1, 2 do
        for _, m in ipairs(st.mobs) do
            if m.hp > 0 and m.state == "idle" and (pass == 2 or not m.route) then
                local d = kd(T, m)
                if not bd or d < bd then best, bd = m, d end
            end
        end
        if best then break end
    end
    if not best then return nil end
    local pack = kpack(st, best)
    local cx, cy = 0, 0
    for _, m in ipairs(pack) do cx, cy = cx + m.x, cy + m.y end
    cx, cy = cx / #pack, cy / #pack
    local vx, vy = T.x - cx, T.y - cy
    local l = math.max(0.01, math.sqrt(vx * vx + vy * vy))
    return { x = cx + vx / l * K.MAW_BACK, y = cy + vy / l * K.MAW_BACK }, pack
end
-- a pack "AoE-able": 3 or more of it within the maw's reach of its middle
local function kaoeable(pack)
    local cx, cy = 0, 0
    for _, m in ipairs(pack) do cx, cy = cx + m.x, cy + m.y end
    cx, cy = cx / #pack, cy / #pack
    local n = 0
    for _, m in ipairs(pack) do if (m.x - cx) ^ 2 + (m.y - cy) ^ 2 <= (2 * K.AOE) ^ 2 then n = n + 1 end end
    return n >= 3
end
-- }}}

-- {{{ local function kraken_tick
local function kraken_tick(st, rand)
    st.t = st.t + 1
    local T, Hh, M, P, R = st.tank, st.healer, st.mage, st.hunter, st.rogue
    local held = kheld(st)
    -- moving on: nothing held and nothing in the maw: the next stop
    if st.phase == "fight" and #held == 0 then
        -- in the dungeon (26) the formation goes back to exploring; on the
        -- open fields, to the next stop
        st.phase = st.dungeon and "explore" or "travel"
        kcount(st, "moved_on")
    end
    if st.phase == "travel" and not st.maw_next then
        st.maw_next, st.stop_pack = knext_stop(st)
        if not st.maw_next then st.phase = "done" end
    end
    if st.phase == "travel" then
        local g = st.maw_next
        -- the tank leads; the others fall in behind
        if kmove(T, g.x, g.y, T.speed * K.TRAVEL) then
            st.maw, st.maw_next, st.phase = g, nil, "fight"
            -- the owner's rule: the pattern only at a pack of 3+ in reach
            st.kraken = (not st.owner_tanks) or kaoeable(st.stop_pack)
            if st.kraken then kcount(st, "kraken_stops") else kcount(st, "plain_stops") end
            -- the opening: the tank takes the pack's nearest
            local first, fd
            for _, m in ipairs(st.stop_pack) do if m.hp > 0 and m.state == "idle" and (not fd or kd(T, m) < fd) then first, fd = m, kd(T, m) end end
            if first then
                kwake(st, first, T)
                kflash(st, "tentacle", T, first, 14); kcount(st, "taunts")
            end
        end
        for i, b in ipairs({ Hh, M, P, R }) do kmove(b, T.x - 10 + i * 4, T.y + 8 + (i % 2) * 4, b.speed * K.TRAVEL) end
    end
    local maw = st.maw or { x = T.x, y = T.y }
    held = kheld(st)
    -- idle monsters notice a buddy that comes within AGGRO yards
    for _, m in ipairs(st.mobs) do
        if m.hp > 0 and m.state == "idle" then
            for _, b in ipairs(st.buddies) do if kd(m, b) <= K.AGGRO then kwake(st, m, b); kcount(st, "noticed") break end end
        end
    end
    if st.phase == "fight" then
        -- {{{ the tank
        -- pick-up: an engaged monster on someone else, within the taunt:
        -- taunt it, and step to the maw's far side from it until it's in
        if T.taunt_ready == nil or T.taunt_ready <= st.t then
            for _, m in ipairs(held) do
                if m.target ~= T and kd(T, m) <= K.TAUNT then
                    m.target = T
                    kflash(st, "tentacle", T, m, 12); kcount(st, "taunts"); kcount(st, "pickups")
                    T.taunt_ready, T.step_from = st.t + K.TAUNT_EVERY, m
                    break
                end
            end
        end
        -- reach: while holding what it can, taunt the nearest idle monster
        -- in reach (its pack comes too); lean toward it within the room
        local lean
        if st.kraken and #held < K.HOLD_MAX and T.hp > 50 then
            local best, bd
            for _, m in ipairs(st.mobs) do
                if m.hp > 0 and m.state == "idle" and not m.claimed then
                    local d = kd(maw, m)
                    if d <= K.TAUNT + K.TANK_ROOM and (not bd or d < bd) then best, bd = m, d end
                end
            end
            if best then
                lean = best
                if kd(T, best) <= K.TAUNT and (T.taunt_ready or 0) <= st.t then
                    kwake(st, best, T)
                    kflash(st, "tentacle", T, best, 14); kcount(st, "taunts"); kcount(st, "tank_pulls")
                    T.taunt_ready, T.step_from = st.t + K.TAUNT_EVERY, best
                end
            end
        end
        local gx, gy = maw.x, maw.y
        if T.step_from and T.step_from.hp > 0 and kd(T.step_from, maw) > K.AOE then
            local vx, vy = T.step_from.x - maw.x, T.step_from.y - maw.y
            local l = math.max(0.01, math.sqrt(vx * vx + vy * vy))
            gx, gy = maw.x - vx / l * K.TANK_ROOM, maw.y - vy / l * K.TANK_ROOM
        else
            T.step_from = nil
            if lean then
                local vx, vy = lean.x - maw.x, lean.y - maw.y
                local l = math.max(0.01, math.sqrt(vx * vx + vy * vy))
                gx, gy = maw.x + vx / l * K.TANK_ROOM, maw.y + vy / l * K.TANK_ROOM
            end
        end
        kmove(T, gx, gy, T.speed)
        -- }}}
    end
    held = kheld(st)
    -- the tank's target: the monster on it with the least health
    T.target_mob = nil
    for _, m in ipairs(held) do if m.target == T and (not T.target_mob or m.hp < T.target_mob.hp) then T.target_mob = m end end
    local in_maw = 0
    for _, m in ipairs(held) do if kd(m, maw) <= K.AOE then in_maw = in_maw + 1 end end
    -- {{{ the pullers: mage and hunter
    for _, B in ipairs({ M, P }) do
        if st.phase == "fight" then
            -- their monster: one that is on them
            local chaser
            for _, m in ipairs(held) do if m.target == B and (not chaser or kd(m, B) < kd(chaser, B)) then chaser = m end end
            if B.state == "approach" and B.claim and (B.claim.hp <= 0 or B.claim.state ~= "idle") then B.state, B.claim = nil, nil end
            if chaser and B.state ~= "draw" then B.state = "kite" end
            if not chaser and (B.state == "kite" or B.state == "draw") then B.state = nil end
            -- choose a pull: an idle monster the tank can't reach, within
            -- PULL_SCAN of the maw, nobody's claim, nearest to this puller
            if st.kraken and not B.state and #held < K.HOLD_MAX and (B.pull_ready or 0) <= st.t then
                local best, bd
                for _, m in ipairs(st.mobs) do
                    if m.hp > 0 and m.state == "idle" and not m.claimed and kd(T, m) > K.TAUNT and kd(maw, m) <= K.PULL_SCAN then
                        local d = kd(B, m)
                        if not bd or d < bd then best, bd = m, d end
                    end
                end
                if best then B.state, B.claim, best.claimed = "approach", best, true end
            end
            local ang = math.atan2(B.y - maw.y, B.x - maw.x)
            if B.state == "approach" then
                local m = B.claim
                if kd(B, m) <= 26 then
                    -- the tag: one hit, and a slow
                    m.hp = m.hp - 5; m.slow_until = st.t + K.SLOW_TICKS; m.claimed = nil
                    kwake(st, m, B)
                    kflash(st, B == M and "frost" or "shot", B, m, 10); kcount(st, "ranged_pulls"); kcount(st, "slows")
                    -- lead it to the far side of a NEIGHBOURING quadrant
                    local q = math.floor(((math.atan2(m.y - maw.y, m.x - maw.x) % (2 * math.pi)) / (math.pi / 2)))
                    local side = (((ang - math.atan2(m.y - maw.y, m.x - maw.x)) % (2 * math.pi)) < math.pi) and 1 or -1
                    local nq = (q + side) % 4
                    -- the far edge of that quadrant, away from the monster's
                    local a = side > 0 and ((nq + 1) * math.pi / 2 - 0.25) or (nq * math.pi / 2 + 0.25)
                    B.dest = { x = maw.x + math.cos(a) * K.ORBIT, y = maw.y + math.sin(a) * K.ORBIT }
                    B.dir, B.state, B.claim = side, "draw", nil
                    B.pull_ready = st.t + 60
                else
                    kmove(B, m.x, m.y, B.speed)
                end
            elseif B.state == "draw" or B.state == "kite" then
                -- a cast-time spell on the monster leading it: the mage's
                -- frostbolt, the hunter's aimed shot. The puller stands to
                -- cast, so the monster closes in; that is what makes the
                -- blink or disengage needed (walking away at the same speed,
                -- nothing ever catches it)
                if B.cast > 0 and chaser then
                    B.cast = B.cast - 1
                    if B.cast == 0 then
                        chaser.hp = chaser.hp - 20
                        if B == M then chaser.slow_until = st.t + K.SLOW_TICKS; kcount(st, "slows") end
                        kflash(st, B == M and "frost" or "shot", B, chaser, 8)
                    end
                    if kd(chaser, B) <= K.ESCAPE then B.cast = 0 end       -- too close: the cast is dropped for the escape below
                elseif chaser and kd(chaser, B) > 16 and (B.cast_ready or 0) <= st.t then
                    B.cast, B.cast_ready = (B == M and 30 or 24), st.t + 70
                end
                -- too close: blink / disengage, onward round the circle
                if B.cast > 0 then
                    -- standing to cast
                elseif chaser and kd(chaser, B) <= K.ESCAPE and B.jump_ready <= st.t then
                    local from = { x = B.x, y = B.y }
                    local na = ang + B.dir * K.JUMP / K.ORBIT
                    B.x, B.y = maw.x + math.cos(na) * K.ORBIT, maw.y + math.sin(na) * K.ORBIT
                    kflash(st, "jump", from, { x = B.x, y = B.y }, 12)
                    kcount(st, B == M and "blinks" or "disengages")
                    B.jump_ready = st.t + K.JUMP_EVERY
                elseif B.state == "draw" then
                    if kmove(B, B.dest.x, B.dest.y, B.speed) then B.state = "kite" end
                else
                    -- kiting round the maw until the tank takes it
                    local na = ang + B.dir * B.speed / K.ORBIT
                    kmove(B, maw.x + math.cos(na) * K.ORBIT, maw.y + math.sin(na) * K.ORBIT, B.speed)
                    if chaser and (chaser.slow_until or 0) < st.t and (B.reslow_ready or 0) <= st.t then
                        chaser.slow_until = st.t + K.SLOW_TICKS; B.reslow_ready = st.t + 80
                        kflash(st, B == M and "frost" or "shot", B, chaser, 8); kcount(st, "slows")
                    end
                end
            else
                -- orbiting the maw: instants on the move; the mage stops to
                -- cast its area spell when two or more are in the maw
                if B == M and M.cast > 0 then
                    M.cast = M.cast - 1
                    if M.spell == "aoe" then
                        for _, m in ipairs(held) do if kd(m, maw) <= K.AOE then m.hp = m.hp - 1.3 end end
                    elseif M.cast == 0 and T.target_mob then T.target_mob.hp = T.target_mob.hp - 22; kflash(st, "frost", M, T.target_mob, 6) end
                elseif B == M and #held > 0 and in_maw >= 2 and st.kraken then
                    M.spell, M.cast = "aoe", 40; kcount(st, "area_spells")
                elseif B == M and #held > 0 and T.target_mob and not st.kraken then
                    M.spell, M.cast = "bolt", 18
                else
                    local na = ang + B.dir * B.speed / K.ORBIT
                    kmove(B, maw.x + math.cos(na) * K.ORBIT, maw.y + math.sin(na) * K.ORBIT, B.speed)
                    if T.target_mob and st.t % 12 == (B == M and 0 or 6) then
                        T.target_mob.hp = T.target_mob.hp - 3
                        kflash(st, B == M and "frost" or "shot", B, T.target_mob, 4)
                    end
                end
            end
        end
    end
    -- }}}
    -- {{{ the rogue and the healer
    if st.phase == "fight" and T.target_mob then
        local tg = T.target_mob
        if (R.next_hop or 0) <= st.t then
            local a = rand() * 2 * math.pi
            R.spot = { x = tg.x + math.cos(a) * 2, y = tg.y + math.sin(a) * 2 }
            R.next_hop, R.hop = st.t + 22 + math.floor(rand() * 10), 5
        end
        kmove(R, R.spot.x, R.spot.y, R.speed)
        if kd(R, tg) <= K.REACH + 1 then tg.hp = tg.hp - 0.6 end
        if st.kraken and st.t % 30 == 0 then
            local near = 0
            for _, m in ipairs(held) do if kd(m, R) <= 8 then near = near + 1 end end
            if near >= 3 then for _, m in ipairs(held) do if kd(m, R) <= 8 then m.hp = m.hp - 6 end end; kflash(st, "fan", R, R, 6); kcount(st, "area_spells") end
        end
    elseif st.phase == "fight" then kmove(R, maw.x - 4, maw.y + 4, R.speed) end
    if R.hop > 0 then R.hop = R.hop - 1 end
    if st.phase == "fight" then
        -- the healer stands back from the maw, on the formation's side
        kmove(Hh, maw.x - 14, maw.y + 12, Hh.speed)
        if Hh.cast > 0 then Hh.cast = Hh.cast - 1; if Hh.cast == 0 then T.hp = math.min(T.max, T.hp + 30); kflash(st, "heal", Hh, T, 8); kcount(st, "heals") end
        elseif T.hp < 75 then Hh.cast = 25 end
    end
    -- }}}
    -- {{{ the monsters
    -- patrols: an idle patrol walks its route; one that passes within
    -- LINK yards of a monster already fighting joins that fight, on the
    -- same target (it blunders in); within AGGRO of a buddy it notices it
    -- like any monster (above)
    for _, m in ipairs(st.mobs) do
        if m.hp > 0 and m.state == "idle" and m.route then
            local p = m.route[m.route_i]
            if kmove(m, p[1], p[2], K.PATROL) then
                if not m.route[m.route_i + m.route_dir] then m.route_dir = -m.route_dir end
                m.route_i = m.route_i + m.route_dir
            end
            for _, o in ipairs(st.mobs) do
                if o.hp > 0 and o.state ~= "idle" and o.target and kd(m, o) <= K.LINK then
                    m.state, m.target = "chase", o.target
                    kcount(st, "patrols_blundered")
                    break
                end
            end
        end
    end
    for _, m in ipairs(st.mobs) do
        if m.hp > 0 and m.target then
            local sp = m.speed * ((m.slow_until or 0) > st.t and K.SLOW or 1)
            if kd(m, m.target) > K.REACH then kmove(m, m.target.x, m.target.y, sp)
            else m.state = "fight"; m.target.hp = math.max(1, m.target.hp - 0.1) end
        end
    end
    for _, m in ipairs(st.mobs) do
        if m.hp <= 0 and m.state ~= "dead" then m.state, m.target, m.claimed = "dead", nil, nil; kcount(st, "killed") end
    end
    -- }}}
end
-- }}}

local KRAKEN_FLASH = { heal = 12, frost = 41, jump = 5, tentacle = 15, shot = 10, fan = 7 }
-- {{{ local function kdraw
-- One frame of a kraken run: the patrols' routes, the idle monsters'
-- notice rings and pack links, the maw and its quadrants, the pullers'
-- claims, the flashes, the monsters and the buddies. Shared by the open
-- field (22, 23) and the dungeon (26).
local function kdraw(f, st, t)
    -- a patrol's route (dashed) while it walks it, and a gold ring on it
    for _, m in ipairs(st.mobs) do
        if m.route and m.hp > 0 and m.state == "idle" then
            for k = 1, #m.route - 1 do
                line(f, px(m.route[k][1]), py(m.route[k][2]), px(m.route[k + 1][1]), py(m.route[k + 1][2]), 19, true)
            end
        end
    end
    -- links between the monsters of a pack not yet taken, and how near a
    -- buddy must come to be noticed
    for i, a in ipairs(st.mobs) do
        if a.hp > 0 and a.state == "idle" then
            ring(f, px(a.x), py(a.y), K.AGGRO * SCALE, 17, true)
            for j = i + 1, #st.mobs do
                local b = st.mobs[j]
                if b.hp > 0 and b.state == "idle" and kd(a, b) <= K.LINK then line(f, px(a.x), py(a.y), px(b.x), py(b.y), 21, true) end
            end
        end
    end
    -- the maw and its quadrants (only while the pattern is on)
    if st.maw and st.phase == "fight" and st.kraken then
        local mx, my = px(st.maw.x), py(st.maw.y)
        local reach = (K.ORBIT + 8) * SCALE
        line(f, mx - reach, my, mx + reach, my, 21, true)
        line(f, mx, my - reach, mx, my + reach, 21, true)
        ring(f, mx, my, K.ORBIT * SCALE, 21, true)
        ring(f, mx, my, K.AOE * SCALE, 40)
        if st.mage.cast > 0 and st.mage.spell == "aoe" then
            local r = K.AOE * SCALE
            for yy = -r, r, 3 do for xx = -r, r, 3 do if xx * xx + yy * yy <= r * r then plot(f, mx + xx + (t % 3), my + yy, 40) end end end
        end
    elseif st.maw_next then
        ring(f, px(st.maw_next.x), py(st.maw_next.y), 5, 20, true)
    end
    -- a puller's claim: a dashed line to the monster it is going for
    for _, b in ipairs({ st.mage, st.hunter }) do
        if b.state == "approach" and b.claim then line(f, px(b.x), py(b.y), px(b.claim.x), py(b.claim.y), b.color, true) end
        if b.state == "draw" and b.dest then ring(f, px(b.dest.x), py(b.dest.y), 3, b.color) end
    end
    for _, fl in ipairs(st.flashes) do
        if fl.until_t >= st.t then
            if fl.kind == "fan" then ring(f, px(fl.a.x), py(fl.a.y), 8 * SCALE, 7)
            else line(f, px(fl.a.x), py(fl.a.y), px(fl.b.x), py(fl.b.y), KRAKEN_FLASH[fl.kind], fl.kind == "jump") end
        end
    end
    for _, m in ipairs(st.mobs) do
        local x, y = px(m.x), py(m.y)
        if m.hp > 0 then
            disc(f, x, y, m.max > 150 and 5 or 3, 13)
            if (m.slow_until or 0) > st.t then ring(f, x, y, (m.max > 150 and 5 or 3) + 2, 41) end
            if m.state ~= "idle" then
                local w = m.max > 150 and 14 or 8
                for xx = 0, w - 1 do plot(f, x - w / 2 + xx, y - 7, xx < w * m.hp / m.max and 12 or 19) end
            end
        else
            line(f, x - 2, y - 2, x + 2, y + 2, 19); line(f, x - 2, y + 2, x + 2, y - 2, 19)
        end
    end
    for _, b in ipairs(st.buddies) do
        local x, y = px(b.x), py(b.y)
        disc(f, x, y, 4, b.color)
        if b.hop and b.hop > 0 then ring(f, x, y - 3, 6, b.color) end
        if b.cast > 0 then ring(f, x, y, 7, 20, true) end
        if b == st.tank then for xx = 0, 9 do plot(f, x - 5 + xx, y - 8, xx < 10 * b.hp / b.max and 12 or 19) end end
    end
    for _, m in ipairs(st.mobs) do
        if m.route and m.hp > 0 then ring(f, px(m.x), py(m.y), 5, 15) end
    end
end
-- }}}

-- {{{ local function render_kraken
local function render_kraken(scene)
    local saveW, saveH, saveS, saveX, saveY = W, H, SCALE, OX, OY
    W, H, SCALE, OX, OY = 620, 460, 2.0, 8, 8
    local rand = lcg(scene.seed or 5)
    local st = kraken_sim(scene.owner_tanks)
    local base = base_map(KF)
    local frames = {}
    for t = 1, scene.frames do
        kraken_tick(st, rand)
        local f = new_frame()
        copy(f, base)
        kdraw(f, st, t)
        frames[t] = f
    end
    local path = OUT_DIR .. "/" .. scene.name .. ".gif"
    local bytes = gif.write(path, { width = W, height = H, palette_bytes = palette, frames = frames, delay_cs = DELAY_CS })
    print(string.format("  %-26s %4d frames, %7d bytes (%dx%d)", scene.name .. ".gif", scene.frames, bytes, W, H))
    local c = st.counts
    print(string.format("    counts: taunts %d (tank pulls %d, pick-ups %d), ranged pulls %d, slows %d, blinks %d, disengages %d, area spells %d, heals %d, noticed %d, killed %d of %d, moved on %d, kraken stops %d, plain stops %d",
        c.taunts or 0, c.tank_pulls or 0, c.pickups or 0, c.ranged_pulls or 0, c.slows or 0, c.blinks or 0, c.disengages or 0, c.area_spells or 0, c.heals or 0, c.noticed or 0, c.killed or 0, #st.mobs, c.moved_on or 0, c.kraken_stops or 0, c.plain_stops or 0))
    scene.counts = c
    scene.mob_count = #st.mobs
    if scene.fill then scene.after = scene.fill(scene) end
    scene.W, scene.H = W, H
    W, H, SCALE, OX, OY = saveW, saveH, saveS, saveX, saveY
end
-- }}}

SCENES[#SCENES + 1] = {
