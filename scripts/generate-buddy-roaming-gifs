-- {{{ kiting alone (24)
-- The owner, 2026-09-27 (617e5): "When they're alone, they'll try and kite
-- the mobs to the area that has the most distance to other enemy mobs - they
-- want the most space to kite within. They will also try and avoid areas
-- that they expect to find mobs spawning at soon, because they keep mental
-- track of how long it's been since there was danger in that direction."
-- A drawn simulation. A lone mage (left half) and a lone hunter (right half),
-- each among its own monsters, which come back where they died after
-- RESPAWN ticks. Each kiter remembers every place it met danger (a monster
-- seen, one killed) and when; round it a ring of 16 sectors shows that
-- memory, brighter where danger was recent or where a monster it killed is
-- due back. Its next step goes toward the most room (farthest from monsters
-- not already chasing it), turned away from sectors where danger is due.
local SK = { RESPAWN = 300, SECTORS = 16, LOOK = 22, SEE = 60, ESCAPE = 7, JUMP = 15, JUMP_EVERY = 80, SLOW = 0.45, SLOW_TICKS = 100, AGGRO = 7,
             HUNTER_SLOW_EVERY = 190 }
local function solo_sim()
    local st = { t = 0, flashes = {}, counts = {} }
    local function kiter(role, x, y, color, lo, hi)
        return { role = role, x = x, y = y, color = color, lo = lo, hi = hi, memory = {}, jump_ready = 0, cast = 0, speed = 1.35, next_shot = 0 }
    end
    st.kiters = { kiter("mage", 70, 110, 9, 8, 150), kiter("hunter", 230, 110, 10, 156, 298) }
    -- monsters run as fast as the kiters: only a slow keeps a kiter ahead
    -- monsters faster than the kiters (the owner, 2026-09-27: "the enemies
    -- should move faster than the player, so they can always hit"): 1.6
    -- against 1.35 (1.35 before); slows (x0.45), blinks and disengages keep
    -- the kiter alive, not its legs
    local function mob(x, y) return { x = x, y = y, hx = x, hy = y, hp = 100, max = 100, speed = 1.6, state = "idle" } end
    st.mobs = {
        mob(40, 40), mob(110, 60), mob(30, 170), mob(120, 180), mob(90, 30), mob(60, 205),
        mob(190, 40), mob(270, 60), mob(200, 190), mob(285, 170), mob(240, 20), mob(175, 120),
    }
    return st
end
local function sector_of(k, x, y)
    local a = math.atan2(y - k.y, x - k.x) % (2 * math.pi)
    return math.floor(a / (2 * math.pi / SK.SECTORS)) % SK.SECTORS + 1
end
-- the memory's weight per sector: recent danger (fading over 200 ticks),
-- or a monster it killed there that is due back (from 60% of the respawn
-- time on, until a little after it)
local function sector_danger(st, k)
    local w = {}
    for s = 1, SK.SECTORS do w[s] = 0 end
    for _, m in ipairs(k.memory) do
        local s = sector_of(k, m.x, m.y)
        local recent = math.max(0, 1 - (st.t - m.seen) / 200)
        local due = 0
        if m.died then
            local age = st.t - m.died
            if age >= 0.6 * SK.RESPAWN and age <= 1.2 * SK.RESPAWN then due = 1 end
        end
        w[s] = math.max(w[s], recent, due)
    end
    return w
end
local function remember(k, m, t, died)
    for _, e in ipairs(k.memory) do
        if e.mob == m then e.x, e.y, e.seen = m.hx, m.hy, t; if died then e.died = t end return end
    end
    k.memory[#k.memory + 1] = { mob = m, x = m.hx, y = m.hy, seen = t, died = died and t or nil }
end
local function solo_tick(st, rand)
    st.t = st.t + 1
    for _, m in ipairs(st.mobs) do
        if m.state == "dead" and st.t >= m.back_at then m.state, m.hp, m.x, m.y, m.target = "idle", m.max, m.hx, m.hy, nil; kcount(st, "respawns") end
    end
    for _, k in ipairs(st.kiters) do
        -- what it sees: monsters within SEE, remembered with the time
        for _, m in ipairs(st.mobs) do
            if m.state ~= "dead" and kd(k, m) <= SK.SEE then remember(k, m, st.t, false) end
            if m.state ~= "dead" and m.state == "idle" and kd(k, m) <= SK.AGGRO then m.state, m.target = "chase", k; kcount(st, "noticed") end
        end
        local chasers = {}
        for _, m in ipairs(st.mobs) do if m.state == "chase" and m.target == k then chasers[#chasers + 1] = m end end
        if #chasers == 0 then
            -- a pull: the nearest monster in its own half (walking to it)
            local best, bd
            for _, m in ipairs(st.mobs) do
                if m.state == "idle" and m.hx >= k.lo and m.hx <= k.hi and (not bd or kd(k, m) < bd) then best, bd = m, kd(k, m) end
            end
            if best then
                if bd <= 30 then
                    best.state, best.target, best.slow_until = "chase", k, st.t + SK.SLOW_TICKS
                    best.hp = best.hp - 8
                    kflash(st, k.role == "mage" and "frost" or "shot", k, best, 10); kcount(st, "pulls"); kcount(st, "slows")
                else
                    kwalk(k, best.x, best.y, k.speed * 0.8)
                end
            end
        else
            -- kiting: the nearest chaser decides
            local near = chasers[1]
            for _, m in ipairs(chasers) do if kd(m, k) < kd(near, k) then near = m end end
            local danger = sector_danger(st, k)
            -- each sector's room: from a point LOOK yards out, the distance
            -- to the nearest monster not chasing it (and to the field's edge)
            local best_s, best_v, raw_s, raw_v
            for s = 1, SK.SECTORS do
                local a = (s - 0.5) * 2 * math.pi / SK.SECTORS
                local x, y = k.x + math.cos(a) * SK.LOOK, k.y + math.sin(a) * SK.LOOK
                local room = math.min(x - 8, 300 - x, y - 8, 222 - y)
                if x < k.lo or x > k.hi then room = -1 end              -- its own half
                for _, m in ipairs(st.mobs) do
                    if m.state ~= "dead" and m.target ~= k then room = math.min(room, math.sqrt((m.x - x) ^ 2 + (m.y - y) ^ 2)) end
                end
                -- away from the chaser, a little
                local away = ((x - k.x) * (k.x - near.x) + (y - k.y) * (k.y - near.y)) / (SK.LOOK * math.max(1, kd(k, near)))
                -- a kiter keeps its heading unless another is clearly better
                -- (without this it swung back and forth over the middle)
                local keep = (k.heading and (math.abs(s - k.heading) <= 1 or math.abs(s - k.heading) == SK.SECTORS - 1)) and 10 or 0
                local v = room + 30 * away + keep
                if not raw_v or v > raw_v then raw_s, raw_v = s, v end
                v = v - 60 * danger[s]
                if not best_v or v > best_v then best_s, best_v = s, v end
            end
            if raw_s ~= best_s and danger[raw_s] >= 1 then
                if (k.avoiding or 0) <= st.t then kcount(st, "avoided_due") end   -- a new episode, not every tick of one
                k.avoiding = st.t + 20
            end
            k.heading = best_s
            local a = (best_s - 0.5) * 2 * math.pi / SK.SECTORS
            local d = kd(k, near)
            if d <= SK.ESCAPE and k.jump_ready <= st.t then
                local from = { x = k.x, y = k.y }
                k.x = math.max(k.lo, math.min(k.hi, k.x + math.cos(a) * SK.JUMP))
                k.y = math.max(10, math.min(220, k.y + math.sin(a) * SK.JUMP))
                kflash(st, "jump", from, { x = k.x, y = k.y }, 12); kcount(st, k.role == "mage" and "blinks" or "disengages")
                k.jump_ready = st.t + SK.JUMP_EVERY
            elseif k.cast == 0 and ((k.role == "mage" and d > 16 and (near.slow_until or 0) > st.t) or (k.role == "hunter" and d > 10)) then
                -- a cast-time spell, standing: the mage's frostbolt (only on
                -- a slowed monster, from 16 yards out); the hunter's steady
                -- shot (from 10 yards out: a hunter in this game stands to
                -- shoot, only its arcane shot fires on the move). Standing
                -- lets the monster close in; that is what the blink or the
                -- disengage is for
                k.cast = (k.role == "mage" and 18 or 22)
            elseif k.cast > 0 then
                k.cast = k.cast - 1
                if d <= SK.ESCAPE then k.cast = 0 end                   -- too close: dropped, the escape comes next tick
                if k.cast == 0 and d > SK.ESCAPE then
                    near.hp = near.hp - 30
                    if k.role == "mage" then near.slow_until = st.t + SK.SLOW_TICKS; kcount(st, "slows") end
                    kflash(st, k.role == "mage" and "frost" or "shot", k, near, 8)
                end
            else
                kwalk(k, k.x + math.cos(a) * 3, k.y + math.sin(a) * 3, k.speed)
                if k.role == "hunter" and k.next_shot <= st.t then
                    near.hp = near.hp - 9; k.next_shot = st.t + 96        -- the arcane shot, on its cooldown
                    kflash(st, "shot", k, near, 4)
                    -- the hunter's slow (a concussive shot) has a cooldown
                    -- longer than the slow, as in the game: the gap between
                    -- is when a monster catches up and a disengage is needed
                    if (near.slow_until or 0) <= st.t and (k.slow_ready or 0) <= st.t then
                        near.slow_until, k.slow_ready = st.t + SK.SLOW_TICKS, st.t + SK.HUNTER_SLOW_EVERY
                        kcount(st, "slows")
                    end
                end
            end
        end
    end
    for _, m in ipairs(st.mobs) do
        if m.state == "chase" and m.target then
            local sp = m.speed * ((m.slow_until or 0) > st.t and SK.SLOW or 1)
            if kd(m, m.target) > 3 then kwalk(m, m.target.x, m.target.y, sp) end
        end
        if m.state ~= "dead" and m.hp <= 0 then
            m.state, m.back_at = "dead", st.t + SK.RESPAWN
            for _, k in ipairs(st.kiters) do if m.target == k then remember(k, m, st.t, true) end end
            m.target = nil
            kcount(st, "killed")
        end
    end
end
local function render_solo(scene)
    local saveW, saveH, saveS, saveX, saveY = W, H, SCALE, OX, OY
    W, H, SCALE, OX, OY = 620, 460, 2.0, 8, 8
    local rand = lcg(scene.seed or 9)
    local st = solo_sim()
    local base = base_map(KF)
    local frames = {}
    for t = 1, scene.frames do
        solo_tick(st, rand)
        local f = new_frame()
        copy(f, base)
        line(f, px(153), py(8), px(153), py(220), 21, true)               -- the two halves
        for _, m in ipairs(st.mobs) do
            local x, y = px(m.x), py(m.y)
            if m.state == "dead" then
                -- where it will come back, and how soon (a ring that closes)
                local left = (m.back_at - st.t) / SK.RESPAWN
                ring(f, px(m.hx), py(m.hy), 3 + left * 8, 19, true)
            else
                if m.state == "idle" then ring(f, x, y, SK.AGGRO * SCALE, 17, true) end
                disc(f, x, y, 3, 13)
                if (m.slow_until or 0) > st.t and m.state == "chase" then ring(f, x, y, 5, 41) end
                if m.state == "chase" then for xx = 0, 7 do plot(f, x - 4 + xx, y - 7, xx < 8 * m.hp / m.max and 12 or 19) end end
            end
        end
        for _, fl in ipairs(st.flashes) do
            if fl.until_t >= st.t then line(f, px(fl.a.x), py(fl.a.y), px(fl.b.x), py(fl.b.y), KRAKEN_FLASH[fl.kind], fl.kind == "jump") end
        end
        for _, k in ipairs(st.kiters) do
            local x, y = px(k.x), py(k.y)
            -- the memory ring: 16 sectors, brighter = more dangerous
            local w = sector_danger(st, k)
            for s = 1, SK.SECTORS do
                local shade = 32 + math.floor(math.min(1, w[s]) * 7 + 0.5)
                for step = 0, 5 do
                    local a = ((s - 1) + step / 5) * 2 * math.pi / SK.SECTORS
                    for r = 13, 16 do plot(f, math.floor(x + math.cos(a) * r + 0.5), math.floor(y + math.sin(a) * r + 0.5), shade) end
                end
            end
            -- the heading chosen
            if k.heading then
                local a = (k.heading - 0.5) * 2 * math.pi / SK.SECTORS
                line(f, x, y, math.floor(x + math.cos(a) * 11 + 0.5), math.floor(y + math.sin(a) * 11 + 0.5), 20)
            end
            disc(f, x, y, 4, k.color)
            if k.cast > 0 then ring(f, x, y, 7, 20, true) end
            if (k.avoiding or 0) > st.t then ring(f, x, y, 19, 17) end
        end
        frames[t] = f
    end
    local path = OUT_DIR .. "/" .. scene.name .. ".gif"
    local bytes = gif.write(path, { width = W, height = H, palette_bytes = palette, frames = frames, delay_cs = DELAY_CS })
    print(string.format("  %-26s %4d frames, %7d bytes (%dx%d)", scene.name .. ".gif", scene.frames, bytes, W, H))
    local c = st.counts
    print(string.format("    counts: pulls %d, slows %d, blinks %d, disengages %d, killed %d, respawns %d, noticed %d, turned from a due direction %d",
        c.pulls or 0, c.slows or 0, c.blinks or 0, c.disengages or 0, c.killed or 0, c.respawns or 0, c.noticed or 0, c.avoided_due or 0))
    scene.after = string.format(scene.after, c.pulls or 0, c.slows or 0, c.blinks or 0, c.disengages or 0, c.killed or 0, c.respawns or 0, c.noticed or 0, c.avoided_due or 0)
    scene.W, scene.H = W, H
    W, H, SCALE, OX, OY = saveW, saveH, saveS, saveX, saveY
end
SCENES[#SCENES + 1] = {
    name = "24-kiting-alone",
    title = "Kiting alone: room to run, and a memory for danger",
    before = "The owner's kiting in the wild (617e5): a lone mage (blue, left half) and a lone hunter (purple, right half), each among its **own** monsters, drawn as a simple simulation, not the game's combat. Each pulls a monster (one hit and a slow: the pale blue ring) and leads it toward the **most** room: from points a little way out in 16 directions, the one farthest from monsters not already chasing it (the white tick shows the way chosen). A monster that gets too **close** is escaped with a blink or a disengage (the dashed white line). The mage **stands** to cast frostbolts when its monster is slowed and far enough (a dashed ring while casting); the hunter shoots on the move. Killed monsters come **back** where they stood (a closing dashed ring shows when). Monsters move faster than the kiters (the owner: \"the enemies should move faster than the player, so they can always hit\"): **only** slows, blinks and disengages keep a kiter ahead. The ring of sectors round each kiter is its **memory** of danger by direction, brighter where danger was met recently or where a monster it killed is due back; a direction that is due is avoided even when it has the most room (a red ring flashes when that happens).",
    after = "What happened (counted as drawn): pulls %d, slows %d, blinks %d, disengages %d, killed %d, came back %d, monsters that noticed a kiter on their own %d, times a kiter turned away from the roomiest direction because danger was due there %d. The memory makes the kiter **steer** round places where it has been killing, just before they fill again. What it needs from the game: each buddy's **own** record of where it met monsters and killed them (the server knows every creature's respawn time, but a buddy \"keeps mental track\" of what it saw, so the record is its own, not the server's).",
    render = render_solo,
    frames = 800,
}
-- }}}

-- {{{ the big dungeon (25, 26)
-- The owner, 2026-09-27: "can we have that behavior on a paint heat map,
-- except without the paint, but with the pathing of the 3rd one? The map
-- can be increased in size because we only need one - so how about 4x in
-- size [...] more tunnels to explore, more connection types to see
-- examined. The pathing of monsters between them will be especially
-- apparent." About 480 by 340 yards (four times the painting hall's
-- bounds): five rooms joined by tunnels 10 yards wide of every kind the
-- owner named: a straight one (entrance room to the hall), an L (the hall
-- round to the north-west room), a fork (up from the hall, splitting west to
-- the north-west room and east to the north-east room), a loop (two ways
-- from the hall to the south-east room, round a block of rock), and a dead
-- end (off the north-east room). Made of rectangles (Roam.walkable's
-- area.rects), since a loop needs a hole a single outline can't have.
local DUNGEON_RECTS = {
    { 20, 190, 110, 340 },   -- R1, the entrance room
    { 190, 140, 310, 240 },  -- R2, the hall
    { 20, 20, 120, 100 },    -- R3, north-west
    { 370, 20, 480, 110 },   -- R4, north-east
    { 380, 170, 480, 330 },  -- R5, south-east
    { 110, 215, 190, 225 },  -- straight: R1 to R2
    { 245, 60, 255, 140 },   -- the fork's stem, up from R2
    { 120, 55, 370, 65 },    -- the fork's bar: west to R3, east to R4
    { 60, 165, 190, 175 },   -- the L: west from R2 ...
    { 60, 100, 70, 175 },    -- ... and up to R3
    { 310, 180, 380, 190 },  -- the loop's north way, R2 to R5
    { 280, 240, 290, 300 },  -- the loop's south way: down from R2 ...
    { 280, 290, 380, 300 },  -- ... and east to R5
    { 440, 110, 450, 150 },  -- the dead end, off R4
}
local DUNGEON = {
    rects   = DUNGEON_RECTS,
    walls   = { { 250, 190, 6 }, { 60, 280, 5 }, { 470, 30, 4 }, { 440, 250, 6 } },
    outline = { { 10, 10 }, { 490, 10 }, { 490, 350 }, { 10, 350 } },   -- the bounds, for the few things that want an outline
    centre  = { 250, 180 },
}
local DUNGEON_ENTRANCE = { 40, 330 }
local DUNGEON_CELL = 3

-- {{{ the sensing comparison (25), measured
-- Each of `seeds` runs, `n` buddies from the entrance, 5000 ticks, "least"
-- (the owner's favourite) against "sense" (least with the quadrant
-- sensing): ticks until 90% of the dungeon is seen up close, ticks until
-- both far rooms (R4, R5) have had a buddy in them, entries into the dead
-- end, and revisits.
local function sense_run(mode, seed, n)
    local rand = lcg(seed)
    local g = Roam.paint_grid(DUNGEON, DUNGEON_CELL)
    local r4 = g.room[Roam.paint_cell_of(g, 425, 65)]
    local r5 = g.room[Roam.paint_cell_of(g, 430, 250)]
    local dead = g.tunnel[Roam.paint_cell_of(g, 445, 140)]
    local bs = {}
    for k = 1, n do bs[k] = { id = k, x = DUNGEON_ENTRANCE[1] - 6 + k * 3, y = DUNGEON_ENTRANCE[2] - 6 } end
    local s = Roam.new(DUNGEON, bs, { reading = "paint", paint_mode = mode, grid = g, entrance = DUNGEON_ENTRANCE, wall_paint = true,
        turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, near = 10, crowd = 5 }, rand)
    local t90, far4, far5, dead_in, where = nil, nil, nil, 0, {}
    for t = 1, 5000 do
        Roam.tick(s, rand)
        for _, b in ipairs(bs) do
            local ci = Roam.paint_cell_of(g, b.x, b.y)
            local rm, tn = ci and g.room[ci], ci and g.tunnel[ci]
            if rm == r4 and not far4 then far4 = t end
            if rm == r5 and not far5 then far5 = t end
            local w = tn and ("t" .. tn) or (rm and ("r" .. rm)) or where[b.id]
            if w ~= where[b.id] then if tn == dead then dead_in = dead_in + 1 end; where[b.id] = w end
        end
        if not t90 and t % 50 == 0 and Roam.paint_coverage(g) >= 0.9 then t90 = t end
    end
    return t90 or 5000, math.max(far4 or 5000, far5 or 5000), dead_in, 100 * s.stats.revisits / s.stats.entries, s.stats.sense_tunnel or 0
end
local SENSE_SEEDS = { 5, 11, 23, 31, 47, 59, 61, 73 }
local function sense_measure(mode, n)
    local a = { 0, 0, 0, 0, 0 }
    for _, sd in ipairs(SENSE_SEEDS) do
        local r = { sense_run(mode, sd, n) }
        for k = 1, 5 do a[k] = a[k] + r[k] end
    end
    for k = 1, 5 do a[k] = a[k] / #SENSE_SEEDS end
    return { t90 = a[1], far = a[2], dead = a[3], revisit = a[4], picks = a[5] }
end
local SENSE_MEASURE = {}
for _, n in ipairs({ 1, 2 }) do
    SENSE_MEASURE["least" .. n] = sense_measure("least", n)
    SENSE_MEASURE["sense" .. n] = sense_measure("sense", n)
end
-- }}}

-- {{{ local function dungeon_base
-- The dungeon's floor, drawn once: rock (dark) where no rectangle is, the
-- floor where one is, rocks standing in it.
local function dungeon_base(g)
    local f = new_frame()
    for y = 0, H - 1 do
        for x = 0, W - 1 do
            local wx, wy = (x - OX) / SCALE, (y - OY) / SCALE
            local i = Roam.paint_cell_of(g, wx, wy)
            if i and g.inside[i] then f[y * W + x] = g.open[i] and 1 or 3 end
        end
    end
    return f
end
-- }}}

-- {{{ local function render_sense
-- 25: a clan of two exploring the dungeon with the quadrant sensing. The
-- floor shows the paint as heat (as in 19); round the first buddy (red),
-- its eight sectors as it last read them: each drawn as an arc at the
-- sensing radius, gold for a tunnel, red for a wall, grey for open ground,
-- the one it chose white, with a line to where it is heading.
local SECTOR_COLOUR = { tunnel = 15, wall = 13, open = 18 }
local function render_sense(scene)
    local saveW, saveH, saveS, saveX, saveY = W, H, SCALE, OX, OY
    W, H, SCALE, OX, OY = 650, 470, 1.3, -7, -7
    local rand = lcg(scene.seed or 9)
    local g = Roam.paint_grid(DUNGEON, DUNGEON_CELL)
    local bs = {}
    for k = 1, 2 do bs[k] = { id = k, x = DUNGEON_ENTRANCE[1] - 6 + k * 3, y = DUNGEON_ENTRANCE[2] - 6 } end
    local s = Roam.new(DUNGEON, bs, { reading = "paint", paint_mode = "sense", grid = g, entrance = DUNGEON_ENTRANCE, wall_paint = true,
        turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, near = 10, crowd = 5 }, rand)
    local base = dungeon_base(g)
    -- each pixel's cell, once
    local cellmap = {}
    for y = 0, H - 1 do for x = 0, W - 1 do
        local i = Roam.paint_cell_of(g, (x - OX) / SCALE, (y - OY) / SCALE)
        cellmap[y * W + x] = (i and g.open[i]) and i or -1
    end end
    local frames = {}
    for t = 1, scene.frames do
        for _ = 1, scene.ticks_per_frame do Roam.tick(s, rand) end
        local f = new_frame()
        copy(f, base)
        for p = 0, W * H - 1 do
            local i = cellmap[p]
            if i >= 0 then
                local v, w = g.buddy[i], g.wallp[i]
                if w > v then f[p] = 42 + math.min(2, math.floor(3 * w / (w + 150)))
                elseif v > 0 then f[p] = 32 + math.min(7, math.floor(8 * v / (v + 300))) end
            end
        end
        local ex, ey = px(DUNGEON_ENTRANCE[1]), py(DUNGEON_ENTRANCE[2])
        for yy = -2, 2 do for xx = -2, 2 do plot(f, ex + xx, ey + yy, 5) end end
        local b1 = bs[1]
        if b1.sense then
            local r = Roam.SENSE.RADIUS * SCALE
            for k, sc in ipairs(b1.sense) do
                local c = (k == b1.sense_pick) and 20 or SECTOR_COLOUR[sc.kind]
                for step = -8, 8 do
                    local a = sc.angle + step * (math.pi / 8) / 8 * 0.9
                    for dr = 0, (k == b1.sense_pick) and 2 or 1 do
                        plot(f, math.floor(px(b1.x) + math.cos(a) * (r - dr) + 0.5), math.floor(py(b1.y) + math.sin(a) * (r - dr) + 0.5), c)
                    end
                end
            end
        end
        for _, b in ipairs(bs) do
            local c = BUDDY[(b.id - 1) % #BUDDY + 1]
            if b.path then for i = b.path_i, #b.path do plot(f, px(b.path[i].x), py(b.path[i].y), c) end end
            if b.goal then
                local gx, gy = px(b.goal.x), py(b.goal.y)
                line(f, gx - 2, gy - 2, gx + 2, gy + 2, c); line(f, gx - 2, gy + 2, gx + 2, gy - 2, c)
                if b == b1 and b1.sense_pick then line(f, px(b.x), py(b.y), gx, gy, 20, true) end
            end
            disc(f, px(b.x), py(b.y), 3, c)
        end
        -- the explored bar along the bottom
        local cov = Roam.paint_coverage(g)
        for yy = H - 5, H - 2 do for xx = 0, W - 1 do f[yy * W + xx] = xx < cov * W and 20 or 19 end end
        frames[t] = f
    end
    local path = OUT_DIR .. "/" .. scene.name .. ".gif"
    local bytes = gif.write(path, { width = W, height = H, palette_bytes = palette, frames = frames, delay_cs = DELAY_CS })
    print(string.format("  %-26s %4d frames, %7d bytes (%dx%d), picks by sensing %d", scene.name .. ".gif", scene.frames, bytes, W, H, s.stats.sense_tunnel or 0))
    scene.W, scene.H = W, H
    W, H, SCALE, OX, OY = saveW, saveH, saveS, saveX, saveY
end
-- }}}

local function sm(key) local r = SENSE_MEASURE[key]
    return string.format("90%% explored after %.0f ticks, both far rooms reached after %.0f, %.1f walks into the dead end, %.0f%% of steps onto ground walked in the last 25 seconds",
        r.t90, r.far, r.dead, r.revisit) end
SCENES[#SCENES + 1] = {
    name = "25-sensing-tunnels",
    title = "Sensing tunnels by quadrants",
    -- a playable scene on the page instead of the GIF (the owner,
    -- 2026-09-28: "the gallery rendering was taking too long, my computer
    -- can't keep up [...] ok let's make them playable scenes"); the GIF
    -- code stays but isn't drawn (widget_only)
    widget_only = true,
    widget = [=[  <section class="card" id="dungeon-sense">
    <h2>Sensing tunnels by quadrants</h2>
    <p class="before">A clan of **buddies** explores the big dungeon: five rooms joined by a straight tunnel, an L, a fork, a loop and a **dead** end. Each goes where the paint is **thin**, and with sensing on it also reads **eight** sectors round itself: gold a tunnel, red a wall, grey open ground. **Click** a buddy to see its sectors; try sensing **off**, or a different blocked share, and watch the time to reach both far rooms.</p>
    <div id="ds-root"></div>
    <p class="after">A sector is a **wall** when most of what lies within the radius is rock, weighted toward what is near; it is a **tunnel** when, even so, a walkable way reaches the edge of the radius through its middle. A tunnel not seen up close **lately** is taken; with none, the buddy chooses by least **paint**. The walls paint a thin **fringe** every 3 seconds (blue-grey), which keeps paths in a tunnel's middle. The rules are the roaming **pattern** (docs/roaming-pattern.md), built twice: in Lua for the model, in JavaScript for this page, with a check holding both to the pattern. A drawn simulation, not the **game**.</p>
  </section>
  <!--EMBED:roam-pattern.js-->
  <!--EMBED:scene-kit.js-->
  <!--EMBED:dungeon-sense.js-->]=],
    before = "The owner's quadrant **sens**ing (617e6), on a new dungeon four times the painting hall's size: five rooms joined by tunnels 10 yards wide of every kind, a straight one (the entrance room, bottom left, to the hall in the middle), an L (the hall round to the north-west room), a fork (up from the hall, splitting to the north-west and north-east rooms), a loop (two ways from the hall to the south-east room round a block of rock) and a dead end (off the north-east room). Two buddies explore it by the owner's **favourite** system (least paint with the walls' paint), with the sensing added. When a buddy chooses where to go next, it reads **eight** sectors round itself, the four quadrants and the four turned 45 degrees, out to 40 yards, weighting what is near it most: a sector mostly blocked is a wall; mostly blocked but with a walkable way through to the edge of the 40 yards (straight ahead within the sector's middle half) is a tunnel. A tunnel it hasn't seen up **close** lately is taken: the buddy heads for the far end of that way, and reads again when it gets there. With **none**, it chooses by least paint as before. Round the first buddy (red) its **last** reading: an arc per sector at 40 yards, gold a tunnel, red a wall, grey open; the chosen one white, with a dashed line to where it is going. The floor shows the **paint** (warm: much; blue-grey: the walls' own); the bar along the bottom is how much of the dungeon has been seen up close.",
    after = "Measured by the generator, 8 runs of 5000 ticks each from the entrance: one buddy, least paint alone: %s; with sensing: %s. Two buddies, least paint alone: %s; with sensing: %s. What tuning showed (16 runs each, 1, 2 and 4 buddies): the share of a sector that must be **blocked** for it to count, first 0.5, was the knob that mattered most: at 0.4 corners of rooms read as tunnels and buddies chased them; at 0.7 almost nothing read as a tunnel and sensing did nothing; 0.6 reached the far rooms soonest. The way through had to be read in each sector's **middle** half: over the whole quarter, a straight tunnel's line sat on the edge of the diagonal sectors beside it, and they read as tunnels too. The sensing radius (25, 40, 60 yards) and how recent \"recently\" is changed **little**; 40 yards and about a minute were kept. With four buddies the two systems are about **level**: four buddies spread by paint find everything quickly anyway; sensing matters most for a buddy alone. The dead end is **still** walked into about as often: sensing never picks it (no way runs through it), but least paint does, once its far end is the least painted place left.",
    render = render_sense,
    frames = 700,
    ticks_per_frame = 2,
}
SCENES[#SCENES].after = string.format(SCENES[#SCENES].after, sm("least1"), sm("sense1"), sm("least2"), sm("sense2"))

-- {{{ the kraken in the dungeon (26)
-- The formation explores with the tank leading by least paint and the
-- walls' paint (the owner's favourite system; paint not drawn), the others
-- following its trail; a standing pack in sight within DETECT yards stops
-- it, and it fights with the kraken pattern (the same code as 22) at a maw
-- short of the pack; when the maw is empty it explores on. Monsters that
-- notice a buddy, or patrols that blunder into a fight, start a fight where
-- the tank stands. A third of the monsters are patrols walking L-shaped
-- routes from room to room through the tunnels.
local DG = { DETECT = 40, TRAIL_GAP = 9 }
local DUNGEON_PATROLS = {
    { { 60, 300 }, { 60, 220 }, { 205, 220 } },    -- entrance room, along the straight tunnel, into the hall
    { { 205, 170 }, { 65, 170 }, { 65, 90 } },     -- the L, hall to the north-west room
    { { 250, 132 }, { 250, 60 }, { 130, 60 } },    -- up the fork's stem and west
    { { 250, 70 }, { 385, 60 }, { 385, 95 } },     -- along the fork's bar east, into the north-east room
    { { 300, 185 }, { 392, 185 }, { 392, 230 } },  -- the loop's north way into the south-east room
    { { 285, 232 }, { 285, 295 }, { 392, 295 } },  -- the loop's south way
    { { 400, 320 }, { 470, 320 }, { 470, 200 } },  -- round the south-east room
    { { 30, 30 }, { 110, 30 }, { 110, 90 } },      -- round the north-west room
    { { 30, 200 }, { 100, 200 }, { 100, 320 } },   -- round the entrance room
    { { 200, 150 }, { 300, 150 }, { 300, 230 } },  -- round the hall
}
local function dungeon_sim(rand)
    local st = { t = 0, flashes = {}, counts = {}, dungeon = true, phase = "explore", trail = {} }
    local function unit(role, x, y, color, hp, speed) return { role = role, x = x, y = y, color = color, hp = hp, max = hp, speed = speed, cast = 0, hop = 0, jump_ready = 0 } end
    local ex, ey = DUNGEON_ENTRANCE[1], DUNGEON_ENTRANCE[2]
    st.tank   = unit("tank",   ex + 4, ey - 8, 6, 100, 1.4)
    st.healer = unit("healer", ex - 6, ey - 2, 12, 80, 1.3)
    st.mage   = unit("mage",   ex + 10, ey - 2, 9, 70, 1.35)
    st.hunter = unit("hunter", ex - 2, ey - 10, 10, 80, 1.35)
    st.rogue  = unit("rogue",  ex + 8, ey - 12, 7, 80, 1.45)
    st.buddies = { st.tank, st.healer, st.mage, st.hunter, st.rogue }
    st.mage.dir, st.hunter.dir = 1, -1
    st.tank.id = 1
    -- monsters faster than every buddy (the owner: "the enemies should move
    -- faster than the player, so they can always hit")
    local function mob(x, y, hp) return { x = x, y = y, hp = hp or 100, max = hp or 100, speed = 1.6, state = "idle" } end
    local function patrol(route) local m = mob(route[1][1], route[1][2]); m.route, m.route_i, m.route_dir = route, 2, 1; return m end
    st.mobs = {
        mob(90, 206),                                                        -- the entrance room: one
        mob(262, 206), mob(274, 198), mob(270, 214), mob(282, 208),          -- the hall: a pack of four
        mob(210, 158),                                                       --   and one by the fork's foot
        mob(52, 46), mob(64, 40), mob(58, 56),                               -- north-west: a pack of three
        mob(400, 84), mob(411, 92), mob(396, 96), mob(452, 44, 260),         -- north-east: three, and an elite
        mob(440, 300), mob(452, 292), mob(448, 312), mob(432, 306),          -- south-east: a pack of four
        mob(400, 192),                                                       --   and one at the loop's mouth
        mob(150, 220), mob(65, 140),                                         -- one in the straight tunnel, one in the L
    }
    for _, r in ipairs(DUNGEON_PATROLS) do st.mobs[#st.mobs + 1] = patrol(r) end
    st.g = Roam.paint_grid(DUNGEON, DUNGEON_CELL)
    st.explore = Roam.new(DUNGEON, { st.tank }, { reading = "paint", paint_mode = "least", grid = st.g, entrance = DUNGEON_ENTRANCE,
        wall_paint = true, turn = 2 * math.pi / 10, y_mode = "step", y_limit = 20, near = 10, crowd = 5, step = 1.4 }, rand)
    for _, u in ipairs(st.buddies) do u.lx, u.ly = u.x, u.y end
    for _, m in ipairs(st.mobs) do m.lx, m.ly = m.x, m.y end
    return st
end
-- a fight here: the maw at `maw`, the pack's nearest idle monster taken first
local function dungeon_fight(st, maw, pack)
    st.maw, st.phase, st.kraken = maw, "fight", true
    kcount(st, "stops")
    local T, first, fd = st.tank, nil, nil
    for _, m in ipairs(pack) do if m.hp > 0 and m.state == "idle" and (not fd or kd(T, m) < fd) then first, fd = m, kd(T, m) end end
    if first then kwake(st, first, T); kflash(st, "tentacle", T, first, 14); kcount(st, "taunts") end
end
-- the maw for a pack seen from the tank: MAW_BACK yards short of the
-- pack's middle toward the tank, pulled back toward the tank until it is
-- on open ground with a clear line to the tank
local function dungeon_maw(st, pack)
    local T, g = st.tank, st.g
    local cx, cy = 0, 0
    for _, m in ipairs(pack) do cx, cy = cx + m.x, cy + m.y end
    cx, cy = cx / #pack, cy / #pack
    local vx, vy = T.x - cx, T.y - cy
    local l = math.max(0.01, math.sqrt(vx * vx + vy * vy))
    local ax, ay = cx + vx / l * math.min(K.MAW_BACK, l), cy + vy / l * math.min(K.MAW_BACK, l)
    for k = 0, 20 do
        local x, y = ax + (T.x - ax) * k / 20, ay + (T.y - ay) * k / 20
        local i = Roam.paint_cell_of(g, x, y)
        if i and Roam.paint_passable(g, i) and Roam.paint_line_clear(g, T.x, T.y, x, y) then return { x = x, y = y } end
    end
    return { x = T.x, y = T.y }
end
local function dungeon_tick(st, rand)
    KNOW = st.t
    local T, g = st.tank, st.g
    if st.phase == "explore" then
        local held = kheld(st)
        if #held > 0 then
            -- something noticed us (or a patrol blundered in): fight here
            dungeon_fight(st, dungeon_maw(st, held), held)
            kcount(st, "ambushed")
        else
            Roam.tick(st.explore, rand)
            st.trail[#st.trail + 1] = { x = T.x, y = T.y }
            -- a standing pack in sight: stop and fight it
            local best, bd
            for _, m in ipairs(st.mobs) do
                if m.hp > 0 and m.state == "idle" and not m.route then
                    local d = kd(T, m)
                    if d <= DG.DETECT and (not bd or d < bd) and Roam.paint_line_clear(g, T.x, T.y, m.x, m.y) then best, bd = m, d end
                end
            end
            if best then
                local pack = kpack(st, best)
                dungeon_fight(st, dungeon_maw(st, pack), pack)
            end
        end
        -- the others follow the tank's trail, each a few steps further back
        for i, b in ipairs({ st.healer, st.mage, st.hunter, st.rogue }) do
            local p = st.trail[math.max(1, #st.trail - i * DG.TRAIL_GAP)] or T
            kmove(b, p.x, p.y, b.speed)
        end
    end
    local was = st.phase
    kraken_tick(st, rand)
    -- back to exploring: the tank chooses afresh from where it stands
    if was == "fight" and st.phase == "explore" then T.path = nil; st.trail = { { x = T.x, y = T.y } } end
    -- everyone paints what they see (fighting too), every 4 ticks
    if st.t % 4 == 0 then for _, b in ipairs(st.buddies) do Roam.paint_deposit(g, b.x, b.y) end end
    -- nobody ends a tick inside rock (a blink, or a step cut across a
    -- corner): back to where it last stood on open ground
    local function keep(u)
        local i = Roam.paint_cell_of(g, u.x, u.y)
        if i and g.open[i] then u.lx, u.ly = u.x, u.y else u.x, u.y = u.lx, u.ly end
    end
    for _, b in ipairs(st.buddies) do keep(b) end
    for _, m in ipairs(st.mobs) do if m.hp > 0 then keep(m) end end
end
local function render_dungeon(scene)
    local saveW, saveH, saveS, saveX, saveY = W, H, SCALE, OX, OY
    W, H, SCALE, OX, OY = 650, 470, 1.3, -7, -7
    local rand = lcg(scene.seed or 5)
    local st = dungeon_sim(rand)
    KGRID = st.g
    local base = dungeon_base(st.g)
    local frames = {}
    for t = 1, scene.frames do
        for _ = 1, scene.ticks_per_frame do dungeon_tick(st, rand) end
        local f = new_frame()
        copy(f, base)
        -- where the tank is heading while it explores
        if st.phase == "explore" then
            local T = st.tank
            if T.path then for i = T.path_i, #T.path do plot(f, px(T.path[i].x), py(T.path[i].y), T.color) end end
        end
        kdraw(f, st, t)
        local cov = Roam.paint_coverage(st.g)
        for yy = H - 5, H - 2 do for xx = 0, W - 1 do f[yy * W + xx] = xx < cov * W and 20 or 19 end end
        frames[t] = f
    end
    KGRID = nil
    local path = OUT_DIR .. "/" .. scene.name .. ".gif"
    local bytes = gif.write(path, { width = W, height = H, palette_bytes = palette, frames = frames, delay_cs = DELAY_CS })
    print(string.format("  %-26s %4d frames, %7d bytes (%dx%d)", scene.name .. ".gif", scene.frames, bytes, W, H))
    local c, dead = st.counts, 0
    for _, m in ipairs(st.mobs) do if m.hp <= 0 then dead = dead + 1 end end
    print(string.format("    counts: stops %d (ambushed %d), taunts %d (reach-outs %d, pick-ups %d), ranged pulls %d, slows %d, blinks %d, disengages %d, area spells %d, heals %d, patrols blundered in %d, killed %d of %d, explored %.0f%%",
        c.stops or 0, c.ambushed or 0, c.taunts or 0, c.tank_pulls or 0, c.pickups or 0, c.ranged_pulls or 0, c.slows or 0, c.blinks or 0, c.disengages or 0, c.area_spells or 0, c.heals or 0, c.patrols_blundered or 0, dead, #st.mobs, 100 * Roam.paint_coverage(st.g)))
    scene.counts, scene.killed, scene.mob_count, scene.explored = c, dead, #st.mobs, 100 * Roam.paint_coverage(st.g)
    if scene.fill then scene.after = scene.fill(scene) end
    scene.W, scene.H = W, H
    W, H, SCALE, OX, OY = saveW, saveH, saveS, saveX, saveY
end
SCENES[#SCENES + 1] = {
    name = "26-kraken-dungeon",
    title = "The kraken in a dungeon",
    widget_only = true,                     -- playable on the page (as 25)
    widget = [=[  <section class="card" id="dungeon-kraken">
    <h2>The kraken in a dungeon</h2>
    <p class="before">A party of **five** explores the same dungeon, the tank leading by least paint; packs stand in the rooms, each with a lone **outlier**, and patrols (gold rings) walk the tunnels. When a fight starts, the maw (blue ring) is set and the **kraken** plays out: gold lines are the tank's taunts, pale blue rings slows, dashed white lines blinks and disengages. Try the kraken **off** for an ordinary fight, more **patrols**, or a different melee buddy.</p>
    <div id="dk-root"></div>
    <p class="after">The tank holds within 6 yards of the maw and **reaches** out with its 30-yard taunt while the hold is light; the mage and the hunter fetch outliers with one hit and a **slow**, lead them into a neighbouring quadrant, and kite round the maw until the tank takes them. Monsters are **faster** than the party, so slows, blinks and taunts save a puller, not its legs. Area spells land when two or more stand in the **maw**; against an elite, area and single-target spells about **equally**. When everything held is dead, the party moves **on**. Health, damage and speeds are round numbers: a drawn simulation of the intended behaviour, not the game's **combat**.</p>
  </section>
  <!--EMBED:dungeon-kraken.js-->]=],
    before = "The kraken (22) on the **dungeon** of 25, drawn as a simple simulation, not the game's combat. The formation explores with the **tank** leading by the owner's favourite system, least paint with the walls' paint (the paint is laid but not drawn), the others following its trail (the tank's planned path in red dots). A standing pack in sight within 40 yards **stops** it: the maw is set short of the pack toward the tank, on open ground, and the kraken fights as in 22 (gold tentacle lines: the tank's taunts; pale blue rings: slows; dashed white lines: blinks and disengages; the blue storm: area spells). When everything held is dead it explores **on**. A third of the monsters are patrols (gold rings) walking L-shaped routes (dashed) between and round the rooms through the **tunnels**; a patrol that passes near a fight joins it, and any monster that notices a buddy starts a fight where the tank stands. Monsters are **faster** than every buddy. The bar along the bottom is how much of the dungeon has been **seen**.",
    after = "",
    render = render_dungeon,
    frames = 1100,
    ticks_per_frame = 2,
    fill = function(sc)
        local c = sc.counts
        return string.format("What happened in this run (counted as it was drawn): %d fights (%d begun by a monster that noticed a buddy or a patrol walking in); the tank's taunts %d (%d reaching out, %d taking back a monster on someone else); the mage's and the hunter's pulls %d, slows %d, blinks %d, disengages %d; area spells %d; heals %d; patrols that blundered into a fight %d; %d of %d monsters killed; %.0f%% of the dungeon seen.",
            c.stops or 0, c.ambushed or 0, c.taunts or 0, c.tank_pulls or 0, c.pickups or 0, c.ranged_pulls or 0, c.slows or 0, c.blinks or 0, c.disengages or 0, c.area_spells or 0, c.heals or 0, c.patrols_blundered or 0, sc.killed, sc.mob_count, sc.explored)
    end,
}
-- }}}
-- }}}

-- {{{ local function esc
local function esc(s) return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub("\"", "&quot;")) end
-- }}}

-- {{{ local function em
-- The owner's emphasis (2026-09-28): about one bold word (or part of a word)
-- per sentence, sometimes two, none where a flat tone is the point; a bold
-- word is fully pronounced, not sharp. Captions carry it as **...**, turned
-- into <strong> after escaping (so it can't break the page), and before a
-- widget's script is embedded (a script may use ** itself). An odd number
-- of ** would leave markup half open, so it stops the page instead.
local function em(s)
    local out, n = s:gsub("%*%*(.-)%*%*", "<strong>%1</strong>")
    assert(not out:find("**", 1, true), "em: an unmatched ** in: " .. s:sub(1, 120))
    return out
end
-- }}}

-- {{{ main
os.execute("mkdir -p '" .. OUT_DIR .. "'")
print("generate-buddy-roaming-gifs: " .. #SCENES .. " scenes -> " .. OUT_DIR)
local cards = {}
-- {{{ local function embed_scripts
-- A widget's card names its script as <!--EMBED:file.js-->; the file's text
-- (docs/HTML/buddy-roaming/file.js, the source) goes into the page inside a
-- <script>. Embedded, not linked: the artifact host runs scripts only from
-- a few approved CDNs, so a script file published beside the page never
-- ran there (the owner, 2026-09-27: the widget "doesn't seem to be built
-- and functional on my end"); in a local browser the linked file ran fine.
local function embed_scripts(html)
    return (html:gsub("<!%-%-EMBED:([%w%-%.]+)%-%->", function(file)
        local fh = assert(io.open(OUT_DIR .. "/" .. file, "r"), "embed: no script " .. OUT_DIR .. "/" .. file)
        local js = fh:read("*a"); fh:close()
        assert(not js:lower():find("</script", 1, true), "embed: " .. file .. " contains </script, which would end the page's script early")
        return "<script>\n" .. js .. "</script>"
    end))
end
-- }}}
local card_by = {}
-- BUDDY_GIF_ONLY=pattern renders only the scenes whose names match (for
-- working on one scene; the page is not written then, since the others'
-- sizes aren't known)
local ONLY = os.getenv("BUDDY_GIF_ONLY")
for _, sc in ipairs(SCENES) do
  if not ONLY or sc.name:find(ONLY, 1, true) then
    -- a scene may draw itself (its own canvas size: the painting panels,
    -- the cluster pull); it then records its size in sc.W, sc.H
    -- a scene that is only a playable widget on the page isn't drawn
    -- (widget_only: the owner's machine couldn't keep up with rendering)
    if sc.widget_only then -- nothing to draw
    elseif sc.render then sc.render(sc) else render(sc.name, sc) end
    -- the GIFs are linked, not embedded: twelve embedded passed the 16 MB
    -- limit of a published page (2026-09-27); linked, they are published
    -- beside the page and open the same way from disk
    if sc.widget then card_by[sc.name] = embed_scripts(em(sc.widget)) else
    card_by[sc.name] = string.format([[
  <section class="card">
    <h2>%s</h2>
    <p class="before">%s</p>
    <img src="buddy-roaming/%s.gif" alt="%s" width="%d" height="%d" loading="lazy">
    <p class="after">%s</p>
  </section>]], esc(sc.title), em(esc(sc.before)), sc.name, esc(sc.title), sc.W or W, sc.H or H, em(esc(sc.after))) end
  end
end
if ONLY then print("  (BUDDY_GIF_ONLY set: the page is left as it was)") os.exit(0) end

-- {{{ the parts
-- The page groups the scenes into parts at their natural breaks (the owner,
-- 2026-09-27: "can you make 'part 1' and 'part 2' headers at natural
-- breaking points?"). The page's order is the parts' order, not the
-- scenes' numbers (which name the files and stay as they are). Every scene
-- must be in exactly one part: a scene left out, or named twice, stops the
-- generator.
local PARTS = {
    { id = "readings", title = "Part 1 · First readings",
      blurb = "The owner's first description (spacing, a pinwheel round the centre, lists of who is far enough) read **four** ways, before the owner's own waypoint rule.",
      scenes = { "01-far-lists", "02-one-buddys-choice", "03-spring", "04-spin-lists", "05-close-and-far" } },
    { id = "waypoints", title = "Part 2 · The owner's waypoint rule",
      blurb = "Waypoints round the centre: the bearing turns a **steady** step, the distance out moves a little each time, crowded spots are nudged, and runs toward the middle cross it.",
      scenes = { "08-waypoints", "09-one-buddys-waypoints", "10-waypoints-kept-apart", "11-waypoints-y-limited", "17-piercing-the-middle" } },
    { id = "ground", title = "Part 3 · Paths and the ground",
      blurb = "Getting to **each** waypoint: round rocks, crates and raised ground, down gentle slopes, along roads, out of a side tunnel.",
      scenes = { "07-round-the-rocks", "12-orbiting-obstacles", "13-planned-paths", "14-one-plan", "15-two-sizes", "16-side-tunnel" } },
    { id = "exploring", title = "Part 4 · Exploring: paint, rooms and tunnels",
      blurb = "Buddies paint what they see and go where the paint is **thin**; the systems compared side by side.",
      scenes = { "19-painting-compared", "21-rooms-and-tunnels", "25-sensing-tunnels" } },
    { id = "fighting", title = "Part 5 · Fighting together",
      blurb = "Drawing monsters' attention, pulling packs to a tank, the **kraken**, and kiting alone. Drawn simulations of the intended behaviour, not the game's combat.",
      scenes = { "18-monsters", "20-cluster-pull", "22-kraken", "26-kraken-dungeon", "24-kiting-alone" } },
    { id = "play", title = "Part 6 · Play it yourself",
      blurb = "The scenes with you in them, **play**able: move the cursor (or a finger) over the area and your dot follows.",
      scenes = { "06-joining-and-leaving", "23-owner-tanks" } },
}
local placed = {}
for _, part in ipairs(PARTS) do
    cards[#cards + 1] = string.format([[
  <header class="part" id="%s">
    <h2>%s</h2>
    <p>%s</p>
  </header>]], part.id, esc(part.title), em(esc(part.blurb)))
    for _, name in ipairs(part.scenes) do
        assert(card_by[name], "parts: scene " .. name .. " has no card (renamed or removed?)")
        assert(not placed[name], "parts: scene " .. name .. " is in two parts")
        placed[name] = true
        cards[#cards + 1] = card_by[name]
    end
end
for _, sc in ipairs(SCENES) do
    assert(placed[sc.name], "parts: scene " .. sc.name .. " is in no part; add it to PARTS")
end
-- }}}

