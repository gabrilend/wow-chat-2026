#!/usr/bin/env luajit
-- generate-buddy-roaming-gifs - animate the buddy roaming design, one GIF per
-- idea, and gather them into a gallery page (issue 617e).
--
-- For a general audience: the owner described how buddies should roam a
-- place (keep an even distance from one another, circle the place's centre,
-- each its own way) and asked to see the readings of that description
-- before one is built. This tool runs the very model the server will use
-- (src/lua-basic/lib/buddy-roam.lua) on a drawn map about the size of a
-- mine or farm, with rocks to walk around, and draws each tick as a frame:
-- circles for buddies, a white circle for the owner, lines for who is "far
-- enough" from whom. Each idea becomes a looping GIF; a page shows them in
-- order, each with what to watch for above it and what it means below.
--
-- Usage: scripts/generate-buddy-roaming-gifs [PROJECT_DIR] [GIF_GENERATOR_DIR]
--   Reads   src/lua-basic/lib/buddy-roam.lua (the model)
--           the GIF encoder of the gif-generator project (src/004-gif.lua)
--   Writes  docs/HTML/buddy-roaming/*.gif and docs/HTML/buddy-roaming.html

local DIR = arg[1] or "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local GEN = arg[2] or "/home/ritz/programming/ai-stuff/gif-generator"
package.path = GEN .. "/src/?.lua;" .. package.path
local ffi  = require("ffi")
local gif  = require("004-gif")
local Roam = dofile(DIR .. "/src/lua-basic/lib/buddy-roam.lua")
local OUT_DIR  = DIR .. "/docs/HTML/buddy-roaming"
local OUT_HTML = DIR .. "/docs/HTML/buddy-roaming.html"

-- {{{ canvas and palette
local W, H   = 400, 320          -- pixels
local SCALE  = 3.0               -- pixels per yard
local OX, OY = 20, 20            -- where yard (0, 0) lands
local FRAMES, DELAY_CS = 440, 6  -- about 26 seconds at ~16 frames a second (doubled 2026-09-27, the owner)

local COLORS = {                 -- index = position - 1
    { 18, 22, 29 },    -- 0 background
    { 31, 40, 51 },    -- 1 area floor
    { 74, 90, 110 },   -- 2 area edge
    { 90, 81, 70 },    -- 3 rock
    { 122, 110, 96 },  -- 4 rock edge
    { 255, 255, 255 }, -- 5 owner
    { 224, 108, 90 },  -- 6 buddy 1
    { 226, 193, 106 }, -- 7 buddy 2
    { 116, 209, 189 }, -- 8 buddy 3
    { 127, 166, 230 }, -- 9 buddy 4
    { 196, 163, 238 }, -- 10 buddy 5
    { 156, 204, 101 }, -- 11 buddy 6
    { 94, 194, 122 },  -- 12 far enough (green)
    { 176, 72, 74 },   -- 13 too close (red)
    { 45, 58, 72 },    -- 14 trail
    { 215, 184, 90 },  -- 15 experience ring (74)
    { 94, 194, 122 },  -- 16 join ring (54)
    { 224, 108, 90 },  -- 17 leave ring (75)
    { 107, 122, 140 }, -- 18 candidate step
    { 58, 63, 71 },    -- 19 refused step
    { 231, 234, 239 }, -- 20 highlight
    { 70, 84, 104 },   -- 21 spacing circle
    { 150, 104, 62 },  -- 22 crate (colliding doodad)
    { 88, 104, 78 },   -- 23 raised ground (a step up in height)
    { 110, 128, 96 },  -- 24 raised ground's contour
    { 22, 30, 40 },    -- 25 ground: a dip
    { 31, 40, 51 },    -- 26 ground: level (the plain floor)
    { 38, 49, 60 },    -- 27 ground: a little up
    { 46, 58, 68 },    -- 28 ground: up
    { 55, 67, 76 },    -- 29 ground: high
    { 64, 76, 84 },    -- 30 ground: hilltop
    { 104, 88, 60 },   -- 31 road
    { 34, 50, 60 },    -- 32 paint: a trace (heat ramp 32-39, the painting comparison)
    { 40, 66, 72 },    -- 33
    { 46, 86, 84 },    -- 34
    { 58, 108, 92 },   -- 35
    { 92, 130, 92 },   -- 36
    { 140, 146, 86 },  -- 37
    { 190, 150, 76 },  -- 38
    { 224, 128, 66 },  -- 39 paint: the most
    { 110, 170, 255 }, -- 40 area spell (the cluster pull)
    { 150, 210, 255 }, -- 41 frost: a frostbolt, a slowed monster
    { 44, 50, 84 },    -- 42 walls' paint: faint (the painting comparisons; a blue-grey
    { 56, 62, 112 },   -- 43   fringe, so the walls' paint shows apart from the buddies' heat)
    { 72, 78, 146 },   -- 44 walls' paint: strong
}
local palette = ffi.new("uint8_t[768]")
for i, c in ipairs(COLORS) do palette[(i - 1) * 3], palette[(i - 1) * 3 + 1], palette[(i - 1) * 3 + 2] = c[1], c[2], c[3] end
local BUDDY = { 6, 7, 8, 9, 10, 11 }
-- }}}

-- {{{ drawing
local function px(x) return math.floor(OX + x * SCALE + 0.5) end
local function py(y) return math.floor(OY + y * SCALE + 0.5) end

local function new_frame() return ffi.new("uint8_t[?]", W * H) end
local function copy(dst, src) ffi.copy(dst, src, W * H) end
local function plot(f, x, y, c) if x >= 0 and x < W and y >= 0 and y < H then f[y * W + x] = c end end

-- {{{ local function line
local function line(f, x0, y0, x1, y1, c, dash)
    local dx, dy = math.abs(x1 - x0), -math.abs(y1 - y0)
    local sx, sy = x0 < x1 and 1 or -1, y0 < y1 and 1 or -1
    local err, n = dx + dy, 0
    while true do
        if not dash or (n % 6) < 3 then plot(f, x0, y0, c) end
        n = n + 1
        if x0 == x1 and y0 == y1 then break end
        local e2 = 2 * err
        if e2 >= dy then err = err + dy; x0 = x0 + sx end
        if e2 <= dx then err = err + dx; y0 = y0 + sy end
    end
end
-- }}}

-- {{{ local function disc / ring
local function disc(f, cx, cy, r, c)
    for y = -r, r do for x = -r, r do if x * x + y * y <= r * r then plot(f, cx + x, cy + y, c) end end end
end
local function ring(f, cx, cy, r, c, dash)
    local steps = math.max(24, math.floor(r * 6))
    for k = 0, steps - 1 do
        if not dash or (k % 4) < 2 then
            local a = 2 * math.pi * k / steps
            plot(f, math.floor(cx + math.cos(a) * r + 0.5), math.floor(cy + math.sin(a) * r + 0.5), c)
        end
    end
end
-- }}}

-- {{{ local function base_map
-- The area (floor, edge) and its rocks, drawn once per GIF.
local function base_map(area)
    local f = new_frame()
    for y = 0, H - 1 do
        for x = 0, W - 1 do
            local wx, wy = (x - OX) / SCALE, (y - OY) / SCALE
            if Roam.walkable({ outline = area.outline, walls = {} }, wx, wy, 0) then
                -- a map with ground: road, or a shade by the lie of the
                -- land (hills only; obstacles are drawn below)
                if area.road and area.road(wx, wy) then f[y * W + x] = 31
                elseif area.ground then f[y * W + x] = 25 + math.max(0, math.min(5, math.floor((area.ground(wx, wy) + 3) / 2)))
                else f[y * W + x] = 1 end
            end
        end
    end
    local o = area.outline
    for i = 1, #o do
        local j = i % #o + 1
        line(f, px(o[i][1]), py(o[i][2]), px(o[j][1]), py(o[j][2]), 2)
    end
    -- obstacles by kind (the 4th field; none = a rock): a crate is a
    -- square, raised ground a disc with contour rings
    for _, w in ipairs(area.walls) do
        local x, y, r = px(w[1]), py(w[2]), math.floor(w[3] * SCALE)
        if w[4] == "crate" then
            local h = math.floor(r * 0.8)
            for yy = -h, h do for xx = -h, h do plot(f, x + xx, y + yy, 22) end end
            line(f, x - h, y - h, x + h, y + h, 4); line(f, x - h, y + h, x + h, y - h, 4)
        elseif w[4] == "mound" then
            disc(f, x, y, r, 23)
            ring(f, x, y, r, 24); ring(f, x, y, r * 0.6, 24); ring(f, x, y, r * 0.25, 24)
        else
            disc(f, x, y, r, 3)
            ring(f, x, y, r, 4)
        end
    end
    return f
end
-- }}}

-- {{{ local function draw_buddy
-- A buddy: a filled circle in its colour, a short tick showing which way it
-- circles the centre, a white ring when grouped with the owner.
local function draw_buddy(f, s, b, color, to_scale)
    local x, y = px(b.x), py(b.y)
    -- to scale (scene.to_scale): the disc is the body's real width, with a
    -- ring two pixels out so a small one still shows
    if to_scale then
        local r = math.max(1, math.floor(b.body / 2 * SCALE + 0.5))
        disc(f, x, y, r, color)
        ring(f, x, y, r + 2, color)
    else
        disc(f, x, y, 4, color)
    end
    local rx, ry = b.x - s.cx, b.y - s.cy
    local len = math.sqrt(rx * rx + ry * ry)
    if len > 0.1 then
        local tx, ty = -ry / len * b.spin, rx / len * b.spin
        line(f, x, y, math.floor(x + tx * 9 + 0.5), math.floor(y + ty * 9 + 0.5), color)
    end
    if b.grouped then ring(f, x, y, 7, 20) end
end
-- }}}
-- }}}

-- {{{ the map: a mine-sized named area with rocks
-- About 120 by 90 yards (Fargodeep Mine's outdoor part is of this order),
-- with rocks of 3-7 yards to walk round.
local AREA = {
    outline = { { 6, 14 }, { 40, 4 }, { 88, 8 }, { 122, 24 }, { 124, 60 }, { 104, 88 }, { 60, 94 }, { 22, 84 }, { 2, 52 } },
    walls = { { 42, 34, 6 }, { 80, 30, 5 }, { 64, 60, 7 }, { 30, 64, 4 }, { 100, 58, 4 }, { 88, 76, 3 } },
}
-- The same area, cluttered the way a real camp is (2026-09-27): small
-- rocks, ruined crates and other colliding doodads, and raised ground (a
-- step up in height the owner asked buddies to walk round, "no need to
-- step on that"). All are circles to the model; in game they are found by
-- probing (617e, Suggested Implementation Steps).
local AREA_CLUTTERED = { outline = AREA.outline, walls = {} }
for _, w in ipairs(AREA.walls) do AREA_CLUTTERED.walls[#AREA_CLUTTERED.walls + 1] = w end
for _, w in ipairs({
    { 22, 30, 1.5, "crate" }, { 56, 22, 1.2, "crate" }, { 96, 44, 1.5, "crate" }, { 50, 80, 1.2, "crate" }, { 112, 36, 1.2, "crate" },
    { 16, 46, 2.0 }, { 70, 14, 1.5 }, { 46, 50, 2.0 }, { 84, 88, 1.5 }, { 108, 72, 2.0 },
    { 26, 76, 4.0, "mound" }, { 64, 38, 3.5, "mound" }, { 100, 20, 3.0, "mound" },
}) do AREA_CLUTTERED.walls[#AREA_CLUTTERED.walls + 1] = w end

-- Its ground, for the path planner (2026-09-27): two hills and a dip
-- ({x, y, height, spread}, bell-shaped), obstacles standing on it (big
-- rocks 5 yards tall, small rocks 1.2, crates 1, raised ground 1.5), and a
-- road (a band 5 yards wide along a line of points).
local HILLS = { { 30, 42, 6, 13 }, { 98, 68, 7, 11 }, { 72, 24, -3, 9 } }
local TALL  = { crate = 1.0, mound = 1.5 }
local ROAD  = { { 4, 50 }, { 36, 56 }, { 62, 78 }, { 96, 84 }, { 118, 70 } }
function AREA_CLUTTERED.ground(x, y)
    local h = 0
    for _, k in ipairs(HILLS) do h = h + k[3] * math.exp(-((x - k[1]) ^ 2 + (y - k[2]) ^ 2) / (2 * k[4] ^ 2)) end
    return h
end
function AREA_CLUTTERED.height(x, y)
    local top = 0
    for _, w in ipairs(AREA_CLUTTERED.walls) do
        if (x - w[1]) ^ 2 + (y - w[2]) ^ 2 < w[3] ^ 2 then top = math.max(top, TALL[w[4]] or (w[3] > 2 and 5 or 1.2)) end
    end
    return AREA_CLUTTERED.ground(x, y) + top
end
function AREA_CLUTTERED.road(x, y)
    for i = 1, #ROAD - 1 do
        local ax, ay, bx, by = ROAD[i][1], ROAD[i][2], ROAD[i + 1][1], ROAD[i + 1][2]
        local vx, vy = bx - ax, by - ay
        local k = math.max(0, math.min(1, ((x - ax) * vx + (y - ay) * vy) / (vx * vx + vy * vy)))
        if (ax + vx * k - x) ^ 2 + (ay + vy * k - y) ^ 2 < 2.5 * 2.5 then return true end
    end
    return false
end

-- A chamber with a side tunnel (2026-09-27, the owner: "can you make a gif
-- that has a side tunnel, and ensure the buddy-bots are encouraged to walk
-- through it?"): the main chamber on the left, a tunnel 8 yards wide
-- running east from it, and a small side chamber at its end. The centre is
-- the main chamber's own centre of area (the corners' average would sit
-- near the tunnel's mouth). Level ground; a few rocks and crates.
local function centroid(poly)
    local a, cx, cy = 0, 0, 0
    for i = 1, #poly do
        local j = i % #poly + 1
        local k = poly[i][1] * poly[j][2] - poly[j][1] * poly[i][2]
        a, cx, cy = a + k, cx + (poly[i][1] + poly[j][1]) * k, cy + (poly[i][2] + poly[j][2]) * k
    end
    return { cx / (3 * a), cy / (3 * a) }
end
local CHAMBER = { { 6, 20 }, { 30, 6 }, { 62, 6 }, { 80, 18 }, { 84, 40 }, { 84, 48 }, { 82, 72 }, { 60, 88 }, { 26, 86 }, { 4, 60 } }
local AREA_TUNNEL = {
    outline = { { 6, 20 }, { 30, 6 }, { 62, 6 }, { 80, 18 }, { 84, 40 }, { 104, 39 }, { 104, 26 }, { 122, 24 }, { 124, 60 },
                { 104, 60 }, { 104, 48 }, { 84, 48 }, { 82, 72 }, { 60, 88 }, { 26, 86 }, { 4, 60 } },
    walls = { { 30, 36, 5 }, { 56, 66, 4 }, { 48, 20, 1.2, "crate" }, { 114, 52, 1.2, "crate" }, { 20, 70, 3, "mound" }, { 66, 30, 1.5 } },
    centre = centroid(CHAMBER),
    tunnel_x = 84,                                   -- past here is the tunnel or the side chamber
}
function AREA_TUNNEL.ground() return 0 end
function AREA_TUNNEL.height(x, y)
    for _, w in ipairs(AREA_TUNNEL.walls) do
        if (x - w[1]) ^ 2 + (y - w[2]) ^ 2 < w[3] ^ 2 then return TALL[w[4]] or (w[3] > 2 and 5 or 1.2) end
    end
    return 0
end
function AREA_TUNNEL.road() return false end
-- }}}

-- {{{ local function lcg
-- A seeded random source, so each GIF is the same every time it is made.
local function lcg(seed)
    local s = seed
    return function()
        s = (s * 1103515245 + 12345) % 2147483648
        return s / 2147483648
    end
end
-- }}}

-- {{{ local function place_buddies
local function place_buddies(n, rand, near, area)
    area = area or AREA
    local out = {}
    while #out < n do
        local x, y
        if near then x, y = near[1] + (rand() - 0.5) * 16, near[2] + (rand() - 0.5) * 16
        else x, y = 8 + rand() * 112, 8 + rand() * 82 end
        if Roam.walkable(area, x, y, 2) then out[#out + 1] = { id = #out + 1, x = x, y = y } end
    end
    return out
end
-- }}}

-- {{{ local function render
-- Run a scene for FRAMES ticks (or scene.frames: the waypoint readings
-- need longer to show a lap) and write the GIF. scene.overlay draws the
-- idea's extras on each frame after the buddies.
local function render(name, scene)
    local rand  = lcg(scene.seed or 7)
    local state = scene.setup(rand)
    local base  = base_map(scene.area or AREA)
    local trails = {}
    local frames = {}
    local count  = scene.frames or FRAMES
    -- scene.rand_per_sim: each sim draws from its own copy of the same
    -- seeded source, so two sims make the same random choices (the same
    -- waypoints) and differ only by their settings
    local rands = {}
    for si in ipairs(state.sims) do rands[si] = scene.rand_per_sim and lcg(scene.seed or 7) or rand end
    for t = 1, count do
        if scene.before_tick then scene.before_tick(state, t, rand) end
        for si, s in ipairs(state.sims) do Roam.tick(s, rands[si]) end
        if scene.after_tick then scene.after_tick(state, t, rand) end
        local f = new_frame()
        copy(f, base)
        for si, s in ipairs(state.sims) do
            for _, b in ipairs(s.buddies) do
                local key = si * 100 + b.id
                trails[key] = trails[key] or {}
                table.insert(trails[key], { px(b.x), py(b.y) })
                if #trails[key] > (scene.trail or 40) then table.remove(trails[key], 1) end
                for _, p in ipairs(trails[key]) do plot(f, p[1], p[2], 14) end
            end
        end
        if scene.under then scene.under(f, state, t) end
        for _, s in ipairs(state.sims) do
            for _, b in ipairs(s.buddies) do draw_buddy(f, s, b, scene.color and scene.color(b) or BUDDY[(b.id - 1) % #BUDDY + 1], scene.to_scale) end
        end
        if scene.overlay then scene.overlay(f, state, t) end
        frames[t] = f
    end
    local path = OUT_DIR .. "/" .. name .. ".gif"
    local bytes = gif.write(path, { width = W, height = H, palette_bytes = palette, frames = frames, delay_cs = DELAY_CS })
    print(string.format("  %-26s %4d frames, %7d bytes", name .. ".gif", count, bytes))
    return path
end
-- }}}

-- {{{ the scenes, in the order the page shows them
local SCENES = {}

-- 1. the reading taken as the default: far-enough lists per step
SCENES[#SCENES + 1] = {
    name = "01-far-lists",
    title = "Reading A: a \"far enough\" list for every step",
    before = "Six buddies spread over **one** named area (about 120 by 90 yards, rocks in grey). Each tick, every buddy looks at **twelve** possible steps and standing still. The short tick on each circle shows which way it circles the area's centre; faint dots are the **last** few seconds of its path.",
    after = "For each possible step, the buddy works out which others it would be at **least** the spacing away from: that step's \"far enough\" list. It **prefers** the step that brings it closest to having everyone on its list (measured by distance, so every yard gained counts), then the one that turns with its circling direction, then the one keeping its nearest neighbour near the spacing. Watch the **start**: bunched in a corner, they burst apart, then settle into an even spread across the whole area that slowly wheels, each on its own heading. This is the reading **closest** to \"they each have their own separate 'far enough away from these buddy-bots' lists, one for each direction\", with \"direction\" meaning each way it could step. **Two** fixes came from watching it: a buddy is gently pushed back once within 12 yards of the area's edge (without it they circled the rim in pairs), and the spacing is judged by distance rather than a yes/no count (without it a buddy inside a crowd saw no difference between steps and never left).",
    setup = function(rand)
        return { sims = { Roam.new(AREA, place_buddies(6, rand, { 40, 20 }), { reading = "far-lists" }, rand) } }
    end,
}

-- 2. inside the decision of one buddy
SCENES[#SCENES + 1] = {
    name = "02-one-buddys-choice",
    title = "Inside one buddy's choice",
    before = "The same model, watching **only** the red buddy's decision. The rays are its twelve possible steps, brighter the **long**er that step's \"far enough\" list; dark rays are refused (a rock, or the area's edge). Green lines go to the buddies it **will** be far enough from after its chosen step, red lines to the ones still too close.",
    after = "Early on, when they start bunched together, most lines are **red** and it steps outward, whichever way turns with its circle. Once the group has spread, the lines go green and the choice is decided mostly by the circling and a small random nudge, so it **drifts** rather than marching. Refused rays are how rocks are walked around: no pathfinding, just **never** choosing a step into one.",
    setup = function(rand)
        return { sims = { Roam.new(AREA, place_buddies(6, rand, { 60, 40 }), { reading = "far-lists" }, rand) } }
    end,
    overlay = function(f, st)
        local s = st.sims[1]
        local b = s.buddies[1]
        if not b.last then return end
        local x0, y0 = px(b.x), py(b.y)
        local maxn = 0
        for _, c in ipairs(b.last.candidates) do if c.ok and c.list and #c.list > maxn then maxn = #c.list end end
        for i = 2, #b.last.candidates do
            local c = b.last.candidates[i]
            local ex = x0 + (c.x - b.x) * SCALE * 6
            local ey = y0 + (c.y - b.y) * SCALE * 6
            line(f, x0, y0, math.floor(ex + 0.5), math.floor(ey + 0.5), c.ok and ((c.list and #c.list == maxn) and 20 or 18) or 19)
        end
        local far = {}
        for _, id in ipairs(b.last.chosen.list or {}) do far[id] = true end
        for _, o in ipairs(s.buddies) do
            if o ~= b then line(f, x0, y0, px(o.x), py(o.y), far[o.id] and 12 or 13, true) end
        end
        draw_buddy(f, s, b, 6)
    end,
}

-- 3. the spring reading
SCENES[#SCENES + 1] = {
    name = "03-spring",
    title = "Reading B: a spring to the spacing, no lists",
    before = "Each buddy looks **only** at its nearest neighbour: pushed away if closer than the spacing, pulled in if farther, and turning with its circle. The **pale** rings are the spacing around each buddy.",
    after = "Simpler, and it also spreads them, but **differently**: since only the nearest neighbour counts, buddies tend to sit in twos and short chains at the spacing rather than covering the area evenly. A buddy far from everyone is pulled **back** toward the others (\"they just try and congregate at a certain distance\"), which keeps them together; Reading A lets a buddy wander alone as long as everyone is far enough. Fewer numbers to keep, **less** even coverage.",
    setup = function(rand)
        return { sims = { Roam.new(AREA, place_buddies(6, rand, { 60, 40 }), { reading = "spring" }, rand) } }
    end,
    under = function(f, st)
        local s = st.sims[1]
        for _, b in ipairs(s.buddies) do ring(f, px(b.x), py(b.y), s.spacing * SCALE, 21, true) end
    end,
}

-- 4. lists per circling direction
SCENES[#SCENES + 1] = {
    name = "04-spin-lists",
    title = "Reading C: a list for each way round",
    before = "Here \"one for each direction\" means the **two** ways round the centre. Every tick, each buddy looks a few steps ahead both ways and keeps a \"far enough\" list for each; it circles the way whose list is **long**er. Orange buddies circle clockwise, blue counter-clockwise; watch them **switch**.",
    after = "In practice most buddies end up circling the **same** way: whichever way has more room wins, and once most go one way, that way stays roomier. The **occasional** blue one turns back when it would crowd the one ahead, which reads as \"pseudo-random\" wandering from a distance. So in this reading the random starting direction **doesn't** last; if the owner wants each buddy to keep its own direction, Reading A holds it (the direction there never changes).",
    setup = function(rand)
        return { sims = { Roam.new(AREA, place_buddies(6, rand), { reading = "spin-lists" }, rand) } }
    end,
    color = function(b) return b.spin == -1 and 7 or 9 end,
}

-- 5. spacing, close and far
SCENES[#SCENES + 1] = {
    name = "05-close-and-far",
    title = "The spacing: close or far",
    before = "The same Reading A, run **twice** on the same map from the same start: dim-ringed buddies with a 12-yard spacing (close), bright ones with a 30-yard spacing (far). The owner said \"whether that's close or far, doesn't matter\".",
    after = "The spacing sets the **whole** look: close, they move as a loose pack that wheels together; far, they cover the area like sentries. Without a setting the model uses **0.6** of the even share (the side of the square each would get if the area were divided among them), about 22 yards here for six; the whole share, about 37 yards, was tried first and pushed them against the edges. Which reads best in game is a **tuning** choice, logged in the balance file when made.",
    setup = function(rand)
        local start = place_buddies(5, rand, { 60, 45 })
        local copy2 = {}
        for i, b in ipairs(start) do copy2[i] = { id = b.id + 10, x = b.x, y = b.y } end
        return { sims = {
            Roam.new(AREA, start, { reading = "far-lists", spacing = 12 }, rand),
            Roam.new(AREA, copy2, { reading = "far-lists", spacing = 30 }, rand),
        } }
    end,
    color = function(b) return b.id > 10 and 20 or 18 end,
}

-- 6. grouping by distance
-- The rings are drawn at half the real distances (the owner, 2026-09-27:
-- at full size the join ring covered the whole drawn area, so nothing
-- happened): join 30 (60), experience 37 (74), leave 37.5 (75).
local HALF_JOIN, HALF_FAR, HALF_LEAVE = 30, 37, 37.5
SCENES[#SCENES + 1] = {
