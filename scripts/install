#!/bin/bash

set -e
set -o pipefail

SELF_DIR="${BASH_SOURCE[0]%/*}"
[[ "${SELF_DIR}" == "${BASH_SOURCE[0]}" ]] && SELF_DIR="."

EXPLICIT_DIR=""
DIR_SCAN_ARGS=("$@")
for (( dir_scan_index = 0; dir_scan_index < ${#DIR_SCAN_ARGS[@]}; dir_scan_index++ )); do
    case "${DIR_SCAN_ARGS[dir_scan_index]}" in
        --dir)   EXPLICIT_DIR="${DIR_SCAN_ARGS[dir_scan_index + 1]:-}" ;;
        --dir=*) EXPLICIT_DIR="${DIR_SCAN_ARGS[dir_scan_index]#*=}"    ;;
    esac
done

if [[ -n "${EXPLICIT_DIR}" ]]; then
    DIR_CANDIDATE="${EXPLICIT_DIR}"
    DIR_SOURCE="the --dir argument"
else
    DIR_CANDIDATE="${SELF_DIR}/.."
    DIR_SOURCE="where this script lives, ${BASH_SOURCE[0]}"
fi

if [[ ! -d "${DIR_CANDIDATE}" ]]; then
    echo "Project directory does not exist: ${DIR_CANDIDATE}"
    echo "  This came from ${DIR_SOURCE}."
    echo "  Nothing has been changed."
    exit 1
fi

DIR="$( builtin cd -P -- "${DIR_CANDIDATE}" && pwd )"


if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi
DEFAULT_PROFILE="${PROFILE}"


declare -A PROFILE_REPO=(
    ["alpha"]="https://github.com/azerothcore/azerothcore-wotlk.git"
    ["beta"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["release"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["vanilla"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["basic"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["cc-test"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
)

declare -A PROFILE_BRANCH=(
    ["alpha"]="master"    # issue 134: alpha-baseline is a local branch made from master
    ["beta"]="Playerbot"
    ["release"]="Playerbot"
    ["vanilla"]="Playerbot"
    ["basic"]="Playerbot"
    ["cc-test"]="Playerbot"
)

declare -A PROFILE_COMMIT=(
    ["alpha"]=""
    ["beta"]="2a2211cd8f3d"
    ["release"]="2a2211cd8f3d"
    ["vanilla"]="2a2211cd8f3d"
    ["basic"]="2a2211cd8f3d"
    ["cc-test"]="2a2211cd8f3d"
)

declare -A PROFILE_MODULES=(
    ["alpha"]="mod-eluna mod-transmog"
    ["beta"]="mod-ale mod-aoe-loot mod-grownup mod-playerbots"
    ["release"]="mod-ale mod-playerbots"
    ["vanilla"]="mod-playerbots mod-solo-lfg mod-aoe-loot mod-fireworks-on-level mod-ale"
    ["basic"]="mod-playerbots mod-solo-lfg mod-aoe-loot mod-fireworks-on-level mod-ale"
    ["cc-test"]="mod-playerbots mod-ale"
)

declare -A MODULE_REPOS=(
    ["mod-ale"]="https://github.com/azerothcore/mod-ale.git"
    ["mod-eluna"]="https://github.com/azerothcore/mod-eluna.git"
    ["mod-aoe-loot"]="https://github.com/azerothcore/mod-aoe-loot.git"   # 2026-10-09: AzerothCore's own, was the TerraByte-tbwps fork (owner: "let's switch")
    ["mod-grownup"]="https://github.com/webluke/mod-grownup"
    ["mod-playerbots"]="https://github.com/liyunfan1223/mod-playerbots.git --branch=master"
    ["mod-solo-lfg"]="https://github.com/azerothcore/mod-solo-lfg.git"
    ["mod-fireworks-on-level"]="https://github.com/azerothcore/mod-fireworks-on-level.git"
)

declare -A PROFILE_MODULE_COMMITS=(
    ["release:mod-eluna"]="1abf244"
    ["beta:mod-playerbots"]="037c0141"
    ["release:mod-playerbots"]="037c0141"
    ["vanilla:mod-playerbots"]="037c0141"
    ["basic:mod-playerbots"]="037c0141"
    ["cc-test:mod-playerbots"]="037c0141"
    ["beta:mod-ale"]="cead0cb"
    ["release:mod-ale"]="cead0cb"
    ["vanilla:mod-ale"]="cead0cb"
    ["basic:mod-ale"]="cead0cb"
    ["cc-test:mod-ale"]="cead0cb"
)


FORCE_REBUILD=false
COMPILE_ARGS=()

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    PROFILE="${2}"
                    COMPILE_ARGS+=("--profile" "${2}")
                    shift 2
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                if [[ -z "${PROFILE}" ]]; then
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                COMPILE_ARGS+=("--profile" "${PROFILE}")
                shift
                ;;
            --dir)
                if [[ -n "${2:-}" ]]; then
                    COMPILE_ARGS+=("--dir" "${2}")
                    shift 2
                else
                    echo "Error: --dir requires a path"
                    exit 1
                fi
                ;;
            --dir=*)
                COMPILE_ARGS+=("--dir" "${1#*=}")
                shift
                ;;
            --threads)
                if [[ -n "${2:-}" && "${2}" =~ ^[0-9]+$ ]]; then
                    COMPILE_ARGS+=("--threads" "${2}")
                    shift 2
                else
                    echo "Error: --threads requires a numeric argument"
                    exit 1
                fi
                ;;
            --threads=*)
                threads_value="${1#*=}"
                if [[ ! "${threads_value}" =~ ^[0-9]+$ ]]; then
                    echo "Error: --threads requires a numeric argument"
                    exit 1
                fi
                COMPILE_ARGS+=("--threads" "${threads_value}")
                shift
                ;;
            --force)
                FORCE_REBUILD=true
                COMPILE_ARGS+=("--force")
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                echo "Error: unrecognized argument '${1}'"
                echo "Run with --help to see available options."
                exit 1
                ;;
        esac
    done
}

show_help() {
    echo "Usage: ./scripts/install [options]"
    echo ""
    echo "First-time setup: clone source, install modules, build, setup MySQL."
    echo ""
    echo "Options:"
    echo "  --dir <path>       Project directory"
    echo "                     (default: the parent of this script's directory)"
    echo "  --profile <name>   Use specific profile (default: ${DEFAULT_PROFILE})"
    echo "  --threads <n>      Number of threads"
    echo "  --force            Re-clone everything from scratch"
    echo "  --help             Show this help message"
    echo ""
    echo "After install:"
    echo "  1. ./scripts/start-mysql   - Start MySQL"
    echo "  2. ./scripts/authserver    - Start auth server"
    echo "  3. ./scripts/worldserver   - Start world server"
}


get_profile_paths() {
    case "${PROFILE}" in
        release) AC_CODE_DIR="${DIR}/source-beta"  ;;
        beta)    AC_CODE_DIR="${DIR}/source-beta"  ;;
        vanilla) AC_CODE_DIR="${DIR}/source-beta"  ;;
        basic)   AC_CODE_DIR="${DIR}/source-beta"  ;;
        cc-test) AC_CODE_DIR="${DIR}/source-beta"  ;;
        alpha)   AC_CODE_DIR="${DIR}/source-alpha" ;;
        *)       echo "ERROR: Unknown profile '${PROFILE}'"; exit 1 ;;
    esac
    INSTALL_DIR="${DIR}/installed-files-${PROFILE}"
    MYSQL_DIR="${DIR}/mysql/installed-files"
}



parse_args "$@"
get_profile_paths

if [[ ! -f "${DIR}/.profile" ]]; then
    echo "${PROFILE}" > "${DIR}/.profile"
    echo "No .profile yet: wrote '${PROFILE}' to ${DIR}/.profile"
fi

REPO="${PROFILE_REPO[$PROFILE]}"
BRANCH="${PROFILE_BRANCH[$PROFILE]}"
COMMIT="${PROFILE_COMMIT[$PROFILE]}"
MODULES="${PROFILE_MODULES[$PROFILE]}"

echo "Profile: ${PROFILE}"
echo "  Repository: ${REPO##*/}"
echo "  Branch: ${BRANCH}"
[[ -n "${COMMIT}" ]] && echo "  Pinned: ${COMMIT:0:10}"
echo "  Modules: ${MODULES:-none}"
echo ""

if [[ "${FORCE_REBUILD}" == true ]]; then
    echo "Force reinstall requested - cleaning source..."
    rm -rf "${AC_CODE_DIR}"
fi

if [[ ! -d "${AC_CODE_DIR}/.git" ]]; then
    echo "Cloning AzerothCore (${BRANCH} branch)..."
    git clone "${REPO}" --branch="${BRANCH}" "${AC_CODE_DIR}"
    if [[ -n "${COMMIT}" ]]; then
        echo "Checking out ${COMMIT:0:10}..."
        git -C "${AC_CODE_DIR}" checkout "${COMMIT}"
    fi
fi

source "${DIR}/patches/patches.sh"
reset_source_trees

mkdir -p "${AC_CODE_DIR}/modules"

for existing_mod in "${AC_CODE_DIR}"/modules/*/; do
    if [[ -d "${existing_mod}" ]]; then
        existing_name=$(basename "${existing_mod}")
        if [[ ! " ${MODULES} " =~ " ${existing_name} " ]]; then
            echo "  Removing ${existing_name} (not in ${PROFILE} profile)..."
            rm -rf "${existing_mod}"
        fi
    fi
done

for mod_name in ${MODULES}; do
    mod_dir="${AC_CODE_DIR}/modules/${mod_name}"
    mod_url="${MODULE_REPOS[$mod_name]:-}"
    mod_url="${mod_url%% *}"                          # the address, without "--branch=..."
    [[ -d "${mod_dir}/.git" && -n "${mod_url}" ]] || continue
    have_url="$(git -C "${mod_dir}" remote get-url origin)"
    if [[ "${have_url}" != "${mod_url}" ]]; then
        echo "  ${mod_name}: cloned from ${have_url}, wanted ${mod_url}; removing it to clone again"
        rm -rf "${mod_dir}"
    fi
done

for mod_name in ${MODULES}; do
    mod_repo="${MODULE_REPOS[$mod_name]}"
    if [[ -z "${mod_repo}" ]]; then
        echo "  Warning: Unknown module '${mod_name}', skipping"
        continue
    fi

    mod_dir="${AC_CODE_DIR}/modules/${mod_name}"
    mod_commit="${PROFILE_MODULE_COMMITS[${PROFILE}:${mod_name}]:-}"

    [[ "${FORCE_REBUILD}" == true && -d "${mod_dir}" ]] && rm -rf "${mod_dir}"

    if [[ ! -d "${mod_dir}/.git" ]]; then
        echo "  Cloning ${mod_name}..."
        cd "${AC_CODE_DIR}/modules"
        git clone ${mod_repo}
        if [[ -n "${mod_commit}" ]]; then
            git -C "${mod_dir}" checkout "${mod_commit}"
        fi
        cd - > /dev/null
    fi
done

echo ""
"${DIR}/scripts/compile" "${COMPILE_ARGS[@]}"

DB_AUTH="acore_auth"
DB_WORLD="$(_profile_db_name acore_world)"
DB_CHARS="$(_profile_db_name acore_characters)"
DB_PLAYERBOTS="$(_profile_db_name acore_playerbots)"

echo ""
echo "Setting up MySQL databases for profile '${PROFILE}'..."
echo "  Auth (shared): ${DB_AUTH}"
echo "  World:         ${DB_WORLD}"
echo "  Characters:    ${DB_CHARS}"
echo "  Playerbots:    ${DB_PLAYERBOTS}"

MYSQL_SOCKET="${DIR}/mysql/databases/mysql.sock"

seed_database_base() {
    local db="${1}"
    local base_dir="${2}"
    local marker_table="${3}"

    if "${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" \
        -u ritz -pmenardi "${db}" \
        -e "SHOW TABLES LIKE '${marker_table}'" 2>/dev/null | grep -q "${marker_table}"; then
        echo "  ${db}: already seeded (${marker_table} table present, skipping)"
        return 0
    fi

    if [[ ! -d "${base_dir}" ]]; then
        echo "  ERROR: base directory not found for ${db}: ${base_dir}"
        return 1
    fi

    local total
    total=$(find "${base_dir}" -maxdepth 1 -name "*.sql" | wc -l)
    if [[ "${total}" -eq 0 ]]; then
        echo "  ERROR: no .sql files in ${base_dir}"
        return 1
    fi

    echo "  ${db}: importing ${total} base files from ${base_dir#${DIR}/}/..."

    local count=0
    local file
    for file in "${base_dir}"/*.sql; do
        count=$((count + 1))
        if (( count % 50 == 0 || count == total )); then
            printf "    [%d/%d] %s\n" "${count}" "${total}" "$(basename "${file}")"
        fi
        if ! "${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" \
            -u ritz -pmenardi "${db}" < "${file}" 2>&1; then
            echo "  ERROR: failed importing $(basename "${file}") into ${db}"
            echo "  Path: ${file}"
            return 1
        fi
    done

    echo "  ${db}: base import complete (${count} files)"
    return 0
}

if "${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" -u ritz -pmenardi -e "USE ${DB_WORLD}; USE ${DB_PLAYERBOTS}" 2>/dev/null; then
    echo "  Databases already exist (skipping CREATE)"
else
    if [[ ! -S "${MYSQL_SOCKET}" ]]; then
        echo ""
        echo "==============================================================================="
        echo "MySQL SETUP SKIPPED: Socket not found"
        echo "==============================================================================="
        echo "Expected: ${MYSQL_SOCKET}"
        echo ""
        echo "To complete setup:"
        echo "  1. Start MySQL: ./scripts/start-mysql"
        echo "  2. Re-run install: ./scripts/install"
        exit 1
    fi

    if ! "${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" -u root << EOF
-- CREATE USER IF NOT EXISTS, never DROP USER: the ritz account already
-- holds grants on every other profile's databases. Dropping and
-- recreating it (the old behavior) left it with grants on this
-- profile's databases only, so the first install of a new profile cut
-- every other profile off from its own data.
CREATE USER IF NOT EXISTS 'ritz'@'localhost' IDENTIFIED BY 'menardi' WITH MAX_QUERIES_PER_HOUR 0 MAX_CONNECTIONS_PER_HOUR 0 MAX_UPDATES_PER_HOUR 0;
CREATE DATABASE IF NOT EXISTS \`${DB_AUTH}\` DEFAULT CHARACTER SET UTF8MB4 COLLATE utf8mb4_unicode_ci;
CREATE DATABASE IF NOT EXISTS \`${DB_WORLD}\` DEFAULT CHARACTER SET UTF8MB4 COLLATE utf8mb4_unicode_ci;
CREATE DATABASE IF NOT EXISTS \`${DB_CHARS}\` DEFAULT CHARACTER SET UTF8MB4 COLLATE utf8mb4_unicode_ci;
CREATE DATABASE IF NOT EXISTS \`${DB_PLAYERBOTS}\` DEFAULT CHARACTER SET UTF8MB4 COLLATE utf8mb4_unicode_ci;
GRANT ALL PRIVILEGES ON \`${DB_AUTH}\` . * TO 'ritz'@'localhost' WITH GRANT OPTION;
GRANT ALL PRIVILEGES ON \`${DB_WORLD}\` . * TO 'ritz'@'localhost' WITH GRANT OPTION;
GRANT ALL PRIVILEGES ON \`${DB_CHARS}\` . * TO 'ritz'@'localhost' WITH GRANT OPTION;
GRANT ALL PRIVILEGES ON \`${DB_PLAYERBOTS}\` . * TO 'ritz'@'localhost' WITH GRANT OPTION;
FLUSH PRIVILEGES;
EOF
    then
        echo "  ERROR: Database creation failed"
        exit 1
    fi

    echo "  Databases and user created successfully"
fi

echo ""
echo "Seeding base database content..."
echo "  Source: ${AC_CODE_DIR#${DIR}/}/data/sql/base/"
seed_database_base "${DB_AUTH}"  "${AC_CODE_DIR}/data/sql/base/db_auth"       "account"
seed_database_base "${DB_CHARS}" "${AC_CODE_DIR}/data/sql/base/db_characters" "characters"
seed_database_base "${DB_WORLD}" "${AC_CODE_DIR}/data/sql/base/db_world"      "version"

if [[ ! -d "${DIR}/data-files/dbc" ]]; then
    SHARED_DATA="/home/ritz/games/azeroth-core/data-files"
    if [[ -d "${SHARED_DATA}" ]]; then
        echo "Copying data-files into project..."
        mkdir -p "${DIR}/data-files"
        cp -r "${SHARED_DATA}"/* "${DIR}/data-files/"
        echo "Data files copied successfully"
    else
        echo "Warning: Game data not found at ${SHARED_DATA}"
        echo "Extract dbc, maps, vmaps, mmaps from WoW client to: ${DIR}/data-files/"
        mkdir -p "${DIR}/data-files"
    fi
else
    echo "Data files already present"
fi

echo ""
echo "Installation complete!"
echo "Next steps:"
echo "  1. Start MySQL: ./scripts/start-mysql"
echo "  2. Start auth server: ./scripts/authserver"
echo "  3. Start world server: ./scripts/worldserver"
