#!/bin/bash
# scripts/install - First-time setup for AzerothCore
# Clones source, installs modules, then calls compile
# Also sets up MySQL databases and copies data files

set -e
set -o pipefail

# {{{ set_dir
# The project directory: --dir when given, otherwise the parent of the
# directory this script lives in.
#
# Scanned out of the arguments here rather than in parse_args further
# down, because the profile is read from ${DIR}/.profile a few lines
# below and parse_args does not run until long after that. Reading the
# profile from one project and then working on another is the failure
# this ordering avoids.
#
# No hard-coded path. This departs from the house convention on purpose,
# so the project can be worked on from a machine that has never seen it.
# The derivation is safe here in a way it is not for the three
# dependency scripts: this one is useless without a full checkout around
# it, so if it is running at all, it is sitting in that checkout's
# scripts directory. See issue 154.
SELF_DIR="${BASH_SOURCE[0]%/*}"
[[ "${SELF_DIR}" == "${BASH_SOURCE[0]}" ]] && SELF_DIR="."

EXPLICIT_DIR=""
DIR_SCAN_ARGS=("$@")
for (( dir_scan_index = 0; dir_scan_index < ${#DIR_SCAN_ARGS[@]}; dir_scan_index++ )); do
    case "${DIR_SCAN_ARGS[dir_scan_index]}" in
        --dir)   EXPLICIT_DIR="${DIR_SCAN_ARGS[dir_scan_index + 1]:-}" ;;
        --dir=*) EXPLICIT_DIR="${DIR_SCAN_ARGS[dir_scan_index]#*=}"    ;;
    esac
done

if [[ -n "${EXPLICIT_DIR}" ]]; then
    DIR_CANDIDATE="${EXPLICIT_DIR}"
    DIR_SOURCE="the --dir argument"
else
    DIR_CANDIDATE="${SELF_DIR}/.."
    DIR_SOURCE="where this script lives, ${BASH_SOURCE[0]}"
fi

if [[ ! -d "${DIR_CANDIDATE}" ]]; then
    echo "Project directory does not exist: ${DIR_CANDIDATE}"
    echo "  This came from ${DIR_SOURCE}."
    echo "  Nothing has been changed."
    exit 1
fi

# Resolved rather than kept as written, so every path built from it is
# valid regardless of the working directory this was invoked from, and
# so a project reachable through a symlink compares equal to itself.
DIR="$( builtin cd -P -- "${DIR_CANDIDATE}" && pwd )"
# }}}

# =============================================================================
# Load Profile
# =============================================================================

if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi
# DEFAULT_PROFILE snapshots the no-argument default so --help reports the
# true default even when a --profile flag precedes --help on the command
# line (that flag mutates PROFILE, not the default a bare run would use).
DEFAULT_PROFILE="${PROFILE}"

# =============================================================================
# Profile Definitions
# =============================================================================

# {{{ Repository URLs
declare -A PROFILE_REPO=(
    ["alpha"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["beta"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["release"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["vanilla"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
)
# }}}

# {{{ Branch per profile
declare -A PROFILE_BRANCH=(
    ["alpha"]="Playerbot"
    ["beta"]="Playerbot"
    ["release"]="Playerbot"
    ["vanilla"]="Playerbot"
)
# }}}

# {{{ Pinned commits
# Empty string means "track HEAD".
# 2026-07-22: beta/release/vanilla (the shared source-beta tree) pinned
# to 52f58186a533 until further notice (issue 308) — the playerbot
# facade corruption was diagnosed and contained (B026/B027) against
# exactly this revision, and the B027 repair is verified working on it.
# Moving HEAD would re-open the diagnosis. The three profiles share one
# tree, so they must pin identically. History: vanilla was pinned
# 2026-06-02 per 148 and un-pinned the same day to stay current.
# Must match scripts/update's block.
declare -A PROFILE_COMMIT=(
    ["alpha"]=""
    ["beta"]="52f58186a533"
    ["release"]="52f58186a533"
    ["vanilla"]="52f58186a533"
)
# }}}

# {{{ Modules per profile
declare -A PROFILE_MODULES=(
    ["alpha"]="mod-eluna mod-transmog"
    ["beta"]="mod-ale mod-aoe-loot mod-grownup mod-playerbots"
    ["release"]="mod-ale mod-playerbots"
    ["vanilla"]="mod-playerbots mod-solo-lfg mod-aoe-loot mod-fireworks-on-level mod-ale"
)
# }}}

# {{{ Module repository URLs
# Two new entries added 2026-06-02 for vanilla: mod-solo-lfg lets a
# solo player queue the dungeon finder with playerbots filling the
# group; mod-fireworks-on-level is the level-up confetti flair.
declare -A MODULE_REPOS=(
    ["mod-ale"]="https://github.com/azerothcore/mod-ale.git"
    ["mod-eluna"]="https://github.com/azerothcore/mod-eluna.git"
    ["mod-aoe-loot"]="https://github.com/TerraByte-tbwps/mod-aoe-loot.git"
    ["mod-grownup"]="https://github.com/webluke/mod-grownup"
    ["mod-playerbots"]="https://github.com/liyunfan1223/mod-playerbots.git --branch=master"
    ["mod-solo-lfg"]="https://github.com/azerothcore/mod-solo-lfg.git"
    ["mod-fireworks-on-level"]="https://github.com/azerothcore/mod-fireworks-on-level.git"
)
# }}}

# {{{ Module commits per profile
# 2026-07-22: mod-playerbots pinned to 93aaea3d for every profile that
# ships it, until further notice (issue 308). That is the module HEAD
# the facade-corruption diagnosis and the B027 repair were verified
# against; its sibling core pin (52f58186a533) lives in PROFILE_COMMIT
# above. Un-pin both together once upstream fixes the corrupt-facade
# construction. The release:mod-eluna pin predates 148 and stays.
# Must match scripts/update's block.
declare -A PROFILE_MODULE_COMMITS=(
    ["release:mod-eluna"]="1abf244"
    ["beta:mod-playerbots"]="93aaea3d"
    ["release:mod-playerbots"]="93aaea3d"
    ["vanilla:mod-playerbots"]="93aaea3d"
)
# }}}

# =============================================================================
# Argument Parsing
# =============================================================================

FORCE_REBUILD=false
COMPILE_ARGS=()

# {{{ parse_args
# Each option supports both --opt value and --opt=value forms. The
# catch-all errors instead of silently dropping unknown args, so
# typos like --profil=vanilla don't quietly fall back to the
# .profile default.
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    PROFILE="${2}"
                    COMPILE_ARGS+=("--profile" "${2}")
                    shift 2
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                if [[ -z "${PROFILE}" ]]; then
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                COMPILE_ARGS+=("--profile" "${PROFILE}")
                shift
                ;;
            --dir)
                # Already resolved by the scan at the top of the file;
                # consumed here so the catch-all does not reject it,
                # and forwarded so compile works on the same project.
                if [[ -n "${2:-}" ]]; then
                    COMPILE_ARGS+=("--dir" "${2}")
                    shift 2
                else
                    echo "Error: --dir requires a path"
                    exit 1
                fi
                ;;
            --dir=*)
                COMPILE_ARGS+=("--dir" "${1#*=}")
                shift
                ;;
            --threads)
                if [[ -n "${2:-}" && "${2}" =~ ^[0-9]+$ ]]; then
                    COMPILE_ARGS+=("--threads" "${2}")
                    shift 2
                else
                    echo "Error: --threads requires a numeric argument"
                    exit 1
                fi
                ;;
            --threads=*)
                threads_value="${1#*=}"
                if [[ ! "${threads_value}" =~ ^[0-9]+$ ]]; then
                    echo "Error: --threads requires a numeric argument"
                    exit 1
                fi
                COMPILE_ARGS+=("--threads" "${threads_value}")
                shift
                ;;
            --force)
                FORCE_REBUILD=true
                COMPILE_ARGS+=("--force")
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                echo "Error: unrecognized argument '${1}'"
                echo "Run with --help to see available options."
                exit 1
                ;;
        esac
    done
}
# }}}

# {{{ show_help
show_help() {
    echo "Usage: ./scripts/install [options]"
    echo ""
    echo "First-time setup: clone source, install modules, build, setup MySQL."
    echo ""
    echo "Options:"
    echo "  --dir <path>       Project directory"
    echo "                     (default: the parent of this script's directory)"
    echo "  --profile <name>   Use specific profile (default: ${DEFAULT_PROFILE})"
    echo "  --threads <n>      Number of threads"
    echo "  --force            Re-clone everything from scratch"
    echo "  --help             Show this help message"
    echo ""
    echo "After install:"
    echo "  1. ./scripts/start-mysql   - Start MySQL"
    echo "  2. ./scripts/authserver    - Start auth server"
    echo "  3. ./scripts/worldserver   - Start world server"
}
# }}}

# =============================================================================
# Functions
# =============================================================================

# {{{ get_profile_paths
# vanilla shares source-beta with release/beta — same upstream fork
# (liyunfan1223/azerothcore-wotlk on the Playerbot branch), same
# schema, same compile target. What differs between the three is the
# module set, the C-patch selection, and the database namespace
# (vanilla suffixes with _vanilla per 148). See issue 136's fourth-
# path design for the rationale on treating the source tree as a
# regenerable build artifact rather than a per-profile checkout.
get_profile_paths() {
    case "${PROFILE}" in
        release) AC_CODE_DIR="${DIR}/source-beta"  ;;
        beta)    AC_CODE_DIR="${DIR}/source-beta"  ;;
        vanilla) AC_CODE_DIR="${DIR}/source-beta"  ;;
        alpha)   AC_CODE_DIR="${DIR}/source-alpha" ;;
        *)       echo "ERROR: Unknown profile '${PROFILE}'"; exit 1 ;;
    esac
    INSTALL_DIR="${DIR}/installed-files-${PROFILE}"
    MYSQL_DIR="${DIR}/mysql/installed-files"
}
# }}}

# update_modules_symlink was removed 2026-05-19 as part of the fourth-path
# refactor recorded in issue 136. Under the fourth-path design, modules are
# cloned directly into source-beta/modules/ from upstream per the MODULE_REPOS
# manifest, so no symlink swap is needed. The function (and modules-beta/)
# are gone.

# =============================================================================
# Main
# =============================================================================

parse_args "$@"
get_profile_paths

REPO="${PROFILE_REPO[$PROFILE]}"
BRANCH="${PROFILE_BRANCH[$PROFILE]}"
COMMIT="${PROFILE_COMMIT[$PROFILE]}"
MODULES="${PROFILE_MODULES[$PROFILE]}"

echo "Profile: ${PROFILE}"
echo "  Repository: ${REPO##*/}"
echo "  Branch: ${BRANCH}"
[[ -n "${COMMIT}" ]] && echo "  Pinned: ${COMMIT:0:10}"
echo "  Modules: ${MODULES:-none}"
echo ""

# Force reinstall
if [[ "${FORCE_REBUILD}" == true ]]; then
    echo "Force reinstall requested - cleaning source..."
    rm -rf "${AC_CODE_DIR}"
fi

# Clone core if missing
if [[ ! -d "${AC_CODE_DIR}/.git" ]]; then
    echo "Cloning AzerothCore (${BRANCH} branch)..."
    git clone "${REPO}" --branch="${BRANCH}" "${AC_CODE_DIR}"
    if [[ -n "${COMMIT}" ]]; then
        echo "Checking out ${COMMIT:0:10}..."
        git -C "${AC_CODE_DIR}" checkout "${COMMIT}"
    fi
fi

# Hard-reset source-beta and every module to HEAD before module-clone
# and compile. Source trees are build artifacts (issue 136); anything in
# the working tree is discardable. See patches.sh:reset_source_trees.
source "${DIR}/patches/patches.sh"
reset_source_trees

# Handle modules
# (Modules are cloned directly into source-beta/modules/ per MODULE_REPOS
# below. No symlink swap — see issue 136's fourth-path design.)
mkdir -p "${AC_CODE_DIR}/modules"

# Remove modules not in this profile
for existing_mod in "${AC_CODE_DIR}"/modules/*/; do
    if [[ -d "${existing_mod}" ]]; then
        existing_name=$(basename "${existing_mod}")
        if [[ ! " ${MODULES} " =~ " ${existing_name} " ]]; then
            echo "  Removing ${existing_name} (not in ${PROFILE} profile)..."
            rm -rf "${existing_mod}"
        fi
    fi
done

# Clone missing modules
for mod_name in ${MODULES}; do
    mod_repo="${MODULE_REPOS[$mod_name]}"
    if [[ -z "${mod_repo}" ]]; then
        echo "  Warning: Unknown module '${mod_name}', skipping"
        continue
    fi

    mod_dir="${AC_CODE_DIR}/modules/${mod_name}"
    mod_commit="${PROFILE_MODULE_COMMITS[${PROFILE}:${mod_name}]:-}"

    [[ "${FORCE_REBUILD}" == true && -d "${mod_dir}" ]] && rm -rf "${mod_dir}"

    if [[ ! -d "${mod_dir}/.git" ]]; then
        echo "  Cloning ${mod_name}..."
        cd "${AC_CODE_DIR}/modules"
        git clone ${mod_repo}
        if [[ -n "${mod_commit}" ]]; then
            git -C "${mod_dir}" checkout "${mod_commit}"
        fi
        cd - > /dev/null
    fi
done

# Call compile script. compile self-bootstraps ccache (issue 149)
# and update funnels through compile too, so no extra ccache call
# is needed here.
echo ""
"${DIR}/scripts/compile" "${COMPILE_ARGS[@]}"

# MySQL setup (after successful build)
DB_AUTH="acore_auth"
DB_WORLD="acore_world_${PROFILE}"
DB_CHARS="acore_characters_${PROFILE}"

echo ""
echo "Setting up MySQL databases for profile '${PROFILE}'..."
echo "  Auth (shared): ${DB_AUTH}"
echo "  World:         ${DB_WORLD}"
echo "  Characters:    ${DB_CHARS}"

MYSQL_SOCKET="${DIR}/mysql/databases/mysql.sock"

# {{{ seed_database_base
# Import the base SQL content for one database. Idempotent: if the
# marker table is already present, skip the import. Marker tables are
# the first content table created by each DB's base set (account for
# auth, characters for characters, version for world).
#
# AC's DatabaseLoader::Populate() in
# source-beta/src/server/database/Database/DatabaseLoader.cpp:138
# is supposed to do this on first worldserver boot, but its early-exit
# conditions (any table present → skip; MySQLExecutable unresolvable →
# skip; one base file failure → silent return-false-and-continue) make
# it possible for the populate phase to no-op silently while the
# subsequent Update phase still runs and crashes on the first missing
# content table. Owning the seed at install time turns a silent
# failure into a loud, traceable one. See issue 148's
# "Base Content Seeding" section for the full rationale.
seed_database_base() {
    local db="${1}"
    local base_dir="${2}"
    local marker_table="${3}"

    if "${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" \
        -u ritz -pmenardi "${db}" \
        -e "SHOW TABLES LIKE '${marker_table}'" 2>/dev/null | grep -q "${marker_table}"; then
        echo "  ${db}: already seeded (${marker_table} table present, skipping)"
        return 0
    fi

    if [[ ! -d "${base_dir}" ]]; then
        echo "  ERROR: base directory not found for ${db}: ${base_dir}"
        return 1
    fi

    local total
    total=$(find "${base_dir}" -maxdepth 1 -name "*.sql" | wc -l)
    if [[ "${total}" -eq 0 ]]; then
        echo "  ERROR: no .sql files in ${base_dir}"
        return 1
    fi

    echo "  ${db}: importing ${total} base files from ${base_dir#${DIR}/}/..."

    local count=0
    local file
    for file in "${base_dir}"/*.sql; do
        count=$((count + 1))
        # Quiet by default to avoid 300+ lines of noise; print every
        # 50th and the last so the user sees the import is progressing
        # without burying everything else in the install output.
        if (( count % 50 == 0 || count == total )); then
            printf "    [%d/%d] %s\n" "${count}" "${total}" "$(basename "${file}")"
        fi
        if ! "${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" \
            -u ritz -pmenardi "${db}" < "${file}" 2>&1; then
            echo "  ERROR: failed importing $(basename "${file}") into ${db}"
            echo "  Path: ${file}"
            return 1
        fi
    done

    echo "  ${db}: base import complete (${count} files)"
    return 0
}
# }}}

# Check whether the databases exist at all; create them if not. Note
# this only checks existence, not whether they've been seeded — the
# seed_database_base step below handles seeding idempotently.
if "${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" -u ritz -pmenardi -e "USE ${DB_WORLD}" 2>/dev/null; then
    echo "  Databases already exist (skipping CREATE)"
else
    if [[ ! -S "${MYSQL_SOCKET}" ]]; then
        echo ""
        echo "==============================================================================="
        echo "MySQL SETUP SKIPPED: Socket not found"
        echo "==============================================================================="
        echo "Expected: ${MYSQL_SOCKET}"
        echo ""
        echo "To complete setup:"
        echo "  1. Start MySQL: ./scripts/start-mysql"
        echo "  2. Re-run install: ./scripts/install"
        exit 1
    fi

    if ! "${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" -u root << EOF
DROP USER IF EXISTS 'ritz'@'localhost';
CREATE USER 'ritz'@'localhost' IDENTIFIED BY 'menardi' WITH MAX_QUERIES_PER_HOUR 0 MAX_CONNECTIONS_PER_HOUR 0 MAX_UPDATES_PER_HOUR 0;
CREATE DATABASE IF NOT EXISTS \`${DB_AUTH}\` DEFAULT CHARACTER SET UTF8MB4 COLLATE utf8mb4_unicode_ci;
CREATE DATABASE IF NOT EXISTS \`${DB_WORLD}\` DEFAULT CHARACTER SET UTF8MB4 COLLATE utf8mb4_unicode_ci;
CREATE DATABASE IF NOT EXISTS \`${DB_CHARS}\` DEFAULT CHARACTER SET UTF8MB4 COLLATE utf8mb4_unicode_ci;
GRANT ALL PRIVILEGES ON \`${DB_AUTH}\` . * TO 'ritz'@'localhost' WITH GRANT OPTION;
GRANT ALL PRIVILEGES ON \`${DB_WORLD}\` . * TO 'ritz'@'localhost' WITH GRANT OPTION;
GRANT ALL PRIVILEGES ON \`${DB_CHARS}\` . * TO 'ritz'@'localhost' WITH GRANT OPTION;
FLUSH PRIVILEGES;
EOF
    then
        echo "  ERROR: Database creation failed"
        exit 1
    fi

    echo "  Databases and user created successfully"
fi

# Seed base content for each DB. This is the missing step that
# leaves worldserver crashing on first boot with
# "Table 'acore_world_<profile>.version' doesn't exist" — the
# version table lives in source-beta/data/sql/base/db_world/version.sql
# along with ~300 other content tables that AC's Populate() phase
# should be importing but isn't on this profile.
echo ""
echo "Seeding base database content..."
echo "  Source: ${AC_CODE_DIR#${DIR}/}/data/sql/base/"
seed_database_base "${DB_AUTH}"  "${AC_CODE_DIR}/data/sql/base/db_auth"       "account"
seed_database_base "${DB_CHARS}" "${AC_CODE_DIR}/data/sql/base/db_characters" "characters"
seed_database_base "${DB_WORLD}" "${AC_CODE_DIR}/data/sql/base/db_world"      "version"

# Copy data files if needed
if [[ ! -d "${DIR}/data-files/dbc" ]]; then
    SHARED_DATA="/home/ritz/games/azeroth-core/data-files"
    if [[ -d "${SHARED_DATA}" ]]; then
        echo "Copying data-files into project..."
        mkdir -p "${DIR}/data-files"
        cp -r "${SHARED_DATA}"/* "${DIR}/data-files/"
        echo "Data files copied successfully"
    else
        echo "Warning: Game data not found at ${SHARED_DATA}"
        echo "Extract dbc, maps, vmaps, mmaps from WoW client to: ${DIR}/data-files/"
        mkdir -p "${DIR}/data-files"
    fi
else
    echo "Data files already present"
fi

echo ""
echo "Installation complete!"
echo "Next steps:"
echo "  1. Start MySQL: ./scripts/start-mysql"
echo "  2. Start auth server: ./scripts/authserver"
echo "  3. Start world server: ./scripts/worldserver"
