#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-rotation-time
# profiles:   all
# priority:   10
# kind:       test
# about:      the short abilities hold to issue 625f: cast time and global cooldown as time, casts cut by movement or a dying target, cooldowns started sooner valued
# quick-test: yes
# ==== end of header ====
# test-buddy-rotation-time - compiles and runs tests/buddy-rotation-time/rotation-check.cpp
# against the buddy module's short-ability look ahead (buddies_rotation_time.h,
# issue 625f), with no server.
#
# Usage: scripts/test-buddy-rotation-time [DIR]   (--help: this text)

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    sed -n '10,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
DIR="${1:-/mnt/kaun/wow-chat-2026}"
OUT="${DIR}/tmp/tmp"
mkdir -p "${OUT}"
g++ -std=c++17 -O1 -Wall -Wextra -Werror -I"${DIR}/patches/B036-mod-buddies/mod-buddies/src" \
    "${DIR}/tests/buddy-rotation-time/rotation-check.cpp" -o "${OUT}/buddy-rotation-time" || exit 1
nice -n 19 "${OUT}/buddy-rotation-time"
# ==== footer of test-buddy-rotation-time ====
# lines:      28
# ==== end of footer ====
