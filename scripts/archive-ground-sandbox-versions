#!/usr/bin/env luajit

if arg[1] == "--help" then
    print("archive-ground-sandbox-versions [PROJECT_DIR]: writes every committed version of")
    print("docs/HTML/ground-sandbox.html to docs/HTML/archive/ground-sandbox/, with an index (issue 617e16c).")
    os.exit(0)
end
local DIR  = arg[1] or "/mnt/kaun/wow-chat-2026"
local PAGE = "docs/HTML/ground-sandbox.html"
local OUT  = DIR .. "/docs/HTML/archive/ground-sandbox"
os.execute("mkdir -p '" .. OUT .. "'")

local function sh(cmd) local h = io.popen(cmd); local s = h:read("*a"); h:close(); return s end

local versions = {}
for line in sh(("git -C '%s' log --reverse --format='%%h%%x09%%ad%%x09%%s' --date=format:%%Y-%%m-%%d-%%H%%M -- %s"):format(DIR, PAGE)):gmatch("[^\n]+") do
    local sha, when, subject = line:match("^(%S+)\t(%S+)\t(.*)$")
    versions[#versions + 1] = { sha = sha, when = when, subject = subject, name = when .. "-" .. sha .. ".html" }
end
if #versions == 0 then io.stderr:write("archive-ground-sandbox-versions: no commit has " .. PAGE .. "\n"); os.exit(1) end

local written = 0
for _, v in ipairs(versions) do
    local path = OUT .. "/" .. v.name
    local f = io.open(path, "r")
    if f then f:close() else
        local page = sh(("git -C '%s' show %s:%s"):format(DIR, v.sha, PAGE))
        if #page == 0 then io.stderr:write("archive-ground-sandbox-versions: commit " .. v.sha .. " gave no page\n"); os.exit(1) end
        page = page:gsub("([\"`])ground%-sandbox/", "%1../../ground-sandbox/")
        local note = ("<!-- archived by scripts/archive-ground-sandbox-versions: docs/HTML/ground-sandbox.html as of commit %s (%s): %s -->\n"):format(v.sha, v.when, v.subject:gsub("%-%-", "- -"))
        page = page:gsub("^(<!doctype html>\n?)", "%1" .. note:gsub("%%", "%%%%"), 1)
        f = assert(io.open(path, "w")); f:write(page); f:close()
        written = written + 1
    end
    v.pictures = {}
    for pic in sh(("git -C '%s' show --name-only --format= %s -- development-history/"):format(DIR, v.sha)):gmatch("development%-history/([^\n]+%.png)") do
        v.pictures[#v.pictures + 1] = pic
    end
end

local function esc(s) return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end
local rows = {}
for i = #versions, 1, -1 do
    local v = versions[i]
    local pics = {}
    for _, p in ipairs(v.pictures) do pics[#pics + 1] = ('<a href="../../../../development-history/%s">%s</a>'):format(p, p:match("^(%d+)")) end
    rows[#rows + 1] = ('<tr><td class="n">%d</td><td><a href="%s">%s</a></td><td><code>%s</code></td><td>%s</td><td>%s</td></tr>'):format(
        i, v.name, v.when, v.sha, esc(v.subject), table.concat(pics, " "))
end
local f = assert(io.open(OUT .. "/index.html", "w"))
f:write(([[<!doctype html>
<!-- docs/HTML/archive/ground-sandbox/index.html - GENERATED by scripts/archive-ground-sandbox-versions (issue 617e16c). Don't edit; run it again. -->
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ground Sandbox Versions</title>
<style>
  :root { --bg: #f6f3ec; --fg: #222; --dim: #6b665c; --line: #d8d2c4; }
  @media (prefers-color-scheme: dark) { :root { --bg: #16161a; --fg: #e6e2d8; --dim: #9a958a; --line: #34343c; } }
  body { background: var(--bg); color: var(--fg); font: 14px/1.45 system-ui, sans-serif; margin: 16px; }
  table { border-collapse: collapse; width: 100%%; }
  td, th { border-bottom: 1px solid var(--line); padding: 5px 8px; text-align: left; vertical-align: top; }
  .n { font-variant-numeric: tabular-nums; color: var(--dim); text-align: right; }
  a { color: inherit; }
</style></head><body>
<h1>Ground sandbox: every version</h1>
<p>Each committed version of the page, newest first: open one to see the bots as they moved then. The pictures are the ones that commit filed in development-history/.</p>
<table><tr><th class="n">#</th><th>Version</th><th>Commit</th><th>What changed</th><th>Pictures</th></tr>
%s
</table></body></html>
]]):format(table.concat(rows, "\n")))
f:close()
print(("archive-ground-sandbox-versions: %d versions (%d written now) -> %s/index.html"):format(#versions, written, OUT))
