#!/usr/bin/env luajit
-- generate-basic-gem-supply-sql - gather the two lists basic's gem supply SQL
-- needs and can't work out by itself, and write them into that SQL file
-- (issue 155p).
--
-- For a general audience: the gem supply SQL decides which recipes and gems
-- drop where. Two facts it needs live outside the world database:
--   1. which Jewelcrafting spell makes which gem. A recipe's product is in
--      the game client's spell file, not in the database;
--   2. which Outland zone each monster lives in. Rare gem-cutting recipes
--      drop in the "first half" of Outland's zones or the "second half"
--      (Ritz, 2026-09-25), and the database doesn't record zones for
--      monsters. This tool reads the server's own extracted map files,
--      which store the area under every 33-yard square of the world,
--      exactly the way the server looks up a zone, and sorts each monster
--      type by the zones its spawns stand in.
-- It writes both lists as plain data between two marker lines in the SQL
-- file; re-running replaces only that block.
--
-- Usage: scripts/generate-basic-gem-supply-sql [PROJECT_DIR] [WORLD_DB]
--   Reads   data-files/dbc/{SkillLineAbility,Spell,AreaTable}.dbc
--           data-files/maps/530*.map (Outland's map, area layer)
--           WORLD_DB (default acore_world_release: stock spawns) on the
--           project MySQL, read-only: creature spawns on map 530
--   Writes  sql/basic/db_world.src/18-gem-supply.apply.sql (GENERATED block)

local DIR   = arg[1] or "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local DB    = arg[2] or "acore_world_release"
local DBC   = DIR .. "/data-files/dbc/"
local MAPS  = DIR .. "/data-files/maps/"
local OUT   = DIR .. "/sql/basic/db_world.src/18-gem-supply.apply.sql"
local MYSQL = DIR .. "/mysql/installed-files/bin/mysql -h127.0.0.1 -P3307 -uritz -pmenardi -N --batch " .. DB

-- {{{ configuration
local SKILL_JEWELCRAFTING = 755
local GRID = 533.3333                                -- SIZE_OF_GRIDS in the server's GridDefines.h
-- Outland's zones in two halves (Ritz, 2026-09-25: "the uncommon cut
-- designs [...] come from the first half of the open world, and rare cut
-- designs come from the second half"), in the ladder's order
local HALF = {
    [3483] = 1, [3521] = 1, [3519] = 1, [3518] = 1,  -- Hellfire Peninsula, Zangarmarsh, Terokkar Forest, Nagrand
    [3522] = 2, [3523] = 2, [3520] = 2, [4080] = 2,  -- Blade's Edge, Netherstorm, Shadowmoon Valley, Isle of Quel'Danas
}
local BEGIN_MARK = "-- >>> GENERATED by scripts/generate-basic-gem-supply-sql"
local END_MARK   = "-- <<< GENERATED END"
-- }}}

-- {{{ local function die
local function die(msg)
    io.stderr:write("generate-basic-gem-supply-sql: ", msg, "\n")
    os.exit(1)
end
-- }}}

-- {{{ local function u32
local function u32(d, o) local a, b, c, e = d:byte(o + 1, o + 4); return a + b * 256 + c * 65536 + e * 16777216 end
-- }}}

-- {{{ local function load_dbc
-- Returns the record count, record size and a uint32 reader over the file.
local function load_dbc(name)
    local f = io.open(DBC .. name, "rb") or die("cannot open " .. DBC .. name)
    local d = f:read("*a")
    f:close()
    if d:sub(1, 4) ~= "WDBC" then die(name .. " is not a WDBC file") end
    return u32(d, 4), u32(d, 12), function(o) return u32(d, o) end
end
-- }}}

-- {{{ local function jewelcrafting_cuts
-- SkillLineAbility.dbc: 1 skill line, 2 spell. Spell.dbc: 0 id, 107 the
-- item its first effect creates. Returns { {spell, item}, ... } for every
-- Jewelcrafting spell that creates an item (the SQL keeps the gems).
local function jewelcrafting_cuts()
    local n, rs, u = load_dbc("SkillLineAbility.dbc")
    local jc = {}
    for r = 0, n - 1 do local b = 20 + r * rs; if u(b + 4) == SKILL_JEWELCRAFTING then jc[u(b + 8)] = true end end
    local sn, srs, su = load_dbc("Spell.dbc")
    local out = {}
    for r = 0, sn - 1 do
        local b = 20 + r * srs
        local id, item = su(b), su(b + 107 * 4)
        if jc[id] and item ~= 0 then out[#out + 1] = { id, item } end
    end
    return out
end
-- }}}

-- {{{ local function zone_of
-- Area id -> its zone (the top of its parent chain; AreaTable.dbc: 0 id,
-- 2 parent). Returns a function(area) -> zone.
local function zone_lookup()
    local n, rs, u = load_dbc("AreaTable.dbc")
    local parent = {}
    for r = 0, n - 1 do local b = 20 + r * rs; parent[u(b)] = u(b + 8) end
    return function(area)
        local seen = 0
        while parent[area] and parent[area] ~= 0 and seen < 10 do area = parent[area]; seen = seen + 1 end
        return area
    end
end
-- }}}

-- {{{ local function area_at
-- The area id under (x, y) on map 530, read like GridTerrainData::getArea:
-- the tile file is maps/530XXYY.map with XX = int(32 - x/GRID), YY =
-- int(32 - y/GRID); its area layer is one id for the whole tile, or 16x16
-- ids indexed [lx * 16 + ly]. Tiles are cached. A spawn over a missing
-- tile (open sky between islands) gives nil.
local tiles = {}
local function area_at(x, y)
    local gx, gy = math.floor(32 - x / GRID), math.floor(32 - y / GRID)
    local key = gx * 100 + gy
    local t = tiles[key]
    if t == nil then
        local f = io.open(string.format("%s530%02d%02d.map", MAPS, gx, gy), "rb")
        if not f then tiles[key] = false; return nil end
        local d = f:read("*a")
        f:close()
        local off = u32(d, 12)                        -- map_fileheader.areaMapOffset
        local flags = d:byte(off + 5) + d:byte(off + 6) * 256
        local grid  = d:byte(off + 7) + d:byte(off + 8) * 256
        t = { data = d, off = off, single = (flags % 2 == 1) and grid or nil }
        tiles[key] = t
    end
    if not t then return nil end
    if t.single then return t.single end
    local lx = math.floor(16 * (32 - x / GRID)) % 16
    local ly = math.floor(16 * (32 - y / GRID)) % 16
    local o = t.off + 8 + (lx * 16 + ly) * 2
    return t.data:byte(o + 1) + t.data:byte(o + 2) * 256
end
-- }}}

-- {{{ local function template_halves
-- Every creature template spawned on map 530, and which half of Outland its
-- spawns stand in: 1 or 2 when all its spawns inside Outland's eight zones
-- are in one half, 3 when it stands in both. Templates with no spawn in
-- those zones are left out.
local function template_halves()
    local zone_of = zone_lookup()
    local p = io.popen(MYSQL .. " -e \"SELECT id1, position_x, position_y FROM creature WHERE map = 530\" 2>&1")
    local halves, n = {}, 0
    for line in p:lines() do
        if not line:find("Using a password", 1, true) then
            if line:find("^ERROR") then die("database " .. DB .. ": " .. line) end
            local id, x, y = line:match("^(%d+)\t(%S+)\t(%S+)$")
            if not id then die("unexpected row from " .. DB .. ": " .. line) end
            local area = area_at(tonumber(x), tonumber(y))
            local h = area and HALF[zone_of(area)]
            if h then
                id = tonumber(id)
                halves[id] = (halves[id] == nil or halves[id] == h) and h or 3
                n = n + 1
            end
        end
    end
    p:close()
    if n == 0 then die("no spawns found in Outland's zones (database " .. DB .. " empty, or the map files moved?)") end
    local out = {}
    for id, h in pairs(halves) do out[#out + 1] = { id, h } end
    table.sort(out, function(a, b) return a[1] < b[1] end)
    return out, n
end
-- }}}

-- {{{ main
local cuts = jewelcrafting_cuts()
local halves, spawns = template_halves()
if #cuts == 0 then die("no Jewelcrafting spells found; the client files may have moved") end
local c, h = {}, {}
for _, r in ipairs(cuts) do c[#c + 1] = string.format("(%d,%d)", r[1], r[2]) end
for _, r in ipairs(halves) do h[#h + 1] = string.format("(%d,%d)", r[1], r[2]) end
local block = table.concat({
    BEGIN_MARK .. " — do not edit by hand",
    "-- Jewelcrafting spells and the item each makes (SkillLineAbility.dbc, Spell.dbc): " .. #cuts,
    "INSERT INTO `tmp_155p_cuts` (`spell`, `item`) VALUES " .. table.concat(c, ",") .. ";",
    string.format("-- creature templates by Outland half (1 first, 2 second, 3 both), from %d spawns on the server's map files: %d", spawns, #halves),
    "INSERT INTO `tmp_155p_halves` (`entry`, `half`) VALUES " .. table.concat(h, ",") .. ";",
    END_MARK }, "\n")
local f = io.open(OUT, "r") or die("cannot open " .. OUT)
local sql = f:read("*a")
f:close()
local a = sql:find(BEGIN_MARK, 1, true)
local b = sql:find(END_MARK, 1, true)
if not a or not b or b < a then die("markers not found in " .. OUT) end
sql = sql:sub(1, a - 1) .. block .. sql:sub(b + #END_MARK)
f = assert(io.open(OUT, "w"))
f:write(sql)
f:close()
io.write(string.format("wrote %d Jewelcrafting spells and %d Outland templates (%d spawns) into %s\n", #cuts, #halves, spawns, OUT))
-- }}}
