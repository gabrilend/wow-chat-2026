#!/usr/bin/env luajit
--------------------------------------------------------------------------------
-- split-install-steps - one file per install step (issue 150)
--
-- For a general audience: every install step (the E patches: SQL, links,
-- config files set up after the server is built) lived in one file,
-- patches/E-patches.sh, which by October 2026 held 63 steps in about 3,200
-- lines, and was where two pieces of work collided most. This cuts it into
-- one file per step (patches/E0NN-<name>.sh), with the helpers they share
-- in patches/E-helpers.sh, and turns E-patches.sh into a short loader that
-- reads the helpers and then every step file, so everything that loads
-- E-patches.sh keeps working unchanged.
--
-- Each step is one fold block ("# -- {{{ patch_E0NN_..." to "# -- }}}") in
-- the old file; comments between blocks go with the block after them. The
-- two statements outside any block (DIR and the staged-SQL list) open the
-- helpers file.
--
-- Proof that nothing changed: the old file and the new loader are each
-- sourced in a clean shell, and the code of every function and the two
-- globals they define are compared. Any difference, and the old file is put
-- back, the new files removed, and the tool stops with an error.
--
-- Usage: scripts/split-install-steps [PROJECT_DIR]
-- Run once; a second run sees the loader and refuses.
--------------------------------------------------------------------------------

local DIR = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end
local P        = DIR .. "/patches/"
local OLD      = P .. "E-patches.sh"
local HELPERS  = P .. "E-helpers.sh"
local LOADER_MARK = "# E-patches.sh - loads the install steps, one file each (issue 150)"

-- {{{ local helpers
local function slurp(p) local f = io.open(p, "r"); if not f then return nil end local s = f:read("*a"); f:close(); return s end
local function spit(p, s) local f = assert(io.open(p, "w")); f:write(s); f:close() end
local function q(s) return "'" .. s:gsub("'", "'\\''") .. "'" end
local function run(cmd) local h = io.popen(cmd .. " 2>&1"); local out = h:read("*a"); h:close(); return out end
-- every function's code and the two globals, as a clean shell defines them
-- after sourcing `file` (no profile, no inherited functions)
local function definitions(file)
    return run("env -i HOME=" .. q(os.getenv("HOME") or "/tmp") .. " PATH=" .. q(os.getenv("PATH")) ..
               " DIR=" .. q(DIR) .. " bash --noprofile --norc -c " ..
               q("source " .. q(file) .. " > /dev/null 2>&1; declare -f; declare -p STAGED_SQL_DIRS DIR"))
end
-- }}}

local src = slurp(OLD)
if not src then error("split-install-steps: " .. OLD .. " is missing") end
if src:find(LOADER_MARK, 1, true) then error("split-install-steps: " .. OLD .. " is already the loader; nothing to split") end

-- {{{ cut the file into blocks
-- top: the file's opening comment (dropped: the loader and helpers get
--      their own); statements: the two lines outside any block;
-- blocks: { name, lines } in file order, each with the comments before it
local lines = {}
for l in (src .. (src:sub(-1) == "\n" and "" or "\n")):gmatch("([^\n]*)\n") do lines[#lines + 1] = l end
local blocks, pending, statements, depth, cur = {}, {}, {}, 0, nil
local seen_code = false
for _, l in ipairs(lines) do
    local opens = l:match("^# %-%- {{{ (%S+)")
    if opens then
        depth = depth + 1
        if depth > 1 then error("split-install-steps: a fold opens inside another (" .. opens .. "); fix the fold markers first") end
        cur = { name = opens, lines = {} }
        -- comments right before the block belong to it; blank lines between stay blank
        while #pending > 0 and pending[1]:match("^%s*$") do table.remove(pending, 1) end
        for _, p in ipairs(pending) do cur.lines[#cur.lines + 1] = p end
        pending = {}
        cur.lines[#cur.lines + 1] = l
    elseif depth > 0 then
        cur.lines[#cur.lines + 1] = l
        if l:match("^# %-%- }}}") then depth = depth - 1; blocks[#blocks + 1] = cur; cur = nil end
    else
        if l:match("^%s*#") or l:match("^%s*$") then
            if seen_code then pending[#pending + 1] = l end
        else
            statements[#statements + 1] = l
            seen_code = true
            pending = {}
        end
    end
end
if depth ~= 0 then error("split-install-steps: a fold is still open at the end of the file") end
-- }}}

-- {{{ write the step files and the helpers
local written, helpers_blocks, steps = {}, {}, 0
for _, b in ipairs(blocks) do
    local id, rest = b.name:match("^patch_(E%d%d%d)_(.+)$")
    if id then
        local path = P .. id .. "-" .. rest:gsub("_", "-") .. ".sh"
        local body = table.concat({
            "#!/usr/bin/env bash",
            "# " .. id .. "-" .. rest:gsub("_", "-") .. ".sh - one install step, loaded by patches/E-patches.sh",
            "# (split out of that file by scripts/split-install-steps, issue 150). Its",
            "# helpers (_register_with_updatefetcher, _profile_db_name, ...) are in",
            "# patches/E-helpers.sh, loaded first.",
            "",
            table.concat(b.lines, "\n"),
            "",
        }, "\n")
        spit(path, body)
        written[#written + 1] = path
        steps = steps + 1
    else
        helpers_blocks[#helpers_blocks + 1] = table.concat(b.lines, "\n")
    end
end
spit(HELPERS, table.concat({
    "#!/usr/bin/env bash",
    "# E-helpers.sh - what the install steps share, loaded first by patches/E-patches.sh",
    "#",
    "# For a general audience: the install steps (one file each, patches/E0NN-*.sh)",
    "# lean on a few shared tools: registering an SQL folder with the server's",
    "# database updater, naming a profile's databases, applying the settings",
    "# patches (config/patches/C*.sh). They live here, split out of the old",
    "# single E-patches.sh by scripts/split-install-steps (issue 150).",
    "",
    table.concat(statements, "\n"),
    "",
    table.concat(helpers_blocks, "\n\n"),
    "",
}, "\n"))
written[#written + 1] = HELPERS
-- }}}

-- {{{ the loader, and the proof
local loader = table.concat({
    "#!/usr/bin/env bash",
    LOADER_MARK,
    "#",
    "# For a general audience: the install steps (PHASE_END patches: SQL, links and",
    "# config files set up after the server is built) are one file each,",
    "# patches/E0NN-<name>.sh, with what they share in patches/E-helpers.sh. This",
    "# loads the helpers and then every step file, so whatever loads this file",
    "# (patches/patches.sh, the tests) gets every step as before. Which steps a",
    "# profile runs, and in what order, is its list in patches/patches.sh.",
    "# A step that fails to load stops the loading with its name.",
    "",
    "E_PATCHES_DIR=\"${BASH_SOURCE[0]%/*}\"",
    "source \"${E_PATCHES_DIR}/E-helpers.sh\" || { echo \"ERROR: patches/E-helpers.sh did not load\"; return 1 2>/dev/null || exit 1; }",
    "for e_patch_file in \"${E_PATCHES_DIR}\"/E[0-9][0-9][0-9]-*.sh; do",
    "    source \"${e_patch_file}\" || { echo \"ERROR: ${e_patch_file} did not load\"; return 1 2>/dev/null || exit 1; }",
    "done",
    "unset e_patch_file",
    "",
}, "\n")
local before = definitions(OLD)
local saved = OLD .. ".before-split"
spit(saved, src)
spit(OLD, loader)
local after = definitions(OLD)
if before ~= after then
    spit(OLD, src)
    for _, w in ipairs(written) do os.remove(w) end
    local bf, af = saved .. ".defs", OLD .. ".after.defs"
    spit(bf, before); spit(af, after)
    error("split-install-steps: the split files do not define the same functions as the old file; the old file is back, the new ones removed. Compare: diff " .. bf .. " " .. af)
end
os.remove(saved)
print(string.format("split %d install steps into patches/E0NN-*.sh, %d helpers into patches/E-helpers.sh;", steps, #helpers_blocks))
print(string.format("E-patches.sh is the loader. Same functions and globals before and after (%d lines of definitions compared).",
      select(2, before:gsub("\n", "\n"))))
-- }}}
