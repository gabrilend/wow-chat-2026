    echo ""
    echo "  authserver         Start the authentication server"
    echo "  worldserver        Start the world server"
    echo "  setup-db           Create databases for current profile (run before first validate)"
    echo "  validate           Test worldserver from shadow (validates build before promotion)"
    echo "  promote            Promote shadow build to main (after successful validation)"
    echo "  apply-patches      Manually apply patches for current profile (to shadow)"
    echo "    --begin          Apply PHASE_BEGIN patches (source modifications)"
    echo "    --end            Apply PHASE_END patches (configs, symlinks) [default]"
    echo "    --begin --end    Apply both phases (can combine flags)"
    echo "    --revert         Revert patches (triggers recompile for --begin)"
    echo "    --dry-run        Show what would be applied without applying"
    echo "  keira              Launch Keira3 database editor"
    echo "  profiles           List available version profiles"
