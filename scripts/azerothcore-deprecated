parse_args() {
    COMMAND=""
    COMMAND_ARGS=()

    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    if [[ -v "PROFILE_REPO[${2}]" ]]; then
                        PROFILE="${2}"
                        shift 2
                    else
                        echo "Error: Unknown profile '${2}'"
                        echo "Available profiles: alpha, beta, release"
                        exit 1
                    fi
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --threads)
                if [[ -n "${2:-}" && "${2}" =~ ^[0-9]+$ ]]; then
                    THREADS="${2}"
                    shift 2
                else
                    echo "Error: --threads requires a numeric argument"
                    exit 1
                fi
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            -*)
                COMMAND_ARGS+=("${1}")
                shift
                ;;
            *)
                if [[ -z "${COMMAND}" ]]; then
                    COMMAND="${1}"
                else
                    COMMAND_ARGS+=("${1}")
                fi
                shift
                ;;
        esac
    done
}

get_profile_paths() {
    local p="${PROFILE}"

    if [[ "${p}" == "alpha" ]]; then
        AC_CODE_DIR="${DIR}/source-alpha"
    else
        AC_CODE_DIR="${DIR}/source-beta"
    fi

    INSTALL_DIR="${DIR}/installed-files-${p}"
    BUILD_DIR="${DIR}/build-${p}"
    MYSQL_DIR="${DIR}/mysql/installed-files"
    BUILD_DIR_SHADOW="${DIR}/build-shadow"
    INSTALL_DIR_SHADOW="${DIR}/installed-files-shadow"
}

update_modules_symlink() {
    local p="${PROFILE}"

    if [[ "${p}" == "alpha" ]]; then
        return
    fi

    local modules_link="${DIR}/source-beta/modules"
    local target_dir

    if [[ "${p}" == "release" ]]; then
        target_dir="../modules-release"
    else
        target_dir="../modules-beta"
    fi

    if [[ -L "${modules_link}" ]]; then
        local current_target=$(readlink "${modules_link}")
        if [[ "${current_target}" != "${target_dir}" ]]; then
            echo "Updating modules symlink: ${current_target} -> ${target_dir}"
            rm "${modules_link}"
            ln -s "${target_dir}" "${modules_link}"
        fi
    else
        echo "Creating modules symlink: -> ${target_dir}"
        rm -rf "${modules_link}"
        ln -s "${target_dir}" "${modules_link}"
    fi
}

setup_log_symlinks() {
    local TMP_BASE="/tmp/wow-chat-2"
    local TMP_LOGS="${TMP_BASE}/logs-${PROFILE}"

    mkdir -p "${TMP_BASE}"
    mkdir -p "${TMP_LOGS}"

    [[ -L "${DIR}/tmp" ]] || ln -s "${TMP_BASE}" "${DIR}/tmp"

    [[ -L "${DIR}/logs-${PROFILE}" ]] || ln -s "${TMP_LOGS}" "${DIR}/logs-${PROFILE}"
}

cmd_profiles() {
    echo "Available version profiles:"
    echo ""
    printf "%-10s %-50s %-12s\n" "PROFILE" "REPOSITORY" "BRANCH"
    printf "%-10s %-50s %-12s\n" "-------" "----------" "------"
    for p in alpha beta release; do
        local repo="${PROFILE_REPO[$p]}"
        local branch="${PROFILE_BRANCH[$p]}"
        local commit="${PROFILE_COMMIT[$p]}"
        local suffix=""
        if [[ -n "${commit}" ]]; then
            suffix=" @${commit:0:7}"
        fi
        printf "%-10s %-50s %-12s\n" "${p}" "${repo##*/}" "${branch}${suffix}"
    done
    echo ""
    echo "Modules per profile:"
    for p in alpha beta release; do
        echo "  ${p}: ${PROFILE_MODULES[$p]}"
    done
    echo ""
    echo "Current profile: ${PROFILE}"
}

cmd_switch() {
    local new_profile="${1:-}"

    if [[ -z "${new_profile}" ]]; then
        echo "Usage: ./scripts/azerothcore switch <profile>"
        echo "Available profiles: alpha, beta, release"
        echo "Current profile: ${PROFILE}"
        return 1
    fi

    if [[ ! -v "PROFILE_REPO[${new_profile}]" ]]; then
        echo "Error: Unknown profile '${new_profile}'"
        echo "Available profiles: alpha, beta, release"
        return 1
    fi

    local old_profile="${PROFILE}"
    PROFILE="${new_profile}"
    get_profile_paths

    if [[ ! -f "${INSTALL_DIR}/bin/worldserver" ]]; then
        echo "Warning: Profile '${new_profile}' has not been built yet."
        echo "Expected: ${INSTALL_DIR}/bin/worldserver"
        echo "Run './scripts/azerothcore install all --profile ${new_profile}' first."
        echo ""
    fi

    echo "${new_profile}" > "${PROFILE_FILE}"

    echo "Switched from '${old_profile}' to '${new_profile}'"
    echo ""
    echo "Directories:"
    echo "  Source:    ${AC_CODE_DIR}"
    echo "  Build:     ${BUILD_DIR}"
    echo "  Installed: ${INSTALL_DIR}"
}

cmd_authserver() {
    get_profile_paths
    setup_log_symlinks

    if [[ -x "${DIR}/scripts/update-realmlist-ip" ]]; then
        echo "Updating realmlist with public IP..."
        "${DIR}/scripts/update-realmlist-ip" "${DIR}"
        echo ""
    fi

    if [[ ! -f "${INSTALL_DIR}/bin/authserver" ]]; then
        echo "Error: authserver not found for profile '${PROFILE}'"
        echo "Expected: ${INSTALL_DIR}/bin/authserver"
        echo "Run './scripts/azerothcore install all --profile ${PROFILE}' first."
        exit 1
    fi
    echo "Starting authserver (profile: ${PROFILE})"
    export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"
    cd "${INSTALL_DIR}/bin"
    ./authserver
}

cmd_worldserver() {
    get_profile_paths
    setup_log_symlinks
    if [[ ! -f "${INSTALL_DIR}/bin/worldserver" ]]; then
        echo "Error: worldserver not found for profile '${PROFILE}'"
        echo "Expected: ${INSTALL_DIR}/bin/worldserver"
        echo "Run './scripts/azerothcore install all --profile ${PROFILE}' first."
        exit 1
    fi
    echo "Starting worldserver (profile: ${PROFILE})"
    export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"
    cd "${INSTALL_DIR}/bin"
    ./worldserver
}

cmd_keira() {
    local KEIRA_DIR="/home/ritz/games/azeroth-core/keira"
    if [[ -d "${KEIRA_DIR}" ]]; then
        "${KEIRA_DIR}/Keira-${KEIRA_VERSION}.LINUX.AppImage" &
    else
        echo "Error: Keira not found at ${KEIRA_DIR}"
        exit 1
    fi
}

extract_custom_config() {
    local conf="$1"
    local dist="${conf}.dist"

    if [[ ! -f "${conf}" || ! -f "${dist}" ]]; then
        return
    fi

    while IFS= read -r line; do
        [[ "${line}" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line}" ]] && continue

        local key="${line%%=*}"
        key="${key%%[[:space:]]}"  # Trim trailing spaces

        [[ "${key}" == "${line}" ]] && continue

        local dist_line=$(grep "^${key}[[:space:]]*=" "${dist}" 2>/dev/null | head -1)

        if [[ -n "${dist_line}" && "${line}" != "${dist_line}" ]]; then
            echo "${line}"
        fi
    done < "${conf}"
}

apply_custom_config() {
    local conf="$1"

    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue

        local key="${line%%=*}"
        key="${key%%[[:space:]]}"

        local escaped_line=$(printf '%s\n' "${line}" | sed 's/[&/\]/\\&/g')

        sed -i "s|^${key}[[:space:]]*=.*|${escaped_line}|" "${conf}"
    done
}

init_config() {
    local conf="$1"
    local dist="${conf}.dist"

    if [[ ! -f "${dist}" ]]; then
        echo "  Warning: ${dist} not found"
        return 1
    fi

    local custom_values=""
    if [[ -f "${conf}" ]]; then
        custom_values=$(extract_custom_config "${conf}")
    fi

    cp -f "${dist}" "${conf}"

    if [[ -n "${custom_values}" ]]; then
        echo "${custom_values}" | apply_custom_config "${conf}"
    fi
}


source "${DIR}/patches/patches.sh"

patches_need_applying() {
    local FILE

    FILE="${AC_CODE_DIR}/modules/mod-aoe-loot/src/aoe_loot.cpp"
    if [[ -f "${FILE}" ]] && grep -q "^[[:space:]]*Item\* pItem = player->GetItemByGuid" "${FILE}"; then
        return 0  # B001 needs applying
    fi

    FILE="${AC_CODE_DIR}/modules/mod-playerbots/src/Bot/RandomPlayerbotMgr.cpp"
    if [[ -f "${FILE}" ]] && ! grep -q "sALE->OnLogin(bot)" "${FILE}"; then
        return 0  # B002 needs applying
    fi

    FILE="${AC_CODE_DIR}/modules/mod-ale/src/LuaEngine/LuaEngine.cpp"
    if [[ -f "${FILE}" ]] && ! grep -q "entry != 0 && !eObjectMgr->GetGameObjectTemplate" "${FILE}"; then
        return 0  # B003 needs applying
    fi

    FILE="${AC_CODE_DIR}/modules/mod-playerbots/src/strategy/values/BudgetValues.cpp"
    if [[ -f "${FILE}" ]] && grep -q "int32 BudgetCalculator::CalculateMaxBudget" "${FILE}"; then
        return 0  # B004 needs applying (warning fix not applied)
    fi

    FILE="${AC_CODE_DIR}/src/server/game/Entities/Unit/Unit.h"
    if [[ -f "${FILE}" ]] && ! grep -q "#define ACCURACY_LEVEL_CAP 3" "${FILE}"; then
        return 0  # B005 needs applying
    fi

    FILE="${AC_CODE_DIR}/modules/mod-ale/src/LuaEngine/Hooks.h"
    if [[ -f "${FILE}" ]] && ! grep -q "PLAYER_EVENT_ON_SELL_ITEM" "${FILE}"; then
        return 0  # B006 needs applying
    fi

    FILE="${AC_CODE_DIR}/modules/mod-ale/src/LuaEngine/UnitMethods.h"
    if [[ -f "${FILE}" ]] && ! grep -q "int SetWalk" "${FILE}"; then
        return 0  # B007 needs applying
    fi

    FILE="${AC_CODE_DIR}/modules/mod-talent-bonus/src/TalentBonus.cpp"
    if [[ ! -f "${FILE}" ]]; then
        return 0  # B008 needs applying (module not linked)
    fi

    return 1  # All patches already applied
}

apply_patches_middle() {
    :
}


apply_config_values() {
    echo "Applying config values for profile: ${PROFILE}..."

    if [[ ! -d "${DIR}/config/patches" ]]; then
        echo "  Warning: config/patches/ directory not found, using defaults"
        return 0
    fi

    declare -A CONFIG_PROFILES

    local patch_count=0
    for patch_file in "${DIR}/config/patches"/C*.sh; do
        [[ -f "${patch_file}" ]] || continue
        source "${patch_file}"
        ((patch_count++))
    done

    if [[ ${patch_count} -eq 0 ]]; then
        echo "  Warning: No config patches found in config/patches/"
        return 0
    fi

    local config_funcs=$(declare -F | grep "^declare -f config_" | sed 's/declare -f //')

    local applied_count=0
    for func in ${config_funcs}; do
        local profiles="${CONFIG_PROFILES[$func]:-}"
        if [[ " ${profiles} " =~ " ${PROFILE} " ]] || [[ " ${profiles} " =~ " all " ]]; then
            ${func}
            echo "  [✓] ${func}"
            ((applied_count++))
        fi
    done

    echo "  Applied ${applied_count} config values from ${patch_count} patches"
}

patch_E001_lua_script_symlinks() {
    local TARGET="${TARGET_INSTALL_DIR:-${INSTALL_DIR}}"
    mkdir -p "${TARGET}/bin/lua_scripts"
    ln -sfn "${DIR}/src/lua" "${TARGET}/bin/lua_scripts/custom"
