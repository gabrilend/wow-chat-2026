#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-radius
# profiles:   all
# priority:   10
# kind:       test
# about:      radius triggers hold to issue 165: enter once, leave past the slack, filters, removal; the bulletin board pins, sticky bosses, flag carriers always on
# quick-test: yes
# ==== end of header ====
# test-buddy-radius - checks the radius triggers and the bulletin board
# (roam/buddy_radius_core.h) against issue 165, with no server.
#
# For a general audience: an object can be given a radius; when something
# comes within it, listed actions run, and when it goes back out past a
# little slack, others do. A buddy's first use is a board of everything
# within 70 yards. The rules are plain C++, so this test builds them alone
# with the system compiler and plays them through.
#
# Usage: scripts/test-buddy-radius [PROJECT_DIR] [--help]
# Builds into tmp/tmp/ (the executable tier). Exits non-zero when any
# check fails.

set -uo pipefail

# {{{ configuration
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: scripts/test-buddy-radius [PROJECT_DIR]"
    echo "  Builds and runs the radius core's offline check (tests/buddy-radius/radius-check.cpp)."
    exit 0
fi
DIR="/mnt/kaun/wow-chat-2026"
[[ -n "${1:-}" ]] && DIR="$1"
CORE="${DIR}/patches/B036-mod-buddies/mod-buddies/src/roam"
SOURCE="${DIR}/tests/buddy-radius/radius-check.cpp"
EXEC_DIR="${DIR}/tmp/tmp"
BINARY="${EXEC_DIR}/buddy-radius-check"
# }}}

[[ -d "${DIR}/tmp" ]] || { echo "ERROR: ${DIR}/tmp missing (the project's link to /tmp/<project>)"; exit 1; }
mkdir -p "${EXEC_DIR}"

if ! g++ -std=c++17 -O2 -Wall -Wextra -Werror -I"${CORE}" "${SOURCE}" -o "${BINARY}"; then
    echo "test-buddy-radius: the radius core did not build alone (above); nothing was checked"
    exit 1
fi
"${BINARY}"
# ==== footer of test-buddy-radius ====
# lines:      49
# ==== end of footer ====
