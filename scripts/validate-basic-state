#!/usr/bin/env bash
# validate-basic-state — ground-truth checker for the basic profile's
# databases after an install and first worldserver boot (issue 155).
#
# For a general audience: the basic profile promises a specific world —
# level-1 starts in the stock valleys with no head-start kit or pretrained
# spells, no flight paths, Classic riding levels, quests open to the whole
# faction, a working starting-valley rotation, and level-64 creatures in the
# Outland dungeons a level 60 can enter. Each of those is a handful of database rows. This
# script asks the live basic databases whether every promise holds, and
# lists the offending rows when one does not. It only READS; it changes
# nothing.
#
# Usage:
#   scripts/validate-basic-state              # default project dir
#   scripts/validate-basic-state /path/to/project
#
# Exit status: 0 when every check passes, 1 when any check flags a row.

set -uo pipefail

# {{{ configuration
DIR="${1:-/mnt/mtwo/games/azeroth-core/wow-chat-2026}"

MYSQL="${DIR}/mysql/installed-files/bin/mysql"
WORLD="acore_world_basic"
CHARS="acore_characters_basic"

# Connection: the project MySQL by default. VALIDATE_MYSQL_SOCKET points it
# at another server instead (scripts/test-basic-sql-in-ram uses this for its
# throwaway RAM instance, where the user is root without a password).
if [[ -n "${VALIDATE_MYSQL_SOCKET:-}" ]]; then
    MYSQL_CONN=(--no-defaults --socket="${VALIDATE_MYSQL_SOCKET}" -uroot -N)
else
    export MYSQL_PWD="menardi"
    MYSQL_CONN=(-h127.0.0.1 -P3307 -uritz -N)
fi

FAIL_COUNT=0
# }}}

# {{{ run_sql()
# One query, tab-separated rows, no header. Errors print through.
run_sql() {
    "${MYSQL}" "${MYSQL_CONN[@]}" -e "$1"
}
# }}}

# {{{ report()
# Empty offender list = PASS; otherwise FAIL with the rows listed.
report() {
    local title="$1" offenders="$2"
    if [[ -z "${offenders}" ]]; then
        printf '  [PASS] %s\n' "${title}"
    else
        printf '  [FAIL] %s\n' "${title}"
        printf '%s\n' "${offenders}" | sed 's/^/         /'
        FAIL_COUNT=$((FAIL_COUNT + 1))
    fi
}
# }}}

# {{{ reachability
if ! run_sql "SELECT 1" > /dev/null; then
    echo "ERROR: cannot reach MySQL (${MYSQL_CONN[*]}) — nothing was checked."
    echo "       to debug: is ./scripts/start-mysql running? Did install create ${WORLD}?"
    exit 1
fi
# }}}

echo "Basic profile state (${WORLD}, ${CHARS})"

# {{{ 155c: no head-start, stock valleys, riding, flight paths
report "no starter-kit rows (vanilla-148h-*) in playercreateinfo_item" \
    "$(run_sql "SELECT race, class, itemid FROM ${WORLD}.playercreateinfo_item WHERE Note LIKE 'vanilla-148h-%' LIMIT 10")"
report "no pretrain rows (vanilla-148j-*) in playercreateinfo_spell_custom" \
    "$(run_sql "SELECT racemask, classmask, Spell FROM ${WORLD}.playercreateinfo_spell_custom WHERE Note LIKE 'vanilla-148j-%' LIMIT 10")"
# stock level-1 zones by race (non-DK): 1→12, 2→14, 3→1, 4→141, 5→85, 6→215,
# 7→1, 8→14, 10→3431, 11→3526. (B028 moves new characters at creation; this
# table is only the fallback-free stock baseline it starts from.)
report "playercreateinfo still holds the stock level-1 zones (E007 not applied)" \
    "$(run_sql "SELECT race, class, zone FROM ${WORLD}.playercreateinfo WHERE class <> 6 AND zone <> CASE race
        WHEN 1 THEN 12 WHEN 2 THEN 14 WHEN 3 THEN 1 WHEN 4 THEN 141 WHEN 5 THEN 85
        WHEN 6 THEN 215 WHEN 7 THEN 1 WHEN 8 THEN 14 WHEN 10 THEN 3431 WHEN 11 THEN 3526 END")"
report "Apprentice Riding (33388) trains at 40, Journeyman (33391) at 60" \
    "$(run_sql "SELECT SpellId, ReqLevel FROM ${WORLD}.trainer_spell WHERE (SpellId = 33388 AND ReqLevel <> 40) OR (SpellId = 33391 AND ReqLevel <> 60) LIMIT 10")"
report "no creature template carries the flightmaster flag" \
    "$(run_sql "SELECT entry, name FROM ${WORLD}.creature_template WHERE npcflag & 8192 LIMIT 10")"
report "every map-530 flightmaster has its flavor menu (90070–90104)" \
    "$(run_sql "SELECT entry FROM ${WORLD}.creature_template WHERE entry IN (17555,17554,16189,16192,24851,26560,21766,18939,19581,19317,18809,18789,18807,18940,19558,18808,16822,18942,18931,18930,20762,18785,18788,18791,16587,20234,22485,21107,22455,18937,18953,20515,22216,18938,19583) AND gossip_menu_id NOT BETWEEN 90070 AND 90104")"
# }}}

# {{{ 155e: quests gated by faction only
report "no quest restricted to part of one faction (masks within 1101 or 690)" \
    "$(run_sql "SELECT ID, AllowableRaces FROM ${WORLD}.quest_template WHERE AllowableRaces <> 0
        AND ((AllowableRaces & ~1101) = 0 AND AllowableRaces <> 1101 OR (AllowableRaces & ~690) = 0 AND AllowableRaces <> 690) LIMIT 10")"
report "every mentor site has its Visiting Mentor spawned (one per row of basic_155e_hubs)" \
    "$(run_sql "SELECT h.hub, h.name FROM ${WORLD}.basic_155e_hubs h LEFT JOIN ${WORLD}.creature c ON c.guid = 15500000 + h.hub AND c.id = 1550000 + h.hub WHERE c.guid IS NULL")"
report "each missing class has a non-empty trainer list (155101-155111), none for death knights" \
    "$(run_sql "SELECT DISTINCT m.class, 'no list' FROM ${WORLD}.basic_155e_missing m LEFT JOIN ${WORLD}.trainer_spell ts ON ts.TrainerId = 155100 + m.class WHERE ts.SpellId IS NULL
        UNION ALL SELECT 'death knight list present', COUNT(*) FROM ${WORLD}.trainer WHERE Id = 155106 HAVING COUNT(*) > 0")"
report "each mentor's menu offers exactly its site's missing classes" \
    "$(run_sql "SELECT m.hub, m.class, 'no dialogue line' FROM ${WORLD}.basic_155e_missing m
        LEFT JOIN ${WORLD}.gossip_menu_option o ON o.MenuID = 155000 + m.hub AND o.OptionID = m.class AND o.ActionMenuID = 155100 + m.class
        WHERE o.MenuID IS NULL")"
report "no placeholder trainers (26324-26332) left at a mentor site" \
    "$(run_sql "SELECT c.guid, c.id FROM ${WORLD}.creature c JOIN ${WORLD}.basic_155e_hubs v ON v.map = c.map
        WHERE c.id BETWEEN 26324 AND 26332 AND POW(c.position_x - v.x, 2) + POW(c.position_y - v.y, 2) < 60 * 60")"
report "quest race-mask backup table exists (the revert needs it)" \
    "$(run_sql "SELECT 'missing' FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM information_schema.tables WHERE table_schema = '${WORLD}' AND table_name = 'basic_155e_quest_race_backup')")"
# }}}

# {{{ 155d: rotation state
report "rotation table holds one row per faction with a valid state" \
    "$(run_sql "SELECT 'rows', COUNT(*) FROM ${CHARS}.basic_starting_valley_rotation HAVING COUNT(*) <> 2
        UNION ALL
        SELECT team, current_valley FROM ${CHARS}.basic_starting_valley_rotation WHERE current_valley NOT IN (0,1,2,3,255) OR count_in_batch > 30")"
# }}}

# {{{ 155f: Outland dungeons, each creature its stock level + its dungeon's offset
# (open world and heroic modes stock; Kael'thas 78). The offsets are the ones
# the apply recorded in basic_155f_templates, per dungeon in basic_155f_maps.
report "the raised set is non-empty and every template is its original level + its offset" \
    "$(run_sql "SELECT 'empty set', COUNT(*) FROM ${WORLD}.basic_155f_templates HAVING COUNT(*) = 0
        UNION ALL SELECT t.entry, CONCAT(t.name, ' ', t.minlevel, '-', t.maxlevel, ' want ', b.minlevel + s.level_offset, '-', b.maxlevel + s.level_offset)
        FROM ${WORLD}.creature_template t JOIN ${WORLD}.basic_155f_level_backup b ON b.entry = t.entry
        JOIN ${WORLD}.basic_155f_templates s ON s.entry = t.entry
        WHERE t.minlevel <> b.minlevel + s.level_offset OR t.maxlevel <> b.maxlevel + s.level_offset LIMIT 10")"
report "no template spawned only in those dungeons was missed" \
    "$(run_sql "SELECT DISTINCT c.id, t.name, t.minlevel FROM ${WORLD}.creature c JOIN ${WORLD}.creature_template t ON t.entry = c.id
        WHERE c.map IN (SELECT map_id FROM ${WORLD}.basic_155f_maps)
          AND c.id NOT IN (SELECT entry FROM ${WORLD}.basic_155f_templates)
          AND c.id NOT IN (SELECT c2.id FROM ${WORLD}.creature c2 WHERE c2.map NOT IN (SELECT map_id FROM ${WORLD}.basic_155f_maps))
        LIMIT 10")"
report "Kael'thas (Magisters' Terrace) is level 78" \
    "$(run_sql "SELECT entry, minlevel FROM ${WORLD}.creature_template WHERE entry = 24664 AND (minlevel <> 78 OR maxlevel <> 78)")"
report "dungeon gear that required more than 60 now requires 60" \
    "$(run_sql "SELECT i.entry, i.name, i.RequiredLevel FROM ${WORLD}.item_template i
        JOIN ${WORLD}.basic_155f_item_backup b ON b.entry = i.entry WHERE i.RequiredLevel <> 60 LIMIT 10")"
report "every one of those dungeons opens at 60 (normal mode)" \
    "$(run_sql "SELECT m.map_id, a.min_level FROM ${WORLD}.basic_155f_maps m
        LEFT JOIN ${WORLD}.dungeon_access_template a ON a.map_id = m.map_id AND a.difficulty = 0
        WHERE a.min_level IS NULL OR a.min_level > 60")"
report "no normal-mode attunement left on them" \
    "$(run_sql "SELECT a.map_id, r.requirement_type, r.requirement_id FROM ${WORLD}.dungeon_access_requirements r
        JOIN ${WORLD}.dungeon_access_template a ON a.id = r.dungeon_access_id
        WHERE a.difficulty = 0 AND a.map_id IN (SELECT map_id FROM ${WORLD}.basic_155f_maps)")"
report "heroic mode left stock (entry still level 70)" \
    "$(run_sql "SELECT a.map_id, a.min_level FROM ${WORLD}.dungeon_access_template a WHERE a.difficulty = 1 AND a.map_id IN (SELECT map_id FROM ${WORLD}.basic_155f_maps) AND a.min_level <> 70")"
# }}}

# {{{ 155i: the creature multiplier table exists (basic_rules.cpp reads it)
report "the creature multiplier table exists with its six value columns" \
    "$(run_sql "SELECT 'missing columns', 6 - COUNT(*) FROM information_schema.columns
        WHERE table_schema = '${WORLD}' AND table_name = 'basic_creature_multipliers'
          AND column_name IN ('entry','map_id','melee','spell','heal','health') HAVING COUNT(*) <> 6")"
# }}}

# {{{ 155n: Outland without tradeskills
OUTLAND_POS="((g.map = 530 AND (g.position_y > -2000 OR g.position_x > 11350)) OR g.map IN (540,542,543,544,545,546,547,548,550,552,553,554,555,556,557,558,564,565,585))"
report "no herb, ore or fishing-pool spawn left in Outland" \
    "$(run_sql "SELECT g.guid, g.id FROM ${WORLD}.gameobject g JOIN ${WORLD}.gameobject_template t ON t.entry = g.id
        WHERE ${OUTLAND_POS} AND (t.type = 25 OR g.id IN (SELECT DISTINCT id FROM ${WORLD}.basic_155n_gameobject)) LIMIT 10")"
report "no gas cloud left in Outland" \
    "$(run_sql "SELECT g.guid, g.id FROM ${WORLD}.creature g WHERE g.id IN (17378,17407,17408,24222) AND ${OUTLAND_POS} LIMIT 10")"
report "no pool still lists a removed spawn" \
    "$(run_sql "SELECT p.guid FROM ${WORLD}.pool_gameobject p JOIN ${WORLD}.basic_155n_gameobject b ON b.guid = p.guid
        UNION ALL SELECT p.guid FROM ${WORLD}.pool_creature p JOIN ${WORLD}.basic_155n_creature b ON b.guid = p.guid LIMIT 10")"
report "every Outland zone needs fishing skill 300" \
    "$(run_sql "SELECT z.entry, f.skill FROM ${WORLD}.basic_155n_fishing_skill z LEFT JOIN ${WORLD}.skill_fishing_base_level f ON f.entry = z.entry
        WHERE f.skill IS NULL OR f.skill <> 300")"
report "no trainer teaches a profession past 300" \
    "$(run_sql "SELECT ts.TrainerId, ts.SpellId, ts.ReqSkillRank FROM ${WORLD}.trainer_spell ts
        WHERE (ts.ReqSkillLine IN (164,165,171,182,186,197,202,333,393,755,773,185,129,356) AND ts.ReqSkillRank > 300)
           OR (ts.TrainerId, ts.SpellId) IN (SELECT TrainerId, SpellId FROM ${WORLD}.basic_155n_trainer_spell) LIMIT 10")"
report "no recipe past 300 sold or dropped directly" \
    "$(run_sql "SELECT 'vendor', v.item FROM ${WORLD}.npc_vendor v JOIN ${WORLD}.item_template i ON i.entry = v.item
        WHERE i.class = 9 AND i.RequiredSkillRank > 300 AND i.RequiredSkill IN (164,165,171,182,186,197,202,333,393,755,773,185,129,356)
        UNION ALL SELECT 'loot', l.Item FROM ${WORLD}.creature_loot_template l JOIN ${WORLD}.item_template i ON i.entry = l.Item
        WHERE l.Reference = 0 AND i.class = 9 AND i.RequiredSkillRank > 300 AND i.RequiredSkill IN (164,165,171,182,186,197,202,333,393,755,773,185,129,356) LIMIT 10")"
# }}}

# {{{ 155l: Outland without quests
report "no enabled quest is given or taken in Outland" \
    "$(run_sql "SELECT s.quest, c.id FROM ${WORLD}.creature_queststarter s JOIN ${WORLD}.creature c ON c.id = s.id
        WHERE ((c.map = 530 AND (c.position_y > -2000 OR c.position_x > 11350)) OR c.map IN (540,542,543,544,545,546,547,548,550,552,553,554,555,556,557,558,564,565,585))
          AND NOT EXISTS (SELECT 1 FROM ${WORLD}.disables d WHERE d.sourceType = 1 AND d.entry = s.quest) LIMIT 10")"
report "the Shattrath portal to the Isle of Quel'Danas is gone" \
    "$(run_sql "SELECT guid FROM ${WORLD}.gameobject WHERE id = 187056")"
# }}}

echo ""
if [[ "${FAIL_COUNT}" -eq 0 ]]; then
    echo "All checks passed."
    exit 0
fi
echo "${FAIL_COUNT} check(s) failed."
exit 1
