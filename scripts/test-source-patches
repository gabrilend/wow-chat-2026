#!/usr/bin/env bash

set -o pipefail

DIR="/mnt/kaun/wow-chat-2026"
[[ -n "${1:-}" ]] && DIR="$1"
PROFILE="${2:-basic}"
SOURCE_TREE="${3:-}"

declare -A SOURCE_BY_PROFILE=(
    [release]="source-beta" [beta]="source-beta" [vanilla]="source-beta"
    [basic]="source-beta"   [alpha]="source-alpha"
    [cc-test]="source-beta"
)
SRC_NAME="${SOURCE_BY_PROFILE[${PROFILE}]:-}"
if [[ -z "${SRC_NAME}" ]]; then
    echo "ERROR: unknown profile '${PROFILE}' (no source tree mapping in this script)"
    exit 1
fi
SRC="${DIR}/${SRC_NAME}"
[[ -n "${SOURCE_TREE}" ]] && SRC="${SOURCE_TREE}" && SRC_NAME="$(basename "${SOURCE_TREE}")"
[[ -d "${SRC}" ]] || { echo "ERROR: ${SRC} missing"; exit 1; }

SCRATCH_ROOT="${DIR}/tmp/shared-memory"
[[ -d "${SCRATCH_ROOT}" ]] || { echo "ERROR: ${SCRATCH_ROOT} missing (RAM scratch link)"; exit 1; }
WORK="${SCRATCH_ROOT}/test-source-patches-${PROFILE}"
rm -rf "${WORK}"
mkdir -p "${WORK}"
if [[ -d "${SRC}/.git" ]]; then
    echo "Exporting ${SRC_NAME}'s committed state to RAM..."
    mkdir -p "${WORK}/pristine"
    git -C "${SRC}" archive --format=tar HEAD | tar -x -C "${WORK}/pristine" \
        || { echo "ERROR: export of ${SRC} failed"; exit 1; }
    for mod_dir in "${SRC}"/modules/*/; do
        [[ -d "${mod_dir}/.git" ]] || continue
        mod="$(basename "${mod_dir}")"
        mkdir -p "${WORK}/pristine/modules/${mod}"
        git -C "${mod_dir}" archive --format=tar HEAD | tar -x -C "${WORK}/pristine/modules/${mod}" \
            || { echo "ERROR: export of module ${mod} failed"; exit 1; }
    done
else
    echo "Copying ${SRC_NAME} to RAM (it has no .git: as it is)..."
    rsync -a "${SRC}/" "${WORK}/pristine/" || { echo "ERROR: copy failed"; exit 1; }
fi
rsync -a "${WORK}/pristine/" "${WORK}/tree/" || { echo "ERROR: copy failed"; exit 1; }

export PROFILE DIR
AC_CODE_DIR="${WORK}/tree"
export AC_CODE_DIR
source "${DIR}/patches/patches.sh" || { echo "ERROR: patches/patches.sh failed to source"; exit 1; }
LIST="${PHASE_BEGIN_PATCHES[${PROFILE}]:-}"
[[ -n "${LIST}" ]] || { echo "ERROR: no PHASE_BEGIN_PATCHES entry for '${PROFILE}'"; exit 1; }

changed_by() {
    local id="$1" rel before
    : > "${WORK}/${id}.changed"
    while IFS= read -r rel; do
        before="${WORK}/last/${rel}"
        [[ -f "${before}" ]] || before="${WORK}/pristine/${rel}"
        if ! cmp -s "${before}" "${WORK}/tree/${rel}"; then
            echo "${rel}" >> "${WORK}/${id}.changed"
            mkdir -p "$(dirname "${WORK}/last/${rel}")"
            cp "${WORK}/tree/${rel}" "${WORK}/last/${rel}"
        fi
    done < <(find "${WORK}/tree" -type f -newer "${WORK}/${id}.mark" -printf '%P\n')
}
failed=0
echo "Applying: ${LIST}"
for id in ${LIST}; do
    fn=$(declare -F | grep "^declare -f patch_${id}_" | sed 's/declare -f //')
    if [[ -z "${fn}" ]]; then
        echo "  [✗] ${id}: no patch function defined"
        failed=$((failed + 1))
        continue
    fi
    touch "${WORK}/${id}.mark"
    if ${fn} > "${WORK}/${id}.apply.log" 2>&1; then
        echo "  [✓] ${id} applied"
    else
        echo "  [✗] ${id} returned failure:"
        sed 's/^/        /' "${WORK}/${id}.apply.log"
        failed=$((failed + 1))
    fi
    changed_by "${id}"
done

declare -A PRIORITY_OF=()
while IFS=$'\t' read -r prio _kind pid _file; do
    PRIORITY_OF["${pid}"]="${prio}"
done < <("${DIR}/scripts/plan-patches" "${DIR}" "${PROFILE}" --stage source)
clashes=0
for a in ${LIST}; do
    for b in ${LIST}; do
        [[ "${a}" < "${b}" ]] || continue
        [[ "${PRIORITY_OF[${a}]:-x}" == "${PRIORITY_OF[${b}]:-y}" ]] || continue
        both="$(comm -12 <(sort "${WORK}/${a}.changed") <(sort "${WORK}/${b}.changed"))"
        if [[ -n "${both}" ]]; then
            echo "  [✗] ${a} and ${b} share priority ${PRIORITY_OF[${a}]} and both change:"
            echo "${both}" | sed 's/^/        /'
            echo "      to fix: give the one laid over the other a higher priority (its header)"
            clashes=$((clashes + 1))
        fi
    done
done
if [[ ${clashes} -eq 0 ]]; then
    echo "  [✓] layering: no two patches of one priority change the same file"
else
    failed=$((failed + clashes))
fi

echo "Reverting (reverse order)..."
reversed=$(echo "${LIST}" | tr ' ' '\n' | tac | tr '\n' ' ')
for id in ${reversed}; do
    fn=$(declare -F | grep "^declare -f unpatch_${id}_" | sed 's/declare -f //')
    [[ -z "${fn}" ]] && { echo "  [!] ${id}: no unpatch function"; continue; }
    ${fn} > "${WORK}/${id}.revert.log" 2>&1 || echo "  [!] ${id}: unpatch returned failure (see ${WORK}/${id}.revert.log)"
done

leftover=$(diff -rq "${WORK}/pristine" "${WORK}/tree" | head -20)
if [[ -n "${leftover}" ]]; then
    echo "  [✗] tree differs from the original after revert:"
    echo "${leftover}" | sed 's/^/        /'
    failed=$((failed + 1))
else
    echo "  [✓] round trip: tree is byte-identical to the original"
fi

echo "Result: ${failed} problem(s). Logs: ${WORK}/"
rm -rf "${WORK}/pristine" "${WORK}/tree" "${WORK}/last"
[[ "${failed}" -eq 0 ]]
