#!/usr/bin/env luajit

local DIR   = arg[1] and arg[1] ~= "" and arg[1] or "/mnt/kaun/wow-chat-2026"
local WORLD = arg[2] or "acore_world_basic"
local HERE  = DIR .. "/patches/E071-basic-fight-multipliers/"
local MYSQL = DIR .. "/mysql/installed-files/bin/mysql -h127.0.0.1 -P3307 -uritz -pmenardi -N -B " .. WORLD
local ffi   = require("ffi")
local F     = dofile(HERE .. "fights.lua")
local done  = {}

local function stop(what, why)
    io.stderr:write("ERROR at: " .. what .. "\n  why: " .. why .. "\n  done before it: " .. (#done > 0 and table.concat(done, "; ") or "nothing") .. "\n")
    os.exit(1)
end

local function query(sql)
    local p = io.popen(MYSQL .. ' -e "' .. sql .. '" 2>&1')
    local rows = {}
    for l in p:lines() do
        if l:match("^ERROR") then stop("querying " .. WORLD, "MySQL said: " .. l) end
        if not l:match("^mysql: %[Warning%]") then
            local m = {}
            for v in (l .. "\t"):gmatch("([^\t]*)\t") do m[#m + 1] = v end
            rows[#rows + 1] = m
        end
    end
    p:close()
    return rows
end

local spell_file = DIR .. "/data-files/dbc/Spell.dbc"
local d = io.open(spell_file, "rb")
if not d then stop("opening " .. spell_file, "missing (the server's data folder)") end
d = d:read("*a")
local function u32(o) local a, b, c, e = d:byte(o + 1, o + 4); return a + b * 256 + c * 65536 + e * 16777216 end
local N, FIELDS, SIZE = u32(4), u32(8), u32(12)
local STRS = 20 + N * SIZE
local ROW = {}
for r = 0, N - 1 do ROW[u32(20 + r * SIZE)] = r end
local function raw(row, i) return u32(20 + row * SIZE + i * 4) end
local function as_int(v) if v >= 2 ^ 31 then return v - 2 ^ 32 end return v end
local function as_float(v) local b = ffi.new("uint32_t[1]", v); return ffi.cast("float*", b)[0] end
local function as_text(v) local e = d:find("\0", STRS + v + 1, true); return d:sub(STRS + v + 1, e - 1) end
done[#done + 1] = "read Spell.dbc (" .. N .. " spells)"

local cols = query("SELECT COLUMN_NAME, DATA_TYPE FROM information_schema.columns WHERE table_schema = '" .. WORLD
    .. "' AND table_name = 'spell_dbc' ORDER BY ORDINAL_POSITION")
if #cols ~= FIELDS then stop("matching spell_dbc to Spell.dbc", "spell_dbc has " .. #cols .. " columns, Spell.dbc " .. FIELDS .. " fields") end
local names = {}
for _, c in ipairs(cols) do names[#names + 1] = "`" .. c[1] .. "`" end

local function sqltext(s) return "'" .. s:gsub("\\", "\\\\"):gsub("'", "''") .. "'" end
local apply, revert = {}, {}
local HEAD = "-- GENERATED by scripts/generate-basic-fight-multipliers-sql from patches/E071-basic-fight-multipliers/fights.lua,\n"
    .. "-- " .. WORLD .. " and the client's Spell.dbc; don't edit by hand (re-run the generator).\n"
    .. "-- Issues 155i, 155f1, 155j: the level-60 fights' per-creature multipliers and rewritten boss spells.\n"
apply[#apply + 1]   = HEAD
revert[#revert + 1] = "-- MARKER_E071_REVERT basic-fight-multipliers\n" .. HEAD .. "\n-- Remove exactly what the apply added (its own creature rows and spell rows)."

local entries = {}
for _, c in ipairs(F.creatures) do
    for _, k in ipairs({ "melee", "spell", "heal", "health" }) do
        if type(c[k]) ~= "number" or c[k] <= 0 then stop("creature " .. tostring(c.entry), k .. " must be a number above 0") end
    end
    local found = query("SELECT name FROM creature_template WHERE entry = " .. c.entry)
    if #found ~= 1 then stop("creature " .. c.entry, "no such creature template in " .. WORLD) end
    apply[#apply + 1] = string.format("-- %s\nREPLACE INTO `basic_creature_multipliers` (`entry`, `map_id`, `melee`, `spell`, `heal`, `health`, `comment`)"
        .. " VALUES (%d, 0, %g, %g, %g, %g, %s);", found[1][1], c.entry, c.melee, c.spell, c.heal, c.health, sqltext(c.why))
    entries[#entries + 1] = tostring(c.entry)
end
if #entries > 0 then
    revert[#revert + 1] = "DELETE FROM `basic_creature_multipliers` WHERE `map_id` = 0 AND `entry` IN (" .. table.concat(entries, ", ") .. ");"
end
done[#done + 1] = #entries .. " creature rows"

local ids = {}
for _, s in ipairs(F.spells) do
    local row = ROW[s.id]
    if not row then stop("spell " .. s.id, "not in Spell.dbc") end
    local other = io.popen('grep -rlE "^(INSERT|REPLACE) INTO .spell_dbc.*VALUES \\(' .. s.id .. ', " "' .. DIR .. '/sql/basic/db_world.src" "'
        .. DIR .. '/patches" --include="*.apply.sql" 2>&1')
    for path in other:lines() do
        if not path:find("/E071-basic-fight-multipliers/", 1, true) then
            stop("spell " .. s.id, "another step already rewrites it: " .. path .. " (one rewrite per spell)")
        end
    end
    other:close()
    local vals, changed = {}, {}
    for i, c in ipairs(cols) do
        local f, kind = i - 1, c[2]
        local v
        if s.set[f] ~= nil then
            v = tostring(s.set[f])
            local was = kind == "float" and as_float(raw(row, f)) or as_int(raw(row, f))
            changed[#changed + 1] = string.format("field %d %s -> %s", f, tostring(was), v)
        elseif kind == "float" then v = string.format("%.9g", as_float(raw(row, f)))
        elseif kind:find("char") or kind:find("text") then v = sqltext(as_text(raw(row, f)))
        else v = tostring(as_int(raw(row, f))) end
        vals[#vals + 1] = v
    end
    for f in pairs(s.set) do
        if f < 0 or f >= FIELDS then stop("spell " .. s.id, "field " .. f .. " is outside Spell.dbc's 0-" .. (FIELDS - 1)) end
    end
    apply[#apply + 1] = string.format("-- %d %s: %s\n--   %s\nREPLACE INTO `spell_dbc` (%s) VALUES (%s);",
        s.id, as_text(raw(row, 136)), s.why, table.concat(changed, ", "), table.concat(names, ", "), table.concat(vals, ", "))
    ids[#ids + 1] = tostring(s.id)
end
if #ids > 0 then revert[#revert + 1] = "DELETE FROM `spell_dbc` WHERE `ID` IN (" .. table.concat(ids, ", ") .. ");" end
done[#done + 1] = #ids .. " spell rows"

for name, lines in pairs({ ["40-fight-multipliers.apply.sql"] = apply, ["40-fight-multipliers.revert.sql"] = revert }) do
    local f = io.open(HERE .. name, "w")
    if not f then stop("writing " .. HERE .. name, "cannot open for writing") end
    f:write(table.concat(lines, "\n\n"), "\n")
    f:close()
end
print("wrote " .. HERE .. "40-fight-multipliers.{apply,revert}.sql: " .. table.concat(done, ", "))
