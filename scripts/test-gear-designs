#!/usr/bin/env luajit
-- test-gear-designs - check the gear design loop without a picture
-- generator (issues 506a, 506b, 506c, 506d).
--
-- For a general audience: the owner's rules for gear designs
-- are that new designs explore the questions nobody has settled, keep what
-- is winning, and loosen their hold on a winner that keeps getting voted
-- down. This test holds the design generator to those rules with made-up
-- votes, runs both generators end to end in a scratch folder (including a
-- pretend picture in a pretend generator output folder), and checks the
-- picture generator's workflows against the node types that the installed
-- ComfyUI actually defines, by reading its source, without running it.
--
-- Usage: scripts/test-gear-designs [PROJECT_DIR] [--sd-dir DIR] [--libs DIR]
--   Uses a scratch folder under PROJECT_DIR/tmp/shared-memory/gear-designs-test
--   (RAM), removed and made again each run. Exit 1 on any failure.

-- {{{ arguments and helpers
local DIR, SD, LIBS = "/mnt/mtwo/games/azeroth-core/wow-chat-2026", "/mnt/kaun/stable-diffusion", "/home/ritz/programming/ai-stuff/libs/lua"
do
    local i = 1
    while i <= #arg do
        if arg[i] == "--sd-dir" then SD = arg[i + 1]; i = i + 2
        elseif arg[i] == "--libs" then LIBS = arg[i + 1]; i = i + 2
        else DIR = arg[i]; i = i + 1 end
    end
end
package.path = LIBS .. "/?.lua;" .. package.path
local json = require("dkjson")
local P = dofile(DIR .. "/src/tools/gear-designs/profiles.lua")
local Q = dofile(DIR .. "/assets/gear-designs/design-questions.lua")

local passed, failed = 0, 0
local function check(ok, what, detail)
    if ok then passed = passed + 1
    else failed = failed + 1; print("  FAIL " .. what .. (detail and (": " .. detail) or "")) end
end
local function q(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end
local function run(cmd)
    local p = io.popen(cmd .. " 2>&1; echo \"__exit=$?\"")
    local out = p:read("*a"); p:close()
    local code = tonumber(out:match("__exit=(%d+)%s*$"))
    return code, (out:gsub("__exit=%d+%s*$", ""))
end
local function count(t) local n = 0 for _ in pairs(t) do n = n + 1 end return n end
-- }}}

-- {{{ 1. the tally: leader and settled
do
    local qs = { { id = "x", pieces = "all", options = { { id = "a" }, { id = "b" }, { id = "c" } } } }
    local function pr(id, o, how) return { id = id, piece = "helm", answers = { x = o }, how = { x = how or "focus" } } end
    -- a leads with 3 net, b has 1: settled (3 >= 3, margin 2)
    local t = P.tally(qs, { pr("1", "a"), pr("2", "a"), pr("3", "a"), pr("4", "b") },
        { ["1"] = { up = 1, down = 0 }, ["2"] = { up = 1, down = 0 }, ["3"] = { up = 1, down = 0 }, ["4"] = { up = 1, down = 0 } })
    check(t.leader.x == "a" and t.answered.x, "a clear leader with 3 net and a margin of 2 settles the question")
    -- a 3, b 2: margin 1, not settled
    t = P.tally(qs, { pr("1", "a"), pr("2", "a"), pr("3", "a"), pr("4", "b"), pr("5", "b") },
        { ["1"] = { up = 1, down = 0 }, ["2"] = { up = 1, down = 0 }, ["3"] = { up = 1, down = 0 }, ["4"] = { up = 1, down = 0 }, ["5"] = { up = 1, down = 0 } })
    check(t.leader.x == "a" and not t.answered.x, "a lead of 1 leaves the question open")
    -- a tie: never settled
    t = P.tally(qs, { pr("1", "a"), pr("2", "b") }, { ["1"] = { up = 4, down = 0 }, ["2"] = { up = 4, down = 0 } })
    check(not t.answered.x, "a tie is never settled")
    -- only downvotes: no leader
    t = P.tally(qs, { pr("1", "a") }, { ["1"] = { up = 0, down = 2 } })
    check(t.leader.x == nil and t.score.x.a == -2, "only downvotes make no leader", tostring(t.leader.x))
    -- carried downvotes counted only when the option was carried
    t = P.tally(qs, { pr("1", "a", "carried"), pr("2", "a", "focus") }, { ["1"] = { up = 0, down = 2 }, ["2"] = { up = 0, down = 3 } })
    check(t.carried.x.a == 2, "downvotes on carried designs are counted apart", tostring(t.carried.x.a))
end
-- }}}

-- {{{ 2. focus leans toward unanswered questions
do
    -- make "armour" settled by hand, then count how often each question is a focus
    local t = P.tally(Q.questions, {}, {})
    t.answered.armour = true
    local r = P.rng(42)
    local focus = {}
    local N = 6000
    for _ = 1, N do
        local pr = P.make(Q, t, r)
        for _, qid in ipairs(pr.focus) do focus[qid] = (focus[qid] or 0) + 1 end
    end
    -- compare with another question that applies to every piece
    local ratio = (focus.armour or 0) / (focus.palette or 1)
    check(ratio > 0.08 and ratio < 0.3, "a settled question is explored about 0.15 times as often as an open one", string.format("ratio %.3f", ratio))
end
-- }}}

-- {{{ 3. persistence, and widening after downvotes
do
    local qs = Q.questions
    -- palette leader "moon" with no downvotes on carried designs
    local function tally_with(carried_downs)
        local t = P.tally(qs, {}, {})
        t.leader.palette = "moon"
        t.carried.palette.moon = carried_downs
        return t
    end
    check(math.abs(P.keep_chance(tally_with(0), "palette") - P.KEEP_BASE) < 1e-9, "a fresh leader is carried at the base chance")
    check(P.keep_chance(tally_with(3), "palette") < P.keep_chance(tally_with(0), "palette"), "downvotes on carried designs lower the chance of carrying")
    check(math.abs(P.keep_chance(tally_with(100), "palette") - P.KEEP_FLOOR) < 1e-9, "the chance never falls below the floor")
    -- measured: share of non-focus palettes that are the leader
    local function carried_share(downs)
        local t, r, keep, other = tally_with(downs), P.rng(7), 0, 0
        for _ = 1, 4000 do
            local pr = P.make(Q, t, r)
            if pr.how.palette ~= "focus" then
                if pr.answers.palette == "moon" then keep = keep + 1 else other = other + 1 end
            end
        end
        return keep / (keep + other)
    end
    local fresh, downed = carried_share(0), carried_share(6)
    check(fresh > 0.8 and downed < 0.55, "variation widens after downvotes (the leader carried less often)",
        string.format("carried share %.2f fresh, %.2f after 6 downvotes", fresh, downed))
    -- no leader at all: every non-focus answer random
    local t, r, seen = P.tally(qs, {}, {}), P.rng(9), {}
    for _ = 1, 400 do seen[P.make(Q, t, r).answers.palette or "none"] = true end
    check(count(seen) >= 4, "with nothing voted, every palette is tried", tostring(count(seen)))
end
-- }}}

-- {{{ 4. reproducible rounds, ids stable, prompts built
do
    local a = P.round(Q, {}, {}, 12, 5)
    local b = P.round(Q, {}, {}, 12, 5)
    local same = true
    for i = 1, 12 do if a[i].id ~= b[i].id or a[i].prompt ~= b[i].prompt then same = false end end
    check(same, "the same seed makes the same round")
    local ids = {}
    for _, pr in ipairs(a) do ids[pr.id] = true end
    check(count(ids) == 12, "no design repeats within a round")
    check(P.id("helm", { armour = "gilded" }, Q.questions) == P.id("helm", { armour = "gilded" }, Q.questions), "the id is a function of piece and answers")
    check(a[1].prompt:find(Q.subject, 1, true) and a[1].prompt:find(Q.piece_words[a[1].piece], 1, true), "the prompt names the subject and the piece")
end
-- }}}

-- {{{ 5. the generators end to end, in a scratch project
local S = DIR .. "/tmp/shared-memory/gear-designs-test"
do
    os.execute("rm -rf " .. q(S))
    os.execute("mkdir -p " .. q(S .. "/assets/gear-designs") .. " " .. q(S .. "/src/tools") .. " " .. q(S .. "/scripts") .. " " .. q(S .. "/docs/HTML"))
    os.execute("ln -s " .. q(DIR .. "/src/tools/gear-designs") .. " " .. q(S .. "/src/tools/gear-designs"))
    os.execute("ln -s " .. q(DIR .. "/scripts/templates") .. " " .. q(S .. "/scripts/templates"))
    os.execute("cp " .. q(DIR .. "/assets/gear-designs/design-questions.lua") .. " " .. q(S .. "/assets/gear-designs/"))
    local gen = DIR .. "/scripts/generate-gear-profiles"
    local code, out = run(gen .. " " .. q(S) .. " --count 10")
    check(code == 0 and out:find("round 1, 10 profiles", 1, true), "the profile generator makes round 1", out)
    local r1 = dofile(S .. "/assets/gear-designs/profiles/round-001.lua")
    -- vote every design with palette "dawn" up and everything else down
    local f = io.open(S .. "/assets/gear-designs/votes.tsv", "w")
    f:write("id\tup\tdown\n")
    for _, pr in ipairs(r1.profiles) do f:write(pr.id, "\t", pr.answers.palette == "dawn" and 1 or 0, "\t", pr.answers.palette == "dawn" and 0 or 1, "\n") end
    f:close()
    code, out = run(gen .. " " .. q(S) .. " --count 10")
    check(code == 0 and out:find("round 2", 1, true) and out:find("voted profiles", 1, true), "round 2 reads the votes", out)
    local r2 = dofile(S .. "/assets/gear-designs/profiles/round-002.lua")
    local r1ids = {}
    for _, pr in ipairs(r1.profiles) do r1ids[pr.id] = true end
    local repeats = 0
    for _, pr in ipairs(r2.profiles) do if r1ids[pr.id] then repeats = repeats + 1 end end
    check(repeats == 0, "round 2 repeats no design of round 1", tostring(repeats))
    -- a malformed votes line is an error that names the line
    f = io.open(S .. "/assets/gear-designs/votes.tsv", "a"); f:write("not a vote line\n"); f:close()
    code, out = run(gen .. " " .. q(S) .. " --count 2")
    check(code ~= 0 and out:find("line", 1, true) and out:find("not a vote line", 1, true), "a malformed votes line stops the generator and names it", out)
    os.execute("sed -i '$d' " .. q(S .. "/assets/gear-designs/votes.tsv"))
    -- the gallery, with a pretend picture in a pretend generator output folder
    local fakesd = S .. "/sd"
    local pid = r1.profiles[1].id
    os.execute("mkdir -p " .. q(fakesd .. "/output/gear-designs/" .. pid) .. " " .. q(fakesd .. "/output/gear-designs/deadbeef"))
    os.execute("magick -size 512x768 xc:#d8b46a " .. q(fakesd .. "/output/gear-designs/" .. pid .. "/view_00001_.png"))
    code, out = run(DIR .. "/scripts/generate-gear-gallery " .. q(S) .. " --sd-dir " .. q(fakesd))
    check(code == 0 and out:find("1 with pictures (1 copies made)", 1, true), "the gallery finds the picture in its design's folder and copies it small", out)
    check(out:find("deadbeef matches no design", 1, true) ~= nil, "a folder named for no design is reported", out)
    local page = io.open(S .. "/docs/HTML/gear-gallery.html"):read("*a")
    check(page:find("gear-gallery/views/" .. pid .. "/view_00001_.webp", 1, true) ~= nil, "the page shows the picture by its published path")
    check(not page:find("/*__DATA__*/", 1, true), "the page's data was filled in")
    local pubs = io.open(S .. "/docs/HTML/gear-gallery/publish-files.txt"):read("*a")
    check(pubs:find("gear-gallery/views/" .. pid .. "/view_00001_.webp\t", 1, true) ~= nil, "the picture is listed for publishing")
    local w = io.popen("magick identify -format %w " .. q(S .. "/docs/HTML/gear-gallery/views/" .. pid .. "/view_00001_.webp")):read("*a")
    check(tonumber(w) == 480, "the copy is 480 pixels wide", w)
    -- the embedded data parses and cannot close its script block early
    local blob = page:match('<script type="application/json" id="data">(.-)</script>')
    check(blob and json.decode(blob) and not blob:find("</", 1, true), "the embedded data is valid JSON with no early </")
end
-- }}}

-- {{{ 6. the workflows against the installed ComfyUI's node definitions
-- Read, never run: every class_type must be defined in the checkout (the
-- classic mapping in nodes.py / comfy_extras, or a node_id= in the new node
-- API), every input the workflow gives must appear in that class's source,
-- every link must point at a node in the same graph, and every placeholder
-- must be one the client fills.
do
    local C = SD .. "/files/comfyui"
    local sources = {}
    local p = io.popen("ls -1 " .. q(C .. "/nodes.py") .. " " .. q(C .. "/comfy_extras") .. "/*.py 2>/dev/null")
    for path in p:lines() do sources[#sources + 1] = path end
    p:close()
    if #sources == 0 then
        print("  SKIP workflow checks: no ComfyUI checkout at " .. C)
    else
        -- class_type -> the source text of its class block
        local blocks = {}
        for _, path in ipairs(sources) do
            local text = io.open(path):read("*a")
            local function block_of(classname)
                local s = text:find("\nclass " .. classname .. "[%(:]")
                if not s then return nil end
                local e = text:find("\nclass ", s + 1) or #text
                return text:sub(s, e)
            end
            for name, cls in text:gmatch('"([%w_]+)"%s*:%s*([%w_]+)%s*,') do
                local b = block_of(cls)
                if b then blocks[name] = b end
            end
            for cls, name in text:gmatch("\nclass ([%w_]+)%b()%s*:.-node_id%s*=%s*\"([%w_]+)\"") do
                blocks[name] = blocks[name] or block_of(cls)
            end
        end
        local fills = { __PROMPT__ = 1, __NEGATIVE__ = 1, __SEED__ = 1, __PREFIX__ = 1, __CKPT__ = 1, __IMAGE__ = 1, __CONTROL_IMAGE__ = 1,
                        __ELEVATION__ = 1, __IMAGE_FRONT__ = 1, __IMAGE_LEFT__ = 1, __IMAGE_BACK__ = 1, __IMAGE_RIGHT__ = 1 }
        local wd = DIR .. "/assets/gear-designs/comfyui"
        for _, name in ipairs({ "concept", "concept-scribble", "to-3d", "multiview", "to-3d-multiview" }) do
            local text = io.open(wd .. "/" .. name .. ".json"):read("*a")
            local graph = json.decode(text)
            check(type(graph) == "table", name .. ".json parses")
            for ph in text:gmatch('"(__[%u_]+__)"') do check(fills[ph], name .. ": placeholder " .. ph .. " is filled by the client") end
            for id, node in pairs(graph or {}) do
                local b = blocks[node.class_type]
                check(b ~= nil, name .. " node " .. id .. ": " .. tostring(node.class_type) .. " exists in the installed ComfyUI")
                for input, value in pairs(node.inputs or {}) do
                    if b then check(b:find('"' .. input .. '"', 1, true) or b:find("Input%(\"" .. input .. "\""), name .. " node " .. id .. ": input " .. input .. " belongs to " .. node.class_type) end
                    if type(value) == "table" then check(graph[value[1]] ~= nil, name .. " node " .. id .. ": input " .. input .. " links to node " .. tostring(value[1])) end
                end
            end
        end
        -- the models the concept workflows name are installed
        check(io.open(SD .. "/models/diffusers/Dreamshaper-8/model_index.json") ~= nil, "Dreamshaper-8 is installed in diffusers form")
        check(io.open(SD .. "/models/controlnet/Contour-Detection-scribble.safetensors") ~= nil, "the scribble ControlNet is installed")
    end
end
-- }}}

-- {{{ 7. the camera plan (issue 506e)
-- The owner's rig: eight cameras per ring, one every 45 degrees, facing in;
-- 1, 3 or 5 rings, the middle first. The multi-view workflow makes one
-- ring as a batch of eight 45 degrees apart, so the plan and the workflow
-- must agree; the mesh's four inputs must be four different compass views.
do
    local C = dofile(DIR .. "/assets/gear-designs/camera-plan.lua")
    check(#C.azimuths == 8, "the camera plan has eight compass views per ring")
    for i, a in ipairs(C.azimuths) do check(a.degrees == (i - 1) * 45, "compass view " .. a.name .. " sits at " .. (i - 1) * 45 .. " degrees") end
    check(#C.rings == 5 and C.rings[1].name == "middle" and C.rings[1].elevation == 0, "five rings, the middle (level) one first")
    for _, lv in ipairs(C.levels) do check(lv <= #C.rings, "level " .. lv .. " has that many rings") end
    local seen = {}
    for key, i in pairs(C.mesh_inputs) do
        check(C.azimuths[i + 1] ~= nil and not seen[i], "the mesh input " .. key .. " is its own compass view")
        seen[i] = true
    end
    local wf = json.decode(io.open(DIR .. "/assets/gear-designs/comfyui/multiview.json"):read("*a"))
    local cond = wf and wf["3"] and wf["3"].inputs
    check(cond and cond.batch_size == #C.azimuths and cond.azimuth_batch_increment == 45 and cond.azimuth == 0,
        "the multi-view workflow makes one ring: a batch of eight, 45 degrees apart, from the front")
end
-- }}}

print(string.format("test-gear-designs: %d passed, %d failed", passed, failed))
os.exit(failed == 0 and 0 or 1)
