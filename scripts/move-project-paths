#!/usr/bin/env luajit
-- move-project-paths - after a project folder is copied to a new place,
-- rewrites the places in it that still name the old one (issue 188).
--
-- For a general audience: the project's scripts and documents name the
-- folders they live in ("/mnt/mtwo/games/azeroth-core/wow-chat-2026/..."),
-- so a copy of the project in a new place still points back at the old
-- one. This finds every such mention in the files git keeps, and in a few
-- files and links git does not keep (the database's settings, the
-- project's links), and changes them to the new place. Only the folders
-- that moved are changed, by their whole names: a folder that stays where
-- it was keeps its path, and "custom-client" never matches inside
-- "custom-client-llama-cpp-study". The saved conversations
-- (llm-transcripts/) are left as they were written: they are history.
-- Every change is listed. With --dry-run nothing is written.
--
-- Usage: move-project-paths DIR [--untracked] [--databases] [--dry-run]
--   DIR          the project folder at its NEW place (a git checkout)
--   --untracked  also the untracked files and links named in UNTRACKED
--                below, and every symbolic link pointing into an old place
--   --databases  also the update folders the database updater has recorded
--                (every database's updates_include rows), through the
--                project's MySQL at DIR, which must be running
-- The moves are the table MOVES below (old parent folders -> new parent).

-- {{{ settings
local DIR = arg[1]
if not DIR or DIR:match("^%-%-") then
    io.stderr:write("usage: move-project-paths DIR [--untracked] [--databases] [--dry-run]\n"); os.exit(1)
end
local opt = { untracked = false, databases = false, ["dry-run"] = false }
for i = 2, #arg do
    local f = arg[i]:match("^%-%-(.+)$")
    if not f or opt[f] == nil then io.stderr:write("move-project-paths: unknown option " .. arg[i] .. "\n"); os.exit(1) end
    opt[f] = true
end

-- the folders that moved, and the two spellings of where they were
-- (/home/ritz/games is a link to /mnt/mtwo/games)
local OLD_PARENTS = { "/mnt/mtwo/games/azeroth-core/", "/home/ritz/games/azeroth-core/" }
local NEW_PARENT  = "/mnt/kaun/"
local MOVED = { "wow-chat-2026", "wow-chat-neuron", "custom-client",
                "wow-chat-beta-homework", "wow-chat-completed-threads", "wow-chat-fronts-homework",
                "wow-chat-llama-cpp-study", "wow-chat-treasure-pool", "custom-client-llama-cpp-study" }

-- untracked files that name the old places (checked, not guessed: found by
-- reading the project on 2026-10-17)
-- my.cnf turned out to be tracked; the servers' generated settings
-- (installed-files-<profile>/etc/*.conf, written at install from the
-- .conf.dist files) are not, and name the data and log folders by full
-- path: a server started from the new copy before a reinstall would read
-- and write the old one. Shell patterns, expanded in DIR.
local UNTRACKED = { "mysql/conf/my.cnf", "installed-files-*/etc/*.conf", "installed-files-*/etc/modules/*.conf" }
-- }}}

-- {{{ local function lines_of / read / write
local function lines_of(cmd)
    local out, f = {}, io.popen(cmd)
    for l in f:lines() do out[#out + 1] = l end
    f:close()
    return out
end
local function read(path)
    local f = io.open(path, "rb"); if not f then return nil end
    local s = f:read("*a"); f:close(); return s
end
local function write(path, s)
    local f = assert(io.open(path, "wb")); f:write(s); f:close()
end
-- }}}

-- {{{ local function rewrite
-- The text with every old place of a moved folder changed to its new one.
-- A match must be the folder's whole name: what follows it may not be a
-- letter, digit, "_", "-" or "." that would make it a longer name.
-- Returns the new text and the number of changes.
local function escape(s) return (s:gsub("%p", "%%%0")) end
local function rewrite(text)
    local total = 0
    for _, parent in ipairs(OLD_PARENTS) do
        for _, name in ipairs(MOVED) do
            local pattern = escape(parent .. name) .. "([^%w_%-%.])"
            local n
            text, n = text:gsub(pattern, function(after) return NEW_PARENT .. name .. after end)
            total = total + n
            -- at the very end of the text
            if text:sub(-#(parent .. name)) == parent .. name then
                text = text:sub(1, -#(parent .. name) - 1) .. NEW_PARENT .. name
                total = total + 1
            end
        end
    end
    return text, total
end
-- }}}

local changedFiles, changes = 0, 0
local function handle(rel)
    local path = DIR .. "/" .. rel
    local text = read(path)
    if not text then return end
    local out, n = rewrite(text)
    if n > 0 then
        changedFiles, changes = changedFiles + 1, changes + n
        print(string.format("  %4d  %s", n, rel))
        if not opt["dry-run"] then write(path, out) end
    end
end

-- {{{ tracked files
print("tracked files in " .. DIR .. ":")
local tracked = lines_of("git -C '" .. DIR .. "' ls-files -z | tr '\\0' '\\n'")
-- Files that name the old places on purpose: this tool (its table and its
-- own description; rewriting itself once turned its example into the new
-- path) and the move's own record, which describes where things were.
local KEEP_AS_WRITTEN = { ["scripts/move-project-paths"] = true, ["issues/188-move-to-kaun.md"] = true }
for _, rel in ipairs(tracked) do
    if not rel:match("^llm%-transcripts/") and not KEEP_AS_WRITTEN[rel] then
        local kind = lines_of("test -L '" .. DIR .. "/" .. rel .. "' && echo link || echo file")[1]
        if kind == "file" then handle(rel) end
    end
end
-- }}}

-- {{{ untracked files and links
local relinked = 0
if opt.untracked then
    print("untracked files:")
    for _, pattern in ipairs(UNTRACKED) do
        -- expand the shell pattern inside DIR; a pattern matching nothing
        -- expands to nothing (the profile is not installed)
        for _, rel in ipairs(lines_of("cd '" .. DIR .. "' && for f in " .. pattern .. "; do [ -f \"$f\" ] && echo \"$f\"; done")) do
            handle(rel)
        end
    end
    print("symbolic links into an old place:")
    for _, line in ipairs(lines_of("find '" .. DIR .. "' -path '" .. DIR .. "/.git' -prune -o -type l -printf '%P\\t%l\\n'")) do
        local rel, target = line:match("^(.-)\t(.*)$")
        local newTarget, n = rewrite(target)
        if n > 0 then
            relinked = relinked + 1
            print("  " .. rel .. ": " .. target .. "  ->  " .. newTarget)
            if not opt["dry-run"] then
                os.execute("ln -sfn '" .. newTarget .. "' '" .. DIR .. "/" .. rel .. "'")
            end
        end
    end
end
-- }}}

-- {{{ the updater's recorded folders
-- The server's database updater remembers each folder it reads update files
-- from, by full path, in every database's updates_include table; the install
-- steps record them resolved (patches/E-helpers.sh, _register_with_updatefetcher).
-- After a move the old rows still name the old place, which the links left
-- there still reach, and the next install records the new place too; the
-- updater then reads every file twice and the worldserver stops ("Duplicate
-- filename ... every name needs to be unique"). Found by the beta session,
-- 2026-10-18. Each old row moves to the new path; if the new path's row is
-- already there (an install ran first), the old one goes instead (the path is
-- the table's key). One transaction per database.
local rowsMoved = 0
if opt.databases then
    print("database update folders:")
    local mysql = "'" .. DIR .. "/mysql/installed-files/bin/mysql' --no-defaults --socket='" .. DIR ..
                  "/mysql/databases/mysql.sock' -uritz -pmenardi -N 2>/dev/null"
    local dbs = lines_of(mysql .. " -e \"SELECT table_schema FROM information_schema.tables WHERE table_name = 'updates_include'\"")
    if #dbs == 0 then
        io.stderr:write("move-project-paths: no database answered with an updates_include table (is the project's MySQL running at " ..
                        DIR .. "/mysql?); none were changed\n")
        os.exit(1)
    end
    for _, db in ipairs(dbs) do
        for _, parent in ipairs(OLD_PARENTS) do
            for _, name in ipairs(MOVED) do
                local old, new = parent .. name, NEW_PARENT .. name
                local rows = lines_of(mysql .. " " .. db .. " -e \"SELECT path FROM updates_include WHERE path = '" .. old ..
                                      "' OR path LIKE '" .. old .. "/%'\"")
                for _, path in ipairs(rows) do
                    rowsMoved = rowsMoved + 1
                    local target = new .. path:sub(#old + 1)
                    print("  " .. db .. ": " .. path .. "  ->  " .. target)
                    if not opt["dry-run"] then
                        os.execute(mysql .. " " .. db .. " -e \"START TRANSACTION; " ..
                            "DELETE FROM updates_include WHERE path = '" .. path .. "' AND EXISTS " ..
                            "(SELECT 1 FROM (SELECT path FROM updates_include WHERE path = '" .. target .. "') AS t); " ..
                            "UPDATE updates_include SET path = '" .. target .. "' WHERE path = '" .. path .. "'; COMMIT;\"")
                    end
                end
            end
        end
    end
end
-- }}}

print(string.format("%s%d change(s) in %d file(s)%s%s", opt["dry-run"] and "(dry run) " or "",
    changes, changedFiles, opt.untracked and string.format(", %d link(s) re-made", relinked) or "",
    opt.databases and string.format(", %d database row(s) moved", rowsMoved) or ""))
