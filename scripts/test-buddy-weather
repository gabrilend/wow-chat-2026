#!/bin/bash

DIR="${1:-/mnt/kaun/wow-chat-2026}"
OUT="${DIR}/tmp/tmp"
mkdir -p "${OUT}"
g++ -std=c++17 -O2 -Wall -Wextra -Werror -I"${DIR}/patches/B036-mod-buddies/mod-buddies/src" \
    "${DIR}/tests/buddy-weather/weather-check.cpp" -o "${OUT}/buddy-weather" || exit 1
nice -n 19 "${OUT}/buddy-weather" || exit 1
g++ -std=c++17 -O2 -Wall -Wextra -Werror -I"${DIR}/patches/B036-mod-buddies/mod-buddies/src" \
    "${DIR}/tests/buddy-weather/storm-check.cpp" -o "${OUT}/buddy-storm" || exit 1
nice -n 19 "${OUT}/buddy-storm"
