#!/usr/bin/env luajit

local DIR = "/mnt/kaun/wow-chat-2026"
local args = {}
for _, a in ipairs(arg) do args[#args + 1] = a end
if args[1] and args[1]:sub(1, 1) == "/" then DIR = table.remove(args, 1) end
local CMD = table.remove(args, 1)
local NOTES_REF = "tests"

local function die(msg) io.stderr:write("test-memory: " .. msg .. "\n"); os.exit(1) end
local function q(s) return "'" .. s:gsub("'", "'\\''") .. "'" end
local function lines_of(cmd)
    local h = io.popen(cmd .. "; echo \"__status $?\"")
    local out = {}
    for l in h:lines() do out[#out + 1] = l end
    h:close()
    local status = table.remove(out)
    if status ~= "__status 0" then die("this failed (" .. tostring(status) .. "): " .. cmd) end
    return out
end
local GIT = "git -C " .. q(DIR) .. " "
local HERE = debug.getinfo(1, "S").source:match("^@(.*/)") or "./"
local Header = dofile(HERE .. "lib/patch-header.lua")

local COMMIT, TOUCHED, names = nil, nil, {}
do
    local i = 1
    while i <= #args do
        if args[i] == "--commit" then i = i + 1; COMMIT = args[i]
        elseif args[i] == "--touched-by" then i = i + 1; TOUCHED = args[i]
        else names[#names + 1] = args[i] end
        i = i + 1
    end
end

local FILES = {}
local function load_files()
    if COMMIT then
        for _, l in ipairs(lines_of(GIT .. "ls-tree -r " .. q(COMMIT))) do
            local kind, hash, path = l:match("^%d+ (%w+) (%x+)\t(.+)$")
            if kind == "blob" then FILES[path] = hash end
        end
        return
    end
    for _, l in ipairs(lines_of(GIT .. "ls-files -s")) do
        local hash, path = l:match("^%d+ (%x+) %d\t(.+)$")
        if hash then FILES[path] = hash end
    end
    for _, path in ipairs(lines_of(GIT .. "ls-files -d")) do FILES[path] = nil end
    local fresh = {}
    for _, path in ipairs(lines_of(GIT .. "ls-files -m")) do if FILES[path] then fresh[#fresh + 1] = path end end
    for _, path in ipairs(lines_of(GIT .. "ls-files -o --exclude-standard")) do fresh[#fresh + 1] = path end
    if #fresh > 0 then
        local list = os.tmpname()
        local f = assert(io.open(list, "w"))
        local real = {}
        for _, path in ipairs(fresh) do
            local probe = io.open(DIR .. "/" .. path, "rb")
            if probe and probe:read(0) then real[#real + 1] = path; f:write(path, "\n") end
            if probe then probe:close() end
        end
        f:close()
        local hashes = #real > 0 and lines_of(GIT .. "hash-object --stdin-paths < " .. q(list)) or {}
        os.remove(list)
        for k, path in ipairs(real) do FILES[path] = hashes[k] end
    end
end

local SORTED, BASENAMES = {}, {}
local function index_files()
    for path in pairs(FILES) do
        SORTED[#SORTED + 1] = path
        local base = path:match("([^/]+)$")
        BASENAMES[base] = BASENAMES[base] or {}
        table.insert(BASENAMES[base], path)
    end
    table.sort(SORTED)
end
local function starting_with(prefix)
    local lo, hi = 1, #SORTED + 1
    while lo < hi do
        local mid = math.floor((lo + hi) / 2)
        if SORTED[mid] < prefix then lo = mid + 1 else hi = mid end
    end
    local out = {}
    while SORTED[lo] and SORTED[lo]:sub(1, #prefix) == prefix do out[#out + 1] = SORTED[lo]; lo = lo + 1 end
    return out
end

local TEXT = {}
local function text_of(path)
    if TEXT[path] ~= nil then return TEXT[path] or nil end
    local t
    if COMMIT then
        local h = io.popen(GIT .. "cat-file -p " .. FILES[path])
        t = h:read("*a"); h:close()
    else
        local f = io.open(DIR .. "/" .. path, "rb")
        if f then t = f:read("*a"); f:close() end
    end
    if t and #t > 1024 * 1024 then t = nil end
    TEXT[path] = t or false
    return t
end

local function followed(path)
    return path:match("^scripts/") or path:match("^patches/") or path:match("^config/patches/")
        or path:match("%.lua$") or path:match("%.sh$")
end

local function code_of(path, text)
    local lua = path:match("%.lua$") or text:match("^#![^\n]*lua")
    local out = {}
    for line in (text .. "\n"):gmatch("([^\n]*)\n") do
        if lua then line = line:gsub("%-%-.*$", "")
        else line = line:gsub("^#.*$", ""):gsub("(%s)#.*$", "%1") end
        out[#out + 1] = line
    end
    return table.concat(out, "\n")
end

local DIR_PREFIX = DIR .. "/"
local function names_in(text, home)
    local found = {}
    local function add(list) for _, p in ipairs(list) do found[#found + 1] = { p, false } end end
    local function tails(word)
        local out = { word }
        for pos in word:gmatch("()/") do out[#out + 1] = word:sub(pos + 1) end
        return out
    end
    for word in text:gmatch("[%w%._%-/]+") do
      if word:sub(1, #DIR_PREFIX) == DIR_PREFIX then word = word:sub(#DIR_PREFIX + 1) end
      local before = #found
      for _, tok in ipairs(tails(word)) do
        if #found > before then break end
        tok = tok:gsub("^%./", ""):gsub("^/+", "")
        if #tok >= 3 then
            if FILES[tok] and tok:find("[/.]") then
                found[#found + 1] = { tok, true }
            elseif home and FILES[home .. tok] and tok:find("[/.]") then
                found[#found + 1] = { home .. tok, true }
            elseif tok:find("/", 1, true) and FILES["scripts/" .. tok] then
                found[#found + 1] = { "scripts/" .. tok, true }
            elseif tok:find("/", 1, true) and #tok >= 5 then
                local list = starting_with(tok)
                if #list == 0 then list = starting_with("scripts/" .. tok) end
                add(list)
            elseif tok:match("^[%w_%-]+%.[%w]+$") and #tok >= 6 and BASENAMES[tok] then
                for _, p in ipairs(BASENAMES[tok]) do found[#found + 1] = { p, true } end
            end
        end
      end
    end
    return found
end

local function read_set(test)
    local start = "scripts/" .. test
    if not FILES[start] then die("no " .. start .. (COMMIT and (" in commit " .. COMMIT) or " in the working tree")) end
    local seen, queue, out = { [start] = true }, { start }, { start }
    while #queue > 0 do
        local path = table.remove(queue)
        local t = text_of(path)
        if t then
            for _, n in ipairs(names_in(code_of(path, t), path:match("^(.*/)"))) do
                local p, exact = n[1], n[2]
                if not seen[p] then
                    seen[p] = true
                    out[#out + 1] = p
                    if exact and followed(p) then queue[#queue + 1] = p; if os.getenv("TEST_MEMORY_DEBUG") then io.stderr:write("follow: ", path, " -> ", p, "\n") end end
                end
            end
        end
    end
    table.sort(out)
    return out
end

local function fingerprint(set)
    local f = os.tmpname()
    local h = assert(io.open(f, "w"))
    for _, path in ipairs(set) do h:write(path, "\t", FILES[path], "\n") end
    h:close()
    local out = lines_of("sha1sum " .. q(f))
    os.remove(f)
    return out[1]:match("^(%x+)")
end

local function remembered_passes()
    local passes = {}
    local pairs_ = lines_of(GIT .. "notes --ref=" .. NOTES_REF .. " list")
    for _, l in ipairs(pairs_) do
        local blob, commit = l:match("^(%x+) (%x+)$")
        if blob then
            local h = io.popen(GIT .. "cat-file -p " .. blob)
            for line in h:lines() do
                local result, test, fp, when, how = line:match("^(%a+) (%S+) (%x+) (%d+) (%S+)$")
                if result then
                    passes[test] = passes[test] or {}
                    local was = passes[test][fp]
                    when = tonumber(when)
                    if not was or when > was.when or (when == was.when and result == "fail") then
                        passes[test][fp] = { pass = (result == "pass"), when = when, commit = commit, how = how }
                    end
                end
            end
            h:close()
        end
    end
    return passes
end

local COMMANDS = {}

function COMMANDS.reads()
    if #names ~= 1 then die("usage: test-memory [PROJECT_DIR] reads TEST [--commit SHA]") end
    load_files(); index_files()
    for _, p in ipairs(read_set(names[1])) do print(p) end
end

function COMMANDS.plan()
    if #names == 0 then die("usage: test-memory [PROJECT_DIR] plan [--commit SHA] [--touched-by SHA] TEST...") end
    load_files(); index_files()
    local changed
    if TOUCHED then
        changed = {}
        for _, p in ipairs(lines_of(GIT .. "diff-tree --root --no-commit-id --name-only -r " .. q(TOUCHED))) do changed[p] = true end
    end
    local passes = remembered_passes()
    for _, test in ipairs(names) do
        local r = Header.read(DIR .. "/scripts/" .. test)
        local set = read_set(test)
        local fp = fingerprint(set)
        if r.fields and r.fields.remember == "no" then
            print(table.concat({ test, "-", "never", "its header says remember: no" }, "\t"))
        else
            local touched = true
            if changed then
                touched = false
                for _, p in ipairs(set) do if changed[p] then touched = true; break end end
            end
            local hit = passes[test] and passes[test][fp]
            if not touched then
                print(table.concat({ test, fp, "untouched", #set .. " files read, none changed by " .. TOUCHED:sub(1, 7) }, "\t"))
            elseif hit and hit.pass then
                print(table.concat({ test, fp, "remembered", hit.commit:sub(1, 7) .. " (" .. hit.how .. ", " .. os.date("%Y-%m-%d %H:%M", hit.when) .. ")" }, "\t"))
            else
                print(table.concat({ test, fp, "run", hit and "failed last time on these files" or "not yet run on these files" }, "\t"))
            end
        end
    end
end

function COMMANDS.record()
    local sha, how = names[1], names[2]
    if not (sha and how and how:match("^%w+$")) then die("usage: test-memory [PROJECT_DIR] record SHA HOW < results") end
    local now, out = os.time(), {}
    for line in io.lines() do
        local result, test, fp = line:match("^(%a+) (%S+) (%x+)$")
        if not (result == "pass" or result == "fail") then die("a result line should read \"pass|fail TEST FINGERPRINT\", not: " .. line) end
        out[#out + 1] = table.concat({ result, test, fp, now, how }, " ")
    end
    if #out == 0 then return end
    local f = os.tmpname()
    local h = assert(io.open(f, "w")); h:write(table.concat(out, "\n"), "\n"); h:close()
    lines_of(GIT .. "notes --ref=" .. NOTES_REF .. " append -F " .. q(f) .. " " .. q(sha))
    os.remove(f)
    print("recorded " .. #out .. " results on " .. sha:sub(1, 7))
end

if not COMMANDS[CMD or ""] then die("the command is reads, plan or record (see the top of this file)") end
COMMANDS[CMD]()
