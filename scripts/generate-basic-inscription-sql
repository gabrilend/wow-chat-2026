#!/usr/bin/env luajit
-- generate-basic-inscription-sql - sort Inscription's recipes, from the game
-- client's own tables, into "glyphs" and "stat scrolls and vellums", and write
-- the two lists into the basic profile's Inscription SQL (issue 155o).
--
-- For a general audience: on basic, Inscription loses its glyphs and becomes
-- a buff-scroll profession. The SQL needs to know which recipes are glyphs
-- (to remove them from trainers) and which are the stat scrolls and the
-- rank-III vellums (to make every rank learnable within basic's 300 skill
-- cap). Those facts live in the client's profession table
-- (SkillLineAbility.dbc: which spells belong to Inscription) and spell table
-- (Spell.dbc: each spell's name and the item it makes). The tool writes them
-- between two marker lines in the SQL file.
--
-- Usage: scripts/generate-basic-inscription-sql [PROJECT_DIR]
--   Reads   data-files/dbc/{SkillLineAbility,Spell}.dbc
--   Writes  sql/basic/db_world.src/14-inscription-without-glyphs.apply.sql
--           (only the GENERATED block)

local DIR = arg[1] or "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local DBC = DIR .. "/data-files/dbc/"
local OUT = DIR .. "/sql/basic/db_world.src/14-inscription-without-glyphs.apply.sql"

-- {{{ configuration
local SKILL_INSCRIPTION = 773
local BEGIN_MARK = "-- >>> GENERATED by scripts/generate-basic-inscription-sql"
local END_MARK   = "-- <<< GENERATED END"
-- }}}

-- {{{ local function die
local function die(msg)
    io.stderr:write("generate-basic-inscription-sql: ", msg, "\n")
    os.exit(1)
end
-- }}}

-- {{{ local function load_dbc
local function load_dbc(name)
    local f = io.open(DBC .. name, "rb") or die("cannot open " .. DBC .. name)
    local d = f:read("*a")
    f:close()
    if d:sub(1, 4) ~= "WDBC" then die(name .. " is not a WDBC file") end
    local function u32(o) local a, b, c, e = d:byte(o + 1, o + 4); return a + b * 256 + c * 65536 + e * 16777216 end
    local n, rs = u32(4), u32(12)
    local sb = 20 + n * rs
    local function str(o) local so = sb + u32(o); local e = d:find("\0", so + 1, true); return d:sub(so + 1, e - 1) end
    return n, rs, u32, str
end
-- }}}

-- {{{ main
-- SkillLineAbility.dbc: 1 skill line, 2 spell
local spells = {}
do
    local n, rs, u32 = load_dbc("SkillLineAbility.dbc")
    for i = 0, n - 1 do
        local o = 20 + i * rs
        if u32(o + 4) == SKILL_INSCRIPTION then spells[u32(o + 8)] = true end
    end
end
-- Spell.dbc: 0 id, 107 created item (first effect), 136 name (enUS)
local glyphs, scrolls = {}, {}
do
    local n, rs, u32, str = load_dbc("Spell.dbc")
    for i = 0, n - 1 do
        local o = 20 + i * rs
        local id = u32(o)
        if spells[id] then
            local name = str(o + 136 * 4)
            if name:match("^Glyph of ") or name:match("Inscription Research$") then
                glyphs[#glyphs + 1] = id
            elseif name:match("^Scroll of Stamina") or name:match("^Scroll of Intellect") or name:match("^Scroll of Spirit")
                or name:match("^Scroll of Agility") or name:match("^Scroll of Strength") or name:match("^%a+ Vellum III$") then
                scrolls[#scrolls + 1] = { id, u32(o + 107 * 4), name }
            end
        end
    end
end
table.sort(glyphs)
table.sort(scrolls, function(a, b) return a[1] < b[1] end)
if #glyphs == 0 or #scrolls == 0 then die("empty list (glyphs " .. #glyphs .. ", scrolls " .. #scrolls .. ")") end

local g, s = {}, {}
for _, id in ipairs(glyphs) do g[#g + 1] = "(" .. id .. ")" end
for _, r in ipairs(scrolls) do s[#s + 1] = string.format("(%d,%d)", r[1], r[2]) end
local block = table.concat({
    BEGIN_MARK .. " — do not edit by hand",
    "-- glyph recipes and glyph research (Inscription spells named 'Glyph of ...' or '... Inscription Research'): " .. #glyphs,
    "INSERT INTO `tmp_155o_glyph_spells` (`spell_id`) VALUES " .. table.concat(g, ",") .. ";",
    "-- stat scroll and rank-III vellum recipes: (recipe spell, item it makes): " .. #scrolls,
    "INSERT INTO `tmp_155o_scroll_spells` (`spell_id`, `item_id`) VALUES " .. table.concat(s, ",") .. ";",
    END_MARK }, "\n")
local f = io.open(OUT, "r") or die("cannot open " .. OUT)
local sql = f:read("*a")
f:close()
local a = sql:find(BEGIN_MARK, 1, true)
local b = sql:find(END_MARK, 1, true)
if not a or not b or b < a then die("markers not found in " .. OUT) end
sql = sql:sub(1, a - 1) .. block .. sql:sub(b + #END_MARK)
f = assert(io.open(OUT, "w"))
f:write(sql)
f:close()
io.write(string.format("wrote %d glyph spells, %d scroll/vellum spells into %s\n", #glyphs, #scrolls, OUT))
-- }}}
