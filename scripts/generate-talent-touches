#!/usr/bin/env luajit
-- generate-talent-touches - works out, for every talent of every class,
-- which of the class's abilities it improves, from the game's own data
-- (issue 625a).
--
-- For a general audience: a buddy should lean on the abilities its
-- talents improve. The game itself knows exactly which those are: every
-- class spell carries a hidden set of flags, and a talent names the flags
-- of the spells it changes; the server applies talents by exactly this.
-- Some talents name no spells but a whole school of magic ("your Shadow
-- spells") or every attack made with a weapon; those are widened to every
-- ability of the class that matches. This tool reads the game client's
-- tables once and writes the answer as plain data the buddy code reads,
-- and a listing per class to check by eye. Nothing is guessed from icons
-- or tooltip words (the owner, 2026-10-30: no shortcut built in).
--
-- Usage: scripts/generate-talent-touches [DIR] [--out PATH] [--listing PATH]
--   DIR            the project root (default the hard-coded one below)
--   --out PATH     the data file (default DIR/src/lua-basic/data/buddy-talent-touches.lua)
--   --listing PATH the listing (default DIR/docs/talent-touches.md)
--   --help         this text
-- Reads data-files/dbc/{Talent,TalentTab,Spell,SkillLineAbility}.dbc

local DIR = "/mnt/kaun/wow-chat-2026"

-- {{{ arguments
local out, listing
do
    local i = 1
    while i <= #arg do
        local a = arg[i]
        if a == "--help" or a == "-h" then
            for line in io.lines(arg[0]) do
                if not line:match("^%-%-") and not line:match("^#!") then break end
                print((line:gsub("^%-%- ?", "")))
            end
            os.exit(0)
        elseif a == "--out"     then out = arg[i + 1]; i = i + 1
        elseif a == "--listing" then listing = arg[i + 1]; i = i + 1
        elseif a:sub(1, 2) ~= "--" then DIR = a
        else error("unknown option " .. a .. " (see --help)") end
        i = i + 1
    end
end
out     = out or (DIR .. "/src/lua-basic/data/buddy-talent-touches.lua")
listing = listing or (DIR .. "/docs/talent-touches.md")
local DBC = DIR .. "/data-files/dbc/"
-- }}}

-- {{{ the game's numbers
-- Classes: the game's class id, its talent-tree class bit, and the spell
-- family its spells carry (Spell.dbc SpellFamilyName; SharedDefines.h
-- SpellFamilyNames).
local CLASSES = {
    { id = 1,  name = "Warrior",      family = 4  },
    { id = 2,  name = "Paladin",      family = 10 },
    { id = 3,  name = "Hunter",       family = 9  },
    { id = 4,  name = "Rogue",        family = 8  },
    { id = 5,  name = "Priest",       family = 6  },
    { id = 6,  name = "Death Knight", family = 15 },
    { id = 7,  name = "Shaman",       family = 11 },
    { id = 8,  name = "Mage",         family = 3  },
    { id = 9,  name = "Warlock",      family = 5  },
    { id = 11, name = "Druid",        family = 7  },
}
-- What a talent's modifier changes (SpellDefines.h SpellModOp), in words.
local MOD_WORDS = {
    [0] = "damage or healing", [1] = "duration", [2] = "threat", [3] = "first effect", [4] = "charges",
    [5] = "range", [6] = "radius", [7] = "critical chance", [8] = "all effects", [9] = "pushback",
    [10] = "cast time", [11] = "cooldown", [12] = "second effect", [13] = "armor ignored", [14] = "cost",
    [15] = "critical bonus", [16] = "hit chance", [17] = "targets", [18] = "chance of success",
    [19] = "activation time", [20] = "damage multiplier", [21] = "global cooldown", [22] = "over time",
    [23] = "third effect", [24] = "bonus multiplier", [26] = "procs per minute", [27] = "value multiplier",
    [28] = "dispel resistance", [29] = "critical bonus", [30] = "cost refund",
}
-- Aura kinds read (SpellAuraDefines.h): 107 and 108 flat and percent
-- modifiers of named spells; 4 a dummy and 42 a proc, which name spells
-- too; 13, 79 and 71 widen to a school of magic (damage done, percent
-- damage done, spell critical chance), their misc value a school mask.
local AURA_FLAT, AURA_PCT, AURA_DUMMY, AURA_PROC = 107, 108, 4, 42
local SCHOOL_AURAS = { [13] = "damage", [79] = "damage", [71] = "critical chance" }
local SCHOOLS = { [1] = "Physical", [2] = "Holy", [4] = "Fire", [8] = "Nature", [16] = "Frost", [32] = "Shadow", [64] = "Arcane" }
local EFFECT_LEARN = 36                                -- SPELL_EFFECT_LEARN_SPELL: the talent teaches its trigger spell
local ATTR0_PASSIVE = 0x40
-- }}}

-- {{{ local function load_dbc()
local function u32(d, o) local a, b, c, e = d:byte(o + 1, o + 4); return a + b * 256 + c * 65536 + e * 16777216 end
local function load_dbc(name)
    local f = io.open(DBC .. name, "rb") or error("cannot open " .. DBC .. name)
    local d = f:read("*a")
    f:close()
    if d:sub(1, 4) ~= "WDBC" then error(name .. " is not a WDBC file") end
    local n, rs = u32(d, 4), u32(d, 12)
    local strings = 20 + n * rs
    local rows = {}
    for r = 0, n - 1 do
        local b = 20 + r * rs
        rows[#rows + 1] = {
            u = function(field) return u32(d, b + field * 4) end,
            s = function(field)
                local s = strings + u32(d, b + field * 4)
                return d:sub(s + 1, (d:find("\0", s + 1, true) or s + 1) - 1)
            end,
        }
    end
    return rows
end
-- }}}

-- {{{ the spells
-- Spell.dbc columns (DBCStructure.h SpellEntry's comments): 0 id, 4 the
-- first attributes, 68 equipped item class, 71-73 effects, 95-97 aura
-- kinds, 110-112 misc values, 116-118 trigger spells, 122-130 each
-- effect's class mask (three words each), 136 the English name, 153 the
-- rank, 208 the family, 209-211 the family flags, 213 the damage class
-- (2 melee, 3 ranged), 225 the school mask.
local SPELL = {}
for _, r in ipairs(load_dbc("Spell.dbc")) do
    local s = { id = r.u(0), name = r.s(136), rank = r.s(153), family = r.u(208),
                flags = { r.u(209), r.u(210), r.u(211) }, passive = bit.band(r.u(4), ATTR0_PASSIVE) ~= 0,
                itemClass = r.u(68), dmgClass = r.u(213), school = r.u(225), effects = {} }
    for e = 0, 2 do
        s.effects[e + 1] = { effect = r.u(71 + e), aura = r.u(95 + e), misc = r.u(110 + e), trigger = r.u(116 + e),
                             mask = { r.u(122 + e * 3), r.u(123 + e * 3), r.u(124 + e * 3) } }
    end
    SPELL[s.id] = s
end
-- The spells a character can learn: those on a skill line
-- (SkillLineAbility.dbc column 2). Triggered and proc spells aren't.
local LEARNABLE = {}
for _, r in ipairs(load_dbc("SkillLineAbility.dbc")) do LEARNABLE[r.u(2)] = true end
-- }}}

-- {{{ the talents
-- TalentTab.dbc: 0 id, 1 name, 20 class mask, 22 its place left to right.
-- Talent.dbc: 0 id, 1 tab, 2 row, 3 column, 4-8 each rank's spell.
local TABS = {}
for _, r in ipairs(load_dbc("TalentTab.dbc")) do
    if r.u(20) ~= 0 then TABS[r.u(0)] = { name = r.s(1), classMask = r.u(20), page = r.u(22) } end
end
local TALENTS, TALENT_SPELL = {}, {}
for _, r in ipairs(load_dbc("Talent.dbc")) do
    local tab = TABS[r.u(1)]
    if tab then
        local t = { id = r.u(0), tab = tab, row = r.u(2), col = r.u(3), spells = {} }
        for k = 4, 8 do if r.u(k) ~= 0 then t.spells[#t.spells + 1] = r.u(k); TALENT_SPELL[r.u(k)] = true end end
        TALENTS[#TALENTS + 1] = t
    end
end
-- }}}

-- {{{ each class's abilities, by name
-- An ability is a learnable, active spell of the class's family that is
-- not itself a talent's rank; its ranks are gathered under its name.
local function abilities_of(cls)
    local byName = {}
    for id, s in pairs(SPELL) do
        if s.family == cls.family and LEARNABLE[id] and not s.passive and not TALENT_SPELL[id] and s.name ~= "" then
            local a = byName[s.name]
            if not a then a = { name = s.name, spells = {}, school = 0, dmgClass = s.dmgClass }; byName[s.name] = a end
            a.spells[#a.spells + 1] = id
            a.school = bit.bor(a.school, s.school)
            a.flags = a.flags or { 0, 0, 0 }
            for w = 1, 3 do a.flags[w] = bit.bor(a.flags[w], s.flags[w]) end
        end
    end
    return byName
end
-- }}}

-- {{{ local function touches_of()
-- For one talent (all its ranks' spells read together), the abilities it
-- touches and how: { [ability name] = { hows = { word = true }, broad = text or nil } }.
local function touches_of(t, abilities, cls)
    local found, teaches = {}, {}
    local function mark(name, how, broad)
        found[name] = found[name] or { hows = {} }
        found[name].hows[how] = true
        if broad then found[name].broad = broad end
    end
    -- a talent whose spell is itself an active ability (Insect Swarm,
    -- Swiftmend) is that ability, learned through the tree: its own
    -- effects' masks name what the ability does, not what it improves
    local first = SPELL[t.spells[1]]
    if first and not first.passive then
        teaches[first.name] = true
        return found, teaches, true
    end
    for _, sid in ipairs(t.spells) do
        local s = SPELL[sid]
        for _, e in ipairs(s and s.effects or {}) do
            local masked = e.mask[1] ~= 0 or e.mask[2] ~= 0 or e.mask[3] ~= 0
            if e.effect == EFFECT_LEARN and e.trigger ~= 0 and SPELL[e.trigger] then
                teaches[SPELL[e.trigger].name] = true
            elseif masked then
                -- the exact answer: abilities of the family whose flags overlap
                local how = (e.aura == AURA_FLAT or e.aura == AURA_PCT) and (MOD_WORDS[e.misc] or ("modifier " .. e.misc))
                            or (e.aura == AURA_PROC and "a proc on it") or "an effect on it"
                for name, a in pairs(abilities) do
                    for w = 1, 3 do
                        if bit.band(a.flags[w], e.mask[w]) ~= 0 then mark(name, how); break end
                    end
                end
            elseif SCHOOL_AURAS[e.aura] and e.misc ~= 0 and e.misc ~= 127 then
                -- a whole school of magic, or with a weapon
                local schools = {}
                for m, n in pairs(SCHOOLS) do if bit.band(e.misc, m) ~= 0 then schools[#schools + 1] = n end end
                table.sort(schools)
                local broad = (s.itemClass == 2 and "every attack with a weapon") or ("every " .. table.concat(schools, " and ") .. " ability")
                for name, a in pairs(abilities) do
                    -- a physical ability counts only if it strikes (melee
                    -- or ranged), so forms and stances aren't "physical damage"
                    local strikes = a.dmgClass == 2 or a.dmgClass == 3
                    local weaponHit = s.itemClass == 2 and strikes
                    local schoolHit = s.itemClass ~= 2 and bit.band(a.school, e.misc) ~= 0
                        and (bit.band(a.school, 1) == 0 or strikes)
                    if weaponHit or schoolHit then
                        mark(name, SCHOOL_AURAS[e.aura], broad)
                    end
                end
            end
        end
    end
    return found, teaches
end
-- }}}

-- {{{ writing
local data, md = {}, {}
data[#data + 1] = "-- buddy-talent-touches.lua - GENERATED by scripts/generate-talent-touches from the client's Talent, TalentTab, Spell and SkillLineAbility tables, so buddies can favour the abilities their talents improve (issue 625a); don't edit, run it again."
data[#data + 1] = "-- touches[talent id] = { name, class, tree, row, abilities = { [ability name] = { how = { words }, broad = text or nil } }, teaches = { names } }"
data[#data + 1] = "return {"
md[#md + 1] = "<!-- docs/talent-touches.md - GENERATED by scripts/generate-talent-touches from the client's tables (issue 625a), to check by eye which abilities each talent improves; don't edit, run it again. -->"
md[#md + 1] = "# What Each Talent Touches"
md[#md + 1] = ""
md[#md + 1] = "Read from the game's own data: the hidden flags the server applies talents by, and talents aimed at a whole school of magic or every weapon attack (marked *broad*). A talent with nothing listed improves no ability directly (a passive bonus, or a weapon kind)."
local totals = { talents = 0, touching = 0, links = 0 }
for _, cls in ipairs(CLASSES) do
    local abilities = abilities_of(cls)
    local mine = {}
    for _, t in ipairs(TALENTS) do if bit.band(t.tab.classMask, 2 ^ (cls.id - 1)) ~= 0 then mine[#mine + 1] = t end end
    table.sort(mine, function(a, b)
        if a.tab.page ~= b.tab.page then return a.tab.page < b.tab.page end
        if a.row ~= b.row then return a.row < b.row end
        return a.col < b.col end)
    md[#md + 1] = ""
    md[#md + 1] = "## " .. cls.name
    local lastTab
    for _, t in ipairs(mine) do
        local name = SPELL[t.spells[1]] and SPELL[t.spells[1]].name or ("talent " .. t.id)
        local found, teaches, isAbility = touches_of(t, abilities, cls)
        if t.tab.name ~= lastTab then md[#md + 1] = ""; md[#md + 1] = "### " .. t.tab.name; lastTab = t.tab.name end
        local names = {}
        for n in pairs(found) do names[#names + 1] = n end
        table.sort(names)
        local parts, dparts = {}, {}
        for _, n in ipairs(names) do
            local hows = {}
            for h in pairs(found[n].hows) do hows[#hows + 1] = h end
            table.sort(hows)
            parts[#parts + 1] = n .. " (" .. table.concat(hows, ", ") .. (found[n].broad and "; broad: " .. found[n].broad or "") .. ")"
            local q = {}
            for _, h in ipairs(hows) do q[#q + 1] = string.format("%q", h) end
            dparts[#dparts + 1] = string.format("[%q] = { how = { %s }%s }", n, table.concat(q, ", "),
                found[n].broad and string.format(", broad = %q", found[n].broad) or "")
            totals.links = totals.links + 1
        end
        local taught = {}
        for n in pairs(teaches) do taught[#taught + 1] = n end
        table.sort(taught)
        totals.talents = totals.talents + 1
        if #names > 0 then totals.touching = totals.touching + 1 end
        md[#md + 1] = "- **" .. name .. "** (row " .. (t.row + 1) .. "): "
            .. (isAbility and "an ability itself, learned through the tree"
                or ((#parts > 0 and table.concat(parts, "; ") or "nothing directly")
                    .. (#taught > 0 and ("; teaches " .. table.concat(taught, ", ")) or "")))
        local tq = {}
        for _, n in ipairs(taught) do tq[#tq + 1] = string.format("%q", n) end
        data[#data + 1] = string.format("    [%d] = { name = %q, class = %q, tree = %q, row = %d, abilities = { %s }, teaches = { %s } },",
            t.id, name, cls.name, t.tab.name, t.row + 1, table.concat(dparts, ", "), table.concat(tq, ", "))
    end
end
data[#data + 1] = "}"
local f = io.open(out, "w") or error("cannot write " .. out)
f:write(table.concat(data, "\n"), "\n")
f:close()
f = io.open(listing, "w") or error("cannot write " .. listing)
f:write(table.concat(md, "\n"), "\n")
f:close()
print(string.format("%d talents read; %d touch at least one ability (%d links); written to %s and %s",
    totals.talents, totals.touching, totals.links, out, listing))
-- }}}
