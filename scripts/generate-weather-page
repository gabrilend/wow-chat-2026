#!/usr/bin/env luajit
-- generate-weather-page - draws Alterac Valley's shared sky and wandering
-- storm as a page, from the real arithmetic (issues 921, 921a, 921b).
--
-- For a general audience: the weather deck and the storm are plain
-- arithmetic in the buddy module (buddies_weather_deck.h,
-- buddies_weather_storm.h). This tool compiles their two test programs,
-- asks them for a timeline (the sky every 20 seconds) and the storm's walk
-- (its place every 10 seconds) for some hours, and writes a page that plays
-- them back: the deck's turns as coloured bands with each turn's swell and
-- fade, and the storm moving over the valley's real cells, leaving a heat
-- map of where it has been. The page draws only what the programs wrote, so
-- it can't disagree with the server.
--
-- Usage: scripts/generate-weather-page [DIR] [--hours N] [--seed N] [--out PATH]
--   DIR          the project root (default the hard-coded one below)
--   --hours N    how long to play (default 3)
--   --seed N     the seed (default 2026)
--   --out PATH   the page (default DIR/docs/HTML/alterac-weather.html)
--   --help       this text

local DIR = "/mnt/kaun/wow-chat-2026"

-- {{{ arguments
local hours, seed, out = 3, 2026, nil
do
    local i = 1
    while i <= #arg do
        local a = arg[i]
        if a == "--help" or a == "-h" then
            for line in io.lines(arg[0]) do
                if not line:match("^%-%-") and not line:match("^#!") then break end
                print((line:gsub("^%-%- ?", "")))
            end
            os.exit(0)
        elseif a == "--hours" then hours = tonumber(arg[i + 1]) or error("--hours takes a number"); i = i + 1
        elseif a == "--seed"  then seed = tonumber(arg[i + 1]) or error("--seed takes a number"); i = i + 1
        elseif a == "--out"   then out = arg[i + 1]; i = i + 1
        elseif a:sub(1, 2) ~= "--" then DIR = a
        else error("unknown option " .. a .. " (see --help)") end
        i = i + 1
    end
end
out = out or (DIR .. "/docs/HTML/alterac-weather.html")
-- }}}

-- {{{ local function sh()
local function sh(cmd)
    local p = io.popen(cmd)
    local o = p:read("*a")
    local ok = p:close()
    return o, ok
end
-- }}}

-- {{{ the programs, compiled and asked
local SRC, TMP = DIR .. "/patches/B036-mod-buddies/mod-buddies/src", DIR .. "/tmp/tmp"
os.execute("mkdir -p '" .. TMP .. "'")
for _, prog in ipairs({ { "weather-check", "buddy-weather" }, { "storm-check", "buddy-storm" } }) do
    local _, ok = sh(string.format("g++ -std=c++17 -O2 -I'%s' '%s/tests/buddy-weather/%s.cpp' -o '%s/%s' 2>&1", SRC, DIR, prog[1], TMP, prog[2]))
    if not ok then error("could not compile tests/buddy-weather/" .. prog[1] .. ".cpp") end
end
local timeline = sh(string.format("'%s/buddy-weather' --timeline %d %d", TMP, seed, hours))
local path = sh(string.format("'%s/buddy-storm' --path %d %d", TMP, seed, hours * 3600))
local cells = {}
local data = io.open(SRC .. "/buddies_av_valley_data.h"):read("*a")
for x, y in data:gmatch("{ (%-?%d+), (%-?%d+) }") do cells[#cells + 1] = "[" .. x .. "," .. y .. "]" end
local function lines_to_array(t)
    local a = {}
    for line in t:gmatch("[^\n]+") do a[#a + 1] = line end
    return "[" .. table.concat(a, ",") .. "]"
end
-- }}}

-- {{{ the page
local html = [==[<!doctype html>
<!-- docs/HTML/alterac-weather.html - GENERATED by scripts/generate-weather-page from the weather deck's and storm's own test programs (issues 921, 921a, 921b), to watch the shared sky and the storm play out; don't edit, run it again. -->
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Alterac Valley's Weather</title>
<style>
:root{--bg:#f3f4f6;--panel:#fff;--ink:#1c2127;--dim:#5d6670;--line:#d6dae0;--accent:#8a6a00}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121418;--panel:#1a1d22;--ink:#e6e6e3;--dim:#9aa0a6;--line:#2c3138;--accent:#e8c547}}
:root[data-theme="dark"]{--bg:#121418;--panel:#1a1d22;--ink:#e6e6e3;--dim:#9aa0a6;--line:#2c3138;--accent:#e8c547}
body{background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,sans-serif;margin:0;padding:16px}
main{max-width:70rem;margin:0 auto}h1{margin:.2rem 0}p{max-width:65ch;color:var(--dim)}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:12px;margin:12px 0}
canvas{width:100%;display:block}.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.now{font-weight:600}input[type=range]{flex:1;min-width:200px}.key span{display:inline-block;margin-right:10px;font-size:.85rem}
.key i{display:inline-block;width:12px;height:12px;border-radius:2px;margin-right:4px;vertical-align:-1px}
</style></head><body><main>
<h1>Alterac Valley's Weather</h1>
<p>One sky for every match, dealt like a shuffled deck, and one storm wandering the valley. Played back from the server's own arithmetic (seed SEED, HOURS hours). The deck's turns are six minutes each; the storm walks two yards a second and pours within 60 yards of its middle.</p>
<div class="panel"><div class="row"><button id="play">Play</button><input id="t" type="range" min="0" max="1" step="1" value="0" aria-label="Time"><span class="now" id="now"></span></div>
<div class="key" id="key"></div></div>
<div class="panel"><canvas id="deck" height="150"></canvas></div>
<div class="panel"><canvas id="valley" height="420"></canvas></div>
<script>
const SKY=TIMELINE, PATH=STORMPATH, CELLS=VALLEYCELLS;
const COLORS={"fine":"#f2c94c","fog":"#9aa5b1","light snow":"#bfe3ff","snow":"#7fb3f0","heavy snow":"#3d7fd1","light slush":"#79d2c0","slush":"#2f9e8f"};
const key=document.getElementById("key");for(const k in COLORS){key.innerHTML+=`<span><i style="background:${COLORS[k]}"></i>${k}</span>`}
const t=document.getElementById("t");t.max=SKY.length-1;
const deck=document.getElementById("deck"),valley=document.getElementById("valley");
function size(c){const r=c.getBoundingClientRect();c.width=Math.round(r.width*devicePixelRatio);c.height=Math.round(parseFloat(c.getAttribute("height"))*devicePixelRatio)}
const cx=CELLS.map(c=>c[0]),cy=CELLS.map(c=>c[1]);const minX=Math.min(...cx),maxX=Math.max(...cx)+1,minY=Math.min(...cy),maxY=Math.max(...cy)+1;
function drawDeck(i){size(deck);const g=deck.getContext("2d"),W=deck.width,H=deck.height;g.clearRect(0,0,W,H);
 const n=SKY.length;for(let k=0;k<n;k++){const s=SKY[k],x=k/n*W,w=W/n+1,h=s.strength*(H-20);g.fillStyle=COLORS[s.kind]||"#888";g.globalAlpha=.25;g.fillRect(x,0,w,H-20);g.globalAlpha=1;g.fillRect(x,H-20-h,w,h)}
 g.fillStyle=getComputedStyle(document.body).color;g.fillRect(i/n*W,0,2*devicePixelRatio,H)}
// the valley drawn along its length: its x (the game's north) runs left to right
function drawValley(i){size(valley);const g=valley.getContext("2d"),W=valley.width,H=valley.height;g.clearRect(0,0,W,H);
 const sx=W/(maxX-minX),sy=H/(maxY-minY),s=Math.min(sx,sy*2.4),ox=(W-(maxX-minX)*s)/2;
 const P=(x,y)=>[ox+(x/50-minX)*s,(maxY-y/50)*(H/(maxY-minY))];
 const heat={};const until=SKY[i].s;for(const p of PATH){if(p.s>until)break;const k=Math.floor(p.x/50)+","+Math.floor(p.y/50);heat[k]=(heat[k]||0)+1}
 const most=Math.max(1,...Object.values(heat));
 for(const c of CELLS){const [x,y]=P(c[0]*50,(c[1]+1)*50);const h=heat[c[0]+","+c[1]]||0;g.fillStyle=h?`rgba(47,158,143,${.15+.75*h/most})`:"rgba(127,127,127,.25)";g.fillRect(x,y,s+.5,H/(maxY-minY)+.5)}
 let at=PATH[0];for(const p of PATH){if(p.s>until)break;at=p}
 const [px,py]=P(at.x,at.y);const r=60/50*s;g.beginPath();g.arc(px,py,r,0,7);g.fillStyle="rgba(40,60,120,.45)";g.fill();g.beginPath();g.arc(px,py,90/50*s,0,7);g.strokeStyle="rgba(40,60,120,.6)";g.stroke()}
function show(){const i=+t.value,s=SKY[i];document.getElementById("now").textContent=`${Math.floor(s.s/3600)}h ${String(Math.floor(s.s%3600/60)).padStart(2,"0")}m: ${s.kind}, ${Math.round(s.strength*100)}%`;drawDeck(i);drawValley(i)}
t.oninput=show;addEventListener("resize",show);let timer=null;
document.getElementById("play").onclick=e=>{if(timer){clearInterval(timer);timer=null;e.target.textContent="Play";return}e.target.textContent="Pause";timer=setInterval(()=>{t.value=(+t.value+1)%SKY.length;show()},50)};
// "#t=N" in the address opens the page at step N (a picture of a later moment)
const want=+(location.hash.match(/t=(\d+)/)||[])[1];if(want)t.value=Math.min(want,SKY.length-1);
show();
</script></main></body></html>
]==]
html = html:gsub("TIMELINE", function() return lines_to_array(timeline) end)
           :gsub("STORMPATH", function() return lines_to_array(path) end)
           :gsub("VALLEYCELLS", function() return "[" .. table.concat(cells, ",") .. "]" end)
           :gsub("SEED", tostring(seed)):gsub("HOURS", tostring(hours))
local f = io.open(out, "w") or error("cannot write " .. out)
f:write(html)
f:close()
print(string.format("%s: %d skies, %d storm places, %d valley cells", out, select(2, timeline:gsub("\n", "")), select(2, path:gsub("\n", "")), #cells))
-- }}}
