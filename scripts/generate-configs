#!/bin/bash
# generate-configs
# Generates server config files from .dist templates with credentials from secrets.conf
# Run this after installation or when secrets.conf changes

# {{{ set_dir
DIR="/home/ritz/games/azeroth-core/wow-chat-2026"
if [[ -n "$1" ]]; then
    DIR="$1"
fi
# }}}

# {{{ load_secrets
SECRETS_FILE="${DIR}/secrets.conf"
if [[ ! -f "${SECRETS_FILE}" ]]; then
    echo "ERROR: ${SECRETS_FILE} not found"
    echo "Copy secrets.conf.example to secrets.conf and fill in your credentials"
    exit 1
fi

source "${SECRETS_FILE}"

if [[ -z "${DB_USER}" || -z "${DB_PASS}" ]]; then
    echo "ERROR: DB_USER and DB_PASS must be set in secrets.conf"
    exit 1
fi

DB_HOST="${DB_HOST:-127.0.0.1}"
DB_PORT="${DB_PORT:-3307}"
# }}}

# {{{ paths
ETC_DIR="${DIR}/installed-files/etc"
MYSQL_DIR="${DIR}/mysql/installed-files"
SOURCE_DIR="${DIR}/source"
BUILD_DIR="${DIR}/build"
LOGS_DIR="${DIR}/logs"
DATA_DIR="${DIR}/data-files"
# }}}

# {{{ generate_authserver_conf
generate_authserver_conf() {
    local DIST="${ETC_DIR}/authserver.conf.dist"
    local CONF="${ETC_DIR}/authserver.conf"

    if [[ ! -f "${DIST}" ]]; then
        echo "SKIP: ${DIST} not found"
        return
    fi

    echo "Generating authserver.conf..."
    cp "${DIST}" "${CONF}"

    # Database connection
    sed -i "s|^LoginDatabaseInfo = .*|LoginDatabaseInfo = \"${DB_HOST};${DB_PORT};${DB_USER};${DB_PASS};acore_auth\"|" "${CONF}"

    # Paths
    sed -i "s|^SourceDirectory = .*|SourceDirectory = \"${SOURCE_DIR}\"|" "${CONF}"
    sed -i "s|^MySQLExecutable = .*|MySQLExecutable = \"${MYSQL_DIR}/bin/mysql\"|" "${CONF}"
    sed -i "s|^LogsDir = .*|LogsDir = \"${LOGS_DIR}\"|" "${CONF}"

    echo "  -> ${CONF}"
}
# }}}

# {{{ generate_worldserver_conf
generate_worldserver_conf() {
    local DIST="${ETC_DIR}/worldserver.conf.dist"
    local CONF="${ETC_DIR}/worldserver.conf"

    if [[ ! -f "${DIST}" ]]; then
        echo "SKIP: ${DIST} not found"
        return
    fi

    echo "Generating worldserver.conf..."
    cp "${DIST}" "${CONF}"

    # Database connections
    sed -i "s|^LoginDatabaseInfo     = .*|LoginDatabaseInfo     = \"${DB_HOST};${DB_PORT};${DB_USER};${DB_PASS};acore_auth\"|" "${CONF}"
    sed -i "s|^WorldDatabaseInfo     = .*|WorldDatabaseInfo     = \"${DB_HOST};${DB_PORT};${DB_USER};${DB_PASS};acore_world\"|" "${CONF}"
    sed -i "s|^CharacterDatabaseInfo = .*|CharacterDatabaseInfo = \"${DB_HOST};${DB_PORT};${DB_USER};${DB_PASS};acore_characters\"|" "${CONF}"

    # Paths
    sed -i "s|^DataDir = .*|DataDir = \"${DATA_DIR}\"|" "${CONF}"
    sed -i "s|^LogsDir = .*|LogsDir = \"${LOGS_DIR}\"|" "${CONF}"
    sed -i "s|^BuildDirectory = .*|BuildDirectory = \"${BUILD_DIR}\"|" "${CONF}"
    sed -i "s|^SourceDirectory = .*|SourceDirectory = \"${SOURCE_DIR}\"|" "${CONF}"
    sed -i "s|^MySQLExecutable = .*|MySQLExecutable = \"${MYSQL_DIR}/bin/mysql\"|" "${CONF}"

    echo "  -> ${CONF}"
}
# }}}

# {{{ generate_module_configs
generate_module_configs() {
    local MODULES_DIR="${ETC_DIR}/modules"

    if [[ ! -d "${MODULES_DIR}" ]]; then
        echo "SKIP: modules directory not found"
        return
    fi

    for DIST in "${MODULES_DIR}"/*.conf.dist; do
        if [[ -f "${DIST}" ]]; then
            local CONF="${DIST%.dist}"
            echo "Generating $(basename "${CONF}")..."
            cp "${DIST}" "${CONF}"
            echo "  -> ${CONF}"
        fi
    done
}
# }}}

# {{{ main
echo "=== Generating config files ==="
echo "Using credentials from: ${SECRETS_FILE}"
echo "DB: ${DB_USER}@${DB_HOST}:${DB_PORT}"
echo ""

mkdir -p "${LOGS_DIR}"

generate_authserver_conf
generate_worldserver_conf
generate_module_configs

echo ""
echo "Done. Config files generated in ${ETC_DIR}"
# }}}
