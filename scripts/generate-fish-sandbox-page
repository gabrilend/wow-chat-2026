#!/usr/bin/env luajit
-- generate-fish-sandbox-page - puts the sandbox's data into its page
-- (issue 617e16).
--
-- For a general audience: the fish-school sandbox is one web page that
-- opens straight from its file (no server), so its data (continents, zones
-- and fences, from scripts/generate-fish-sandbox-data) is written into it.
-- This joins the page's template (scripts/templates/fish-sandbox.html) and
-- the data file into docs/HTML/fish-sandbox.html.
--
-- Usage: scripts/generate-fish-sandbox-page [PROJECT_DIR]

local DIR      = arg[1] or "/mnt/kaun/wow-chat-2026"
local TEMPLATE = DIR .. "/scripts/templates/fish-sandbox.html"
local DATA     = DIR .. "/assets/fish-sandbox/sandbox-data.js"
local OUT      = DIR .. "/docs/HTML/fish-sandbox.html"

local function read(p)
    local f = io.open(p) or error("generate-fish-sandbox-page: cannot read " .. p .. (p == DATA and " (scripts/generate-fish-sandbox-data writes it)" or ""))
    local s = f:read("*a"); f:close(); return s
end
local page, data = read(TEMPLATE), read(DATA)
local note = "<!-- docs/HTML/fish-sandbox.html - GENERATED by scripts/generate-fish-sandbox-page from scripts/templates/fish-sandbox.html\n" ..
             "     and assets/fish-sandbox/sandbox-data.js (issue 617e16), so the sandbox opens from its file. Don't edit; run it again. -->"
local a, b = page:find("<!-- GENERATED_NOTE -->", 1, true)
page = page:sub(1, a - 1) .. note .. page:sub(b + 1)
a, b = page:find("/*SANDBOX_DATA*/", 1, true)
if not a then error("generate-fish-sandbox-page: the template has no /*SANDBOX_DATA*/ mark") end
page = page:sub(1, a - 1) .. data .. page:sub(b + 1)
local f = io.open(OUT, "w") or error("generate-fish-sandbox-page: cannot write " .. OUT)
f:write(page)
f:close()
print(("generate-fish-sandbox-page: %d bytes -> %s"):format(#page, OUT))
