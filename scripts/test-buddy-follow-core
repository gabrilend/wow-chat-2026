#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-follow-core
# profiles:   all
# priority:   10
# kind:       test
# about:      the following core holds to the owner's design: her offsets, the half circle along a bent track, nobody crossing, the 10-yard rest
# quick-test: yes
# ==== end of header ====
# test-buddy-follow-core - checks how buddies follow their owner (the
# following core, roam/buddy_follow_core.h) against the owner's design,
# with no server (issue 617e13).
#
# For a general audience: the owner drew how followers should walk: beside
# her track, side by side on a half circle 1 to 2 yards behind, and at
# rest until she walks more than 10 yards away, mingling now and then. The
# server's version of that is plain arithmetic, so this test builds it
# alone with the system compiler and puts it through the owner's own cases:
# her table of offsets, a straight track, a bend and a corner, a teleport,
# who takes which place, and the rest-or-follow rule with its one-in-ten
# mingling.
#
# Usage: scripts/test-buddy-follow-core [PROJECT_DIR]
# Builds into tmp/tmp/ (the executable tier). Exits non-zero when any
# check fails.

set -uo pipefail

# {{{ configuration
DIR="/mnt/kaun/wow-chat-2026"
[[ -n "${1:-}" ]] && DIR="$1"
CORE="${DIR}/patches/B036-mod-buddies/mod-buddies/src/roam"
SOURCE="${DIR}/tests/buddy-follow-core/follow-check.cpp"
EXEC_DIR="${DIR}/tmp/tmp"
BINARY="${EXEC_DIR}/buddy-follow-check"
# }}}

[[ -d "${DIR}/tmp" ]] || { echo "ERROR: ${DIR}/tmp missing (the project's link to /tmp/<project>)"; exit 1; }
mkdir -p "${EXEC_DIR}"

if ! g++ -std=c++17 -O2 -Wall -Wextra -Werror -I"${CORE}" "${SOURCE}" -o "${BINARY}"; then
    echo "test-buddy-follow-core: the following core did not build alone (above); nothing was checked"
    exit 1
fi
"${BINARY}"
# ==== footer of test-buddy-follow-core ====
# lines:      48
# ==== end of footer ====
