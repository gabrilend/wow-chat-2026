#!/usr/bin/env luajit

local DIR   = arg[1] or "/mnt/kaun/wow-chat-2026"
local DB    = arg[2] or "acore_world_release"
local MAPS  = DIR .. "/data-files/maps/"
local OUT   = DIR .. "/sql/basic/db_world.src/19-titan-jewelers.apply.sql"
local MYSQL = DIR .. "/mysql/installed-files/bin/mysql -h127.0.0.1 -P3307 -uritz -pmenardi -N --batch " .. DB

local SITES = {
    { site = "uldaman", query = "SELECT target_map, target_position_x, target_position_y, target_position_z, target_orientation FROM areatrigger_teleport WHERE ID = 288",
      out = 6, dir = nil,
      placed = { trader  = { 0, -6069.84, -2963.40, 209.78, 1.587 },
                 jeweler = { 0, -6070.53, -2947.52, 209.78, 4.779 } } },
    { site = "uldum",   query = "SELECT map, position_x, position_y, position_z, orientation FROM gameobject WHERE id = 142343 LIMIT 1",
      out = 7, dir = 0 },
    { site = "pylon_n", query = "SELECT map, position_x, position_y, position_z, orientation FROM gameobject WHERE id = 164955 LIMIT 1",
      out = 9, toward = { -6900, -1400 } },
    { site = "pylon_w", query = "SELECT map, position_x, position_y, position_z, orientation FROM gameobject WHERE id = 164956 LIMIT 1",
      out = 9, toward = { -6900, -1400 } },
    { site = "pylon_e", query = "SELECT map, position_x, position_y, position_z, orientation FROM gameobject WHERE id = 164957 LIMIT 1",
      out = 9, toward = { -6900, -1400 } },
}
local UNDER_ROCK = 5
local PAIR_GAP = 2
local GRID, RES = 533.3333, 128
local BEGIN_MARK = "-- >>> GENERATED by scripts/generate-basic-titan-jeweler-spots"
local END_MARK   = "-- <<< GENERATED END"

local function die(msg)
    io.stderr:write("generate-basic-titan-jeweler-spots: ", msg, "\n")
    os.exit(1)
end

local ffi = require("ffi")
local function u32(d, o) local a, b, c, e = d:byte(o + 1, o + 4); return a + b * 256 + c * 65536 + e * 16777216 end
local function u16(d, o) local a, b = d:byte(o + 1, o + 2); return a + b * 256 end
local function f32(d, o) local v = ffi.new("uint32_t[1]", u32(d, o)); return ffi.cast("float*", v)[0] end

local function ground(map, x, y)
    local gx, gy = math.floor(32 - x / GRID), math.floor(32 - y / GRID)
    local path = string.format("%s%03d%02d%02d.map", MAPS, map, gx, gy)
    local f = io.open(path, "rb") or die("no map tile " .. path)
    local d = f:read("*a")
    f:close()
    local off = u32(d, 20)
    local flags, base, top = u32(d, off + 4), f32(d, off + 8), f32(d, off + 12)
    if flags % 2 == 1 then return base end
    local int16, int8 = math.floor(flags / 2) % 2 == 1, math.floor(flags / 4) % 2 == 1
    local size = int16 and 2 or (int8 and 1 or 4)
    local v9, v8 = off + 16, off + 16 + 129 * 129 * size
    local function at(start, i)
        local o = start + i * size
        if int16 then return u16(d, o) elseif int8 then return d:byte(o + 1) else return f32(d, o) end
    end
    local fx, fy = RES * (32 - x / GRID), RES * (32 - y / GRID)
    local xi, yi = math.floor(fx), math.floor(fy)
    fx, fy = fx - xi, fy - yi
    xi, yi = xi % RES, yi % RES
    local h1, h2 = at(v9, xi * 129 + yi), at(v9, (xi + 1) * 129 + yi)
    local h3, h4 = at(v9, xi * 129 + yi + 1), at(v9, (xi + 1) * 129 + yi + 1)
    local h5 = 2 * at(v8, xi * 128 + yi)
    local a, b, c
    if fx + fy < 1 then
        if fx > fy then a, b, c = h2 - h1, h5 - h1 - h2, h1 else a, b, c = h5 - h1 - h3, h3 - h1, h1 end
    else
        if fx > fy then a, b, c = h2 + h4 - h5, h4 - h2, h5 - h4 else a, b, c = h4 - h3, h3 + h4 - h5, h5 - h4 end
    end
    local h = a * fx + b * fy + c
    if int16 then return h * (top - base) / 65535 + base end
    if int8 then return h * (top - base) / 255 + base end
    return h
end

local function landmark(query)
    local p = io.popen(MYSQL .. " -e \"" .. query .. "\" 2>&1")
    local out = p:read("*a")
    p:close()
    for line in out:gmatch("[^\n]+") do
        if not line:find("Using a password", 1, true) then
            if line:find("^ERROR") then die("database " .. DB .. ": " .. line) end
            local m, x, y, z, o = line:match("^(%d+)\t(%S+)\t(%S+)\t(%S+)\t(%S+)$")
            if m then return tonumber(m), tonumber(x), tonumber(y), tonumber(z), tonumber(o) end
        end
    end
    die("landmark not found: " .. query)
end

local rows, report = {}, {}
for _, s in ipairs(SITES) do
    local map, lx, ly, lz, lo = landmark(s.query)
    local dir = s.dir or lo
    if s.toward then dir = math.atan2(s.toward[2] - ly, s.toward[1] - lx) end
    local cx, cy = lx + s.out * math.cos(dir), ly + s.out * math.sin(dir)
    local face = (dir + math.pi) % (2 * math.pi)
    local side = dir + math.pi / 2
    local under_rock = math.abs(ground(map, lx, ly) - lz) > UNDER_ROCK
    for role, sgn in pairs({ trader = 1, jeweler = -1 }) do
        local x, y = cx + sgn * PAIR_GAP * math.cos(side), cy + sgn * PAIR_GAP * math.sin(side)
        local z = under_rock and lz or ground(map, x, y)
        local o = face
        if s.placed then map, x, y, z, o = unpack(s.placed[role]) end
        rows[#rows + 1] = string.format("('%s','%s',%d,%.2f,%.2f,%.2f,%.3f)", s.site, role, map, x, y, z, o)
    end
    report[#report + 1] = string.format("  %-8s landmark z %.1f, ground under it %.1f%s", s.site, lz, ground(map, lx, ly),
        under_rock and " (under rock: the pair uses the landmark's height)" or "")
end
table.sort(rows)
local block = table.concat({
    BEGIN_MARK .. " — do not edit by hand",
    "-- site, role (trader = crystal trader, jeweler = masterwork jewelcrafter), map, x, y, ground z, facing",
    "INSERT INTO `tmp_155p_spots` (`site`, `role`, `map`, `x`, `y`, `z`, `o`) VALUES " .. table.concat(rows, ",") .. ";",
    END_MARK }, "\n")
local f = io.open(OUT, "r") or die("cannot open " .. OUT)
local sql = f:read("*a")
f:close()
local a = sql:find(BEGIN_MARK, 1, true)
local b = sql:find(END_MARK, 1, true)
if not a or not b or b < a then die("markers not found in " .. OUT) end
sql = sql:sub(1, a - 1) .. block .. sql:sub(b + #END_MARK)
f = assert(io.open(OUT, "w"))
f:write(sql)
f:close()
io.write(table.concat(report, "\n"), "\n", string.format("wrote %d spots into %s\n", #rows, OUT))
