#!/usr/bin/env luajit
-- generate-ground-sandbox-page - builds the ground sandbox's page (issue
-- 617e16c), and with --screenshot photographs it and files the picture.
--
-- For a general audience: the ground sandbox is the fish-school sandbox's
-- flock set down on the world's real ground: hills shaded, ground too steep
-- to walk in red, trees, rocks and small buildings as dark marks the bots
-- steer round. One page that opens straight from its file; it reads each
-- zone's ground from a file beside it (docs/HTML/ground-sandbox/, written by
-- scripts/generate-ground-sandbox-data) when the zone is opened. This joins
-- the page's template, the sandbox's zones and fences (the same data as the
-- fish-school sandbox) and the heights' decoder into docs/HTML/ground-sandbox.html.
--
-- Usage: scripts/generate-ground-sandbox-page [PROJECT_DIR] [--screenshot SETTINGS]
--        scripts/generate-ground-sandbox-page --help
--   --screenshot SETTINGS: also photograph the page headless, driven by
--     SETTINGS (the page's address settings, e.g.
--     "continent=1&zone=The%20Barrens&theme=night%20sea&sim=120&fence=0&view=fence"),
--     and file the picture in development-history/ (scripts/file-screenshot)

local DIR, SHOT = "/mnt/kaun/wow-chat-2026", nil
local i = 1
while i <= #arg do
    local a = arg[i]
    if a == "--help" then
        print("generate-ground-sandbox-page [PROJECT_DIR] [--screenshot SETTINGS]: writes docs/HTML/ground-sandbox.html")
        print("  (issue 617e16c). --screenshot SETTINGS: photograph it with those address settings")
        print("  (continent=1&zone=The%20Barrens&sim=120&fence=0&view=fence&slope=50) and file the picture.")
        os.exit(0)
    elseif a == "--screenshot" then SHOT = arg[i + 1]; i = i + 2
    elseif a:sub(1, 2) == "--" then io.stderr:write("generate-ground-sandbox-page: unknown option " .. a .. "\n"); os.exit(1)
    else DIR = a; i = i + 1 end
end
if SHOT == "" then io.stderr:write("generate-ground-sandbox-page: --screenshot needs the page's settings\n"); os.exit(1) end

local TEMPLATE = DIR .. "/scripts/templates/ground-sandbox.html"
local DECODE   = DIR .. "/scripts/templates/ground-decode.js"
local DATA     = DIR .. "/assets/fish-sandbox/sandbox-data.js"
local OUT      = DIR .. "/docs/HTML/ground-sandbox.html"

local function read(p)
    local f = io.open(p)
    if not f then io.stderr:write("generate-ground-sandbox-page: cannot read " .. p .. (p == DATA and " (scripts/generate-fish-sandbox-data writes it)" or "") .. "\n"); os.exit(1) end
    local s = f:read("*a"); f:close(); return s
end
-- {{{ local function put
-- Puts `text` where the template's mark is; a missing mark stops the tool
-- (a template edited out of shape would otherwise make a page that half works).
local page = read(TEMPLATE)
local function put(mark, text)
    local a, b = page:find(mark, 1, true)
    if not a then io.stderr:write("generate-ground-sandbox-page: the template has no " .. mark .. " mark\n"); os.exit(1) end
    page = page:sub(1, a - 1) .. text .. page:sub(b + 1)
end
-- }}}
put("<!-- GENERATED_NOTE -->", "<!-- docs/HTML/ground-sandbox.html - GENERATED by scripts/generate-ground-sandbox-page from\n" ..
    "     scripts/templates/ground-sandbox.html, scripts/templates/ground-decode.js and assets/fish-sandbox/sandbox-data.js\n" ..
    "     (issue 617e16c); each zone's ground is read from ground-sandbox/ beside it. Don't edit; run it again. -->")
put("/*SANDBOX_DATA*/", read(DATA))
put("/*GROUND_DECODE*/", read(DECODE))
local f = assert(io.open(OUT, "w")); f:write(page); f:close()
local zones = 0
local h = io.popen("ls '" .. DIR .. "/docs/HTML/ground-sandbox/' 2>/dev/null")
for _ in h:lines() do zones = zones + 1 end
h:close()
print(("generate-ground-sandbox-page: %d bytes -> %s (%d zones' ground beside it)"):format(#page, OUT, zones))

-- {{{ --screenshot: photographed with the given settings, filed
if SHOT then
    local cmd = string.format("'%s/scripts/file-screenshot' --dir '%s' --name ground-sandbox --made %q"
        .. " --source scripts/templates/ground-sandbox.html --source scripts/templates/ground-decode.js"
        .. " --source scripts/generate-ground-sandbox-data --source scripts/generate-ground-sandbox-page"
        .. " --window 1600x900 --url 'file://%s#%s'",
        DIR, DIR, "scripts/generate-ground-sandbox-page --screenshot '" .. SHOT .. "'", OUT, SHOT)
    local r = os.execute(cmd)
    if r ~= true and r ~= 0 then io.stderr:write("generate-ground-sandbox-page: the page is written, but its picture was not filed\n"); os.exit(1) end
end
-- }}}
