#!/usr/bin/env luajit
-- generate-basic-outland-dungeons-sql - list the creatures each Outland
-- dungeon's server scripts name, and write that list into the basic profile's
-- Outland dungeon SQL (issue 155f).
--
-- For a general audience: the SQL that raises Outland dungeon creatures'
-- levels finds most of them by where they stand. Some never stand anywhere
-- until a boss fight summons them (adds, waves, a boss that appears on cue);
-- those are only named inside the dungeon's compiled script. This tool reads
-- each dungeon's script folder, collects every creature id the scripts name
-- (their NPC_, ENTRY_, CREATURE_ and MOB_ constants), and writes them as plain
-- data into the SQL file between two marker lines, tagged with the dungeon
-- they belong to, so each creature gets its own dungeon's level step.
-- Re-running replaces only that block. Ids that turn out not to be creatures
-- are filtered out by the SQL itself (it joins against creature templates).
--
-- Usage: scripts/generate-basic-outland-dungeons-sql [PROJECT_DIR]
--   Reads   source-beta/src/server/scripts/<dungeon folders below>
--   Writes  sql/basic/db_world.src/09-outland-dungeons-64.apply.sql and
--           sql/basic/db_world.src/16-outland-gear-scaling.apply.sql
--           (only the GENERATED block; the same list in both: the gear
--           scaler uses it to find the bosses a script summons)

local DIR     = arg[1] or "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local SCRIPTS = DIR .. "/source-beta/src/server/scripts/"
local OUTS    = { DIR .. "/sql/basic/db_world.src/09-outland-dungeons-64.apply.sql",
                  DIR .. "/sql/basic/db_world.src/16-outland-gear-scaling.apply.sql" }

-- {{{ configuration
-- dungeon map id -> its script folder (relative to SCRIPTS); the level
-- offsets live in the SQL's basic_155f_maps table, not here
local DUNGEONS = {
    { 543, "Outland/HellfireCitadel/HellfireRamparts" },
    { 542, "Outland/HellfireCitadel/BloodFurnace" },
    { 540, "Outland/HellfireCitadel/ShatteredHalls" },
    { 547, "Outland/CoilfangReservoir/SlavePens" },
    { 546, "Outland/CoilfangReservoir/underbog" },
    { 545, "Outland/CoilfangReservoir/SteamVault" },
    { 557, "Outland/Auchindoun/ManaTombs" },
    { 558, "Outland/Auchindoun/AuchenaiCrypts" },
    { 556, "Outland/Auchindoun/SethekkHalls" },
    { 555, "Outland/Auchindoun/ShadowLabyrinth" },
    { 554, "Outland/TempestKeep/Mechanar" },
    { 553, "Outland/TempestKeep/botanica" },
    { 552, "Outland/TempestKeep/arcatraz" },
    { 560, "Kalimdor/CavernsOfTime/EscapeFromDurnholdeKeep" },
    { 269, "Kalimdor/CavernsOfTime/TheBlackMorass" },
    { 585, "EasternKingdoms/MagistersTerrace" },
}
local BEGIN_MARK = "-- >>> GENERATED by scripts/generate-basic-outland-dungeons-sql"
local END_MARK   = "-- <<< GENERATED END"
-- }}}

-- {{{ local function die
local function die(msg)
    io.stderr:write("generate-basic-outland-dungeons-sql: ", msg, "\n")
    os.exit(1)
end
-- }}}

-- {{{ local function script_ids
-- Every creature-looking constant in one folder's .h/.cpp files. A folder
-- with no files is an error: a moved upstream folder would otherwise give
-- an empty list and silently leave that dungeon's summoned creatures stock.
local function script_ids(folder)
    local path = SCRIPTS .. folder
    local list = io.popen("find '" .. path .. "' -type f \\( -name '*.cpp' -o -name '*.h' \\) 2>/dev/null")
    local ids, nfiles = {}, 0
    for file in list:lines() do
        nfiles = nfiles + 1
        local f = assert(io.open(file, "r"))
        local text = f:read("*a")
        f:close()
        for prefix, id in text:gmatch("%f[%w_](%u+)_[%w_]*%s*=%s*(%d%d%d%d%d?%d?)") do
            if prefix == "NPC" or prefix == "ENTRY" or prefix == "CREATURE" or prefix == "MOB" then
                ids[tonumber(id)] = true
            end
        end
    end
    list:close()
    if nfiles == 0 then die("no script files under " .. path .. " (moved upstream?)") end
    local sorted = {}
    for id in pairs(ids) do sorted[#sorted + 1] = id end
    table.sort(sorted)
    return sorted
end
-- }}}

-- {{{ main
local lines = { BEGIN_MARK .. " — do not edit by hand",
                "INSERT INTO `tmp_155f_script_ids` (`entry`, `map_id`) VALUES" }
local rows, total = {}, 0
for _, d in ipairs(DUNGEONS) do
    local map, folder = d[1], d[2]
    local ids = script_ids(folder)
    local chunk = {}
    for _, id in ipairs(ids) do chunk[#chunk + 1] = string.format("(%d,%d)", id, map) end
    total = total + #ids
    if #chunk > 0 then
        rows[#rows + 1] = "  -- " .. folder .. " (" .. #ids .. ")\n  " .. table.concat(chunk, ",")
    end
    io.write(string.format("  %3d  %-48s %3d ids\n", map, folder, #ids))
end
lines[#lines + 1] = table.concat(rows, ",\n") .. ";"
lines[#lines + 1] = END_MARK
local block = table.concat(lines, "\n")

for _, OUT in ipairs(OUTS) do
    local f = io.open(OUT, "r") or die("cannot open " .. OUT)
    local sql = f:read("*a")
    f:close()
    local a = sql:find(BEGIN_MARK, 1, true)
    local b = sql:find(END_MARK, 1, true)
    if not a or not b or b < a then die("markers not found in " .. OUT) end
    sql = sql:sub(1, a - 1) .. block .. sql:sub(b + #END_MARK)
    f = assert(io.open(OUT, "w"))
    f:write(sql)
    f:close()
    io.write(string.format("wrote %d script-named ids into %s\n", total, OUT))
end
-- }}}
