#!/usr/bin/env luajit
--------------------------------------------------------------------------------
-- trace-completed-issues - does each finished issue still describe the
-- project, and what came after it?
--
-- For a general audience: a completed issue file is the blueprint of a
-- piece of the project as it was built. The project keeps moving: files
-- are renamed, folders split by profile, patches retired, and later
-- issues rework what an earlier one made. Nothing checked whether a
-- finished blueprint still points at real things, or whether a reader of
-- it would ever learn that a later issue changed the design. This tool
-- reads every completed issue and reports, for each:
--
--   paths     files and folders it names (src/..., scripts/..., docs/...)
--             that no longer exist, and, when a file of the same name
--             lives elsewhere now, where (a likely move)
--   patches   patch steps it names (B023, C006b, E042) that no longer
--             exist, or were retired
--   issues    issues it names that have no file anywhere
--   after     later issues that name it (the thread forward), and whether
--             it names them back (the thread backward); a completed issue
--             that later work refers to but that never mentions that work
--             is a thread with only one end tied. Because numbers were
--             reused, a mention counts only when its words match the
--             issue's name; others are listed as unconfirmed, or as a
--             reused number when they carry another issue's name
--   misfiled  issues still in issues/ whose status says completed
--
-- It changes nothing. It prints one line per issue and writes the whole
-- report as Markdown to tmp/shared-memory/trace-completed-issues.md.
--
-- Usage: scripts/trace-completed-issues [PROJECT_DIR] [--file ISSUE_PATH]
--   Exit 0 when nothing is out of date, 1 when something is (a warning,
--   not a failure: history is allowed to be old, but it should say so).
--------------------------------------------------------------------------------

local DIR, ONLY = "/mnt/mtwo/games/azeroth-core/wow-chat-2026", nil
do
    local k = 1
    while k <= #arg do
        if arg[k] == "--file" then ONLY = arg[k + 1]; k = k + 2
        else DIR = arg[k]; k = k + 1 end
    end
end
local ISSUES = DIR .. "/issues"
local OUT    = DIR .. "/tmp/shared-memory/trace-completed-issues.md"

-- {{{ local helpers
local function read(path)
    local f = io.open(path, "r")
    if not f then return nil end
    local d = f:read("*a")
    f:close()
    return d
end

local function lines_of(cmd)
    local p, out = io.popen(cmd), {}
    for l in p:lines() do out[#out + 1] = l end
    p:close()
    return out
end

-- An issue file's id: its leading number and letters ("617e4a" from
-- "617e4a-town-circles.md"); nil for files that aren't issues.
local function id_of(name)
    return name:match("^(%d+%w-)%-") or name:match("^(%d+%w*)$")
end
-- }}}

-- {{{ the project as it is today
-- Tracked files (git), so build trees and installs never count as "exists".
local tracked, by_base = {}, {}
for _, f in ipairs(lines_of("git -C '" .. DIR .. "' ls-files")) do
    tracked[f] = true
    local dir = f
    while true do
        dir = dir:match("^(.*)/[^/]+$")
        if not dir then break end
        tracked[dir] = true
    end
    local base = f:match("([^/]+)$")
    by_base[base] = by_base[base] or {}
    table.insert(by_base[base], f)
end

-- Every issue file anywhere under issues/ (open, completed, declined,
-- superseded, archived), by id. An id can have more than one file.
local issue_files, issue_where = {}, {}
for _, f in ipairs(lines_of("cd '" .. ISSUES .. "' && find . -type f | sort")) do
    local rel  = f:gsub("^%./", "")
    local name = rel:match("([^/]+)$")
    local id   = id_of(name)
    if id then
        issue_files[#issue_files + 1] = { id = id, rel = rel, name = name,
            completed = rel:match("^completed/[^/]+$") ~= nil }
        issue_where[id] = issue_where[id] or {}
        table.insert(issue_where[id], rel)
    end
end

-- Old numbers from the April renumbering (issues/MIGRATION_MAP.md, its
-- "| old | new | slug |" rows): an issue named by an old number that has
-- no file now is reported with its new number, not as missing.
local renumbered = {}
for old, new in (read(ISSUES .. "/MIGRATION_MAP.md") or ""):gmatch("\n| (%d+%l?) | (%d+%l?) | [%w%-]+ |") do
    renumbered[old] = renumbered[old] and (renumbered[old] .. " or " .. new) or new
end

-- Patch steps that exist: B in patches/ (".retired" in the name: retired),
-- C in config/patches/, E as "# E042:" headers in patches/E-patches.sh.
local patch_state = {}
for f in pairs(tracked) do
    local b = f:match("^patches/(B%d%d%d%a?)%-[^/]+$")
    if b then patch_state[b] = f:find("retired", 1, true) and "retired" or "live" end
    local c = f:match("^config/patches/(C%d%d%d%a?)[%-%._]")
    if c then patch_state[c] = "live" end
end
for e in (read(DIR .. "/patches/E-patches.sh") or ""):gmatch("\n# (E%d%d%d%a?):") do patch_state[e] = "live" end
-- }}}

-- {{{ reading one issue's references
local TOP = { src = true, scripts = true, patches = true, config = true, sql = true, docs = true,
              modules = true, tests = true, tools = true, notes = true, assets = true }

-- A path is skipped when a wildcard or placeholder follows or fills it
-- ("patches/B*.sh", "config/patches/C<n>"): first written without this,
-- "patches/B" was reported as a missing file.
local function paths_named(text)
    local found, seen = {}, {}
    for p, after in text:gmatch("([%w_%-%.]*/?[%w_%-%./]+)()") do
        local top  = p:match("^([%w_%-]+)/")
        local next = text:sub(after, after)
        if top and TOP[top] and not p:find("[<>%*{}]") and not next:find("[%*<{%$#]") then
            p = p:gsub("[%.,:;]+$", ""):gsub("/$", "")
            if not seen[p] and #p > #top + 1 then seen[p] = true; found[#found + 1] = p end
        end
    end
    return found
end

local function patches_named(text)
    local found, seen = {}, {}
    for p in text:gmatch("%f[%w]([BCE]%d%d%d%a?)%f[%W]") do
        if not seen[p] then seen[p] = true; found[#found + 1] = p end
    end
    return found
end

-- Issue ids named as issues: "issue 203", "issues 617e and 617f",
-- "(203)", "203-some-name", "**203**", or a link field's list. Bare
-- numbers in prose are not taken (years, counts, ports).
-- A candidate counts only if it is shaped like an issue id (3 or 4 digits,
-- then optionally a letter, digits, a letter: 617, 1004, 148s, 617e4a),
-- its phase is one the project has issues in, and it isn't a decade
-- ("the 100s"). First written without these, ports (3307), spell numbers
-- (45902) and document numbers (000, 009) were reported as missing issues.
local phases = {}
local function phase_of(id)
    local digits = id:match("^(%d+)")
    return #digits == 3 and digits:sub(1, 1) or digits:sub(1, 2)
end
for _, f in ipairs(issue_files) do phases[phase_of(f.id)] = true end
local function issue_shaped(id)
    if not (id:match("^%d%d%d%d?$") or id:match("^%d%d%d%d?%l$") or id:match("^%d%d%d%d?%l%d+%l?$")) then return false end
    if id:match("^%d+0s$") then return false end
    return phases[phase_of(id)] == true
end

local function issues_named(text)
    local found, seen = {}, {}
    local function add(id) if id and issue_shaped(id) and not seen[id] then seen[id] = true; found[#found + 1] = id end end
    for list in text:gmatch("[Ii]ssues? ([%d%w ,/&and]+)") do
        for id in list:gmatch("%f[%w](%d%d%d%d?%l?%d?%l?)%f[%W]") do add(id) end
    end
    for id in text:gmatch("%f[%w](%d%d%d%d?%l?%d?%l?)%-%l") do add(id) end
    for id in text:gmatch("%((%d%d%d%d?%l?%d?%l?)[%),]") do add(id) end
    for id in text:gmatch("%*%*(%d%d%d%d?%l?%d?%l?)%*%*") do add(id) end
    for field in text:gmatch("[Bb]locked by:?%**:?([^\n]*)") do for id in field:gmatch("%f[%w](%d%d%d%d?%l?%d?%l?)%f[%W]") do add(id) end end
    for field in text:gmatch("[Rr]elated:?%**:?([^\n]*)")    do for id in field:gmatch("%f[%w](%d%d%d%d?%l?%d?%l?)%f[%W]") do add(id) end end
    for field in text:gmatch("[Pp]arent:?%**:?([^\n]*)")     do for id in field:gmatch("%f[%w](%d%d%d%d?%l?%d?%l?)%f[%W]") do add(id) end end
    return found
end
-- }}}

-- {{{ the forward thread: who names whom
local texts, names = {}, {}
for _, f in ipairs(issue_files) do
    texts[f.rel] = read(ISSUES .. "/" .. f.rel) or ""
    local set = {}
    for _, id in ipairs(issues_named(texts[f.rel])) do set[id] = true end
    names[f.rel] = set
end
-- }}}

-- {{{ trace each completed issue
local report, stale_count, checked = {}, 0, 0
local function w(s) report[#report + 1] = s end
w("# Completed issues, traced against today's project")
w("")
w("Generated " .. os.date("!%Y-%m-%d %H:%M UTC") .. " by scripts/trace-completed-issues, which reads every")
w("completed issue and checks the files, patch steps and issues it names against the")
w("project as it is now, and lists the later issues that name it. Rerun it for current")
w("results; numbers here go stale.")
w("")

for _, f in ipairs(issue_files) do
    if f.completed and (not ONLY or ONLY:match("([^/]+)$") == f.name) then
        checked = checked + 1
        -- A "What Came After" section explains what moved and why; the old
        -- names in it are history on purpose, so only the text above it is
        -- checked for things that no longer exist
        local text = texts[f.rel]:match("^(.-)\n## What Came After") or texts[f.rel]
        local dead_paths, dead_patches, retired, dead_issues = {}, {}, {}, {}
        local after_note = texts[f.rel]:match("\n## What Came After(.*)$") or ""
        local explained = {}
        for _, p in ipairs(paths_named(text)) do
            local base = p:match("([^/]+)$")
            if not tracked[p] and (after_note:find(p, 1, true) or after_note:find(base, 1, true)) then
                explained[#explained + 1] = p
            elseif not tracked[p] then
                local base, moved = p:match("([^/]+)$"), nil
                if by_base[base] and #by_base[base] <= 3 then moved = table.concat(by_base[base], ", ") end
                dead_paths[#dead_paths + 1] = moved and (p .. " (now: " .. moved .. ")") or p
            end
        end
        for _, p in ipairs(patches_named(text)) do
            if not patch_state[p] then dead_patches[#dead_patches + 1] = p
            elseif patch_state[p] == "retired" then retired[#retired + 1] = p end
        end
        for _, id in ipairs(issues_named(text)) do
            if not issue_where[id] then
                dead_issues[#dead_issues + 1] = renumbered[id] and (id .. " (renumbered in April: now " .. renumbered[id] .. ")") or id
            end
        end
        -- The forward thread. Issue numbers were reused (the April
        -- renumbering, and duplicates like the two 142s), so a mention of
        -- the number alone may mean another issue: "307: narrator-audience-
        -- facing" in 909 is today's 908, not 307-ale-gameobject-wildcard.
        -- A mention counts as this issue when the line it is on, or the
        -- next, shares a word of five letters or more with this issue's
        -- name; one that shares none but carries another issue's name is a
        -- reused number; one with no name at all is unconfirmed.
        local words = {}
        for word in f.name:gsub("%.md$", ""):gmatch("%a+") do if #word >= 5 then words[word:lower()] = true end end
        local function about_this(g)
            local verdict, t = "unconfirmed", texts[g.rel]
            local lines = {}
            for l in (t .. "\n"):gmatch("([^\n]*)\n") do lines[#lines + 1] = l end
            for k, l in ipairs(lines) do
                if l:find("%f[%w]" .. f.id .. "%f[%W]") then
                    local near = (l .. " " .. (lines[k + 1] or "")):lower():gsub("%-", " ")
                    for word in pairs(words) do if near:find(word, 1, true) then return "this" end end
                    if near:find(f.id .. "[%s:%-%(]+%a%a%a%a%a") then verdict = "reused" end
                end
            end
            return verdict
        end
        local after, unanswered, unsure, reused = {}, {}, {}, {}
        for _, g in ipairs(issue_files) do
            if g.rel ~= f.rel and g.id ~= f.id and names[g.rel][f.id] then
                local v = about_this(g)
                if v == "this" then
                    after[#after + 1] = g.id
                    if not names[f.rel][g.id] then unanswered[#unanswered + 1] = g.id end
                elseif v == "reused" then reused[#reused + 1] = g.id
                else unsure[#unsure + 1] = g.id end
            end
        end
        table.sort(after); table.sort(unanswered); table.sort(unsure); table.sort(reused)

        local stale = #dead_paths + #dead_patches + #dead_issues
        if stale > 0 then stale_count = stale_count + 1 end
        print(string.format("%-40s paths %2d dead | patches %d gone %d retired | issues %d missing | named by %2d later (%2d not back, %d unsure, %d reused no.)",
            f.name:sub(1, 40), #dead_paths, #dead_patches, #retired, #dead_issues, #after, #unanswered, #unsure, #reused))

        w("## " .. f.name)
        w("")
        if stale == 0 and #retired == 0 then w("Every file, patch step and issue it names exists.") end
        if #dead_paths > 0   then w("- **Paths no longer in the project:** " .. table.concat(dead_paths, "; ")) end
        if #explained > 0    then w("- **Paths since moved or removed, explained under What Came After:** " .. table.concat(explained, "; ")) end
        if #dead_patches > 0 then w("- **Patch steps no longer in the project:** " .. table.concat(dead_patches, ", ")) end
        if #retired > 0      then w("- **Patch steps since retired:** " .. table.concat(retired, ", ")) end
        if #dead_issues > 0  then w("- **Issues named with no file:** " .. table.concat(dead_issues, ", ")) end
        if #after > 0        then w("- **Named by later issues:** " .. table.concat(after, ", ")) end
        if #unanswered > 0   then w("- **Of those, not named back here:** " .. table.concat(unanswered, ", ")) end
        if #unsure > 0       then w("- **Name its number without its name (unconfirmed):** " .. table.concat(unsure, ", ")) end
        if #reused > 0       then w("- **Use its number for another issue (a reused number):** " .. table.concat(reused, ", ")) end
        w("")
    end
end
-- }}}

-- {{{ finished, but filed as open
-- An issue in issues/ itself whose status line says it is completed was
-- finished and never moved, so none of the above traced it (found
-- 2026-10-17: the full 307 sat in issues/ while completed/ held its
-- pre-renumbering stub under the same name).
if not ONLY then
    local misfiled = {}
    for _, f in ipairs(issue_files) do
        if not f.rel:find("/", 1, true) then
            local head = texts[f.rel]:sub(1, 1500)
            if head:match("[Ss]tatus:?%**:?%s*[Cc]ompleted") or head:match("## Status:?%s*[Cc]ompleted") or head:match("[Ss]tatus%*%*:?%s*[Cc]ompleted") then
                local clash = false
                for _, g in ipairs(issue_files) do if g.completed and g.name == f.name then clash = true end end
                misfiled[#misfiled + 1] = f.name .. (clash and " (completed/ already has a file of this name)" or "")
            end
        end
    end
    if #misfiled > 0 then
        w("## Marked completed, still filed as open")
        w("")
        for _, m in ipairs(misfiled) do w("- " .. m) end
        w("")
        print(string.format("%d issues are marked completed but still in issues/: %s", #misfiled, table.concat(misfiled, "; ")))
    end
end
-- }}}

os.execute("mkdir -p '" .. DIR .. "/tmp/shared-memory'")
local out = assert(io.open(OUT, "w"))
out:write(table.concat(report, "\n"), "\n")
out:close()
if ONLY and checked == 0 then io.stderr:write("trace-completed-issues: no completed issue named ", ONLY, "\n"); os.exit(2) end
print(string.format("%d completed issues traced, %d name something no longer in the project; report: %s", checked, stale_count, OUT))
os.exit(stale_count > 0 and 1 or 0)
