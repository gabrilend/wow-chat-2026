#!/usr/bin/env luajit

local DIR, SHOT = "/mnt/kaun/wow-chat-2026", nil
local i = 1
while i <= #arg do
    local a = arg[i]
    if a == "--help" then
        print("generate-battleground-sandbox-page [PROJECT_DIR] [--screenshot SETTINGS]: writes docs/HTML/battleground-sandbox.html")
        print("  (issue 617e16l). --screenshot SETTINGS: photograph it with those address settings")
        print("  (sim=180&side=15) and file the picture in development-history/.")
        os.exit(0)
    elseif a == "--screenshot" then SHOT = arg[i + 1]; i = i + 2
    elseif a:sub(1, 2) == "--" then io.stderr:write("generate-battleground-sandbox-page: unknown option " .. a .. "\n"); os.exit(1)
    else DIR = a; i = i + 1 end
end
if SHOT == "" then io.stderr:write("generate-battleground-sandbox-page: --screenshot needs the page's settings\n"); os.exit(1) end

local TEMPLATE = DIR .. "/scripts/templates/battleground-sandbox.html"
local DECODE   = DIR .. "/scripts/templates/ground-decode.js"
local ROADS    = DIR .. "/src/lua-cc-test/data/arathi-basin-roads.lua"
local GROUND   = DIR .. "/docs/HTML/battleground-sandbox/zone-529-3358.js"
local OUT      = DIR .. "/docs/HTML/battleground-sandbox.html"

local function read(p, why)
    local f = io.open(p)
    if not f then io.stderr:write("generate-battleground-sandbox-page: cannot read " .. p .. (why or "") .. "\n"); os.exit(1) end
    local s = f:read("*a"); f:close(); return s
end
read(GROUND, " (scripts/generate-ground-sandbox-data --zone 529-3358 --out docs/HTML/battleground-sandbox writes it)")

local R = dofile(ROADS)
local function screen(p) return ("[%.1f,%.1f,%.1f]"):format(-p[2], -p[1], p[3]) end
local names = {}
for name in pairs(R.places) do names[#names + 1] = name end
table.sort(names)
local out = { "const BG = {\n  name: \"Arathi Basin\", map: 529, zone: 3358,\n  places: {\n" }
for _, name in ipairs(names) do
    out[#out + 1] = ("    %q: %s,\n"):format(name, screen(R.places[name]))
end
out[#out + 1] = "  },\n  roads: [\n"
for _, road in ipairs(R.roads) do
    if not R.places[road.from] or not R.places[road.to] then
        io.stderr:write(("generate-battleground-sandbox-page: road %s names a place not in the list (%s, %s)\n"):format(road.source, road.from, road.to)); os.exit(1)
    end
    local pts = {}
    for _, p in ipairs(road.points) do pts[#pts + 1] = screen(p) end
    out[#out + 1] = ("    { from: %q, to: %q, length: %.1f, pts: [%s] },\n"):format(road.from, road.to, road.length, table.concat(pts, ","))
end
out[#out + 1] = "  ],\n};\n"
local data = table.concat(out)

local page = read(TEMPLATE)
local function put(mark, text)
    local a, b = page:find(mark, 1, true)
    if not a then io.stderr:write("generate-battleground-sandbox-page: the template has no " .. mark .. " mark\n"); os.exit(1) end
    page = page:sub(1, a - 1) .. text .. page:sub(b + 1)
end
put("<!-- GENERATED_NOTE -->", "<!-- docs/HTML/battleground-sandbox.html - GENERATED by scripts/generate-battleground-sandbox-page from\n" ..
    "     scripts/templates/battleground-sandbox.html, scripts/templates/ground-decode.js and\n" ..
    "     src/lua-cc-test/data/arathi-basin-roads.lua (issue 617e16l); the ground is read from\n" ..
    "     battleground-sandbox/ beside it. Don't edit; run it again. -->")
put("/*BG_DATA*/", data)
put("/*GROUND_DECODE*/", read(DECODE))
local f = assert(io.open(OUT, "w")); f:write(page); f:close()
print(("generate-battleground-sandbox-page: %d bytes -> %s (%d places, %d roads)"):format(#page, OUT, #names, #R.roads))

do
    local check = DIR .. "/tmp/shared-memory/battleground-sandbox-parse.js"
    local cf = assert(io.open(check, "w"))
    cf:write([[
const s = require("fs").readFileSync(process.argv[2], "utf8"); let bad = 0;
[...s.matchAll(/<script>([\s\S]*?)<\/script>/g)].forEach((m, i) => {
  try { new Function(m[1]); } catch (e) { bad++; console.log(`generate-battleground-sandbox-page: the page's script ${i} doesn't parse: ${e.message}`); } });
process.exit(bad ? 1 : 0);
]])
    cf:close()
    local r = os.execute(("node '%s' '%s'"):format(check, OUT))
    if r ~= true and r ~= 0 then io.stderr:write("generate-battleground-sandbox-page: the page is written but broken (above); no picture taken\n"); os.exit(1) end
end

if SHOT then
    local cmd = string.format("'%s/scripts/file-screenshot' --dir '%s' --name battleground-sandbox --made %q"
        .. " --source scripts/templates/battleground-sandbox.html --source scripts/templates/ground-decode.js"
        .. " --source scripts/generate-battleground-sandbox-page --source src/lua-cc-test/data/arathi-basin-roads.lua"
        .. " --window 1600x900 --url 'file://%s#%s'",
        DIR, DIR, "scripts/generate-battleground-sandbox-page --screenshot '" .. SHOT .. "'", OUT, SHOT)
    local r = os.execute(cmd)
    if r ~= true and r ~= 0 then io.stderr:write("generate-battleground-sandbox-page: the page is written, but its picture was not filed\n"); os.exit(1) end
end
