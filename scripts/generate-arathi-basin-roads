#!/usr/bin/env luajit
--------------------------------------------------------------------------------
-- generate-arathi-basin-roads - Arathi Basin's roads as data, from the
-- playerbots module's own hand-placed paths
--
-- For a general audience: the bot module walks its bots round Arathi Basin
-- along 15 roads it has written out point by point: each home base to the
-- Stables or Farm, the Gold Mine and the Lumber Mill, and the five bases to
-- each other. The cc-test profile's Arathi Basin scene (issue 176a2c) sends
-- its stand-ins along the same roads by its own rule, so this copies them
-- into a Lua data file the scene's scripts read. The river path is not
-- among them, on purpose.
--
-- Read from the module's committed source (git HEAD), not its working
-- tree, which a build's patches may have edited. Each path's name says
-- which two places it joins ("AllianceBase_to_Stables"); every place's
-- path ends must lie close together, or nothing is written.
--
-- Homes are named by where they are, not by faction, since each match
-- draws which side starts where (176a2a): Trollbane Hall, the north-west
-- home (the bot module's "AllianceBase"), and the Defiler's Den, the
-- south-east home ("HordeBase").
--
-- Writes src/lua-cc-test/data/arathi-basin-roads.lua.
-- Usage: scripts/generate-arathi-basin-roads [PROJECT_DIR]
--------------------------------------------------------------------------------

local DIR = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end

local MODULE = DIR .. "/source-beta/modules/mod-playerbots"
local SOURCE = "src/Ai/Base/Actions/BattleGroundTactics.cpp"
local OUT    = DIR .. "/src/lua-cc-test/data/arathi-basin-roads.lua"
local ENDS_WITHIN = 60                              -- yards: a place's path ends lie this close to their middle. A base is an area ~50 yards across (the Blacksmith's ends spread 50, the Farm's 43); a path read the wrong way round or named for the wrong place misses by hundreds

-- the bot module's names -> ours
local PLACE = {
    AllianceBase = "north-west home", HordeBase = "south-east home",
    Stables = "Stables", Stable = "Stables", Blacksmith = "Blacksmith", Farm = "Farm",
    GoldMine = "Gold Mine", LumberMill = "Lumber Mill",
}

-- {{{ read the source
local h = io.popen("git -C '" .. MODULE .. "' show HEAD:" .. SOURCE)
local text = h:read("*a")
local ok = h:close()
if not ok or #text == 0 then
    io.stderr:write("ERROR: could not read " .. SOURCE .. " at HEAD in " .. MODULE .. " (is mod-playerbots cloned?)\n")
    os.exit(1)
end
local commit = io.popen("git -C '" .. MODULE .. "' rev-parse --short HEAD"):read("*l")
-- }}}

-- {{{ the paths
local roads = {}
for a, b, body in text:gmatch("BattleBotPath%s+vPath_AB_(%w+)_to_(%w+)%s*=%s*(%b{})") do
    if not PLACE[a] or not PLACE[b] then
        io.stderr:write("ERROR: path vPath_AB_" .. a .. "_to_" .. b .. " names a place this script doesn't know\n")
        os.exit(1)
    end
    local points = {}
    for x, y, z in body:gmatch("{%s*(%-?[%d%.]+)f?%s*,%s*(%-?[%d%.]+)f?%s*,%s*(%-?[%d%.]+)f?%s*,") do
        points[#points + 1] = { tonumber(x), tonumber(y), tonumber(z) }
    end
    local length = 0
    for i = 2, #points do
        local p, q = points[i - 1], points[i]
        length = length + math.sqrt((q[1] - p[1]) ^ 2 + (q[2] - p[2]) ^ 2 + (q[3] - p[3]) ^ 2)
    end
    roads[#roads + 1] = { from = PLACE[a], to = PLACE[b], points = points, length = length, source = "vPath_AB_" .. a .. "_to_" .. b }
end
if #roads ~= 15 then
    io.stderr:write("ERROR: found " .. #roads .. " Arathi Basin paths, expected 15 (did the module's paths change?)\n")
    os.exit(1)
end
-- }}}

-- {{{ each place: its middle, from every path end there; the ends must agree
local ends = {}
for _, r in ipairs(roads) do
    ends[r.from] = ends[r.from] or {}; table.insert(ends[r.from], r.points[1])
    ends[r.to]   = ends[r.to]   or {}; table.insert(ends[r.to],   r.points[#r.points])
end
local places, problems = {}, {}
for name, list in pairs(ends) do
    local mx, my, mz = 0, 0, 0
    for _, p in ipairs(list) do mx, my, mz = mx + p[1], my + p[2], mz + p[3] end
    mx, my, mz = mx / #list, my / #list, mz / #list
    for _, p in ipairs(list) do
        local d = math.sqrt((p[1] - mx) ^ 2 + (p[2] - my) ^ 2)
        if d > ENDS_WITHIN then problems[#problems + 1] = string.format("%s: a path end %.0f yards from the others' middle", name, d) end
    end
    places[name] = { mx, my, mz, ends = #list }
end
if #problems > 0 then
    io.stderr:write("ERROR: the paths' ends don't meet; nothing written:\n  " .. table.concat(problems, "\n  ") .. "\n")
    os.exit(1)
end
-- }}}

-- {{{ write
table.sort(roads, function(a, b) return a.source < b.source end)
local out = {}
local function w(s) out[#out + 1] = s end
w("-- GENERATED by scripts/generate-arathi-basin-roads from mod-playerbots " .. commit .. " (" .. SOURCE .. ", the vPath_AB_* paths);")
w("-- don't edit by hand: run the script again. Why: the cc-test Arathi Basin scene's stand-ins walk these")
w("-- roads by their own rule (issue 176a2c); homes are named by place, since each match draws its sides.")
w("return {")
w("    places = {   -- each place's middle, from the path ends that meet there (x, y, z)")
local names = {}
for n in pairs(places) do names[#names + 1] = n end
table.sort(names)
for _, n in ipairs(names) do
    local p = places[n]
    w(string.format('        [%q] = { %.2f, %.2f, %.2f },   -- %d path ends', n, p[1], p[2], p[3], p.ends))
end
w("    },")
w("    roads = {    -- from, to, length in yards, the points in order from 'from' to 'to'")
for _, r in ipairs(roads) do
    local pts = {}
    for _, p in ipairs(r.points) do pts[#pts + 1] = string.format("{ %.2f, %.2f, %.2f }", p[1], p[2], p[3]) end
    w(string.format("        { from = %q, to = %q, length = %.1f, source = %q,", r.from, r.to, r.length, r.source))
    w("          points = { " .. table.concat(pts, ", ") .. " } },")
end
w("    },")
w("}")
os.execute("mkdir -p '" .. DIR .. "/src/lua-cc-test/data'")
local f = assert(io.open(OUT, "w"))
f:write(table.concat(out, "\n"), "\n")
f:close()
print(string.format("%s: %d roads between %d places", OUT:sub(#DIR + 2), #roads, #names))
-- }}}
