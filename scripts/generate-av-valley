#!/usr/bin/env luajit
-- generate-av-valley - writes Alterac Valley's ground as cells, for the
-- wandering storm (issue 921b), from the battleground's own known places.
--
-- For a general audience: the storm must never leave the valley, so it
-- needs to know where the valley is. The server's Alterac Valley code
-- lists about nine hundred places (graveyards, towers, creatures, spawn
-- points), all in the valley. This tool reads them out of that code, marks
-- the 50-yard cell of each and its neighbours as valley, and writes the
-- cells as a header the buddy module compiles in. Nothing is typed by hand.
--
-- Usage: scripts/generate-av-valley [DIR] [--out PATH]
--   DIR         the project root (default the hard-coded one below)
--   --out PATH  the header (default DIR/patches/B036-mod-buddies/mod-buddies/src/buddies_av_valley_data.h)
--   --help      this text
-- Reads source-beta/src/server/game/Battlegrounds/Zones/BattlegroundAV.h

local DIR = "/mnt/kaun/wow-chat-2026"

-- {{{ arguments
local out
do
    local i = 1
    while i <= #arg do
        local a = arg[i]
        if a == "--help" or a == "-h" then
            for line in io.lines(arg[0]) do
                if not line:match("^%-%-") and not line:match("^#!") then break end
                print((line:gsub("^%-%- ?", "")))
            end
            os.exit(0)
        elseif a == "--out" then out = arg[i + 1]; i = i + 1
        elseif a:sub(1, 2) ~= "--" then DIR = a
        else error("unknown option " .. a .. " (see --help)") end
        i = i + 1
    end
end
out = out or (DIR .. "/patches/B036-mod-buddies/mod-buddies/src/buddies_av_valley_data.h")
-- }}}

-- the cell size and the neighbourhood must match buddies_weather_storm.h
-- (CELL 50 yards, NEAR_CELLS 1)
local CELL, NEAR = 50, 1
local src = DIR .. "/source-beta/src/server/game/Battlegrounds/Zones/BattlegroundAV.h"
local f = io.open(src) or error("cannot read " .. src)
local text = f:read("*a")
f:close()

-- every {x, y, z ...} position in the file
local cells, places = {}, 0
for x, y in text:gmatch("{%s*(%-?%d+%.%d+)f?%s*,%s*(%-?%d+%.%d+)f?%s*,%s*%-?%d+%.%d+") do
    places = places + 1
    local cx, cy = math.floor(tonumber(x) / CELL), math.floor(tonumber(y) / CELL)
    for dx = -NEAR, NEAR do
        for dy = -NEAR, NEAR do cells[(cx + dx) .. "," .. (cy + dy)] = { cx + dx, cy + dy } end
    end
end
if places < 100 then error("only " .. places .. " places found in " .. src .. ": its layout has changed") end
local list = {}
for _, c in pairs(cells) do list[#list + 1] = c end
table.sort(list, function(a, b) return a[1] < b[1] or (a[1] == b[1] and a[2] < b[2]) end)
local rows = {}
for _, c in ipairs(list) do rows[#rows + 1] = string.format("{ %d, %d }", c[1], c[2]) end

local o = io.open(out, "w") or error("cannot write " .. out)
o:write("// buddies_av_valley_data.h - GENERATED by scripts/generate-av-valley from BattlegroundAV.h's ",
    places, " known places,\n// so the wandering storm (issue 921b) knows where the valley is; don't edit, run it again.\n",
    "#ifndef MOD_BUDDIES_AV_VALLEY_DATA_H\n#define MOD_BUDDIES_AV_VALLEY_DATA_H\n\n",
    "// Alterac Valley's cells, ", CELL, " yards a side (cell x, cell y: the floor of a position over ", CELL, ")\n",
    "static int const AV_VALLEY_CELLS[][2] = {\n    ")
for i, r in ipairs(rows) do
    o:write(r, i < #rows and "," or "", i % 8 == 0 and "\n    " or " ")
end
o:write("\n};\n\n#endif\n")
o:close()
print(string.format("%d places, %d valley cells -> %s", places, #list, out))
