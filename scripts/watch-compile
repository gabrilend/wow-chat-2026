#!/bin/bash

DIR="/mnt/kaun/wow-chat-2026"
PROFILE=""
AFTER=$(date +%s)
MAX_MINUTES=300
while [[ $# -gt 0 ]]; do
    case "$1" in
        --profile) PROFILE="$2"; shift 2 ;;
        --after)   AFTER="$2"; shift 2 ;;
        --max)     MAX_MINUTES="$2"; shift 2 ;;
        -*)        echo "watch-compile: unknown option $1" >&2; exit 2 ;;
        *)         DIR="$1"; shift ;;
    esac
done
[[ -n "${PROFILE}" ]] || PROFILE="$(cat "${DIR}/.profile")"

RECEIPT="${DIR}/tmp/shared-memory/compile-${PROFILE}.goodbye"
RUN_LOG="${DIR}/tmp/shared-memory/compile-${PROFILE}.log"
TRIAL_LOG="${DIR}/tmp/shadow-validation-${PROFILE}.log"
DEADLINE=$(( $(date +%s) + MAX_MINUTES * 60 ))

wait_for() {
    while ! eval "$1"; do
        [[ $(date +%s) -lt ${DEADLINE} ]] || return 1
        sleep 30
    done
}

warnings() {
    [[ -f "${TRIAL_LOG}" ]] || return 0
    sed 's/\x1b\[[0-9;]*m//g' "${TRIAL_LOG}" | grep -n -i -E "missing in your update directory|warn|error|could not|failed" |
        grep -v -i "Can't set process priority" | head -40
}

verdict() {
    local word=$1 why=$2
    echo "${word}: ${why}"
    echo "--- receipt (${RECEIPT#${DIR}/}):"
    sed 's/^/  /' "${RECEIPT}" 2>/dev/null
    local w; w="$(warnings)"
    if [[ -n "${w}" ]]; then
        echo "--- the trial server's warnings (${TRIAL_LOG#${DIR}/}):"
        echo "${w}" | sed 's/^/  /'
    else
        echo "--- the trial server printed no warnings"
    fi
    if [[ "${word}" != "SUCCEEDED" ]]; then
        echo "--- the run log's last 25 lines (${RUN_LOG#${DIR}/}):"
        sed 's/\x1b\[[0-9;]*m//g' "${RUN_LOG}" 2>/dev/null | tail -25 | sed 's/^/  /'
    fi
}

echo "watch-compile: ${PROFILE}, waiting for a receipt after $(date -d @"${AFTER}" '+%H:%M:%S') (${RECEIPT#${DIR}/})"
wait_for '[[ -f "${RECEIPT}" && $(stat -c %Y "${RECEIPT}") -ge ${AFTER} ]]' ||
    { echo "GAVE UP: no receipt within ${MAX_MINUTES} minutes"; exit 2; }

if ! grep -q "^verdict: *compiled\|^verdict: *succeeded" "${RECEIPT}"; then
    verdict FAILED "the compile itself failed"
    exit 1
fi

if grep -q "^verdict: *compiled" "${RECEIPT}"; then
    wait_for 'grep -q -E "Promotion complete|ERROR:|Validation timeout" "${RUN_LOG}"' ||
        { verdict FAILED "validation or promotion did not finish within ${MAX_MINUTES} minutes"; exit 2; }
    sleep 5   # the run log is written through a pipe; let its last lines arrive
fi

if ! grep -q "World initialized in" "${TRIAL_LOG}" 2>/dev/null; then
    verdict FAILED "the trial server never said \"World initialized\""
    exit 1
fi
if ! grep -q "Promotion complete" "${RUN_LOG}" 2>/dev/null; then
    verdict FAILED "the build was not promoted"
    exit 1
fi
verdict SUCCEEDED "compiled, the trial server started (\"World initialized\"), and the build was promoted"
exit 0
