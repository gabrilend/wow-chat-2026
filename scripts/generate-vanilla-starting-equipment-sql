#!/usr/bin/env bash
# generate-vanilla-starting-equipment-sql
#
# What it does:
#   Emits sql/vanilla/db_world.src/02-starting-equipment.apply.sql — the
#   migration that issues every newly-created vanilla character a
#   level-20-appropriate white-quality starter kit (148h, redesigned
#   2026-06-12 with thematic-curation philosophy + item cloning).
#   Applied by the existing E009 patch in E-patches.sh.
#
# Why it exists:
#   The 52-combo (race × class) kit matrix locked down on 2026-06-12 plus
#   the per-combo weapon-skill grants would be ~570 INSERT rows if hand-
#   typed. This script holds the matrix as data and stamps the SQL
#   deterministically. Re-run after any matrix change; commit both this
#   script and its output.
#
# Idempotence:
#   Every INSERT row carries a Note='vanilla-148h-<...>' tag. The SQL
#   begins with `DELETE WHERE Note LIKE 'vanilla-148h-%'` on each
#   affected table so re-applying leaves the same state without
#   touching unrelated playercreateinfo_item / _skills rows.
#
# Entry IDs:
#   References the ORIGINAL, canonical item entries — the same numbers
#   Wowhead lists. Between 2026-06-12 and 2026-08-07 this script emitted
#   cloned IDs (original + 2000000) instead; that design is reversed per
#   148v, because an entry no client has ever cached renders as an
#   invisible model with a red "?" icon and there is no server-side way
#   to fix it. Canonical entries every client already knows are correct
#   by construction.
#
#   The level-20 tuning those clones used to carry is now applied in
#   place to these same originals by the E018 patch
#   (06-kit-required-level-cap). That patch and this migration touch
#   different tables — item_template versus playercreateinfo_item — so
#   they no longer have an ordering dependency between them the way the
#   clone design did.

set -euo pipefail

# {{{ resolve_dir
DIR="/mnt/mtwo/games/azeroth-core/wow-chat-2026"
if [[ -n "${1:-}" && -d "${1:-}" ]]; then
    DIR="$1"
fi
OUT="${DIR}/sql/vanilla/db_world.src/02-starting-equipment.apply.sql"
# }}}

# {{{ armor_sets
# Six visible-armor pieces a class wears as its base kit. Picks reference
# canonical item entries; the E018 patch tunes these same entries in
# place per 148v.
# Helmets and shoulders deliberately omitted per 148h's "clean
# silhouette at start" rule.
declare -A MAIL=(
    [chest]=2153 [legs]=2152 [hands]=2151
    [feet]=2149  [waist]=2148 [wrist]=2150
)
declare -A LEATHER=(
    [chest]=2141 [legs]=2146 [hands]=2145
    [feet]=2143  [waist]=2142 [wrist]=2144
)
declare -A CLOTH=(
    [chest]=2160 [legs]=2159 [hands]=2158
    [feet]=2156  [waist]=3591 [wrist]=3592
)
# Universal cape: Rugged Cape (2240).
CAPE=2240
# }}}

# {{{ class_armor
# Class ID → armor set. Warrior/Paladin have mail proficiency at L1.
# Hunter/Shaman wait on mail until 40; at L20 start they wear leather.
# Rogue/Druid leather; the cloth trio cloth.
declare -A CLASS_ARMOR=(
    [1]=MAIL     [2]=MAIL     [3]=LEATHER  [4]=LEATHER  [5]=CLOTH
    [7]=LEATHER  [8]=CLOTH    [9]=CLOTH    [11]=LEATHER
)
# }}}

# {{{ universal_items
# Linen Bag (4238): three of these in every kit. White,
# RequiredLevel 0, AllowableClass=-1.
LINEN_BAG=4238
LINEN_COUNT=3

# Hearthstone (6948) in every kit. Bind point set by the
# ALE auto-equip script (148k) on first login to the character's race's
# spawn town per 148n.
HEARTHSTONE=6948
# }}}

# {{{ race_class_kit
# Per-(race, class) explicit weapon/offhand/ranged/relic kit. All 52
