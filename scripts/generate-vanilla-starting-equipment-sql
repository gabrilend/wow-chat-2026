#!/usr/bin/env luajit
-- generate-vanilla-starting-equipment-sql
--
-- What it does: writes sql/vanilla/db_world.src/02-starting-equipment.apply.sql,
-- the rows that give every new vanilla character its level-20 starter kit
-- (issue 148h). Applied by install step E009.
--
-- How: the kit itself is a gearset profile (issue 617r),
-- src/lua-basic/data/gearsets/vanilla-starter.lua: for each class and race,
-- the item in each equipment slot, the bags, the ammunition. This turns
-- each record into rows of the game's "items a new character gets" table
-- (playercreateinfo_item: race, class, item, amount, note), joining the
-- same item in two slots into one row of two (a dual-wield pair) and the
-- same bag three times into one row of three, and adds the hearthstone
-- every character gets. Until 2026-10-05 the kit was a matrix inside this
-- script (bash); it moved into the profile so one gear system serves
-- buddies, players, stand-ins and the starter kit alike. The rows it
-- writes give every race and class the same items as before
-- (scripts/test-gearsets checks that against the last bash output).
--
-- Notes on each row start "vanilla-148h-", which the SQL's first step
-- deletes by, so re-applying never doubles a kit.
--
-- Usage: scripts/generate-vanilla-starting-equipment-sql [PROJECT_DIR] [--stdout]

-- {{{ configuration
local DIR, STDOUT = "/mnt/mtwo/games/azeroth-core/wow-chat-2026", false
for _, a in ipairs(arg) do
    if a == "--stdout" then STDOUT = true elseif a ~= "" then DIR = a end
end
local PROFILE = DIR .. "/src/lua-basic/data/gearsets/vanilla-starter.lua"
local OUT     = DIR .. "/sql/vanilla/db_world.src/02-starting-equipment.apply.sql"
local HEARTHSTONE = 6948
local CLASS = { [1] = "warrior", [2] = "paladin", [3] = "hunter", [4] = "rogue", [5] = "priest",
                [7] = "shaman", [8] = "mage", [9] = "warlock", [11] = "druid" }
local SLOT  = { [0] = "head", "neck", "shoulders", "shirt", "chest", "waist", "legs", "feet", "wrist",
                "hands", "finger", "finger", "trinket", "trinket", "cape", "mainhand", "offhand", "ranged" }
-- }}}

-- {{{ header
local HEADER = [[
-- MARKER_E009_APPLY vanilla-starting-equipment
-- AUTOGENERATED by scripts/generate-vanilla-starting-equipment-sql from the
-- gearset profile src/lua-basic/data/gearsets/vanilla-starter.lua.
-- Do not edit by hand: change the profile and re-run.
--
-- Apply-form SOURCE for E009. The E-patch cp's this file to
-- sql/vanilla/db_world/02-starting-equipment.sql, which AC's
-- UpdateFetcher picks up on next worldserver boot.
--
-- Purpose: equip every newly-created vanilla character (level-20 start
-- per C007c) with a full white-quality, race-and-class-appropriate
-- starter kit per the 148h thematic-curation design. References the
-- canonical item entries, which the E018 patch tunes in place to
-- RequiredLevel 20 and level-appropriate damage (148v reversal of the
-- clone design: a cloned entry no client has cached renders as an
-- invisible model with a red "?" icon).
--
-- Idempotent: re-running deletes prior vanilla-148h rows by Note prefix
-- and re-inserts. Default shirt/pants/quest-starter rows untouched.
--
-- Dual Wield dependency: dual-wield kits need spell 674 "Dual Wield"
-- granted before the off-hand can equip. 148j grants every level-20
-- trainer spell at creation, including Dual Wield.
--
-- Cross-references:
--   issues/148h-class-specific-starting-equipment.md  -- behavior spec
--   issues/148j-pretrain-level-20-abilities.md        -- DW dependency
--   issues/148k-ale-auto-equip-starter-kit.md         -- equip hook
--   issues/617r-elite-outfits.md                      -- gearset profiles
--   sql/vanilla/db_world.src/06-kit-required-level-cap.apply.sql  -- in-place tuning

START TRANSACTION;

-- {{{ idempotence_clear
DELETE FROM playercreateinfo_item
 WHERE Note LIKE 'vanilla-148h-%'
    OR Note = 'vanilla starter kit';

DELETE FROM playercreateinfo_skills
 WHERE comment LIKE 'vanilla-148h-%'
    OR comment LIKE 'vanilla starter %';
-- }}}
]]
-- }}}

-- {{{ local function rows_for
-- One record's rows, in a fixed order: slots 0-17, then bags, then ammo,
-- then the hearthstone. The same item in several slots (a dual-wield pair)
-- or several times among the bags becomes one row with that amount, at the
-- place of its first appearance.
local function rows_for(rec)
    local rows, at = {}, {}
    local function add(item, amount, label)
        if at[item] then
            rows[at[item]].amount = rows[at[item]].amount + amount
            rows[at[item]].label  = label == "offhand" and "dualwield" or rows[at[item]].label
        else
            rows[#rows + 1] = { item = item, amount = amount, label = label }
            at[item] = #rows
        end
    end
    for slot = 0, 17 do
        if rec.items[slot] then add(rec.items[slot], 1, SLOT[slot]) end
    end
    for _, bag in ipairs(rec.bags or {}) do add(bag, 1, "bag") end
    if rec.ammo then add(rec.ammo.item, rec.ammo.count, "ammo") end
    add(HEARTHSTONE, 1, "hearthstone")
    return rows
end
-- }}}

local profile = dofile(PROFILE)
if profile.keyed_by ~= "class" then error(PROFILE .. ": the starter kit must be keyed by class (a new character has no spec)") end

local out = { HEADER, "-- {{{ playercreateinfo_item: per (race, class) starter kit" }
local classes, total, combos = {}, 0, 0
for class in pairs(profile.records) do classes[#classes + 1] = class end
table.sort(classes)
for _, class in ipairs(classes) do
    out[#out + 1] = string.format("\n-- %s (class %d)", CLASS[class] or ("class " .. class), class)
    local races = {}
    for race in pairs(profile.records[class]) do races[#races + 1] = race end
    table.sort(races)
    for _, race in ipairs(races) do
        combos = combos + 1
        for _, r in ipairs(rows_for(profile.records[class][race])) do
            out[#out + 1] = string.format(
                "INSERT INTO playercreateinfo_item (race, class, itemid, amount, Note) VALUES (%d, %d, %d, %d, 'vanilla-148h-%s');",
                race, class, r.item, r.amount, r.label)
            total = total + 1
        end
    end
end
out[#out + 1] = "-- }}}\n\nCOMMIT;\n"
local text = table.concat(out, "\n")

if STDOUT then
    io.write(text)
else
    local f = assert(io.open(OUT, "w"))
    f:write(text)
    f:close()
    print("Wrote " .. OUT)
    print(string.format("  %d item rows\n  %d (race, class) combos", total, combos))
end
