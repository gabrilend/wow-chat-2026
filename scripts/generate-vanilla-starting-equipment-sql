# }}}

# {{{ race_class_skill
# Per-(race, class) starter weapon skill at rank 100 (= 5 × level 20).
# Convention: the skill grant tracks the main-hand weapon's type. The
# pre-trained skill applies ONLY to that weapon type — a Human Warrior
# starting with a Claymore has Two-Handed Swords at 100, but if they
# later pick up a Battle Axe their Two-Handed Axes skill starts at 1.
declare -A RACE_CLASS_SKILL=(
    # Human
    [1:1]=55      # Warrior  → Two-Handed Swords (Claymore)
    [1:2]=160     # Paladin  → Two-Handed Maces (Maul)
    [1:4]=173     # Rogue    → Daggers (Ceremonial Knife dual)
    [1:5]=54      # Priest   → Maces 1H (Militia Hammer)
    [1:8]=136     # Mage     → Staves (Militia Quarterstaff)
    [1:9]=43      # Warlock  → Swords 1H (Scimitar)

    # Orc
    [2:1]=44      # Warrior  → Axes 1H (Hatchet + Ringed Buckler)
    [2:3]=44      # Hunter   → Axes 1H (dual Butcher's Cleaver)
    [2:4]=54      # Rogue    → Maces 1H (Flail MH, mace-spec racial fit)
    [2:7]=160     # Shaman   → Two-Handed Maces (Giant Mace)
    [2:9]=136     # Warlock  → Staves (Militia Quarterstaff)

    # Dwarf
    [3:1]=229     # Warrior  → Polearms (Short Spear)
    [3:2]=54      # Paladin  → Maces 1H (Flail + shield)
    [3:3]=172     # Hunter   → Two-Handed Axes (Battle Axe)
    [3:4]=173     # Rogue    → Daggers (Ceremonial Knife dual)
    [3:5]=54      # Priest   → Maces 1H (Militia Hammer)

    # Night Elf
    [4:1]=229     # Warrior  → Polearms (Short Spear)
    [4:3]=229     # Hunter   → Polearms (Dacian Falx)
    [4:4]=43      # Rogue    → Swords 1H (Scimitar dual)
    [4:5]=136     # Priest   → Staves (Gnarled Staff)
    [4:11]=136    # Druid    → Staves (Militia Quarterstaff)

    # Undead
    [5:1]=172     # Warrior  → Two-Handed Axes (Battle Axe)
    [5:4]=43      # Rogue    → Swords 1H (Scimitar MH, Ceremonial Knife OH)
    [5:5]=173     # Priest   → Daggers (Amani Sacrificial Dagger)
    [5:8]=136     # Mage     → Staves (Gnarled Staff)
    [5:9]=43      # Warlock  → Swords 1H (Scimitar)

    # Tauren
    [6:1]=229     # Warrior  → Polearms (Short Spear)
    [6:3]=136     # Hunter   → Staves (Gnarled Staff — the Tauren-staff oddity)
    [6:7]=160     # Shaman   → Two-Handed Maces (Giant Mace)
    [6:11]=136    # Druid    → Staves (Militia Quarterstaff)

    # Gnome
    [7:1]=43      # Warrior  → Swords 1H (Scimitar dual)
    [7:4]=173     # Rogue    → Daggers (Ceremonial Knife dual)
    [7:8]=136     # Mage     → Staves (Gnarled Staff)
    [7:9]=43      # Warlock  → Swords 1H (Scimitar)

    # Troll
    [8:1]=172     # Warrior  → Two-Handed Axes (Battle Axe)
    [8:3]=44      # Hunter   → Axes 1H (dual Butcher's Cleaver)
    [8:4]=173     # Rogue    → Daggers (Ceremonial Knife dual)
    [8:5]=54      # Priest   → Maces 1H (Flail — kept grim utilitarian)
    [8:7]=172     # Shaman   → Two-Handed Axes (Battle Axe)
    [8:8]=173     # Mage     → Daggers (Amani Sacrificial Dagger, vanilla-class restored)

    # Blood Elf
    [10:2]=55     # Paladin  → Two-Handed Swords (Claymore)
    [10:3]=229    # Hunter   → Polearms (Short Spear)
    [10:4]=43     # Rogue    → Swords 1H (Scimitar dual)
    [10:5]=173    # Priest   → Daggers (Amani Sacrificial Dagger)
    [10:8]=43     # Mage     → Swords 1H (Scimitar, the 1H mage with frill)
    [10:9]=173    # Warlock  → Daggers (Amani Sacrificial Dagger)

    # Draenei
    [11:1]=54     # Warrior  → Maces 1H (Militia Hammer + shield)
    [11:2]=160    # Paladin  → Two-Handed Maces (Maul)
    [11:3]=55     # Hunter   → Two-Handed Swords (Claymore)
    [11:5]=54     # Priest   → Maces 1H (Militia Hammer)
    [11:7]=44     # Shaman   → Axes 1H (Hatchet + shield, no dual until L40)
    [11:8]=136    # Mage     → Staves (Gnarled Staff)
)

declare -A SKILL_NAME=(
    [43]=swords-1h   [44]=axes-1h    [45]=bows
    [54]=maces-1h    [55]=swords-2h
    [136]=staves     [160]=maces-2h  [172]=axes-2h
    [173]=daggers    [229]=polearms
)
# }}}

# {{{ bitmasks
# classMask / raceMask bits for playercreateinfo_skills rows.
declare -A CLASS_BIT=(
    [1]=1    [2]=2    [3]=4    [4]=8    [5]=16
    [7]=64   [8]=128  [9]=256  [11]=1024
)
declare -A RACE_BIT=(
    [1]=1    [2]=2    [3]=4    [4]=8    [5]=16
    [6]=32   [7]=64   [8]=128  [10]=512 [11]=1024
)
# }}}

# {{{ names
declare -A CLASS_NAME=(
    [1]=warrior [2]=paladin [3]=hunter [4]=rogue [5]=priest
    [7]=shaman  [8]=mage    [9]=warlock [11]=druid
)
declare -A RACE_NAME=(
    [1]=human   [2]=orc     [3]=dwarf   [4]=nightelf [5]=undead
    [6]=tauren  [7]=gnome   [8]=troll   [10]=bloodelf [11]=draenei
)
# }}}

# {{{ valid_combos
# Race-class validity matrix for 3.3.5a (DK excluded per 148a).
# Troll Mage (8:8) IS included — it's a vanilla class. The earlier
# generator excluded it as "Cataclysm-era," which was incorrect and
# is the bug the 2026-06-12 redesign repairs.
VALID_COMBOS=(
    1:1  1:2  1:4  1:5  1:8  1:9                  # Human:    War Pal Rog Pri Mag Wlk
    2:1  2:3  2:4  2:7  2:9                       # Orc:      War Hun Rog Sha Wlk
    3:1  3:2  3:3  3:4  3:5                       # Dwarf:    War Pal Hun Rog Pri
    4:1  4:3  4:4  4:5  4:11                      # NightElf: War Hun Rog Pri Dru
    5:1  5:4  5:5  5:8  5:9                       # Undead:   War Rog Pri Mag Wlk
    6:1  6:3  6:7  6:11                           # Tauren:   War Hun Sha Dru
    7:1  7:4  7:8  7:9                            # Gnome:    War Rog Mag Wlk (Priest is Cata)
    8:1  8:3  8:4  8:5  8:7  8:8                  # Troll:    War Hun Rog Pri Sha Mag
    10:2 10:3 10:4 10:5 10:8 10:9                 # BloodElf: Pal Hun Rog Pri Mag Wlk
    11:1 11:2 11:3 11:5 11:7 11:8                 # Draenei:  War Pal Hun Pri Sha Mag
)
# }}}

# {{{ emit_header
emit_header() {
    cat <<'SQL'
-- MARKER_E009_APPLY vanilla-starting-equipment
-- AUTOGENERATED by scripts/generate-vanilla-starting-equipment-sql.
-- Do not edit by hand — change the generator and re-run.
--
-- Apply-form SOURCE for E009. The E-patch cp's this file to
-- sql/vanilla/db_world/02-starting-equipment.sql, which AC's
-- UpdateFetcher picks up on next worldserver boot.
--
-- Purpose: equip every newly-created vanilla character (level-20 start
-- per C007c) with a full white-quality, race-and-class-appropriate
-- starter kit per the 148h thematic-curation design. References the
-- canonical item entries, which the E018 patch tunes in place to
-- RequiredLevel 20 and level-appropriate damage (148v reversal of the
-- clone design — a cloned entry no client has cached renders as an
-- invisible model with a red "?" icon).
--
-- Idempotent: re-running deletes prior vanilla-148h rows by Note prefix
-- and re-inserts. Default shirt/pants/quest-starter rows untouched.
--
-- Dual Wield dependency: dual-wield kits (Orc/Troll Hunter dual cleavers,
-- Gnome Warrior twin Scimitars, every Rogue's twin-dagger or mixed-
-- pair kit) need spell 674 "Dual Wield" granted before the off-hand
-- can equip. 148j grants every level-≤20 trainer spell at creation,
-- including DW.
--
-- Cross-references:
--   issues/148h-class-specific-starting-equipment.md  -- behavior spec
--   issues/148j-pretrain-level-20-abilities.md        -- DW dependency
--   issues/148k-ale-auto-equip-starter-kit.md         -- equip hook
--   issues/148n-vanilla-racial-starting-zones.md      -- bind targets
--   issues/148o-vanilla-spawn-and-kit-validation-pass.md -- test pass
--   issues/148p-wand-spell-dps-parity-rebalance.md    -- wand follow-up
--   issues/148v-cloned-kit-items-render-invisible.md  -- why entries are canonical
--   sql/vanilla/db_world.src/06-kit-required-level-cap.apply.sql  -- in-place tuning

START TRANSACTION;

-- {{{ idempotence_clear
DELETE FROM playercreateinfo_item
 WHERE Note LIKE 'vanilla-148h-%'
    OR Note = 'vanilla starter kit';

DELETE FROM playercreateinfo_skills
 WHERE comment LIKE 'vanilla-148h-%'
    OR comment LIKE 'vanilla starter %';
-- }}}

SQL
}
# }}}

# {{{ resolve_kit
# Args: race, class. Echoes the kit (newline-separated rows).
resolve_kit() {
    local race="$1" class="$2"
    local key="${race}:${class}"
    if [[ -z "${RACE_CLASS_KIT[$key]:-}" ]]; then
        echo "ERROR: no kit for race=$race class=$class" >&2
        exit 1
    fi
    printf '%s\n' "${RACE_CLASS_KIT[$key]}"
}
# }}}

# {{{ resolve_skill
# Args: race, class. Echoes the starter weapon skill ID.
resolve_skill() {
    local race="$1" class="$2"
    local key="${race}:${class}"
    if [[ -z "${RACE_CLASS_SKILL[$key]:-}" ]]; then
        echo "ERROR: no skill for race=$race class=$class" >&2
        exit 1
    fi
    echo "${RACE_CLASS_SKILL[$key]}"
}
# }}}

# {{{ emit_items_for_combo
# Args: race, class. Emits one INSERT row per kit item.
emit_items_for_combo() {
    local race="$1" class="$2"
    local armor_type="${CLASS_ARMOR[$class]}"

    # armor pieces (indirect array reference)
    local slot itemid
    for slot in chest legs hands feet waist wrist; do
        eval "itemid=\${${armor_type}[$slot]}"
        printf "INSERT INTO playercreateinfo_item (race, class, itemid, amount, Note) VALUES (%d, %d, %d, 1, 'vanilla-148h-%s-%s');\n" \
            "$race" "$class" "$itemid" "${armor_type,,}" "$slot"
    done

    # universal cape
    printf "INSERT INTO playercreateinfo_item (race, class, itemid, amount, Note) VALUES (%d, %d, %d, 1, 'vanilla-148h-cape');\n" \
        "$race" "$class" "$CAPE"

    # weapon kit
    local kit
    kit="$(resolve_kit "$race" "$class")"
    local line
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local item amount label
        read -r item amount label <<< "$line"
        printf "INSERT INTO playercreateinfo_item (race, class, itemid, amount, Note) VALUES (%d, %d, %d, %d, 'vanilla-148h-%s');\n" \
            "$race" "$class" "$item" "$amount" "$label"
    done <<< "$kit"

    # bags — three Linen Bags for everyone. Hunters get the Medium Quiver
    # via their weapon kit row.
    printf "INSERT INTO playercreateinfo_item (race, class, itemid, amount, Note) VALUES (%d, %d, %d, %d, 'vanilla-148h-bag-linen');\n" \
        "$race" "$class" "$LINEN_BAG" "$LINEN_COUNT"

    # hearthstone — universal, bind point handled by 148k Lua hook
    printf "INSERT INTO playercreateinfo_item (race, class, itemid, amount, Note) VALUES (%d, %d, %d, 1, 'vanilla-148h-hearthstone');\n" \
        "$race" "$class" "$HEARTHSTONE"
}
# }}}

# {{{ emit_items_section
emit_items_section() {
    echo "-- {{{ playercreateinfo_item — per (race, class) starter kit"
    local prev_class=""
    local combo race class
    for combo in "${VALID_COMBOS[@]}"; do
        race="${combo%:*}"
        class="${combo#*:}"
        if [[ "$class" != "$prev_class" ]]; then
            printf "\n-- %s (class %d)\n" "${CLASS_NAME[$class]}" "$class"
            prev_class="$class"
        fi
        emit_items_for_combo "$race" "$class"
    done
    echo "-- }}}"
    echo ""
}
# }}}

# {{{ emit_skills_section
emit_skills_section() {
    echo "-- {{{ playercreateinfo_skills — starter weapon skill at 100 per (race, class)"
    local prev_class=""
    local combo race class
    for combo in "${VALID_COMBOS[@]}"; do
        race="${combo%:*}"
        class="${combo#*:}"
        if [[ "$class" != "$prev_class" ]]; then
            printf "\n-- %s\n" "${CLASS_NAME[$class]}"
            prev_class="$class"
        fi
        local skill skill_name race_bit class_bit
        skill="$(resolve_skill "$race" "$class")"
        skill_name="${SKILL_NAME[$skill]}"
        race_bit="${RACE_BIT[$race]}"
        class_bit="${CLASS_BIT[$class]}"
        printf "INSERT INTO playercreateinfo_skills (raceMask, classMask, skill, \`rank\`, comment) VALUES (%d, %d, %d, 100, 'vanilla-148h-%s-%s-%s-100');\n" \
            "$race_bit" "$class_bit" "$skill" "${RACE_NAME[$race]}" "${CLASS_NAME[$class]}" "$skill_name"
    done
    echo "-- }}}"
    echo ""
}
# }}}

# {{{ emit_footer
emit_footer() {
    cat <<'SQL'
COMMIT;
SQL
}
# }}}

# {{{ main
main() {
    mkdir -p "$(dirname "$OUT")"
    {
        emit_header
        emit_items_section
        # emit_skills_section removed (148h weapon-skill rework): the
        # playercreateinfo_skills.rank column is a skill tier-STEP
        # (< MAX_SKILL_STEP = 16), not a 0-100 value, and is ignored outright
        # for weapon skills (SKILL_RANGE_LEVEL) — so the old rank=100 rows were
        # rejected by the core and did nothing but log 52 warnings. Starter
        # weapon/defense skill is now set to max-for-level ONCE, on first
        # login, by the ALE hook (src/lua-vanilla/auto-equip-starter-kit.lua ->
        # AdvanceSkillsToMax), which preserves normal weapon-skill progression
        # past level 20. The idempotence_clear DELETE in emit_header still
        # purges any previously-inserted vanilla-148h skill rows on re-apply.
        emit_footer
    } > "$OUT"
    local item_rows skill_rows
    item_rows="$(grep -c '^INSERT INTO playercreateinfo_item' "$OUT" || true)"
    skill_rows="$(grep -c '^INSERT INTO playercreateinfo_skills' "$OUT" || true)"
    echo "Wrote ${OUT}"
    echo "  ${item_rows} item rows"
    echo "  ${skill_rows} skill rows"
    echo "  ${#VALID_COMBOS[@]} valid (race, class) combos"
}

main "$@"
# }}}
