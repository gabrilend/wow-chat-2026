# RACE_CLASS_KIT_OVERRIDE; the new design's per-race main-hand
# curation has so many race-specific picks that the default-plus-
# override pattern stops compressing — explicit rows are cleaner.
#
# Format: newline-separated "itemid amount slotlabel" rows. Slotlabel
# becomes the Note suffix. Item entries are canonical, per 148v.
declare -A RACE_CLASS_KIT=(
    # Human
