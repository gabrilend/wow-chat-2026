#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-paint-paths
# profiles:   all
# priority:   10
# kind:       test
# about:      the buddy module's painted map (C++) passes the page's own courses: learning together, space from walls, spreading, smooth turning, fast plans
# quick-test: yes
# ==== end of header ====
# test-buddy-paint-paths - checks the buddy module's painted map
# (roam/buddy_paint_paths.h, issue 617o8) with no server.
#
# For a general audience: the painted map is the pathfinding the owner
# designed on 2026-10-29: the bots paint what they learn onto a shared map,
# keep their distance from walls (less near what they need), spread out,
# and walk in arcs. It exists twice: as the script the ground sandbox page
# runs (tested by scripts/test-paint-paths) and as C++ for the buddies in
# game. This builds the C++ alone with the system compiler and runs the
# page's test courses on it with the same random numbers, so the two
# can be read side by side.
#
# Usage: scripts/test-buddy-paint-paths [PROJECT_DIR]
# Builds into tmp/tmp/ (the executable tier). Exits non-zero when any
# check fails.

set -uo pipefail

# {{{ configuration
DIR="/mnt/kaun/wow-chat-2026"
[[ -n "${1:-}" ]] && DIR="$1"
CORE="${DIR}/patches/B036-mod-buddies/mod-buddies/src/roam"
SOURCE="${DIR}/tests/buddy-paint-paths/paint-check.cpp"
EXEC_DIR="${DIR}/tmp/tmp"
BINARY="${EXEC_DIR}/buddy-paint-check"
# }}}

[[ -d "${DIR}/tmp" ]] || { echo "ERROR: ${DIR}/tmp missing (the project's link to /tmp/<project>)"; exit 1; }
mkdir -p "${EXEC_DIR}"

if ! g++ -std=c++17 -O2 -Wall -Wextra -Werror -I"${CORE}" "${SOURCE}" -o "${BINARY}"; then
    echo "test-buddy-paint-paths: the painted map's core did not build alone (above); nothing was checked"
    exit 1
fi
"${BINARY}"
# ==== footer of test-buddy-paint-paths ====
# lines:      47
# ==== end of footer ====
