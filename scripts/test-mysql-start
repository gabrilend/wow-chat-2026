#!/bin/bash

DIR="/mnt/kaun/wow-chat-2026"
if [[ -n "$1" ]]; then
    DIR="$1"
fi

DATA_DIR="${DIR}/mysql/databases"
PID_FILE="${DATA_DIR}/mysqld.pid"
SOCKET="${DATA_DIR}/mysql.sock"
ADMIN="${DIR}/mysql/installed-files/bin/mysqladmin"
FAILS=0

check() {
    if eval "${2}"; then echo "  ok:   ${1}"; else echo "  FAIL: ${1}"; FAILS=$((FAILS + 1)); fi
}

if "${ADMIN}" --no-defaults --socket="${SOCKET}" --connect-timeout=2 ping >/dev/null 2>&1; then
    echo "MySQL is already running; stop it with ${DIR}/scripts/stop-mysql and rerun this test."
    exit 1
fi

sleep 300 &
DECOY_PID=$!
echo "${DECOY_PID}" > "${PID_FILE}"
echo "Planted PID file naming an unrelated live process (sleep, PID ${DECOY_PID})"

HANDED="${DIR}/tmp/shared-memory/test-mysql-start.handed"
: > "${HANDED}"

echo "Run 1: starter with a recycled PID in the file, and an open file handed to it"
OUT1="$("${DIR}/scripts/start-mysql" "${DIR}" 7< "${HANDED}")"
RC1=$?
echo "${OUT1}" | sed 's/^/    | /'
check "starter exited 0"                         '[[ ${RC1} -eq 0 ]]'
check "starter called the PID file stale"        '[[ "${OUT1}" == *"Removing stale PID file"* ]]'
check "server answers a ping"                    '"${ADMIN}" --no-defaults --socket="${SOCKET}" --connect-timeout=2 ping >/dev/null 2>&1'
check "decoy process was left untouched"         'kill -0 ${DECOY_PID} 2>/dev/null'
check "PID file now names a mysqld"              '[[ "$(readlink /proc/$(cat "${PID_FILE}")/exe)" == */mysqld ]]'
MYSQLD_NOW="$(cat "${PID_FILE}")"
check "mysqld leads a session of its own"        '[[ "$(ps -o sid= -p "${MYSQLD_NOW}" | tr -d " ")" == "${MYSQLD_NOW}" ]]'
check "mysqld is outside the starter's session"    '[[ "$(ps -o sid= -p "${MYSQLD_NOW}" | tr -d " ")" != "$(ps -o sid= -p $$ | tr -d " ")" ]]'
check "mysqld holds no file its launcher had open" '! ls -l /proc/"${MYSQLD_NOW}"/fd | grep -q -- "${HANDED}"'

echo "Run 2: starter with MySQL already up"
OUT2="$("${DIR}/scripts/start-mysql" "${DIR}")"
RC2=$?
echo "${OUT2}" | sed 's/^/    | /'
check "starter exited 0"                         '[[ ${RC2} -eq 0 ]]'
check "starter reported 'already running'"       '[[ "${OUT2}" == *"MySQL already running"* ]]'
check "exactly one mysqld on our datadir"        '[[ $(pgrep -f -- "--defaults-file=${DIR}/mysql/conf/my.cnf" | wc -l) -eq 1 ]]'

kill "${DECOY_PID}"
rm -f "${HANDED}"
echo "Stopping the MySQL this test started"
"${DIR}/scripts/stop-mysql" "${DIR}" | sed 's/^/    | /'
check "MySQL stopped again"                      '! "${ADMIN}" --no-defaults --socket="${SOCKET}" --connect-timeout=2 ping >/dev/null 2>&1'
echo ""
if [[ "${FAILS}" -eq 0 ]]; then echo "All checks passed (MySQL stopped again)"; else echo "${FAILS} check(s) failed"; fi
[[ "${FAILS}" -eq 0 ]]
