#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-route
# profiles:   all
# priority:   10
# kind:       test
# about:      a buddy's way to its owner across maps is the quickest route over walking, boats, portals and its own teleports; aboard, it gets off where the owner is reached soonest
# quick-test: yes
# ==== end of header ====
# test-buddy-route - checks a buddy's way to its owner across maps
# (roam/buddy_route_core.h) against issue 617e8, with no server.
#
# For a general audience: when its owner is on another continent, a buddy
# plans its way like any other path: walk to a dock, sail, step through a
# portal, or, for a mage, cast its own teleport, whichever chain gets it
# there soonest, and the owner's own boat when it is about as quick. Aboard
# a ship, it gets off at the stop from which the owner is reached soonest.
# This test builds the search alone with the system compiler and checks it
# on places shaped like the world's.
#
# Usage: scripts/test-buddy-route [PROJECT_DIR] [--help]
# Builds into tmp/tmp/ (the executable tier). Exits non-zero when any
# check fails.

set -uo pipefail

# {{{ configuration
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: scripts/test-buddy-route [PROJECT_DIR]"
    echo "  Builds and runs the route core's offline check (tests/buddy-route/route-check.cpp)."
    exit 0
fi
DIR="/mnt/kaun/wow-chat-2026"
[[ -n "${1:-}" ]] && DIR="$1"
CORE="${DIR}/patches/B036-mod-buddies/mod-buddies/src/roam"
SOURCE="${DIR}/tests/buddy-route/route-check.cpp"
EXEC_DIR="${DIR}/tmp/tmp"
BINARY="${EXEC_DIR}/buddy-route-check"
# }}}

[[ -d "${DIR}/tmp" ]] || { echo "ERROR: ${DIR}/tmp missing (the project's link to /tmp/<project>)"; exit 1; }
mkdir -p "${EXEC_DIR}"

if ! g++ -std=c++17 -O2 -Wall -Wextra -Werror -I"${CORE}" "${SOURCE}" -o "${BINARY}"; then
    echo "test-buddy-route: the route core did not build alone (above); nothing was checked"
    exit 1
fi
"${BINARY}"
# ==== footer of test-buddy-route ====
# lines:      51
# ==== end of footer ====
