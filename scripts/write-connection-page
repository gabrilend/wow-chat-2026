#!/usr/bin/env luajit

local DIR = "/mnt/kaun/wow-chat-2026"
local address, preview, out, screenshot, open_realm
do
    local i = 1
    while i <= #arg do
        local a = arg[i]
        if a == "--address" then address = arg[i + 1]; i = i + 1
        elseif a == "--preview" then preview = true
        elseif a == "--out" then out = arg[i + 1]; i = i + 1
        elseif a == "--screenshot" then
            screenshot = true
            if arg[i + 1] and arg[i + 1]:sub(1, 1) ~= "-" then open_realm = arg[i + 1]; i = i + 1 end
        elseif a == "--help" or a == "-h" then
            print("Usage: scripts/write-connection-page [DIR] (--address NAME | --preview) [--out FILE]"); os.exit(0)
        elseif a:sub(1, 1) == "-" then
            io.stderr:write("write-connection-page: unknown option " .. a .. " (see --help)\n"); os.exit(2)
        elseif a ~= "" then DIR = a end
        i = i + 1
    end
end
if not address and not preview then
    io.stderr:write("write-connection-page: give --address NAME (the login machine players connect to) or --preview "
                 .. "(a page whose banner says the name is not chosen yet). The name is still open: issue 157g, question 2.\n")
    os.exit(2)
end
out = out or (DIR .. "/tmp/shared-memory/connection-page/index.html")

local REALMS = {
    { key = "release", name = "Release" },
    { key = "beta",    name = "Beta"    },
    { key = "vanilla", name = "Vanilla" },
    { key = "alpha",   name = "Alpha"   },
    { key = "basic",   name = "Basic"   },
    { key = "cc-test", name = "cc-test" },
}

local COMPARISON = {
    { feature = "Levels", cells = {
        release = { text = "1–20",  proof = { "Starting Level 1 (Beta/Release/Basic)", "Max Level 20 (Beta/Release)" } },
        beta    = { text = "1–20",  proof = { "Death knights from level 1", "| Level cap                       | 20" } },
        vanilla = { text = "20–40", proof = { "Level 20 start, level 40 cap" } },
        alpha   = { text = "40–80", proof = { "Starting Level 40 (Alpha)", "Max Level 80 (Alpha)" } },
        basic   = { text = "1–60",  proof = { "Level 1 start, level 60 cap" } },
        ["cc-test"] = { text = "1–80", proof = { "No level-cap change (80)" } } } },
    { feature = "An empty world that fills in around you with ambushes", cells = {
        release = { tick = true, proof = { "Empty world by default" } },
        beta    = { tick = true, proof = { "An empty world", "The ambush." } } } },
    { feature = "AI playerbots in the world", cells = {
        release = { tick = true, proof = { "AI companion playerbots" } },
        beta    = { tick = true, proof = { "Random bots                     | 200" } },
        vanilla = { tick = true, proof = { "AI companion playerbots" } } } },
    { feature = "No flight paths: the world is walked", cells = {
        vanilla = { tick = true, proof = { "No flight paths." } },
        basic   = { tick = true, proof = { "No flight paths." } } } },
    { feature = "Slower movement, heavier falls", cells = {
        vanilla = { tick = true, proof = { "Slower movement (80% of normal), heavier fall damage" } },
        basic   = { tick = true, proof = { "Slower movement (80%), heavier fall damage" } } } },
    { feature = "Death knights", cells = {
        beta    = { text = "from level 1", proof = { "Death knights from level 1" } },
        basic   = { text = "with two limits", proof = { "Death knights allowed, with two limits" } } } },
    { feature = "and many more features!", many = true, cells = {
        release = { tick = true }, beta = { tick = true }, vanilla = { tick = true },
        basic = { tick = true }, ["cc-test"] = { tick = true } } },
}

local warnings = {}
local function warn(s) warnings[#warnings + 1] = s end

local function read_file(path)
    local f = io.open(path, "rb")
    if not f then error("write-connection-page: cannot read " .. path) end
    local s = f:read("*a"); f:close(); return s
end

local function section(md, title)
    local lines, inside, found = {}, false, false
    for line in (md .. "\n"):gmatch("([^\n]*)\n") do
        if line:match("^## ") then
            if inside then break end
            if line:sub(4):lower():find(title:lower(), 1, true) == 1 then inside, found = true, true end
        elseif inside then
            lines[#lines + 1] = line
        end
    end
    return found and table.concat(lines, "\n") or nil
end

local function is_internal(part)
    part = part:gsub("^%s+", ""):gsub("%s+$", "")
    return part == ""
        or part:match("^%d%d%d+%a*%d*$") ~= nil
        or part:match("^%d%d%d+%a*%d*,") ~= nil
        or part:lower():find("issue", 1, true) ~= nil
        or part:find("%f[%w][BCE]%d%d%d") ~= nil
        or part:find("`", 1, true) ~= nil
        or part:match("^%d%d%d%d%-%d%d%-%d%d") ~= nil
end
local function public_text(s)
    s = s:gsub("%s*(%b())", function(paren)
        local kept = {}
        for part in (paren:sub(2, -2) .. ";"):gmatch("([^;]*);") do
            if not is_internal(part) then kept[#kept + 1] = (part:gsub("^%s+", ""):gsub("%s+$", "")) end
        end
        return #kept > 0 and (" (" .. table.concat(kept, "; ") .. ")") or ""
    end)
    local sentences = {}
    for sentence in (s .. " "):gmatch("(.-[%.!?:]?)%s+") do
        if sentence ~= "" and not sentence:find("`[^`]*/[^`]*`") then sentences[#sentences + 1] = sentence end
    end
    s = table.concat(sentences, " ")
    s = s:gsub("`([^`]*)`", "%1")
    return s
end

local function escape(s)
    return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"))
end
local function inline(s)
    s = s:gsub("%[([^%]]*)%]%([^%)]*%)", "%1")
    s = escape(s)
    s = s:gsub("%*%*(.-)%*%*", "<strong>%1</strong>")
    return s
end

local function points(text)
    local intro, bullets, current = {}, {}, nil
    for line in (text .. "\n"):gmatch("([^\n]*)\n") do
        if line:match("^%- ") then
            current = { line:sub(3) }
            bullets[#bullets + 1] = current
        elseif current and line:match("^%s+%S") then
            current[#current + 1] = (line:gsub("^%s+", ""))
        elseif line:match("^%S") and not line:match("^#") and not current then
            intro[#intro + 1] = line
        elseif line == "" and current then
            current = nil
        end
    end
    local out_points = {}
    for _, b in ipairs(bullets) do
        local whole = public_text(table.concat(b, " "))
        local lead, rest = whole:match("^%*%*(.-)%*%*%s*(.*)$")
        if not lead then lead, rest = whole:match("^(.-%.)%s+(.*)$") end
        if not lead then lead, rest = whole, "" end
        out_points[#out_points + 1] = { lead = lead, rest = rest }
    end
    local intro_text = public_text(table.concat(intro, " "))
    return intro_text, out_points
end

local function check_leftovers(realm, s)
    for token in s:gmatch("%f[%w]%d%d%d%a%d*%f[%W]") do warn(realm .. ": still names " .. token .. " in: " .. s:sub(1, 90)) end
    for token in s:gmatch("%f[%w][BCE]%d%d%d%a?%f[%W]") do warn(realm .. ": still names " .. token .. " in: " .. s:sub(1, 90)) end
end

local boxes = dofile(DIR .. "/config/box-art/realms.lua").realms
local out_dir = out:match("^(.*)/[^/]*$")
os.execute("mkdir -p '" .. out_dir .. "/box-art'")
local function cover_for(key)
    local src = DIR .. "/assets/box-art/" .. key .. ".png"
    local fh = io.open(src, "rb")
    if not fh then
        if not preview then
            error("write-connection-page: realm " .. key .. " has no kept cover (" .. src .. "); make one with "
               .. "scripts/make-box-art " .. key .. " and keep it with --keep, or write a --preview page")
        end
        warn(key .. ": no cover kept yet; a plain glass box front is shown (preview only)")
        return nil
    end
    local data = fh:read("*a"); fh:close()
    local dst = assert(io.open(out_dir .. "/box-art/" .. key .. ".png", "wb")); dst:write(data); dst:close()
    return "box-art/" .. key .. ".png"
end

local entries = {}
for index, realm in ipairs(REALMS) do
    local md = read_file(DIR .. "/docs/profiles/" .. realm.key .. ".md")
    local summary = md:match("%*%*One%-line summary:%*%*%s*(.-)\n\n") or md:match("^#[^\n]*\n\n(.-)\n\n")
    if not summary then error("write-connection-page: docs/profiles/" .. realm.key .. ".md has neither a summary nor a first paragraph") end
    summary = public_text(summary:gsub("\n", " "))
    summary = summary:sub(1, 1):upper() .. summary:sub(2)
    local got = section(md, "What you get")
    if not got then error("write-connection-page: docs/profiles/" .. realm.key .. ".md has no \"## What you get\" section") end
    local intro, gets = points(got)
    local not_got = section(md, "What you do NOT get")
    local _, lacks = points(not_got or "")

    local function list_html(items, cls)
        local rows = {}
        for _, p in ipairs(items) do
            check_leftovers(realm.name, p.lead .. " " .. p.rest)
            if p.rest ~= "" then
                rows[#rows + 1] = string.format('<li><details class="point %s"><summary>%s</summary><p>%s</p></details></li>',
                    cls, inline(p.lead), inline(p.rest))
            else
                rows[#rows + 1] = string.format('<li><div class="point %s">%s</div></li>', cls, inline(p.lead))
            end
        end
        return table.concat(rows)
    end
    check_leftovers(realm.name, summary .. " " .. intro)

    local box = boxes[realm.key]
    if not box then error("write-connection-page: config/box-art/realms.lua has no box for realm " .. realm.key) end
    local back_lines = {}
    for k = 2, #box.back do back_lines[#back_lines + 1] = "<li>" .. escape(box.back[k]) .. "</li>" end
    local back_html = string.format('<div class="box-back"><p class="box-headline">%s</p><ul>%s</ul></div>',
        escape(box.back[1]), table.concat(back_lines))
    local cover = cover_for(realm.key)

    entries[#entries + 1] = string.format([[
<li class="realm" id="realm-%s">
<details>
<summary><span class="box" aria-hidden="true"><span class="box-front"%s><span class="box-title">%s</span><span class="orb">%d</span></span></span><span class="realm-name">%s</span><span class="realm-summary">%s</span><span class="chevron" aria-hidden="true"></span></summary>
<div class="realm-body">
%s
%s
<h3>What is here</h3>
<ul class="points">%s</ul>
%s
<a class="gel" href="#connect">Connect to %s</a>
</div>
</details>
</li>]], realm.key, cover and string.format(' style="background-image:url(\'%s\')"', cover) or "",
        escape(realm.name), index, escape(realm.name), inline(summary), back_html,
        intro ~= "" and ("<p class=\"intro\">" .. inline(intro) .. "</p>") or "",
        list_html(gets, "gets"),
        #lacks > 0 and ("<h3>Left out on purpose</h3><ul class=\"points\">" .. list_html(lacks, "lacks") .. "</ul>") or "",
        escape(realm.name))
end

local comparison_html
do
    local pages = {}
    for _, realm in ipairs(REALMS) do pages[realm.key] = read_file(DIR .. "/docs/profiles/" .. realm.key .. ".md") end
    local head = { "<th scope=\"col\">Feature</th>" }
    for _, realm in ipairs(REALMS) do
        head[#head + 1] = string.format('<th scope="col"><a href="#realm-%s">%s</a></th>', realm.key, escape(realm.name))
    end
    local rows = {}
    for _, row in ipairs(COMPARISON) do
        local cells = { string.format('<th scope="row">%s</th>', escape(row.feature)) }
        for _, realm in ipairs(REALMS) do
            local cell = row.cells[realm.key]
            if cell then
                for _, quote in ipairs(cell.proof or {}) do
                    if not pages[realm.key]:find(quote, 1, true) then
                        error(string.format("write-connection-page: the comparison says %s has \"%s\", but docs/profiles/%s.md "
                            .. "no longer contains the words that prove it: \"%s\". Mend the row (in this script's COMPARISON) "
                            .. "or the page.", realm.name, row.feature, realm.key, quote))
                    end
                end
                cells[#cells + 1] = cell.tick and '<td><span class="tick" role="img" aria-label="yes"></span></td>'
                    or ("<td>" .. escape(cell.text) .. "</td>")
            else
                cells[#cells + 1] = '<td><span class="dash" aria-label="no">–</span></td>'
            end
        end
        rows[#rows + 1] = string.format('<tr%s>%s</tr>', row.many and ' class="many"' or "", table.concat(cells))
    end
    comparison_html = '<div class="compare glass"><table><thead><tr>' .. table.concat(head) .. '</tr></thead><tbody>'
        .. table.concat(rows) .. "</tbody></table></div>"
end

local seed = 1997
local function rnd(low, high)
    seed = (seed * 1103515245 + 12345) % 2147483648
    return low + (high - low) * (seed / 2147483648)
end
local bubbles = {}
for _ = 1, 24 do
    local size = rnd(16, 110)
    bubbles[#bubbles + 1] = string.format('<span style="left:%.1f%%;top:%.1f%%;width:%.0fpx;height:%.0fpx;animation-delay:-%.1fs;animation-duration:%.1fs"></span>',
        rnd(0, 97), rnd(0, 100), size, size, rnd(0, 30), rnd(18, 40))
end

