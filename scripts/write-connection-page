<h2 id="connect-title">How to connect</h2>
<section id="connect" class="glass" aria-labelledby="connect-title">
<ol>
<li>Use a World of Warcraft 3.3.5a client (Wrath of the Lich King, build 12340).</li>
<li>Open <code>Data/enUS/realmlist.wtf</code> (or your language's folder) in a text editor and make it the one line:<br>]] .. address_html .. [[</li>
<li>Start the game and log in. The realm list shows every realm above; pick one.</li>
</ol>
<p class="note">Realms answer only players who have just logged in, so the realm list in the game is the only place their details appear.</p>
</section>
<footer>Generated from the realms' own pages. The realms are a private, non-commercial project.</footer>
</div>
</body>
</html>
]]

os.execute("mkdir -p '" .. out:match("^(.*)/[^/]*$") .. "'")
local f = assert(io.open(out, "wb")); f:write(html); f:close()

if screenshot then
    local history = DIR .. "/development-history"
    os.execute("mkdir -p '" .. history .. "'")
    local highest = 0
    local listing = io.popen("ls '" .. history .. "'")
    for name in listing:lines() do
        local n = tonumber(name:match("^(%d%d%d)%-"))
        if n and n > highest then highest = n end
    end
    listing:close()
    local commit = io.popen("git -C '" .. DIR .. "' rev-parse --short HEAD"):read("*l") or "(no commit)"
    local sources = io.popen("cat '" .. DIR .. "/scripts/write-connection-page' '" .. DIR .. "/docs/profiles/'*.md | b2sum")
    local fingerprint = (sources:read("*l") or ""):match("^(%x+)") or "(b2sum failed)"
    sources:close()

    local page = out
    if open_realm then
        local text = html:gsub('(<li class="realm" id="realm%-' .. open_realm:gsub("%-", "%%-") .. '">\n)<details>', "%1<details open>")
        if text == html then error("write-connection-page: --screenshot " .. open_realm .. ": no realm by that name on the page") end
        page = out:gsub("%.html$", "") .. "-open-" .. open_realm .. ".html"
        local pf = assert(io.open(page, "wb")); pf:write(text); pf:close()
    end
    local profile_dir = DIR .. "/tmp/shared-memory/connection-page/firefox-profile"
    os.execute("mkdir -p '" .. profile_dir .. "'")
    for _, shot in ipairs({ { width = 900, height = open_realm and 2200 or 1500, label = "wide" },
                            { width = 390, height = 1400, label = "phone" } }) do
        highest = highest + 1
        local name = string.format("%03d-connection-page-%s%s", highest, shot.label, open_realm and ("-" .. open_realm .. "-open") or "")
        local png = history .. "/" .. name .. ".png"
        local status = os.execute(string.format("timeout 90 firefox --headless --no-remote --profile '%s' --window-size=%d,%d --screenshot '%s' 'file://%s' >/dev/null 2>&1",
            profile_dir, shot.width, shot.height, png, page))
        if not io.open(png, "rb") then
            error("write-connection-page: Firefox wrote no picture at " .. png .. " (exit " .. tostring(status) .. "); "
               .. "to debug: run the same command without '>/dev/null' and read Firefox's own message")
        end
        local nf = assert(io.open(history .. "/" .. name .. ".info.md", "wb"))
        nf:write(string.format([[# %s

## What made it
- Tool: `scripts/write-connection-page%s --screenshot%s`
- Commit: %s (the working tree may hold uncommitted changes)
- Window: %d x %d, headless Firefox
- Sources fingerprint (BLAKE2b of the script and docs/profiles/*.md): %s

## What changed since the previous picture
Compare the fingerprint above with the previous picture's.

## What it shows
(to be filled in)

## The story so far
(to be filled in)
]], name, address and (" --address " .. address) or " --preview", open_realm and (" " .. open_realm) or "",
            commit, shot.width, shot.height, fingerprint))
        nf:close()
        print("filed " .. png)
    end
end

for _, w in ipairs(warnings) do io.stderr:write("WARNING " .. w .. "\n") end
print(string.format("wrote %s: %d realms, %d bytes, %d warning(s)%s", out, #entries, #html, #warnings,
                    (preview and not address) and ", PREVIEW (no login machine name)" or ""))
