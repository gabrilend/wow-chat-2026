#!/usr/bin/env luajit
-- generate-crowsign-page - build the "Crowsign" design page: sprite-craft, the
-- owner's idea of 2026-09-26 (notes/vision-enchanting-system-update.md, the
-- section "Second Conversation"), set beside the game data that decides how
-- it could be built without changing the game client.
--
-- For a general audience: the owner wants enchanting to gather magic from the
-- world and turn it into small floating "sprites". The game client (the
-- program players run) cannot be changed, so any new ability has to borrow
-- a name, an icon and a recipe slot the client already knows. This tool reads
-- the client's own data files (which skills, spells and recipes it knows) and
-- the server's world database (who teaches what, what breaks down into what),
-- and writes every list the decision needs into one page: the enchanting
-- recipes by skill, every skill line a player could see, the spells whose
-- names fit sprites, and the enchanting materials with the crafts that use
-- them. The prose on the page is the design; the lists are regenerated here.
--
-- Usage: scripts/generate-crowsign-page [PROJECT_DIR]
--   Reads   data-files/dbc/{SkillLine,SkillLineCategory,SkillLineAbility,
--           SkillRaceClassInfo,SkillTiers,Spell,SpellIcon,SpellDuration}.dbc
--           the world database acore_world_release (read-only SELECTs)
--   Writes  docs/HTML/crowsign.html (from scripts/templates/crowsign.html,
--           whose /*DATA*/ marker becomes the JSON built here)
--
-- The DBC files are WDBC: a 20-byte header ("WDBC", record count, field
-- count, record size, string block size), then the records (every field four
-- bytes), then a string block; a string field holds an offset into it. Field
-- positions below are for client 3.3.5a (build 12340) and were checked on
-- 2026-09-26 against known rows: Disenchant 13262, Prospecting 31252, Milling
-- 51005, Enchant Bracer - Minor Health 7418 (learned at 1, yellow 70, grey
-- 110), Runed Copper Rod 7421 (1 / 5 / 10).

local ffi = require("ffi")

-- {{{ DIR configuration
local DIR      = arg[1] or "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local DBC      = DIR .. "/data-files/dbc/"
local TEMPLATE = DIR .. "/scripts/templates/crowsign.html"
local OUT      = DIR .. "/docs/HTML/crowsign.html"
local MYSQL    = DIR .. "/mysql/installed-files/bin/mysql -h127.0.0.1 -P3307 -uritz -pmenardi -N --batch acore_world_release"
-- }}}

-- {{{ field positions (3.3.5a)
-- SkillLine:          0 id, 1 category, 3 name (enUS), 37 spell icon, 38 verb
-- SkillLineCategory:  0 id, 1 name
-- SkillLineAbility:   0 id, 1 skill line, 2 spell, 7 skill needed to learn
--                     (1 for nearly all; the real learning rank lives with
--                     the trainer or the recipe item), 9 acquire method
--                     (1 = learned the moment the skill is learned),
--                     10 grey at (no more skill-ups), 11 yellow at
-- SkillRaceClassInfo: 1 skill line, 2 race mask, 3 class mask, 4 flags
--                     (0x400 = the client shows no bar), 6 skill tier
-- SkillTiers:         17..32 the max value of each rank
-- Spell:              37 max level, 38 base level, 39 spell level,
--                     40 duration index, 52..59 reagents, 60..67 counts,
--                     71..73 effect, 80..82 base points, 95..97 aura,
--                     98..100 period (ms), 107..109 created item,
--                     116..118 trigger spell (the spell a "learn" teaches),
--                     110..112 misc value, 133 icon, 136 name, 153 rank,
--                     170 description, 222 tool category (6 = runed rod)
-- SpellIcon:          0 id, 1 texture path
-- SpellDuration:      0 id, 1 duration (ms)
local F = {
    sl_cat = 1, sl_name = 3, sl_icon = 37, sl_verb = 38,
    sla_skill = 1, sla_spell = 2, sla_req = 7, sla_acq = 9, sla_grey = 10, sla_yellow = 11,
    rc_skill = 1, rc_race = 2, rc_class = 3, rc_flags = 4, rc_tier = 6,
    sp_maxlvl = 37, sp_baselvl = 38, sp_lvl = 39, sp_dur = 40,
    sp_reag = 52, sp_rcount = 60, sp_eff = 71, sp_bp = 80, sp_aura = 95, sp_amp = 98,
    sp_item = 107, sp_misc = 110, sp_icon = 133, sp_name = 136, sp_rank = 153,
    sp_desc = 170, sp_tcat = 222,
}
-- }}}

-- {{{ the judgements
-- What each skill line a player could see is doing in 3.3.5, read from the
-- data on 2026-09-26 (source: SkillRaceClassInfo flags, trainer_spell,
-- item_template.RequiredSkill, and the server source for Lockpicking and
-- Runeforging). "free" means nobody uses it and it could carry Crowsign.
local VERDICT = {
    [142] = { "free",    "Survival: a cut secondary profession from before release. Everyone may hold it (all races, all classes), the client draws a progress bar (flags 0), nobody teaches it, no item needs it. Its one spell, Basic Campfire, Cooking also teaches. No recipe window." },
    [769] = { "free",    "Internal: the developers' test skill. The client knows a recipe-window spell for it (Internal Knowledge, 36356) and 35 test spells (\"Uber Heal Over Time\", \"Master Buff (Magic)\", \"dmg4\"). Sits under Class Skills; flags 0x410 show a flat value, no bar." },
    [148] = { "retired", "Horse Riding: a racial riding skill from before patch 2.0; Riding (762) replaced them all. A few old mounts still name it. Flags 0x492: no bar, always at max." },
    [149] = { "retired", "Wolf Riding: as Horse Riding." },
    [150] = { "retired", "Tiger Riding: as Horse Riding." },
    [152] = { "retired", "Ram Riding: as Horse Riding." },
    [533] = { "retired", "Raptor Riding: as Horse Riding." },
    [553] = { "retired", "Mechanostrider Piloting: as Horse Riding." },
    [554] = { "retired", "Undead Horsemanship: as Horse Riding." },
    [713] = { "retired", "Kodo Riding: as Horse Riding." },
    [155] = { "retired", "Swimming: no race/class row, so the server deletes it from any character at login unless one is added server-side." },
    [633] = { "in use",  "Lockpicking: rogues' Pick Lock grows it; the server reads it when opening locks." },
    [776] = { "in use",  "Runeforging: the death knight's rune window (flags 0x80). Death knights only." },
    [183] = { "hidden",  "GENERIC (DND): category Not Displayed; every character holds it for Auto Attack, Opening, Duel." },
    [138] = { "rare",    "Language: Draconic: spoken by NPCs; no player race starts with it." },
    [140] = { "rare",    "Language: Titan: spoken by NPCs; no player race starts with it." },
    [139] = { "rare",    "Language: Demon Tongue: spoken by NPCs." },
    [141] = { "rare",    "Language: Old Tongue: spoken by NPCs." },
}
-- Words that make a spell a sprite candidate (whole-word or prefix match,
-- case ignored).
local SPRITE_WORDS = { "sprite", "wisp", "mote", "spirit", "elemental", "faerie", "fairy",
                       "will%-o", "essence", "pixie", "firefly" }
local SPRITE_WORDS_SQL = "Sprite|Wisp|Mote|Faerie|Fairy|Will-o|Pixie|Firefly|Elemental|Essence|Spirit"
-- }}}

