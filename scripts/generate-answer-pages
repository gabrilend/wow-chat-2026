#!/usr/bin/env luajit
-- generate-answer-pages - writes the five architecture pages you can answer
-- on (issue 1102), from their stories and from the issue files themselves.
--
-- For a general audience: each page tells one part of the project as a
-- short story (docs/answer-pages/<page>.md, with its five gifs placed in
-- it), then lists every open question its issues still ask, read fresh
-- from the issue files so the page never holds a stale copy. Beside each
-- question is a box to answer it; the answer goes to the answer server
-- (scripts/answer-server), which keeps it in notes/answers/<page>.md, and
-- the page shows the answers already kept. The first page holds every
-- open question in the project, ranked by how many open issues wait on
-- the issue that asks it, and grouped by the seven rings of the capability
-- architecture (docs/capability-architecture.md). The gifs are copied in
-- from the gif tools' latest drawing and shrunk on the way, several at once.
--
-- Usage: scripts/generate-answer-pages [DIR] [--gifs PATH] [--check]
--   DIR          the project root (default the hard-coded one below)
--   --gifs PATH  where the drawn gifs are (default DIR/tmp/shared-memory/gifs/attempt-1);
--                a gif already in the pages' folder is kept unless --regif is given
--   --regif      copy every gif again
--   --check      write nothing; say whether the pages are up to date (a quick test)
--   --help       this text
-- Writes docs/HTML/answer-pages/<page>.html, its index.html, and gifs/.

local DIR = "/mnt/kaun/wow-chat-2026"
local LIBS = "/home/ritz/programming/ai-stuff/libs/lua"

-- {{{ arguments
local gifsFrom, regif, check
do
    local i = 1
    while i <= #arg do
        local a = arg[i]
        if a == "--help" or a == "-h" then
            for line in io.lines(arg[0]) do
                if not line:match("^%-%-") and not line:match("^#!") then break end
                print((line:gsub("^%-%- ?", "")))
            end
            os.exit(0)
        elseif a == "--gifs"  then gifsFrom = arg[i + 1]; i = i + 1
        elseif a == "--regif" then regif = true
        elseif a == "--check" then check = true
        elseif a:sub(1, 2) ~= "--" then DIR = a
        else error("unknown option " .. a .. " (see --help)") end
        i = i + 1
    end
end
gifsFrom = gifsFrom or (DIR .. "/tmp/shared-memory/gifs/attempt-1")
-- }}}

package.path = LIBS .. "/?.lua;" .. package.path
local json = require("dkjson")

local PAGES = { "open-questions", "pathfinding", "talents", "stand-ins", "alterac-weather" }
local OUT   = DIR .. "/docs/HTML/answer-pages"

-- {{{ local function slurp()
local function slurp(path)
    local f = io.open(path, "r") or error("cannot read " .. path)
    local t = f:read("*a")
    f:close()
    return t
end
-- }}}

-- {{{ local function esc()
local function esc(s) return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;")) end
-- }}}

-- {{{ local function inline()
-- The Markdown the issues and stories use inside a line: `code`, **bold**,
-- [text](link). Escaped first, so nothing in an issue becomes markup.
local function inline(s)
    s = esc(s)
    s = s:gsub("`([^`]+)`", "<code>%1</code>")
    s = s:gsub("%*%*(.-)%*%*", "<strong>%1</strong>")
    s = s:gsub("%[([^%]]+)%]%(([^%)]+)%)", '<a href="%2">%1</a>')
    return s
end
-- }}}

-- {{{ the issues
-- Every open issue (issues/*.md, not completed/): its title, state, phase,
-- the issues it waits on, and its open questions, item by item. An item
-- is a line starting "1." or "- " at the left edge, with the indented
-- lines after it; a "### " line inside the section names a group. An item
-- counts as answered when it says so ("Answered", "Settled by later
-- work", "Decided") and doesn't also say part of it is still open.
local ISSUES, IDS = {}, {}
for path in io.popen("ls " .. DIR .. "/issues/*.md"):lines() do
    local name = path:match("([^/]+)%.md$")
    local id = name:match("^(%d+%a*%d*%a*%d*)%-")
    if id then
        local text = slurp(path)
        local it = { id = id, name = name, deps = {}, blocks = {}, questions = {} }
        it.title = (text:match("^#%s*[^\n]-%s+%-%s+([^\n]+)") or text:match("^#%s*([^\n]+)") or name)
        -- read as scripts/issue-status-board reads them, so the two agree
        it.state = text:match("\n%-%s*State:%s*([^\n]+)") or text:match("\n%*%*State%*%*:?%s*([^\n]+)") or ""
        it.now = text:match("## Current Behavior%s*\n%s*\n?([^\n]+)") or ""
        it.cb = text:match("## Current Behavior%s*\n(.-)\n## ") or text:match("## Current Behavior%s*\n(.*)$")
        it.phase = tonumber(text:match("\n%-%s*%**Phase%**:%s*(%d+)") or "")
        for line in text:gmatch("[^\n]+") do
            local l = line:lower()
            local dep = l:match("^%s*%-?%s*%**blocked by%**:") or l:match("^%s*%-?%s*%**depends on%**:") or l:match("^%s*%-?%s*%**dependencies%**:")
            local blk = l:match("^%s*%-?%s*%**blocks%**:")
            if dep or blk then
                for ref in line:gmatch("%f[%w](%d%d%d+%a*%d*%a*%d*)%f[%W]") do
                    table.insert(dep and it.deps or it.blocks, ref)
                end
            end
        end
        local section = text:match("\n## Open [Qq]uestions[^\n]*\n(.-)\n## ") or text:match("\n## Open [Qq]uestions[^\n]*\n(.*)$")
        if section then
            local group, cur = nil, nil
            for line in (section .. "\n"):gmatch("([^\n]*)\n") do
                if line:match("^###%s") then
                    group, cur = line:gsub("^###%s+", ""), nil
                elseif line:match("^%d+%.%s") or line:match("^%-%s") then
                    cur = { text = line:gsub("^%d+%.%s+", ""):gsub("^%-%s+", ""), group = group }
                    table.insert(it.questions, cur)
                elseif cur and line:match("^%s+%S") then
                    cur.text = cur.text .. " " .. line:gsub("^%s+", "")
                elseif line:match("^%S") then
                    cur = nil                           -- prose between items ends the item
                end
            end
            -- An item is often answered in parts, written on as they come
            -- ("... stays open. And the rest, 2026-10-28: ... Question 3 is
            -- answered."), so the last word decides: whichever comes later
            -- in the text, a mark of an answer or a mark of something open.
            local ANSWER_MARKS = { "answered", "settled by later work", "decided" }
            local OPEN_MARKS   = { "still open", "stays open", "stay open", "; open", "open.", "to be asked again", "still to be asked", "to be talked through" }
            local function last(l, marks)
                local at = 0
                for _, m in ipairs(marks) do
                    local from = 1
                    while true do
                        local s = l:find(m, from, true)
                        if not s then break end
                        at, from = math.max(at, s), s + 1
                    end
                end
                return at
            end
            for n, q in ipairs(it.questions) do
                local l = q.text:lower()
                q.n = n
                local a, o = last(l, ANSWER_MARKS), last(l, OPEN_MARKS)
                q.answered = a > 0 and a > o
            end
        end
        ISSUES[id] = it
        IDS[#IDS + 1] = id
    end
end
-- }}}

-- {{{ what waits on what
-- An issue's count is every open issue that waits on it, directly or
-- through others: by the dependency lines, and a sub-issue waiting on its
-- parent (617e13 on 617e).
local dependents = {}
local function add(on, who)
    if on ~= who and ISSUES[who] then dependents[on] = dependents[on] or {}; dependents[on][who] = true end
end
for id, it in pairs(ISSUES) do
    for _, d in ipairs(it.deps) do add(d, id) end
    for _, b in ipairs(it.blocks) do add(id, b) end
end
-- b is a's sub-issue when it starts with a and goes on with the other
-- kind of character (617 then a letter, 617e then a digit), so 61 is not
-- 617's parent
for _, a in ipairs(IDS) do for _, b in ipairs(IDS) do
    local nxt, aEndsInLetter = b:sub(#a + 1, #a + 1), a:sub(-1):match("%a") ~= nil
    if a ~= b and b:sub(1, #a) == a and ((aEndsInLetter and nxt:match("%d")) or (not aEndsInLetter and nxt:match("%a"))) then add(a, b) end
end end
for id, it in pairs(ISSUES) do
    local seen, stack, n = {}, { id }, 0
    while #stack > 0 do
        local x = table.remove(stack)
        for y in pairs(dependents[x] or {}) do
            if not seen[y] then seen[y] = true; n = n + 1; stack[#stack + 1] = y end
        end
    end
    it.unblocks = n
end
-- }}}

-- {{{ the rings
-- From the architecture document's "The capabilities, ring by ring": each
-- ring's tables name issues in their rows; an issue not named takes the
-- ring of the nearest named issue it is a sub-issue of.
local RING_OF, RINGS = {}, {}
do
    local arch, ring = slurp(DIR .. "/docs/capability-architecture.md"), nil
    local inside = false
    for line in arch:gmatch("[^\n]+") do
        if line:match("^## The capabilities, ring by ring") then inside = true
        elseif line:match("^## ") then inside = false end
        local r = inside and line:match("^### %d+%.%s+(.+)")
        if r then ring = r; RINGS[#RINGS + 1] = r end
        if inside and ring and line:match("^|") then
            for ref in line:gmatch("%f[%w](%d%d%d+%a*%d*%a*%d*)%f[%W]") do RING_OF[ref] = RING_OF[ref] or ring end
        end
    end
end
for id, it in pairs(ISSUES) do
    local probe = id
    while #probe > 0 and not RING_OF[probe] do probe = probe:sub(1, -2) end
    it.ring = RING_OF[probe] or "not yet placed"
end
-- }}}

-- {{{ local function state_kind()
-- Where an issue stands, by the same rule as scripts/issue-status-board's
-- groups (copied, so the board and this page say the same; a change there
-- is made here too): the State line first, then the Current Behavior.
local function state_kind(state, now, cb)
    local s, c, all = (state or ""):lower(), (now or ""):lower(), (cb or ""):lower()
    if all:find("not yet compiled") or all:find("waiting for the owner's compile") or all:find("waits for the owner's compile") then return "waiting for the compile" end
    if s:find("will not") then return "will not implement" end
    if s:find("planned") or s:find("plan only") or s:find("^plan") or s:find("an idea") or s:find("a goal") or s:find("deferred") then return "planned" end
    if c:match("^%*?%*?not built") or c:match("^not started") then return "not started" end
    local built = all:find("%*%*built") or all:find("built 20%d%d") or all:find("built and") or all:find("written and")
                  or all:find("is built") or all:find("are built") or all:find("now built")
    if s:find("in progress") or c:find("in progress") then return built and "built" or "in progress" end
    if s:find("built") or s:find("done") or built then return "built" end
    if cb then return "not started" end
    return "unclear"
end
-- }}}

-- {{{ local function questions_for()
-- The questions a page lists, as data for its script: one entry per issue
-- (in the order asked, or by what it unblocks for "all").
local function questions_for(issueList)
    local list = {}
    if issueList[1] == "all" then
        for _, id in ipairs(IDS) do if #ISSUES[id].questions > 0 then list[#list + 1] = id end end
        table.sort(list, function(a, b)
            if ISSUES[a].unblocks ~= ISSUES[b].unblocks then return ISSUES[a].unblocks > ISSUES[b].unblocks end
            return a < b end)
    else
        for _, id in ipairs(issueList) do
            if not ISSUES[id] then error("the page names issue " .. id .. ", which is not an open issue file") end
            list[#list + 1] = id
        end
    end
    local out = {}
    for _, id in ipairs(list) do
        local it = ISSUES[id]
        local qs = {}
        for _, q in ipairs(it.questions) do qs[#qs + 1] = { n = q.n, html = inline(q.text), answered = q.answered, group = q.group } end
        out[#out + 1] = { id = id, title = it.title, file = it.name .. ".md", ring = it.ring, state = state_kind(it.state, it.now, it.cb),
                          stateText = it.state, phase = it.phase, unblocks = it.unblocks, questions = qs }
    end
    return out
end
-- }}}

-- {{{ local function story()
-- A story file: "key: value" lines first (title, subtitle, part, state,
-- issues, gifs), a blank line, then Markdown: ## and ### headings,
-- paragraphs, "- " and "1. " lists, | tables |, a "gif: 2a" line for a gif,
-- and "questions:" where the questions go.
local function story(page)
    local text = slurp(DIR .. "/docs/answer-pages/" .. page .. ".md")
    local meta, body = {}, text:match("^.-\n\n(.*)$")
    for k, v in text:match("^(.-)\n\n"):gmatch("([%w]+):%s*([^\n]*)") do meta[k] = v end
    local html, heads, para, list, tbl = {}, {}, {}, nil, nil
    local function flush()
        if #para > 0 then html[#html + 1] = "<p>" .. inline(table.concat(para, " ")) .. "</p>"; para = {} end
        if list then html[#html + 1] = "<" .. list.kind .. ">" .. table.concat(list.items) .. "</" .. list.kind .. ">"; list = nil end
        if tbl then
            local rows = {}
            for r, cells in ipairs(tbl) do
                local tag = r == 1 and "th" or "td"
                local cs = {}
                for _, c in ipairs(cells) do
                    local num = c:match("^%s*[%d%.%%]+%s*$") and " class=num" or ""
                    cs[#cs + 1] = "<" .. tag .. num .. ">" .. inline(c:match("^%s*(.-)%s*$")) .. "</" .. tag .. ">"
                end
                rows[#rows + 1] = (r == 1 and "<thead>" or "") .. "<tr>" .. table.concat(cs) .. "</tr>" .. (r == 1 and "</thead>" or "")
            end
            html[#html + 1] = "<div class=table><table>" .. table.concat(rows) .. "</table></div>"
            tbl = nil
        end
    end
    local gifCount = {}
    for line in (body .. "\n"):gmatch("([^\n]*)\n") do
        local h2, h3 = line:match("^## (.+)"), line:match("^### (.+)")
        local gif = line:match("^gif:%s*(%w+)")
        if h2 or h3 then
            flush()
            local t = h2 or h3
            local slug = t:lower():gsub("[^%w]+", "-"):gsub("^%-+", ""):gsub("%-+$", "")
            heads[#heads + 1] = { slug = slug, text = t, level = h2 and 2 or 3 }
            html[#html + 1] = string.format("<h%d id=%q>%s</h%d>", h2 and 2 or 3, slug, inline(t), h2 and 2 or 3)
        elseif gif then
            flush()
            gifCount[gif] = true
            html[#html + 1] = string.format("<figure class=gif><img src=\"gifs/%s.gif\" alt=\"\" loading=lazy width=256 height=256><figcaption>%s</figcaption></figure>",
                gif, esc(meta["caption" .. gif] or ""))
        elseif line:match("^questions:") then
            flush()
            html[#html + 1] = "<div id=questions></div>"
        elseif line:match("^|") then
            if not line:match("^|[%s%-:|]+|%s*$") then
                tbl = tbl or {}
                local cells = {}
                for c in line:gsub("^|", ""):gsub("|%s*$", ""):gmatch("([^|]*)") do cells[#cells + 1] = c end
                tbl[#tbl + 1] = cells
            end
        elseif line:match("^%- ") or line:match("^%d+%. ") then
            if #para > 0 then html[#html + 1] = "<p>" .. inline(table.concat(para, " ")) .. "</p>"; para = {} end
            local kind = line:match("^%d") and "ol" or "ul"
            list = list or { kind = kind, items = {} }
            list.items[#list.items + 1] = "<li>" .. inline(line:gsub("^%d+%. ", ""):gsub("^%- ", "")) .. "</li>"
        elseif line:match("^%s+%S") and list then
            local more = inline((line:gsub("^%s+", "")))
            list.items[#list.items] = list.items[#list.items]:sub(1, -6) .. " " .. more .. "</li>"
        elseif line:match("^%s*$") then
            flush()
        else
            if list then flush() end
            para[#para + 1] = line
        end
    end
    flush()
    -- every one of the page's own five gifs must be in its story
    for g in (meta.gifs or ""):gmatch("%w+") do
        if not gifCount[g] then error(page .. ": its gif " .. g .. " is not placed in the story (a \"gif: " .. g .. "\" line)") end
    end
    return meta, table.concat(html, "\n"), heads
end
-- }}}

-- {{{ the gifs
-- Copied from the drawing, shrunk (frames that change little share
-- pixels), eight at a time; a gif already there is kept unless --regif.
local function copy_gifs(wanted)
    local cmds = {}
    for g in pairs(wanted) do
        local dest = OUT .. "/gifs/" .. g .. ".gif"
        local have = io.open(dest, "rb")
        if have then have:close() end
        if regif or not have then
            local src = gifsFrom .. "/" .. g .. ".gif"
            local s = io.open(src, "rb") or error("no drawn gif " .. src .. " (draw them: scripts/compose-architecture-gifs, scripts/render-gif-scores)")
            s:close()
            cmds[#cmds + 1] = string.format("magick '%s' -coalesce -fuzz 3%% -layers Optimize '%s'", src, dest)
        end
    end
    if #cmds == 0 then return 0 end
    os.execute("mkdir -p '" .. OUT .. "/gifs'")
    local listFile = DIR .. "/tmp/shared-memory/answer-page-gif-commands"
    local f = io.open(listFile, "w") or error("cannot write " .. listFile)
    f:write(table.concat(cmds, "\n"), "\n")
    f:close()
    os.execute("xargs -P 8 -I{} sh -c '{}' < '" .. listFile .. "'")
    return #cmds
end
-- }}}

