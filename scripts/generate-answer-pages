@media (max-width:760px){.wrap{grid-template-columns:minmax(0,1fr);gap:.5rem}nav{position:static;max-height:none;border-bottom:1px solid var(--line)}figure.gif{float:none;margin:1rem auto;width:min(256px,100%)}}
]]

local SCRIPT = [[
(function(){
const PAGE=document.body.dataset.page, ALL=PAGE==="open-questions";
const DATA=JSON.parse(document.getElementById("data").textContent);
const served=location.protocol.startsWith("http");
let kept={};
const el=(t,c,h)=>{const e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e};
const box=document.getElementById("server");
if(served){box.classList.add("on");box.innerHTML="Answers go to the answer server on this computer, which keeps them in <code>notes/answers/"+PAGE+".md</code>.";}
else{box.innerHTML="The answer server isn't running for this page (it was opened as a plain file), so the boxes can't send. Start it with <code>scripts/answer-server</code>, then open <code>http://127.0.0.1:8642/answer-pages/"+PAGE+".html</code>.";}
function render(){
  const mount=document.getElementById("questions"); if(!mount) return;
  mount.innerHTML="";
  const f=ALL?{ring:document.getElementById("f-ring").value,state:document.getElementById("f-state").value,phase:document.getElementById("f-phase").value,
    text:document.getElementById("f-text").value.toLowerCase(),answered:document.getElementById("f-answered").checked,sort:document.getElementById("f-sort").value}:{answered:true};
  let issues=DATA.slice();
  if(ALL&&f.sort==="issue") issues.sort((a,b)=>a.id.localeCompare(b.id,undefined,{numeric:true}));
  let shownQ=0, openQ=0;
  for(const it of DATA) for(const q of it.questions) if(!q.answered) openQ++;
  for(const it of issues){
    if(ALL&&((f.ring&&it.ring!==f.ring)||(f.state&&it.state!==f.state)||(f.phase&&String(it.phase)!==f.phase))) continue;
    const qs=it.questions.filter(q=>(f.answered||!q.answered)&&(!f.text||(q.html+" "+it.title+" "+it.id).toLowerCase().includes(f.text)));
    if(!qs.length) continue;
    const card=el("section","issue");
    card.appendChild(el("h4",null,"<code>"+it.id+"</code> "+it.title.replace(/&/g,"&amp;").replace(/</g,"&lt;")));
    card.appendChild(el("div","meta",[it.ring,it.state,it.phase?"phase "+it.phase:"",it.unblocks+" open issues wait on it"].filter(Boolean).join(" · ")+(it.stateText?" — "+it.stateText.replace(/</g,"&lt;"):"")));
    let lastGroup=null;
    for(const q of qs){
      shownQ++;
      const d=el("div","q"+(q.answered?" answered":""));
      if(q.group&&q.group!==lastGroup){d.appendChild(el("div","group",q.group.replace(/</g,"&lt;")));lastGroup=q.group;}
      const head="<strong>"+q.n+".</strong> ";
      if(q.answered){const det=el("details");det.appendChild(el("summary",null,head+"answered in the issue <span class=tag>answered</span>"));det.appendChild(el("div","text",q.html));d.appendChild(det);}
      else d.appendChild(el("div","text",head+q.html));
      const key=it.id+"#"+q.n;
      for(const a of (kept[key]||[])){const k=el("div","kept");k.appendChild(el("span","when","answered "+a.when));k.appendChild(document.createTextNode(a.answer));d.appendChild(k);}
      const b=el("div","box"),ta=el("textarea"),btn=el("button",null,"Send"),said=el("div","said");
      ta.placeholder=served?"Your answer…":"Start the answer server to answer here";ta.setAttribute("aria-label","Answer to "+key);
      btn.disabled=!served;
      btn.onclick=async()=>{
        const text=ta.value.trim(); if(!text) return;
        btn.disabled=true; said.textContent="Sending…";
        try{
          const plain=d.querySelector(".text").textContent;
          const r=await fetch("/answer",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({page:PAGE,issue:it.id,number:q.n,question:plain,answer:text})});
          const j=await r.json();
          if(!r.ok) throw new Error(j.error||r.status);
          said.textContent="Kept in "+j.kept+".";
          (kept[key]=kept[key]||[]).push({when:"just now",answer:text}); ta.value="";
          const k=el("div","kept");k.appendChild(el("span","when","answered just now"));k.appendChild(document.createTextNode(text));d.insertBefore(k,b);
        }catch(e){said.textContent="Not sent: "+e.message+". Is scripts/answer-server still running?";}
        btn.disabled=false;
      };
      b.appendChild(ta);b.appendChild(btn);d.appendChild(b);d.appendChild(said);
      card.appendChild(d);
    }
    mount.appendChild(card);
  }
  const c=document.getElementById("count");
  if(c) c.textContent=shownQ+" questions shown; "+openQ+" still open across "+DATA.length+" issues.";
}
if(ALL) for(const id of ["f-ring","f-state","f-phase","f-text","f-answered","f-sort"]) document.getElementById(id).addEventListener("input",render);
render();
if(served) fetch("/answers/"+PAGE).then(r=>r.json()).then(j=>{kept={};for(const a of j.answers){(kept[a.key]=kept[a.key]||[]).push(a)} render();}).catch(()=>{});
})();
]]

-- {{{ local function page_html()
local function page_html(page, meta, body, heads, data, titles)
    local nav = { "<div class=eyebrow>Answer pages</div>" }
    for _, p in ipairs(PAGES) do
        nav[#nav + 1] = string.format("<a href=\"%s.html\"%s>%s</a>", p, p == page and " class=here" or "", esc(titles[p]))
    end
    nav[#nav + 1] = "<div class=eyebrow>On this page</div>"
    for _, h in ipairs(heads) do
        if h.level == 2 then nav[#nav + 1] = string.format("<a href=\"#%s\">%s</a>", h.slug, esc(h.text)) end
    end
    nav[#nav + 1] = "<div class=eyebrow>More</div><a href=\"../capability-architecture.html\">The capability architecture</a>"

    local filters = ""
    if page == "open-questions" then
        local rings, phases = {}, {}
        for _, r in ipairs(RINGS) do rings[#rings + 1] = "<option>" .. esc(r) .. "</option>" end
        rings[#rings + 1] = "<option>not yet placed</option>"
        local seenPhase = {}
        for _, it in ipairs(data) do if it.phase and not seenPhase[it.phase] then seenPhase[it.phase] = true; phases[#phases + 1] = it.phase end end
        table.sort(phases)
        for i, p in ipairs(phases) do phases[i] = "<option>" .. p .. "</option>" end
        filters = "<div class=filters><label>Ring <select id=f-ring><option value=\"\">all</option>" .. table.concat(rings) .. "</select></label>"
            .. "<label>State <select id=f-state><option value=\"\">all</option><option>waiting for the compile</option><option>built</option><option>in progress</option><option>planned</option><option>not started</option><option>unclear</option></select></label>"
            .. "<label>Phase <select id=f-phase><option value=\"\">all</option>" .. table.concat(phases) .. "</select></label>"
            .. "<label>Sort <select id=f-sort><option value=unblocks>unblocks the most</option><option value=issue>issue number</option></select></label>"
            .. "<input id=f-text type=search placeholder=\"Search\" aria-label=\"Search the questions\">"
            .. "<label><input id=f-answered type=checkbox> show answered</label></div><div class=count id=count></div>"
    end
    body = body:gsub("<div id=questions></div>", function() return filters .. "<div id=questions></div>" end)

    local badges = string.format("<div class=badges><span>%s</span><span>%s</span></div>", esc(meta.part or ""), esc(meta.state or ""))
    return table.concat({
        "<!doctype html>",
        "<!-- docs/HTML/answer-pages/" .. page .. ".html - GENERATED by scripts/generate-answer-pages from docs/answer-pages/" .. page
            .. ".md and the open issues' Open Questions sections, so the owner can read and answer them (issue 1102); don't edit, run it again. -->",
        "<html lang=en><head><meta charset=utf-8><meta name=viewport content=\"width=device-width, initial-scale=1, viewport-fit=cover\">",
        "<title>" .. esc(meta.title) .. "</title>",
        "<link rel=preconnect href=\"https://fonts.googleapis.com\"><link rel=stylesheet href=\"https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@500;600;700&family=Source+Sans+3:wght@400;600&family=JetBrains+Mono:wght@400;500&display=swap\">",
        "<style>" .. STYLE .. "</style></head>",
        "<body data-page=\"" .. page .. "\"><div class=wrap><nav aria-label=Contents>" .. table.concat(nav) .. "</nav><main>",
        "<h1>" .. esc(meta.title) .. "</h1><p class=subtitle>" .. esc(meta.subtitle or "") .. "</p>" .. badges,
        "<div class=server id=server></div>",
        body,
        "<p class=source>Written by <code>scripts/generate-answer-pages</code> from <code>docs/answer-pages/" .. page
            .. ".md</code> and the issue files on " .. os.date("%Y-%m-%d %H:%M") .. ". Answers: <code>notes/answers/" .. page .. ".md</code>.</p>",
        "</main></div>",
        "<script type=application/json id=data>" .. json.encode(data):gsub("</", "<\\/") .. "</script>",
        "<script>" .. SCRIPT .. "</script></body></html>",
    }, "\n")
end
-- }}}
-- }}}

-- {{{ writing
local titles, written, gifsWanted, outputs = {}, {}, {}, {}
for _, page in ipairs(PAGES) do
    local meta, body, heads = story(page)
    titles[page] = meta.title
    written[page] = { meta = meta, body = body, heads = heads }
    for g in (meta.gifs or ""):gmatch("%w+") do gifsWanted[g] = true end
    for g in body:gmatch("gifs/(%w+)%.gif") do gifsWanted[g] = true end
end
for _, page in ipairs(PAGES) do
    local w = written[page]
    local issueList = {}
    for id in (w.meta.issues or ""):gmatch("%S+") do issueList[#issueList + 1] = id end
    outputs[page] = page_html(page, w.meta, w.body, w.heads, questions_for(issueList), titles)
end
-- the index: the five pages, each with its first gif and how many questions it holds
do
    local cards = {}
    for _, page in ipairs(PAGES) do
        local m = written[page].meta
        cards[#cards + 1] = string.format("<a class=card href=\"%s.html\"><img src=\"gifs/%s.gif\" alt=\"\" width=128 height=128><span><strong>%s</strong><br>%s<br><em>%s</em></span></a>",
            page, (m.gifs or ""):match("%w+") or "", esc(m.title), esc(m.subtitle or ""), esc(m.state or ""))
    end
    outputs.index = table.concat({ "<!doctype html>",
        "<!-- docs/HTML/answer-pages/index.html - GENERATED by scripts/generate-answer-pages: the five answer pages (issue 1102); don't edit, run it again. -->",
        "<html lang=en><head><meta charset=utf-8><meta name=viewport content=\"width=device-width, initial-scale=1\"><title>Answer Pages</title><style>" .. STYLE
            .. ".cards{display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(20rem,1fr))}.card{display:flex;gap:1rem;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:.8rem;color:var(--ink);text-decoration:none}.card img{background:#000;border-radius:4px;flex:none}.card em{color:var(--dim);font-size:.85rem}</style></head>",
        "<body><main style=\"max-width:70rem;margin:0 auto;padding:1.5rem 16px\"><h1>Answer pages</h1><p class=subtitle>Five parts of the architecture, each with its open questions and a box to answer each. Start <code>scripts/answer-server</code> and open <code>http://127.0.0.1:8642/answer-pages/</code> to answer.</p><div class=cards>",
        table.concat(cards), "</div></main></body></html>" }, "\n")
end

if check then
    local stale = {}
    for name, html in pairs(outputs) do
        local f = io.open(OUT .. "/" .. name .. ".html", "r")
        local old = f and f:read("*a") or ""
        if f then f:close() end
        if old:gsub("on %d+%-%d+%-%d+ %d+:%d+", "") ~= html:gsub("on %d+%-%d+%-%d+ %d+:%d+", "") then stale[#stale + 1] = name end
    end
    table.sort(stale)
    print(#stale == 0 and "ok: the answer pages are up to date" or ("stale: " .. table.concat(stale, ", ") .. " (run scripts/generate-answer-pages)"))
    os.exit(#stale == 0 and 0 or 1)
end

os.execute("mkdir -p '" .. OUT .. "'")
local copied = copy_gifs(gifsWanted)
local total, open = 0, 0
for _, it in pairs(ISSUES) do for _, q in ipairs(it.questions) do total = total + 1; if not q.answered then open = open + 1 end end end
for name, html in pairs(outputs) do
    local f = io.open(OUT .. "/" .. name .. ".html", "w") or error("cannot write " .. OUT .. "/" .. name .. ".html")
    f:write(html)
    f:close()
end
print(string.format("6 pages written to %s; %d gifs copied; %d questions in %d open issues, %d still open",
    OUT, copied, total, #IDS, open))
-- }}}
