#!/usr/bin/env luajit
-- generate-basic-sockets-sql - gather the client-side facts basic's socket
-- SQL needs, and write them into that SQL file (issue 155p, stage 3).
--
-- For a general audience: stage 3 puts gem sockets on white gear sold in
-- the capitals and on blues from vanilla's dungeons. Three facts it needs
-- live in the game client's data files, not the world database:
--   1. the honest socket bonuses: every item enchantment whose whole effect
--      is one stat and whose text says exactly that ("+4 Stamina"), with the
--      stat and the number, so a bonus is picked by stat and size and the
--      tooltip always tells the truth (docs/design-principles.md);
--   2. which maps are vanilla's 5-person dungeons (instance maps of the
--      original game, not raids);
--   3. the outlines of Azeroth's six capitals, to find the white gear their
--      vendors sell.
-- It writes them as plain data between two marker lines in the SQL file;
-- re-running replaces only that block.
--
-- Usage: scripts/generate-basic-sockets-sql [PROJECT_DIR]
--   Reads   data-files/dbc/{SpellItemEnchantment,Map,WorldMapArea}.dbc
--   Writes  sql/basic/db_world.src/20-sockets.apply.sql (GENERATED block)

local DIR = arg[1] or "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local DBC = DIR .. "/data-files/dbc/"
local OUT = DIR .. "/sql/basic/db_world.src/20-sockets.apply.sql"

-- {{{ configuration
local ENCHANT_TYPE_STAT = 5
-- the stats a socket bonus may give, and the words the client's text uses
-- for each (ITEM_MOD_* numbers from the server's SharedDefines.h)
local STAT_WORDS = {
    [3] = "Agility", [4] = "Strength", [5] = "Intellect", [6] = "Spirit", [7] = "Stamina",
    [12] = "Defense Rating", [13] = "Dodge Rating", [14] = "Parry Rating", [15] = "Block Rating",
    [31] = "Hit Rating", [32] = "Critical Strike Rating", [35] = "Resilience Rating", [36] = "Haste Rating",
    [37] = "Expertise Rating", [38] = "Attack Power", [45] = "Spell Power", [43] = "Mana every 5 seconds",
}
local MAP_INSTANCE, EXPANSION_VANILLA = 1, 0                           -- Map.dbc map_type, expansion
local CAPITALS = { [1519] = 1, [1537] = 1, [1657] = 1, [1637] = 2, [1638] = 2, [1497] = 2 }   -- area -> 1 Alliance, 2 Horde
local BEGIN_MARK = "-- >>> GENERATED by scripts/generate-basic-sockets-sql"
local END_MARK   = "-- <<< GENERATED END"
-- }}}

-- {{{ local function die
local function die(msg)
    io.stderr:write("generate-basic-sockets-sql: ", msg, "\n")
    os.exit(1)
end
-- }}}

-- {{{ local function load_dbc
-- Returns the record count, record size, a uint32 reader, a string reader
-- and a float reader.
local ffi = require("ffi")
local function load_dbc(name)
    local f = io.open(DBC .. name, "rb") or die("cannot open " .. DBC .. name)
    local d = f:read("*a")
    f:close()
    if d:sub(1, 4) ~= "WDBC" then die(name .. " is not a WDBC file") end
    local function u32(o) local a, b, c, e = d:byte(o + 1, o + 4); return a + b * 256 + c * 65536 + e * 16777216 end
    local n, rs = u32(4), u32(12)
    local sb = 20 + n * rs
    local function str(o) local so = sb + u32(o); local e = d:find("\0", so + 1, true); return d:sub(so + 1, e - 1) end
    local function flt(o) local v = ffi.new("uint32_t[1]", u32(o)); return ffi.cast("float*", v)[0] end
    return n, rs, u32, str, flt
end
-- }}}

-- {{{ local function honest_bonuses
-- SpellItemEnchantment.dbc: 0 id, 2..4 effect types, 5..7 amounts, 11..13
-- arguments, 14 text. Kept: one stat effect only, text exactly "+N <stat>".
local function honest_bonuses()
    local n, rs, u, str = load_dbc("SpellItemEnchantment.dbc")
    local out = {}
    for r = 0, n - 1 do
        local b = 20 + r * rs
        if u(b + 8) == ENCHANT_TYPE_STAT and u(b + 12) == 0 and u(b + 16) == 0 then
            local stat, amount = u(b + 44), u(b + 20)
            local words = STAT_WORDS[stat]
            if words and str(b + 56) == string.format("+%d %s", amount, words) then
                out[#out + 1] = { u(b), stat, amount }
            end
        end
    end
    return out
end
-- }}}

-- {{{ local function vanilla_dungeons
-- Map.dbc: 0 id, 2 map type, 5 name, 63 expansion.
local function vanilla_dungeons()
    local n, rs, u, str = load_dbc("Map.dbc")
    local out = {}
    for r = 0, n - 1 do
        local b = 20 + r * rs
        if u(b + 8) == MAP_INSTANCE and u(b + 63 * 4) == EXPANSION_VANILLA then out[#out + 1] = { u(b), str(b + 20) } end
    end
    return out
end
-- }}}

-- {{{ local function capital_rects
-- WorldMapArea.dbc: 1 map, 2 area, 4..7 left, right, top, bottom (floats;
-- left/right bound y, top/bottom bound x).
local function capital_rects()
    local n, rs, u, _, f = load_dbc("WorldMapArea.dbc")
    local out = {}
    for r = 0, n - 1 do
        local b = 20 + r * rs
        local side = CAPITALS[u(b + 8)]
        if side then
            local l, rt, t, bt = f(b + 16), f(b + 20), f(b + 24), f(b + 28)
            out[#out + 1] = { u(b + 8), side, u(b + 4), math.min(t, bt), math.max(t, bt), math.min(l, rt), math.max(l, rt) }
        end
    end
    if #out ~= 6 then die("found " .. #out .. " capital rectangles, expected 6") end
    return out
end
-- }}}

-- {{{ main
local bonuses, dungeons, capitals = honest_bonuses(), vanilla_dungeons(), capital_rects()
if #bonuses == 0 or #dungeons == 0 then die("empty list (bonuses " .. #bonuses .. ", dungeons " .. #dungeons .. ")") end
local bo, du, ca, names = {}, {}, {}, {}
for _, r in ipairs(bonuses) do bo[#bo + 1] = string.format("(%d,%d,%d)", r[1], r[2], r[3]) end
for _, r in ipairs(dungeons) do du[#du + 1] = string.format("(%d)", r[1]); names[#names + 1] = r[2] end
for _, r in ipairs(capitals) do ca[#ca + 1] = string.format("(%d,%d,%d,%.0f,%.0f,%.0f,%.0f)", r[1], r[2], r[3], r[4], r[5], r[6], r[7]) end
local block = table.concat({
    BEGIN_MARK .. " — do not edit by hand",
    "-- honest one-stat enchantments (SpellItemEnchantment.dbc): enchantment, stat, amount: " .. #bo,
    "INSERT INTO `tmp_155p_bonus` (`enchant`, `stat`, `amount`) VALUES " .. table.concat(bo, ",") .. ";",
    "-- vanilla 5-person dungeons (Map.dbc): " .. table.concat(names, ", "),
    "INSERT INTO `tmp_155p_dungeons` (`map_id`) VALUES " .. table.concat(du, ",") .. ";",
    "-- Azeroth's capitals: area, side, map, x and y bounds (WorldMapArea.dbc)",
    "INSERT INTO `tmp_155p_capitals` (`area`, `side`, `map`, `x0`, `x1`, `y0`, `y1`) VALUES " .. table.concat(ca, ",") .. ";",
    END_MARK }, "\n")
local f = io.open(OUT, "r") or die("cannot open " .. OUT)
local sql = f:read("*a")
f:close()
local a = sql:find(BEGIN_MARK, 1, true)
local b = sql:find(END_MARK, 1, true)
if not a or not b or b < a then die("markers not found in " .. OUT) end
sql = sql:sub(1, a - 1) .. block .. sql:sub(b + #END_MARK)
f = assert(io.open(OUT, "w"))
f:write(sql)
f:close()
io.write(string.format("wrote %d honest bonuses, %d vanilla dungeons, %d capitals into %s\n", #bonuses, #dungeons, #capitals, OUT))
-- }}}
