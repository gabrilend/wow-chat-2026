#!/usr/bin/env bash
# test-change-character-class - check, without a database, that the class
# change planner removes exactly the old class and nothing else, and that
# running it twice changes nothing the second time.
#
# For a general audience: scripts/change-character-class turns a character
# into another class. Its thinking part (scripts/lib/class-change-sql.lua)
# reads a small description of the character and writes SQL. This test
# hands it a level 44 blood elf warlock shaped like the first character it
# was used on (Felicity, 2026-10-14): warlock skill lines and spells, the
# Felsteed, riding, cloth, staves, daggers, wands, mounts and companion
# pets. It checks the plan for a priest, then describes the character as
# the plan leaves it and plans again: the second plan must be empty.
# The three mistakes the first dry runs made are each a check here.
#
# Usage: scripts/test-change-character-class [PROJECT_DIR]

set -euo pipefail

DIR="/mnt/kaun/wow-chat-2026"
if [[ -n "${1:-}" ]]; then DIR="$1"; fi
PLANNER="${DIR}/scripts/lib/class-change-sql.lua"
WORK="${DIR}/tmp/shared-memory/test-change-character-class"
mkdir -p "${WORK}"

PASS=0
FAIL=0
# {{{ check
check() {
    local what="$1"
    local ok="$2"
    if [[ "${ok}" == "yes" ]]; then PASS=$((PASS + 1)); echo "  ok    ${what}"
    else FAIL=$((FAIL + 1)); echo "  FAIL  ${what}"; fi
}
# }}}
has() { if grep -qE "$2" "$1"; then echo yes; else echo no; fi; }
lacks() { if grep -qE "$2" "$1"; then echo no; else echo yes; fi; }

# {{{ the warlock
STATE="${WORK}/warlock.tsv"
{
    printf 'char\t577\t10\t9\t44\n'
    for s in "95 1 220" "109 300 300" "136 1 220" "137 300 300" "162 1 220" "173 1 220" \
             "183 220 220" "228 1 220" "354 220 220" "355 220 220" "415 1 1" "593 220 220" \
             "756 220 220" "762 75 75" "777 1 220" "778 1 220"; do
        printf 'skill\t%s\t%s\t%s\n' ${s}
    done
    # Shadow Bolt (686 rank 1 is not held; 1088 is a later rank), Corruption
    # 172, Summon Imp 688, Felsteed 5784, Apprentice Riding 33388
    for sp in 1088 172 688 5784 33388; do printf 'spell\t%s\n' "${sp}"; done
} > "${STATE}"
# }}}

echo "Warlock to priest:"
PLAN="${WORK}/plan1.sql"
luajit "${PLANNER}" "${DIR}" "${STATE}" 5 "${PLAN}" > "${WORK}/report1.txt"
check "removes the three warlock skill lines"          "$(has   "${PLAN}" 'skill IN \(354,355,593\);')"
check "keeps Mounts and Companion Pets (2nd dry run)"  "$(lacks "${PLAN}" 'skill IN \([^)]*(777|778)')"
check "adds Holy, Shadow Magic and Discipline"          "$(has   "${PLAN}" 'VALUES \(577, 613, 220, 220\)')"
check "adds no other class's lines (1st dry run)"       "$(lacks "${PLAN}" 'VALUES \(577, (769|771),')"
check "removes the Felsteed (2nd dry run)"              "$(has   "${PLAN}" 'spell IN \([^)]*5784')"
check "keeps Apprentice Riding"                         "$(lacks "${PLAN}" 'spell IN \([^)]*33388')"
check "removes their action-bar buttons"                "$(has   "${PLAN}" 'DELETE FROM character_action WHERE guid = 577 AND type = 0')"
check "sets the class and resets talents"               "$(has   "${PLAN}" 'SET class = 5, at_login = at_login \| 4')"
# owner, 2026-10-15: Felicity arrived with staves at 7 and wands at 11 of
# 220; a changed character's weapon skills (defense too) are now full
check "raises kept weapon skills to full (staves, wands)" "$(has "${PLAN}" 'SET value = 220, max = 220 WHERE guid = 577 AND skill = 136;')"
check "raises defense to full"                            "$(has "${PLAN}" 'SET value = 220, max = 220 WHERE guid = 577 AND skill = 95;')"

# {{{ the priest the plan leaves
STATE2="${WORK}/priest.tsv"
{
    printf 'char\t577\t10\t5\t44\n'
    # the warlock's skills less its class lines, its weapon skills (and
    # defense) now full, as the plan's raises leave them
    grep '^skill' "${STATE}" | grep -vE $'^skill\t(354|355|593)\t' \
        | sed -E $'s/^skill\t(95|136|162|173|228)\t1\t220$/skill\t\\1\t220\t220/'
    printf 'skill\t56\t220\t220\nskill\t78\t220\t220\nskill\t613\t220\t220\n'
    printf 'spell\t33388\n'
} > "${STATE2}"
# }}}

echo "Second run on the priest (must change nothing):"
PLAN2="${WORK}/plan2.sql"
luajit "${PLANNER}" "${DIR}" "${STATE2}" 5 "${PLAN2}" > "${WORK}/report2.txt"
check "no deletes"                    "$(lacks "${PLAN2}" '^DELETE')"
check "no inserts"                    "$(lacks "${PLAN2}" '^INSERT')"
check "talents and class untouched"   "$(lacks "${PLAN2}" '^UPDATE')"

echo "${PASS} passed, ${FAIL} failed"
[[ "${FAIL}" == "0" ]]
