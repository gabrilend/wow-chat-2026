#!/usr/bin/env luajit

local DIR   = arg[1] or "/mnt/kaun/wow-chat-2026"
local DB    = arg[2] or "acore_world_release"
local DBC   = DIR .. "/data-files/dbc/"
local OUT   = DIR .. "/sql/basic/db_world.src/22-ability-tomes.apply.sql"
local MYSQL = DIR .. "/mysql/installed-files/bin/mysql -h127.0.0.1 -P3307 -uritz -pmenardi -N --batch " .. DB

local LEVEL_LO, LEVEL_HI = 61, 80
local FIRST_ITEM         = 1557001
local LAST_ITEM          = 1557999
local EXCLUDED = {
    [53140] = "Teleport: Dalaran (Northrend is closed on basic, 155s)",
    [53142] = "Portal: Dalaran (Northrend is closed on basic, 155s)",
}
local ALL_RACES = 1 + 2 + 4 + 8 + 16 + 32 + 64 + 128 + 512 + 1024
local EFFECT_LEARN_SPELL = 36
local BEGIN_MARK = "-- >>> GENERATED by scripts/generate-basic-ability-tomes-sql"
local END_MARK   = "-- <<< GENERATED END"

local function die(msg)
    io.stderr:write("generate-basic-ability-tomes-sql: ", msg, "\n")
    os.exit(1)
end

local function u32(d, o) local a, b, c, e = d:byte(o + 1, o + 4); return a + b * 256 + c * 65536 + e * 16777216 end

local function load_dbc(name)
    local f = io.open(DBC .. name, "rb") or die("cannot open " .. DBC .. name)
    local d = f:read("*a")
    f:close()
    if d:sub(1, 4) ~= "WDBC" then die(name .. " is not a WDBC file") end
    local n, rs = u32(d, 4), u32(d, 12)
    local strings = 20 + n * rs
    local function str(o)
        local s = strings + u32(d, o)
        return d:sub(s + 1, (d:find("\0", s + 1, true) or s + 1) - 1)
    end
    return n, rs, function(o) return u32(d, o) end, str
end

local function query(sql)
    local p = io.popen(MYSQL .. " -e \"" .. sql .. "\" 2>&1")
    local rows = {}
    for line in p:lines() do
        if line:find("^mysql: %[Warning%]") then
        elseif line:find("^ERROR") then
            die("query failed: " .. line)
        else
            local r = {}
            for v in line:gmatch("[^\t]+") do r[#r + 1] = tonumber(v) or v end
            rows[#rows + 1] = r
        end
    end
    p:close()
    return rows
end

local function roman(n)
    local out, vals = "", { {1000,"M"},{900,"CM"},{500,"D"},{400,"CD"},{100,"C"},{90,"XC"},{50,"L"},{40,"XL"},{10,"X"},{9,"IX"},{5,"V"},{4,"IV"},{1,"I"} }
    for _, v in ipairs(vals) do while n >= v[1] do out = out .. v[2]; n = n - v[1] end end
    return out
end

local function sql_string(s) return "'" .. s:gsub("\\", "\\\\"):gsub("'", "''") .. "'" end

local trainer = {}
local wanted  = {}
for _, r in ipairs(query("SELECT DISTINCT t.Requirement, s.SpellId, s.ReqLevel, s.ReqAbility1 FROM trainer t JOIN trainer_spell s ON s.TrainerId = t.Id WHERE t.Type = 0")) do
    local class, spell, level, req1 = r[1], r[2], r[3], r[4]
    trainer[class] = trainer[class] or {}
    local old = trainer[class][spell]
    if old and (old.level ~= level or old.req1 ~= req1) then
        die(string.format("class %d's trainers teach spell %d two ways (level %d/%d, needing %d/%d)", class, spell, old.level, level, old.req1, req1))
    end
    trainer[class][spell] = { level = level, req1 = req1 }
    wanted[spell] = true
end

local sn, srs, su, sstr = load_dbc("Spell.dbc")
local spell_info = {}
for r = 0, sn - 1 do
    local b = 20 + r * srs
    local id = su(b)
    if wanted[id] then
        spell_info[id] = { name = sstr(b + 136 * 4), rank = sstr(b + 153 * 4),
                           effect = su(b + 71 * 4), trigger = su(b + 116 * 4) }
    end
end

local an, ars, au = load_dbc("SkillLineAbility.dbc")
local races = {}
for r = 0, an - 1 do
    local b = 20 + r * ars
    local spell, mask = au(b + 8), au(b + 12)
    if wanted[spell] then races[spell] = bit.bor(races[spell] or 0, mask) end
end

local books, skipped, wrappers = {}, {}, 0
for class, spells in pairs(trainer) do for spell, t in pairs(spells) do
    if t.level >= LEVEL_LO and t.level <= LEVEL_HI then
        if EXCLUDED[spell] then
            skipped[#skipped + 1] = spell .. " " .. EXCLUDED[spell]
        else
            local info = spell_info[spell] or die("spell " .. spell .. " is on a trainer but not in Spell.dbc")
            local taught = spell
            if info.effect == EFFECT_LEARN_SPELL and info.trigger ~= 0 then taught = info.trigger; wrappers = wrappers + 1 end
            local req, seen = t.req1, 0
            while req ~= 0 and spells[req] do
                req = spells[req].req1
                seen = seen + 1
                if seen > 40 then die("prerequisite chain of spell " .. spell .. " loops") end
            end
            local mask = races[spell] or 0
            if bit.band(mask, ALL_RACES) == ALL_RACES then mask = 0 end
            local n = tonumber(info.rank:match("^Rank (%d+)$"))
            local title = info.name .. ((n and n > 1) and (" " .. roman(n)) or "")
            local teaches = "Teaches " .. info.name .. (n and (" (Rank " .. n .. ")") or "") .. "."
            books[#books + 1] = { spell = spell, taught = taught, class = class, level = t.level,
                                  talent = req, races = mask, title = title, teaches = teaches }
        end
    end
end end
table.sort(books, function(a, b)
    if a.class ~= b.class then return a.class < b.class end
    if a.level ~= b.level then return a.level < b.level end
    return a.spell < b.spell
end)
if #books == 0 then die("no trainer spells at levels 61-80; is " .. DB .. " the stock world database?") end
if FIRST_ITEM + #books - 1 > LAST_ITEM then die(#books .. " books do not fit in items " .. FIRST_ITEM .. "-" .. LAST_ITEM) end

local rows, talents, faction = {}, 0, 0
for i, b in ipairs(books) do
    if b.talent ~= 0 then talents = talents + 1 end
    if b.races ~= 0 then faction = faction + 1 end
    rows[#rows + 1] = string.format("(%d,%d,%d,%d,%d,%d,%d,%s,%s)", FIRST_ITEM + i - 1, b.spell, b.taught, b.class, b.level, b.talent, b.races, sql_string(b.title), sql_string(b.teaches))
end
local block = table.concat({
    BEGIN_MARK .. " — do not edit by hand",
    string.format("-- class trainer spells at levels %d-%d (stock trainer lists, Spell.dbc, SkillLineAbility.dbc): %d books,", LEVEL_LO, LEVEL_HI, #books),
    string.format("-- %d needing a talent, %d limited to some races, %d teaching spells unwrapped; left out: %s", talents, faction, wrappers, (#skipped > 0 and table.concat(skipped, "; ") or "none")),
    "INSERT INTO `tmp_155q_books` (`item`, `spell`, `taught`, `class`, `level`, `talent`, `races`, `title`, `teaches`) VALUES",
    table.concat(rows, ",\n") .. ";",
    END_MARK }, "\n")
local f = io.open(OUT, "r") or die("cannot open " .. OUT)
local sql = f:read("*a")
f:close()
local a = sql:find(BEGIN_MARK, 1, true)
local b = sql:find(END_MARK, 1, true)
if not a or not b or b < a then die("markers not found in " .. OUT) end
sql = sql:sub(1, a - 1) .. block .. sql:sub(b + #END_MARK)
f = assert(io.open(OUT, "w"))
f:write(sql)
f:close()
io.write(string.format("wrote %d books (%d need a talent, %d race-limited, %d unwrapped, %d left out) into %s\n",
    #books, talents, faction, wrappers, #skipped, OUT))
