#!/usr/bin/env luajit
-- test-client-models - checks how the custom client reads the original
-- game's files (issue 173d), without opening a window.
--
-- For a general audience: the custom client draws the real night elf by
-- reading the original 3.3.5a client's archives in place. This checks
-- each step on the real files: the archives' scrambling recipe gives its
-- known answers; the night elf's model, mesh, skin picture and tables are
-- found and read; her model stands as tall as the game says a night elf
-- woman is; her pictures decode to the right size; and putting her
-- together keeps her body and her chosen hair style while hiding every
-- other hair style and every clothing shape, and paints her face onto her
-- skin sheet.
--
-- Usage: scripts/test-client-models [PROJECT_DIR] [CLIENT_DATA_DIR]

-- {{{ configuration
local DIR    = "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local CLIENT = "/mnt/dile/ritz/games/World of Warcraft 3.3.5a/Data"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end
if arg[2] and arg[2] ~= "" then CLIENT = arg[2] end
package.path = DIR .. "/src/custom-client/?.lua;" .. package.path
-- }}}

local Mpq, M2, Blp, Dbc, Character = require("lib.mpq"), require("lib.m2"), require("lib.blp"), require("lib.dbc"), require("lib.character")

local fails, checks = 0, 0
-- {{{ local function check
local function check(ok, what)
    checks = checks + 1
    if ok then print("  ok:   " .. what) else print("  FAIL: " .. what); fails = fails + 1 end
end
-- }}}

print("the archives")
-- the format's two published table keys (any MPQ reader gives these)
check(Mpq.hash("(hash table)", 3) == 0xC3AF3770, "the index's key is C3AF3770")
check(Mpq.hash("(block table)", 3) == 0xEC83B3A3, "the block list's key is EC83B3A3")
check(Mpq.hash("a/b", 0) == Mpq.hash("A\\B", 0), "names match without regard to case or slash")
local c = Mpq.chain(CLIENT, "enUS")
check(#c.archives == 13, string.format("all 13 of the client's archives open (%d)", #c.archives))
local base = "Character\\NightElf\\Female\\NightElfFemale"
local m2s, from = c:read(base .. ".m2")
check(m2s and m2s:sub(1, 4) == "MD20", "her model is found and begins as a model does")
check(from and from:match("patch%-3%.MPQ$"), "and it is the newest patch's copy (patch-3)")
check(c:read("No\\Such\\File.m2") == nil, "a file no archive holds is nil, not an error")

print("her model")
local m = M2.read(m2s, c:read(base .. "00.skin"), base)
local zmax = -1e9
for _, v in ipairs(m.vertices) do zmax = math.max(zmax, v[3]) end
check(math.abs(zmax - 2.29) < 0.02, string.format("she stands %.2f yards tall (the stand-in was 2.3)", zmax))
check(#m.indices % 3 == 0 and #m.indices > 0, string.format("%d triangles", #m.indices / 3))
local in_range = true
for _, i in ipairs(m.indices) do if i < 1 or i > #m.vertices then in_range = false end end
check(in_range, "every triangle's corners are real points of the model")
check(m.textures[1].kind == 1 and m.textures[2].kind == 6, "her first picture is her skin, her second her hair")

print("pictures")
local skin = Blp.decode(c:read(base .. "Skin00_00.blp"))
check(skin.width == 512 and skin.height == 512 and #skin.rgba == 512 * 512 * 4, "her skin sheet decodes to 512 x 512")
local hair = Blp.decode(c:read("Character\\NightElf\\Hair00_00.blp"))
local cut = false
for i = 4, #hair.rgba, 4 do if hair.rgba:byte(i) < 128 then cut = true; break end end
check(cut, "her hair picture has see-through strands (alpha)")
check(#Dbc.read(c:read("DBFilesClient\\CharSections.dbc"), { [5] = true, [6] = true, [7] = true }) > 1000, "the character pictures table reads (over a thousand rows)")

print("putting her together")
local ch = Character.build(c, { race = 4, sex = 1, skin = 0, face = 0, hair_style = 0, hair_color = 0 })
local ids = {}
for _, p in ipairs(ch.model.pieces) do ids[p.id] = true end
check(ids[0] and ids[2], "her body (0) and hair style 0's piece (2) show")
local others = false
for id = 3, 13 do if ids[id] then others = true end end
check(not others, "no other hair style shows")
check(not (ids[1002] or ids[1102] or ids[1202] or ids[1302] or ids[1502] or ids[802]), "no clothing shapes show (sleeves, robe, tabard, cape)")
check(ids[401] and ids[501] and ids[702], "bare hands, bare feet, and her ears show")
-- the face patch (256 x 320 to 512 x 512 on a 512 sheet) differs from the bare skin once the face is laid on
local sheet, changed = ch.images[1].rgba, 0
for y = 384, 511, 8 do
    for x = 8, 255, 8 do
        local o = (y * 512 + x) * 4 + 1
        if sheet:byte(o) ~= skin.rgba:byte(o) then changed = changed + 1 end
    end
end
check(changed > 50, string.format("her face is painted onto her skin sheet (%d of 512 samples changed)", changed))
check(ch.images[6] and ch.images[6].width > 0, "her hair has its picture")

print(fails == 0 and ("All " .. checks .. " checks passed") or (fails .. " of " .. checks .. " checks failed"))
os.exit(fails == 0 and 0 or 1)
