    fi
}
# -- }}}

# -- {{{ extract_custom_config
# Extract non-default values from a config file by comparing to .dist
# Outputs KEY=VALUE pairs for values that differ from defaults
# Args: $1 = config file path (the .dist will be inferred)
extract_custom_config() {
    local conf="$1"
    local dist="${conf}.dist"

    if [[ ! -f "${conf}" || ! -f "${dist}" ]]; then
        return
    fi

    # Compare each non-comment, non-empty line
    while IFS= read -r line; do
        # Skip comments and empty lines
        [[ "${line}" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line}" ]] && continue

        # Extract key (everything before first =)
        local key="${line%%=*}"
        key="${key%%[[:space:]]}"  # Trim trailing spaces

        # Skip if no = found
        [[ "${key}" == "${line}" ]] && continue

        # Get the full line from dist file for this key
        local dist_line=$(grep "^${key}[[:space:]]*=" "${dist}" 2>/dev/null | head -1)

        # If line differs from dist, output it
        if [[ -n "${dist_line}" && "${line}" != "${dist_line}" ]]; then
            echo "${line}"
        fi
    done < "${conf}"
}
# -- }}}

# -- {{{ apply_custom_config
# Apply custom config values to a config file
# Reads KEY=VALUE pairs from stdin and applies them via sed
# Args: $1 = config file path
apply_custom_config() {
    local conf="$1"

    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue

        # Extract key (everything before first =, trimmed)
        local key="${line%%=*}"
        key="${key%%[[:space:]]}"

        # Escape special characters for sed
        local escaped_line=$(printf '%s\n' "${line}" | sed 's/[&/\]/\\&/g')

        # Replace line matching this key
        sed -i "s|^${key}[[:space:]]*=.*|${escaped_line}|" "${conf}"
    done
}
# -- }}}

# -- {{{ init_config
# Initialize a config file from .dist, preserving custom values
# Args: $1 = config file path (without .dist)
init_config() {
    local conf="$1"
    local dist="${conf}.dist"

    if [[ ! -f "${dist}" ]]; then
        echo "  Warning: ${dist} not found"
        return 1
    fi

    # Extract custom values before overwriting
    local custom_values=""
    if [[ -f "${conf}" ]]; then
        custom_values=$(extract_custom_config "${conf}")
    fi

    # Copy dist to conf
    cp -f "${dist}" "${conf}"

    # Re-apply custom values
    if [[ -n "${custom_values}" ]]; then
        echo "${custom_values}" | apply_custom_config "${conf}"
    fi
}
# -- }}}

# =============================================================================
# Build Patch System
# =============================================================================
# Three-phase patch system: BEGIN (pre-compile), MIDDLE (compile), END (post)
# Each patch is idempotent and atomic. Parallelizable patches run concurrently.
# See docs/patches/patch-registry.md for full documentation.
# Patches are stored in patches/*.sh - each file contains patch + unpatch functions
# =============================================================================

# Source all patch functions from patches/ directory
source "${DIR}/patches/patches.sh"

# -- {{{ patches_need_applying
# Check if any PHASE_BEGIN patches would modify source (Issue 112, formerly 326)
# Returns 0 (true) if patches need applying, 1 (false) if all applied
# This prevents early exit when new patches are added but upstream unchanged
patches_need_applying() {
    local FILE

    # B001: aoe-loot item namespace
    FILE="${AC_CODE_DIR}/modules/mod-aoe-loot/src/aoe_loot.cpp"
    if [[ -f "${FILE}" ]] && grep -q "^[[:space:]]*Item\* pItem = player->GetItemByGuid" "${FILE}"; then
        return 0  # B001 needs applying
    fi

    # B002: playerbots ALE login hook
    FILE="${AC_CODE_DIR}/modules/mod-playerbots/src/Bot/RandomPlayerbotMgr.cpp"
    if [[ -f "${FILE}" ]] && ! grep -q "sALE->OnLogin(bot)" "${FILE}"; then
        return 0  # B002 needs applying
    fi

    # B003: ALE gameobject wildcard
    FILE="${AC_CODE_DIR}/modules/mod-ale/src/LuaEngine/LuaEngine.cpp"
    if [[ -f "${FILE}" ]] && ! grep -q "entry != 0 && !eObjectMgr->GetGameObjectTemplate" "${FILE}"; then
        return 0  # B003 needs applying
    fi

    # B004: upstream warning fixes (multiple files - check one representative)
    FILE="${AC_CODE_DIR}/modules/mod-playerbots/src/strategy/values/BudgetValues.cpp"
    if [[ -f "${FILE}" ]] && grep -q "int32 BudgetCalculator::CalculateMaxBudget" "${FILE}"; then
        return 0  # B004 needs applying (warning fix not applied)
    fi

    # B005: accuracy level cap
    FILE="${AC_CODE_DIR}/src/server/game/Entities/Unit/Unit.h"
    if [[ -f "${FILE}" ]] && ! grep -q "#define ACCURACY_LEVEL_CAP 3" "${FILE}"; then
        return 0  # B005 needs applying
    fi

    # B006: ALE sell item hook
    FILE="${AC_CODE_DIR}/modules/mod-ale/src/LuaEngine/Hooks.h"
    if [[ -f "${FILE}" ]] && ! grep -q "PLAYER_EVENT_ON_SELL_ITEM" "${FILE}"; then
        return 0  # B006 needs applying
    fi

    # B007: ALE unit methods (SetWalk, SetRun, etc.)
    FILE="${AC_CODE_DIR}/modules/mod-ale/src/LuaEngine/UnitMethods.h"
    if [[ -f "${FILE}" ]] && ! grep -q "int SetWalk" "${FILE}"; then
        return 0  # B007 needs applying
    fi

    # B008: mod-talent-bonus (check if module exists and is linked)
    FILE="${AC_CODE_DIR}/modules/mod-talent-bonus/src/TalentBonus.cpp"
    if [[ ! -f "${FILE}" ]]; then
        return 0  # B008 needs applying (module not linked)
    fi

    return 1  # All patches already applied
}
# -- }}}

# -- {{{ apply_patches_middle
# PHASE_MIDDLE: Compile-time adjustments
# Reserved for future use (build tuning, caching, etc.)
apply_patches_middle() {
    # Currently empty - compilation handled by do_build
    :
}
# -- }}}

# =============================================================================
# Config Value Orchestrator (Issue 119, formerly 407)
# =============================================================================
# Profile-aware configuration registry
# Each config is a function in config/config-registry.sh
# Applies configs based on profile specification
# =============================================================================

# -- {{{ apply_config_values
# Apply all config values for current profile (Issue 119, formerly 407)
# Called after init_config() copies .dist to .conf
# Sources all config patch files from config/patches/
apply_config_values() {
    echo "Applying config values for profile: ${PROFILE}..."

    # Check if config patches directory exists
    if [[ ! -d "${DIR}/config/patches" ]]; then
        echo "  Warning: config/patches/ directory not found, using defaults"
        return 0
    fi

    # Declare profile mapping array
    declare -A CONFIG_PROFILES

    # Source all config patch files
    local patch_count=0
    for patch_file in "${DIR}/config/patches"/C*.sh; do
        [[ -f "${patch_file}" ]] || continue
        source "${patch_file}"
        ((patch_count++))
    done

    if [[ ${patch_count} -eq 0 ]]; then
        echo "  Warning: No config patches found in config/patches/"
        return 0
    fi

    # Get list of all config functions
    local config_funcs=$(declare -F | grep "^declare -f config_" | sed 's/declare -f //')

    local applied_count=0
    for func in ${config_funcs}; do
        # Check if this config applies to current profile
        local profiles="${CONFIG_PROFILES[$func]:-}"
        if [[ " ${profiles} " =~ " ${PROFILE} " ]] || [[ " ${profiles} " =~ " all " ]]; then
            ${func}
            echo "  [✓] ${func}"
            ((applied_count++))
        fi
    done

    echo "  Applied ${applied_count} config values from ${patch_count} patches"
}
# -- }}}

# -- {{{ patch_E001_lua_script_symlinks
# Create symlinks from install dir to project Lua sources
# Parallelizable: Yes (unique directory)
# Uses TARGET_INSTALL_DIR (defaults to INSTALL_DIR, can be set to INSTALL_DIR_SHADOW)
patch_E001_lua_script_symlinks() {
    local TARGET="${TARGET_INSTALL_DIR:-${INSTALL_DIR}}"
    mkdir -p "${TARGET}/bin/lua_scripts"
    ln -sfn "${DIR}/src/lua" "${TARGET}/bin/lua_scripts/custom"
    if [[ -d "${DIR}/src/lua/extensions" ]]; then
        ln -sfn "${DIR}/src/lua/extensions" "${TARGET}/bin/lua_scripts/extensions"
    fi
    echo "  [E001] Lua script symlinks"
}

unpatch_E001_lua_script_symlinks() {
    local TARGET="${TARGET_INSTALL_DIR:-${INSTALL_DIR}}"
    [[ -L "${TARGET}/bin/lua_scripts/custom" ]] && rm "${TARGET}/bin/lua_scripts/custom"
    [[ -L "${TARGET}/bin/lua_scripts/extensions" ]] && rm "${TARGET}/bin/lua_scripts/extensions"
    echo "  [E001] Removed Lua script symlinks"
}
# -- }}}

# -- {{{ patch_E004_log_directory_setup
# Create RAM-backed log directory symlink
# Parallelizable: Yes (unique target)
patch_E004_log_directory_setup() {
    local TMP_BASE="/tmp/wow-chat-2"
    local TMP_LOGS="${TMP_BASE}/logs-${PROFILE}"
    mkdir -p "${TMP_BASE}"
    mkdir -p "${TMP_LOGS}"
    [[ -L "${DIR}/tmp" ]] || ln -s "${TMP_BASE}" "${DIR}/tmp"
    [[ -L "${DIR}/logs-${PROFILE}" ]] || ln -s "${TMP_LOGS}" "${DIR}/logs-${PROFILE}"
    echo "  [E004] Log directory setup"
}

unpatch_E004_log_directory_setup() {
    [[ -L "${DIR}/tmp" ]] && rm "${DIR}/tmp"
    [[ -L "${DIR}/logs-${PROFILE}" ]] && rm "${DIR}/logs-${PROFILE}"
    echo "  [E004] Removed log directory symlinks"
}
# -- }}}

# -- {{{ patch_E005_dk_levelstats
# Apply Death Knight level 1-20 stats to database
# Required before worldserver first start (Issue 206, formerly 138)
# Parallelizable: No (database operation)
patch_E005_dk_levelstats() {
    local MYSQL_SOCKET="${DIR}/mysql/databases/mysql.sock"
    local DB_WORLD="acore_world_${PROFILE}"
    local SQL_FILE="${DIR}/sql/custom/db_world/death-knights-levelstats.sql"

    # Skip if MySQL not running
    [[ ! -S "${MYSQL_SOCKET}" ]] && return 0

    # Skip if SQL file doesn't exist
    [[ ! -f "${SQL_FILE}" ]] && return 0

    # Check if DK level 1 stats already exist
    local dk_exists=$("${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" \
        -u ritz -pmenardi "${DB_WORLD}" \
        -N -e "SELECT COUNT(*) FROM player_class_stats WHERE Class = 6 AND Level = 1;" 2>/dev/null || echo "0")

    if [[ "${dk_exists}" == "0" ]]; then
        echo "  [E005] Applying DK level stats to ${DB_WORLD}"
        "${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" \
            -u ritz -pmenardi "${DB_WORLD}" < "${SQL_FILE}" 2>/dev/null || true
    fi
}

unpatch_E005_dk_levelstats() {
    local MYSQL_SOCKET="${DIR}/mysql/databases/mysql.sock"
    local DB_WORLD="acore_world_${PROFILE}"

    # Skip if MySQL not running
    [[ ! -S "${MYSQL_SOCKET}" ]] && return 0

    # Delete DK level 1-20 stats (Class=6 is Death Knight)
    echo "  [E005] Removing DK level stats from ${DB_WORLD}"
    "${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" \
        -u ritz -pmenardi "${DB_WORLD}" \
        -e "DELETE FROM player_class_stats WHERE Class = 6 AND Level BETWEEN 1 AND 20;" 2>/dev/null || true
}
# -- }}}

# -- {{{ patch_E006_initialize_config_files
# Initialize config files (.dist → .conf) and apply profile-specific values
# Runs after build completes (PHASE_END)
# Parallelizable: No (sequential file operations)
# Uses TARGET_INSTALL_DIR (defaults to INSTALL_DIR, can be set to INSTALL_DIR_SHADOW)
patch_E006_initialize_config_files() {
    local TARGET="${TARGET_INSTALL_DIR:-${INSTALL_DIR}}"
    echo "  [E006] Initializing config files..."

    # Copy .dist files to .conf
    if [[ -f "${TARGET}/etc/authserver.conf.dist" ]]; then
        cp -f "${TARGET}/etc/authserver.conf.dist" "${TARGET}/etc/authserver.conf"
    fi

    if [[ -f "${TARGET}/etc/worldserver.conf.dist" ]]; then
        cp -f "${TARGET}/etc/worldserver.conf.dist" "${TARGET}/etc/worldserver.conf"
    fi

    # Initialize module configs
    for conf_dist in "${TARGET}/etc/modules/"*.conf.dist; do
        if [[ -f "${conf_dist}" ]]; then
            cp -f "${conf_dist}" "${conf_dist%.dist}"
        fi
    done

    # Apply profile-specific config values (database, paths, gameplay settings)
    # Temporarily override INSTALL_DIR for config patches
    local ORIG_INSTALL_DIR="${INSTALL_DIR}"
    INSTALL_DIR="${TARGET}"
    apply_config_values
    INSTALL_DIR="${ORIG_INSTALL_DIR}"
}

unpatch_E006_initialize_config_files() {
    local TARGET="${TARGET_INSTALL_DIR:-${INSTALL_DIR}}"
    echo "  [E006] Removing config files (keeping .dist)..."

    # Remove .conf files (leave .dist files intact)
    [[ -f "${TARGET}/etc/authserver.conf" ]] && rm "${TARGET}/etc/authserver.conf"
    [[ -f "${TARGET}/etc/worldserver.conf" ]] && rm "${TARGET}/etc/worldserver.conf"
    [[ -f "${TARGET}/etc/dbimport.conf" ]] && rm "${TARGET}/etc/dbimport.conf"

    # Remove module configs
    for conf in "${TARGET}/etc/modules/"*.conf; do
        if [[ -f "${conf}" && -f "${conf}.dist" ]]; then
            rm "${conf}"
        fi
    done
}
# -- }}}

# apply_patches_end is now defined in patches/patches.sh with profile-aware lists

# -- {{{ check_git_status
# Check if a git repo is at the expected state
# Returns 0 if up-to-date, 1 if needs update
# Args: $1 = directory, $2 = expected commit (empty = check remote HEAD)
check_git_status() {
    local repo_dir="$1"
    local expected_commit="$2"

    if [[ ! -d "${repo_dir}/.git" ]]; then
        return 1  # Not a git repo, needs clone
    fi

    cd "${repo_dir}"
    local current_head=$(git rev-parse HEAD)

    if [[ -n "${expected_commit}" ]]; then
        # Pinned commit - check if we're at that commit
        if [[ "${current_head}" == "${expected_commit}"* ]]; then
            cd - > /dev/null
            return 0  # Up to date
        fi
    else
        # No pinned commit - check against remote
        git fetch --quiet 2>/dev/null || true
        local remote_head=$(git rev-parse @{u} 2>/dev/null || echo "")
        if [[ -n "${remote_head}" && "${current_head}" == "${remote_head}" ]]; then
            cd - > /dev/null
            return 0  # Up to date
        fi
    fi

    cd - > /dev/null
    return 1  # Needs update
}
# -- }}}

# =============================================================================
# Parallel Status Check System (issue 323)
# =============================================================================
# Runs git status checks in parallel with live spinner feedback.
# Uses temp files for IPC and ANSI codes for cursor control.
# =============================================================================

# -- {{{ Spinner and display configuration
SPINNER_CHARS="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
SPINNER_LEN=10
CHECK_TMP_DIR="/tmp/wow-chat-2/parallel-checks"

# Parallel check data arrays (populated by parallel_check_add)
declare -a PCHECK_NAMES=()
declare -a PCHECK_DIRS=()
declare -a PCHECK_COMMITS=()
# -- }}}

# -- {{{ parallel_check_init
# Initialize parallel check system
parallel_check_init() {
    PCHECK_NAMES=()
    PCHECK_DIRS=()
    PCHECK_COMMITS=()
    rm -rf "${CHECK_TMP_DIR}"
    mkdir -p "${CHECK_TMP_DIR}"
}
# -- }}}

# -- {{{ parallel_check_add
# Add a repo to check
# Args: $1 = display name, $2 = repo_dir, $3 = expected_commit (optional)
parallel_check_add() {
    PCHECK_NAMES+=("$1")
    PCHECK_DIRS+=("$2")
    PCHECK_COMMITS+=("${3:-}")
}
# -- }}}

# -- {{{ parallel_check_worker
# Background worker that checks a single repo and writes result to temp file
# Args: $1 = name, $2 = repo_dir, $3 = expected_commit
parallel_check_worker() {
    local name="$1"
    local repo_dir="$2"
    local expected_commit="$3"
    local status_file="${CHECK_TMP_DIR}/${name}.status"

    # Initial status
    echo "checking" > "${status_file}"

    # Check if repo exists
    if [[ ! -d "${repo_dir}/.git" ]]; then
        echo "missing" > "${status_file}"
        return
    fi

    # Get current HEAD
    local current_head
    current_head=$(git -C "${repo_dir}" rev-parse HEAD 2>/dev/null)

    if [[ -n "${expected_commit}" ]]; then
        # Pinned commit - check if we're at that commit
        if [[ "${current_head}" == "${expected_commit}"* ]]; then
            echo "up-to-date" > "${status_file}"
        else
            echo "needs-update" > "${status_file}"
        fi
    else
        # No pinned commit - fetch and check against remote
        git -C "${repo_dir}" fetch --quiet 2>/dev/null || true
        local remote_head
        remote_head=$(git -C "${repo_dir}" rev-parse @{u} 2>/dev/null || echo "")
        if [[ -n "${remote_head}" && "${current_head}" == "${remote_head}" ]]; then
            echo "up-to-date" > "${status_file}"
        else
            echo "needs-update" > "${status_file}"
        fi
    fi
}
# -- }}}

# -- {{{ parallel_check_display
# Display status lines for all checks with spinners
# Global: PARALLEL_CHECK_FRAME (spinner frame counter)
parallel_check_display() {
    local frame="${PARALLEL_CHECK_FRAME:-0}"
    local spinner_char="${SPINNER_CHARS:$((frame % SPINNER_LEN)):1}"

    for name in "${PCHECK_NAMES[@]}"; do
        local status_file="${CHECK_TMP_DIR}/${name}.status"
        local status="checking"
        [[ -f "${status_file}" ]] && status=$(cat "${status_file}" 2>/dev/null)

        case "${status}" in
            checking)
                printf "  %s Checking %s...\033[K\n" "${spinner_char}" "${name}"
                ;;
            up-to-date)
                printf "  \033[32m✓\033[0m %s is up-to-date\033[K\n" "${name}"
                ;;
            needs-update)
                printf "  \033[33m↓\033[0m %s needs update\033[K\n" "${name}"
                ;;
            missing)
                printf "  \033[31m✗\033[0m %s not found\033[K\n" "${name}"
                ;;
            *)
                printf "  ? %s: %s\033[K\n" "${name}" "${status}"
                ;;
        esac
    done
}
# -- }}}

# -- {{{ parallel_check_run
# Run parallel git status checks with live spinner display
# Sets PARALLEL_CHECK_RESULTS associative array with results
# Returns: 0 if all up-to-date, 1 if any need update
parallel_check_run() {
    local -a pids=()
    local count=${#PCHECK_NAMES[@]}

    if [[ $count -eq 0 ]]; then
        return 0
    fi

    # Start all workers in background
    for i in "${!PCHECK_NAMES[@]}"; do
        parallel_check_worker "${PCHECK_NAMES[$i]}" "${PCHECK_DIRS[$i]}" "${PCHECK_COMMITS[$i]}" &
        pids+=($!)
    done

    # Initial display
    parallel_check_display

    # Poll until all complete
    PARALLEL_CHECK_FRAME=0
    while true; do
        local all_done=true
        for name in "${PCHECK_NAMES[@]}"; do
            local status_file="${CHECK_TMP_DIR}/${name}.status"
            if [[ -f "${status_file}" ]]; then
                local status
                status=$(cat "${status_file}" 2>/dev/null)
                if [[ "${status}" == "checking" ]]; then
                    all_done=false
                    break
                fi
            else
                all_done=false
                break
            fi
        done

        if [[ "${all_done}" == true ]]; then
            break
        fi

        # Move cursor up and redraw
        printf "\033[%dA" "${count}"
        PARALLEL_CHECK_FRAME=$((PARALLEL_CHECK_FRAME + 1))
        parallel_check_display

        sleep 0.1
    done

    # Final redraw
    printf "\033[%dA" "${count}"
    parallel_check_display

    # Wait for all workers to finish
    for pid in "${pids[@]}"; do
        wait "${pid}" 2>/dev/null || true
    done

    # Collect results into global associative array
    declare -gA PARALLEL_CHECK_RESULTS=()
    local any_needs_update=false

    for name in "${PCHECK_NAMES[@]}"; do
        local status_file="${CHECK_TMP_DIR}/${name}.status"
        local status
        status=$(cat "${status_file}" 2>/dev/null || echo "error")
        PARALLEL_CHECK_RESULTS["${name}"]="${status}"
        if [[ "${status}" == "needs-update" || "${status}" == "missing" ]]; then
            any_needs_update=true
        fi
    done

    # Cleanup
    rm -rf "${CHECK_TMP_DIR}"

    if [[ "${any_needs_update}" == true ]]; then
        return 1
    fi
    return 0
}
# -- }}}

# -- {{{ cmd_install
# Install or update AzerothCore and modules
# Checks git status and only rebuilds if source changed or --force
# Uses parallel status checks with spinners (issue 323)
cmd_install() {
    set -e
    set -o pipefail

    # Parse arguments
    local force=false
    for arg in "$@"; do
        if [[ "${arg}" == "--force" ]]; then
            force=true
        fi
    done

    # Get profile-specific paths and settings
    get_profile_paths
    local REPO="${PROFILE_REPO[$PROFILE]}"
    local BRANCH="${PROFILE_BRANCH[$PROFILE]}"
    local COMMIT="${PROFILE_COMMIT[$PROFILE]}"
    local MODULES="${PROFILE_MODULES[$PROFILE]}"

    echo "Profile: ${PROFILE}"
    echo "  Repository: ${REPO##*/}"
    echo "  Branch: ${BRANCH}"
    if [[ -n "${COMMIT}" ]]; then
        echo "  Pinned: ${COMMIT:0:10}"
    fi
    echo "  Modules: ${MODULES}"
    echo ""

    local needs_rebuild=false

    # -- Handle force reinstall --
    if [[ "${force}" == true ]]; then
        echo "Force reinstall requested - cleaning source..."
        rm -rf "${AC_CODE_DIR}"
        needs_rebuild=true
    fi

    # -- Clone core if missing --
    if [[ ! -d "${AC_CODE_DIR}/.git" ]]; then
        echo "Cloning AzerothCore (${BRANCH} branch)..."
        git clone "${REPO}" --branch="${BRANCH}" "${AC_CODE_DIR}"
        if [[ -n "${COMMIT}" ]]; then
            echo "Checking out ${COMMIT:0:10}..."
            git -C "${AC_CODE_DIR}" checkout "${COMMIT}"
        fi
        needs_rebuild=true
    fi

    # -- Update modules symlink (release vs beta) --
    update_modules_symlink

    # -- Check/update modules --
    # Modules managed via symlink for release/beta profiles
    # Alpha manages modules directly in source-alpha/modules/
    mkdir -p "${AC_CODE_DIR}/modules"

    # Remove modules that aren't in this profile
    for existing_mod in "${AC_CODE_DIR}"/modules/*/; do
        if [[ -d "${existing_mod}" ]]; then
            local existing_name=$(basename "${existing_mod}")
            if [[ ! " ${MODULES} " =~ " ${existing_name} " ]]; then
                echo "  Removing ${existing_name} (not in ${PROFILE} profile)..."
                rm -rf "${existing_mod}"
                needs_rebuild=true
            fi
        fi
    done

    # Clone any missing modules (sequential, can't parallelize git clone)
    for mod_name in ${MODULES}; do
        local mod_repo="${MODULE_REPOS[$mod_name]}"
        if [[ -z "${mod_repo}" ]]; then
            echo "  Warning: Unknown module '${mod_name}', skipping"
            continue
        fi

        local mod_dir="${AC_CODE_DIR}/modules/${mod_name}"
        local mod_commit="${PROFILE_MODULE_COMMITS[${PROFILE}:${mod_name}]:-}"

        if [[ "${force}" == true && -d "${mod_dir}" ]]; then
            rm -rf "${mod_dir}"
        fi

        if [[ ! -d "${mod_dir}/.git" ]]; then
            echo "  Cloning ${mod_name}..."
            cd "${AC_CODE_DIR}/modules"
            git clone ${mod_repo}
            if [[ -n "${mod_commit}" ]]; then
                echo "  Checking out ${mod_name} @ ${mod_commit}..."
                git -C "${mod_dir}" checkout "${mod_commit}"
            fi
            cd - > /dev/null
            needs_rebuild=true
        fi
    done

    # -- Parallel status checks for existing repos --
    if [[ "${needs_rebuild}" == false ]]; then
        # Initialize parallel check system
        parallel_check_init

        # Add Core
        parallel_check_add "Core" "${AC_CODE_DIR}" "${COMMIT}"

        # Add all modules that exist
        for mod_name in ${MODULES}; do
            local mod_dir="${AC_CODE_DIR}/modules/${mod_name}"
            local mod_commit="${PROFILE_MODULE_COMMITS[${PROFILE}:${mod_name}]:-}"
            if [[ -d "${mod_dir}/.git" ]]; then
                parallel_check_add "${mod_name}" "${mod_dir}" "${mod_commit}"
            fi
        done

        # Run parallel checks with spinners
        echo "Checking for updates..."
        if ! parallel_check_run; then
            needs_rebuild=true
        fi
        echo ""

        # Apply updates for repos that need them
        if [[ "${PARALLEL_CHECK_RESULTS[Core]:-}" == "needs-update" ]]; then
            echo "Updating Core..."
            if [[ -n "${COMMIT}" ]]; then
                git -C "${AC_CODE_DIR}" fetch
                git -C "${AC_CODE_DIR}" checkout "${COMMIT}"
            else
                git -C "${AC_CODE_DIR}" pull --rebase
            fi
        fi

        for mod_name in ${MODULES}; do
            if [[ "${PARALLEL_CHECK_RESULTS[${mod_name}]:-}" == "needs-update" ]]; then
                echo "Updating ${mod_name}..."
                local mod_dir="${AC_CODE_DIR}/modules/${mod_name}"
                local mod_commit="${PROFILE_MODULE_COMMITS[${PROFILE}:${mod_name}]:-}"
                if [[ -n "${mod_commit}" ]]; then
                    git -C "${mod_dir}" fetch
                    git -C "${mod_dir}" checkout "${mod_commit}"
                else
                    git -C "${mod_dir}" pull --rebase
                fi
            fi
        done
    fi

    # -- Apply pre-compile patches --
    apply_patches_begin
    # Ensure patches are reverted even on build failure (Issue 334)
    trap 'unapply_patches_begin' EXIT

    # -- Build --
    # Pass force flag to do_build for cmake reconfiguration
    FORCE_REBUILD="${force}"
    do_build

    # Clear trap and revert patches after successful build
    trap - EXIT
    unapply_patches_begin

    # PHASE_END patches already applied to shadow by do_build
    # Configs and symlinks are in shadow, ready for validation

    # -- First-time setup (MySQL, configs, data files) --
    # Database names: auth is shared, world/characters are per-profile
    local DB_AUTH="acore_auth"
    local DB_WORLD="acore_world_${PROFILE}"
    local DB_CHARS="acore_characters_${PROFILE}"
    local LOGS_DIR="${DIR}/logs-${PROFILE}"

    echo ""
    echo "Setting up MySQL databases for profile '${PROFILE}'..."
    echo "  Auth (shared): ${DB_AUTH}"
    echo "  World:         ${DB_WORLD}"
    echo "  Characters:    ${DB_CHARS}"

    # MySQL setup with error handling
    local MYSQL_SOCKET="${DIR}/mysql/databases/mysql.sock"

    # Check if databases already exist (skip setup if so)
    # Uses ritz user which should already have access if previously configured
    if "${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" -u ritz -pmenardi -e "USE ${DB_WORLD}" 2>/dev/null; then
        echo "  Databases already configured (skipping setup)"
    else

    if [[ ! -S "${MYSQL_SOCKET}" ]]; then
        echo ""
        echo "==============================================================================="
        echo "MySQL SETUP FAILED: Socket not found"
        echo "==============================================================================="
        echo ""
        echo "Expected socket: ${MYSQL_SOCKET}"
        echo ""
        echo "What didn't complete:"
        echo "  [ ] Database creation (${DB_AUTH}, ${DB_WORLD}, ${DB_CHARS})"
        echo "  [ ] User 'ritz'@'localhost' creation/privileges"
        echo "  [ ] Config file initialization"
        echo "  [ ] Directory path configuration"
        echo "  [ ] Lua script symlinks"
        echo "  [ ] Data files copy"
        echo ""
        echo "To fix:"
        echo "  1. Start MySQL: ./scripts/start-mysql"
        echo "  2. Re-run install: ./scripts/azerothcore install"
        echo ""
        exit 1
    fi

    # Use root via socket auth for admin operations
    # --no-defaults: ignore system/user .my.cnf files that may have passwords
    if ! "${MYSQL_DIR}/bin/mysql" --no-defaults --socket="${MYSQL_SOCKET}" -u root << EOF
DROP USER IF EXISTS 'ritz'@'localhost';
CREATE USER 'ritz'@'localhost' IDENTIFIED BY 'menardi' WITH MAX_QUERIES_PER_HOUR 0 MAX_CONNECTIONS_PER_HOUR 0 MAX_UPDATES_PER_HOUR 0;

CREATE DATABASE IF NOT EXISTS \`${DB_AUTH}\` DEFAULT CHARACTER SET UTF8MB4 COLLATE utf8mb4_unicode_ci;
CREATE DATABASE IF NOT EXISTS \`${DB_WORLD}\` DEFAULT CHARACTER SET UTF8MB4 COLLATE utf8mb4_unicode_ci;
CREATE DATABASE IF NOT EXISTS \`${DB_CHARS}\` DEFAULT CHARACTER SET UTF8MB4 COLLATE utf8mb4_unicode_ci;

GRANT ALL PRIVILEGES ON \`${DB_AUTH}\` . * TO 'ritz'@'localhost' WITH GRANT OPTION;
GRANT ALL PRIVILEGES ON \`${DB_WORLD}\` . * TO 'ritz'@'localhost' WITH GRANT OPTION;
GRANT ALL PRIVILEGES ON \`${DB_CHARS}\` . * TO 'ritz'@'localhost' WITH GRANT OPTION;
FLUSH PRIVILEGES;
EOF
    then
        echo ""
        echo "==============================================================================="
        echo "MySQL SETUP FAILED: Database/user creation failed"
        echo "==============================================================================="
        echo ""
        echo "Connection attempted via: ${MYSQL_SOCKET}"
        echo ""
        echo "What didn't complete:"
        echo "  [ ] Database creation (${DB_AUTH}, ${DB_WORLD}, ${DB_CHARS})"
        echo "  [ ] User 'ritz'@'localhost' creation/privileges"
        echo "  [ ] Config file initialization"
        echo "  [ ] Directory path configuration"
        echo "  [ ] Lua script symlinks"
        echo "  [ ] Data files copy"
        echo ""
        echo "What DID complete:"
        echo "  [x] Source code clone/update"
        echo "  [x] Module installation"
        echo "  [x] Pre-compile patches (PHASE_BEGIN)"
        echo "  [x] Compilation (make)"
        echo "  [x] Binary installation"
        echo ""
        echo "Possible causes:"
        echo "  - MySQL not running (start with: ./scripts/start-mysql)"
        echo "  - Root user doesn't have socket auth configured"
        echo "  - Socket permissions issue"
        echo ""
        echo "To debug:"
        echo "  ${MYSQL_DIR}/bin/mysql --no-defaults --socket=${MYSQL_SOCKET} -u root"
        echo ""
        echo "  If it connects: root has no password, script bug (report issue)"
        echo "  If 'Access denied': root has a password set, need to reset or use it"
        echo "  If 'Can't connect': MySQL not running or wrong socket path"
        echo ""
        exit 1
    fi

    echo "  Databases and user configured successfully"
    fi  # end of database setup else block

    # Config initialization and Lua symlinks now handled by PHASE_END patches (E006, E001)

    # Copy data files if needed
    if [[ ! -d "${DIR}/data-files/dbc" ]]; then
        local SHARED_DATA="/home/ritz/games/azeroth-core/data-files"
        if [[ -d "${SHARED_DATA}" ]]; then
            echo "Copying data-files into project (this may take a while)..."
            mkdir -p "${DIR}/data-files"
            cp -r "${SHARED_DATA}"/* "${DIR}/data-files/"
            echo "Data files copied successfully"
        else
            echo "Warning: Game data not found at ${SHARED_DATA}"
            echo "You will need to extract dbc, maps, vmaps, mmaps from the WoW client"
            echo "Place them in: ${DIR}/data-files/"
            mkdir -p "${DIR}/data-files"
        fi
    else
        echo "Data files already present"
    fi

    echo ""
    echo "Installation complete!"
    echo "Next steps:"
    echo "  1. Start MySQL: ./scripts/start-mysql"
    echo "  2. Start auth server: ./scripts/azerothcore authserver"
    echo "  3. Start world server: ./scripts/azerothcore worldserver"
}
# -- }}}

# -- {{{ atomic_swap_dirs
# Atomically swap shadow directories to become current (Issue 327)
# On success: shadow becomes current, old current is deleted
# On failure: shadow is preserved, current is untouched
# Args: none (uses global BUILD_DIR, BUILD_DIR_SHADOW, INSTALL_DIR, INSTALL_DIR_SHADOW)
atomic_swap_dirs() {
    echo ""
    echo "Build successful - swapping to new binaries..."

    # Swap build directories
    # Note: rm -rf on large build dir can be slow, but safer than leaving orphaned dirs
    if [[ -d "${BUILD_DIR}" ]]; then
        rm -rf "${BUILD_DIR}"
    fi
    mv "${BUILD_DIR_SHADOW}" "${BUILD_DIR}"

    # Swap install directories
    if [[ -d "${INSTALL_DIR}" ]]; then
        rm -rf "${INSTALL_DIR}"
    fi
    mv "${INSTALL_DIR_SHADOW}" "${INSTALL_DIR}"

    echo "  build:     ${BUILD_DIR}"
    echo "  installed: ${INSTALL_DIR}"
}
# -- }}}

# -- {{{ print_build_failure
# Print helpful error message when build fails (Issue 327)
# Preserves shadow directories for debugging
print_build_failure() {
    local ERROR_LOG="${BUILD_DIR_SHADOW}/compile-errors.log"

    echo ""
    echo "==============================================================================="
    echo "BUILD FAILED"
    echo "==============================================================================="
    echo ""
    echo "Debug information preserved at:"
    echo "  ${ERROR_LOG}"
    echo ""
    if [[ -d "${INSTALL_DIR}" && -f "${INSTALL_DIR}/bin/worldserver" ]]; then
        echo "Your current working binaries are UNCHANGED:"
        echo "  ${INSTALL_DIR}/bin/worldserver"
        echo "  ${INSTALL_DIR}/bin/authserver"
    else
        echo "No previous working binaries exist."
        echo "This appears to be a first-time build."
    fi
    echo ""
    echo "To retry after fixing:"
    echo "  ./scripts/azerothcore compile"
    echo "==============================================================================="
}
# -- }}}

# -- {{{ do_build
# Shared build logic - cmake and make
# Compiles into shadow directories, swaps on success (Issue 327)
# Expects: AC_CODE_DIR, BUILD_DIR, INSTALL_DIR, MYSQL_DIR, BOOST_DIR, PROFILE to be set
# Also uses BUILD_DIR_SHADOW and INSTALL_DIR_SHADOW from get_profile_paths
# Logs output to tmp/build-${PROFILE}.log and BUILD_DIR_SHADOW/compile-errors.log
do_build() {
    echo ""
    echo "Building into shadow directories..."
    echo "  Shadow build:   ${BUILD_DIR_SHADOW}"
    echo "  Shadow install: ${INSTALL_DIR_SHADOW}"

    local CLANGPP_DIR="/usr/bin/clang++"
    local CLANG_DIR="/usr/bin/clang"
    local LUAJIT_INC="/usr/include/luajit-2.1"
    local LUAJIT_LIB="/usr/lib/libluajit-5.1.so"

    # Setup log symlinks to /tmp (RAM)
    setup_log_symlinks
    local BUILD_LOG="${DIR}/tmp/build-${PROFILE}.log"

    # Prepare shadow build directory
    # If shadow exists from a previous failed build, preserve object files for incremental retry
    mkdir -p "${BUILD_DIR_SHADOW}"
    cd "${BUILD_DIR_SHADOW}"

    # Error log in shadow directory (Issue 327)
    local ERROR_LOG="${BUILD_DIR_SHADOW}/compile-errors.log"
    echo "Build started: $(date)" > "${ERROR_LOG}"
    echo "Profile: ${PROFILE}" >> "${ERROR_LOG}"
    echo "Source: ${AC_CODE_DIR}" >> "${ERROR_LOG}"
    echo "Shadow build: ${BUILD_DIR_SHADOW}" >> "${ERROR_LOG}"
    echo "Shadow install: ${INSTALL_DIR_SHADOW}" >> "${ERROR_LOG}"
    echo "---" >> "${ERROR_LOG}"

    # Also write to the RAM-backed build log
    cp "${ERROR_LOG}" "${BUILD_LOG}"
    echo "Build log: ${BUILD_LOG}"
    echo "Error log: ${ERROR_LOG}"

    # Build Boost if needed
    if [[ ! -d "${BOOST_DIR}/lib" ]]; then
        echo "Local Boost not found - building from source..."
        cmd_boost 2>&1 | tee -a "${BUILD_LOG}" "${ERROR_LOG}"
    fi
    echo "Using local Boost from ${BOOST_DIR}"

    # Only run cmake if not already configured in shadow, or if forced
    # CMakeCache.txt presence indicates cmake has been run before
    if [[ ! -f "${BUILD_DIR_SHADOW}/CMakeCache.txt" || "${FORCE_REBUILD:-false}" == "true" ]]; then
        echo ""
        echo "Running cmake..."
        # IMPORTANT: CMAKE_INSTALL_PREFIX points to shadow directory
        # Binary will run from shadow first (validation), then promoted to main
        # Both shadow and main have identical directory structure
        if ! cmake "${AC_CODE_DIR}" \
          -DBOOST_ROOT="${BOOST_DIR}" \
          -DLUA_VERSION=luajit \
          -DLUAJIT_INCLUDE_DIR="${LUAJIT_INC}" \
          -DLUAJIT_LIBRARIES="${LUAJIT_LIB}" \
          -DCMAKE_INSTALL_PREFIX="${INSTALL_DIR_SHADOW}" \
          -DCMAKE_C_COMPILER="${CLANG_DIR}" \
          -DCMAKE_CXX_COMPILER="${CLANGPP_DIR}" \
          -DCMAKE_CXX_FLAGS="-I${AC_CODE_DIR}/src/common -I${LUAJIT_INC} -Wno-enum-constexpr-conversion -fcolor-diagnostics" \
          -DCMAKE_BINARY_DIR="${BUILD_DIR_SHADOW}" \
          -DCMAKE_SOURCE_DIR="${AC_CODE_DIR}" \
          -DCMAKE_COLOR_DIAGNOSTICS=ON \
          -DWITH_WARNINGS=1 \
          -DTOOLS_BUILD=all \
          -DSCRIPTS=static \
          -DMODULES=static \
          -DMYSQL_EXECUTABLE="${MYSQL_DIR}/bin/mysql" \
          -DMYSQL_INCLUDE_DIR="${MYSQL_DIR}/include" \
          -DMYSQL_LIBRARY="${MYSQL_DIR}/lib/libmysqlclient.so" \
          2>&1 | tee -a "${BUILD_LOG}" "${ERROR_LOG}"; then
            echo "" >> "${ERROR_LOG}"
            echo "CMAKE FAILED at $(date)" >> "${ERROR_LOG}"
            print_build_failure
            return 1
        fi
    else
        echo ""
        echo "Skipping cmake (already configured, use --force to reconfigure)"
    fi

    echo ""
    echo "Building with ${THREADS} threads..."
    # Capture make exit code without triggering set -e
    local make_result=0
    make -j${THREADS} 2>&1 | tee -a "${BUILD_LOG}" "${ERROR_LOG}" || make_result=$?

    if [[ ${make_result} -ne 0 ]]; then
        echo "" >> "${ERROR_LOG}"
        echo "MAKE FAILED with exit code ${make_result} at $(date)" >> "${ERROR_LOG}"
        print_build_failure
        return 1
    fi

    echo ""
    echo "Installing to shadow directory..."
    local install_result=0
    cmake --install . 2>&1 | tee -a "${BUILD_LOG}" "${ERROR_LOG}" || install_result=$?

    if [[ ${install_result} -ne 0 ]]; then
        echo "" >> "${ERROR_LOG}"
        echo "MAKE INSTALL FAILED with exit code ${install_result} at $(date)" >> "${ERROR_LOG}"
        print_build_failure
        return 1
    fi

    # Setup Lua script symlinks in shadow install dir
    mkdir -p "${INSTALL_DIR_SHADOW}/bin/lua_scripts"
    ln -sfn "${DIR}/src/lua" "${INSTALL_DIR_SHADOW}/bin/lua_scripts/custom"
    if [[ -d "${DIR}/src/lua/extensions" ]]; then
        ln -sfn "${DIR}/src/lua/extensions" "${INSTALL_DIR_SHADOW}/bin/lua_scripts/extensions"
    fi

    # Apply PHASE_END patches to shadow directory
    # Set TARGET_INSTALL_DIR so patches operate on shadow, not main
    TARGET_INSTALL_DIR="${INSTALL_DIR_SHADOW}"
    apply_patches_end
    unset TARGET_INSTALL_DIR

    echo ""
    echo "Build complete! Shadow install at: ${INSTALL_DIR_SHADOW}"
    echo "Log: ${BUILD_LOG}"
    echo ""
    echo "NOTE: Binaries are in shadow directory and have NOT been promoted yet."
    echo "Run validation before promoting to main installation."
}
# -- }}}

# -- {{{ validate_shadow_worldserver
# Start worldserver from shadow directory to validate it works
# Returns 0 if successful, 1 if failed
# Kills the server after validation
validate_shadow_worldserver() {
    echo ""
    echo "Validating shadow worldserver..."
    echo "  Shadow: ${INSTALL_DIR_SHADOW}/bin/worldserver"

    # Check if binary exists
    if [[ ! -f "${INSTALL_DIR_SHADOW}/bin/worldserver" ]]; then
        echo "  ERROR: worldserver not found in shadow"
        return 1
    fi

    # Check if config exists
    if [[ ! -f "${INSTALL_DIR_SHADOW}/etc/worldserver.conf" ]]; then
        echo "  ERROR: worldserver.conf not found in shadow/etc/"
        return 1
    fi

    # Start worldserver in background
    echo "  Starting worldserver from shadow (validation run)..."
    cd "${INSTALL_DIR_SHADOW}/bin"
    export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"

    # Start in background, redirect output to validation log
    local VALIDATION_LOG="${DIR}/tmp/shadow-validation-${PROFILE}.log"
    ./worldserver > "${VALIDATION_LOG}" 2>&1 &
    local WS_PID=$!

    echo "  Worldserver started (PID ${WS_PID})"
    echo "  Waiting for successful initialization..."

    # Wait up to 30 seconds for successful startup
    local timeout=30
    local elapsed=0
    local success=false

    while [[ ${elapsed} -lt ${timeout} ]]; do
        # Check if process is still running
        if ! kill -0 ${WS_PID} 2>/dev/null; then
            echo "  ERROR: Worldserver crashed during startup"
            echo "  Check log: ${VALIDATION_LOG}"
            return 1
        fi

        # Check log for success indicator
        if grep -q "World initialized in" "${VALIDATION_LOG}" 2>/dev/null; then
            success=true
            break
        fi

        # Check for critical errors
        if grep -qE "(ERROR|FATAL|Failed to initialize)" "${VALIDATION_LOG}" 2>/dev/null; then
            echo "  ERROR: Worldserver failed to initialize"
            kill ${WS_PID} 2>/dev/null
            echo "  Check log: ${VALIDATION_LOG}"
            return 1
        fi

        sleep 1
        ((elapsed++))
    done

    # Kill the validation worldserver
    if kill ${WS_PID} 2>/dev/null; then
        echo "  Stopped validation worldserver (PID ${WS_PID})"
    fi

    if [[ "${success}" == "true" ]]; then
        echo "  ✓ Shadow worldserver validated successfully"
        return 0
    else
        echo "  ERROR: Validation timeout (${timeout}s)"
        echo "  Check log: ${VALIDATION_LOG}"
        return 1
    fi
}
# -- }}}

# -- {{{ promote_shadow_to_main
# Copy shadow installation to main, tracking non-clobbered files
# Updates build manifest with promotion details
promote_shadow_to_main() {
    echo ""
    echo "Promoting shadow to main installation..."
    echo "  From: ${INSTALL_DIR_SHADOW}"
    echo "  To:   ${INSTALL_DIR}"

    # Create manifest directory
    local MANIFEST_DIR="${DIR}/build-manifests"
    mkdir -p "${MANIFEST_DIR}"

    local TIMESTAMP=$(date +%Y%m%d-%H%M%S)
    local MANIFEST_FILE="${MANIFEST_DIR}/${PROFILE}-${TIMESTAMP}.txt"

    echo "# Build Manifest" > "${MANIFEST_FILE}"
    echo "# Profile: ${PROFILE}" >> "${MANIFEST_FILE}"
    echo "# Timestamp: ${TIMESTAMP}" >> "${MANIFEST_FILE}"
    echo "# Shadow: ${INSTALL_DIR_SHADOW}" >> "${MANIFEST_FILE}"
    echo "# Main: ${INSTALL_DIR}" >> "${MANIFEST_FILE}"
    echo "" >> "${MANIFEST_FILE}"

    # Find files in main that won't be clobbered (user customizations)
    if [[ -d "${INSTALL_DIR}" ]]; then
        echo "# Files in main NOT in shadow (preserved):" >> "${MANIFEST_FILE}"

        # Use comm to find files only in main
        local main_files=$(mktemp)
        local shadow_files=$(mktemp)

        (cd "${INSTALL_DIR}" && find . -type f | sort > "${main_files}")
        (cd "${INSTALL_DIR_SHADOW}" && find . -type f | sort > "${shadow_files}")

        local preserved_count=0
        while IFS= read -r file; do
            echo "  ${file}" >> "${MANIFEST_FILE}"
            ((preserved_count++))
        done < <(comm -23 "${main_files}" "${shadow_files}")

        rm -f "${main_files}" "${shadow_files}"

        echo "" >> "${MANIFEST_FILE}"
        echo "# Preserved files: ${preserved_count}" >> "${MANIFEST_FILE}"
        echo "  Preserved ${preserved_count} existing files"
    else
        echo "# No existing main installation (first-time)" >> "${MANIFEST_FILE}"
        echo "  No existing main installation"
    fi

    echo "" >> "${MANIFEST_FILE}"
    echo "# Files promoted from shadow:" >> "${MANIFEST_FILE}"

    # Copy shadow to main, preserving directory structure
    mkdir -p "${INSTALL_DIR}"

    # Use rsync to copy, tracking what was copied
    local promoted_count=0
    (cd "${INSTALL_DIR_SHADOW}" && find . -type f) | while IFS= read -r file; do
        local src="${INSTALL_DIR_SHADOW}/${file}"
        local dst="${INSTALL_DIR}/${file}"

        # Create parent directory
        mkdir -p "$(dirname "${dst}")"

        # Copy file
        cp -f "${src}" "${dst}"
        echo "  ${file}" >> "${MANIFEST_FILE}"
        ((promoted_count++))
    done

    # Copy symlinks separately
    (cd "${INSTALL_DIR_SHADOW}" && find . -type l) | while IFS= read -r link; do
        local src="${INSTALL_DIR_SHADOW}/${link}"
        local dst="${INSTALL_DIR}/${link}"
        local target=$(readlink "${src}")

        mkdir -p "$(dirname "${dst}")"
        ln -sfn "${target}" "${dst}"
        echo "  ${link} -> ${target}" >> "${MANIFEST_FILE}"
    done

    echo ""
    echo "  ✓ Promotion complete"
    echo "  Manifest: ${MANIFEST_FILE}"

    # Create symlink to latest manifest
    ln -sfn "$(basename "${MANIFEST_FILE}")" "${MANIFEST_DIR}/${PROFILE}-latest.txt"
}
# -- }}}

# -- {{{ cmd_apply_patches
# Manually apply PHASE_BEGIN or PHASE_END patches for current profile
# Always operates on shadow directory (main comes from promote workflow)
# Issue 409: Manual Patch Application Command
cmd_apply_patches() {
    local do_begin=false
    local do_end=false
    local revert=false
    local dry_run=false

    # Parse arguments - can combine --begin and --end
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --begin) do_begin=true; shift ;;
            --end)   do_end=true; shift ;;
            --revert) revert=true; shift ;;
            --dry-run) dry_run=true; shift ;;
            *) shift ;;
        esac
    done

    # Default to --end if neither specified
    if [[ "${do_begin}" == "false" && "${do_end}" == "false" ]]; then
        do_end=true
    fi

    get_profile_paths

    # Always operate on shadow directory
    # Main directory is a generated artifact from the promote workflow
    TARGET_INSTALL_DIR="${INSTALL_DIR_SHADOW}"

    local action="apply"
    [[ "${revert}" == "true" ]] && action="revert"

    echo ""
    echo "Apply Patches (Issue 409)"
    echo "  Profile: ${PROFILE}"
    echo "  Action:  ${action}"
    echo "  Target:  shadow (${TARGET_INSTALL_DIR})"
    [[ "${do_begin}" == "true" ]] && echo "  Phase:   PHASE_BEGIN"
    [[ "${do_end}" == "true" ]] && echo "  Phase:   PHASE_END"
    echo ""

    if [[ "${dry_run}" == "true" ]]; then
        echo "DRY RUN - Would ${action}:"
        if [[ "${do_begin}" == "true" ]]; then
            echo "  PHASE_BEGIN: ${PHASE_BEGIN_PATCHES[$PROFILE]:-none}"
        fi
        if [[ "${do_end}" == "true" ]]; then
            echo "  PHASE_END: ${PHASE_END_PATCHES[$PROFILE]:-none}"
        fi
        unset TARGET_INSTALL_DIR
        return 0
    fi

    # PHASE_BEGIN patches (source code modifications)
    if [[ "${do_begin}" == "true" ]]; then
        if [[ "${revert}" == "true" ]]; then
            echo "Reverting PHASE_BEGIN patches..."
            unapply_patches_begin
            echo ""
            echo "Triggering incremental recompilation..."
            # Recompile only changed files - make handles this automatically
            cd "${BUILD_DIR_SHADOW}"
            make -j${THREADS}
            echo "  Recompilation complete."
        else
            echo "Applying PHASE_BEGIN patches..."
            apply_patches_begin
        fi
    fi

    # PHASE_END patches (config files, symlinks, database)
    if [[ "${do_end}" == "true" ]]; then
        if [[ "${revert}" == "true" ]]; then
            echo "Reverting PHASE_END patches..."
            unapply_patches_end
        else
            echo "Applying PHASE_END patches..."
            apply_patches_end
        fi
    fi

    unset TARGET_INSTALL_DIR
    echo ""
    echo "Done."
}
# -- }}}

# -- {{{ cmd_update
# Update source and rebuild - does NOT touch MySQL, configs, or data files
# Uses parallel status checks with spinners (issue 323)
cmd_update() {
    set -e
    set -o pipefail

    local force=false
    for arg in "$@"; do
        if [[ "${arg}" == "--force" ]]; then
            force=true
        fi
    done

    get_profile_paths
    local REPO="${PROFILE_REPO[$PROFILE]}"
    local BRANCH="${PROFILE_BRANCH[$PROFILE]}"
    local COMMIT="${PROFILE_COMMIT[$PROFILE]}"
    local MODULES="${PROFILE_MODULES[$PROFILE]}"

    echo "Updating profile: ${PROFILE}"
    echo ""

    # Check source exists
    if [[ ! -d "${AC_CODE_DIR}/.git" ]]; then
        echo "Error: Source not found. Run 'install' first."
        exit 1
    fi

    local needs_rebuild=false

    # Force rebuild skips status checks
    if [[ "${force}" == true ]]; then
        echo "Force rebuild requested"
        needs_rebuild=true
    else
        # Initialize parallel check system
        parallel_check_init

        # Add Core as first check (treated same as modules)
        parallel_check_add "Core" "${AC_CODE_DIR}" "${COMMIT}"

        # Add all modules
        for mod_name in ${MODULES}; do
            local mod_dir="${AC_CODE_DIR}/modules/${mod_name}"
            local mod_commit="${PROFILE_MODULE_COMMITS[${PROFILE}:${mod_name}]:-}"
            parallel_check_add "${mod_name}" "${mod_dir}" "${mod_commit}"
        done

        # Run parallel checks with spinners
        echo "Checking for updates..."
        if ! parallel_check_run; then
            needs_rebuild=true
        fi
        echo ""

        # Apply updates for repos that need them
        if [[ "${PARALLEL_CHECK_RESULTS[Core]:-}" == "needs-update" ]]; then
            echo "Updating Core..."
            if [[ -n "${COMMIT}" ]]; then
                git -C "${AC_CODE_DIR}" checkout "${COMMIT}"
            else
                git -C "${AC_CODE_DIR}" pull --rebase
            fi
        fi

        for mod_name in ${MODULES}; do
            if [[ "${PARALLEL_CHECK_RESULTS[${mod_name}]:-}" == "needs-update" ]]; then
                echo "Updating ${mod_name}..."
                local mod_dir="${AC_CODE_DIR}/modules/${mod_name}"
                local mod_commit="${PROFILE_MODULE_COMMITS[${PROFILE}:${mod_name}]:-}"
                if [[ -n "${mod_commit}" ]]; then
                    git -C "${mod_dir}" checkout "${mod_commit}"
                else
                    git -C "${mod_dir}" pull --rebase
                fi
            elif [[ "${PARALLEL_CHECK_RESULTS[${mod_name}]:-}" == "missing" ]]; then
                echo "  ${mod_name} missing - run 'install' to add it"
            fi
        done
    fi

    # Check if patches need applying (Issue 112)
    # Must check BEFORE early exit, otherwise new patches are never applied
    if patches_need_applying; then
        echo "Patches pending - rebuild required"
        needs_rebuild=true
    fi

    # Check if patched source files are newer than binary (Issue 326)
    # This catches the case where patches were applied but binary wasn't rebuilt
    if [[ "${needs_rebuild}" == false && -f "${INSTALL_DIR}/bin/worldserver" ]]; then
        local BINARY_TIME=$(stat -c %Y "${INSTALL_DIR}/bin/worldserver" 2>/dev/null || echo 0)

        # Check B002 source file
        local B002_FILE="${AC_CODE_DIR}/modules/mod-playerbots/src/Bot/RandomPlayerbotMgr.cpp"
        if [[ -f "${B002_FILE}" ]]; then
            local B002_TIME=$(stat -c %Y "${B002_FILE}" 2>/dev/null || echo 0)
            if [[ "${B002_TIME}" -gt "${BINARY_TIME}" ]]; then
                echo "Source newer than binary - rebuild required"
                needs_rebuild=true
            fi
        fi

        # Check B003 source file
        local B003_FILE="${AC_CODE_DIR}/modules/mod-ale/src/LuaEngine/LuaEngine.cpp"
        if [[ "${needs_rebuild}" == false && -f "${B003_FILE}" ]]; then
            local B003_TIME=$(stat -c %Y "${B003_FILE}" 2>/dev/null || echo 0)
            if [[ "${B003_TIME}" -gt "${BINARY_TIME}" ]]; then
                echo "Source newer than binary - rebuild required"
                needs_rebuild=true
            fi
        fi
    fi

    # Build if needed
    if [[ "${needs_rebuild}" == false && -f "${INSTALL_DIR}/bin/worldserver" ]]; then
        echo ""
        echo "Everything up-to-date, no rebuild needed."
        echo "Use --force to rebuild anyway."
        # Always check database patches (idempotent, safe to run every time)
        patch_E005_dk_levelstats
        return 0
    fi

    # Apply pre-compile patches
    apply_patches_begin
    # Ensure patches are reverted even on build failure (Issue 334)
    trap 'unapply_patches_begin' EXIT

    # Pass force flag to do_build for cmake reconfiguration
    FORCE_REBUILD="${force}"
    do_build

    # Clear trap and revert patches after successful build
    trap - EXIT
    unapply_patches_begin

    # PHASE_END patches already applied to shadow by do_build
    # Use 'validate' command to test, then 'promote' to move to main

    echo ""
    echo "Update complete! Shadow build ready for validation."
}
# -- }}}

# -- {{{ cmd_compile
# Compile only - skip git checks, go straight to cmake/make
# Use when you've made local changes and just want to rebuild
cmd_compile() {
    set -e
    set -o pipefail

    local force=false
    for arg in "$@"; do
        if [[ "${arg}" == "--force" ]]; then
            force=true
        fi
    done

    get_profile_paths

    echo "Compiling profile: ${PROFILE}"
    echo "  (skipping git checks)"
    echo ""

    # Check source exists
    if [[ ! -d "${AC_CODE_DIR}/.git" ]]; then
        echo "Error: Source not found. Run 'install' first."
        exit 1
    fi

    # Apply pre-compile patches (idempotent, safe to run)
    apply_patches_begin
    # Ensure patches are reverted even on build failure (Issue 334)
    trap 'unapply_patches_begin' EXIT

    # Build - force cmake reconfig if --force
    FORCE_REBUILD="${force}"
    do_build

    # Clear trap and revert patches after successful build
    trap - EXIT
    unapply_patches_begin

    # PHASE_END patches already applied to shadow by do_build
    # Use 'validate' command to test, then 'promote' to move to main

    echo ""
    echo "Compile complete! Shadow build ready for validation."
}
# -- }}}

# -- {{{ main
# Main entry point - parse args and dispatch to command
main() {
    parse_args "$@"

    case "${COMMAND}" in
        install)
            cmd_install "${COMMAND_ARGS[@]}"
            ;;
        update)
            cmd_update "${COMMAND_ARGS[@]}"
            ;;
        compile)
            cmd_compile "${COMMAND_ARGS[@]}"
            ;;
        authserver)
            cmd_authserver
            ;;
        worldserver)
            cmd_worldserver
            ;;
        keira)
            cmd_keira
            ;;
        profiles)
            cmd_profiles
            ;;
        switch)
            cmd_switch "${COMMAND_ARGS[0]:-}"
            ;;
        validate)
            get_profile_paths
            validate_shadow_worldserver
            ;;
        promote)
            get_profile_paths
            promote_shadow_to_main
            ;;
        apply-patches)
            source "${DIR}/patches/patches.sh"
            cmd_apply_patches "${COMMAND_ARGS[@]}"
            ;;
        boost)
            cmd_boost
            ;;
        extract-maps)
            "${DIR}/scripts/extract-maps" "${COMMAND_ARGS[@]}"
            ;;
        ""|help)
            show_help
            ;;
        *)
            echo "Error: Unknown command '${COMMAND}'"
            echo ""
            show_help
            exit 1
            ;;
    esac
}
# -- }}}

main "$@"
