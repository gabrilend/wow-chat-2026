}
# -- }}}

# -- {{{ parse_args
# Parse global arguments and extract command
parse_args() {
    COMMAND=""
    COMMAND_ARGS=()

    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    if [[ -v "PROFILE_REPO[${2}]" ]]; then
                        PROFILE="${2}"
                        shift 2
                    else
                        echo "Error: Unknown profile '${2}'"
                        echo "Available profiles: alpha, beta, release"
                        exit 1
                    fi
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --threads)
                if [[ -n "${2:-}" && "${2}" =~ ^[0-9]+$ ]]; then
                    THREADS="${2}"
                    shift 2
                else
                    echo "Error: --threads requires a numeric argument"
                    exit 1
                fi
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            -*)
                # Pass other flags to command
                COMMAND_ARGS+=("${1}")
                shift
                ;;
            *)
                if [[ -z "${COMMAND}" ]]; then
                    COMMAND="${1}"
                else
                    COMMAND_ARGS+=("${1}")
                fi
                shift
                ;;
        esac
    done
}
# -- }}}

# -- {{{ get_profile_paths
# Returns profile-specific directory paths
# Sets: AC_CODE_DIR, INSTALL_DIR, BUILD_DIR, and shadow variants
# Two source directories:
#   source-alpha/ = wow-chat-1 baseline (old Eluna)
#   source-beta/  = Latest AzerothCore (used by release AND beta)
# Build/install directories profile-specific
# Shadow directories used during compilation (Issue 327)
get_profile_paths() {
    local p="${PROFILE}"

    # Alpha uses source-alpha, release/beta use source-beta
    if [[ "${p}" == "alpha" ]]; then
        AC_CODE_DIR="${DIR}/source-alpha"
    else
        AC_CODE_DIR="${DIR}/source-beta"
    fi

    INSTALL_DIR="${DIR}/installed-files-${p}"
    BUILD_DIR="${DIR}/build-${p}"
    MYSQL_DIR="${DIR}/mysql/installed-files"
    # Shadow directories for atomic builds (Issue 327)
    # Unified across profiles - reused for each build
    BUILD_DIR_SHADOW="${DIR}/build-shadow"
    INSTALL_DIR_SHADOW="${DIR}/installed-files-shadow"
}
# -- }}}

# -- {{{ update_modules_symlink
# Updates source-beta/modules symlink to point to correct profile modules
# Release uses modules-release/ (empty), beta uses modules-beta/ (all modules)
# Alpha uses source-alpha (doesn't use symlink)
update_modules_symlink() {
    local p="${PROFILE}"

    # Only update symlink for profiles using source-beta
    if [[ "${p}" == "alpha" ]]; then
        return
    fi

    local modules_link="${DIR}/source-beta/modules"
    local target_dir

    if [[ "${p}" == "release" ]]; then
        target_dir="../modules-release"
    else
        target_dir="../modules-beta"
    fi

    # Update symlink if it doesn't point to the right target
    if [[ -L "${modules_link}" ]]; then
        local current_target=$(readlink "${modules_link}")
        if [[ "${current_target}" != "${target_dir}" ]]; then
            echo "Updating modules symlink: ${current_target} -> ${target_dir}"
            rm "${modules_link}"
            ln -s "${target_dir}" "${modules_link}"
        fi
    else
        echo "Creating modules symlink: -> ${target_dir}"
        rm -rf "${modules_link}"
        ln -s "${target_dir}" "${modules_link}"
    fi
}
# -- }}}

# -- {{{ setup_log_symlinks
# Ensure log directories exist in /tmp (RAM) with symlinks from project
# Creates: /tmp/wow-chat-2/, /tmp/wow-chat-2/logs-${PROFILE}/
# Symlinks: ${DIR}/tmp -> /tmp/wow-chat-2/
#           ${DIR}/logs-${PROFILE} -> /tmp/wow-chat-2/logs-${PROFILE}/
setup_log_symlinks() {
    local TMP_BASE="/tmp/wow-chat-2"
    local TMP_LOGS="${TMP_BASE}/logs-${PROFILE}"

    # Create RAM directories
    mkdir -p "${TMP_BASE}"
    mkdir -p "${TMP_LOGS}"

    # Setup tmp symlink (for build logs)
    [[ -L "${DIR}/tmp" ]] || ln -s "${TMP_BASE}" "${DIR}/tmp"

    # Setup logs-${PROFILE} symlink (for runtime logs)
    [[ -L "${DIR}/logs-${PROFILE}" ]] || ln -s "${TMP_LOGS}" "${DIR}/logs-${PROFILE}"
}
# -- }}}

# -- {{{ cmd_profiles
# List available version profiles and their configurations
cmd_profiles() {
    echo "Available version profiles:"
    echo ""
    printf "%-10s %-50s %-12s\n" "PROFILE" "REPOSITORY" "BRANCH"
    printf "%-10s %-50s %-12s\n" "-------" "----------" "------"
    for p in alpha beta release; do
        local repo="${PROFILE_REPO[$p]}"
        local branch="${PROFILE_BRANCH[$p]}"
        local commit="${PROFILE_COMMIT[$p]}"
        local suffix=""
        if [[ -n "${commit}" ]]; then
            suffix=" @${commit:0:7}"
        fi
        printf "%-10s %-50s %-12s\n" "${p}" "${repo##*/}" "${branch}${suffix}"
    done
    echo ""
    echo "Modules per profile:"
    for p in alpha beta release; do
        echo "  ${p}: ${PROFILE_MODULES[$p]}"
    done
    echo ""
    echo "Current profile: ${PROFILE}"
}
# -- }}}

# -- {{{ cmd_switch
# Switch to a different profile without recompiling
# Validates profile exists and has been built
cmd_switch() {
    local new_profile="${1:-}"

    if [[ -z "${new_profile}" ]]; then
        echo "Usage: ./scripts/azerothcore switch <profile>"
        echo "Available profiles: alpha, beta, release"
        echo "Current profile: ${PROFILE}"
        return 1
    fi

    # Validate profile exists
    if [[ ! -v "PROFILE_REPO[${new_profile}]" ]]; then
        echo "Error: Unknown profile '${new_profile}'"
        echo "Available profiles: alpha, beta, release"
        return 1
    fi

    # Check if profile has been built
    local old_profile="${PROFILE}"
    PROFILE="${new_profile}"
    get_profile_paths

    if [[ ! -f "${INSTALL_DIR}/bin/worldserver" ]]; then
        echo "Warning: Profile '${new_profile}' has not been built yet."
        echo "Expected: ${INSTALL_DIR}/bin/worldserver"
        echo "Run './scripts/azerothcore install all --profile ${new_profile}' first."
        echo ""
    fi

    # Write new profile
    echo "${new_profile}" > "${PROFILE_FILE}"

    echo "Switched from '${old_profile}' to '${new_profile}'"
    echo ""
    echo "Directories:"
    echo "  Source:    ${AC_CODE_DIR}"
    echo "  Build:     ${BUILD_DIR}"
    echo "  Installed: ${INSTALL_DIR}"
}
# -- }}}

# -- {{{ cmd_authserver
# Starts the authentication server
# Sets LD_LIBRARY_PATH to use project MySQL libs instead of system libs
# Updates realmlist with current public IP before starting (cached daily)
cmd_authserver() {
    get_profile_paths
    setup_log_symlinks

    # Update realmlist with current public IP (cached daily in /tmp/wow-chat/)
    # Why: ISP may change our IP; this ensures players can connect
    # Why daily: Checking every startup wastes bandwidth; ISPs rarely change more than once/day
    # Why here: authserver starts first, stays up longer, worldserver restarts should be fast
    if [[ -x "${DIR}/scripts/update-realmlist-ip" ]]; then
        echo "Updating realmlist with public IP..."
        "${DIR}/scripts/update-realmlist-ip" "${DIR}"
        echo ""
    fi

    if [[ ! -f "${INSTALL_DIR}/bin/authserver" ]]; then
        echo "Error: authserver not found for profile '${PROFILE}'"
        echo "Expected: ${INSTALL_DIR}/bin/authserver"
        echo "Run './scripts/azerothcore install all --profile ${PROFILE}' first."
        exit 1
    fi
    echo "Starting authserver (profile: ${PROFILE})"
    export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"
    cd "${INSTALL_DIR}/bin"
    ./authserver
}
# -- }}}

# -- {{{ cmd_worldserver
# Starts the world server
# Sets LD_LIBRARY_PATH to use project MySQL libs instead of system libs
cmd_worldserver() {
    get_profile_paths
    setup_log_symlinks
    if [[ ! -f "${INSTALL_DIR}/bin/worldserver" ]]; then
        echo "Error: worldserver not found for profile '${PROFILE}'"
        echo "Expected: ${INSTALL_DIR}/bin/worldserver"
        echo "Run './scripts/azerothcore install all --profile ${PROFILE}' first."
        exit 1
    fi
    echo "Starting worldserver (profile: ${PROFILE})"
    export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"
    cd "${INSTALL_DIR}/bin"
    ./worldserver
}
# -- }}}

