#!/bin/bash

# AzerothCore management script for wow-chat-2
# Handles installation, updates, and server startup for the project-local server.
# Supports multiple version profiles for compatibility testing.
# Run directly: ./scripts/azerothcore <command> [options]

# Project root directory - all paths derive from this
DIR="/home/ritz/games/azeroth-core/wow-chat-2026"

# Thread count for parallel builds - defaults to (nproc - 1)
#THREADS=$(( $(nproc) - 1 ))
THREADS=4
#if [[ "${THREADS}" -lt 1 ]]; then
#    THREADS=1
#fi

echo "running in 4 threaded mode"

KEIRA_VERSION="3.10.1"

# =============================================================================
# Version Profile Definitions
# =============================================================================
# alpha   - Latest playerbots branch, cutting edge (not yet implemented)
# beta    - Current work being tested, all modules
# release - June 2023 known good, wow-chat-1 compatible (stable)
# =============================================================================

# -- {{{ profile_definitions
# Repository URLs for each profile
# alpha: wow-chat-1 baseline (old Eluna)
# beta: playerbots fork + all experimental features
# release: playerbots fork, bare bones, NO modules
declare -A PROFILE_REPO=(
    ["alpha"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["beta"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["release"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
)

# Branch to clone for each profile
declare -A PROFILE_BRANCH=(
    ["alpha"]="Playerbot"
    ["beta"]="Playerbot"
    ["release"]="Playerbot"
)

# Specific commit to checkout (empty = HEAD)
declare -A PROFILE_COMMIT=(
    ["alpha"]=""
    ["beta"]=""
    ["release"]=""
)

# Modules to install for each profile (space-separated)
# alpha: mod-eluna + mod-transmog (wow-chat-1 baseline)
# beta: mod-ale + all experimental modules
# release: NONE (bare playerbots only)
declare -A PROFILE_MODULES=(
    ["alpha"]="mod-eluna mod-transmog"
    ["beta"]="mod-ale mod-aoe-loot mod-grownup mod-playerbots"
    ["release"]=""
)

# Module repository URLs
declare -A MODULE_REPOS=(
    ["mod-ale"]="https://github.com/azerothcore/mod-ale.git"
    ["mod-eluna"]="https://github.com/azerothcore/mod-eluna.git"
    ["mod-aoe-loot"]="https://github.com/TerraByte-tbwps/mod-aoe-loot.git"
    ["mod-grownup"]="https://github.com/webluke/mod-grownup"
    ["mod-playerbots"]="https://github.com/liyunfan1223/mod-playerbots.git --branch=master"
)

# Module commits per profile (profile:module -> commit)
# Empty = use HEAD
declare -A PROFILE_MODULE_COMMITS=(
    ["release:mod-eluna"]="1abf244"
)

# Current profile - read from .current-profile or default to release
PROFILE_FILE="${DIR}/.current-profile"
if [[ -f "${PROFILE_FILE}" ]]; then
    PROFILE="$(cat "${PROFILE_FILE}")"
else
    PROFILE="release"
fi
# -- }}}

# -- {{{ Boost configuration
BOOST_VERSION="1.74.0"
BOOST_VERSION_UNDERSCORE="1_74_0"
BOOST_DIR="${DIR}/libs/boost"
# -- }}}

# -- {{{ cmd_boost
# Download and compile Boost from source
# Installs to libs/boost with required components for AzerothCore
cmd_boost() {
    set -e
    echo "Installing Boost ${BOOST_VERSION}..."

    local BOOST_SRC="${DIR}/libs/boost-src"
    local BOOST_TARBALL="boost_${BOOST_VERSION_UNDERSCORE}.tar.gz"
    # SourceForge mirror - JFrog artifactory no longer allows direct downloads
    local BOOST_URL="https://sourceforge.net/projects/boost/files/boost/${BOOST_VERSION}/${BOOST_TARBALL}/download"

    mkdir -p "${DIR}/libs"

    # Check if already installed
    if [[ -f "${BOOST_DIR}/lib/libboost_system.a" ]]; then
        echo "Boost already installed at ${BOOST_DIR}"
        echo "To reinstall, remove ${BOOST_DIR} first."
        return 0
    fi

    # Download
    if [[ ! -f "${DIR}/libs/${BOOST_TARBALL}" ]]; then
        echo "Downloading Boost ${BOOST_VERSION}..."
        curl -L --fail --progress-bar -o "${DIR}/libs/${BOOST_TARBALL}" "${BOOST_URL}"
    fi

    # Verify download is a valid tarball
    if ! file "${DIR}/libs/${BOOST_TARBALL}" | grep -q "gzip compressed"; then
        echo "Error: Downloaded file is not a valid gzip archive"
        echo "Contents: $(head -c 100 "${DIR}/libs/${BOOST_TARBALL}")"
        rm -f "${DIR}/libs/${BOOST_TARBALL}"
        exit 1
    fi

    # Extract
    echo "Extracting..."
    rm -rf "${BOOST_SRC}"
    mkdir -p "${BOOST_SRC}"
    tar -xzf "${DIR}/libs/${BOOST_TARBALL}" -C "${BOOST_SRC}" --strip-components=1

    # Bootstrap and build
    echo "Building Boost (this may take a while)..."
    cd "${BOOST_SRC}"

    ./bootstrap.sh --prefix="${BOOST_DIR}" \
        --with-libraries=system,filesystem,program_options,iostreams,regex,thread

    ./b2 install \
        --prefix="${BOOST_DIR}" \
        -j${THREADS} \
        link=static \
        threading=multi \
        variant=release

    # Cleanup
    echo "Cleaning up..."
    rm -rf "${BOOST_SRC}"

    echo "Boost ${BOOST_VERSION} installed to ${BOOST_DIR}"
}
# -- }}}

