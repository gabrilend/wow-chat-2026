#!/usr/bin/env luajit
--------------------------------------------------------------------------------
-- generate-fight-forward-pass-page - writes the page that lays out how the
-- buddies think in a fight (issue 625n): the fight's forward pass.
--
-- For a general audience: the owner compared a buddy's fight curves to a
-- language model reading everything said so far through the same weights to
-- find its next word, and asked how it would be built. This writes that
-- design as a page in the project pages' look: the analogy side by side,
-- what the snapshot of a fight holds, the minute of events, the weights,
-- the six layers drawn with what is built, where it runs, and a playground
-- where the fight curves can be moved by hand (a dying tank, Lay on Hands,
-- Hand of Protection), using the same arithmetic as the buddy module's
-- buddies_curve.h, with the numbers its test checks as the starting values.
-- The layers' build state, the snapshot's fields and the owner's words are
-- tables in this script; change them here and run it again.
--
-- Writes: docs/HTML/fight-forward-pass.html (a whole page), and with
--         --fragment PATH the same page without its outer skeleton, for
--         publishing as an artifact (which wraps its own skeleton round it)
-- Usage:  scripts/generate-fight-forward-pass-page [PROJECT_DIR] [--fragment PATH]
--         scripts/generate-fight-forward-pass-page --help
--------------------------------------------------------------------------------

-- {{{ configuration
local DIR, FRAGMENT = "/mnt/kaun/wow-chat-2026", nil
local i = 1
while i <= #arg do
    local a = arg[i]
    if a == "--help" or a == "-h" then
        print("generate-fight-forward-pass-page [PROJECT_DIR] [--fragment PATH]: writes docs/HTML/fight-forward-pass.html")
        print("  (issue 625n's design as a page); --fragment PATH also writes the page without its skeleton (for an artifact).")
        os.exit(0)
    elseif a == "--fragment" then FRAGMENT = arg[i + 1]; i = i + 2
    elseif a:sub(1, 2) == "--" then io.stderr:write("generate-fight-forward-pass-page: unknown option " .. a .. "\n"); os.exit(1)
    else DIR = a; i = i + 1 end
end
local OUT = DIR .. "/docs/HTML/fight-forward-pass.html"
-- }}}

local function esc(s) return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end

-- {{{ the layers: name, what it does, its issue, built or not
-- state: "built" (offline, tested), "part" (some of it), "todo"
local LAYERS = {
    { "Rates",              "Health lost and gained per character, enemies' health falling, so the fight's time left.", "625h", "built" },
    { "Marks to modifiers", "Every buff and debuff a multiplier on damage taken, healing received, damage dealt or haste, ending when it does.", "625f", "part" },
    { "Attention",          "Whom each enemy attacks now and next, in the server's own order.", "625j", "built" },
    { "Fight curves",       "Each character's health to the fight's end, by who holds the attention, marks wearing off and planned cooldowns.", "625j", "built" },
    { "Plans",              "Each buddy's cooldown timeline, the tanks' swaps, the healer's plan, who gets each buff.", "625f 625i 625l", "part" },
    { "Answers",            "Each answer a buddy could give now, tried as if given; its change to the curves in damage and health, handed to the draw.", "625d", "todo" },
}
local STATE_LABEL = { built = "built, offline", part = "part built", todo = "not yet" }
-- }}}

-- {{{ the snapshot: field, type, what it is
local SNAPSHOT = {
    { "The fight", {
        { "seconds run", "decimal", "since the pull" },
        { "kind", "small whole number", "boss, rare elite or trash" },
        { "windows open", "list of start, length, factor (decimals)", "Bloodlust running, a weak phase" },
    } },
    { "Each party member and pet", {
        { "health, most health", "decimals", "now and at most" },
        { "resource, most, which", "decimals and a small whole number", "mana, rage, energy, runic power, focus" },
        { "role", "small whole number", "tank, healer or damage" },
        { "position", "three decimals", "where it stands" },
        { "cast in progress", "spell id (whole number), seconds left (decimal)", "what it is casting" },
        { "cooldowns", "list of spell id, seconds until ready", "every ability waiting" },
        { "marks", "list of marks (below)", "what is on it" },
    } },
    { "Each mark", {
        { "aura", "spell id (whole number)", "which buff or debuff" },
        { "seconds left", "decimal", "until it wears off" },
        { "stacks", "small whole number", "how many" },
        { "put on by", "character id", "whose it is" },
    } },
    { "Each enemy", {
        { "health, most, rank, cast, marks", "as above", "the enemy's own state" },
        { "attacking", "character id", "its attention now" },
        { "threat list", "per character: threat (decimal); available, passed over or out; taunting, none or turned away; within melee reach (yes or no)", "where the threat is stored" },
    } },
}
-- }}}

-- {{{ the analogy, side by side
local ANALOGY = {
    { "Everything said so far", "The fight so far: one snapshot and a minute of events" },
    { "Tokens, one after another", "Events: a hit, a heal, a mark landing or wearing off, a cast, a death" },
    { "The cache, so nothing is read twice", "Running summaries, updated as each event arrives" },
    { "Fixed weights", "The game's own numbers and the economies' arithmetic" },
    { "Layers, each reading the last", "Rates, marks, attention, fight curves, plans, answers" },
    { "A score for every word it could say", "A worth for every answer a buddy could give now" },
    { "Sampling the next token", "The weighted draw picking what the buddy does" },
}
-- }}}

-- {{{ the owner's words (issue 625n, word for word)
local WORDS = {
    { "The idea", "okay so the curve is a path through a series of weights, sorta like when an LLM is processing a long string of output text. At the instant when it processes it's next token, it feeds all the previous data through the same weights and sees where it trajectorizes to. We want to do something similar, all of the status effects of the fight should be charted and mapped and routed through these weights, each moment we supply the entire state and it updates the fight curve according to the new, and extended, and desired, state." },
    { "What is desired", "depends on the group. What do they value? besides victory, bots prefer lower gold cost (use fewer consumables) and faster time (3 minute kill instead of 4). When questing and such, they prefer things like gold-per-hour, and exp-per-hour." },
    { "What a buddy may know", "we can let them know. Yes, it's not human, but humans have better capabilities in some ways and worse in others. So, with an eventual goal of equalizing the presented information, let's just let them see the numbers for now." },
    { "How far back", "a minute is fine." },
    { "The weights", "I don't imagine they will grow very much. They are things like, how much certain talents benefit certain abilities, how critical strike rating relates to certain spells, how resistant a target is to a certain type of shadow blast, how important mana is to this particular fight, stuff like that." },
}
-- }}}

-- {{{ the layer drawing: six bands, the snapshot coming in at the top, the draw at the bottom
local svg = { '<svg class="stack" viewBox="0 0 640 520" role="img" aria-label="Six layers, from rates at the top to answers at the bottom, each reading the one before; the snapshot enters at the top and the weighted draw takes the answers at the bottom">' }
svg[#svg + 1] = '<rect x="170" y="8" width="300" height="34" rx="4" class="io"/><text x="320" y="30" class="io-label">snapshot + a minute of events</text>'
svg[#svg + 1] = '<line x1="320" y1="42" x2="320" y2="56" class="arrow"/>'
for n, l in ipairs(LAYERS) do
    local y = 56 + (n - 1) * 70
    svg[#svg + 1] = ('<rect x="40" y="%d" width="560" height="56" rx="4" class="layer %s"/>'):format(y, l[4])
    svg[#svg + 1] = ('<text x="58" y="%d" class="layer-n">%d</text>'):format(y + 34, n)
    svg[#svg + 1] = ('<text x="88" y="%d" class="layer-name">%s</text>'):format(y + 25, esc(l[1]))
    svg[#svg + 1] = ('<text x="88" y="%d" class="layer-issue">%s</text>'):format(y + 44, esc(l[3]))
    svg[#svg + 1] = ('<text x="584" y="%d" class="layer-state">%s</text>'):format(y + 34, esc(STATE_LABEL[l[4]]))
    if n < #LAYERS then svg[#svg + 1] = ('<line x1="320" y1="%d" x2="320" y2="%d" class="arrow"/>'):format(y + 56, y + 70) end
end
local yEnd = 56 + #LAYERS * 70 - 14
svg[#svg + 1] = ('<line x1="320" y1="%d" x2="320" y2="%d" class="arrow"/>'):format(yEnd, yEnd + 14)
svg[#svg + 1] = ('<rect x="170" y="%d" width="300" height="34" rx="4" class="io"/><text x="320" y="%d" class="io-label">the weighted draw: what the buddy does</text>'):format(yEnd + 14, yEnd + 36)
svg[#svg + 1] = "</svg>"
-- }}}

-- {{{ the threads drawing: world thread, snapshot, workers, double buffer, draw
local threads = [==[
<svg class="threads" viewBox="0 0 640 210" role="img" aria-label="The world thread takes a snapshot and hands it to a pool of worker threads; their verdicts go to a double buffer that the bot module's draw reads from">
  <rect x="10" y="80" width="130" height="50" rx="4" class="io"/><text x="75" y="102" class="io-label">world thread</text><text x="75" y="120" class="small">takes the snapshot</text>
  <line x1="140" y1="105" x2="190" y2="105" class="arrow"/>
  <rect x="190" y="20" width="200" height="40" rx="4" class="layer built"/><text x="290" y="45" class="io-label">party task: shared layers</text>
  <rect x="190" y="85" width="200" height="40" rx="4" class="layer built"/><text x="290" y="110" class="io-label">buddy task: its plan</text>
  <rect x="190" y="150" width="200" height="40" rx="4" class="layer built"/><text x="290" y="175" class="io-label">buddy task: its plan</text>
  <line x1="390" y1="105" x2="440" y2="105" class="arrow"/>
  <rect x="440" y="70" width="80" height="35" rx="3" class="io"/><text x="480" y="92" class="small">next</text>
  <rect x="440" y="110" width="80" height="35" rx="3" class="io"/><text x="480" y="132" class="small">last</text>
  <line x1="520" y1="127" x2="560" y2="127" class="arrow"/>
  <rect x="560" y="105" width="72" height="45" rx="4" class="io"/><text x="596" y="132" class="small">the draw</text>
</svg>]==]
-- }}}

-- {{{ html pieces
local function analogyTable()
    local t = { '<div class="table"><table><thead><tr><th>A language model</th><th>A buddy in a fight</th></tr></thead><tbody>' }
    for _, r in ipairs(ANALOGY) do t[#t + 1] = ("<tr><td>%s</td><td>%s</td></tr>"):format(esc(r[1]), esc(r[2])) end
    t[#t + 1] = "</tbody></table></div>"
    return table.concat(t)
end
local function snapshotTables()
    local t = {}
    for _, group in ipairs(SNAPSHOT) do
        t[#t + 1] = ('<h3>%s</h3><div class="table"><table><thead><tr><th>Field</th><th>Kind of value</th><th>What it is</th></tr></thead><tbody>'):format(esc(group[1]))
        for _, r in ipairs(group[2]) do t[#t + 1] = ("<tr><td>%s</td><td>%s</td><td>%s</td></tr>"):format(esc(r[1]), esc(r[2]), esc(r[3])) end
        t[#t + 1] = "</tbody></table></div>"
    end
    return table.concat(t)
end
local function layerList()
    local t = { '<ol class="layers">' }
    for _, l in ipairs(LAYERS) do
        t[#t + 1] = ('<li><strong>%s</strong> <span class="chip %s">%s</span><br>%s <span class="issue">(%s)</span></li>'):format(esc(l[1]), l[4], esc(STATE_LABEL[l[4]]), esc(l[2]), esc(l[3]))
    end
    t[#t + 1] = "</ol>"
    return table.concat(t)
end
local function words()
    local t = {}
    for _, w in ipairs(WORDS) do t[#t + 1] = ('<blockquote><p class="who">%s</p><p>%s</p></blockquote>'):format(esc(w[1]), esc(w[2])) end
    return table.concat(t)
end
-- }}}

