local sections = {
    { "idea", "The idea" }, { "context", "The snapshot" }, { "events", "A minute of events" }, { "weights", "The weights" },
    { "layers", "The six layers" }, { "desired", "New, extended, desired" }, { "playground", "Fight curves, by hand" },
    { "threads", "Where it runs" }, { "calm", "Calm, and replays" }, { "words", "The owner's words" }, { "open", "Still open" },
}
local nav = {}
for _, s in ipairs(sections) do nav[#nav + 1] = ('<a href="#%s">%s</a>'):format(s[1], esc(s[2])) end

local body = table.concat({
'<div class="wrap"><nav aria-label="Contents"><div class="eyebrow">Contents</div><div class="links">', table.concat(nav), '</div></nav><main>',
'<h1>Fight Forward Pass</h1>',
'<p class="lede">How a buddy thinks in a fight: everything that has happened so far, run through the same fixed weights every moment, to find where every character\'s health is heading and which answer bends it toward victory. Issue 625n.</p>',

'<h2 id="idea">The idea</h2>',
'<p>A language model reads everything said so far through fixed weights and scores every word it could say next. A buddy reads the fight so far through fixed weights and scores every answer it could give now. The pieces line up one to one.</p>',
analogyTable(),

'<h2 id="context">The snapshot</h2>',
'<p>Taken by the world thread when something has happened (no thinking while nothing does, issue 627; at most every half second in combat), once per party, so every buddy reads the same picture. Plain values copied, never game objects, so worker threads can read it while the game moves on. Buddies see every number for now; equalizing what they are shown against what a player beside them could see is the later goal.</p>',
snapshotTables(),

'<h2 id="events">A minute of events</h2>',
'<p>Each hit, heal, mark landing or wearing off, cast and death goes into a ring that holds the last minute, each stamped with its time. Running summaries are updated as each event arrives, so a step never reads the whole minute again: damage taken and healing received per second for each character, damage dealt per second against each enemy, each enemy\'s health trend (which is the fight-length guess, already built).</p>',

'<h2 id="weights">The weights</h2>',
'<p>Mostly fixed. Three kinds:</p>',
'<ol><li><strong>The game\'s own tables</strong>, read by generators: every class\'s abilities, what each buff gives, which talents touch which abilities, the lockouts (Forbearance, Sated), the threat levers. Still to add: what each debuff does to whoever carries it.</li>',
'<li><strong>Each buddy\'s own</strong>: its abilities, talents and gear, worked out again when they change.</li>',
'<li><strong>The few that may move with play</strong>, each kept with where it started and how it moves: how much a talent benefits an ability, how a rating relates to a spell, how resistant a target is to a school, how much mana matters in this fight.</li></ol>',

'<h2 id="layers">The six layers</h2>',
'<p>Each step runs them in order, each reading the one before.</p>',
'<figure>', table.concat(svg), '<figcaption>The snapshot enters at the top; the weighted draw takes the answers at the bottom. Green: built and tested offline. Gold: part built. Grey: not yet.</figcaption></figure>',
layerList(),

'<h2 id="desired">New, extended, desired</h2>',
'<ul><li><strong>New</strong> is the snapshot just taken.</li>',
'<li><strong>Extended</strong> is the fight curves carried forward to the fight\'s end, with the plans in them.</li>',
'<li><strong>Desired</strong> is what the group values: victory first (every enemy dead before anyone in the party, no curve below nothing); then, by default, fewer consumables used and a faster kill; when questing, gold and experience per hour.</li></ul>',
'<p>Each step measures the gap from extended to desired. An answer is worth what it closes of that gap, said in damage and health so everything adds up.</p>',

'<h2 id="playground">Fight curves, by hand</h2>',
'<p>A tank at 2000 of 8000 health, a fury warrior and a priest behind it. Move the numbers and pick a lever; the curves are each character\'s health to the fight\'s end, worked out the way the buddy module works them out. The starting values are the ones its test checks: nothing done leaves the party 4000 short, Lay on Hands none, Hand of Protection with the fury warrior next 1700, with the priest next worse than nothing.</p>',
[==[<div class="play">
  <div class="controls">
    <label for="tankHealth">Tank health now <output id="tankHealthOut"></output><input id="tankHealth" type="range" min="500" max="8000" step="100" value="2000"></label>
    <label for="damage">Enemy damage per second <output id="damageOut"></output><input id="damage" type="range" min="100" max="1500" step="25" value="500"></label>
    <label for="healing">Healing per second <output id="healingOut"></output><input id="healing" type="range" min="0" max="1200" step="25" value="300"></label>
    <label for="left">Fight left, seconds <output id="leftOut"></output><input id="left" type="range" min="10" max="120" step="1" value="30"></label>
    <label for="markTaken">Debuff on the tank: damage taken &#215; <output id="markTakenOut"></output><input id="markTaken" type="range" min="0.5" max="3" step="0.05" value="1"></label>
    <label for="markUntil">Debuff wears off after, seconds <output id="markUntilOut"></output><input id="markUntil" type="range" min="0" max="60" step="1" value="10"></label>
  </div>
  <div class="levers" role="group" aria-label="Lever">
    <button type="button" id="leverNone" aria-pressed="true">Nothing</button>
    <button type="button" id="leverLoh" aria-pressed="false">Lay on Hands (5000)</button>
    <button type="button" id="leverHop" aria-pressed="false">Hand of Protection (10 s)</button>
    <label for="next" class="small-label">next in line <select id="next"><option value="1">the fury warrior</option><option value="2">the priest</option></select></label>
  </div>
  <svg id="chart" viewBox="0 0 640 300" role="img" aria-label="Each character's health over the rest of the fight"></svg>
  <div class="key"><span class="k-tank">tank</span><span class="k-fury">fury warrior</span><span class="k-priest">priest</span><span>the band under the chart: who holds the attention</span></div>
  <div class="verdict" id="verdict"></div>
</div>]==],

'<h2 id="threads">Where it runs</h2>',
'<p>The world thread only takes the snapshot and reads the last verdict; the game\'s objects are safe to touch only there. A pool of worker threads runs the layers: one task per party for what is shared (attention, the fight curves, the tanks\' swaps, who gets each buff), one per buddy for its own plan and answers. Verdicts are double-buffered: the workers write the next while the bot module reads the last, at most one step old. Measured: a buddy\'s cooldown plan takes about half a millisecond for a five-minute fight, a fight curve microseconds.</p>',
'<figure>', threads, '<figcaption>One snapshot, worked by many threads, read back through a double buffer.</figcaption></figure>',

'<h2 id="calm">Calm, and replays</h2>',
'<p>The server\'s own switching margins (a new attacker must beat the current one by a tenth in melee reach, three tenths at range), no swap or hold for nothing, weights that change smoothly, and the weighted draw at the end keep the buddies natural rather than scripted. Every step\'s snapshot and verdict can be written to a log; a recorded fight run back through the layers gives the same verdicts every time, so changes are tested on real fights and learning has its material.</p>',

'<h2 id="words">The owner\'s words</h2>',
words(),

'<h2 id="open">Still open</h2>',
'<p>Gold cost: which consumables count (potions, food, flasks, reagents, ammunition, repairs), and is each counted at its vendor price, or at the auction house\'s when there is one?</p>',

'<p class="source">Made by scripts/generate-fight-forward-pass-page from issue 625n\'s design; the playground uses the same arithmetic as the buddy module\'s fight curves (buddies_curve.h). Change the script and run it again.</p>',
'</main></div>',
}, "\n")

-- the playground's arithmetic: the module's Shortfall, twinned (same stretches,
-- same marks cut where they wear off, healing never above most)
local script = [==[
<script>
(function () {
  "use strict";
  var $ = function (id) { return document.getElementById(id); };
  var lever = "none";
  var NAMES = ["tank", "fury", "priest"];
  var LABELS = ["Tank", "Fury warrior", "Priest"];
  function loss(h, t, f, cut) {
    var taken = h.taken, healed = 1;
    for (var i = 0; i < h.marks.length; i++) if (t < h.marks[i].until) { taken *= h.marks[i].taken; healed *= h.marks[i].healed; }
    return f.damage * taken * (1 - cut) - f.healing * healed;
  }
  // follows every holder step by step, keeping each one's path for the chart
  function follow(holders, stretches, f) {
    var hs = holders.map(function (h) { return { health: h.health, maxHealth: h.maxHealth, taken: h.taken, marks: h.marks }; });
    var step = 0.25, paths = hs.map(function (h) { return [[0, h.health]]; }), lowest = hs.map(function (h) { return h.health; });
    for (var t = 0; t < f.left - 1e-9; t += step) {
      var dt = Math.min(step, f.left - t), who = -1, cut = 0;
      for (var s = 0; s < stretches.length; s++) if (t >= stretches[s].from && t < stretches[s].to) { who = stretches[s].holder; cut = stretches[s].cut; }
      if (who >= 0) {
        var h = hs[who];
        h.health = Math.min(h.maxHealth, h.health - loss(h, t, f, cut) * dt);
        lowest[who] = Math.min(lowest[who], h.health);
      }
      for (var k = 0; k < hs.length; k++) paths[k].push([t + dt, hs[k].health]);
    }
    return { paths: paths, short: lowest.map(function (l) { return Math.max(0, -l); }) };
  }
  function read() {
    var v = {};
    ["tankHealth", "damage", "healing", "left", "markTaken", "markUntil"].forEach(function (id) { v[id] = parseFloat($(id).value); $(id + "Out").textContent = $(id).value; });
    return v;
  }
  function draw() {
    var v = read();
    var holders = [
      { health: v.tankHealth, maxHealth: 8000, taken: 1.0, marks: v.markTaken !== 1 ? [{ until: v.markUntil, taken: v.markTaken, healed: 1 }] : [] },
      { health: 6000, maxHealth: 6000, taken: 1.6, marks: [] },
      { health: 4000, maxHealth: 4000, taken: 2.0, marks: [] }
    ];
    var f = { damage: v.damage, healing: v.healing, left: v.left };
    var next = parseInt($("next").value, 10), stretches;
    if (lever === "loh") holders[0].health = Math.min(8000, holders[0].health + 5000);
    if (lever === "hop") stretches = [{ from: 0, to: 11.5, holder: next, cut: 0 }, { from: 11.5, to: f.left, holder: 0, cut: 0 }];
    else stretches = [{ from: 0, to: f.left, holder: 0, cut: 0 }];
    var r = follow(holders, stretches, f);
    // chart: health from the lowest reached (or a little under nothing) to 8000
    var W = 640, H = 300, L = 54, R = 12, T = 12, B = 46, band = 10;
    var lo = 0; r.paths.forEach(function (p) { p.forEach(function (q) { lo = Math.min(lo, q[1]); }); });
    lo = Math.floor(lo / 1000) * 1000 - (lo < 0 ? 0 : 0);
    var hi = 8000;
    var x = function (t) { return L + (W - L - R) * t / f.left; };
    var y = function (h) { return T + (H - T - B) * (hi - h) / (hi - lo); };
    var out = [];
    for (var g = lo; g <= hi; g += 2000) out.push('<line x1="' + L + '" x2="' + (W - R) + '" y1="' + y(g) + '" y2="' + y(g) + '" class="axis"/><text x="' + (L - 6) + '" y="' + (y(g) + 4) + '" class="tick" text-anchor="end">' + g + '</text>');
    out.push('<line x1="' + L + '" x2="' + (W - R) + '" y1="' + y(0) + '" y2="' + y(0) + '" class="zero"/>');
    var tickStep = f.left > 60 ? 20 : 10;
    for (var s2 = 0; s2 <= f.left; s2 += tickStep) out.push('<text x="' + x(s2) + '" y="' + (H - B + 16) + '" class="tick" text-anchor="middle">' + s2 + ' s</text>');
    r.paths.forEach(function (p, k) {
      var d = p.map(function (q, n) { return (n ? "L" : "M") + x(q[0]).toFixed(1) + " " + y(q[1]).toFixed(1); }).join(" ");
      out.push('<path d="' + d + '" class="curve c-' + NAMES[k] + '"/>');
    });
    stretches.forEach(function (s) {
      var a = x(Math.max(0, s.from)), b = x(Math.min(f.left, s.to));
      if (b > a) out.push('<rect x="' + a + '" y="' + (H - B + 24) + '" width="' + (b - a) + '" height="' + band + '" class="holder-' + NAMES[s.holder] + '"/>');
    });
    $("chart").innerHTML = out.join("");
    var total = r.short.reduce(function (a, b) { return a + b; }, 0);
    var cells = r.short.map(function (s, k) { return '<div><div class="k">' + LABELS[k] + ' short</div><div class="v">' + Math.round(s) + '</div></div>'; });
    cells.push('<div class="total"><div class="k">Party short</div><div class="v">' + Math.round(total) + '</div></div>');
    cells.push('<div><div class="k">Curve points at</div><div class="v">' + (total < 0.5 ? "victory" : "a death") + '</div></div>');
    $("verdict").innerHTML = cells.join("");
  }
  function pick(which) {
    lever = which;
    [["none", "leverNone"], ["loh", "leverLoh"], ["hop", "leverHop"]].forEach(function (p) { $(p[1]).setAttribute("aria-pressed", p[0] === which ? "true" : "false"); });
    draw();
  }
  ["tankHealth", "damage", "healing", "left", "markTaken", "markUntil"].forEach(function (id) { $(id).addEventListener("input", draw); });
  $("next").addEventListener("change", draw);
  $("leverNone").addEventListener("click", function () { pick("none"); });
  $("leverLoh").addEventListener("click", function () { pick("loh"); });
  $("leverHop").addEventListener("click", function () { pick("hop"); });
  draw();
})();
</script>
]==]

local content = style .. body .. "\n" .. script
local note = "<!-- docs/HTML/fight-forward-pass.html - GENERATED by scripts/generate-fight-forward-pass-page (issue 625n's design as a page); don't edit, run it again. -->\n"
local page = "<!doctype html>\n" .. note .. '<html lang="en">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">\n' ..
    style .. "\n</head>\n<body>\n" .. body .. "\n" .. script .. "\n</body>\n</html>\n"
local o = assert(io.open(OUT, "w")); o:write(page); o:close()
print(("generate-fight-forward-pass-page: %d bytes -> %s"):format(#page, OUT:sub(#DIR + 2)))
if FRAGMENT then
    local fr = assert(io.open(FRAGMENT, "w")); fr:write(note:gsub("docs/HTML/fight%-forward%-pass%.html", "the artifact's page"), content, "\n"); fr:close()
    print("generate-fight-forward-pass-page: the page without its skeleton -> " .. FRAGMENT)
end
