#!/usr/bin/env luajit
-- generate-gearset-sql
--
-- What it does: puts every gearset profile (src/lua-basic/data/gearsets/
-- *.lua, issue 617r) into the world database as rows of one table,
-- gearset_item, so code that isn't Lua (the buddy module, C++) reads the
-- very same profiles the Lua scripts do. Writes
-- sql/basic/db_world.src/33-gearsets.apply.sql, applied by install step
-- E052.
--
-- How: one row per item of every record: the profile's name, the record's
-- keys in the profile's own order (key1, key2, key3; 0 where a profile has
-- fewer), the slot and the item. Equipment slots are 0-17; a record's bags
-- are slots 100, 101, ... in order; its ammunition is slot 200 with its
-- count as the amount. A profile's key names are kept in gearset_profile,
-- so a reader can tell a level key (take the highest at or below) from an
-- exact one.
--
-- Usage: scripts/generate-gearset-sql [PROJECT_DIR] [--stdout]

-- {{{ configuration
local DIR, STDOUT = "/mnt/kaun/wow-chat-2026", false
for _, a in ipairs(arg) do
    if a == "--stdout" then STDOUT = true elseif a ~= "" then DIR = a end
end
local GEARSETS = DIR .. "/src/lua-basic/data/gearsets/"
local OUT      = DIR .. "/sql/basic/db_world.src/33-gearsets.apply.sql"
local BAG_SLOT, AMMO_SLOT = 100, 200
-- }}}

local Gearsets = dofile(DIR .. "/src/lua-basic/lib/gearsets.lua")

-- the profiles, by name, in a fixed order
local names = {}
local ls = io.popen('ls "' .. GEARSETS .. '"')
for f in ls:lines() do
    local n = f:match("^([%w%-]+)%.lua$")
    if n then names[#names + 1] = n end
end
ls:close()
table.sort(names)

local out = {
    "-- MARKER_E052_APPLY gearsets",
    "-- 33-gearsets (issue 617r) - GENERATED by scripts/generate-gearset-sql from",
    "-- src/lua-basic/data/gearsets/*.lua; don't edit by hand: edit a profile and re-run.",
    "--",
    "-- gearset_profile: name, key1/key2/key3 (the key each column holds: shape,",
    "--   class, race, level; '' when unused).",
    "-- gearset_item: profile, key1, key2, key3 (integers; 0 when unused), slot",
    "--   (0-17 equipment; 100+ bags in order; 200 ammunition), item, amount.",
    "-- Re-applicable: both tables are emptied and refilled.",
    "",
    "CREATE TABLE IF NOT EXISTS `gearset_profile` (",
    "    `name` VARCHAR(32) NOT NULL, `key1` VARCHAR(8) NOT NULL, `key2` VARCHAR(8) NOT NULL, `key3` VARCHAR(8) NOT NULL,",
    "    PRIMARY KEY (`name`)",
    ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='issue 617r: gearset profiles and their keys';",
    "CREATE TABLE IF NOT EXISTS `gearset_item` (",
    "    `profile` VARCHAR(32) NOT NULL, `key1` INT UNSIGNED NOT NULL, `key2` INT UNSIGNED NOT NULL, `key3` INT UNSIGNED NOT NULL,",
    "    `slot` SMALLINT UNSIGNED NOT NULL, `item` INT UNSIGNED NOT NULL, `amount` INT UNSIGNED NOT NULL DEFAULT 1,",
    "    PRIMARY KEY (`profile`, `key1`, `key2`, `key3`, `slot`)",
    ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='issue 617r: every item of every gearset record';",
    "DELETE FROM `gearset_profile`;",
    "DELETE FROM `gearset_item`;",
    "",
}
local rows = 0
for _, name in ipairs(names) do
    local p = Gearsets.load(GEARSETS, name)
    if #p.keys > 3 then error(name .. ": more than three keys; gearset_item holds three") end
    out[#out + 1] = string.format("INSERT INTO `gearset_profile` VALUES ('%s', '%s', '%s', '%s');",
        name, p.keys[1] or "", p.keys[2] or "", p.keys[3] or "")
    local values = {}
    -- walk the records depth-first in key order, sorted, so the file is stable
    local function walk(node, depth, keys)
        if depth > #p.keys then
            local function add(slot, item, amount)
                values[#values + 1] = string.format("('%s',%d,%d,%d,%d,%d,%d)", name, keys[1] or 0, keys[2] or 0, keys[3] or 0, slot, item, amount)
            end
            for slot = 0, 17 do if node.items and node.items[slot] then add(slot, node.items[slot], 1) end end
            for i, bag in ipairs(node.bags or {}) do add(BAG_SLOT + i - 1, bag, 1) end
            if node.ammo then add(AMMO_SLOT, node.ammo.item, node.ammo.count) end
            return
        end
        local ks = {}
        for k in pairs(node) do ks[#ks + 1] = k end
        table.sort(ks)
        for _, k in ipairs(ks) do
            keys[depth] = k
            walk(node[k], depth + 1, keys)
        end
        keys[depth] = nil
    end
    walk(p.records, 1, {})
    -- in batches of 500 rows, so no one statement grows huge
    for i = 1, #values, 500 do
        out[#out + 1] = "INSERT INTO `gearset_item` VALUES\n" .. table.concat(values, ",\n", i, math.min(i + 499, #values)) .. ";"
    end
    rows = rows + #values
end
local text = table.concat(out, "\n") .. "\n"

if STDOUT then
    io.write(text)
else
    local f = assert(io.open(OUT, "w"))
    f:write(text)
    f:close()
    print(string.format("Wrote %s: %d profiles, %d item rows", OUT, #names, rows))
end
