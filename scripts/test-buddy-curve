#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-curve
# profiles:   all
# priority:   10
# kind:       test
# about:      the curve each character's health follows to the fight's end, and the levers that turn a dying tank's curve toward victory
# quick-test: yes
# ==== end of header ====
# test-buddy-curve - compiles and runs
# tests/buddy-curve/curve-check.cpp against the buddy module's
# health curves (issue 625j), with no server.
#
# Usage: scripts/test-buddy-curve [DIR]   (--help: this text)

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    sed -n '10,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
DIR="${1:-/mnt/kaun/wow-chat-2026}"
OUT="${DIR}/tmp/tmp"
mkdir -p "${OUT}"
g++ -std=c++17 -O1 -Wall -Wextra -Werror -I"${DIR}/patches/B036-mod-buddies/mod-buddies/src" \
    "${DIR}/tests/buddy-curve/curve-check.cpp" -o "${OUT}/buddy-curve" || exit 1
nice -n 19 "${OUT}/buddy-curve"
# ==== footer of test-buddy-curve ====
# lines:      28
# ==== end of footer ====
