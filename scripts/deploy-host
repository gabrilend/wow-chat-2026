#!/usr/bin/env luajit
--------------------------------------------------------------------------------
-- deploy-host - one field of one role from the roles file (issue 157a)
--
-- For a general audience: config/deploy-hosts.lua says which machine does
-- each of the server's jobs (database, auth, world). Bash scripts ask this
-- tool for what they need instead of reading Lua themselves:
--
--   scripts/deploy-host world lan_address     -> 127.0.0.1 while world is local
--   scripts/deploy-host database local        -> yes / no
--   scripts/deploy-host --check               -> every mistake in the file
--
-- Fields: lan_address, ssh_user, install_dir, arch, and "local". A local
-- role answers this machine's own: 127.0.0.1, no ssh user (an empty line),
-- the project folder, and `uname -m`. The file is checked before any answer;
-- a file with a mistake answers nothing.
--
-- Usage: scripts/deploy-host [PROJECT_DIR] <role> <field>
--        scripts/deploy-host [PROJECT_DIR] --check
--   PROJECT_DIR  (has a "/" in it) defaults to the hard-coded path below
-- Exit status: 0 with the answer (or "ok") on standard output; 1 with the
-- reason on standard error.
--------------------------------------------------------------------------------

local args = { ... }
local DIR  = "/mnt/kaun/wow-chat-2026"
if args[1] and args[1]:find("/") then DIR = table.remove(args, 1) end
DIR = DIR:gsub("/+$", "")

local function die(msg) io.stderr:write("deploy-host: " .. msg .. "\n"); os.exit(1) end
local usage = "usage: deploy-host [PROJECT_DIR] <role> <field> | deploy-host [PROJECT_DIR] --check"

local Hosts = dofile(DIR .. "/scripts/lib/deploy-hosts.lua")
local path  = DIR .. "/config/deploy-hosts.lua"
local hosts, err = Hosts.load(path)
if not hosts then die(err) end
local problems = Hosts.problems(hosts)
if #problems > 0 then die(path .. ": " .. #problems .. " mistake(s):\n  " .. table.concat(problems, "\n  ")) end

if args[1] == "--check" then
    if #args ~= 1 then die(usage) end
    print("ok"); os.exit(0)
end
if #args ~= 2 then die(usage) end

-- {{{ this machine's architecture, for a local role
local function uname_m()
    local p = io.popen("uname -m 2>/dev/null")
    local a = p and p:read("*l") or nil
    if p then p:close() end
    return a or ""
end
-- }}}

local value, why = Hosts.field(hosts, args[1], args[2], { dir = DIR, arch = args[2] == "arch" and uname_m() or "" })
if value == nil then die(why) end
print(value)
