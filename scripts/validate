#!/bin/bash

DIR="/mnt/kaun/wow-chat-2026"


if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi
DEFAULT_PROFILE="${PROFILE}"


parse_args() {
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    PROFILE="${2}"
                    shift 2
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                if [[ -z "${PROFILE}" ]]; then
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                shift
                ;;
            --no-promote)
                NO_PROMOTE=true
                shift
                ;;
            --then-serve)
                THEN_SERVE=true
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                echo "Error: unrecognized argument '${1}'"
                echo "Run with --help to see available options."
                exit 1
                ;;
        esac
    done
}

show_help() {
    echo "Usage: ./scripts/validate [options]"
    echo ""
    echo "Validate shadow worldserver build before promotion."
    echo "Starts worldserver from shadow, waits for initialization, then stops."
    echo ""
    echo "Options:"
    echo "  --profile <name>   Use specific profile (default: ${DEFAULT_PROFILE})"
    echo "  --no-promote       Start and stop only (the build's gate 2000: the"
    echo "                     databases brought to upstream's state); no promotion"
    echo "  --help             Show this help message"
    echo ""
    echo "Workflow:"
    echo "  1. ./scripts/compile     - Build to shadow"
    echo "  2. ./scripts/validate    - Test shadow build"
    echo "  3. ./scripts/promote     - Copy shadow to main"
}


get_profile_paths() {
    INSTALL_DIR_SHADOW="${DIR}/installed-files-shadow"
    MYSQL_DIR="${DIR}/mysql/installed-files"
}

validate_shadow_worldserver() {
    local STARTS="${DIR}/build-shadow/.validate-starts-${PROFILE}"
    local AVERAGE=""                                # the average length of the last five starts
    [[ -f "${STARTS}" ]] && AVERAGE="$(tail -n 5 "${STARTS}" | awk '{ s += $2; n++ } END { if (n > 0) printf "%d", s / n }')"
    local LIMIT=300                                 # seconds a start may take: the average plus half
    [[ "${AVERAGE}" =~ ^[0-9]+$ && ${AVERAGE} -gt 0 ]] && LIMIT=$(( AVERAGE + (AVERAGE + 1) / 2 ))
    LIMIT=${VALIDATE_MAX_TIMEOUT:-${LIMIT}}         # set outright by scripts/test-validate-needs-world-up
    local HARD_LIMIT=${VALIDATE_HARD_LIMIT:-3600}   # seconds in all, whatever happens
    local PROBE_EVERY=5                             # seconds between counts of finished updates
    local GRACE=$(( (LIMIT + 2) / 3 ))
    (( GRACE < 2 * PROBE_EVERY )) && GRACE=$(( 2 * PROBE_EVERY ))
    local START_EPOCH
    START_EPOCH="$(date +%s)"                       # updates finished since then are this start's
    local PROGRESS_CMD="${VALIDATE_PROGRESS_CMD:-}"
    if [[ -z "${PROGRESS_CMD}" ]]; then
        local MYSQL_CALL="\"${MYSQL_DIR}/bin/mysql\" --defaults-file=${DIR}/mysql/conf/client.cnf -h127.0.0.1 -P3307 -N -B"
        local SCHEMAS
        SCHEMAS="$(eval "${MYSQL_CALL}" -e "\"SELECT table_schema FROM information_schema.tables WHERE table_name = 'updates' AND table_schema LIKE 'acore%'\"" 2>&1 | grep -v "Using a password")"
        if [[ -n "${SCHEMAS}" && "${SCHEMAS}" != *ERROR* ]]; then
            local SUM="" s
            for s in ${SCHEMAS}; do SUM="${SUM:+${SUM} + }(SELECT COUNT(*) FROM ${s}.updates WHERE UNIX_TIMESTAMP(timestamp) >= \${START_EPOCH})"; done
            PROGRESS_CMD="${MYSQL_CALL} -e \"SELECT ${SUM}\" 2>&1 | grep -v 'Using a password'"
        else
            echo "  WARNING (fallback): can't read the databases' update records, so a long run of updates can't extend the time allowed."
            echo "    The database said: ${SCHEMAS:-nothing}"
            echo "    To debug: is MySQL running (scripts/start-mysql)? does ${MYSQL_DIR}/bin/mysql exist?"
        fi
    fi
    local fmt
    fmt() { if (( $1 >= 60 )); then printf '%dm %02ds' $(( $1 / 60 )) $(( $1 % 60 )); else printf '%ds' "$1"; fi; }

    [[ -f "${INSTALL_DIR_SHADOW}/bin/worldserver" ]] || { echo "  ERROR: no worldserver in ${INSTALL_DIR_SHADOW}/bin (did the build install?)"; return 1; }
    [[ -f "${INSTALL_DIR_SHADOW}/etc/worldserver.conf" ]] || { echo "  ERROR: no worldserver.conf in ${INSTALL_DIR_SHADOW}/etc"; return 1; }

    local VALIDATION_LOG="${DIR}/tmp/shadow-validation-${PROFILE}.log"
    local WHAT="the new server starts with our database changes"
    if [[ "${NO_PROMOTE}" == "true" ]]; then
        VALIDATION_LOG="${DIR}/tmp/shadow-gate-2000-${PROFILE}.log"
        WHAT="the new server starts on upstream's databases"
    fi
    echo ""
    echo "Checking ${WHAT} (allowed $(fmt ${LIMIT}))..."
    cd "${INSTALL_DIR_SHADOW}/bin"
    export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"
    mkdir -p "${DIR}/tmp"
    > "${VALIDATION_LOG}"
    ./worldserver \
        -c "${INSTALL_DIR_SHADOW}/etc/worldserver.conf" \
        -C "${INSTALL_DIR_SHADOW}/etc" \
        < /dev/null > "${VALIDATION_LOG}" 2>&1 &
    local WS_PID=$!

    local TTY=""
    { : > /dev/tty; } 2>/dev/null && TTY=/dev/tty

    local elapsed=0 deadline=${LIMIT} success=false
    local applied="" applied_now="" applied_first=""
    if [[ -n "${PROGRESS_CMD}" ]]; then
        applied="$(eval "${PROGRESS_CMD}")"
        applied_first="${applied}"
    fi

    while (( elapsed < deadline && elapsed < HARD_LIMIT )); do
        if grep -qi "World initialized in" "${VALIDATION_LOG}" 2>/dev/null; then
            success=true
            break
        fi
        if ! kill -0 ${WS_PID} 2>/dev/null; then
            [[ -n "${TTY}" ]] && printf '\r\033[K' > "${TTY}"
            echo "  ERROR: the server stopped before it finished starting (after $(fmt ${elapsed}))"
            echo "  Its last line: $(tail -1 "${VALIDATION_LOG}" 2>/dev/null | cut -c1-160)"
            echo "  Its log: ${VALIDATION_LOG}"
            return 1
        fi
        if grep -qE "^(FATAL|.*Failed to initialize World)" "${VALIDATION_LOG}" 2>/dev/null; then
            [[ -n "${TTY}" ]] && printf '\r\033[K' > "${TTY}"
            kill ${WS_PID} 2>/dev/null; wait ${WS_PID} 2>/dev/null
            echo "  ERROR: the server failed to initialize (after $(fmt ${elapsed}))"
            echo "  The error: $(grep -m1 -E "^(FATAL|.*Failed to initialize World)" "${VALIDATION_LOG}" | cut -c1-160)"
            echo "  Its log: ${VALIDATION_LOG}"
            return 1
        fi
        if [[ -n "${PROGRESS_CMD}" ]] && (( elapsed % PROBE_EVERY == 0 )); then
            applied_now="$(eval "${PROGRESS_CMD}")"
            if [[ "${applied_now}" =~ ^[0-9]+$ && "${applied}" =~ ^[0-9]+$ && ${applied_now} -gt ${applied} ]]; then
                (( elapsed + GRACE > deadline )) && deadline=$(( elapsed + GRACE ))
            fi
            [[ "${applied_now}" =~ ^[0-9]+$ ]] && applied="${applied_now}"
        fi
        [[ -n "${TTY}" ]] && printf '\r  %s' "$(fmt ${elapsed})" > "${TTY}"
        sleep 1
        ((elapsed++))
    done
    [[ -n "${TTY}" ]] && printf '\r\033[K' > "${TTY}"

    if kill ${WS_PID} 2>/dev/null; then
        sleep 2
        kill -0 ${WS_PID} 2>/dev/null && kill -9 ${WS_PID} 2>/dev/null
    fi
    wait ${WS_PID} 2>/dev/null

    local updates=""
    [[ "${applied}" =~ ^[0-9]+$ && "${applied_first}" =~ ^[0-9]+$ ]] && updates="$(( applied - applied_first ))"

    if [[ "${success}" == "true" ]]; then
        echo "  Up in $(fmt ${elapsed})${updates:+, ${updates} database updates applied}."
        if [[ -z "${VALIDATE_MAX_TIMEOUT:-}" ]]; then
            mkdir -p "$(dirname "${STARTS}")"
            echo "$(date +%Y-%m-%dT%H:%M:%S) ${elapsed}" >> "${STARTS}"
            if [[ "${AVERAGE}" =~ ^[0-9]+$ && ${AVERAGE} -gt 0 && ${elapsed} -lt $(( AVERAGE / 2 )) ]]; then
                echo "  NOTE: under half the usual $(fmt ${AVERAGE}): it may have skipped work (its log: ${VALIDATION_LOG})"
            fi
        fi
        return 0
    fi
    if (( elapsed >= HARD_LIMIT )); then
        echo "  ERROR: not up after $(fmt ${HARD_LIMIT}), the most any start may take, though updates were still finishing"
    else
        echo "  ERROR: not up after $(fmt ${elapsed}): allowed $(fmt ${LIMIT})${AVERAGE:+ (the recent average, $(fmt ${AVERAGE}), and half again)}, and no database update finished in its last $(fmt ${GRACE})"
    fi
    echo "  ${updates:-an unknown number of} database updates applied; the log's last line: $(tail -1 "${VALIDATION_LOG}" 2>/dev/null | cut -c1-160)"
    echo "  Its log: ${VALIDATION_LOG}"
    return 1
}


NO_PROMOTE=false
THEN_SERVE=false
parse_args "$@"
get_profile_paths

if ! validate_shadow_worldserver; then
    exit 1
fi

if [[ "${NO_PROMOTE}" == "true" ]]; then
    echo "  Gate 2000 passed: every database is at upstream's state (the server's updater ran)"
    exit 0
fi

echo ""
echo "Validation passed, promoting to main installation..."
exec "${DIR}/scripts/promote" --profile "${PROFILE}" $([[ "${THEN_SERVE:-false}" == "true" ]] && echo --then-serve)
