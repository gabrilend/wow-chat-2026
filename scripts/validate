#!/bin/bash

DIR="/mnt/kaun/wow-chat-2026"


if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi
DEFAULT_PROFILE="${PROFILE}"


parse_args() {
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    PROFILE="${2}"
                    shift 2
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                if [[ -z "${PROFILE}" ]]; then
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                shift
                ;;
            --no-promote)
                NO_PROMOTE=true
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                echo "Error: unrecognized argument '${1}'"
                echo "Run with --help to see available options."
                exit 1
                ;;
        esac
    done
}

show_help() {
    echo "Usage: ./scripts/validate [options]"
    echo ""
    echo "Validate shadow worldserver build before promotion."
    echo "Starts worldserver from shadow, waits for initialization, then stops."
    echo ""
    echo "Options:"
    echo "  --profile <name>   Use specific profile (default: ${DEFAULT_PROFILE})"
    echo "  --no-promote       Start and stop only (the build's gate 2000: the"
    echo "                     databases brought to upstream's state); no promotion"
    echo "  --help             Show this help message"
    echo ""
    echo "Workflow:"
    echo "  1. ./scripts/compile     - Build to shadow"
    echo "  2. ./scripts/validate    - Test shadow build"
    echo "  3. ./scripts/promote     - Copy shadow to main"
}


get_profile_paths() {
    INSTALL_DIR_SHADOW="${DIR}/installed-files-shadow"
    MYSQL_DIR="${DIR}/mysql/installed-files"
}

validate_shadow_worldserver() {
    local MAX_TIMEOUT=${VALIDATE_MAX_TIMEOUT:-300}
    local HARD_LIMIT=${VALIDATE_HARD_LIMIT:-3600}   # seconds in all, progress or not
    local PROBE_EVERY=5                             # seconds between counts of applied updates
    local PROGRESS_CMD="${VALIDATE_PROGRESS_CMD:-}"
    if [[ -z "${PROGRESS_CMD}" ]]; then
        local MYSQL_CALL="\"${MYSQL_DIR}/bin/mysql\" -h127.0.0.1 -P3307 -uritz -pmenardi -N -B"
        local SCHEMAS
        SCHEMAS="$(eval "${MYSQL_CALL}" -e "\"SELECT table_schema FROM information_schema.tables WHERE table_name = 'updates' AND table_schema LIKE 'acore%'\"" 2>&1 | grep -v "Using a password")"
        if [[ -n "${SCHEMAS}" && "${SCHEMAS}" != *ERROR* ]]; then
            local SUM="" s
            for s in ${SCHEMAS}; do SUM="${SUM:+${SUM} + }(SELECT COUNT(*) FROM ${s}.updates)"; done
            PROGRESS_CMD="${MYSQL_CALL} -e \"SELECT ${SUM}\" 2>&1 | grep -v 'Using a password'"
        else
            echo "  WARNING (fallback): can't read the databases' update records, so progress is judged by the log alone."
            echo "    The database said: ${SCHEMAS:-nothing}"
            echo "    To debug: is MySQL running (scripts/start-mysql)? does ${MYSQL_DIR}/bin/mysql exist?"
        fi
    fi

    echo ""
    echo "Validating shadow worldserver..."
    echo "  Shadow: ${INSTALL_DIR_SHADOW}/bin/worldserver"

    if [[ ! -f "${INSTALL_DIR_SHADOW}/bin/worldserver" ]]; then
        echo "  ERROR: worldserver not found in shadow"
        return 1
    fi

    if [[ ! -f "${INSTALL_DIR_SHADOW}/etc/worldserver.conf" ]]; then
        echo "  ERROR: worldserver.conf not found in shadow/etc/"
        return 1
    fi

    echo "  Starting worldserver from shadow (validation run)..."
    cd "${INSTALL_DIR_SHADOW}/bin"
    export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"

    local VALIDATION_LOG="${DIR}/tmp/shadow-validation-${PROFILE}.log"
    [[ "${NO_PROMOTE}" == "true" ]] && VALIDATION_LOG="${DIR}/tmp/shadow-gate-2000-${PROFILE}.log"
    mkdir -p "${DIR}/tmp"
    > "${VALIDATION_LOG}"  # Truncate log
    ./worldserver \
        -c "${INSTALL_DIR_SHADOW}/etc/worldserver.conf" \
        -C "${INSTALL_DIR_SHADOW}/etc" \
        < /dev/null > "${VALIDATION_LOG}" 2>&1 &
    local WS_PID=$!

    echo "  Worldserver started (PID ${WS_PID})"
    echo "  Waiting for \"World initialized\" (until ${MAX_TIMEOUT}s pass with no new log line and no update applied, ${HARD_LIMIT}s at most)..."

    local elapsed=0
    local last_line_count=0
    local silence_count=0
    local success=false
    local unique_count=0
    local quiet=0                                   # seconds since the last progress of either kind
    local applied="" applied_now="" applied_first=""

    if [[ -n "${PROGRESS_CMD}" ]]; then
        applied="$(eval "${PROGRESS_CMD}")"
        applied_first="${applied}"
    fi

    while [[ ${quiet} -lt ${MAX_TIMEOUT} && ${elapsed} -lt ${HARD_LIMIT} ]]; do
        if grep -qi "World initialized in" "${VALIDATION_LOG}" 2>/dev/null; then
            sleep 2
            echo "  Stable: World initialized successfully"
            success=true
            break
        fi

        if ! kill -0 ${WS_PID} 2>/dev/null; then
            if grep -qi "World initialized in" "${VALIDATION_LOG}" 2>/dev/null; then
                echo "  Stable: World initialized (server exited cleanly)"
                success=true
                break
            fi
            echo "  ERROR: Worldserver crashed during startup"
            echo "  Check log: ${VALIDATION_LOG}"
            return 1
        fi

        if grep -qE "^(FATAL|.*Failed to initialize World)" "${VALIDATION_LOG}" 2>/dev/null; then
            echo "  ERROR: Worldserver failed to initialize"
            kill ${WS_PID} 2>/dev/null
            wait ${WS_PID} 2>/dev/null
            echo "  Check log: ${VALIDATION_LOG}"
            return 1
        fi

        local current_line_count
        current_line_count=$(wc -l < "${VALIDATION_LOG}" 2>/dev/null || echo 0)

        if [[ ${current_line_count} -eq ${last_line_count} ]]; then
            ((silence_count++))
            ((quiet++))
        else
            silence_count=0
            quiet=0
            unique_count=${current_line_count}
            last_line_count=${current_line_count}
        fi

        if [[ -n "${PROGRESS_CMD}" ]] && (( elapsed % PROBE_EVERY == 0 )); then
            applied_now="$(eval "${PROGRESS_CMD}")"
            if [[ "${applied_now}" =~ ^[0-9]+$ && "${applied}" =~ ^[0-9]+$ && ${applied_now} -gt ${applied} ]]; then
                quiet=0
            fi
            [[ "${applied_now}" =~ ^[0-9]+$ ]] && applied="${applied_now}"
        fi

        sleep 1
        ((elapsed++))
    done

    echo "  Stopping validation worldserver..."
    if kill ${WS_PID} 2>/dev/null; then
        sleep 2
        if kill -0 ${WS_PID} 2>/dev/null; then
            kill -9 ${WS_PID} 2>/dev/null
        fi
    fi
    wait ${WS_PID} 2>/dev/null

    local applied_note=""
    if [[ "${applied}" =~ ^[0-9]+$ && "${applied_first}" =~ ^[0-9]+$ ]]; then
        applied_note=", $(( applied - applied_first )) database updates applied"
    fi

    if [[ "${success}" == "true" ]]; then
        echo "  Validation successful (${elapsed}s, ${unique_count} lines${applied_note})"
        return 0
    else
        if [[ ${elapsed} -ge ${HARD_LIMIT} ]]; then
            echo "  ERROR: Validation timeout (${HARD_LIMIT}s in all, the hard limit, though it was still making progress)"
        else
            echo "  ERROR: Validation timeout (${MAX_TIMEOUT}s with no new log line and no update applied, after ${elapsed}s)"
        fi
        echo "  It never said \"World initialized\"; ${unique_count} lines logged${applied_note}, the log's last ${silence_count}s silent."
        echo "  Last line: $(tail -1 "${VALIDATION_LOG}" 2>/dev/null | cut -c1-120)"
        echo "  Check log: ${VALIDATION_LOG}"
        return 1
    fi
}


NO_PROMOTE=false
parse_args "$@"
get_profile_paths

if ! validate_shadow_worldserver; then
    exit 1
fi

if [[ "${NO_PROMOTE}" == "true" ]]; then
    echo "  Gate 2000 passed: every database is at upstream's state (the server's updater ran)"
    exit 0
fi

echo ""
echo "Validation passed, promoting to main installation..."
exec "${DIR}/scripts/promote" --profile "${PROFILE}"
