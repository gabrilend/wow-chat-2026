#!/bin/bash
# scripts/validate - Validate shadow worldserver build
# Starts worldserver from shadow directory to verify it initializes correctly
# Part of shadow-run-promote workflow: compile -> validate -> promote
#
# With --no-promote it is the build's gate 2000 (issue 189d, patches/gates):
# the compile starts the shadow server once after the install stage, so the
# server's own updater brings every database (the bot module's too) to
# upstream's state, before our SQL is handed to it. The owner, 2026-10-20:
# "let's start the server and let them apply naturally. We already do this
# for the validation step." The start must reach "World initialized", as in
# validation; it then stops, and nothing is promoted.

DIR="/mnt/kaun/wow-chat-2026"

# =============================================================================
# Load Profile
# =============================================================================

if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi
# DEFAULT_PROFILE snapshots the no-argument default so --help reports the
# true default even when a --profile flag precedes --help on the command
# line (that flag mutates PROFILE, not the default a bare run would use).
DEFAULT_PROFILE="${PROFILE}"

# =============================================================================
# Argument Parsing
# =============================================================================

# {{{ parse_args
# Each option supports both --opt value and --opt=value forms. The
# catch-all errors instead of silently dropping unknown args.
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    PROFILE="${2}"
                    shift 2
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                if [[ -z "${PROFILE}" ]]; then
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                shift
                ;;
            --no-promote)
                NO_PROMOTE=true
                shift
                ;;
            --then-serve)
                # passed on to promote: the server starts once promoted
                THEN_SERVE=true
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                echo "Error: unrecognized argument '${1}'"
                echo "Run with --help to see available options."
                exit 1
                ;;
        esac
    done
}
# }}}

# {{{ show_help
show_help() {
    echo "Usage: ./scripts/validate [options]"
    echo ""
    echo "Validate shadow worldserver build before promotion."
    echo "Starts worldserver from shadow, waits for initialization, then stops."
    echo ""
    echo "Options:"
    echo "  --profile <name>   Use specific profile (default: ${DEFAULT_PROFILE})"
    echo "  --no-promote       Start and stop only (the build's gate 2000: the"
    echo "                     databases brought to upstream's state); no promotion"
    echo "  --help             Show this help message"
    echo ""
    echo "Workflow:"
    echo "  1. ./scripts/compile     - Build to shadow"
    echo "  2. ./scripts/validate    - Test shadow build"
    echo "  3. ./scripts/promote     - Copy shadow to main"
}
# }}}

# =============================================================================
# Functions
# =============================================================================

# {{{ get_profile_paths
get_profile_paths() {
    INSTALL_DIR_SHADOW="${DIR}/installed-files-shadow"
    MYSQL_DIR="${DIR}/mysql/installed-files"
}
# }}}

# {{{ validate_shadow_worldserver
# Starts the shadow worldserver and passes only when it says "World
# initialized in" (the core's own last line of a finished startup). Fails
# when it crashes, prints FATAL or "Failed to initialize World", or makes no
# progress for MAX_TIMEOUT seconds; the timeout message says how long it
# had been quiet, which tells a stuck startup from a slow one.
#
# Progress is a new line in its log, or a new database update applied.
# Until 2026-10-22 the limit counted from the start, and a compile whose
# server had a backlog of our own SQL updates to apply (one took 112 s,
# about 30 took 5 minutes together) was stopped part way through them,
# its build fine. The log can't show that work: the server's output
# reaches the file in delayed chunks, and the 2026-10-21 run's log sat on
# a half-written "Applying update" line for 297 s while the updates went
# on. So the rows of every database's `updates` table (one per update the
# server's updater has finished) are counted too. The owner, asked whether
# the start should wait while updates are still being applied and time out
# only once it goes quiet: "yes". A hard limit (HARD_LIMIT) still ends a
# start that keeps making progress and never finishes.
#
# Counted since 2026-10-31 as the updates finished since this start began,
# new or re-applied: a file the updater runs again (its first line changed,
# as when basic's module list gained area looting) rewrites its row instead
# of adding one, so counting rows saw none of that work, and a start
# re-applying forty files was stopped as silent with the work still going.
#
# How long quiet may last is learned (the owner, 2026-10-31: "this five
# minute limit should be set based on the average of how long previous
# starts have taken. It should count the last like, 5 starts, and average
# them. Plus/minus 50%."). What the limit measures is the longest quiet
# stretch inside a start (one slow database file applying, the log still),
# not a whole start's length, so that is what is learned: each successful
# start of this profile is kept in build-shadow/.validate-starts-<profile>,
# one line each (when, its seconds in all, its longest quiet stretch), and
# the limit is the average longest quiet of the last five, plus half. (First
# written from whole starts' lengths and seeded with a 131-second start that
# applied nothing; the owner, 2026-10-31: "if the limit is 3 minutes, and we
# just timed out on a 5 minute timer, then why would you set the limit to 3
# minutes?" A start re-running every file has quiet stretches of two minutes
# and more.) A start quicker than half the usual length is said so (it may
# have skipped work). With no starts recorded yet, 300 seconds, the earlier
# fixed limit.
validate_shadow_worldserver() {
    local STARTS="${DIR}/build-shadow/.validate-starts-${PROFILE}"
    local AVERAGE="" LENGTH=""                      # the average longest quiet, and the average length, of recent starts
    if [[ -f "${STARTS}" ]]; then
        # the last five starts that recorded their longest quiet (3 fields)
        AVERAGE="$(awk 'NF >= 3' "${STARTS}" | tail -n 5 | awk '{ s += $3; n++ } END { if (n > 0) printf "%d", s / n }')"
        LENGTH="$(tail -n 5 "${STARTS}" | awk '{ s += $2; n++ } END { if (n > 0) printf "%d", s / n }')"
    fi
    # seconds without progress: the average plus half (300 with no starts
    # recorded); VALIDATE_MAX_TIMEOUT sets it outright for scripts/test-validate-needs-world-up
    local LEARNED=300
    [[ "${AVERAGE}" =~ ^[0-9]+$ && ${AVERAGE} -gt 0 ]] && LEARNED=$(( AVERAGE + (AVERAGE + 1) / 2 ))
    local MAX_TIMEOUT=${VALIDATE_MAX_TIMEOUT:-${LEARNED}}
    # when this start began: updates finished since then are its progress
    local START_EPOCH
    START_EPOCH="$(date +%s)"
    local HARD_LIMIT=${VALIDATE_HARD_LIMIT:-3600}   # seconds in all, progress or not
    local PROBE_EVERY=5                             # seconds between counts of applied updates
    # How many database updates are applied so far: one number, or nothing
    # when the database can't be read. The test replaces it
    # (VALIDATE_PROGRESS_CMD) with a file its pretend servers write.
    local PROGRESS_CMD="${VALIDATE_PROGRESS_CMD:-}"
    if [[ -z "${PROGRESS_CMD}" ]]; then
        local MYSQL_CALL="\"${MYSQL_DIR}/bin/mysql\" --defaults-file=${DIR}/mysql/conf/client.cnf -h127.0.0.1 -P3307 -N -B"
        # every database with an updates table (each profile's, and acore_auth)
        local SCHEMAS
        SCHEMAS="$(eval "${MYSQL_CALL}" -e "\"SELECT table_schema FROM information_schema.tables WHERE table_name = 'updates' AND table_schema LIKE 'acore%'\"" 2>&1 | grep -v "Using a password")"
        if [[ -n "${SCHEMAS}" && "${SCHEMAS}" != *ERROR* ]]; then
            local SUM="" s
            # no backquotes around the names: the command is run through eval,
            # inside double quotes, where a backquote would run a command
            # (the names are plain: letters, digits, underscores)
            # the updates finished since this start began, new or re-applied
            # (\${START_EPOCH} is filled in each time the count is taken)
            for s in ${SCHEMAS}; do SUM="${SUM:+${SUM} + }(SELECT COUNT(*) FROM ${s}.updates WHERE UNIX_TIMESTAMP(timestamp) >= \${START_EPOCH})"; done
            PROGRESS_CMD="${MYSQL_CALL} -e \"SELECT ${SUM}\" 2>&1 | grep -v 'Using a password'"
        else
            # a fallback: the start is then timed by its log alone, which can
            # stop it while it is still applying updates (as on 2026-10-21)
            echo "  WARNING (fallback): can't read the databases' update records, so progress is judged by the log alone."
            echo "    The database said: ${SCHEMAS:-nothing}"
            echo "    To debug: is MySQL running (scripts/start-mysql)? does ${MYSQL_DIR}/bin/mysql exist?"
        fi
    fi

    echo ""
    echo "Validating shadow worldserver..."
    echo "  Shadow: ${INSTALL_DIR_SHADOW}/bin/worldserver"

    # Check if binary exists
    if [[ ! -f "${INSTALL_DIR_SHADOW}/bin/worldserver" ]]; then
        echo "  ERROR: worldserver not found in shadow"
        return 1
    fi

    # Check if config exists
    if [[ ! -f "${INSTALL_DIR_SHADOW}/etc/worldserver.conf" ]]; then
        echo "  ERROR: worldserver.conf not found in shadow/etc/"
        return 1
    fi

    # Start worldserver in background
    echo "  Starting worldserver from shadow (validation run)..."
    cd "${INSTALL_DIR_SHADOW}/bin"
    export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"

    # Start in background, redirect output to validation log
    # Use /dev/null for stdin to prevent blocking on input
    local VALIDATION_LOG="${DIR}/tmp/shadow-validation-${PROFILE}.log"
    [[ "${NO_PROMOTE}" == "true" ]] && VALIDATION_LOG="${DIR}/tmp/shadow-gate-2000-${PROFILE}.log"
    mkdir -p "${DIR}/tmp"
    > "${VALIDATION_LOG}"  # Truncate log
    # Explicit -c and -C flags: with CONF_DIR baked into the binary
    # pointing at the profile etc dir (see issue 137), the shadow
    # validation run must override BOTH the main config file (-c) AND
    # the module config directory (-C, from B022). Without -C, module
    # configs would still be loaded from the baked _CONF_DIR — i.e.
    # the promoted profile's etc/modules — which silently invalidates
    # the validation. The flags are the exception, used precisely here.
    ./worldserver \
        -c "${INSTALL_DIR_SHADOW}/etc/worldserver.conf" \
        -C "${INSTALL_DIR_SHADOW}/etc" \
        < /dev/null > "${VALIDATION_LOG}" 2>&1 &
    local WS_PID=$!

    echo "  Worldserver started (PID ${WS_PID})"
    if [[ -n "${VALIDATE_MAX_TIMEOUT:-}" ]]; then
        echo "  (the quiet limit set outright: ${MAX_TIMEOUT}s)"
    elif [[ -n "${AVERAGE}" ]]; then
        echo "  (the last starts' longest quiet stretches averaged ${AVERAGE}s; quiet allowed: that plus half, ${MAX_TIMEOUT}s)"
    else
        echo "  (no starts recorded yet for ${PROFILE}: quiet allowed ${MAX_TIMEOUT}s)"
    fi
    echo "  Waiting for \"World initialized\" (until ${MAX_TIMEOUT}s pass with no new log line and no update applied, ${HARD_LIMIT}s at most)..."

    # Smart detection variables
    local elapsed=0
    local last_line_count=0
    local silence_count=0
    local success=false
    local unique_count=0
    local quiet=0                                   # seconds since the last progress of either kind
    local longest_quiet=0                           # the longest such stretch in this start, kept for the next limit
    local applied="" applied_now="" applied_first=""

    if [[ -n "${PROGRESS_CMD}" ]]; then
        applied="$(eval "${PROGRESS_CMD}")"
        applied_first="${applied}"
    fi

    while [[ ${quiet} -lt ${MAX_TIMEOUT} && ${elapsed} -lt ${HARD_LIMIT} ]]; do
        # Check for success FIRST (before checking if process died)
        # This handles the case where server initializes and exits cleanly
        if grep -qi "World initialized in" "${VALIDATION_LOG}" 2>/dev/null; then
            sleep 2
            echo "  Stable: World initialized successfully"
            success=true
            break
        fi

        # Check if process is still running
        if ! kill -0 ${WS_PID} 2>/dev/null; then
            # Process died - but check if it succeeded before dying
            if grep -qi "World initialized in" "${VALIDATION_LOG}" 2>/dev/null; then
                echo "  Stable: World initialized (server exited cleanly)"
                success=true
                break
            fi
            echo "  ERROR: Worldserver crashed during startup"
            echo "  Check log: ${VALIDATION_LOG}"
            return 1
        fi

        # Check for critical errors (but not warnings about missing optional things)
        if grep -qE "^(FATAL|.*Failed to initialize World)" "${VALIDATION_LOG}" 2>/dev/null; then
            echo "  ERROR: Worldserver failed to initialize"
            kill ${WS_PID} 2>/dev/null
            wait ${WS_PID} 2>/dev/null
            echo "  Check log: ${VALIDATION_LOG}"
            return 1
        fi

        # Count current lines
        local current_line_count
        current_line_count=$(wc -l < "${VALIDATION_LOG}" 2>/dev/null || echo 0)

        # Silence and repeated lines are NOT success: only "World initialized
        # in" above is. Until 2026-10-18 five quiet seconds counted as stable,
        # and the worldserver is quiet for longer than that while it updates
        # its databases, so a build was promoted after 6 s and 55 lines, the
        # world never loaded (owner: "you should have caught this"). They are
        # still counted, to say in the timeout message where it went quiet.
        if [[ ${current_line_count} -eq ${last_line_count} ]]; then
            ((silence_count++))
            ((quiet++))
        else
            silence_count=0
            quiet=0
            unique_count=${current_line_count}
            last_line_count=${current_line_count}
        fi

        # an update finished since the last count: progress, even with the log quiet
        if [[ -n "${PROGRESS_CMD}" ]] && (( elapsed % PROBE_EVERY == 0 )); then
            applied_now="$(eval "${PROGRESS_CMD}")"
            if [[ "${applied_now}" =~ ^[0-9]+$ && "${applied}" =~ ^[0-9]+$ && ${applied_now} -gt ${applied} ]]; then
                quiet=0
            fi
            [[ "${applied_now}" =~ ^[0-9]+$ ]] && applied="${applied_now}"
        fi

        (( quiet > longest_quiet )) && longest_quiet=${quiet}
        sleep 1
        ((elapsed++))
    done

    # Kill the validation worldserver gracefully, then forcefully
    echo "  Stopping validation worldserver..."
    if kill ${WS_PID} 2>/dev/null; then
        sleep 2
        if kill -0 ${WS_PID} 2>/dev/null; then
            kill -9 ${WS_PID} 2>/dev/null
        fi
    fi
    wait ${WS_PID} 2>/dev/null

    # how many database updates the start applied, when they could be counted
    local applied_note=""
    if [[ "${applied}" =~ ^[0-9]+$ && "${applied_first}" =~ ^[0-9]+$ ]]; then
        applied_note=", $(( applied - applied_first )) database updates applied"
    fi

    if [[ "${success}" == "true" ]]; then
        echo "  Validation successful (${elapsed}s, ${unique_count} lines${applied_note})"
        # this start, for the next one's limit; and a word when it was
        # quicker than half the usual (the owner's "minus 50%")
        if [[ -z "${VALIDATE_MAX_TIMEOUT:-}" ]]; then
            mkdir -p "$(dirname "${STARTS}")"
            echo "$(date +%Y-%m-%dT%H:%M:%S) ${elapsed} ${longest_quiet}" >> "${STARTS}"
            echo "  (its longest quiet stretch: ${longest_quiet}s, recorded for the next limit)"
            if [[ "${LENGTH}" =~ ^[0-9]+$ && ${LENGTH} -gt 0 && ${elapsed} -lt $(( LENGTH / 2 )) ]]; then
                echo "  NOTE: this start took ${elapsed}s, under half the usual ${LENGTH}s: it may have skipped work it should have done (its log: ${VALIDATION_LOG})"
            fi
        fi
        return 0
    else
        if [[ ${elapsed} -ge ${HARD_LIMIT} ]]; then
            echo "  ERROR: Validation timeout (${HARD_LIMIT}s in all, the hard limit, though it was still making progress)"
        else
            echo "  ERROR: Validation timeout (${MAX_TIMEOUT}s with no new log line and no update applied, after ${elapsed}s)"
        fi
        echo "  It never said \"World initialized\"; ${unique_count} lines logged${applied_note}, the log's last ${silence_count}s silent."
        echo "  Last line: $(tail -1 "${VALIDATION_LOG}" 2>/dev/null | cut -c1-120)"
        echo "  Check log: ${VALIDATION_LOG}"
        return 1
    fi
}
# }}}

# =============================================================================
# Main
# =============================================================================

NO_PROMOTE=false
THEN_SERVE=false
parse_args "$@"
get_profile_paths

if ! validate_shadow_worldserver; then
    exit 1
fi

# The gate's start: the databases are at upstream's state; the compile goes
# on with the SQL stage, then validates again (which does promote).
if [[ "${NO_PROMOTE}" == "true" ]]; then
    echo "  Gate 2000 passed: every database is at upstream's state (the server's updater ran)"
    exit 0
fi

# Auto-promote on successful validation
echo ""
echo "Validation passed, promoting to main installation..."
exec "${DIR}/scripts/promote" --profile "${PROFILE}" $([[ "${THEN_SERVE:-false}" == "true" ]] && echo --then-serve)
