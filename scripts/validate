#!/bin/bash
# scripts/validate - Validate shadow worldserver build
# Starts worldserver from shadow directory to verify it initializes correctly
# Part of shadow-run-promote workflow: compile -> validate -> promote
#
# With --no-promote it is the build's gate 2000 (issue 189d, patches/gates):
# the compile starts the shadow server once after the install stage, so the
# server's own updater brings every database (the bot module's too) to
# upstream's state, before our SQL is handed to it. The owner, 2026-10-20:
# "let's start the server and let them apply naturally. We already do this
# for the validation step." The start must reach "World initialized", as in
# validation; it then stops, and nothing is promoted.

DIR="/mnt/kaun/wow-chat-2026"

# =============================================================================
# Load Profile
# =============================================================================

if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi
# DEFAULT_PROFILE snapshots the no-argument default so --help reports the
# true default even when a --profile flag precedes --help on the command
# line (that flag mutates PROFILE, not the default a bare run would use).
DEFAULT_PROFILE="${PROFILE}"

# =============================================================================
# Argument Parsing
# =============================================================================

# {{{ parse_args
# Each option supports both --opt value and --opt=value forms. The
# catch-all errors instead of silently dropping unknown args.
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    PROFILE="${2}"
                    shift 2
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                if [[ -z "${PROFILE}" ]]; then
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                shift
                ;;
            --no-promote)
                NO_PROMOTE=true
                shift
                ;;
            --then-serve)
                # passed on to promote: the server starts once promoted
                THEN_SERVE=true
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                echo "Error: unrecognized argument '${1}'"
                echo "Run with --help to see available options."
                exit 1
                ;;
        esac
    done
}
# }}}

# {{{ show_help
show_help() {
    echo "Usage: ./scripts/validate [options]"
    echo ""
    echo "Validate shadow worldserver build before promotion."
    echo "Starts worldserver from shadow, waits for initialization, then stops."
    echo ""
    echo "Options:"
    echo "  --profile <name>   Use specific profile (default: ${DEFAULT_PROFILE})"
    echo "  --no-promote       Start and stop only (the build's gate 2000: the"
    echo "                     databases brought to upstream's state); no promotion"
    echo "  --help             Show this help message"
    echo ""
    echo "Workflow:"
    echo "  1. ./scripts/compile     - Build to shadow"
    echo "  2. ./scripts/validate    - Test shadow build"
    echo "  3. ./scripts/promote     - Copy shadow to main"
}
# }}}

# =============================================================================
# Functions
# =============================================================================

# {{{ get_profile_paths
get_profile_paths() {
    INSTALL_DIR_SHADOW="${DIR}/installed-files-shadow"
    MYSQL_DIR="${DIR}/mysql/installed-files"
}
# }}}

# {{{ validate_shadow_worldserver
# Starts the shadow worldserver and passes only when it says "World
# initialized in" (the core's own last line of a finished startup). Fails
# when it crashes, prints FATAL or "Failed to initialize World", or makes no
# progress for MAX_TIMEOUT seconds; the timeout message says how long it
# had been quiet, which tells a stuck startup from a slow one.
#
# Progress is a new line in its log, or a new database update applied.
# Until 2026-10-22 the limit counted from the start, and a compile whose
# server had a backlog of our own SQL updates to apply (one took 112 s,
# about 30 took 5 minutes together) was stopped part way through them,
# its build fine. The log can't show that work: the server's output
# reaches the file in delayed chunks, and the 2026-10-21 run's log sat on
# a half-written "Applying update" line for 297 s while the updates went
# on. So the rows of every database's `updates` table (one per update the
# server's updater has finished) are counted too. The owner, asked whether
# the start should wait while updates are still being applied and time out
# only once it goes quiet: "yes". A hard limit (HARD_LIMIT) still ends a
# start that keeps making progress and never finishes.
#
# Counted since 2026-10-31 as the updates finished since this start began,
# new or re-applied: a file the updater runs again (its first line changed,
# as when basic's module list gained area looting) rewrites its row instead
# of adding one, so counting rows saw none of that work, and a start
# re-applying forty files was stopped as silent with the work still going.
#
# How long a start may take is learned (the owner, 2026-10-31: "this five
# minute limit should be set based on the average of how long previous
# starts have taken. It should count the last like, 5 starts, and average
# them. Plus/minus 50%."): each successful start of this profile is kept in
# build-shadow/.validate-starts-<profile> (one line each: when, its seconds),
# and a start may take the average of the last five plus half. While the
# databases' updates are still finishing (the owner, 2026-10-22, asked
# whether a start should wait while updates go on: "yes"), each update that
# finishes moves the deadline to half an average past it, so a start doing
# real work past its usual length isn't cut off; one that stops making any
# is. A start quicker than half the average is said so: it may have skipped
# work. With no starts recorded, 300 seconds (the old five minutes).
# (A first version timed quiet stretches instead and was seeded by hand with
# one start that applied nothing; the owner: "if the limit is 3 minutes, and
# we just timed out on a 5 minute timer, then why would you set the limit to
# 3 minutes?")
#
# What it prints (the owner, 2026-10-31, of the old lines: "this is way too
# busy. We could make this like, 1/10th of the text. Can we also add an
# updating timer that says how long we've waited so far?"): one line saying
# what is checked and how long it may take, a timer counting on the
# terminal (not in the build log), and one line with the result. A failure
# says everything it knows.
validate_shadow_worldserver() {
    local STARTS="${DIR}/build-shadow/.validate-starts-${PROFILE}"
    local AVERAGE=""                                # the average length of the last five starts
    [[ -f "${STARTS}" ]] && AVERAGE="$(tail -n 5 "${STARTS}" | awk '{ s += $2; n++ } END { if (n > 0) printf "%d", s / n }')"
    local LIMIT=300                                 # seconds a start may take: the average plus half
    [[ "${AVERAGE}" =~ ^[0-9]+$ && ${AVERAGE} -gt 0 ]] && LIMIT=$(( AVERAGE + (AVERAGE + 1) / 2 ))
    LIMIT=${VALIDATE_MAX_TIMEOUT:-${LIMIT}}         # set outright by scripts/test-validate-needs-world-up
    local HARD_LIMIT=${VALIDATE_HARD_LIMIT:-3600}   # seconds in all, whatever happens
    local PROBE_EVERY=5                             # seconds between counts of finished updates
    # half an average: how far a finished update moves the deadline; at least
    # two counts' worth, since an update is only seen when the count is taken
    local GRACE=$(( (LIMIT + 2) / 3 ))
    (( GRACE < 2 * PROBE_EVERY )) && GRACE=$(( 2 * PROBE_EVERY ))
    local START_EPOCH
    START_EPOCH="$(date +%s)"                       # updates finished since then are this start's
    # how many database updates have finished since this start began, new or
    # re-applied (a re-applied file rewrites its row, so rows aren't counted);
    # the test replaces it (VALIDATE_PROGRESS_CMD) with its pretend servers' file
    local PROGRESS_CMD="${VALIDATE_PROGRESS_CMD:-}"
    if [[ -z "${PROGRESS_CMD}" ]]; then
        local MYSQL_CALL="\"${MYSQL_DIR}/bin/mysql\" --defaults-file=${DIR}/mysql/conf/client.cnf -h127.0.0.1 -P3307 -N -B"
        local SCHEMAS
        SCHEMAS="$(eval "${MYSQL_CALL}" -e "\"SELECT table_schema FROM information_schema.tables WHERE table_name = 'updates' AND table_schema LIKE 'acore%'\"" 2>&1 | grep -v "Using a password")"
        if [[ -n "${SCHEMAS}" && "${SCHEMAS}" != *ERROR* ]]; then
            local SUM="" s
            # no backquotes round the names: the command runs through eval;
            # \${START_EPOCH} is filled in each time the count is taken
            for s in ${SCHEMAS}; do SUM="${SUM:+${SUM} + }(SELECT COUNT(*) FROM ${s}.updates WHERE UNIX_TIMESTAMP(timestamp) >= \${START_EPOCH})"; done
            PROGRESS_CMD="${MYSQL_CALL} -e \"SELECT ${SUM}\" 2>&1 | grep -v 'Using a password'"
        else
            # a fallback, said: without the update records, no update can move
            # the deadline, so a long backlog of updates may be cut off
            echo "  WARNING (fallback): can't read the databases' update records, so a long run of updates can't extend the time allowed."
            echo "    The database said: ${SCHEMAS:-nothing}"
            echo "    To debug: is MySQL running (scripts/start-mysql)? does ${MYSQL_DIR}/bin/mysql exist?"
        fi
    fi
    # minutes and seconds, for people
    local fmt
    fmt() { if (( $1 >= 60 )); then printf '%dm %02ds' $(( $1 / 60 )) $(( $1 % 60 )); else printf '%ds' "$1"; fi; }

    [[ -f "${INSTALL_DIR_SHADOW}/bin/worldserver" ]] || { echo "  ERROR: no worldserver in ${INSTALL_DIR_SHADOW}/bin (did the build install?)"; return 1; }
    [[ -f "${INSTALL_DIR_SHADOW}/etc/worldserver.conf" ]] || { echo "  ERROR: no worldserver.conf in ${INSTALL_DIR_SHADOW}/etc"; return 1; }

    local VALIDATION_LOG="${DIR}/tmp/shadow-validation-${PROFILE}.log"
    local WHAT="the new server starts with our database changes"
    if [[ "${NO_PROMOTE}" == "true" ]]; then
        VALIDATION_LOG="${DIR}/tmp/shadow-gate-2000-${PROFILE}.log"
        WHAT="the new server starts on upstream's databases"
    fi
    echo ""
    echo "Checking ${WHAT} (allowed $(fmt ${LIMIT}))..."
    cd "${INSTALL_DIR_SHADOW}/bin"
    export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"
    mkdir -p "${DIR}/tmp"
    > "${VALIDATION_LOG}"
    # Explicit -c and -C flags: with CONF_DIR baked into the binary pointing
    # at the profile's etc (issue 137), the check must override both the main
    # config (-c) and the module config folder (-C, from B022), or modules'
    # settings come from the promoted profile and the check means nothing.
    ./worldserver \
        -c "${INSTALL_DIR_SHADOW}/etc/worldserver.conf" \
        -C "${INSTALL_DIR_SHADOW}/etc" \
        < /dev/null > "${VALIDATION_LOG}" 2>&1 &
    local WS_PID=$!

    # the timer goes to the terminal only, when there is one (the build log
    # gets the result line, not a line a second)
    local TTY=""
    { : > /dev/tty; } 2>/dev/null && TTY=/dev/tty

    local elapsed=0 deadline=${LIMIT} success=false
    local applied="" applied_now="" applied_first=""
    if [[ -n "${PROGRESS_CMD}" ]]; then
        applied="$(eval "${PROGRESS_CMD}")"
        applied_first="${applied}"
    fi

    # Only "World initialized in" is success (until 2026-10-18 five quiet
    # seconds counted as up, and a build was promoted whose world never
    # loaded; the owner: "you should have caught this").
    while (( elapsed < deadline && elapsed < HARD_LIMIT )); do
        if grep -qi "World initialized in" "${VALIDATION_LOG}" 2>/dev/null; then
            success=true
            break
        fi
        if ! kill -0 ${WS_PID} 2>/dev/null; then
            [[ -n "${TTY}" ]] && printf '\r\033[K' > "${TTY}"
            echo "  ERROR: the server stopped before it finished starting (after $(fmt ${elapsed}))"
            echo "  Its last line: $(tail -1 "${VALIDATION_LOG}" 2>/dev/null | cut -c1-160)"
            echo "  Its log: ${VALIDATION_LOG}"
            return 1
        fi
        if grep -qE "^(FATAL|.*Failed to initialize World)" "${VALIDATION_LOG}" 2>/dev/null; then
            [[ -n "${TTY}" ]] && printf '\r\033[K' > "${TTY}"
            kill ${WS_PID} 2>/dev/null; wait ${WS_PID} 2>/dev/null
            echo "  ERROR: the server failed to initialize (after $(fmt ${elapsed}))"
            echo "  The error: $(grep -m1 -E "^(FATAL|.*Failed to initialize World)" "${VALIDATION_LOG}" | cut -c1-160)"
            echo "  Its log: ${VALIDATION_LOG}"
            return 1
        fi
        # an update finished: the start is still at work, so the deadline is
        # at least half an average past now
        if [[ -n "${PROGRESS_CMD}" ]] && (( elapsed % PROBE_EVERY == 0 )); then
            applied_now="$(eval "${PROGRESS_CMD}")"
            if [[ "${applied_now}" =~ ^[0-9]+$ && "${applied}" =~ ^[0-9]+$ && ${applied_now} -gt ${applied} ]]; then
                (( elapsed + GRACE > deadline )) && deadline=$(( elapsed + GRACE ))
            fi
            [[ "${applied_now}" =~ ^[0-9]+$ ]] && applied="${applied_now}"
        fi
        [[ -n "${TTY}" ]] && printf '\r  %s' "$(fmt ${elapsed})" > "${TTY}"
        sleep 1
        ((elapsed++))
    done
    [[ -n "${TTY}" ]] && printf '\r\033[K' > "${TTY}"

    # stop the check's server: gently, then not
    if kill ${WS_PID} 2>/dev/null; then
        sleep 2
        kill -0 ${WS_PID} 2>/dev/null && kill -9 ${WS_PID} 2>/dev/null
    fi
    wait ${WS_PID} 2>/dev/null

    local updates=""
    [[ "${applied}" =~ ^[0-9]+$ && "${applied_first}" =~ ^[0-9]+$ ]] && updates="$(( applied - applied_first ))"

    if [[ "${success}" == "true" ]]; then
        echo "  Up in $(fmt ${elapsed})${updates:+, ${updates} database updates applied}."
        if [[ -z "${VALIDATE_MAX_TIMEOUT:-}" ]]; then
            mkdir -p "$(dirname "${STARTS}")"
            echo "$(date +%Y-%m-%dT%H:%M:%S) ${elapsed}" >> "${STARTS}"
            if [[ "${AVERAGE}" =~ ^[0-9]+$ && ${AVERAGE} -gt 0 && ${elapsed} -lt $(( AVERAGE / 2 )) ]]; then
                echo "  NOTE: under half the usual $(fmt ${AVERAGE}): it may have skipped work (its log: ${VALIDATION_LOG})"
            fi
        fi
        return 0
    fi
    if (( elapsed >= HARD_LIMIT )); then
        echo "  ERROR: not up after $(fmt ${HARD_LIMIT}), the most any start may take, though updates were still finishing"
    else
        echo "  ERROR: not up after $(fmt ${elapsed}): allowed $(fmt ${LIMIT})${AVERAGE:+ (the recent average, $(fmt ${AVERAGE}), and half again)}, and no database update finished in its last $(fmt ${GRACE})"
    fi
    echo "  ${updates:-an unknown number of} database updates applied; the log's last line: $(tail -1 "${VALIDATION_LOG}" 2>/dev/null | cut -c1-160)"
    echo "  Its log: ${VALIDATION_LOG}"
    return 1
}
# }}}

# =============================================================================
# Main
# =============================================================================

NO_PROMOTE=false
THEN_SERVE=false
parse_args "$@"
get_profile_paths

if ! validate_shadow_worldserver; then
    exit 1
fi

# The gate's start: the databases are at upstream's state; the compile goes
# on with the SQL stage, then validates again (which does promote).
if [[ "${NO_PROMOTE}" == "true" ]]; then
    echo "  Gate 2000 passed: every database is at upstream's state (the server's updater ran)"
    exit 0
fi

# Auto-promote on successful validation
echo ""
echo "Validation passed, promoting to main installation..."
exec "${DIR}/scripts/promote" --profile "${PROFILE}" $([[ "${THEN_SERVE:-false}" == "true" ]] && echo --then-serve)
