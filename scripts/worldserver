#!/bin/bash

DIR="/mnt/kaun/wow-chat-2026"


if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi
DEFAULT_PROFILE="${PROFILE}"

DEBUG_MODE=0
AFTER_COMPILE=0


parse_args() {
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    PROFILE="${2}"
                    shift 2
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                if [[ -z "${PROFILE}" ]]; then
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                shift
                ;;
            --debug)
                DEBUG_MODE=1
                shift
                ;;
            --after-compile)
                AFTER_COMPILE=1
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                echo "Error: unrecognized argument '${1}'"
                echo "Run with --help to see available options."
                exit 1
                ;;
        esac
    done
}

show_help() {
    echo "Usage: ./scripts/worldserver [options]"
    echo ""
    echo "Start the world server for the current profile."
    echo ""
    echo "Options:"
    echo "  --profile <name>   Use specific profile (default: ${DEFAULT_PROFILE})"
    echo "  --debug            Run under a crash-backtrace catcher; on a"
    echo "                     segfault a symbolized stack trace is written to"
    echo "                     tmp/debug-${PROFILE}/ (uses gdb if installed,"
    echo "                     otherwise an LD_PRELOAD shim + addr2line)"
    echo "  --help             Show this help message"
    echo ""
    echo "Current profile: ${PROFILE}"
}


get_profile_paths() {
    SERVER_PROFILE="${PROFILE}"; BRANCH_REALM=""
    local line
    for _ in 1 2 3 4 5 6 7 8; do
        line="$(grep "^${SERVER_PROFILE} " "${DIR}/config/branches" 2>/dev/null)"
        [[ -n "${line}" ]] || break
        [[ -n "${BRANCH_REALM}" ]] || BRANCH_REALM="$(echo "${line}" | awk '{print $3}')"
        SERVER_PROFILE="$(echo "${line}" | awk '{print $2}')"
    done
    case "${SERVER_PROFILE}" in
        release) AC_CODE_DIR="${DIR}/source-beta"  ;;
        beta)    AC_CODE_DIR="${DIR}/source-beta"  ;;
        vanilla) AC_CODE_DIR="${DIR}/source-beta"  ;;
        basic)   AC_CODE_DIR="${DIR}/source-beta"  ;;
        cc-test) AC_CODE_DIR="${DIR}/source-beta"  ;;
        alpha)   AC_CODE_DIR="${DIR}/source-alpha" ;;
        *)       echo "ERROR: Unknown profile '${PROFILE}' (not a profile, and not a branch in config/branches)"; exit 1 ;;
    esac
    INSTALL_DIR="${DIR}/installed-files-${SERVER_PROFILE}"
    MYSQL_DIR="${DIR}/mysql/installed-files"
}

setup_log_symlinks() {
    local TMP_BASE="/tmp/wow-chat-2"
    local TMP_LOGS="${TMP_BASE}/logs-${PROFILE}"
    mkdir -p "${TMP_BASE}"
    mkdir -p "${TMP_LOGS}"
    [[ -L "${DIR}/tmp" ]] || ln -s "${TMP_BASE}" "${DIR}/tmp"
    [[ -L "${DIR}/logs-${PROFILE}" ]] || ln -s "${TMP_LOGS}" "${DIR}/logs-${PROFILE}"
    local SHM="/dev/shm/wow-chat-2026"
    mkdir -p "${SHM}"
    [[ -L "${TMP_BASE}/shared-memory" ]] || ln -s "${SHM}" "${TMP_BASE}/shared-memory"
}

check_mysql() {
    if ! "${DIR}/scripts/start-mysql" "${DIR}"; then
        echo "ERROR: MySQL is not available; not starting the server"
        exit 1
    fi
    echo ""
}


parse_args "$@"

quiet_until_ready() {
    local line last=()
    while IFS= read -r line; do
        last+=("${line}")
        (( ${#last[@]} > 25 )) && last=("${last[@]:1}")
        if [[ "${line}" == *"ready..."* ]]; then
            echo "Compilation and promotion successful, server is now online."
            exec cat
        fi
    done
    echo "ERROR: the new server stopped before it was ready; its last lines (all of them: logs-${PROFILE}/Server.log):"
    printf '  %s\n' "${last[@]}"
    return 1
}

if [[ "${AFTER_COMPILE}" -eq 1 ]]; then
    echo "Starting the new server (its start-up lines: logs-${PROFILE}/Server.log)..."
    script -qfec "$(printf '%q ' "${DIR}/scripts/worldserver" --profile "${PROFILE}")" /dev/null | quiet_until_ready
    exit "${PIPESTATUS[0]}"
fi

get_profile_paths
setup_log_symlinks
check_mysql

if [[ ! -f "${INSTALL_DIR}/bin/worldserver" ]]; then
    echo "Error: worldserver not found for profile '${PROFILE}'"
    echo "Expected: ${INSTALL_DIR}/bin/worldserver"
    echo "Run './scripts/install --profile ${PROFILE}' first."
    exit 1
fi

SQUAT_BASE="$(readlink -f "${DIR}")/installed-files-"
for SQUAT_PID in $(pgrep -x worldserver); do
    SQUAT_EXE="$(readlink "/proc/${SQUAT_PID}/exe")"
    SQUAT_EXE="${SQUAT_EXE% (deleted)}"       # a server started before the last reinstall runs a replaced binary
    case "${SQUAT_EXE}" in
        "${SQUAT_BASE}"*/bin/worldserver)
            echo "Stopping the running worldserver (pid ${SQUAT_PID}, ${SQUAT_EXE#${SQUAT_BASE%installed-files-}})..."
            kill "${SQUAT_PID}"
            for SQUAT_WAIT in $(seq 1 60); do
                kill -0 "${SQUAT_PID}" 2>/dev/null || break
                sleep 1
            done
            if kill -0 "${SQUAT_PID}" 2>/dev/null; then
                echo "ERROR: worldserver ${SQUAT_PID} is still running after 60 s; not starting a second one"
                exit 1
            fi
            ;;
        *)
            ;;
    esac
done
"${DIR}/scripts/set-active-realm" "${PROFILE}"

if [[ -f "${INSTALL_DIR}/bin/.build-type" ]] && [[ "$(cat "${INSTALL_DIR}/bin/.build-type")" == "Debug" ]]; then
    [[ "${DEBUG_MODE}" -ne 1 ]] && echo "Debug build detected — enabling crash catcher automatically."
    DEBUG_MODE=1
fi

echo "Starting worldserver (profile: ${PROFILE}$([[ -n "${BRANCH_REALM}" ]] && echo ", a branch of ${SERVER_PROFILE}"))"
export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"

if [[ -n "${BRANCH_REALM}" ]]; then
    B_SUFFIX="${PROFILE//-/_}"
    B_CONF="${INSTALL_DIR}/etc"
    b_info() { grep -m1 "^$1" "$2" | sed 's/^[^"]*"\(.*\)"$/\1/' | sed "s/;[^;]*\$/;$3/"; }
    export AC_WORLD_DATABASE_INFO="$(b_info WorldDatabaseInfo "${B_CONF}/worldserver.conf" "acore_world_${B_SUFFIX}")"
    export AC_CHARACTER_DATABASE_INFO="$(b_info CharacterDatabaseInfo "${B_CONF}/worldserver.conf" "acore_characters_${B_SUFFIX}")"
    export AC_PLAYERBOTS_DATABASE_INFO="$(b_info PlayerbotsDatabaseInfo "${B_CONF}/modules/playerbots.conf" "acore_playerbots_${B_SUFFIX}")"
    export AC_REALM_ID="${BRANCH_REALM}"
    export AC_LOGS_DIR="${DIR}/logs-${PROFILE}"
    mkdir -p "${AC_LOGS_DIR}"                       # the server writes there, but doesn't make it
    export AC_BUDDIES_TEST_REALM=1
    for v in AC_WORLD_DATABASE_INFO AC_CHARACTER_DATABASE_INFO AC_PLAYERBOTS_DATABASE_INFO; do
        [[ "${!v}" == *";acore_"* ]] || { echo "ERROR: branch ${PROFILE}: could not form ${v} from ${SERVER_PROFILE}'s settings"; exit 1; }
    done
    echo "  branch ${PROFILE}: realm ${BRANCH_REALM}, databases acore_*_${B_SUFFIX}, logs logs-${PROFILE}"
fi
cd "${INSTALL_DIR}/bin"

if [[ "${DEBUG_MODE}" -eq 1 ]]; then
    source "${DIR}/scripts/debug-run.sh"
    debug_run_binary "./worldserver" "worldserver"
else
    ./worldserver
fi
