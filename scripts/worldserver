#!/bin/bash
# scripts/worldserver - Start the world server
# Runs the worldserver binary for the current profile

DIR="/home/ritz/games/azeroth-core/wow-chat-2026"

# =============================================================================
# Load Profile
# =============================================================================

if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi
# DEFAULT_PROFILE snapshots the no-argument default so --help reports the
# true default even when a --profile flag precedes --help on the command
# line (that flag mutates PROFILE, not the default a bare run would use).
DEFAULT_PROFILE="${PROFILE}"

# --debug launches the server under a crash-backtrace catcher (see
# scripts/debug-run.sh). Off by default so normal runs are untouched.
DEBUG_MODE=0

# =============================================================================
# Argument Parsing
# =============================================================================

# {{{ parse_args
# Each option supports both --opt value and --opt=value forms. The
# catch-all errors instead of silently dropping unknown args.
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    PROFILE="${2}"
                    shift 2
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                if [[ -z "${PROFILE}" ]]; then
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                shift
                ;;
            --debug)
                DEBUG_MODE=1
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                echo "Error: unrecognized argument '${1}'"
                echo "Run with --help to see available options."
                exit 1
                ;;
        esac
    done
}
# }}}

# {{{ show_help
show_help() {
    echo "Usage: ./scripts/worldserver [options]"
    echo ""
    echo "Start the world server for the current profile."
    echo ""
    echo "Options:"
    echo "  --profile <name>   Use specific profile (default: ${DEFAULT_PROFILE})"
    echo "  --debug            Run under a crash-backtrace catcher; on a"
    echo "                     segfault a symbolized stack trace is written to"
    echo "                     tmp/debug-${PROFILE}/ (uses gdb if installed,"
    echo "                     otherwise an LD_PRELOAD shim + addr2line)"
    echo "  --help             Show this help message"
    echo ""
    echo "Current profile: ${PROFILE}"
}
# }}}

# =============================================================================
# Functions
# =============================================================================

# {{{ get_profile_paths
get_profile_paths() {
    # vanilla shares source-beta with release/beta — see issue 148.
    case "${PROFILE}" in
        release) AC_CODE_DIR="${DIR}/source-beta"  ;;
        beta)    AC_CODE_DIR="${DIR}/source-beta"  ;;
        vanilla) AC_CODE_DIR="${DIR}/source-beta"  ;;
        alpha)   AC_CODE_DIR="${DIR}/source-alpha" ;;
        *)       echo "ERROR: Unknown profile '${PROFILE}'"; exit 1 ;;
    esac
    INSTALL_DIR="${DIR}/installed-files-${PROFILE}"
    MYSQL_DIR="${DIR}/mysql/installed-files"
}
# }}}

# {{{ setup_log_symlinks
setup_log_symlinks() {
    local TMP_BASE="/tmp/wow-chat-2"
    local TMP_LOGS="${TMP_BASE}/logs-${PROFILE}"
    mkdir -p "${TMP_BASE}"
    mkdir -p "${TMP_LOGS}"
    [[ -L "${DIR}/tmp" ]] || ln -s "${TMP_BASE}" "${DIR}/tmp"
    [[ -L "${DIR}/logs-${PROFILE}" ]] || ln -s "${TMP_LOGS}" "${DIR}/logs-${PROFILE}"
}
# }}}

# {{{ check_mysql
# Ensures MySQL is running before server startup
# Calls start-mysql if not running (which handles already-running case gracefully)
check_mysql() {
    local PID_FILE="${DIR}/mysql/databases/mysqld.pid"
    local MYSQL_RUNNING=0

    if [[ -f "${PID_FILE}" ]]; then
        local PID
        PID=$(cat "${PID_FILE}")
        if kill -0 "${PID}" 2>/dev/null; then
            MYSQL_RUNNING=1
        fi
    fi

    if [[ "${MYSQL_RUNNING}" -eq 0 ]]; then
        echo "MySQL not running, starting..."
        if ! "${DIR}/scripts/start-mysql"; then
            echo "ERROR: Failed to start MySQL"
            exit 1
        fi
        echo ""
    fi
}
# }}}

# =============================================================================
# Main
# =============================================================================

parse_args "$@"
get_profile_paths
setup_log_symlinks
check_mysql

if [[ ! -f "${INSTALL_DIR}/bin/worldserver" ]]; then
    echo "Error: worldserver not found for profile '${PROFILE}'"
    echo "Expected: ${INSTALL_DIR}/bin/worldserver"
    echo "Run './scripts/install --profile ${PROFILE}' first."
    exit 1
fi

# Unified realmlist (issue 136a): kill any worldserver squatting the
# shared port from a previous profile, then flip realm rows so this
# profile is the online one in the realm-select list. authserver does
# the same flip but doing it again here covers the "worldserver booted
# without authserver" case.
pkill -f "${INSTALL_DIR%-*}-"*"/bin/worldserver" 2>/dev/null || true
"${DIR}/scripts/set-active-realm" "${PROFILE}"

# Auto-enable the crash catcher for debug builds. `compile --debug` stamps
# bin/.build-type = "Debug"; when present, run under the catcher even without the
# runtime --debug flag (which stays as a manual override for RelWithDebInfo
# builds). Self-correcting: every build restamps this file and promote overwrites
# it, so the stamp always reflects the currently-installed binary.
if [[ -f "${INSTALL_DIR}/bin/.build-type" ]] && [[ "$(cat "${INSTALL_DIR}/bin/.build-type")" == "Debug" ]]; then
    [[ "${DEBUG_MODE}" -ne 1 ]] && echo "Debug build detected — enabling crash catcher automatically."
    DEBUG_MODE=1
fi

echo "Starting worldserver (profile: ${PROFILE})"
export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"
cd "${INSTALL_DIR}/bin"

# Normal path: exec the binary directly. Debug path: hand it to the crash
# harness, which runs it under gdb (or the shim) and dumps a backtrace to
# tmp/ if it dies. Same binary, same cwd/env either way.
if [[ "${DEBUG_MODE}" -eq 1 ]]; then
    source "${DIR}/scripts/debug-run.sh"
    debug_run_binary "./worldserver" "worldserver"
else
    ./worldserver
fi
