#!/bin/bash
# scripts/worldserver - Start the world server
# Runs the worldserver binary for the current profile

DIR="/mnt/kaun/wow-chat-2026"

# =============================================================================
# Load Profile
# =============================================================================

if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi
# DEFAULT_PROFILE snapshots the no-argument default so --help reports the
# true default even when a --profile flag precedes --help on the command
# line (that flag mutates PROFILE, not the default a bare run would use).
DEFAULT_PROFILE="${PROFILE}"

# --debug launches the server under a crash-backtrace catcher (see
# scripts/debug-run.sh). Off by default so normal runs are untouched.
DEBUG_MODE=0
# --after-compile: started by a compile's promotion (scripts/promote): the
# server runs as usual, its start-up lines hidden until it is ready
AFTER_COMPILE=0

# =============================================================================
# Argument Parsing
# =============================================================================

# {{{ parse_args
# Each option supports both --opt value and --opt=value forms. The
# catch-all errors instead of silently dropping unknown args.
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    PROFILE="${2}"
                    shift 2
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                if [[ -z "${PROFILE}" ]]; then
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                shift
                ;;
            --debug)
                DEBUG_MODE=1
                shift
                ;;
            --after-compile)
                AFTER_COMPILE=1
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                echo "Error: unrecognized argument '${1}'"
                echo "Run with --help to see available options."
                exit 1
                ;;
        esac
    done
}
# }}}

# {{{ show_help
show_help() {
    echo "Usage: ./scripts/worldserver [options]"
    echo ""
    echo "Start the world server for the current profile."
    echo ""
    echo "Options:"
    echo "  --profile <name>   Use specific profile (default: ${DEFAULT_PROFILE})"
    echo "  --debug            Run under a crash-backtrace catcher; on a"
    echo "                     segfault a symbolized stack trace is written to"
    echo "                     tmp/debug-${PROFILE}/ (uses gdb if installed,"
    echo "                     otherwise an LD_PRELOAD shim + addr2line)"
    echo "  --help             Show this help message"
    echo ""
    echo "Current profile: ${PROFILE}"
}
# }}}

# =============================================================================
# Functions
# =============================================================================

# {{{ get_profile_paths
get_profile_paths() {
    # vanilla shares source-beta with release/beta — see issue 148.
    case "${PROFILE}" in
        release) AC_CODE_DIR="${DIR}/source-beta"  ;;
        beta)    AC_CODE_DIR="${DIR}/source-beta"  ;;
        vanilla) AC_CODE_DIR="${DIR}/source-beta"  ;;
        basic)   AC_CODE_DIR="${DIR}/source-beta"  ;;
        cc-test) AC_CODE_DIR="${DIR}/source-beta"  ;;
        alpha)   AC_CODE_DIR="${DIR}/source-alpha" ;;
        *)       echo "ERROR: Unknown profile '${PROFILE}'"; exit 1 ;;
    esac
    INSTALL_DIR="${DIR}/installed-files-${PROFILE}"
    MYSQL_DIR="${DIR}/mysql/installed-files"
}
# }}}

# {{{ setup_log_symlinks
setup_log_symlinks() {
    local TMP_BASE="/tmp/wow-chat-2"
    local TMP_LOGS="${TMP_BASE}/logs-${PROFILE}"
    mkdir -p "${TMP_BASE}"
    mkdir -p "${TMP_LOGS}"
    [[ -L "${DIR}/tmp" ]] || ln -s "${TMP_BASE}" "${DIR}/tmp"
    [[ -L "${DIR}/logs-${PROFILE}" ]] || ln -s "${TMP_LOGS}" "${DIR}/logs-${PROFILE}"
    # tmp/shared-memory -> /dev/shm/wow-chat-2026, the RAM-only folder the
    # Lua scripts write their traces into (gossip-trace.lua and others).
    # /dev/shm is emptied at every reboot, so it is made here each start:
    # on 2026-10-15 a server started before it existed and every gossip
    # trace line failed ("gossip-trace: cannot open ...").
    local SHM="/dev/shm/wow-chat-2026"
    mkdir -p "${SHM}"
    [[ -L "${TMP_BASE}/shared-memory" ]] || ln -s "${SHM}" "${TMP_BASE}/shared-memory"
}
# }}}

# {{{ check_mysql
# Ensures MySQL is up and answering before server startup. start-mysql is
# safe to call every time: it verifies the PID file really names our mysqld
# (process numbers are recycled after a reboot) and waits until the server
# answers a ping, so the server binary's first connection succeeds.
check_mysql() {
    if ! "${DIR}/scripts/start-mysql" "${DIR}"; then
        echo "ERROR: MySQL is not available; not starting the server"
        exit 1
    fi
    echo ""
}
# }}}

# =============================================================================
# Main
# =============================================================================

parse_args "$@"

# {{{ quiet_until_ready
# Between the server's output and this terminal, for a start after a
# compile: every line is held back until the server says it is ready
# ("(worldserver-daemon) ready..."); then one line saying so, and from there
# everything passes straight through, byte by byte (cat), so the AC> prompt,
# which ends with no newline, shows at once. The start-up lines are not
# lost: the server writes them to logs-<profile>/Server.log as always.
#   the ready line seen: the message, then everything as it comes
#   the output ends first (the server stopped while starting): the last
#     lines it printed, so the failure is not silent
quiet_until_ready() {
    local line last=()
    while IFS= read -r line; do
        last+=("${line}")
        (( ${#last[@]} > 25 )) && last=("${last[@]:1}")
        if [[ "${line}" == *"ready..."* ]]; then
            echo "Compilation and promotion successful, server is now online."
            exec cat
        fi
    done
    echo "ERROR: the new server stopped before it was ready; its last lines (all of them: logs-${PROFILE}/Server.log):"
    printf '  %s\n' "${last[@]}"
    return 1
}
# }}}

# After a compile: this same script runs the server inside `script`, which
# gives it a terminal of its own (a server writing into a pipe holds its
# output back in large blocks, and its console needs a terminal), while
# what it prints comes through quiet_until_ready. Keys typed here go to it
# as usual, Ctrl-C included (it reaches the server, which saves and stops).
if [[ "${AFTER_COMPILE}" -eq 1 ]]; then
    echo "Starting the new server (its start-up lines: logs-${PROFILE}/Server.log)..."
    script -qfec "$(printf '%q ' "${DIR}/scripts/worldserver" --profile "${PROFILE}")" /dev/null | quiet_until_ready
    exit "${PIPESTATUS[0]}"
fi

get_profile_paths
setup_log_symlinks
check_mysql

if [[ ! -f "${INSTALL_DIR}/bin/worldserver" ]]; then
    echo "Error: worldserver not found for profile '${PROFILE}'"
    echo "Expected: ${INSTALL_DIR}/bin/worldserver"
    echo "Run './scripts/install --profile ${PROFILE}' first."
    exit 1
fi

# Unified realmlist (issue 136a): kill any worldserver squatting the
# shared port from a previous profile, then flip realm rows so this
# profile is the online one in the realm-select list. authserver does
# the same flip but doing it again here covers the "worldserver booted
# without authserver" case.
#
# A squatter is found by the program it runs, not its command line: the
# server is started as ./worldserver from its bin folder, so a pattern
# naming the install path never matched it (and the old unquoted * spread
# into several patterns, which pkill refuses: nothing was ever stopped).
# Each gets the ordinary stop signal (it saves and shuts down cleanly),
# and the start waits for it to be gone, so the port is free.
SQUAT_BASE="$(readlink -f "${DIR}")/installed-files-"
for SQUAT_PID in $(pgrep -x worldserver); do
    SQUAT_EXE="$(readlink "/proc/${SQUAT_PID}/exe")"
    SQUAT_EXE="${SQUAT_EXE% (deleted)}"       # a server started before the last reinstall runs a replaced binary
    case "${SQUAT_EXE}" in
        "${SQUAT_BASE}"*/bin/worldserver)
            # one of this project's worldservers, any profile: stop it
            echo "Stopping the running worldserver (pid ${SQUAT_PID}, ${SQUAT_EXE#${SQUAT_BASE%installed-files-}})..."
            kill "${SQUAT_PID}"
            for SQUAT_WAIT in $(seq 1 60); do
                kill -0 "${SQUAT_PID}" 2>/dev/null || break
                sleep 1
            done
            if kill -0 "${SQUAT_PID}" 2>/dev/null; then
                echo "ERROR: worldserver ${SQUAT_PID} is still running after 60 s; not starting a second one"
                exit 1
            fi
            ;;
        *)
            # someone else's worldserver (another project): left alone
            ;;
    esac
done
"${DIR}/scripts/set-active-realm" "${PROFILE}"

# Auto-enable the crash catcher for debug builds. `compile --debug` stamps
# bin/.build-type = "Debug"; when present, run under the catcher even without the
# runtime --debug flag (which stays as a manual override for RelWithDebInfo
# builds). Self-correcting: every build restamps this file and promote overwrites
# it, so the stamp always reflects the currently-installed binary.
if [[ -f "${INSTALL_DIR}/bin/.build-type" ]] && [[ "$(cat "${INSTALL_DIR}/bin/.build-type")" == "Debug" ]]; then
    [[ "${DEBUG_MODE}" -ne 1 ]] && echo "Debug build detected — enabling crash catcher automatically."
    DEBUG_MODE=1
fi

echo "Starting worldserver (profile: ${PROFILE})"
export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"
cd "${INSTALL_DIR}/bin"

# Normal path: exec the binary directly. Debug path: hand it to the crash
# harness, which runs it under gdb (or the shim) and dumps a backtrace to
# tmp/ if it dies. Same binary, same cwd/env either way.
if [[ "${DEBUG_MODE}" -eq 1 ]]; then
    source "${DIR}/scripts/debug-run.sh"
    debug_run_binary "./worldserver" "worldserver"
else
    ./worldserver
fi
