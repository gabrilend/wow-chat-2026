#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-kit
# profiles:   all
# priority:   10
# kind:       test
# about:      checks how a new buddy's bag slots are split over its bags
# quick-test: yes
# ==== end of header ====
# test-buddy-kit - checks how a new buddy's bag slots are split over its bags
# (issue 617a4): builds the small bag-split test with the system compiler and
# runs it, at low priority so the machine stays usable.
# Usage: scripts/test-buddy-kit [PROJECT_DIR]
DIR="${1:-/mnt/kaun/wow-chat-2026}"
OUT="${DIR}/tmp/tmp"
mkdir -p "${OUT}"
g++ -std=c++17 -O1 -Wall -Wextra -Werror -I"${DIR}/patches/B036-mod-buddies/mod-buddies/src" \
    "${DIR}/tests/buddy-kit/bag-split.cpp" -o "${OUT}/buddy-kit-bag-split" || exit 1
nice -n 19 "${OUT}/buddy-kit-bag-split"
# ==== footer of test-buddy-kit ====
# lines:      22
# ==== end of footer ====
