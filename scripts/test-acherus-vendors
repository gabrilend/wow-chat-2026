#!/usr/bin/env bash
# test-acherus-vendors
#
# What it is: a check that the Acherus vendors install step (E051, issue
# 718) does what it says, without leaving a trace. Inside one database
# transaction on the basic world database it runs the revert first and
# looks (stock, whether or not the live database has the step applied),
# runs the step twice and looks (two vendors open, five items at 1 gold,
# worth nothing to sell), runs the revert and looks again (stock
# restored), then rolls the whole transaction back, so the database is as
# it was. Until 2026-10-09 the first look was of the live database, which
# on an installed server already holds the step: the revert, correctly
# going back to stock, then "failed" against it.
# Needs the project's MySQL running (scripts/start-mysql).
#
# Usage: scripts/test-acherus-vendors [PROJECT_DIR]

set -euo pipefail

# {{{ configuration
DIR="/mnt/mtwo/games/azeroth-core/wow-chat-2026"
if [[ -n "${1:-}" && -d "${1:-}" ]]; then DIR="$1"; fi
MYSQL="${DIR}/mysql/installed-files/bin/mysql"
DB="acore_world_basic"
APPLY="${DIR}/sql/basic/db_world.src/32-acherus-choice-vendors.apply.sql"
REVERT="${DIR}/sql/basic/db_world.src/32-acherus-choice-vendors.revert.sql"
# }}}

# One line per look: vendor flag bits on the two creatures, vendor rows,
# and the five items' buy and sell prices.
LOOK="SELECT CONCAT('flags ', GROUP_CONCAT(entry, ':', npcflag & 128 ORDER BY entry)) FROM creature_template WHERE entry IN (28471, 28357);
SELECT CONCAT('rows ', COUNT(*)) FROM npc_vendor WHERE entry IN (28471, 28357);
SELECT CONCAT('prices ', GROUP_CONCAT(entry, ':', BuyPrice, '/', SellPrice ORDER BY entry)) FROM item_template WHERE entry IN (39320, 38664, 39322, 38632, 38633);"

OUT="$(
    {
        echo "START TRANSACTION;"
        cat "${REVERT}"
        echo "SELECT 'before';"; echo "${LOOK}"
        cat "${APPLY}"
        cat "${APPLY}"
        echo "SELECT 'applied';"; echo "${LOOK}"
        cat "${REVERT}"
        echo "SELECT 'reverted';"; echo "${LOOK}"
        echo "ROLLBACK;"
    } | "${MYSQL}" -h127.0.0.1 -P3307 -uritz -pmenardi -N "${DB}" 2>&1 | grep -v "Using a password"
)"
echo "${OUT}"

before="$(  echo "${OUT}" | sed -n '2,4p')"
applied="$( echo "${OUT}" | sed -n '/^applied$/,/^reverted$/p')"
reverted="$(echo "${OUT}" | tail -n 3)"

fails=0
# {{{ check
check() {
    if [[ "$2" == "yes" ]]; then echo "  ok:   $1"; else echo "  FAIL: $1"; fails=$((fails + 1)); fi
}
# }}}
has() { [[ "$1" == *"$2"* ]] && echo yes || echo no; }

check "applied: both creatures carry the vendor flag"   "$(has "${applied}" "flags 28357:128,28471:128")"
check "applied: five items for sale"                    "$(has "${applied}" "rows 5")"
check "applied: every item 1 gold, sells for nothing"   "$(has "${applied}" "prices 38632:10000/0,38633:10000/0,38664:10000/0,39320:10000/0,39322:10000/0")"
check "reverted: the flags, rows and prices are stock again" "$([[ "${before}" == "${reverted}" ]] && echo yes || echo no)"

echo ""
if [[ ${fails} -eq 0 ]]; then echo "All 4 checks passed (rolled back; nothing changed)"; else echo "${fails} of 4 checks failed"; exit 1; fi
