#!/usr/bin/env luajit
-- generate-buddy-lever-map-page - draws the buddy lever map as a page
-- (issue 638).
--
-- For a general audience: scripts/generate-buddy-lever-map groups the
-- buddies' levers (small things a buddy can do) by meaning and names the
-- groups; this puts that map on a web page that opens straight from its
-- file: each lever a dot, close dots close in meaning, coloured by group,
-- with the groups listed by name and a box to find levers. Making the map
-- and drawing it are separate tools, so either can change alone.
--
-- Reads:  src/lua-basic/data/buddy-lever-list.lua, src/lua-basic/data/buddy-lever-map.lua,
--         scripts/templates/buddy-lever-map.html
-- Writes: docs/HTML/buddy-lever-map.html
--         development-history/NNN-buddy-lever-map.png, with --screenshot
-- Usage:  scripts/generate-buddy-lever-map-page [PROJECT_DIR] [--screenshot]
--         scripts/generate-buddy-lever-map-page --help

local DIR, SHOT = "/mnt/kaun/wow-chat-2026", false
for _, a in ipairs(arg) do
    if a == "--help" then
        print("generate-buddy-lever-map-page [PROJECT_DIR] [--screenshot]: writes docs/HTML/buddy-lever-map.html")
        print("from the lever list and the semantic map (run generate-buddy-lever-map first; issue 638).")
        print("  --screenshot  also photograph the page and file the picture in development-history/")
        os.exit(0)
    elseif a == "--screenshot" then SHOT = true
    elseif a:sub(1, 2) == "--" then io.stderr:write("generate-buddy-lever-map-page: unknown option " .. a .. "\n"); os.exit(1)
    else DIR = a end
end
local LIBS = "/home/ritz/programming/ai-stuff/libs/lua"
package.path = LIBS .. "/?.lua;" .. package.path
local json = require("dkjson")

local TEMPLATE = DIR .. "/scripts/templates/buddy-lever-map.html"
local OUT      = DIR .. "/docs/HTML/buddy-lever-map.html"
local LEVERS   = dofile(DIR .. "/src/lua-basic/data/buddy-lever-list.lua")
local ok, MAP  = pcall(dofile, DIR .. "/src/lua-basic/data/buddy-lever-map.lua")
if not ok then
    io.stderr:write("generate-buddy-lever-map-page: no map to draw (" .. tostring(MAP) .. "); scripts/generate-buddy-lever-map makes it\n")
    os.exit(1)
end

-- {{{ the page's data
-- Every lever with its segment and place; a lever the map doesn't know
-- (the list was made again after the map) stops the tool, since its dot
-- would have nowhere to go: make the map again.
local data = { model = MAP.model, seed = MAP.seed, segments = MAP.segments, levers = {} }
for _, l in ipairs(LEVERS) do
    local seg, xy = MAP.segment_of[l.id], MAP.xy[l.id]
    if not seg or not xy then
        io.stderr:write("generate-buddy-lever-map-page: the map has no place for " .. l.id .. "; the lever list is newer than the map: run scripts/generate-buddy-lever-map\n")
        os.exit(1)
    end
    data.levers[#data.levers + 1] = { id = l.id, say = l.say, seg = seg, x = xy[1], y = xy[2] }
end
-- }}}

local f = assert(io.open(TEMPLATE)); local page = f:read("*a"); f:close()
local note = "<!-- docs/HTML/buddy-lever-map.html - GENERATED by scripts/generate-buddy-lever-map-page from\n" ..
             "     scripts/templates/buddy-lever-map.html and the lever map's data (issue 638). Don't edit; run it again. -->"
local a, b = page:find("<!-- GENERATED_NOTE -->", 1, true)
page = page:sub(1, a - 1) .. note .. page:sub(b + 1)
a, b = page:find("/*MAP_DATA*/", 1, true)
if not a then io.stderr:write("generate-buddy-lever-map-page: the template has no /*MAP_DATA*/ mark\n"); os.exit(1) end
page = page:sub(1, a - 1) .. json.encode(data) .. page:sub(b + 1)
f = assert(io.open(OUT, "w")); f:write(page); f:close()
print(("generate-buddy-lever-map-page: %d levers, %d segments, %d bytes -> %s"):format(#data.levers, #data.segments, #page, OUT))

-- {{{ --screenshot: the page photographed and kept in development-history/
-- (the owner keeps every picture the project takes of itself; filed and
-- noted by scripts/file-screenshot, "What it shows" left to whoever looks)
if SHOT then
    local cmd = string.format("'%s/scripts/file-screenshot' --dir '%s' --name buddy-lever-map --made %q"
        .. " --source scripts/generate-buddy-levers --source scripts/generate-buddy-lever-map"
        .. " --source scripts/generate-buddy-lever-map-page --source scripts/templates/buddy-lever-map.html"
        .. " --source src/lua-basic/data/buddy-lever-map.lua --window 1400x900 --url 'file://%s'",
        DIR, DIR, "scripts/generate-buddy-lever-map-page --screenshot (" .. MAP.model .. ", " .. #data.segments .. " segments, seed " .. MAP.seed .. ")", OUT)
    local r = os.execute(cmd)
    if r ~= true and r ~= 0 then io.stderr:write("generate-buddy-lever-map-page: the page is written, but its picture was not filed (file-screenshot failed)\n"); os.exit(1) end
end
-- }}}
