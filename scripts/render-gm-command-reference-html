#!/usr/bin/env luajit

local DIR = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end
local TXT  = arg[2] or (DIR .. "/docs/gm-commands.txt")
local HTML = arg[3] or (DIR .. "/docs/HTML/gm-commands.html")

local h = io.open(TXT, "r")
if not h then io.stderr:write("ERROR: cannot read " .. TXT .. " (run scripts/generate-gm-command-reference first)\n"); os.exit(1) end
local lines = {}
for line in h:lines() do lines[#lines + 1] = line end
h:close()

local function esc(s) return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;")) end
local function slug(s) return (s:lower():gsub("[^%w]+", "-"):gsub("^%-+", ""):gsub("%-+$", "")) end
local function indent_of(s) return #s:match("^( *)") end

local stamp, sections = {}, {}
local i, section = 1, nil
while i <= #lines and not lines[i]:match("^=+$") do stamp[#stamp + 1] = lines[i]; i = i + 1 end

local system, stack, anchor = nil, {}, nil
while i <= #lines do
    local line = lines[i]
    if line:match("^=+$") and lines[i + 2] and lines[i + 2]:match("^=+$") then
        local title = lines[i + 1]:match("^%s*(.-)%s*$")
        section = { title = title, kind = (title:find("^WHAT'S NEW") or title:find("^EVERY COMMAND")) and "commands" or "prose",
                    prose = {}, systems = {} }
        sections[#sections + 1] = section
        system, stack, anchor = nil, {}, nil
        i = i + 3
    elseif not section then
        i = i + 1
    elseif section.kind == "prose" then
        section.prose[#section.prose + 1] = line
        i = i + 1
    elseif not line:match("%S") then
        i = i + 1
    elseif indent_of(line) == 0 and lines[i + 1] and lines[i + 1]:match("^%-+$") then
        system = { name = line, families = {} }
        section.systems[#section.systems + 1] = system
        stack, anchor = {}, nil
        i = i + 2
    else
        local ind, text = indent_of(line), line:match("^%s*(.-)%s*$")
        if anchor and ind >= anchor.indent + 4 then
            anchor.help[#anchor.help + 1] = text
        elseif text:sub(1, 1) == "." and anchor and anchor.kind == "command" and ind == anchor.indent and not text:find("%s%s%[[^%]]*%]$") then
            anchor.syntax[#anchor.syntax + 1] = text
        else
            local node = { indent = ind, help = {}, syntax = {}, children = {} }
            if text:sub(1, 1) == "." then
                local syn, meta = text:match("^(.-)%s%s+%[([^%]]*)%]$")
                node.kind, node.syntax, node.meta = "command", { syn or text }, meta or ""
            else
                node.kind = (ind == 2) and "family" or "group"
                node.text = text
            end
            while #stack > 0 and stack[#stack].indent >= ind do table.remove(stack) end
            if node.kind == "family" then
                if not system then io.stderr:write("ERROR: line " .. i .. ": a family outside any system\n"); os.exit(1) end
                system.families[#system.families + 1] = node
            elseif #stack > 0 then
                table.insert(stack[#stack].children, node)
            else
                io.stderr:write("ERROR: line " .. i .. ": a command or group outside any family: " .. text .. "\n"); os.exit(1)
            end
            if node.kind ~= "command" then stack[#stack + 1] = node end
            anchor = node
        end
        i = i + 1
    end
end

local out = {}
local function w(s) out[#out + 1] = s end

local function syntax_html(s)
    local cmd, rest = s:match("^(%.[%w_%-]+[^%$#<%[]*)(.*)$")
    if not cmd then cmd, rest = s, "" end
    rest = esc(rest)
    rest = rest:gsub("(%[[^%]]*%])", '<span class="opt">%1</span>')
    rest = rest:gsub("(&lt;[^&]*&gt;)", '<span class="req">%1</span>')
    rest = rest:gsub("([%$#][%w_]+)", '<span class="val">%1</span>')
    return '<span class="cmd">' .. esc(cmd) .. "</span>" .. rest
end

local counts = { total = 0, new = 0 }
local function draw_node(node, family_slug)
    if node.kind == "command" then
        counts.total = counts.total + 1
        local level, where, new = node.meta:match("^%s*([^,]+),%s*([^,]+),?%s*(.-)%s*$")
        local is_new = new == "NEW"
        if is_new then counts.new = counts.new + 1 end
        local words = {}
        for _, s in ipairs(node.syntax) do words[#words + 1] = s end
        w(string.format('<div class="c%s" data-level="%s" data-new="%s" data-text="%s">', is_new and " new" or "", esc(level or ""),
            is_new and "1" or "0", esc((table.concat(words, " ") .. " " .. table.concat(node.help, " ")):lower())))
        w('<div class="row"><code class="syn">')
        for k, s in ipairs(node.syntax) do w((k > 1 and "<br>" or "") .. syntax_html(s)) end
        w('</code><span class="meta"><span class="lv lv-' .. esc(level or "") .. '">' .. esc(level or "") .. '</span>'
            .. '<span class="wh">' .. esc(where or "") .. "</span>" .. (is_new and '<span class="nw">new</span>' or "") .. "</span></div>")
        if #node.help > 0 then w('<p class="help">' .. esc(table.concat(node.help, " ")) .. "</p>") end
        w("</div>")
    else
        local tag = node.kind == "family" and "h3" or "h4"
        w(string.format('<div class="%s"%s>', node.kind, node.kind == "family" and (' id="' .. family_slug .. '"') or ""))
        local title, count = node.text:match("^(.-)%s%s+(%(.*%))$")
        w(string.format("<%s>%s%s</%s>", tag, esc(title or node.text), count and (' <small>' .. esc(count) .. "</small>") or "", tag))
        if #node.help > 0 then w('<p class="help">' .. esc(table.concat(node.help, " ")) .. "</p>") end
        for _, child in ipairs(node.children) do draw_node(child, family_slug) end
        w("</div>")
    end
end

local function prose_html(plines)
    local blocks, para, pre = {}, {}, {}
    local function flush()
        if #para > 0 then blocks[#blocks + 1] = "<p>" .. esc(table.concat(para, " ")) .. "</p>"; para = {} end
        if #pre > 0 then blocks[#blocks + 1] = "<pre>" .. esc(table.concat(pre, "\n")) .. "</pre>"; pre = {} end
    end
    for _, l in ipairs(plines) do
        if not l:match("%S") then flush()
        elseif indent_of(l) > 0 then if #para > 0 then flush() end; pre[#pre + 1] = l
        else if #pre > 0 then flush() end; para[#para + 1] = l end
    end
    flush()
    return table.concat(blocks, "\n")
end

local toc = {}
for _, s in ipairs(sections) do
    local sid = slug(s.title)
    toc[#toc + 1] = '<li><a href="#' .. sid .. '">' .. esc(s.title:lower():gsub("^%l", string.upper)) .. "</a>"
    if s.kind == "commands" then
        toc[#toc + 1] = "<ul>"
        for _, sys in ipairs(s.systems) do
            local yid = sid .. "--" .. slug(sys.name)
            toc[#toc + 1] = '<li><a href="#' .. yid .. '">' .. esc(sys.name:lower():gsub("^%l", string.upper)) .. "</a>"
            if s.title:find("^EVERY") then
                toc[#toc + 1] = '<ul class="fams">'
                for _, f in ipairs(sys.families) do
                    local name = f.text:match("^(%S+)")
                    toc[#toc + 1] = '<li><a href="#' .. yid .. "--" .. slug(name) .. '">' .. esc(name) .. "</a></li>"
                end
                toc[#toc + 1] = "</ul>"
            end
            toc[#toc + 1] = "</li>"
        end
        toc[#toc + 1] = "</ul>"
    end
    toc[#toc + 1] = "</li>"
end

local body = {}
for _, s in ipairs(sections) do
    local sid = slug(s.title)
    body[#body + 1] = '<section id="' .. sid .. '"><h2>' .. esc(s.title) .. "</h2>"
    if s.kind == "prose" then
        body[#body + 1] = prose_html(s.prose)
    else
        local before = #out
        for _, sys in ipairs(s.systems) do
            local yid = sid .. "--" .. slug(sys.name)
            w('<div class="sys" id="' .. yid .. '"><h2 class="sysh">' .. esc(sys.name) .. "</h2>")
            for _, f in ipairs(sys.families) do draw_node(f, yid .. "--" .. slug(f.text:match("^(%S+)"))) end
            w("</div>")
        end
        local piece = {}
        for k = before + 1, #out do piece[#piece + 1] = out[k] end
        for k = #out, before + 1, -1 do out[k] = nil end
        body[#body + 1] = table.concat(piece, "\n")
    end
    body[#body + 1] = "</section>"
end

local page = [[<!doctype html>
<!-- ]] .. esc(table.concat(stamp, " ")):gsub("%-%-", "- -") .. [[ Drawn by scripts/render-gm-command-reference-html from docs/gm-commands.txt alone. -->
