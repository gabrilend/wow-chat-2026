  --rule:#2c2b27; --accent:#3987e5; --new:#2fcf92; --new-bg:rgba(47,207,146,.10);
  --val:#e08a52; --opt:#a990e6; --req:#5aa2ff; } }
:root[data-theme="dark"]{
  color-scheme:dark; --bg:#131311; --surface:#1a1a19; --ink:#f3f2ec; --ink-2:#c3c2b7; --ink-3:#8f8d82;
  --rule:#2c2b27; --accent:#3987e5; --new:#2fcf92; --new-bg:rgba(47,207,146,.10);
  --val:#e08a52; --opt:#a990e6; --req:#5aa2ff; }
