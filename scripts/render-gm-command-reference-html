]] .. table.concat(body, "\n") .. [[

</main>
</div>
<script>
(function(){
  var q=document.getElementById('q'), all=document.getElementById('all'), onlynew=document.getElementById('onlynew'),
      levels=document.querySelectorAll('#levels button'), count=document.getElementById('count');
  var state={text:'',newOnly:false,level:''};
  var cmds=[].slice.call(document.querySelectorAll('.c'));
  var boxes=[].slice.call(document.querySelectorAll('.group,.family,.sys')).reverse();
  function apply(){
    var shown=0, words=state.text.toLowerCase().split(/\s+/).filter(Boolean);
    cmds.forEach(function(c){
      var ok=(!state.newOnly||c.dataset.new==='1')&&(!state.level||c.dataset.level===state.level)&&
             words.every(function(w){return c.dataset.text.indexOf(w)>=0;});
      c.classList.toggle('hidden',!ok); if(ok) shown++;
    });
    boxes.forEach(function(b){ b.classList.toggle('hidden', !b.querySelector('.c:not(.hidden)')); });
    count.textContent=shown+' of '+cmds.length+' shown';
  }
  q.addEventListener('input',function(){state.text=q.value;apply();});
  all.addEventListener('click',function(){state.newOnly=false;all.setAttribute('aria-pressed','true');onlynew.setAttribute('aria-pressed','false');apply();});
  onlynew.addEventListener('click',function(){state.newOnly=true;onlynew.setAttribute('aria-pressed','true');all.setAttribute('aria-pressed','false');apply();});
  levels.forEach(function(b){b.addEventListener('click',function(){
    state.level=b.dataset.l; levels.forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false');}); apply();});});
  apply();
})();
</script>
</body>
</html>
]]
local o = assert(io.open(HTML, "w"))
o:write(page)
o:close()
print(string.format("%s: %d command entries (%d new) from %s", HTML:sub(#DIR + 2), counts.total, counts.new, TXT:sub(#DIR + 2)))
