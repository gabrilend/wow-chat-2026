section>h2{font:600 13px "IBM Plex Mono",monospace;letter-spacing:.08em;color:var(--ink-3);border-bottom:1px solid var(--rule);padding-bottom:6px;margin:34px 0 12px}
.sysh{font:600 22px/1.2 "Cormorant SC",Georgia,serif;margin:26px 0 8px;letter-spacing:.02em}
section p,section pre{max-width:72ch;color:var(--ink-2)}
