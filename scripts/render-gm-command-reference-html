<div class="controls">
  <input type="search" id="q" placeholder="Search commands and help" aria-label="Search commands and help">
  <div class="seg" role="group" aria-label="Which commands"><button id="all" aria-pressed="true">all</button><button id="onlynew" aria-pressed="false">new only</button></div>
  <div class="seg" role="group" aria-label="Who may run them" id="levels">
    <button data-l="" aria-pressed="true">any level</button><button data-l="player" aria-pressed="false">player</button><button data-l="moderator" aria-pressed="false">moderator</button><button data-l="gm" aria-pressed="false">gm</button><button data-l="admin" aria-pressed="false">admin</button><button data-l="console" aria-pressed="false">console</button>
  </div>
  <span class="count" id="count"></span>
