#!/usr/bin/env luajit
-- generate-buddy-quest-spells - the class spells that quests teach, as a
-- table the buddy module compiles in (issue 617n).
--
-- For a general audience: a player learns most class abilities from a
-- trainer, but some only by finishing a class quest (a warlock's demons, a
-- hunter's pet taming, a druid's bear form). Buddies don't do quests, so
-- they would never have those. The owner (2026-10-03): "we can manually add
-- the quest-reward spells and pet spells and such to the list of spells we
-- teach to each class." This reads every quest that only one class may
-- take and that rewards a spell, from the world database, and writes
-- modules/mod-buddies/src/buddies_quest_spells.h: class, which races, the
-- level the quest can first be taken at, the spell learned, the quest's
-- name. A spell taught by several quests (one per starting city) is one
-- row: the lowest level, every race that can get it.
--
-- Usage: scripts/generate-buddy-quest-spells [PROJECT_DIR] [WORLD_DB]
--   Reads   WORLD_DB (default acore_world_basic), read-only
--   Writes  modules/mod-buddies/src/buddies_quest_spells.h

local DIR   = arg[1] or "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local DB    = arg[2] or "acore_world_basic"
local OUT   = DIR .. "/modules/mod-buddies/src/buddies_quest_spells.h"
local MYSQL = DIR .. "/mysql/installed-files/bin/mysql -h127.0.0.1 -P3307 -uritz -pmenardi -N --batch " .. DB

-- {{{ the query
-- One class only: the class mask has exactly one bit (a quest any of
-- several classes may take, like the Wrathgate's, rewards no class
-- ability). The spell learned is the display spell when there is one (the
-- reward spell is then the "teach" spell the quest casts on the player),
-- else the reward spell itself. Repeatable quests are left out.
local QUERY = [[
SELECT qa.AllowableClasses, q.AllowableRaces, q.MinLevel,
       IF(q.RewardDisplaySpell <> 0, q.RewardDisplaySpell, q.RewardSpell), q.ID, q.LogTitle
FROM quest_template q JOIN quest_template_addon qa ON qa.ID = q.ID
WHERE (q.RewardSpell <> 0 OR q.RewardDisplaySpell <> 0)
  AND qa.AllowableClasses <> 0 AND (qa.AllowableClasses & (qa.AllowableClasses - 1)) = 0
  AND (qa.SpecialFlags & 1) = 0
ORDER BY q.ID]]
-- }}}

-- {{{ local function die
local function die(msg)
    io.stderr:write("generate-buddy-quest-spells: ", msg, "\n")
    os.exit(1)
end
-- }}}

-- {{{ read
local p = io.popen(MYSQL .. " -e \"" .. QUERY:gsub("\n", " ") .. "\" 2>&1")
local out = p:read("*a")
p:close()
local rows, byKey = {}, {}
for line in out:gmatch("[^\n]+") do
    if not line:find("Using a password", 1, true) then
        if line:find("^ERROR") then die("database " .. DB .. ": " .. line) end
        local mask, races, level, spell, id, title = line:match("^(%d+)\t(%d+)\t(%-?%d+)\t(%d+)\t(%d+)\t(.*)$")
        if not mask then die("unreadable row: " .. line) end
        mask, races, level, spell = tonumber(mask), tonumber(races), math.max(1, tonumber(level)), tonumber(spell)
        local cls = 0
        while mask > 1 do mask = mask / 2; cls = cls + 1 end
        cls = cls + 1                                           -- class ids count from 1 (mask bit 0 is class 1)
        local key = cls .. ":" .. spell
        local r = byKey[key]
        if not r then
            r = { cls = cls, races = races, level = level, spell = spell, quest = title:gsub('"', "'") }
            byKey[key] = r
            rows[#rows + 1] = r
        else
            -- the same lesson from another city's quest: every race, the lowest level
            r.races = (races == 0 or r.races == 0) and 0 or bit.bor(r.races, races)
            if level < r.level then r.level, r.quest = level, title:gsub('"', "'") end
        end
    end
end
if #rows == 0 then die("no class quest rewards a spell in " .. DB .. "; is it the right database?") end
table.sort(rows, function(a, b)
    if a.cls ~= b.cls then return a.cls < b.cls end
    if a.level ~= b.level then return a.level < b.level end
    return a.spell < b.spell
end)
-- }}}

-- {{{ write
local f = assert(io.open(OUT, "w"))
f:write([[
/*
 * buddies_quest_spells.h - GENERATED by scripts/generate-buddy-quest-spells;
 * don't edit by hand. The class spells quests teach (issue 617n): a buddy
 * of the class and one of the races (0: any) learns the spell from a class
 * trainer once its level reaches the quest's, and all of them it qualifies
 * for when it is made (buddies_spells.cpp).
 */

#ifndef MOD_BUDDIES_QUEST_SPELLS_H
#define MOD_BUDDIES_QUEST_SPELLS_H

#include <cstdint>

struct BuddyQuestSpell
{
    uint8_t  cls;
    uint32_t races;    // race mask (bit 0 = race 1); 0 = every race
    uint8_t  level;    // the quest's minimum level
    uint32_t spell;    // the spell learned
};

static BuddyQuestSpell const sBuddyQuestSpells[] = {
]])
for _, r in ipairs(rows) do
    f:write(string.format("    { %2d, %5d, %2d, %6d },   // %s\n", r.cls, r.races, r.level, r.spell, r.quest))
end
f:write([[
};

#endif
]])
f:close()
io.write(string.format("wrote %d quest spells into %s\n", #rows, OUT))
-- }}}
