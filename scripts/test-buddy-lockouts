#!/bin/bash

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    sed -n '10,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
DIR="${1:-/mnt/kaun/wow-chat-2026}"
OUT="${DIR}/tmp/tmp"
mkdir -p "${OUT}"
g++ -std=c++17 -O1 -Wall -Wextra -Werror -I"${DIR}/patches/B036-mod-buddies/mod-buddies/src" \
    "${DIR}/tests/buddy-lockouts/lockout-check.cpp" -o "${OUT}/buddy-lockouts" || exit 1
nice -n 19 "${OUT}/buddy-lockouts"
