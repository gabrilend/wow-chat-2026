#!/usr/bin/env bash
# test-profile-config-gates - run a profile's config patches on scratch
# copies of the config files and check every value that came out.
#
# For a general audience: each profile's settings (level cap, bot
# population, fall damage, ...) are written into the server's config files
# by small patch scripts, each tagged with the profiles it applies to. A
# tag that misses a profile fails silently: the server still starts, with
# the wrong numbers. This test runs the real patch scripts against
# throwaway copies of the stock config files, then reads each setting back
# and compares it with the value the profile's issue file promises. It
# never starts a server and never touches a database.
#
# Usage: scripts/test-profile-config-gates [PROJECT_DIR] [PROFILE] [--source TREE]
#   PROJECT_DIR defaults to the hard-coded path below.
#   --source: the AzerothCore source tree whose stock config files are
#   patched (default PROJECT_DIR/source-beta). A separate checkout of the
#   project has no source tree of its own; name the main project's.
#   PROFILE: check that one profile. Without it, every profile with an
#   expectation table below is checked in turn (basic, cc-test, beta), so
#   the build's quick tests, which pass only the project folder, check
#   them all. (Until 2026-10-17 it defaulted to basic alone, and beta's
#   table, added that day, was never checked by a build.)
#
# Input: the stock .conf.dist files in the source tree, the ones the next
# build installs. Until 2026-10-18 they were taken from the first installed
# tree found (vanilla, beta, release), on the belief that every installed
# tree holds the same files. They do not: each holds the files of the build
# that made it, and beta's (April) and release's (May) still name the
# playerbots setting EquipmentPersistence, which upstream has since renamed
# EquipAndSpecPersistence. Wherever vanilla's newer tree was missing, the
# test failed on a patch that was right.
# Exit status: 0 if every expectation holds, 1 otherwise.

set -o pipefail

DIR="/mnt/kaun/wow-chat-2026"
SOURCE=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--source" ]]; then SOURCE="$2"; shift 2; else POSITIONAL+=("$1"); shift; fi
done
set -- "${POSITIONAL[@]}"
[[ -n "${1:-}" ]] && DIR="$1"
[[ -n "${SOURCE}" ]] || SOURCE="${DIR}/source-beta"

# {{{ every profile with a table, when none is named
#   a profile named: check it below
#   none named: run this script once per profile with a table, and pass
#     only if every one passes
if [[ -z "${2:-}" ]]; then
    overall=0
    for each in basic cc-test beta; do
        echo "=== ${each}"
        "$0" "${DIR}" "${each}" --source "${SOURCE}" || overall=1
    done
    exit "${overall}"
fi
PROFILE="$2"
# }}}

# {{{ expectations
# Each row: file (relative to etc/) | key | expected value.
# Source of truth for basic: issues/155b-basic-profile-config-gates.md.
declare -a EXPECT_basic=(
    "worldserver.conf|MaxPlayerLevel|60"
    "worldserver.conf|StartPlayerLevel|1"
    "worldserver.conf|StartHeroicPlayerLevel|55"          # death knights start at 55 (C017)
    "worldserver.conf|RecruitAFriend.MaxLevel|60"
    "worldserver.conf|Rate.Damage.Fall|10.0"
    "worldserver.conf|Rate.MoveSpeed.Player|0.85"
    "worldserver.conf|EnableLowLevelRegenBoost|0"          # no faster healing below 15 (C034)
    "worldserver.conf|Rate.XP.Kill|1"
    # no quest sparkles, object quest marks or map points (C038, 2026-10-20)
    "worldserver.conf|Visibility.ObjectSparkles|0"
    "worldserver.conf|Visibility.ObjectQuestMarkers|0"
    "worldserver.conf|QuestPOI.Enabled|0"
    "worldserver.conf|Corpse.Decay.NORMAL|60"              # stock: wow-chat-1's corpses are beta's only
    "worldserver.conf|Visibility.Distance.Instances|250"   # C039 (bots capped by B056)
    "worldserver.conf|Visibility.Distance.Continents|100"  # stock: only beta's continents are raised
    "worldserver.conf|RealmID|5"
    "worldserver.conf|WorldServerPort|4462"
    "worldserver.conf|GM.LoginState|3"
    "worldserver.conf|CharacterCreating.MinLevelForHeroicCharacter|55"
    "worldserver.conf|CharacterCreating.Disabled.ClassMask|0"
    "worldserver.conf|PlayerStart.CustomSpells|__unset_or_0__"
    "worldserver.conf|ClientCacheVersion|__nonzero_uint32__"
    # no random bots on basic (C023, 2026-09-24): buddies only (issue 617)
    "modules/playerbots.conf|AiPlayerbot.RandomBotAutologin|0"
    "modules/playerbots.conf|AiPlayerbot.MinRandomBots|0"
    "modules/playerbots.conf|AiPlayerbot.MaxRandomBots|0"
    "modules/playerbots.conf|AiPlayerbot.DisableDeathKnightLogin|1"
    # no dual spec on basic (C026, 2026-09-25, issue 155r): above the level cap
    "worldserver.conf|MinDualSpecLevel|255"
    # buddies' talents by the project's own script (C027, 2026-09-26, issue 617g)
    "modules/playerbots.conf|AiPlayerbot.AltMaintenanceTalentTree|0"
    # honor effectively uncapped (C028, 2026-09-26, issue 155t)
    "worldserver.conf|MaxHonorPoints|2147483647"
    "worldserver.conf|MaxHonorPointsMoneyPerPoint|0"
    # buddies' far parties survive a login (C029, 2026-09-27, issue 617c2)
    "modules/playerbots.conf|AiPlayerbot.KeepAltsInGroup|1"
    # no playerbots group invite at a buddy's login (C030 + B037, 2026-09-27, issue 617c2)
    "modules/playerbots.conf|AiPlayerbot.InviteAltsOnLogin|0"
    # nobody joins General, Trade, LocalDefense, WorldDefense, GuildRecruitment, LookingForGroup (C031 + B038, 2026-09-27, issue 155x)
    "worldserver.conf|Basic.RefusedChannels|1 2 22 23 25 26"
)

# Source of truth for cc-test: issues/176-cc-test-profile.md ("What the
# name resolves to"). Stock values everywhere a gameplay patch would
# otherwise reach; the table's name uses an underscore because a hyphen
# can't stand in a shell variable name (looked up as EXPECT_cc_test).
declare -a EXPECT_cc_test=(
    "worldserver.conf|MaxPlayerLevel|80"
    "worldserver.conf|StartPlayerLevel|1"
    "worldserver.conf|StartHeroicPlayerLevel|55"
    "worldserver.conf|MinDualSpecLevel|40"
    "worldserver.conf|Rate.MoveSpeed.Player|1"            # stock speed: C003 gated away from cc-test
    "worldserver.conf|EnableLowLevelRegenBoost|0"          # C034 is every profile's since 2026-10-20
    "worldserver.conf|QuestPOI.Enabled|1"                  # stock: C038 leaves cc-test alone
    "worldserver.conf|Visibility.Distance.Instances|250"   # C039: stand-ins and buddies are capped by B056 here too
    "worldserver.conf|Rate.Damage.Fall|1"
    "worldserver.conf|Rate.XP.Kill|1"
    "worldserver.conf|RealmID|6"
    "worldserver.conf|WorldServerPort|4462"
    "authserver.conf|RealmServerPort|4362"
    "worldserver.conf|GM.LoginState|0"                     # a test character meets every player check
    "worldserver.conf|Warden.ClientCheckFailAction|0"      # C033: logged only, until the custom client answers Warden
    "worldserver.conf|ClientCacheVersion|__nonzero_uint32__"
    # no random bots (C023): a scene places the bots it needs
    "modules/playerbots.conf|AiPlayerbot.RandomBotAutologin|0"
    "modules/playerbots.conf|AiPlayerbot.MinRandomBots|0"
    "modules/playerbots.conf|AiPlayerbot.MaxRandomBots|0"
    # the buddy module's settings, as basic's (C027, C029, C030)
    "modules/playerbots.conf|AiPlayerbot.AltMaintenanceTalentTree|0"
    "modules/playerbots.conf|AiPlayerbot.KeepAltsInGroup|1"
    "modules/playerbots.conf|AiPlayerbot.InviteAltsOnLogin|0"
)

# Source of truth for beta: docs/profiles/beta.md ("Settings"), which
# names the issue behind each value. Added 2026-10-17, when beta had no
# table and its death knights had quietly been set to start at the cap.
declare -a EXPECT_beta=(
    "worldserver.conf|MaxPlayerLevel|20"                   # C006b
    "worldserver.conf|StartPlayerLevel|1"                  # C007b
    "worldserver.conf|StartHeroicPlayerLevel|1"            # C017: death knights at 1 (issue 206)
    "worldserver.conf|CharacterCreating.MinLevelForHeroicCharacter|0"   # C036: no level-55 character needed first
    "worldserver.conf|RecruitAFriend.MaxLevel|20"          # C017
    "worldserver.conf|Rate.XP.Kill|3"                      # C037: no quests on beta (C005 is release's only since 2026-10-20)
    "worldserver.conf|Rate.XP.Quest|1"                     # stock: nothing to quest for
    "worldserver.conf|EnableLowLevelRegenBoost|0"          # C034, every profile since 2026-10-20
    # wow-chat-1's survival settings (C037, docs/wow-chat-1-settings.md), one or two per theme
    "worldserver.conf|DurabilityLoss.OnDeath|0"
    "worldserver.conf|Rate.RepairCost|25"
    "worldserver.conf|Rate.SellValue.Item.Legendary|10"
    "worldserver.conf|Rate.XP.Explore|10"
    "worldserver.conf|SkillChance.Prospecting|1"
    "worldserver.conf|MaxPrimaryTradeSkill|2"              # stock, the owner's choice
    "worldserver.conf|WaterBreath.Timer|18000"
    "worldserver.conf|Instance.IgnoreLevel|1"
    "worldserver.conf|Battleground.PlayerRespawn|60"
    "worldserver.conf|AllowTwoSide.Interaction.Group|1"
    "worldserver.conf|ChatStrictLinkChecking.Severity|-1"
    "worldserver.conf|QuestPOI.Enabled|0"                  # C038
    "worldserver.conf|Visibility.ObjectSparkles|0"         # C038
    "worldserver.conf|Corpse.Decay.NORMAL|36000"           # C037, decided 2026-10-20
    "worldserver.conf|Rate.Corpse.Decay.Looted|1"          # C037
    "worldserver.conf|vmap.BlizzlikePvPLOS|1"              # stock, the owner's choice
    "worldserver.conf|DBC.EnforceItemAttributes|1"         # stock, the owner's choice
    "worldserver.conf|PlayerLimit|1000"                    # stock: held for a decision (bots count)
    "worldserver.conf|Visibility.Distance.Continents|250"  # C037: the server's most (it clamps above), B056 capping bots (issue 194)
    "worldserver.conf|Visibility.Distance.Instances|250"   # C039, every profile
    "worldserver.conf|Visibility.Distance.BGArenas|250"    # C039
    "worldserver.conf|Rate.Damage.Fall|10.0"               # C004
    "worldserver.conf|Rate.MoveSpeed.Player|0.85"          # C003
    "worldserver.conf|InstantFlightPaths|1"                # C009
    "worldserver.conf|GM.LoginState|3"                     # C008
    "worldserver.conf|RealmID|2"                           # C019
    "worldserver.conf|WorldServerPort|4462"                # C010 (shared today; issue 136b)
    "authserver.conf|RealmServerPort|4362"                 # C010
    "modules/playerbots.conf|AiPlayerbot.RandomBotMinLevel|1"   # C012
    "modules/playerbots.conf|AiPlayerbot.RandomBotMaxLevel|20"  # C012
    "modules/playerbots.conf|AiPlayerbot.MinRandomBots|200"     # C035; the bots are ambushed too
    "modules/playerbots.conf|AiPlayerbot.MaxRandomBots|200"     # C035
)
# }}}

# {{{ scratch_setup
# RAM-backed scratch tier per the project convention (tmp/shared-memory).
SCRATCH_ROOT="${DIR}/tmp/shared-memory"
if [[ ! -d "${SCRATCH_ROOT}" ]]; then
    echo "ERROR: ${SCRATCH_ROOT} missing (the project's RAM scratch link)."
    echo "       to debug: does ${DIR}/tmp point at /tmp/<project>, and does"
    echo "       tmp/shared-memory point at /dev/shm/<project>?"
    exit 1
fi
SCRATCH="${SCRATCH_ROOT}/test-config-gates-${PROFILE}"
rm -rf "${SCRATCH}"
mkdir -p "${SCRATCH}/etc/modules"

# The stock files are gathered from the source tree into the layout an
# install gives them (etc/, etc/modules/), so everything below reads them
# as before: the server's two from their apps' folders, every module's
# from its conf/ folder.
DIST_SRC="${SCRATCH}/stock"
mkdir -p "${DIST_SRC}/modules"
WORLD_DIST="${SOURCE}/src/server/apps/worldserver/worldserver.conf.dist"
AUTH_DIST="${SOURCE}/src/server/apps/authserver/authserver.conf.dist"
BOTS_DIST="${SOURCE}/modules/mod-playerbots/conf/playerbots.conf.dist"
for f in "${WORLD_DIST}" "${AUTH_DIST}" "${BOTS_DIST}"; do
    if [[ ! -f "${f}" ]]; then
        echo "ERROR: no stock config at ${f}"
        echo "       to debug: is ${SOURCE} a cloned source tree with mod-playerbots in modules/?"
        echo "       From a separate checkout, name the main project's: --source <main project>/source-beta"
        exit 1
    fi
done
cp "${WORLD_DIST}" "${AUTH_DIST}" "${DIST_SRC}/"
cp "${SOURCE}"/modules/*/conf/*.conf.dist "${DIST_SRC}/modules/"
cp "${DIST_SRC}/worldserver.conf.dist"         "${SCRATCH}/etc/worldserver.conf"
cp "${DIST_SRC}/authserver.conf.dist"          "${SCRATCH}/etc/authserver.conf"
cp "${DIST_SRC}/modules/playerbots.conf.dist"  "${SCRATCH}/etc/modules/playerbots.conf"
echo "Stock configs from: ${SOURCE}"
echo "Scratch:            ${SCRATCH}"
# }}}

# {{{ run_patches
# The patch scripts read INSTALL_DIR, PROFILE, DIR and PROJECT_DIR.
export INSTALL_DIR="${SCRATCH}"
export PROJECT_DIR="${DIR}"
export PROFILE DIR
# The real runner, not a copy of it. This test once re-implemented the
# runner's loop in filename order while the runner itself went in
# alphabetical function-name order; the copy passed and the install still
# wrote StartHeroicPlayerLevel = 80 (C017 ran before C006d). Calling the
# runner itself means the order tested is the order installed.
source "${DIR}/patches/E-patches.sh" || { echo "ERROR: patches/E-patches.sh failed to source"; exit 1; }
failed=0
apply_config_values > "${SCRATCH}/apply-config-values.log" 2>&1 || failed=1
# Only the applying half of the runner's report; its listing of every
# patch by profile is noise here. A failed patch shows as [✗].
sed -n '/Applying for profile/,$p' "${SCRATCH}/apply-config-values.log"
# }}}

# {{{ check_expectations
# A profile name may hold a hyphen (cc-test); a shell variable name may not.
table_var="EXPECT_${PROFILE//-/_}"
table_name="${table_var}[@]"
if [[ -z "$(declare -p "${table_var}" 2>/dev/null)" ]]; then
    echo "ERROR: no expectation table ${table_var} in this script"
    exit 1
fi

pass=0
fail=0
for row in "${!table_name}"; do
    IFS='|' read -r file key want <<< "${row}"
    conf="${SCRATCH}/etc/${file}"
    key_re="${key//./\\.}"
    got=$(grep -E "^${key_re}[[:space:]]*=" "${conf}" | head -1 | sed 's|^[^=]*=[[:space:]]*||; s|[[:space:]]*$||; s|^"||; s|"$||')
    if [[ "${want}" == "__unset_or_0__" ]]; then
        # A key that must not be switched on for this profile.
        if [[ -z "${got}" || "${got}" == "0" ]]; then ok=1; else ok=0; fi
    elif [[ "${want}" == "__nonzero_uint32__" ]]; then
        # A computed value (C025's fingerprint): any number in 1..2^32-1.
        if [[ "${got}" =~ ^[0-9]+$ && "${got}" -gt 0 && "${got}" -le 4294967295 ]]; then ok=1; else ok=0; fi
    else
        [[ "${got}" == "${want}" ]] && ok=1 || ok=0
    fi
    if [[ "${ok}" -eq 1 ]]; then
        printf "  [✓] %-52s = %s\n" "${key}" "${got:-<unset>}"
        pass=$((pass + 1))
    else
        printf "  [✗] %-52s = %s   (expected %s, in %s)\n" "${key}" "${got:-<unset>}" "${want}" "${file}"
        fail=$((fail + 1))
    fi
done
echo "Expectations: ${pass} passed, ${fail} failed"
# }}}

# {{{ check_database_names
# The databases the servers are told to use (C001) must be the ones the
# install creates and seeds and the install steps write to
# (_profile_db_name in patches/E-helpers.sh). Two copies of one naming rule:
# until 2026-10-17 both said beta used release's databases, and nothing
# would have noticed one changing without the other.
db_fail=0
for pair in "worldserver.conf|WorldDatabaseInfo|acore_world" \
            "worldserver.conf|CharacterDatabaseInfo|acore_characters"; do
    IFS='|' read -r file key base <<< "${pair}"
    got=$(grep -E "^${key}[[:space:]]*=" "${SCRATCH}/etc/${file}" | head -1 | sed 's|.*;||; s|"[[:space:]]*$||')
    want="$(_profile_db_name "${base}")"
    if [[ "${got}" == "${want}" ]]; then
        printf "  [✓] %-52s names %s, as the install creates\n" "${key}" "${got}"
    else
        printf "  [✗] %-52s names %s, but the install creates %s (C001 and _profile_db_name disagree)\n" "${key}" "${got:-<unset>}" "${want}"
        db_fail=$((db_fail + 1))
    fi
done
# }}}

# {{{ check_keys_exist
# Every key any config patch edits (for any profile) must exist in the
# stock config files, or the patch's sed matches nothing and the setting
# silently stays at its default. Three patches had drifted this way
# (Rate.Run.Speed, Instant.Taxi, EquipmentPersistence) before this check
# existed. Keys are read out of the patches' own literal sed patterns;
# patches that build the key from a variable (C016's backfill list, which
# appends keys a stale .dist lacks) are not covered by this check.
# Only source-beta configs are checked here; alpha's older tree names some
# keys differently (see C003's per-profile key table).
missing=0
all_keys=$(grep -ohE "s\|\^[A-Za-z][A-Za-z0-9\\\.]*" "${DIR}"/config/patches/C*.sh \
    | sed 's/^s|^//; s/\\\././g; s/\.$//' | sort -u)
for key in ${all_keys}; do
    key_re="${key//./\\.}"
    if ! grep -qE "^${key_re}[[:space:]]*=" "${DIST_SRC}"/worldserver.conf.dist "${DIST_SRC}"/authserver.conf.dist "${DIST_SRC}"/modules/*.conf.dist; then
        echo "  [✗] a config patch edits '${key}', which no stock .conf.dist contains"
        missing=$((missing + 1))
    fi
done
echo "Edited keys missing from stock configs: ${missing}"
# }}}

[[ "${failed}" -eq 0 && "${fail}" -eq 0 && "${missing}" -eq 0 && "${db_fail}" -eq 0 ]]
