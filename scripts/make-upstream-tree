#!/bin/bash
# make-upstream-tree - a clean copy of the server's source, at chosen
# commits, in RAM, for trying the source patches before a pin moves
#
# For a general audience: the project holds the game server's source, and
# each module's, at fixed versions ("pins"), and changes them with small
# reversible patches at build time. Before moving a pin to a newer upstream
# version, each patch has to be tried on that version: does it still apply,
# and is it still needed. This builds such a version beside the real one,
# from the history the real source folders already downloaded, so the real
# folders (which a build may be using) are never touched.
#
# How: the core and each pinned module are written out of their git history
# at the asked commit (git archive: the files of that commit, nothing
# else). Modules the project does not pin (mod-solo-lfg, mod-aoe-loot,
# mod-fireworks-on-level) are cloned once into a cache beside the trees and
# copied in at their newest commit, as an install would.
#
# Usage: scripts/make-upstream-tree [PROJECT_DIR] NAME CORE PLAYERBOTS ALE
#   NAME        the tree's folder name under tmp/shared-memory/upstream-trees/
#   CORE        a commit of source-beta (e.g. 52f58186a533, origin/Playerbot)
#   PLAYERBOTS  a commit of modules/mod-playerbots
#   ALE         a commit of modules/mod-ale
# Prints the tree's path last. Run `git fetch` in the real folders first to
# see newer upstream commits.

set -o pipefail

DIR="/mnt/kaun/wow-chat-2026"
if [[ $# -eq 5 ]]; then DIR="$1"; shift; fi
[[ $# -eq 4 ]] || { echo "usage: $0 [PROJECT_DIR] NAME CORE PLAYERBOTS ALE"; exit 1; }
NAME="$1" CORE="$2" BOTS="$3" ALE="$4"

SRC="${DIR}/source-beta"
ROOT="${DIR}/tmp/shared-memory/upstream-trees"
TREE="${ROOT}/${NAME}"
CACHE="${ROOT}/module-cache"
UNPINNED=(
    "mod-solo-lfg https://github.com/azerothcore/mod-solo-lfg.git"
    "mod-aoe-loot https://github.com/azerothcore/mod-aoe-loot.git"
    "mod-fireworks-on-level https://github.com/azerothcore/mod-fireworks-on-level.git"
)

[[ -d "${DIR}/tmp/shared-memory" ]] || { echo "ERROR: ${DIR}/tmp/shared-memory missing (the RAM scratch link)"; exit 1; }

# {{{ export_commit
# Writes the files of one commit of a repository into a folder.
export_commit() {
    local repo="$1" rev="$2" dest="$3"
    git -C "${repo}" rev-parse --verify --quiet "${rev}^{commit}" > /dev/null \
        || { echo "ERROR: ${repo} has no commit ${rev} (fetched?)"; return 1; }
    mkdir -p "${dest}"
    git -C "${repo}" archive "${rev}" | tar -x -C "${dest}" \
        || { echo "ERROR: writing ${repo} at ${rev} into ${dest} failed"; return 1; }
    echo "  ${repo#${DIR}/} at $(git -C "${repo}" log -1 --format='%h (%cs)' "${rev}")"
}
# }}}

rm -rf "${TREE}"
echo "Building ${TREE}"
export_commit "${SRC}" "${CORE}" "${TREE}" || exit 1
export_commit "${SRC}/modules/mod-playerbots" "${BOTS}" "${TREE}/modules/mod-playerbots" || exit 1
export_commit "${SRC}/modules/mod-ale" "${ALE}" "${TREE}/modules/mod-ale" || exit 1

mkdir -p "${CACHE}"
for entry in "${UNPINNED[@]}"; do
    read -r mod url <<< "${entry}"
    # a cached clone from another address (the loot module's fork, before
    # 2026-10-09) is cloned again from the right one
    if [[ -d "${CACHE}/${mod}/.git" && "$(git -C "${CACHE}/${mod}" remote get-url origin)" != "${url}" ]]; then
        rm -rf "${CACHE:?}/${mod}"
    fi
    if [[ -d "${CACHE}/${mod}/.git" ]]; then
        git -C "${CACHE}/${mod}" pull --quiet --ff-only || { echo "ERROR: updating ${mod} failed"; exit 1; }
    else
        git clone --quiet "${url}" "${CACHE}/${mod}" || { echo "ERROR: cloning ${mod} failed"; exit 1; }
    fi
    export_commit "${CACHE}/${mod}" HEAD "${TREE}/modules/${mod}" || exit 1
done

echo "${TREE}"
