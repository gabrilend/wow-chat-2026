#!/usr/bin/env luajit
-- ==== header: 8 lines, footer: 3 lines ====
-- id:         test-talent-builds
-- profiles:   all
-- priority:   10
-- kind:       test
-- about:      every named talent build is met at 60 by the spender, within the server's rules, and impossible builds are refused
-- quick-test: yes
-- ==== end of header ====
-- test-talent-builds - checks the named talent builds and the spender's
-- way of meeting them (issue 635b).
--
-- For a general audience: a build says "favour these trees, but max these
-- talents whatever they cost". This test spends a level-60 character's
-- points on every build in src/lua-basic/data/talent-builds.lua, point by
-- point, many times with different dice, and checks each point with its
-- own referee (the server's learn-a-talent rules: the row open, the
-- prerequisite held, one rank at a time, basic's cap): that every required
-- talent ends maxed, nothing forbidden is taken, and no point is left. It
-- also checks the refusals: a build whose talents cost more points than
-- the character has, a misspelled talent, a talent past basic's cap, and
-- a talent both required and forbidden must each stop with an error.
--
-- Usage: scripts/test-talent-builds [PROJECT_DIR]

-- {{{ configuration
local DIR     = arg[1] or "/mnt/kaun/wow-chat-2026"
local DATA    = dofile(DIR .. "/src/lua-basic/data/buddy-talent-data.lua")
local Spender = dofile(DIR .. "/src/lua-basic/lib/buddy-talent-spender.lua")
local BUILDS  = dofile(DIR .. "/src/lua-basic/data/talent-builds.lua")
local POINTS  = 51          -- talent points at 60 on basic
local SEEDS   = 200         -- dice per build
local checks, failed = 0, 0
-- }}}

-- {{{ local function check(ok, what)
local function check(ok, what)
    checks = checks + 1
    if not ok then failed = failed + 1; print("FAIL " .. what) end
end
-- }}}

-- {{{ local function dice(seed)
-- The same generator the other talent tests use, so a failing seed can be
-- replayed: s = (s * 1103515245 + 12345) mod 2^31.
local function dice(seed)
    local s = seed
    return function(n)
        s = (s * 1103515245 + 12345) % 2147483648
        return math.floor(s / 2147483648 * n) + 1
    end
end
-- }}}

-- {{{ local function referee(cls, held, step, past_cap)
-- The server's rules for one point, written apart from the spender.
local function referee(cls, held, step, past_cap)
    for t, tree in ipairs(cls.trees) do
        for _, tal in ipairs(tree.talents) do
            if tal.id == step.id then
                local spent = 0
                for _, o in ipairs(tree.talents) do spent = spent + (held[o.id] or 0) end
                if not (tal.allowed or past_cap)            then return "shut by basic's cap" end
                if spent < tal.row * 5                      then return "row not open" end
                if (held[tal.id] or 0) ~= step.rank         then return "not one rank above what is held" end
                if step.rank >= tal.ranks                   then return "past its last rank" end
                if tal.dep ~= 0 and (held[tal.dep] or 0) < tal.dep_points then return "prerequisite not held" end
                if t ~= step.tree                           then return "wrong tree" end
                return nil, tal
            end
        end
    end
    return "no such talent"
end
-- }}}

-- {{{ every build, many dice
for _, build in ipairs(BUILDS) do
    local cls = DATA.classes[build.class]
    check(cls ~= nil, build.name .. ": class " .. tostring(build.class) .. " exists")
    local cost = Spender.build_cost(cls, build)
    check(cost <= POINTS, ("%s: its required talents cost %d of %d points"):format(build.name, cost, POINTS))
    local forbid = {}
    for _, n in ipairs(build.forbidden or {}) do forbid[n] = true end
    local worst
    for seed = 1, SEEDS do
        local steps, unspent, missing = Spender.plan_build(cls, build, {}, POINTS, dice(seed))
        local held, bad = {}, nil
        for _, st in ipairs(steps) do
            local why, tal = referee(cls, held, st, build.past_cap)
            if why then bad = st.name .. ": " .. why; break end
            if forbid[tal.name] then bad = st.name .. ": forbidden"; break end
            held[st.id] = (held[st.id] or 0) + 1
        end
        if bad or unspent ~= 0 or #missing > 0 then
            worst = ("%s seed %d: %s"):format(build.name, seed,
                bad or (unspent ~= 0 and (unspent .. " points unspent")) or ("not maxed: " .. table.concat(missing, ", ")))
            break
        end
    end
    check(worst == nil, worst or (build.name .. ": all good"))
    if not worst then
        local steps = Spender.plan_build(cls, build, {}, POINTS, dice(1))
        local per = { 0, 0, 0 }
        for _, st in ipairs(steps) do per[st.tree] = per[st.tree] + 1 end
        print(("ok   %-30s %2d/%2d/%2d points (required cost %2d)"):format(build.name, per[1], per[2], per[3], cost))
    end
end
-- }}}

-- {{{ the refusals
local druid = DATA.classes[11]
local function refuses(build, points, pattern, what)
    local ok, err = pcall(Spender.plan_build, druid, build, {}, points, dice(1))
    check(not ok and tostring(err):find(pattern) ~= nil, what .. " (got: " .. tostring(err) .. ")")
end
refuses({ name = "short", thirds = { 0, 0, 3 }, required = { "Gift of Nature" } }, 10,
        "short%)", "a build costing more points than the character has is refused")
refuses({ name = "misspelt", thirds = { 0, 0, 3 }, required = { "Gift of Nurture" } }, 51,
        "has no talent named", "a misspelled talent is refused")
refuses({ name = "deep", thirds = { 0, 0, 3 }, required = { "Tree of Life" } }, 51,
        "basic's talent cap", "a talent past basic's cap is refused")
refuses({ name = "both", thirds = { 0, 0, 3 }, required = { "Swiftmend" }, forbidden = { "Swiftmend" } }, 51,
        "both required and forbidden", "a talent both required and forbidden is refused")
-- }}}

print(("%d checks, %d failed"):format(checks, failed))
os.exit(failed == 0 and 0 or 1)
-- ==== footer of test-talent-builds ====
-- lines:      131
-- ==== end of footer ====
