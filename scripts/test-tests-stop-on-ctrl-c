#!/bin/bash

DIR="${1:-/mnt/kaun/wow-chat-2026}"
RUNNER="${DIR}/scripts/run-tests-in-parallel"
SCRATCH="${DIR}/tmp/tmp/test-tests-stop-on-ctrl-c"

MARKER_SLEEP="299.1990$$"

FAILURES=0

make_pretend_project() {
    rm -rf "${SCRATCH}"
    mkdir -p "${SCRATCH}/project/scripts" "${SCRATCH}/logs" || exit 1

    printf '#!/bin/bash\nexit 0\n' > "${SCRATCH}/project/scripts/quick-one"

    printf '#!/bin/bash\nsleep %s\n' "${MARKER_SLEEP}" > "${SCRATCH}/project/scripts/slow-one"

    printf '#!/bin/bash\nbash -c "sleep %s; true"\n' "${MARKER_SLEEP}" > "${SCRATCH}/project/scripts/slow-two"

    chmod +x "${SCRATCH}/project/scripts/"*
}

check_one_signal() {
    local signal="$1"
    make_pretend_project

    env --default-signal=INT "${RUNNER}" "${SCRATCH}/project" "${SCRATCH}/logs" \
        quick-one slow-one slow-two > "${SCRATCH}/runner.out" 2>&1 &
    local runner_pid=$!

    local tries=0
    local running=0
    while [[ ${tries} -lt 100 ]]; do
        running="$(pgrep -c -f "^sleep ${MARKER_SLEEP}")"   # the programs themselves, not the shell that started one
        [[ -f "${SCRATCH}/logs/quick-one.done" && "${running}" -ge 2 ]] && break
        sleep 0.1
        tries=$((tries + 1))
    done
    if [[ ${tries} -ge 100 ]]; then
        echo "FAIL (${signal}): the pretend tests never got going (quick-one done: $([[ -f "${SCRATCH}/logs/quick-one.done" ]] && echo yes || echo no), long programs running: ${running})"
        kill -TERM "${runner_pid}"
        pkill -f "sleep ${MARKER_SLEEP}"
        FAILURES=$((FAILURES + 1))
        return
    fi

    kill "-${signal}" "${runner_pid}"
    wait "${runner_pid}"
    local status=$?

    sleep 0.5
    local survivors
    survivors="$(pgrep -c -f "sleep ${MARKER_SLEEP}")"

    if [[ "${survivors}" -ne 0 ]]; then
        echo "FAIL (${signal}): ${survivors} of the pretend tests' programs still running after the runner exited"
        pkill -f "sleep ${MARKER_SLEEP}"
        FAILURES=$((FAILURES + 1))
    else
        echo "ok   (${signal}): nothing the pretend tests started is left running"
    fi

    if [[ ${status} -ne 130 ]]; then
        echo "FAIL (${signal}): the runner exited ${status}, not 130 (interrupted)"
        FAILURES=$((FAILURES + 1))
    else
        echo "ok   (${signal}): the runner says it was interrupted (130)"
    fi

    if [[ ! -f "${SCRATCH}/logs/quick-one.ok" ]]; then
        echo "FAIL (${signal}): the test that finished before the interrupt lost its pass mark"
        FAILURES=$((FAILURES + 1))
    else
        echo "ok   (${signal}): the finished test still counts as passed"
    fi

    if ! grep -q "slow-one" "${SCRATCH}/runner.out" || grep -q "quick-one" "${SCRATCH}/runner.out"; then
        echo "FAIL (${signal}): the runner's list of unfinished tests is wrong:"
        sed 's/^/      /' "${SCRATCH}/runner.out"
        FAILURES=$((FAILURES + 1))
    else
        echo "ok   (${signal}): the runner names the unfinished tests, and only those"
    fi
}

check_one_signal INT
check_one_signal TERM

rm -rf "${SCRATCH}"
if [[ ${FAILURES} -gt 0 ]]; then
    echo "${FAILURES} check(s) failed"
    exit 1
fi
echo "all checks passed"
