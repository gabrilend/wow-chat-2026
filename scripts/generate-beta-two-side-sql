#!/usr/bin/env luajit

local DIR = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end
local OUT = (arg[2] and arg[2] ~= "" and arg[2]:gsub("/*$", "/")) or (DIR .. "/sql/beta/db_auth.src/")

local PERMISSIONS = {
    { step = "E062", stem = "01-two-side-trade",   id = 51, name = "RBAC_PERM_ALLOW_TWO_SIDE_TRADE",
      what = "trade with a player of the other faction" },
    { step = "E063", stem = "02-two-side-mail",    id = 27, name = "RBAC_PERM_TWO_SIDE_INTERACTION_MAIL",
      what = "send mail to a player of the other faction" },
    { step = "E064", stem = "03-two-side-who",     id = 28, name = "RBAC_PERM_TWO_SIDE_WHO_LIST",
      what = "see players of the other faction in the /who list" },
    { step = "E065", stem = "04-two-side-friends", id = 29, name = "RBAC_PERM_TWO_SIDE_ADD_FRIEND",
      what = "add a player of the other faction as a friend" },
}
local LEVELS = { 0, 1, 2, 3 }

local function slurp(p) local f = io.open(p, "r"); if not f then return nil end local s = f:read("*a"); f:close(); return s end
local c019 = slurp(DIR .. "/config/patches/C019-realm-id.sh")
if not c019 then error("generate-beta-two-side-sql: config/patches/C019-realm-id.sh is missing; it sets the realm numbers") end
local REALM = tonumber(c019:match("\n%s*beta%)%s*REALM_ID=(%d+)"))
if not REALM then error("generate-beta-two-side-sql: no 'beta) REALM_ID=<n>' line in C019; did its table change shape?") end

local rbac = slurp(DIR .. "/source-beta/src/server/game/Accounts/RBAC.h")
if not rbac then error("generate-beta-two-side-sql: no source-beta/src/server/game/Accounts/RBAC.h to check the numbers against") end
for _, p in ipairs(PERMISSIONS) do
    local n = tonumber(rbac:match(p.name .. "%s*=%s*(%d+)"))
    if n ~= p.id then
        error(string.format("generate-beta-two-side-sql: %s is %s in RBAC.h, not %d; upstream renumbered it", p.name, tostring(n), p.id))
    end
end

os.execute("mkdir -p '" .. OUT .. "'")
for _, p in ipairs(PERMISSIONS) do
    local rows = {}
    for _, lv in ipairs(LEVELS) do rows[#rows + 1] = string.format("(%d, %d, %d)", lv, p.id, REALM) end
    local head = table.concat({
        "-- ============================================================================",
        "-- " .. p.stem .. ".sql (issue 193: beta's two factions together) — %s SOURCE",
        "-- ============================================================================",
        "-- Generated by scripts/generate-beta-two-side-sql; edit that, not this.",
        "-- Lets every account on beta's realm (" .. REALM .. ", from C019) " .. p.what .. ":",
        "-- permission " .. p.id .. " (" .. p.name .. ") for each account level",
        "-- (0 player, 1 moderator, 2 game master, 3 administrator). The accounts",
        "-- database is shared by every realm; the realm number keeps it beta's.",
        "-- The owner, 2026-10-20: \"make sure it's one for each of cross-faction",
        "-- trade, mail, /who, and friends\" and \"for beta can we turn them on for",
        "-- everyone via sql or something, and keep them isolated to the servers that",
        "-- have them enabled for everyone\". Database: acore_auth. Applied by " .. p.step .. ".",
        "-- ============================================================================",
    }, "\n")
    local apply = "-- MARKER_" .. p.step .. "_APPLY beta-" .. p.stem:gsub("^%d+%-", "") .. "\n" ..
        head:format("APPLY") .. "\n\n" ..
        "INSERT IGNORE INTO `rbac_default_permissions` (`secId`, `permissionId`, `realmId`) VALUES\n    " ..
        table.concat(rows, ",\n    ") .. ";\n"
    local revert = "-- MARKER_" .. p.step .. "_REVERT beta-" .. p.stem:gsub("^%d+%-", "") .. "\n" ..
        head:format("REVERT") .. "\n\n" ..
        string.format("DELETE FROM `rbac_default_permissions` WHERE `permissionId` = %d AND `realmId` = %d;\n", p.id, REALM)
    for kind, text in pairs({ apply = apply, revert = revert }) do
        local path = OUT .. p.stem .. "." .. kind .. ".sql"
        local f = assert(io.open(path, "w")); f:write(text); f:close()
        print("wrote " .. path)
    end
end
