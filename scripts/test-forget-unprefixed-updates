#!/bin/bash
# test-forget-unprefixed-updates - checks the install step that tidies the
# update records left under their old names by issue 183's renaming.
#
# For a general audience: the database remembers every update file it has
# applied, by name. Since issue 183 our files are applied under a "z_" name
# (z_04-buddy-roster.sql), and the old name's record stayed behind, so the
# server warned at every start that a file it had applied was missing. The
# install step now forgets those old records, but only for our own files,
# and only where the z_ record is there to take their place. This gives the
# real step a pretend database table and folder and checks it removes
# exactly the right records, and nothing on a second run.
#
# Usage: scripts/test-forget-unprefixed-updates [PROJECT_DIR]
# Needs the project's MySQL (it works in the _smoke_test database).
# Exit status: 0 when every check passes, 1 otherwise.

DIR="/mnt/kaun/wow-chat-2026"
if [[ -n "$1" ]]; then
    DIR="$1"
fi
MYSQL="${DIR}/mysql/installed-files/bin/mysql --no-defaults --socket=${DIR}/mysql/databases/mysql.sock -uritz -pmenardi -N _smoke_test"

source /home/ritz/programming/ai-stuff/scripts/libs/ensure-ram-tiers
ensure_ram_tiers "${DIR}" || exit 1
WORK="$(mktemp -d "${DIR}/tmp/shared-memory/forget-updates-test.XXXXXX")"
TABLE_MADE=false
cleanup() { rm -rf "${WORK}"; [[ "${TABLE_MADE}" == "true" ]] && ${MYSQL} -e "DROP TABLE IF EXISTS updates" 2>/dev/null; }
trap cleanup EXIT

# the step under test, lifted out of patches/E-patches.sh as it is
eval "$(sed -n '/^_forget_unprefixed_updates() {/,/^}/p' "${DIR}/patches/E-patches.sh")"
declare -F _forget_unprefixed_updates > /dev/null || { echo "FAIL: _forget_unprefixed_updates not found in patches/E-patches.sh"; exit 1; }

if ${MYSQL} -e "SHOW TABLES LIKE 'updates'" 2>/dev/null | grep -q .; then
    echo "FAIL: _smoke_test already has an updates table; not touching it"; exit 1
fi
${MYSQL} -e "CREATE TABLE updates (name VARCHAR(200) PRIMARY KEY, hash CHAR(40), state VARCHAR(20), timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP, speed INT DEFAULT 0)" 2>/dev/null ||
    { echo "FAIL: could not make a scratch table in _smoke_test (is the project's MySQL running?)"; exit 1; }
TABLE_MADE=true

# our folder holds a.sql and b.sql; the records:
#   a.sql + z_a.sql   the leftover: a.sql must go, z_a.sql stay
#   b.sql alone       not yet applied under its z_ name: must stay
#   c.sql + z_c.sql   not our file (not in the folder): both stay
#   2026_01_01_00_world.sql  upstream's: stays
mkdir -p "${WORK}/staging"
touch "${WORK}/staging/a.sql" "${WORK}/staging/b.sql"
${MYSQL} -e "INSERT INTO updates (name, hash, state) VALUES ('a.sql','h','CUSTOM'), ('z_a.sql','h','CUSTOM'), ('b.sql','h','CUSTOM'), ('c.sql','h','CUSTOM'), ('z_c.sql','h','CUSTOM'), ('2026_01_01_00_world.sql','h','RELEASED')" 2>/dev/null

FAILS=0
check() { if [[ "$2" == "$3" ]]; then echo "  ok    $1"; else FAILS=$((FAILS + 1)); echo "  FAIL  $1: got '$2', wanted '$3'"; fi; }
names() { ${MYSQL} -e "SELECT GROUP_CONCAT(name ORDER BY name) FROM updates" 2>/dev/null; }

echo "test-forget-unprefixed-updates"
out="$(_forget_unprefixed_updates "${WORK}/staging" _smoke_test)"
check "the leftover's old name is forgotten, everything else kept" "$(names)" "2026_01_01_00_world.sql,b.sql,c.sql,z_a.sql,z_c.sql"
check "it says how many it forgot" "$(grep -o '[0-9]* old update name' <<< "${out}")" "1 old update name"
out="$(_forget_unprefixed_updates "${WORK}/staging" _smoke_test)"
check "a second run changes nothing and says nothing" "$(names)|${out}" "2026_01_01_00_world.sql,b.sql,c.sql,z_a.sql,z_c.sql|"

echo "$(( FAILS == 0 ? 3 : 3 - FAILS )) of 3 checks passed"
exit $(( FAILS > 0 ))
