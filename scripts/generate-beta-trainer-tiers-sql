#!/usr/bin/env luajit

local DIR = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end

local COPY_BASE = 5030000
local COPY_LAST = 5039999
local SNAPSHOT  = "wow_chat_e014_snapshot_creature_default_trainer"
local OLD_SNAP  = "wow_chat_e014_snapshot_npc_trainer"

local rows = dofile(DIR .. "/src/lua-beta/data/travel-trainers.lua")

local function check_rows()
    local seen, problems = {}, {}
    for i, r in ipairs(rows) do
        local where = "row " .. i .. " (creature " .. tostring(r.trainerID) .. ")"
        if type(r.trainerID) ~= "number" or type(r.minLevel) ~= "number" or type(r.maxLevel) ~= "number" or type(r.id) ~= "number" then
            problems[#problems + 1] = where .. ": a field is missing or not a number"
        elseif r.id > -1 or r.id < -11 or r.id == -10 then
            problems[#problems + 1] = where .. ": class " .. r.id .. " is not a class (-1..-9, -11; the game has no class 10)"
        elseif r.minLevel < 1 or r.maxLevel > 20 or r.minLevel > r.maxLevel then
            problems[#problems + 1] = where .. ": slice " .. r.minLevel .. "-" .. r.maxLevel .. " is not inside 1-20"
        elseif seen[r.trainerID] then
            problems[#problems + 1] = where .. ": the same creature is also row " .. seen[r.trainerID]
        end
        seen[r.trainerID] = seen[r.trainerID] or i
    end
    return problems
end

local problems = check_rows()
if #problems > 0 then
    io.stderr:write("ERROR: data/travel-trainers.lua has " .. #problems .. " problem(s); nothing written:\n")
    for _, p in ipairs(problems) do io.stderr:write("  " .. p .. "\n") end
    os.exit(1)
end

local capped = {}
for _, r in ipairs(rows) do
    if r.id ~= -6 then capped[#capped + 1] = r end
end
local ids = {}
for i, r in ipairs(capped) do ids[i] = tostring(r.trainerID) end
local idList = table.concat(ids, ", ")

local HEADER = [[
-- Generated by scripts/generate-beta-trainer-tiers-sql from
-- src/lua-beta/data/travel-trainers.lua; edit those, not this file, and
-- run the generator again. Issue 503 (dynamic trainer spawning), 721.
]]

local apply = {}
local function add(t, s) t[#t + 1] = s end
add(apply, "-- MARKER_E014_APPLY beta-trainer-spell-level-cap")
add(apply, HEADER)
add(apply, [[
-- Each travelling class trainer gets its own copy of its class's lessons,
-- cut off at the top of its level slice, and is pointed at the copy.
-- Re-running is safe: the copies are taken from the saved original links,
-- and every insert skips rows already there.

-- {{{ put back what the old (npc_trainer) form of this step deleted
-- The old form saved npc_trainer before deleting from it. If that copy
-- exists, restore from it and drop it; if not, the CREATE makes an empty
-- one and the restore adds nothing. (npc_trainer is no longer read by
-- the server; this only leaves the table as upstream shipped it.)
CREATE TABLE IF NOT EXISTS `]] .. OLD_SNAP .. [[` LIKE `npc_trainer`;
INSERT IGNORE INTO `npc_trainer` SELECT * FROM `]] .. OLD_SNAP .. [[`;
DROP TABLE `]] .. OLD_SNAP .. [[`;
-- }}}

-- {{{ save each trainer's original link, once
CREATE TABLE IF NOT EXISTS `]] .. SNAPSHOT .. [[` LIKE `creature_default_trainer`;
INSERT IGNORE INTO `]] .. SNAPSHOT .. [[`
    SELECT * FROM `creature_default_trainer` WHERE `CreatureId` IN (]] .. idList .. [[);
-- }}}
]])
local CLASS_NAME = { [-1] = "warrior", [-2] = "paladin", [-3] = "hunter", [-4] = "rogue", [-5] = "priest",
                     [-7] = "shaman", [-8] = "mage", [-9] = "warlock", [-11] = "druid" }
local FACTION = { [1] = "horde", [2] = "alliance", [3] = "either" }
assert(#capped <= COPY_LAST - COPY_BASE, "more trainers than issue 503's block holds")
for n, r in ipairs(capped) do
    local copy = COPY_BASE + n
    add(apply, string.format("-- {{{ creature %d: %s %s trainer, levels %d-%d", r.trainerID,
        FACTION[r.rel] or "?", CLASS_NAME[r.id], r.minLevel, r.maxLevel))
    add(apply, string.format([[
INSERT IGNORE INTO `trainer` (`Id`, `Type`, `Requirement`, `Greeting`, `VerifiedBuild`)
    SELECT %d, t.`Type`, t.`Requirement`, t.`Greeting`, t.`VerifiedBuild`
    FROM `%s` s JOIN `trainer` t ON t.`Id` = s.`TrainerId` WHERE s.`CreatureId` = %d;
INSERT IGNORE INTO `trainer_spell` (`TrainerId`, `SpellId`, `MoneyCost`, `ReqSkillLine`, `ReqSkillRank`, `ReqAbility1`, `ReqAbility2`, `ReqAbility3`, `ReqLevel`, `VerifiedBuild`)
    SELECT %d, ts.`SpellId`, ts.`MoneyCost`, ts.`ReqSkillLine`, ts.`ReqSkillRank`, ts.`ReqAbility1`, ts.`ReqAbility2`, ts.`ReqAbility3`, ts.`ReqLevel`, ts.`VerifiedBuild`
    FROM `%s` s JOIN `trainer_spell` ts ON ts.`TrainerId` = s.`TrainerId` WHERE s.`CreatureId` = %d AND ts.`ReqLevel` <= %d;
UPDATE `creature_default_trainer` SET `TrainerId` = %d WHERE `CreatureId` = %d;
-- }}}]], copy, SNAPSHOT, r.trainerID, copy, SNAPSHOT, r.trainerID, r.maxLevel, copy, r.trainerID))
end

local revert = {}
add(revert, "-- MARKER_E014_REVERT beta-trainer-spell-level-cap")
add(revert, HEADER)
add(revert, string.format([[
-- Point every trainer back at the list it had before the apply, then
-- remove the copies (only the copies' own number range is touched) and
-- the saved links. Safe when the apply never ran: the CREATE makes an
-- empty saved-links table, and nothing matches.
CREATE TABLE IF NOT EXISTS `%s` LIKE `creature_default_trainer`;
UPDATE `creature_default_trainer` d JOIN `%s` s ON s.`CreatureId` = d.`CreatureId`
    SET d.`TrainerId` = s.`TrainerId`;
DELETE FROM `trainer_spell` WHERE `TrainerId` BETWEEN %d AND %d;
DELETE FROM `trainer`       WHERE `Id`        BETWEEN %d AND %d;
DROP TABLE `%s`;]], SNAPSHOT, SNAPSHOT, COPY_BASE + 1, COPY_LAST, COPY_BASE + 1, COPY_LAST, SNAPSHOT))

local out = DIR .. "/sql/beta/db_world.src/14-trainer-spell-level-cap"
local function write(path, lines)
    local f = assert(io.open(path, "w"))
    f:write(table.concat(lines, "\n"), "\n")
    f:close()
end
write(out .. ".apply.sql", apply)
write(out .. ".revert.sql", revert)
print(string.format("wrote %s.apply.sql and .revert.sql: %d trainers capped (%d death knight trainers left whole)",
    out:sub(#DIR + 2), #capped, #rows - #capped))
