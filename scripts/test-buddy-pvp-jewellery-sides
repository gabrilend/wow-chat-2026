#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-pvp-jewellery-sides
# profiles:   all
# priority:   10
# kind:       test
# about:      a buddy's PvP necklace, rings and trinkets are its own side's, and each side has a full set at its levels
# quick-test: yes
# ==== end of header ====
# test-buddy-pvp-jewellery-sides - checks that a buddy is only offered the
# PvP necklace, rings and trinkets its own side may wear, and that each
# side has enough of them.
#
# For a general audience: from level 18 a buddy wears the best
# player-versus-player necklace, two rings and two trinkets of its level
# (buddies_kit.cpp). Many of those items allow every race and instead say
# in a flag which side may wear them: the Stormpike pendants are the
# Alliance's, the Frostwolf ones the Horde's. Until 2026-10-26 the picker
# looked only at races, chose Alliance pendants and rings for Horde buddies,
# and the server refused them, so Feldowinn's five paladins wore no
# necklace and one ring. This checks two things:
#   - the picker's code tests both side flags (ITEM_FLAG2_FACTION_HORDE,
#     ITEM_FLAG2_FACTION_ALLIANCE) as the server's equip check does;
#   - in the world database, for each side, at every level the jewellery
#     is given from (18 and each ten after, to 80), the items the picker
#     may choose from hold at least one necklace, two rings and two
#     trinkets the side may wear (the picker's own conditions: sold for
#     honor or arena points, no old honor rank, at or below the level).
#
# Usage: scripts/test-buddy-pvp-jewellery-sides [PROJECT_DIR]
# Exit status: 0 when every check passes, 1 otherwise.

DIR="${1:-/mnt/kaun/wow-chat-2026}"
KIT="${DIR}/patches/B036-mod-buddies/mod-buddies/src/buddies_kit.cpp"
WORLD="acore_world_$(cat "${DIR}/.profile")"
MYSQL="${DIR}/mysql/installed-files/bin/mysql"
FAILS=0
CHECKS=0

# {{{ check
check() {
    CHECKS=$((CHECKS + 1))
    if eval "$2"; then :; else echo "  FAIL: $1"; FAILS=$((FAILS + 1)); fi
}
# }}}

# {{{ the picker's code
PICKER="$(sed -n '/^std::string BuddyGivePvpJewellery/,/^}/p' "${KIT}")"
check "the jewellery picker is in buddies_kit.cpp" '[[ -n "${PICKER}" ]]'
check "it leaves out items only the Horde may wear, for others"    'grep -q "ITEM_FLAG2_FACTION_HORDE" <<< "${PICKER}"'
check "it leaves out items only the Alliance may wear, for others" 'grep -q "ITEM_FLAG2_FACTION_ALLIANCE" <<< "${PICKER}"'
# }}}

# {{{ the world database: a full set for each side at each level
# Item extended costs live in the client's data (ItemExtendedCost.dbc), not
# the database, so "bought with honor or arena points" is read as the
# vendor's extended cost being set (the picker's first test); the count is
# by inventory type: 2 neck, 11 finger, 12 trinket. FlagsExtra holds the
# side flags (1 Horde only, 2 Alliance only).
#   side  the flag of the OTHER side, whose items it may not wear
count() {
    local level=$1 other_flag=$2 type=$3
    "${MYSQL}" "--defaults-file=${DIR}/mysql/conf/client.cnf" --socket="${DIR}/mysql/databases/mysql.sock" -N -B "${WORLD}" -e "
        SELECT COUNT(DISTINCT it.entry) FROM item_template it JOIN npc_vendor v ON v.item = it.entry
        WHERE it.InventoryType = ${type} AND v.ExtendedCost > 0 AND it.RequiredLevel <= ${level}
          AND it.RequiredHonorRank = 0 AND (it.FlagsExtra & ${other_flag}) = 0" 2>&1 | grep -v "Using a password"
}
for level in 18 28 38 48 58 68 78 80; do
    for side in "Horde 2" "Alliance 1"; do
        name="${side% *}"; other="${side#* }"
        neck="$(count "${level}" "${other}" 2)"
        rings="$(count "${level}" "${other}" 11)"
        trinkets="$(count "${level}" "${other}" 12)"
        check "${name} at ${level}: a necklace it may wear (found ${neck})"   '[[ "${neck}" =~ ^[0-9]+$ && ${neck} -ge 1 ]]'
        check "${name} at ${level}: two rings it may wear (found ${rings})"   '[[ "${rings}" =~ ^[0-9]+$ && ${rings} -ge 2 ]]'
        check "${name} at ${level}: two trinkets it may wear (found ${trinkets})" '[[ "${trinkets}" =~ ^[0-9]+$ && ${trinkets} -ge 2 ]]'
    done
done
# }}}

if [[ ${FAILS} -eq 0 ]]; then echo "test-buddy-pvp-jewellery-sides: all ${CHECKS} checks passed"; exit 0; fi
echo "test-buddy-pvp-jewellery-sides: ${FAILS} of ${CHECKS} checks failed"
exit 1
# ==== footer of test-buddy-pvp-jewellery-sides ====
# lines:     86
# ==== end of footer ====
