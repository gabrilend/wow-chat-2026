#!/bin/bash

DIR="${1:-/mnt/kaun/wow-chat-2026}"
KIT="${DIR}/patches/B036-mod-buddies/mod-buddies/src/buddies_kit.cpp"
WORLD="acore_world_$(cat "${DIR}/.profile")"
MYSQL="${DIR}/mysql/installed-files/bin/mysql"
FAILS=0
CHECKS=0

check() {
    CHECKS=$((CHECKS + 1))
    if eval "$2"; then :; else echo "  FAIL: $1"; FAILS=$((FAILS + 1)); fi
}

PICKER="$(sed -n '/^std::string BuddyGivePvpJewellery/,/^}/p' "${KIT}")"
check "the jewellery picker is in buddies_kit.cpp" '[[ -n "${PICKER}" ]]'
check "it leaves out items only the Horde may wear, for others"    'grep -q "ITEM_FLAG2_FACTION_HORDE" <<< "${PICKER}"'
check "it leaves out items only the Alliance may wear, for others" 'grep -q "ITEM_FLAG2_FACTION_ALLIANCE" <<< "${PICKER}"'

count() {
    local level=$1 other_flag=$2 type=$3
    "${MYSQL}" "--defaults-file=${DIR}/mysql/conf/client.cnf" --socket="${DIR}/mysql/databases/mysql.sock" -N -B "${WORLD}" -e "
        SELECT COUNT(DISTINCT it.entry) FROM item_template it JOIN npc_vendor v ON v.item = it.entry
        WHERE it.InventoryType = ${type} AND v.ExtendedCost > 0 AND it.RequiredLevel <= ${level}
          AND it.RequiredHonorRank = 0 AND (it.FlagsExtra & ${other_flag}) = 0" 2>&1 | grep -v "Using a password"
}
for level in 18 28 38 48 58 68 78 80; do
    for side in "Horde 2" "Alliance 1"; do
        name="${side% *}"; other="${side#* }"
        neck="$(count "${level}" "${other}" 2)"
        rings="$(count "${level}" "${other}" 11)"
        trinkets="$(count "${level}" "${other}" 12)"
        check "${name} at ${level}: a necklace it may wear (found ${neck})"   '[[ "${neck}" =~ ^[0-9]+$ && ${neck} -ge 1 ]]'
        check "${name} at ${level}: two rings it may wear (found ${rings})"   '[[ "${rings}" =~ ^[0-9]+$ && ${rings} -ge 2 ]]'
        check "${name} at ${level}: two trinkets it may wear (found ${trinkets})" '[[ "${trinkets}" =~ ^[0-9]+$ && ${trinkets} -ge 2 ]]'
    done
done

if [[ ${FAILS} -eq 0 ]]; then echo "test-buddy-pvp-jewellery-sides: all ${CHECKS} checks passed"; exit 0; fi
echo "test-buddy-pvp-jewellery-sides: ${FAILS} of ${CHECKS} checks failed"
exit 1
