#!/usr/bin/env luajit
-- check-issue-references - reads issue files and checks that the files,
-- folders and other issues they name still exist, and says where each
-- missing one went when it can tell.
--
-- For a general audience: an issue file is the blueprint of a piece of the
-- project, and it names the files it built ("src/lua/ambush.lua",
-- "scripts/azerothcore"). The project moves on after an issue is closed:
-- folders are renamed, scripts are split, files are switched off. A
-- blueprint that names files which are gone no longer tells a reader how
-- to rebuild the thing, and nothing says so. This reads every issue (the
-- completed ones by default), pulls out each file path and each issue
-- number it names, and checks them against the project as it is now:
--   ok       the path or issue exists
--   moved    the path is gone, but a file of the same name (or the same
--            name switched off, ".disabled", or switched on again) exists
--            elsewhere, or a known rename explains it; the new place is
--            printed
--   missing  gone, and nothing of that name exists
-- Issue numbers are checked against the issue folders; a number listed in
-- issues/MIGRATION_MAP.md's "Old" column is reported with its new number,
-- since a reference written before the April 2026 renumbering may mean the
-- old issue.
--
-- It reads only; it changes nothing. It is an audit, not a gate: it exits
-- 0 unless --strict is given, in which case any "missing" makes it exit 1.
--
-- Usage: scripts/check-issue-references [PROJECT_DIR] [options] [ISSUE_FILE ...]
--   PROJECT_DIR      defaults to the hard-coded path below
--   --all            every issue, open and completed (default: completed/)
--   --source TREE    where "source-beta/..." paths are looked for (default
--                    PROJECT_DIR/source-beta; a separate checkout has none)
--   --summary        one line per issue, no detail; each line also says
--                    whether the issue has a "## Since then" section (where
--                    an old issue explains what became of it)
--   --suspect        also list issue numbers that exist now but were old
--                    numbers before the renumbering (often harmless: the
--                    2026-04-29 sweep rewrote most of them)
--   --strict         exit 1 if anything is missing
--   --threads        also list, for each issue checked, the later issues
--                    that name it and whether it names them back (a thread
--                    tied at both ends); a mention whose words fit another
--                    issue's name is a reused number, not this issue
--   ISSUE_FILE ...   check just these files
--
-- Also checked (added 2026-10-17 from scripts/trace-completed-issues, the
-- fronts-homework branch's version of this audit, now retired):
--   patches   patch steps an issue names (B023, C006b, E042) that no
--             longer exist, or were retired
--   explained a path that is gone but that the issue's own "## Since then"
--             section names (the path, its file name, or a folder it was
--             in) is counted as explained, not as moved or missing: the
--             issue already tells its reader; an old issue number written
--             as "334 (now 127)" with 127 existing is explained the same way
--   misfiled  with no files named, issues still in issues/ whose status
--             says completed are listed at the end

local DIR = "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local args, files = {}, {}
local opt = { all = false, summary = false, strict = false, source = nil, suspect = false, threads = false }
local i = 1
while i <= #arg do
    local a = arg[i]
    if a == "--all" then opt.all = true
    elseif a == "--summary" then opt.summary = true
    elseif a == "--strict" then opt.strict = true
    elseif a == "--suspect" then opt.suspect = true
    elseif a == "--threads" then opt.threads = true
    elseif a == "--source" then i = i + 1; opt.source = arg[i]
    elseif a:match("^/") and not a:match("%.md$") and not a:find("/issues/") then DIR = a
    else files[#files + 1] = a end
    i = i + 1
end
local SOURCE = opt.source or (DIR .. "/source-beta")

-- {{{ local function lines_of
local function lines_of(cmd)
    local out, f = {}, io.popen(cmd)
    for l in f:lines() do out[#out + 1] = l end
    f:close()
    return out
end
-- }}}

-- {{{ what exists now
-- Every tracked path (files, and every folder above them), plus anything
-- on disk at the project root's top levels, so untracked build folders
-- that issues name (installed-files-*, build-*) are not "missing".
local exists, byName = {}, {}
for _, p in ipairs(lines_of("git -C '" .. DIR .. "' ls-files")) do
    exists[p] = true
    local name = p:match("[^/]+$")
    byName[name] = byName[name] or {}
    table.insert(byName[name], p)
    local d = p
    while true do
        d = d:match("^(.*)/[^/]+$")
        if not d then break end
        exists[d] = true
    end
end
local function on_disk(path)
    local ok = os.execute("test -e '" .. path:gsub("'", "") .. "'")
    return ok == 0 or ok == true
end
-- }}}

-- {{{ known renames: a prefix that moved, and when
-- Each row: old prefix, new prefix, why. Checked in order; the first that
-- gives a path that exists wins.
local RENAMES = {
    { "src/lua/",    "src/lua-beta/",  "2026-06-04: per-profile Lua folders (src/lua became src/lua-beta)" },
    { "issues-beta/", "issues/",       "2026-04-29: the renumbered issues folder became issues/" },
    { "sql/custom/", "sql/beta/",      "2026-06-04: per-profile SQL folders" },
    { "src/lua-beta/behaviors/", "src/lua-beta/.behaviors.disabled/", "2026-04-10 switched off, 2026-10-17 hidden with a dot" },
    { "src/lua-beta/behaviors.disabled/", "src/lua-beta/.behaviors.disabled/", "2026-10-17: hidden with a dot so the engine skips it" },
    { "scripts/azerothcore", "scripts/azerothcore-deprecated", "2026-04-14: split into scripts/compile, install, update, worldserver... (issue 142); the old one kept as -deprecated" },
    { "scripts/profile-switch", "scripts/profile-switch-deprecated", "2026-04-14: replaced by scripts/switch; kept as -deprecated" },
}
-- Prefixes of things that left this project for another one: reported as
-- "moved" with where they went, since no file here will ever match them.
local MOVED_OUT = {
    { "src/custom-client-c", "the W client project, ../custom-client/src/ (issue 173v, 2026-10-07)" },
    { "src/custom-client",   "the W client project, ../custom-client/ (issue 173v; the Lua first version was removed)" },
    { "scripts/custom-client", "the W client project's scripts/run (issue 173v)" },
    { "scripts/build-custom-client", "the W client project's scripts/build (issue 173v)" },
}
-- Paths inside the game's own source tree, as an issue may write them
-- without the "source-beta/" in front.
local SOURCE_TOP = { "modules/mod-", "src/server/", "src/common/", "data/sql/" }
-- }}}

-- {{{ issue numbers that exist, and the renumbering map
local issueIds = {}
for _, p in ipairs(lines_of("ls '" .. DIR .. "/issues' '" .. DIR .. "/issues/completed' '" .. DIR .. "/issues/declined' 2>/dev/null")) do
    local id = p:match("^(%d+%a*%d*)%-")
    if id then issueIds[id] = true end
end
-- old number -> list of { new = number, slug = name }. A list, because
-- the April renumbering split some old numbers in two (327, 328, 329 and
-- 332 each named two different issues before; the map says "dup-N split").
-- Until 2026-10-17 only the last row was kept, and "328" was reported as
-- 124 when the text meant 606b.
local migrated = {}
do
    local f = io.open(DIR .. "/issues/MIGRATION_MAP.md")
    if f then
        for l in f:lines() do
            local old, new, slug = l:match("^|%s*(%d+%a*)%s*|%s*(%d+%a*)%s*|%s*([%w%-]+)")
            if old and old ~= new then
                migrated[old] = migrated[old] or {}
                table.insert(migrated[old], { new = new, slug = slug })
            end
        end
        f:close()
    end
end
-- Patch steps that exist: B in patches/ (".retired" in the name: retired),
-- C in config/patches/, E in patches/E-patches.sh, where a step is written
-- either as a "# E004:" header or only as its functions ("patch_E008_...";
-- read from headers alone, E008 was reported gone while it ran on two
-- profiles).
local patchState = {}
for p in pairs(exists) do
    local b = p:match("^patches/(B%d%d%d%a?)%-[^/]+$")
    if b then patchState[b] = p:find("retired", 1, true) and "retired" or "live" end
    local c = p:match("^config/patches/(C%d%d%d%a?)[%-%._]")
    if c then patchState[c] = "live" end
end
do
    local f = io.open(DIR .. "/patches/E-patches.sh")
    local src = f and f:read("*a") or ""
    if f then f:close() end
    for e in src:gmatch("\n# (E%d%d%d%a?):") do patchState[e] = "live" end
    for e in src:gmatch("\npatch_(E%d%d%d%a?)_[%w_]*%(%)") do patchState[e] = "live" end
end

local function candidates(old)
    local out = {}
    for _, m in ipairs(migrated[old] or {}) do out[#out + 1] = m.new .. " (" .. m.slug .. ")" end
    return table.concat(out, " or ")
end
-- }}}

-- {{{ local function classify_path
-- Returns "ok" | "moved", where | "missing", hint
local PREFIXES = { "src/", "scripts/", "patches/", "config/", "sql/", "docs/", "tests/", "libs/",
                   "modules/", "tools/", "notes/", "issues/", "issues-beta/", "assets/", "source-beta/" }
local function classify_path(p)
    for _, m in ipairs(MOVED_OUT) do
        if p:sub(1, #m[1]) == m[1] and not exists[p] then return "moved", m[2] end
    end
    for _, top in ipairs(SOURCE_TOP) do
        if p:sub(1, #top) == top and not exists[p] then
            if on_disk(SOURCE .. "/" .. p) then return "ok" end
            return "missing", "not in " .. SOURCE .. " either (source tree path)"
        end
    end
    if p:match("^source%-beta/") then
        if on_disk(SOURCE .. p:sub(#"source-beta" + 1)) then return "ok" end
        return "missing", "not in " .. SOURCE
    end
    if exists[p] or on_disk(DIR .. "/" .. p) then return "ok" end
    for _, r in ipairs(RENAMES) do
        if p:sub(1, #r[1]) == r[1] then
            local np = r[2] .. p:sub(#r[1] + 1)
            if exists[np] or exists[np .. ".disabled"] then return "moved", np .. (exists[np] and "" or ".disabled") .. "  (" .. r[3] .. ")" end
        end
    end
    -- switched off or on since, or retired with a "deprecated" ending
    if exists[p .. ".disabled"] then return "moved", p .. ".disabled  (switched off)" end
    for _, ending in ipairs({ ".deprecated", "-deprecated", "-done" }) do
        if exists[p .. ending] then return "moved", p .. ending .. "  (retired, kept for the record)" end
    end
    local undis = p:gsub("%.disabled$", "")
    if undis ~= p and exists[undis] then return "moved", undis .. "  (switched on again)" end
    -- a file of the same name elsewhere
    local name = p:match("[^/]+$")
    local found = byName[name] or byName[name .. ".disabled"] or (undis ~= p and byName[undis:match("[^/]+$")])
    if found then
        local where = {}
        for k = 1, math.min(#found, 3) do where[k] = found[k] end
        return "moved", table.concat(where, ", ") .. (#found > 3 and ", ..." or "") .. "  (same name)"
    end
    return "missing", nil
end
-- }}}

-- {{{ local function refs_in
-- Pulls path-like and issue-number references out of one issue's text.
-- A path: a known top folder followed by name characters, trailing
-- punctuation and ":line" removed; wildcards and placeholders skipped.
local function refs_in(text)
    local paths, issues, seenP, seenI, patches, seenX = {}, {}, {}, {}, {}, {}
    local n = 0
    for line in (text .. "\n"):gmatch("([^\n]*)\n") do
        n = n + 1
        for tok in line:gmatch("[%w_%./%-]+") do
            for _, pre in ipairs(PREFIXES) do
                local s = tok:find(pre, 1, true)
                if s == 1 or (s and tok:sub(s - 1, s - 1) == "/" and false) then
                    local p = tok:gsub("[%.,;:%)]+$", ""):gsub(":%d+$", "")
                    -- skip wildcards, placeholders, "..." elisions, and stubs
                    -- left where a wildcard was cut off ("patches/B" from
                    -- "patches/B*.sh": a last part of one character)
                    local stub = (p:match("[^/]+$") or ""):len() < 2
                    local cut = line:find(p .. "*", 1, true) or line:find(p .. "...", 1, true) or p:find("...", 1, true)
                    if not p:find("[%*<>{}%$]") and #p > #pre and not p:match("/$") and not stub and not cut and not seenP[p] then
                        seenP[p] = true
                        paths[#paths + 1] = { path = p, line = n }
                    end
                    break
                end
            end
        end
        for id in line:gmatch("[Ii]ssues?%s+(%d%d%d+%a*%d*)") do
            if not seenI[id] then seenI[id] = true; issues[#issues + 1] = { id = id, line = n } end
        end
        -- an old number annotated in place with its new one: "334 (now 127)"
        for id, now in line:gmatch("(%d%d%d+%a*%d*)%s*%(now%s+(%d%d%d+%a*%d*)") do
            for _, r in ipairs(issues) do if r.id == id then r.now = now end end
            if not seenI[id] then seenI[id] = true; issues[#issues + 1] = { id = id, line = n, now = now } end
        end
        for x in line:gmatch("%f[%w]([BCE]%d%d%d%a?)%f[%W]") do
            if not seenX[x] then seenX[x] = true; patches[#patches + 1] = { id = x, line = n } end
        end
        for id in line:gmatch("issues/(%d%d%d+%a*%d*)%-") do
            if not seenI[id] then seenI[id] = true; issues[#issues + 1] = { id = id, line = n } end
        end
    end
    return paths, issues, patches
end
-- }}}

-- {{{ which issues to read
explicitFiles = #files > 0
if #files == 0 then
    local where = opt.all and ("'" .. DIR .. "/issues' -maxdepth 2") or ("'" .. DIR .. "/issues/completed' -maxdepth 1")
    for _, p in ipairs(lines_of("find " .. where .. " -type f \\( -name '[0-9]*' \\) | sort")) do
        if not p:find("/archived/") then files[#files + 1] = p end
    end
end
-- }}}

local totals = { ok = 0, moved = 0, missing = 0, explained = 0, issues = 0, badIssues = 0, renumbered = 0, threaded = 0, badPatches = 0 }

-- {{{ every issue file's text, for --threads and the misfiled list
local allIssues = {}
for _, p in ipairs(lines_of("find '" .. DIR .. "/issues' -maxdepth 2 -type f -name '[0-9]*' | sort")) do
    if not p:find("/archived/") then
        local name = p:match("([^/]+)$")
        local fh = io.open(p)
        allIssues[#allIssues + 1] = { path = p, name = name, id = name:match("^(%d+%a*%d*)"),
                                      completed = p:find("/issues/completed/", 1, true) ~= nil,
                                      open = p:match("/issues/[^/]+$") ~= nil,
                                      text = fh and fh:read("*a") or "" }
        if fh then fh:close() end
    end
end
-- }}}

-- {{{ local function thread_of
-- The later issues that name issue `id` (file name `name`, text `text`).
-- Numbers were reused (the April renumbering, and numbers handed out
-- twice: 141, 142), so a mention counts as this issue only when the line
-- it is on, or the next, shares a word of five letters or more with this
-- issue's name; one that shares none but is followed by a name of its own
-- ("307: narrator-audience-facing") is a reused number; neither is
-- unconfirmed. Returns lists: confirmed, not named back, reused, unsure.
local function names_id(text, id)
    return text:find("[Ii]ssues?%s+" .. id .. "%f[%W]") or text:find("issues/" .. id .. "%-") or
           text:find("%*%*" .. id .. "%*%*") or text:find("%(" .. id .. "[%),]") or text:find("%f[%w]" .. id .. "%-%l")
end
local function thread_of(id, name, text)
    local words = {}
    for w in name:gsub("%.md$", ""):gmatch("%a+") do if #w >= 5 then words[w:lower()] = true end end
    local yes, unanswered, reused, unsure = {}, {}, {}, {}
    for _, g in ipairs(allIssues) do
        if g.id ~= id and names_id(g.text, id) then
            local lines, verdict = {}, "unsure"
            for l in (g.text .. "\n"):gmatch("([^\n]*)\n") do lines[#lines + 1] = l end
            for k, l in ipairs(lines) do
                if verdict ~= "this" and l:find("%f[%w]" .. id .. "%f[%W]") then
                    local near = (l .. " " .. (lines[k + 1] or "")):lower():gsub("%-", " ")
                    for w in pairs(words) do if near:find(w, 1, true) then verdict = "this" end end
                    if verdict ~= "this" and near:find(id .. "[%s:%-%(]+%a%a%a%a%a") then verdict = "reused" end
                end
            end
            if verdict == "this" then
                yes[#yes + 1] = g.id
                if not names_id(text, g.id) then unanswered[#unanswered + 1] = g.id end
            elseif verdict == "reused" then reused[#reused + 1] = g.id
            else unsure[#unsure + 1] = g.id end
        end
    end
    return yes, unanswered, reused, unsure
end
-- }}}
for _, file in ipairs(files) do
    local f = io.open(file)
    if not f then print("  cannot read " .. file) else
        local text = f:read("*a"); f:close()
        -- the issue's own account of what became of it: a gone path it names
        -- there (or its file name, or a folder it was in) is explained
        local since = text:match("\n## Since then(.*)$") or text:match("\n## What Came After(.*)$") or ""
        local body  = text:match("^(.-)\n## Since then") or text:match("^(.-)\n## What Came After") or text
        local function told(p)
            if since == "" then return false end
            if since:find(p, 1, true) or since:find(p:match("[^/]+$"), 1, true) then return true end
            local d = p:match("^(.*)/[^/]+$")
            while d and d:find("/", 1, true) do
                if since:find(d .. "/", 1, true) then return true end
                d = d:match("^(.*)/[^/]+$")
            end
            return false
        end
        local paths, issues, patches = refs_in(body)
        local report, c = {}, { ok = 0, moved = 0, missing = 0, explained = 0 }
        for _, r in ipairs(paths) do
            local kind, hint = classify_path(r.path)
            if kind ~= "ok" and told(r.path) then kind, hint = "explained", "named in the issue's Since then section" end
            c[kind] = c[kind] + 1
            if kind ~= "ok" then
                report[#report + 1] = string.format("    %-7s line %-4d %s%s", kind, r.line, r.path, hint and ("  ->  " .. hint) or "")
            end
        end
        local own = file:match("([^/]+)$"):match("^(%d+%a*%d*)")
        for _, r in ipairs(patches) do
            local st = patchState[r.id]
            if st ~= "live" then
                totals.badPatches = totals.badPatches + 1
                report[#report + 1] = string.format("    patch   line %-4d %s %s", r.line, r.id,
                    st == "retired" and "has been retired" or "is not in the project")
            end
        end
        for _, r in ipairs(issues) do
            if r.id ~= own then
                if r.now and issueIds[r.now] and not issueIds[r.id] then
                    -- annotated in place with its new number: explained
                elseif not issueIds[r.id] then
                    totals.badIssues = totals.badIssues + 1
                    report[#report + 1] = string.format("    issue   line %-4d %s does not exist%s", r.line, r.id,
                        migrated[r.id] and ("  ->  renumbered to " .. candidates(r.id)) or "")
                elseif migrated[r.id] and opt.suspect then
                    totals.renumbered = totals.renumbered + 1
                    report[#report + 1] = string.format("    issue?  line %-4d %s exists, but was also an old number: if written before 2026-04-29 it may mean %s",
                        r.line, r.id, candidates(r.id))
                end
            end
        end
        if opt.threads then
            local yes, unanswered, reused, unsure = thread_of(own, file:match("([^/]+)$"), text)
            if #yes + #reused + #unsure > 0 then
                report[#report + 1] = string.format("    after   named by later issues: %s%s%s%s",
                    #yes > 0 and table.concat(yes, ", ") or "none",
                    #unanswered > 0 and ("; not named back: " .. table.concat(unanswered, ", ")) or "",
                    #reused > 0 and ("; the same number meaning another issue in: " .. table.concat(reused, ", ")) or "",
                    #unsure > 0 and ("; the number without a name (unconfirmed) in: " .. table.concat(unsure, ", ")) or "")
            end
        end
        totals.ok, totals.moved, totals.missing = totals.ok + c.ok, totals.moved + c.moved, totals.missing + c.missing
        totals.explained = totals.explained + c.explained
        totals.issues = totals.issues + 1
        local name = file:sub(#DIR + 2)
        -- A "Since then" section is where an old issue says what became of
        -- it; an issue with one has had its stale references explained.
        local threaded = text:find("\n## Since then", 1, false) ~= nil
        if threaded then totals.threaded = totals.threaded + 1 end
        print(string.format("%s: %d paths ok, %d moved, %d missing%s%s", name, c.ok, c.moved, c.missing,
            c.explained > 0 and string.format(", %d explained", c.explained) or "",
            threaded and "  [has a Since then thread]" or ((c.moved + c.missing > 0) and "  [no Since then thread yet]" or "")))
        if not opt.summary then for _, l in ipairs(report) do print(l) end end
    end
end
-- {{{ finished, but filed as open
-- Only when the whole set is checked: an issue in issues/ itself whose
-- status says completed was finished and never moved (found 2026-10-17:
-- the full 307 sat in issues/ while completed/ held its old copy).
if not explicitFiles then
    for _, g in ipairs(allIssues) do
        if g.open then
            local head = g.text:sub(1, 1500)
            if head:match("[Ss]tatus:?%**:?%s*[Cc]ompleted") or head:match("[Ss]tatus%*%*:?%s*[Cc]ompleted") then
                totals.misfiled = (totals.misfiled or 0) + 1
                print("issues/" .. g.name .. ": marked completed, but still filed among the open issues")
            end
        end
    end
end
-- }}}
print(string.format("%d issue file(s), %d with a Since then thread: %d paths ok, %d moved, %d missing, %d explained; %d issue numbers that do not exist, %d that may mean a renumbered issue; %d patch steps gone or retired",
    totals.issues, totals.threaded, totals.ok, totals.moved, totals.missing, totals.explained, totals.badIssues, totals.renumbered, totals.badPatches))
os.exit((opt.strict and totals.missing > 0) and 1 or 0)
