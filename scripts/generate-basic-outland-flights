#!/usr/bin/env luajit

local DIR = arg[1] or "/mnt/kaun/wow-chat-2026"
local DBC = DIR .. "/data-files/dbc/"
local OUT = DIR .. "/src/lua-basic/data/outland-flight-paths.lua"

local ROUTES = {
    { "portal_to_honor_hold",      { 564 } },
    { "honor_hold_to_portal",      { 566 } },
    { "portal_to_thrallmar",       { 565 } },
    { "thrallmar_to_portal",       { 567 } },
    { "lights_hope_to_isle_a",     { 796 } },
    { "isle_to_lights_hope_a",     { 797 } },
    { "lights_hope_to_isle_h",     { 771, 786 } },
    { "isle_to_lights_hope_h",     { 787, 772 } },
}

local function die(msg)
    io.stderr:write("generate-basic-outland-flights: ", msg, "\n")
    os.exit(1)
end

local function load_dbc(name)
    local f = io.open(DBC .. name, "rb") or die("cannot open " .. DBC .. name)
    local d = f:read("*a")
    f:close()
    if d:sub(1, 4) ~= "WDBC" then die(name .. " is not a WDBC file") end
    local function u32(o) local a, b, c, e = d:byte(o + 1, o + 4); return a + b * 256 + c * 65536 + e * 16777216 end
    local function f32(o)
        local a, b, c, e = d:byte(o + 1, o + 4)
        local s = (e >= 128) and -1 or 1
        local ex = (e % 128) * 2 + math.floor(c / 128)
        local m = (c % 128) * 65536 + b * 256 + a
        if ex == 0 then return 0 end
        return s * (1 + m / 8388608) * 2 ^ (ex - 127)
    end
    return u32(4), u32(12), u32, f32
end

local n, rs, u32, f32 = load_dbc("TaxiPathNode.dbc")
local points = {}
for i = 0, n - 1 do
    local o = 20 + i * rs
    local path = u32(o + 4)
    points[path] = points[path] or {}
    points[path][u32(o + 8) + 1] = { u32(o + 12), f32(o + 16), f32(o + 20), f32(o + 24), u32(o + 28), u32(o + 32) }
end

local out = {
    "-- outland-flight-paths.lua - GENERATED by scripts/generate-basic-outland-flights; do not edit by hand.",
    "-- The waypoints of basic's few kept flights (issue 155l), copied from the client's TaxiPathNode.dbc.",
    "-- Each point: { map, x, y, z, flags, delay }, the shape Global:AddTaxiPath takes.",
    "return {",
}
for _, r in ipairs(ROUTES) do
    local name, paths = r[1], r[2]
    local pts = {}
    for leg, pid in ipairs(paths) do
        local list = points[pid] or die("taxi path " .. pid .. " not in TaxiPathNode.dbc")
        for k = 1, #list do
            local p = list[k] or die("taxi path " .. pid .. " has a gap at point " .. k)
            if not (leg > 1 and k == 1) then pts[#pts + 1] = p end
        end
    end
    out[#out + 1] = "    " .. name .. " = {  -- taxi path(s) " .. table.concat(paths, " + ") .. ", " .. #pts .. " points"
    for _, p in ipairs(pts) do
        out[#out + 1] = string.format("        { %d, %.3f, %.3f, %.3f, %d, %d },", p[1], p[2], p[3], p[4], p[5], p[6])
    end
    out[#out + 1] = "    },"
end
out[#out + 1] = "}"
local f = io.open(OUT, "w") or die("cannot write " .. OUT)
f:write(table.concat(out, "\n"), "\n")
f:close()
io.write("wrote ", #ROUTES, " routes into ", OUT, "\n")
