#!/usr/bin/env luajit
-- ==== header: 8 lines, footer: 3 lines ====
-- id:         test-buddy-item-plan
-- profiles:   all
-- priority:   10
-- kind:       test
-- about:      check the plan a buddy makes for each item it picks up
-- quick-test: yes
-- ==== end of header ====
-- test-buddy-item-plan - check the plan a buddy makes for each item it
-- picks up, and when those plans change (issue 617h2).
--
-- For a general audience: a buddy decides what every item is for the moment
-- it picks it up (wear it, open it, learn it, use it, keep it for a recipe,
-- feed its pet, give it to a clan-mate, disenchant it, auction it, sell
-- it), and changes a plan only when a newer item makes a difference (the
-- owner's example: a pearl kept once a recipe that needs it is learned).
-- This test plays the owner's examples one by one, then thousands of random
-- buddies picking up random items, and checks every plan against a referee
-- written from the decisions in 617h2, not from the code being tested.
--
-- Checks: each kind of item gets its plan; the hearthstone, tools and
-- fishing poles are never sold; bound items never go to the auction house
-- or a clan-mate; a learned recipe turns its reagents from "sell" to
-- "craft" and changes nothing else; a pickup that learns nothing changes no
-- held plan; the plans held after any run of pickups are the plans a fresh
-- login works out from the same bags, in any order; a want turns "ready"
-- once the purse and planned sales cover it, and is bought at the auction
-- house only with money in the purse (an item put up there brings nothing
-- until its money is fetched from the mailbox); a place settles exactly the
-- plans made for it. Quest items nobody pays for are left on the ground,
-- others are judged as white items (trade goods when a profession uses
-- them). Ammo it fires is kept, the best stacks up to its count, and better
-- ammo sends the worst to the vendor, the same whatever order it came in.
-- The mailbox: money always taken, items by plan and by what the town has.
--
-- Usage: scripts/test-buddy-item-plan [PROJECT_DIR] [RUNS]
--   RUNS  random buddies (default 400)
-- Exit status 0 if all pass.

local DIR  = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end
local RUNS = tonumber(arg[2]) or 400

local Plan = dofile(DIR .. "/src/lua-basic/lib/buddy-item-plan.lua")

local fails, checks = {}, 0
local function check(ok, what)
    checks = checks + 1
    if not ok and #fails < 25 then fails[#fails + 1] = what end
end

-- {{{ items for the owner's examples
local GREEN, BLUE, EPIC, GREY, WHITE = 2, 3, 4, 0, 1
local function item(t) t.count = t.count or 1; t.quality = t.quality or WHITE; t.sell_price = t.sell_price or 0; return t end
local PEARL     = function() return item({ id = 5498,  class = 7, subclass = 7, quality = WHITE, sell_price = 100 }) end   -- Small Lustrous Pearl
local RECIPE    = function() return item({ id = 20854, class = 9, subclass = 10, use = true, sell_price = 50,
                                           recipe = { skill = 755, rank = 50, teaches = 25339, reagents = { [5498] = 1, [2840] = 1 } } }) end
local HEARTH    = function() return item({ id = 6948,  class = 15, use = true, bound = true, bonding = 1 }) end
local PICK      = function() return item({ id = 2901,  class = 7, tool = true, sell_price = 16 }) end
local POLE      = function() return item({ id = 6256,  class = 2, subclass = 20, sell_price = 4 }) end
local CLAM      = function() return item({ id = 5523,  class = 0, openable = true, use = true, sell_price = 1 }) end
local POTION    = function() return item({ id = 118,   class = 0, use = true, sell_price = 5 }) end
local MEAT      = function() return item({ id = 2672,  class = 0, use = true, food_type = 1, sell_price = 1 }) end
local BOUND_GRN = function() return item({ id = 9000,  class = 4, quality = GREEN, bonding = 1, bound = true, sell_price = 300, de_skill = 25 }) end
local BOE_BLUE  = function() return item({ id = 9001,  class = 2, quality = BLUE,  bonding = 2, sell_price = 900 }) end
local BOE_EPIC  = function() return item({ id = 9002,  class = 2, quality = EPIC,  bonding = 2, sell_price = 5000 }) end
local GREY_JUNK = function() return item({ id = 9003,  class = 15, quality = GREY, sell_price = 7, count = 3 }) end
local ROCK      = function() return item({ id = 9004,  class = 15, quality = WHITE, sell_price = 0 }) end
local TRINKET   = function() return item({ id = 9005,  class = 4, quality = GREEN, bonding = 1, bound = true, use = true, sell_price = 200 }) end
local QUEST_FREE = function() return item({ id = 9006, class = 12, quality = WHITE, bonding = 4, sell_price = 0 }) end
local QUEST_PAID = function() return item({ id = 9007, class = 12, quality = GREEN, bonding = 4, sell_price = 40 }) end
local QUEST_MAT  = function() return item({ id = 9008, class = 12, quality = WHITE, sell_price = 25, material = true }) end
local ARROWS     = function(dps, n) return item({ id = 2512 + dps, class = 6, subclass = 2, ammo_dps = dps, sell_price = 1, count = n or 200, stack = 200 }) end
local BULLETS    = function(dps, n) return item({ id = 2516 + dps, class = 6, subclass = 3, ammo_dps = dps, sell_price = 1, count = n or 200, stack = 200 }) end
-- }}}

-- {{{ each kind gets its plan
do
    local plain = { professions = {}, recipes = {} }
    local cases = {
        { "hearthstone",          HEARTH(),    plain, "keep" },
        { "a mining pick",        PICK(),      plain, "keep" },
        { "a fishing pole",       POLE(),      plain, "keep" },
        { "a clam",               CLAM(),      plain, "open" },
        { "a healing potion",     POTION(),    plain, "use" },
        { "a trinket with a use", TRINKET(),   plain, "use" },
        { "meat, no pet",         MEAT(),      plain, "use" },
        { "meat, a meat-eating pet", MEAT(),   { pet_diet = { [1] = true } }, "feed" },
        { "meat, a fish-eating pet", MEAT(),   { pet_diet = { [2] = true } }, "use" },
        { "a bound green",        BOUND_GRN(), plain, "vendor" },
        { "a bound green, enchanter 25", BOUND_GRN(), { professions = { [333] = 25 } }, "disenchant" },
        { "a bound green, enchanter 10", BOUND_GRN(), { professions = { [333] = 10 } }, "vendor" },
        { "a bind-on-equip blue", BOE_BLUE(),  plain, "auction" },
        { "a bind-on-equip blue, enchanter", BOE_BLUE(), { professions = { [333] = 300 } }, "auction" },
        { "an epic (treated as any item)", BOE_EPIC(), plain, "auction" },
        { "grey junk",            GREY_JUNK(), plain, "vendor" },
        { "a rock",               ROCK(),      plain, "junk" },
        { "a pearl (trade goods)", PEARL(),    plain, "auction" },
        { "a pearl, recipe known", PEARL(),    { recipes = { [1] = { [5498] = 1 } } }, "craft" },
        { "a recipe, no profession", RECIPE(), plain, "auction" },
        { "a recipe, profession too low", RECIPE(), { professions = { [755] = 40 } }, "auction" },
        { "a recipe it can learn", RECIPE(),   { professions = { [755] = 50 } }, "learn" },
        { "a recipe already known", RECIPE(),  { professions = { [755] = 50 }, recipes = { [25339] = {} } }, "auction" },
        { "a pearl a clan-mate wants", PEARL(), { clan = { { name = "Brom", needs = { [5498] = true } } } }, "give" },
        { "a bound green a clan-mate wants", BOUND_GRN(), { clan = { { name = "Brom", needs = { [9000] = true } } } }, "vendor" },
        { "an upgrade",           (function() local i = BOE_BLUE(); i.wear = "now";  return i end)(), plain, "wear" },
        { "a kept weapon",        (function() local i = BOE_BLUE(); i.wear = "kept"; return i end)(), plain, "keep" },
        { "a quest item nobody pays for", QUEST_FREE(), plain, "leave" },
        { "a quest item, judged white not green", QUEST_PAID(), plain, "vendor" },
        { "a quest item a profession uses", QUEST_MAT(), plain, "auction" },
        { "a quest item a known recipe uses", QUEST_MAT(), { recipes = { [1] = { [9008] = 1 } } }, "craft" },
        { "arrows, a bow user",   ARROWS(5),   { ammo = 2, ammo_stacks = 1 }, "keep" },
        { "bullets, a bow user",  BULLETS(5),  { ammo = 2, ammo_stacks = 1 }, "vendor" },
        { "arrows, no ranged weapon", ARROWS(5), plain, "vendor" },
    }
    for _, c in ipairs(cases) do
        local plan, why, to = Plan.decide(c[2], c[3])
        check(plan == c[4], c[1] .. ": planned " .. tostring(plan) .. ", wanted " .. c[4])
        check(type(why) == "string" and #why > 0, c[1] .. ": no reason given")
        if plan == "give" then check(to == "Brom", c[1] .. ": given to " .. tostring(to)) end
    end
    local bop = BOE_BLUE(); bop.bonding = 1                             -- bind-on-pickup, "bound" not passed
    check(Plan.decide(bop, plain) == "vendor", "a bind-on-pickup blue not marked bound goes to the auction house")
    check(Plan.decide(bop, { clan = { { name = "Brom", needs = { [9001] = true } } } }) == "vendor", "a bind-on-pickup blue is given away")
    local bp = RECIPE(); bp.bonding, bp.bound = 1, true
    check(Plan.decide(bp, plain) == "vendor", "a bound recipe it can't learn isn't vendored")
end
-- }}}

-- {{{ the owner's pearl: a recipe learned turns its reagents to "craft", nothing else
do
    local s = Plan.new({ professions = { [755] = 60 } })
    local _, c1 = Plan.pickup(s, PEARL())
    local _, c2 = Plan.pickup(s, BOE_BLUE())
    local _, c3 = Plan.pickup(s, PEARL())
    check(#c1 == 0 and #c2 == 0 and #c3 == 0, "a pickup that learns nothing changed a held plan")
    check(s.bag[1].plan == "auction" and s.bag[3].plan == "auction", "pearls before the recipe aren't for the auction house")
    local e, changes, _, now = Plan.pickup(s, RECIPE())
    check(e.plan == "learn" and now, "the recipe isn't learned at once")
    check(#s.bag == 3, "the learned recipe stayed in the bags")
    check(s.buddy.recipes[25339] ~= nil, "the recipe isn't known after learning it")
    check(#changes == 2, "learning changed " .. #changes .. " plans, wanted the 2 pearls")
    for _, ch in ipairs(changes) do
        check(ch.entry.item.id == 5498 and ch.from == "auction" and ch.to == "craft", "learning changed a plan it shouldn't")
    end
    check(s.bag[2].plan == "auction", "the blue's plan changed")
    local e4 = Plan.pickup(s, PEARL())
    check(e4.plan == "craft", "a pearl after the recipe isn't for crafting")
end
-- }}}

-- {{{ the owner's axe: a want turns ready, and is bought at the auction house
do
    local s = Plan.new({ money = 5000, wants = { { name = "two-handed axe", price = 9000 } } })
    local _, _, w1 = Plan.pickup(s, GREY_JUNK())                     -- 21 copper: not yet
    check(#w1 == 0 and s.wants[1].state == "saving", "the axe is ready too soon")
    local blue = BOE_BLUE(); blue.auction = 4000
    local _, _, w2 = Plan.pickup(s, blue)                            -- 5000 + 21 + 4000 >= 9000
    check(#w2 == 1 and w2[1].from == "saving" and w2[1].to == "ready", "the axe didn't turn ready")
    local _, _, w3 = Plan.pickup(s, POTION())
    check(#w3 == 0, "a ready want changed again")

    local sold = Plan.settle(s, "vendor")
    check(#sold == 1 and sold[1].act == "vendor" and sold[1].entry.item.id == 9003, "the vendor settled the wrong items")
    check(s.buddy.money == 5021, "the vendor's money is " .. s.buddy.money)
    check(#s.bag == 2, "the vendor took more than the junk")
    check(#Plan.settle(s, "mailbox") == 0, "the mailbox settled something")
    -- the blue is put up: out of mind, no money yet, so no axe (the owner,
    -- 2026-11-05: "How could we buy something with money we don't have?")
    local ah = Plan.settle(s, "auction")
    check(#ah == 1 and ah[1].act == "auction", "the auction house didn't just put the blue up")
    check(s.buddy.money == 5021, "putting the blue up changed the purse to " .. s.buddy.money)
    check(#s.wants == 1 and s.wants[1].state == "saving", "the axe is still counted on the blue's sale")
    check(#s.bag == 1 and s.bag[1].plan == "use", "the potion left the bags")
    -- the blue sold: its money comes by mail, then the axe is bought
    local got = Plan.mailbox(s, { { money = 4000 } }, { auction = true, vendor = true })
    check(got == 4000 and s.buddy.money == 9021, "the auction's money wasn't taken from the mail")
    check(s.wants[1].state == "ready", "the axe isn't ready once the money is in the purse")
    local buy = Plan.settle(s, "auction")
    check(#buy == 1 and buy[1].act == "buy" and s.buddy.money == 21 and #s.wants == 0, "the axe isn't bought with the purse's money")

    -- the wants go in their list's order, each one the purse covers
    local o = Plan.new({ money = 120, wants = { { name = "big", price = 100 }, { name = "small", price = 50 }, { name = "tiny", price = 20 } } })
    local bought = Plan.settle(o, "auction")
    check(#bought == 2 and bought[1].want.name == "big" and bought[2].want.name == "tiny" and o.buddy.money == 0,
          "the wants weren't bought in list order, each the purse covered")
    check(#o.wants == 1 and o.wants[1].name == "small", "the want the purse couldn't cover is gone")
    check(Plan.drop_want(o, "small") == 1 and #o.wants == 0, "a want can't be pruned")
    check(Plan.drop_want(o, "small") == 0, "pruning a want that isn't there pruned something")

    -- the vendor before the auction house: the vendor pays at once
    local a = Plan.new({ money = 0, wants = { { name = "axe", price = 500 } } })
    Plan.pickup(a, item({ id = 1, class = 15, sell_price = 500 }))
    check(a.wants[1].state == "ready", "the axe isn't ready on a 500 sale")
    check(#Plan.settle(a, "auction") == 0, "the axe was bought before the vendor's money came in")
    Plan.settle(a, "vendor")
    local late = Plan.settle(a, "auction")
    check(#late == 1 and late[1].act == "buy" and a.buddy.money == 0, "the axe isn't bought once the vendor paid")
    local okay = pcall(Plan.new, { ammo = 2 })
    check(not okay, "a buddy that fires ammo but keeps no count of stacks was accepted")

    local t = Plan.new({ money = 0, wants = { { name = "a", price = 100 }, { name = "b", price = 50 } } })
    local _, _, w = Plan.pickup(t, item({ id = 1, class = 15, sell_price = 60 }))
    check(#w == 1 and w[1].want.name == "b", "the cheaper want isn't ready first")
    check(t.wants[1].state == "saving", "both wants ready on 60 copper")
    local u = Plan.new({ money = 0, wants = { { name = "z", price = 100 }, { name = "y", price = 100 } } })
    local _, _, wu = Plan.pickup(u, item({ id = 1, class = 15, sell_price = 100 }))
    check(#wu == 1 and wu[1].want.name == "y", "two wants of one price aren't taken by name")
    local v = Plan.new({ money = 0, wants = { { name = "z", price = 100 } } })
    Plan.pickup(v, item({ id = 1, class = 15, sell_price = 99 }))
    check(v.wants[1].state == "saving", "a want one copper short is ready")
    local x = Plan.new({ money = 0, wants = { { name = "z", price = 100 } } })
    Plan.pickup(x, item({ id = 1, class = 15, sell_price = 100 }))
    check(x.wants[1].state == "ready", "a want paid exactly isn't ready")
    local y = Plan.new({ money = 0, wants = { { name = "z", price = 300 } } })
    Plan.pickup(y, item({ id = 1, class = 15, quality = GREEN, sell_price = 100 }))
    check(y.wants[1].state == "ready", "a green's auction guess isn't three times its vendor price")
    local z = Plan.new({ money = 0, wants = { { name = "z", price = 400 } } })
    Plan.pickup(z, item({ id = 1, class = 15, quality = GREEN, sell_price = 100, count = 2 }))
    check(z.wants[1].state == "ready", "a stack's value isn't counted whole")
end
-- }}}

-- {{{ a login does at once what has become possible
do
    local l, done = Plan.login({ professions = { [755] = 50 } }, { PEARL(), RECIPE(), POTION() })
    check(#done == 1 and done[1].plan == "learn", "a login didn't learn the recipe the buddy can now learn")
    check(#l.bag == 2 and l.bag[1].plan == "craft", "after the login's learning the pearl isn't for crafting")
    local m, none = Plan.login({}, { PEARL(), RECIPE(), POTION() })
    check(#none == 0 and #m.bag == 3, "a login with nothing to do at once did something")
end
-- }}}

-- {{{ quest items left on the ground, ammo kept to its count
do
    local q = Plan.new({})
    local e, ch, _, now = Plan.pickup(q, QUEST_FREE())
    check(e.plan == "leave" and not now and #q.bag == 0 and #ch == 0, "a quest item nobody pays for was taken")

    -- a hunter's ammo bag of 3 stacks: the best three kept, better ammo sends the worst to the vendor
    local h = Plan.new({ ammo = 2, ammo_stacks = 3 })
    Plan.pickup(h, ARROWS(5)); Plan.pickup(h, ARROWS(5)); Plan.pickup(h, ARROWS(7))
    for k = 1, 3 do check(h.bag[k].plan == "keep", "a hunter's arrow stack " .. k .. " of 3 isn't kept") end
    local e4, c4 = Plan.pickup(h, ARROWS(9))
    check(e4.plan == "keep" and #c4 == 1 and c4[1].from == "keep" and c4[1].to == "vendor" and c4[1].entry.item.ammo_dps == 5,
          "better arrows didn't send one of the worst stacks to the vendor")
    local e5, c5 = Plan.pickup(h, ARROWS(3))
    check(e5.plan == "vendor" and #c5 == 0, "arrows worse than the kept three weren't sold")
    local e6, c6 = Plan.pickup(h, ARROWS(9, 40))                       -- better arrows first, then the fuller stack
    check(e6.plan == "keep" and #c6 == 1 and c6[1].entry.item.ammo_dps == 5 and c6[1].to == "vendor",
          "a part-stack of better arrows didn't replace the last of the worse")
    local e8 = Plan.pickup(h, ARROWS(7, 40))
    check(e8.plan == "vendor", "a part-stack beat a full stack of the same arrows")
    local e7 = Plan.pickup(h, BULLETS(20))
    check(e7.plan == "vendor", "a bow user kept bullets")
    -- a warrior keeps one stack, the best
    local w = Plan.new({ ammo = 3, ammo_stacks = 1 })
    Plan.pickup(w, BULLETS(4))
    local _, cw = Plan.pickup(w, BULLETS(6))
    check(w.bag[1].plan == "vendor" and w.bag[2].plan == "keep" and #cw == 1, "a warrior kept more than its one best stack")
    -- a learned recipe doesn't bring a sold stack back
    local r = Plan.new({ ammo = 2, ammo_stacks = 1, professions = { [755] = 50 } })
    Plan.pickup(r, ARROWS(4)); Plan.pickup(r, ARROWS(6))
    local _, cr = Plan.pickup(r, RECIPE())
    check(#cr == 0 and r.bag[1].plan == "vendor" and r.bag[2].plan == "keep", "learning a recipe brought sold ammo back")
    -- a bigger ammo bag keeps the stack it was going to sell, at the next pickup
    r.buddy.ammo_stacks = 2
    local _, cb = Plan.pickup(r, POTION())
    check(#cb == 1 and cb[1].from == "vendor" and cb[1].to == "keep" and r.bag[1].plan == "keep", "a bigger ammo bag didn't keep the spare stack")
    local okay = pcall(Plan.pickup, Plan.new({ ammo = 2, ammo_stacks = 1 }), item({ id = 1, class = 6, subclass = 2, sell_price = 1 }))
    check(not okay, "ammo with no damage per second was ranked")

    -- the same ammo, picked up in any order, ends with the same stacks kept
    for run = 1, 200 do
        math.randomseed(run * 31 + 7)
        local R = math.random
        local stacks, list = R(4), {}
        for k = 1, R(12) do list[k] = (R(2) == 1 and ARROWS or BULLETS)(R(6), R(200)) end
        local function kept(order)
            local s = Plan.new({ ammo = 2, ammo_stacks = stacks })
            for _, it in ipairs(order) do Plan.pickup(s, it) end
            local out = {}
            for _, en in ipairs(s.bag) do
                if en.plan == "keep" then out[#out + 1] = en.item.ammo_dps .. "x" .. en.item.count end
            end
            table.sort(out)
            return table.concat(out, " "), s
        end
        local a, sa = kept(list)
        local back = {}
        for k = #list, 1, -1 do back[#back + 1] = list[k] end
        local b = kept(back)
        check(a == b, "ammo run " .. run .. ": kept " .. a .. " one way, " .. b .. " the other")
        local arrows = 0
        for _, it in ipairs(list) do if it.subclass == 2 then arrows = arrows + 1 end end
        local n = 0
        for _, en in ipairs(sa.bag) do if en.plan == "keep" then n = n + 1 end end
        check(n == math.min(stacks, arrows), "ammo run " .. run .. ": kept " .. n .. " stacks of " .. arrows .. ", room for " .. stacks)
        for _, en in ipairs(sa.bag) do
            if en.plan == "keep" then
                for _, other in ipairs(sa.bag) do
                    check(other.plan == "keep" or other.item.subclass ~= 2 or other.item.ammo_dps <= en.item.ammo_dps,
                          "ammo run " .. run .. ": better arrows sold while worse were kept")
                end
            end
        end
    end
end
-- }}}

-- {{{ the mailbox: money always, items by plan and by what the town has
do
    local function mail() return { { money = 300, items = { GREY_JUNK(), BOE_BLUE(), POTION(), PEARL(), ROCK() } } } end
    -- a mailbox with no vendor or auction house near (the death knights' land)
    local s = Plan.new({ money = 0, recipes = { [1] = { [5498] = 1 } } })
    local money, taken, left = Plan.mailbox(s, mail(), { vendor = false, auction = false, crafting = false })
    local plans = {}
    for _, e in ipairs(taken) do plans[#plans + 1] = e.plan end
    check(money == 300 and s.buddy.money == 300, "the mail's money wasn't taken")
    check(table.concat(plans, " ") == "use", "a mailbox with nothing near took " .. table.concat(plans, " "))
    check(#left == 4, "a mailbox with nothing near left " .. #left .. " items, wanted the junk, the blue, the pearl, the rock")
    -- a capital: vendor and auction house, and a profession errand on the to-do list
    local c = Plan.new({ money = 0, recipes = { [1] = { [5498] = 1 } } })
    local _, ct, cl = Plan.mailbox(c, mail(), { vendor = true, auction = true, crafting = true })
    local cp = {}
    for _, e in ipairs(ct) do cp[#cp + 1] = e.plan end
    check(table.concat(cp, " ") == "vendor auction use craft", "a capital's mailbox took " .. table.concat(cp, " "))
    check(#cl == 1 and cl[1].plan == "junk", "a capital's mailbox didn't leave only the rock")
    check(#c.bag == 4, "what the mailbox took isn't in the bags")
    -- the profession item waits for a profession errand
    local p = Plan.new({ recipes = { [1] = { [5498] = 1 } } })
    local _, pt = Plan.mailbox(p, { { items = { PEARL() } } }, { vendor = true, auction = true, crafting = false })
    check(#pt == 0, "a reagent was taken with no profession errand on the to-do list")
    -- an unsold auction coming back is planned again, as a fresh pickup
    local u = Plan.new({ money = 0 })
    local back = BOE_BLUE()
    local _, ut = Plan.mailbox(u, { { items = { back } } }, { auction = true })
    check(#ut == 1 and ut[1].plan == "auction" and u.bag[1].item == back, "an unsold auction coming back wasn't planned again")
    -- money with items: the money is taken even when the items are left
    local g = Plan.new({ money = 10 })
    local gm, gt = Plan.mailbox(g, { { money = 55, items = { BOE_BLUE() } } }, { auction = false })
    check(gm == 55 and g.buddy.money == 65 and #gt == 0, "a letter's money wasn't taken when its item was left")
end
-- }}}

-- {{{ the referee, written from 617h2's decisions
-- Each item kind's plan, from the table in the issue's 2026-11-06 decision.
local function referee(i, b)
    local prof, known, ench = b.professions or {}, b.recipes or {}, (b.professions or {})[333]
    local free = not i.bound and i.bonding ~= 1
    local quality = i.class == 12 and 1 or i.quality                  -- quest items are judged white (2026-11-05)
    local goods   = i.class == 7 or (i.class == 12 and i.material)    -- and trade goods when a profession uses them
    if i.class == 12 and i.sell_price == 0 then return "leave" end
    if i.id == 6948 or i.tool or (i.class == 2 and i.subclass == 20) then return "keep" end
    if i.wear == "now" then return "wear" end
    if i.wear == "kept" then return "keep" end
    if i.openable then return "open" end
    if i.class == 9 and i.recipe and prof[i.recipe.skill] and prof[i.recipe.skill] >= i.recipe.rank
        and not known[i.recipe.teaches] then return "learn" end
    if i.class == 0 and i.food_type and b.pet_diet and b.pet_diet[i.food_type] then return "feed" end
    if i.class ~= 9 and (i.class == 0 or i.use) then return "use" end
    for _, r in pairs(known) do if r[i.id] then return "craft" end end
    if free then for _, m in ipairs(b.clan or {}) do if m.needs[i.id] then return "give" end end end
    if not free and i.de_skill and ench and ench >= i.de_skill then return "disenchant" end
    if free and (quality >= 2 or goods or i.class == 9) then return "auction" end
    if i.sell_price > 0 then return "vendor" end
    return "junk"
end
-- }}}

-- {{{ random buddies, random pickups
local AT_ONCE = { wear = true, open = true, learn = true, disenchant = true }
local function random_item(R, pool)
    if R(12) == 1 then local p = { HEARTH, PICK, POLE, CLAM, POTION, MEAT, RECIPE, PEARL }; return p[R(#p)]() end
    local i = item({
        id         = pool[R(#pool)],
        class      = ({ 0, 2, 4, 7, 9, 12, 15, 15 })[R(8)],
        subclass   = R(21) - 1,
        quality    = R(5) - 1,
        sell_price = R(4) == 1 and 0 or R(2000),
        count      = R(3),
    })
    i.bonding  = R(4) - 1
    i.bound    = i.bonding == 1 or R(6) == 1
    i.use      = R(4) == 1
    i.openable = R(25) == 1
    i.tool     = R(40) == 1
    i.food_type = R(3) == 1 and R(3) or nil
    i.de_skill = R(2) == 1 and R(300) or nil
    i.wear     = ({ "now", "kept", nil, nil, nil, nil, nil, nil })[R(8)]
    i.material = R(3) == 1
    if R(3) == 1 then i.auction = R(5000) end
    if i.class == 9 then
        i.recipe = { skill = ({ 755, 171, 164 })[R(3)], rank = R(300), teaches = 30000 + R(20),
                     reagents = { [pool[R(#pool)]] = 1, [pool[R(#pool)]] = 2 } }
    end
    return i
end

local seen, relearned, bought_total = {}, 0, 0         -- coverage: every plan comes up, learning changes plans, wants get bought
for run = 1, RUNS do
    math.randomseed(run * 977 + 13)
    local R = math.random
    local pool = {}
    for k = 1, 15 do pool[k] = 100 + k end
    local buddy = {
        professions = {}, recipes = {}, clan = {}, money = R(3) == 1 and R(20000) or 0, wants = {},
        pet_diet = R(3) == 1 and { [R(3)] = true } or nil,
    }
    for _, skill in ipairs({ 755, 171, 164, 333 }) do if R(2) == 1 then buddy.professions[skill] = R(300) end end
    if R(3) == 1 then buddy.recipes[29000] = { [pool[R(#pool)]] = 1 } end
    for k = 1, R(3) - 1 do buddy.clan[k] = { name = "mate" .. k, needs = { [pool[R(#pool)]] = true } } end
    for k = 1, R(3) - 1 do buddy.wants[k] = { name = "want" .. k, price = R(30000) } end
    local where = "run " .. run

    local s = Plan.new(buddy)
    local picked = {}
    for n = 1, 10 + R(30) do
        local it = random_item(R, pool)
        local before = {}
        for k, e in ipairs(s.bag) do before[k] = e.plan end
        local want = referee(it, s.buddy)
        local e, changes, _, now = Plan.pickup(s, it)
        local w = where .. " pickup " .. n
        check(e.plan == want, w .. ": planned " .. tostring(e.plan) .. ", the referee says " .. want)
        check(now == (AT_ONCE[e.plan] == true), w .. ": " .. e.plan .. " settled at once? " .. tostring(now))
        seen[e.plan] = true
        if e.plan == "learn" then relearned = relearned + #changes end
        local differ = 0
        for k, p in ipairs(before) do if s.bag[k].plan ~= p then differ = differ + 1 end end
        check(#changes == differ, w .. ": " .. #changes .. " changes listed, " .. differ .. " plans changed")
        if e.plan ~= "learn" then
            check(differ == 0, w .. ": a " .. e.plan .. " pickup changed " .. differ .. " held plans")
        end
        for _, ch in ipairs(changes) do
            check(ch.to == "craft" and ch.from ~= "craft" and ch.entry.plan == "craft", w .. ": learning changed a plan to " .. tostring(ch.to))
        end
        if not now and e.plan ~= "leave" then picked[#picked + 1] = it end
        if e.plan == "leave" then check(#s.bag == #picked, w .. ": an item left on the ground is in the bags") end
        if it.class ~= 12 and (it.id == 6948 or it.tool or (it.class == 2 and it.subclass == 20)) then   -- a quest item nobody pays for is left first
            check(e.plan == "keep", w .. ": the hearthstone, a tool or a pole isn't kept")
        end
        if it.bound or it.bonding == 1 then
            check(e.plan ~= "auction" and e.plan ~= "give", w .. ": a bound item planned " .. e.plan)
        end
    end

    -- every held plan is what the buddy, as it is now, would decide afresh
    for k, e in ipairs(s.bag) do
        check(e.plan == referee(e.item, s.buddy), where .. ": held plan " .. k .. " is stale")
        check(Plan.PLANS[e.plan].stays, where .. ": a plan settled at once is held")
    end
    check(#s.bag == #picked, where .. ": the bag holds " .. #s.bag .. " of " .. #picked)

    -- a login from the same bags, shuffled, works out the same plans
    local shuffled = {}
    for k, it in ipairs(picked) do shuffled[k] = it end
    for k = #shuffled, 2, -1 do local j = R(k); shuffled[k], shuffled[j] = shuffled[j], shuffled[k] end
    local l, done = Plan.login(s.buddy, shuffled)
    check(#done == 0, where .. ": a login settled something at once")
    local by_item = {}
    for _, e in ipairs(l.bag) do by_item[e.item] = e.plan end
    for _, e in ipairs(s.bag) do
        check(by_item[e.item] == e.plan, where .. ": login planned " .. tostring(by_item[e.item]) .. ", pickups " .. e.plan)
    end

    -- a want is ready exactly when money and planned sales cover it, cheapest first
    local left = s.buddy.money
    for _, e in ipairs(s.bag) do left = left + Plan.value(e.item, e.plan) end
    local ws = {}
    for _, wnt in ipairs(s.wants) do ws[#ws + 1] = wnt end
    table.sort(ws, function(a, b) if a.price ~= b.price then return a.price < b.price end return a.name < b.name end)
    for _, wnt in ipairs(ws) do
        local ready = left >= wnt.price
        if ready then left = left - wnt.price end
        check(wnt.state == (ready and "ready" or "saving"), where .. ": " .. wnt.name .. " is " .. wnt.state)
    end

    -- each place settles exactly the plans made for it, and the money adds up
    for _, place in ipairs({ "vendor", "mailbox", "auction" }) do
        local due, money, held = 0, s.buddy.money, #s.bag
        for _, e in ipairs(s.bag) do
            if Plan.PLANS[e.plan].at == place then
                due = due + 1
                if place == "vendor" then money = money + Plan.value(e.item, e.plan) end   -- only a vendor pays at once
            end
        end
        local deeds = Plan.settle(s, place)
        local boughts = 0
        local settled, bought = 0, 0
        for _, d in ipairs(deeds) do
            if d.act == "buy" then bought = bought + d.want.price; boughts = boughts + 1
            else settled = settled + 1; check(d.act == place or (place == "mailbox" and d.act == "give"), where .. ": " .. place .. " settled a " .. d.act) end
        end
        bought_total = (bought_total or 0) + boughts
        check(settled == due, where .. ": " .. place .. " settled " .. settled .. " of " .. due)
        check(#s.bag == held - due, where .. ": " .. place .. " left the bag at " .. #s.bag)
        check(s.buddy.money == money - bought, where .. ": " .. place .. "'s money is " .. s.buddy.money .. ", wanted " .. (money - bought))
        check(s.buddy.money >= 0, where .. ": money below zero")
        for _, e in ipairs(s.bag) do check(Plan.PLANS[e.plan].at ~= place, where .. ": " .. place .. " left a " .. e.plan) end
    end
    for _, wnt in ipairs(s.wants) do check(s.buddy.money < wnt.price, where .. ": a want the purse covers wasn't bought") end
end
for plan in pairs(Plan.PLANS) do check(seen[plan], "random runs never planned " .. plan) end
check(relearned > 0, "random runs never changed a plan by learning")
check((bought_total or 0) > 0, "random runs never bought a want")
-- }}}

print(string.format("test-buddy-item-plan: %d checks, %d failures", checks, #fails))
for _, f in ipairs(fails) do print("  FAIL: " .. f) end
print(#fails == 0 and "Result: all checks passed." or ("Result: " .. #fails .. " failure(s) shown."))
os.exit(#fails == 0 and 0 or 1)
-- ==== footer of test-buddy-item-plan ====
-- lines:      516
-- ==== end of footer ====
