#!/usr/bin/env luajit

local DIR = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end
local SRC = DIR .. "/patches/B036-mod-buddies/mod-buddies/src"

local NEEDS_WORLD = { "SetEnchantment%(", "SendEnchantmentLog%(", "%->GetOwner%(%)" }

local fails, checked, files = 0, 0, 0
local h = io.popen("ls '" .. SRC .. "'/*.cpp")
for path in h:lines() do
    files = files + 1
    local f = assert(io.open(path)); local text = f:read("*a"); f:close()
    local name = path:match("([^/]+)$")
    local current, body, first = nil, {}, 0
    local function judge()
        if not current then return end
        local code = table.concat(body, "\n")
        for _, call in ipairs(NEEDS_WORLD) do
            if code:find(call) then
                checked = checked + 1
                if not code:find("IsInWorld%(%)") then
                    fails = fails + 1
                    print(string.format("  FAIL: %s:%d %s calls %s without asking IsInWorld() first",
                        name, first, current, call:gsub("%%", "")))
                end
            end
        end
    end
    local n = 0
    for line in (text .. "\n"):gmatch("([^\n]*)\n") do
        n = n + 1
        local code = line:gsub("//.*$", "")
        local starts = code:match("^[%w_:<>%*&, ]+[%s%*&]([%w_:~]+)%s*%b()%s*[%w ]*$") or code:match("^[%w_:<>%*&, ]+[%s%*&]([%w_:~]+)%s*%(")
        if starts and not code:find(";%s*$") and not code:match("^%s") then
            judge()
            current, body, first = starts, {}, n
        end
        body[#body + 1] = code
    end
    judge()
end
h:close()

if files == 0 then print("test-buddy-made-out-of-world: no C++ files in " .. SRC); os.exit(1) end
if fails == 0 then
    print(string.format("test-buddy-made-out-of-world: all %d calls that need the world are guarded (%d files)", checked, files))
    os.exit(0)
end
print(string.format("test-buddy-made-out-of-world: %d of %d calls that need the world are not guarded", fails, checked))
os.exit(1)
