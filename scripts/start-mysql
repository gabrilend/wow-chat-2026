#!/bin/bash

DIR="/mnt/kaun/wow-chat-2026"
if [[ -n "$1" ]]; then
    DIR="$1"
fi

MYSQL_DIR="${DIR}/mysql"
INSTALL_DIR="${MYSQL_DIR}/installed-files"
CONF_FILE="${MYSQL_DIR}/conf/my.cnf"
DATA_DIR="${MYSQL_DIR}/databases"
PID_FILE="${DATA_DIR}/mysqld.pid"
SOCKET="${DATA_DIR}/mysql.sock"
ERROR_LOG="${DATA_DIR}/error.log"
MYSQLD_BIN="$(readlink -f "${INSTALL_DIR}/bin/mysqld")"
READY_TIMEOUT=60      # seconds; InnoDB crash recovery after an unclean stop can be slow

TMP_TARGET="/tmp/wow-chat-2"
if [[ ! -d "${TMP_TARGET}" ]]; then
    echo "Creating ${TMP_TARGET}..."
    mkdir -p "${TMP_TARGET}"
fi

is_our_mysqld() {
    local exe
    exe="$(readlink "/proc/${1}/exe" 2>/dev/null)" || return 1
    exe="${exe% (deleted)}"   # a mysqld started before the binary was reinstalled
    [[ "${exe}" == "${MYSQLD_BIN}" ]]
}

is_answering() {
    "${INSTALL_DIR}/bin/mysqladmin" --no-defaults --socket="${SOCKET}" \
        --connect-timeout=2 ping >/dev/null 2>&1
}

if [[ -f "${PID_FILE}" ]]; then
    PID="$(cat "${PID_FILE}")"
    if is_our_mysqld "${PID}"; then
        for i in $(seq 1 "${READY_TIMEOUT}"); do
            if is_answering; then
                echo "MySQL already running (PID ${PID})"
                exit 0
            fi
            sleep 1
        done
        echo "ERROR: MySQL process ${PID} is running but not answering on ${SOCKET} after ${READY_TIMEOUT} s"
        echo "  done:    found our mysqld by its PID file"
        echo "  stopped: it never answered a ping"
        echo "  to debug: tail ${ERROR_LOG} — is it doing crash recovery (wait), or stuck on a lock (another mysqld on this datadir)?"
        exit 1
    else
        echo "Removing stale PID file (process ${PID} is not this project's mysqld)"
        rm -f "${PID_FILE}"
    fi
fi

for OTHER_PID in $(pgrep -x mysqld); do
    if is_our_mysqld "${OTHER_PID}"; then
        echo "ERROR: this project's mysqld is already running as PID ${OTHER_PID}, but ${PID_FILE} is missing"
        echo "  to debug: stop it with 'kill ${OTHER_PID}' and run start-mysql again"
        exit 1
    fi
done

echo "Starting MySQL server..."
echo "Config: ${CONF_FILE}"
echo "Data:   ${DATA_DIR}"

"${INSTALL_DIR}/bin/mysqld" \
    --defaults-file="${CONF_FILE}" \
    --user="$(whoami)" \
    --pid-file="${PID_FILE}" \
    &
MYSQLD_PID=$!

for i in $(seq 1 "${READY_TIMEOUT}"); do
    if is_answering; then
        echo "MySQL started (PID ${MYSQLD_PID}, ready after ~${i} s)"
        echo "Socket: ${SOCKET}"
        echo "Port: 3307"
        exit 0
    fi
    if ! kill -0 "${MYSQLD_PID}" 2>/dev/null; then
        echo "ERROR: mysqld (PID ${MYSQLD_PID}) exited during startup"
        echo "  done:    launched mysqld"
        echo "  stopped: it quit before answering; last lines of ${ERROR_LOG}:"
        tail -n 15 "${ERROR_LOG}" | sed 's/^/    /'
        exit 1
    fi
    sleep 1
done

echo "ERROR: MySQL (PID ${MYSQLD_PID}) still not answering after ${READY_TIMEOUT} s; it is left running"
echo "  to debug: tail ${ERROR_LOG}; run start-mysql again to keep waiting"
exit 1
