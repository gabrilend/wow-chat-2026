#!/bin/bash
# start-mysql
# Starts the local MySQL server for wow-chat-2
# Ensures tmp/ symlink exists (destroyed on reboot since target is /tmp)

# {{{ set_dir
DIR="/home/ritz/games/azeroth-core/wow-chat-2026"
if [[ -n "$1" ]]; then
    DIR="$1"
fi
# }}}

# {{{ paths
MYSQL_DIR="${DIR}/mysql"
INSTALL_DIR="${MYSQL_DIR}/installed-files"
CONF_FILE="${MYSQL_DIR}/conf/my.cnf"
DATA_DIR="${MYSQL_DIR}/databases"
PID_FILE="${DATA_DIR}/mysqld.pid"
TMP_DIR="${DIR}/tmp"
# }}}

# {{{ ensure_tmp_symlink
# tmp/ is a symlink to /tmp/wow-chat-2 for RAM-backed temp storage
# target directory is destroyed on reboot, so recreate if missing
TMP_TARGET="/tmp/wow-chat-2"
if [[ ! -d "${TMP_TARGET}" ]]; then
    echo "Creating ${TMP_TARGET}..."
    mkdir -p "${TMP_TARGET}"
fi
# }}}

# {{{ check_running
if [[ -f "${PID_FILE}" ]]; then
    PID=$(cat "${PID_FILE}")
    if kill -0 "${PID}" 2>/dev/null; then
        echo "MySQL already running (PID ${PID})"
        exit 0
    else
        echo "Removing stale PID file"
        rm -f "${PID_FILE}"
    fi
fi
# }}}

# {{{ start
echo "Starting MySQL server..."
echo "Config: ${CONF_FILE}"
echo "Data:   ${DATA_DIR}"

"${INSTALL_DIR}/bin/mysqld" \
    --defaults-file="${CONF_FILE}" \
    --user=$(whoami) \
    --pid-file="${PID_FILE}" \
    &

# wait up to 10 seconds for PID file
for i in {1..10}; do
    if [[ -f "${PID_FILE}" ]]; then
        PID=$(cat "${PID_FILE}")
        echo "MySQL started (PID ${PID})"
        echo "Socket: ${DATA_DIR}/mysql.sock"
        echo "Port: 3307"
        exit 0
    fi
    sleep 1
done

echo "ERROR: MySQL failed to start"
echo "Check ${DATA_DIR}/error.log for details"
exit 1
# }}}
