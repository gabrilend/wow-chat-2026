#!/usr/bin/env luajit

local DIR, CHECK = "/mnt/kaun/wow-chat-2026", false
for _, a in ipairs(arg) do
    if a == "--help" or a == "-h" then
        for line in io.lines(arg[0]) do
            if not line:match("^%-%-") and not line:match("^#!") then break end
            if not line:match("^%-%-%-%-%-") and not line:match("^#!") then print((line:gsub("^%-%- ?", ""))) end
        end
        os.exit(0)
    elseif a == "--check" then CHECK = true
    elseif a:sub(1, 2) == "--" then io.stderr:write("generate-buddies-conf: unknown option " .. a .. " (see --help)\n"); os.exit(2)
    else DIR = a end
end
local SRC = DIR .. "/patches/B036-mod-buddies/mod-buddies/src"
local OUT = DIR .. "/patches/B036-mod-buddies/mod-buddies/conf/mod_buddies.conf.dist"

local files = {}
local list = io.popen('find "' .. SRC .. '" -type f \\( -name "*.cpp" -o -name "*.h" \\) | sort')
for f in list:lines() do files[#files + 1] = f end
list:close()
if #files == 0 then io.stderr:write("generate-buddies-conf: no sources under " .. SRC .. "\n"); os.exit(1) end

local settings, order = {}, {}
for _, path in ipairs(files) do
    local fh = assert(io.open(path))
    local text = fh:read("*a")
    fh:close()
    local short = path:sub(#SRC + 2)
    for kind, name, default in text:gmatch('GetOption<%s*([%w_:]+)%s*>%s*%(%s*"(Buddies%.[%w_%.]+)"%s*,%s*([^%)]-)%s*%)') do
        local s = settings[name]
        if not s then
            s = { name = name, kind = kind, default = default, files = {}, notes = {} }
            settings[name] = s
            order[#order + 1] = name
        elseif s.default ~= default then
            io.stderr:write(("generate-buddies-conf: %s is read with default %s in %s and %s elsewhere\n"):format(name, default, short, s.default))
            os.exit(1)
        end
        if not s.files[short] then
            s.files[short] = true
            for line in text:gmatch("[^\n]+") do
                local c = line:match("^%s*//%s?(.*)$") or line:match("^%s*%*%s?(.*)$")
                local pattern = (name:gsub("%.", "%%."))
                if c and (c:match("^" .. pattern .. "[^%w_.]") or c:match("^Switch:%s*" .. pattern .. "[^%w_.]")) then s.notes[#s.notes + 1] = c end
            end
        end
    end
end
table.sort(order)

local function default_text(s)
    local d = s.default
    if s.kind:find("string") then return (d:match('^"(.*)"$') or d) end
    return d
end
local out = {}
out[#out + 1] = "# mod_buddies.conf.dist - GENERATED by scripts/generate-buddies-conf from the buddy module's sources:"
out[#out + 1] = "# every setting it reads, at its default, with the notes beside it in the code. Don't edit; change the"
out[#out + 1] = "# code and run it again. The server's build installs it beside the other modules' settings; set a value"
out[#out + 1] = "# in mod_buddies.conf (or worldserver.conf) to change it."
out[#out + 1] = ""
out[#out + 1] = "[worldserver]"
for _, name in ipairs(order) do
    local s = settings[name]
    local where = {}
    for f in pairs(s.files) do where[#where + 1] = f end
    table.sort(where)
    out[#out + 1] = ""
    out[#out + 1] = "#    " .. name
    out[#out + 1] = "#        Read in " .. table.concat(where, ", ") .. " (" .. s.kind .. ")."
    local seen = {}
    for _, n in ipairs(s.notes) do
        if not seen[n] then seen[n] = true; out[#out + 1] = "#        " .. n end
    end
    out[#out + 1] = "#        Default: " .. default_text(s)
    out[#out + 1] = ""
    out[#out + 1] = name .. " = " .. default_text(s)
end
local text = table.concat(out, "\n") .. "\n"

if CHECK then
    local fh = io.open(OUT)
    local now = fh and fh:read("*a") or ""
    if fh then fh:close() end
    if now ~= text then
        print("generate-buddies-conf: " .. OUT:sub(#DIR + 2) .. " is behind the code (run scripts/generate-buddies-conf)")
        os.exit(1)
    end
    print("generate-buddies-conf: " .. OUT:sub(#DIR + 2) .. " matches the code (" .. #order .. " settings)")
    os.exit(0)
end
os.execute('mkdir -p "' .. OUT:match("^(.*)/") .. '"')
local fh = assert(io.open(OUT, "w"))
fh:write(text)
fh:close()
print("generate-buddies-conf: " .. #order .. " settings -> " .. OUT:sub(#DIR + 2))
