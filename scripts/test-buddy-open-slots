#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-open-slots
# profiles:   all
# priority:   10
# kind:       test
# about:      the "nearest open slot" follow mode holds to issue 617s8: one buddy to a slot, the tank in front, no trading mid-walk, the nearest free slot on arrival, a calm ring while the owner stands
# quick-test: yes
# ==== end of header ====
# test-buddy-open-slots - compiles and runs tests/buddy-open-slots/open-slots-check.cpp
# against the buddy module's open-slot follow mode (roam/buddy_open_slots_core.h,
# issue 617s8), with no server.
#
# Usage: scripts/test-buddy-open-slots [DIR]   (--help: this text)

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    sed -n '10,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
DIR="${1:-/mnt/kaun/wow-chat-2026}"
OUT="${DIR}/tmp/tmp"
mkdir -p "${OUT}"
g++ -std=c++17 -O1 -Wall -Wextra -Werror -I"${DIR}/patches/B036-mod-buddies/mod-buddies/src/roam" \
    "${DIR}/tests/buddy-open-slots/open-slots-check.cpp" -o "${OUT}/buddy-open-slots" || exit 1
nice -n 19 "${OUT}/buddy-open-slots"
# ==== footer of test-buddy-open-slots ====
# lines:      28
# ==== end of footer ====
