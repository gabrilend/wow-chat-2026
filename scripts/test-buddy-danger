#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-danger
# profiles:   all
# priority:   10
# kind:       test
# about:      the clan's danger holds to issue 617e10: rises fast, falls slowly, shrinks the leash step by step to the follow ring
# quick-test: yes
# ==== end of header ====
# test-buddy-danger - compiles and runs tests/buddy-danger/danger-check.cpp
# against the buddy module's danger reading (roam/buddy_danger_core.h,
# issue 617e10), with no server.
#
# Usage: scripts/test-buddy-danger [DIR]   (--help: this text)

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    sed -n '10,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
DIR="${1:-/mnt/kaun/wow-chat-2026}"
OUT="${DIR}/tmp/tmp"
mkdir -p "${OUT}"
g++ -std=c++17 -O1 -Wall -Wextra -Werror -I"${DIR}/patches/B036-mod-buddies/mod-buddies/src" \
    "${DIR}/tests/buddy-danger/danger-check.cpp" -o "${OUT}/buddy-danger" || exit 1
nice -n 19 "${OUT}/buddy-danger"
# ==== footer of test-buddy-danger ====
# lines:      28
# ==== end of footer ====
