#!/usr/bin/env luajit

local DIR = arg[1] or "/mnt/kaun/wow-chat-2026"
local DBC = DIR .. "/data-files/dbc/"
local OUT = DIR .. "/sql/basic/db_world.src/12-outland-without-tradeskills.apply.sql"

local LOCKTYPE_HERBALISM, LOCKTYPE_MINING = 2, 3
local LOCK_KEY_SKILL = 2
local OUTLAND_ZONES = { 3483, 3518, 3519, 3520, 3521, 3522, 3523, 3703, 4080 }
local RANK_WORDS = { "Alchemist", "Blacksmith", "Enchanter", "Engineer", "Herbalist", "Jewelcrafter",
                     "Leatherworker", "Miner", "Skinner", "Tailor", "Scribe", "Cook", "Fishing", "First Aid" }
local BEGIN_MARK = "-- >>> GENERATED by scripts/generate-basic-outland-tradeskills-sql"
local END_MARK   = "-- <<< GENERATED END"

local function die(msg)
    io.stderr:write("generate-basic-outland-tradeskills-sql: ", msg, "\n")
    os.exit(1)
end

local function load_dbc(name)
    local f = io.open(DBC .. name, "rb") or die("cannot open " .. DBC .. name)
    local d = f:read("*a")
    f:close()
    if d:sub(1, 4) ~= "WDBC" then die(name .. " is not a WDBC file") end
    local function u32(o) local a, b, c, e = d:byte(o + 1, o + 4); return a + b * 256 + c * 65536 + e * 16777216 end
    local n, rs = u32(4), u32(12)
    local sb = 20 + n * rs
    local function str(o) local so = sb + u32(o); local e = d:find("\0", so + 1, true); return d:sub(so + 1, e - 1) end
    return n, rs, u32, str
end

local function herb_and_ore_locks()
    local n, rs, u32 = load_dbc("Lock.dbc")
    local ids = {}
    for i = 0, n - 1 do
        local o = 20 + i * rs
        for k = 0, 7 do
            if u32(o + (1 + k) * 4) == LOCK_KEY_SKILL then
                local lt = u32(o + (9 + k) * 4)
                if lt == LOCKTYPE_HERBALISM or lt == LOCKTYPE_MINING then ids[#ids + 1] = u32(o); break end
            end
        end
    end
    table.sort(ids)
    return ids
end

local function outland_areas()
    local n, rs, u32 = load_dbc("AreaTable.dbc")
    local parent = {}
    for i = 0, n - 1 do local o = 20 + i * rs; parent[u32(o)] = u32(o + 8) end
    local zone = {}
    for _, z in ipairs(OUTLAND_ZONES) do zone[z] = true end
    local ids = {}
    for id in pairs(parent) do
        if not zone[id] then
            local p, hops = parent[id], 0
            while p and p ~= 0 and not zone[p] and hops < 8 do p = parent[p]; hops = hops + 1 end
            if p and zone[p] then ids[#ids + 1] = id end
        end
    end
    table.sort(ids)
    return ids
end

local function rank_spells()
    local n, rs, u32, str = load_dbc("Spell.dbc")
    local want = {}
    for _, w in ipairs(RANK_WORDS) do
        want["Master " .. w] = true
        want["Grand Master " .. w] = true
    end
    local ids = {}
    for i = 0, n - 1 do
        local o = 20 + i * rs
        if want[str(o + 136 * 4)] then ids[#ids + 1] = u32(o) end
    end
    table.sort(ids)
    return ids
end

local function rows(ids)
    local out = {}
    for _, id in ipairs(ids) do out[#out + 1] = "(" .. id .. ")" end
    return table.concat(out, ",")
end

local locks, areas, ranks = herb_and_ore_locks(), outland_areas(), rank_spells()
if #locks == 0 or #areas == 0 or #ranks == 0 then die("an empty list (locks " .. #locks .. ", areas " .. #areas .. ", ranks " .. #ranks .. "); the client files may have moved") end
local block = table.concat({
    BEGIN_MARK .. " — do not edit by hand",
    "-- herb and ore locks (Lock.dbc, skill lock types 2 and 3): " .. #locks,
    "INSERT INTO `tmp_155n_locks` (`lock_id`) VALUES " .. rows(locks) .. ";",
    "-- named areas inside Outland's zones, Shattrath and the Isle (AreaTable.dbc): " .. #areas,
    "INSERT INTO `tmp_155n_areas` (`area_id`) VALUES " .. rows(areas) .. ";",
    "-- Master and Grand Master rank spells (Spell.dbc, by name): " .. #ranks,
    "INSERT INTO `tmp_155n_rank_spells` (`spell_id`) VALUES " .. rows(ranks) .. ";",
    END_MARK }, "\n")
local f = io.open(OUT, "r") or die("cannot open " .. OUT)
local sql = f:read("*a")
f:close()
local a = sql:find(BEGIN_MARK, 1, true)
local b = sql:find(END_MARK, 1, true)
if not a or not b or b < a then die("markers not found in " .. OUT) end
sql = sql:sub(1, a - 1) .. block .. sql:sub(b + #END_MARK)
f = assert(io.open(OUT, "w"))
f:write(sql)
f:close()
io.write(string.format("wrote %d locks, %d areas, %d rank spells into %s\n", #locks, #areas, #ranks, OUT))
