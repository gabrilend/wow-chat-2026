#!/usr/bin/env bash

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$DIR"

if [[ $# -lt 1 ]]; then
    echo "Usage: $0 <profile> [--no-rebuild]"
    echo ""
    echo "Profiles: release, alpha, beta"
    exit 1
fi

TARGET_PROFILE="$1"
NO_REBUILD=false

if [[ "${2:-}" == "--no-rebuild" ]]; then
    NO_REBUILD=true
fi

case "$TARGET_PROFILE" in
    release|alpha|beta)
        ;;
    *)
        echo "Error: Unknown profile '$TARGET_PROFILE'"
        echo "Valid profiles: release, alpha, beta"
        exit 1
        ;;
esac

if [[ -f ".current-profile" ]]; then
    CURRENT_PROFILE="$(cat .current-profile)"
else
    CURRENT_PROFILE="unknown"
fi

echo "==============================================================================="
echo "Profile Transition: $CURRENT_PROFILE → $TARGET_PROFILE"
echo "==============================================================================="
echo ""

if [[ "$CURRENT_PROFILE" == "$TARGET_PROFILE" ]]; then
    echo "Already on $TARGET_PROFILE profile."
    echo ""
    echo "Current state:"
    echo "  Profile: $TARGET_PROFILE"
    echo "  Branch:  $(cd source && git branch --show-current)"
    echo ""
    exit 0
fi

echo "Step 1: Checking out $TARGET_PROFILE branch in source/"
cd source
git checkout "$TARGET_PROFILE"
BRANCH="$(git branch --show-current)"
echo "  ✓ On branch: $BRANCH"
echo ""
cd ..

echo "Step 2: Updating .current-profile"
echo "$TARGET_PROFILE" > .current-profile
echo "  ✓ Profile set to: $TARGET_PROFILE"
echo ""

if [[ "$NO_REBUILD" == "true" ]]; then
    echo "Step 3: Rebuild SKIPPED (--no-rebuild flag)"
    echo ""
else
    echo "Step 3: Rebuilding for $TARGET_PROFILE profile"
    echo "  Command: ./scripts/azerothcore update"
    echo ""

    read -p "Proceed with rebuild? [Y/n] " -n 1 -r
    echo

    if [[ $REPLY =~ ^[Yy]$ ]] || [[ -z $REPLY ]]; then
        ./scripts/azerothcore update
    else
        echo "  Rebuild cancelled"
        echo ""
    fi
fi

echo "==============================================================================="
echo "Profile Switch Complete"
echo "==============================================================================="
echo ""
echo "Profile: $TARGET_PROFILE"
echo "Branch:  $(cd source && git branch --show-current)"
echo "Source:  source/"
echo "Build:   build-$TARGET_PROFILE/"
echo "Install: installed-files-$TARGET_PROFILE/"
echo ""
echo "To start servers:"
echo "  ./scripts/start-mysql"
echo "  ./scripts/azerothcore worldserver"
echo ""
