#!/usr/bin/env luajit
-- generate-basic-buddy-selector-sql - place a Sargobras in each starting
-- valley, a few steps in front of where new characters arrive (issue 617b).
--
-- For a general audience: every new character is owed its first buddy, and
-- Sargobras waits in the starting valley to let them choose it. Where each
-- valley's newcomers arrive is written in the world database (the table the
-- server uses to place a new character). This tool reads those arrival
-- points and writes one Sargobras spawn per valley, four yards ahead of the
-- arrival point and facing it, into the SQL that installs him. Re-running
-- replaces only that block.
--
-- Usage: scripts/generate-basic-buddy-selector-sql [PROJECT_DIR] [WORLD_DB]
--   Reads   WORLD_DB (default acore_world_release) on the project MySQL,
--           read-only: playercreateinfo (arrival points; death knights,
--           who arrive in Acherus, left out)
--   Writes  sql/basic/db_world.src/26-buddy-selector.apply.sql (GENERATED block)

local DIR   = arg[1] or "/mnt/kaun/wow-chat-2026"
local DB    = arg[2] or "acore_world_release"
local OUT   = DIR .. "/sql/basic/db_world.src/26-buddy-selector.apply.sql"
local MYSQL = DIR .. "/mysql/installed-files/bin/mysql -h127.0.0.1 -P3307 -uritz -pmenardi -N --batch " .. DB

-- {{{ configuration
local ENTRY      = 6170001      -- the valley Sargobras
local FIRST_GUID = 6170001      -- valley spawns count up from here (range to 6170099)
-- Spawn ids must stay below 16777215 (0xFFFFFF): the server keeps the next
-- free spawn id at MAX(guid)+1 and stops dead at startup the first time it
-- hands one out past that cap ("Creature spawn id overflow", TCE00007).
-- The earlier issue-times-100000 range (61700001) did exactly that.
-- Where he stands. Each valley's first quest giver stands just ahead of
-- the arrival point too, and straight ahead put Sargobras on top of every
-- one of them (2026-10-13, owner: "spawns right in-front of the player,
-- and right on-top of a quest giver"; within 2 yards in all eight valleys).
-- So spots are tried in order, nearest the line of sight first: each
-- distance, then each turn from straight ahead, both sides; the first one
-- at least CLEAR yards from every other creature, on ground no more than
-- MAX_STEP above or below the arrival point (more is a wall, a step into a
-- building, or a drop), is taken. None fits: the tool stops, naming the
-- valley, rather than putting him back on someone.
local DISTANCES  = { 4, 6, 8, 10 }                     -- yards from the arrival point
local TURNS      = { 0, 35, -35, 70, -70, 105, -105 }  -- degrees off straight ahead
local CLEAR      = 5            -- yards from any other creature
local LOOK_ROUND = 20           -- creatures this near the arrival point are checked
local MAX_STEP   = 2            -- yards of ground height away from the arrival point's
local CROWD_DB   = "acore_world_basic"                 -- whose creatures he must stand clear of
local Heights    = dofile(DIR .. "/scripts/lib/map-heights.lua")
local BEGIN_MARK = "-- >>> GENERATED by scripts/generate-basic-buddy-selector-sql"
local END_MARK   = "-- <<< GENERATED END"
-- }}}

-- {{{ local function die
local function die(msg)
    io.stderr:write("generate-basic-buddy-selector-sql: ", msg, "\n")
    os.exit(1)
end
-- }}}

-- {{{ local function query
local function query(sql)
    local p = io.popen(MYSQL .. " -e \"" .. sql .. "\" 2>&1")
    local rows = {}
    for line in p:lines() do
        if line:find("^mysql: %[Warning%]") then
            -- the password-on-command-line notice; not an error
        elseif line:find("^ERROR") then
            die("query failed: " .. line)
        else
            local r = {}
            for v in line:gmatch("[^\t]+") do r[#r + 1] = tonumber(v) or v end
            rows[#rows + 1] = r
        end
    end
    p:close()
    return rows
end
-- }}}

-- {{{ main
-- One arrival point per valley: the races sharing a valley (dwarves and
-- gnomes, orcs and trolls) arrive at the same spot, so group by map and
-- zone and take that spot. Death knights arrive in Acherus: left out.
local valleys = query("SELECT map, zone, MIN(position_x), MIN(position_y), MIN(position_z), MIN(orientation), "
    .. "GROUP_CONCAT(DISTINCT race ORDER BY race) FROM playercreateinfo WHERE class <> 6 GROUP BY map, zone ORDER BY map, zone")
if #valleys ~= 8 then die("expected 8 starting valleys, found " .. #valleys) end

local lines = { BEGIN_MARK,
    "-- one per starting valley: the first spot near the arrival point clear of every other creature (" .. CLEAR
        .. " yards), facing the arrival point" }
lines[#lines + 1] = "INSERT INTO `creature` (`guid`, `id`, `map`, `spawnMask`, `phaseMask`, `position_x`, `position_y`, `position_z`, `orientation`, `spawntimesecs`, `Comment`) VALUES"
local terrains = {}
for i, v in ipairs(valleys) do
    local map, zone, x, y, z, o, races = v[1], v[2], v[3], v[4], v[5], v[6], tostring(v[7])
    terrains[map] = terrains[map] or Heights.map(DIR, map)
    local terrain = terrains[map]
    -- everyone standing near the arrival point, as basic has them (its own
    -- additions too, such as the arena pedestals in some valleys), but
    -- not the valley Sargobras himself
    local near = query(string.format("SELECT position_x, position_y FROM %s.creature WHERE map = %d AND id <> %d AND POW(position_x - (%f), 2) + POW(position_y - (%f), 2) < %d",
        CROWD_DB, map, ENTRY, x, y, LOOK_ROUND * LOOK_ROUND))
    -- the arrival point's own ground, against which a spot's ground is
    -- compared (its z is where a newcomer stands, maybe a little above)
    local home = terrain:smooth_height(x, y) or die(string.format("zone %d: no map file under the arrival point (%.1f, %.1f) on map %d", zone, x, y, map))
    local sx, sy, sz, tried = nil, nil, nil, 0
    for _, d in ipairs(DISTANCES) do
        for _, t in ipairs(TURNS) do
            local a  = o + math.rad(t)
            local cx, cy = x + math.cos(a) * d, y + math.sin(a) * d
            local g  = terrain:smooth_height(cx, cy)
            local ok = g ~= nil and math.abs(g - home) <= MAX_STEP
            for _, c in ipairs(near) do
                if ok and (c[1] - cx) ^ 2 + (c[2] - cy) ^ 2 < CLEAR * CLEAR then ok = false end
            end
            tried = tried + 1
            if ok then sx, sy, sz = cx, cy, z + (g - home) break end
        end
        if sx then break end
    end
    if not sx then
        die(string.format("zone %d (races %s): none of %d spots near the arrival point (%.1f, %.1f) is %d yards clear of the %d creatures within %d yards"
            .. " on ground within %d yards of its height. To debug: widen DISTANCES or TURNS, or lower CLEAR", zone, races, tried, x, y, CLEAR, #near, LOOK_ROUND, MAX_STEP))
    end
    local face = math.atan2(y - sy, x - sx) % (2 * math.pi)     -- toward the arrival point
    print(string.format("  zone %4d (races %-5s): %.1f yards from the arrival point, %d of %d spots tried, %d creatures near",
        zone, races, math.sqrt((sx - x) ^ 2 + (sy - y) ^ 2), tried, #DISTANCES * #TURNS, #near))
    lines[#lines + 1] = string.format("  (%d, %d, %d, 1, 1, %.1f, %.1f, %.1f, %.2f, 300, 'issue 617b: valley Sargobras, zone %d (races %s)')%s",
        FIRST_GUID + i - 1, ENTRY, map, sx, sy, sz, face, zone, races, i < #valleys and "," or ";")
end
lines[#lines + 1] = END_MARK

local f = io.open(OUT) or die("cannot read " .. OUT)
local sql = f:read("*a")
f:close()
local a = sql:find(BEGIN_MARK, 1, true)
local b = select(2, sql:find(END_MARK, 1, true))
if not a or not b then die(OUT .. " lacks the GENERATED markers") end
sql = sql:sub(1, a - 1) .. table.concat(lines, "\n") .. sql:sub(b + 1)
f = io.open(OUT, "w") or die("cannot write " .. OUT)
f:write(sql)
f:close()
print(string.format("generate-basic-buddy-selector-sql: %d valley spawns -> %s", #valleys, OUT))
-- }}}
