#!/usr/bin/env luajit

local DIR = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end

local fails, checks = 0, 0
local function check(ok, what)
    checks = checks + 1
    if not ok then fails = fails + 1; print("  FAIL: " .. what) end
end

local here = (arg[0]:match("^(.*[/\\])") or "./")
local Toy = dofile(here .. "lib/toy-world.lua")
local World, advance = Toy.World, Toy.advance

local quiet = print
print = function() end
dofile(DIR .. "/src/lua-beta/hearthstone.lua")
print = quiet
local GH = GroupHearth
local function START(p, spell) Toy.spellEvent(1, p, spell or 8690) end
local function CANCEL(p, spell) Toy.spellEvent(3, p, spell or 8690, true) end
local CAST = Toy.handlers[5][#Toy.handlers[5]]

local function dist(a, b) return math.sqrt((a.x - b.x) ^ 2 + (a.y - b.y) ^ 2) end

do
    for n = 2, 40 do
        local spots = GH.circle(100, 200, n)
        local closest, centreGap = math.huge, math.huge
        for i = 1, n do
            centreGap = math.min(centreGap, dist(spots[i], { x = 100, y = 200 }))
            for j = i + 1, n do closest = math.min(closest, dist(spots[i], spots[j])) end
        end
        check(#spots == n, "a group of " .. n .. " should get " .. n .. " places")
        check(centreGap >= 2.999, "nobody should stand on the hearther's spot (group of " .. n .. ")")
        check(n < 3 or closest >= 2.4, "places should be at least 2.5 yards apart in a group of " .. n .. ", closest " .. closest)
    end
end

local function party()
    World.events = {}
    GH.lastOpen, GH.riding = {}, {}
    local ann, bea, cid, dot = Toy.new_player("Ann", 401), Toy.new_player("Bea", 402),
                               Toy.new_player("Cid", 403), Toy.new_player("Dot", 404)
    dot.bot = true
    ann.home = { mapId = 1, x = 500, y = 600, z = 10 }
    Toy.chardb.homebind[401] = 14
    for _, p in ipairs({ ann, bea, cid, dot }) do Toy.login(p) end
    Toy.group({ ann, bea, cid, dot })
    return ann, bea, cid, dot
end
local function done(p) CAST(5, p, Toy.spell(8690)) end

do
    local ann, bea, cid, dot = party()
    local ok, err = pcall(START, ann)
    check(ok, "starting a hearth should not raise an error (" .. tostring(err) .. ")")
    check(bea.window ~= nil and cid.window ~= nil, "each other player should be asked in a window")
    check(ann.window == nil, "the hearther should not be asked")
    check(dot.window == nil, "a bot should not be shown a window")
    check(dot.casts[1] == 8690, "a bot always comes: it starts its own hearthstone at once")
    local hasPopup = false
    for _, it in ipairs(bea.window and bea.window.items or {}) do if it.popup then hasPopup = true end end
    check(hasPopup, "'come along' should carry a confirm box (the okay/cancel)")
    local text = bea.window and bea.window.items[1].text or ""
    check(text == "Ann is hearthing to Durotar. Come along?", "the window should say where the hearther is going (got: " .. text .. ")")
    Toy.answer(bea, 1)
    check(bea.window == nil, "an answer should close the window")
    check(bea.casts[1] == 8690 and bea.cooldownResets == 1, "okay starts Bea's own hearthstone, its cooldown cleared first")
    check(#ann.casts == 0, "a rider's cast should not invite the group again")
    CAST(5, ann, Toy.spell(8690))
    check(cid.window == nil, "when the hearther's cast ends, a window still open closes as a no")
    advance(1600)
    check(#bea.teleports == 0 and #dot.teleports == 0, "riders arrive by their own hearthstones, not the hearther's")
    done(bea)
    done(dot)
    advance(1600)
    check(#bea.teleports == 1, "Bea's own hearthstone completing puts her on the circle")
    check(#cid.teleports == 0, "Cid, who never answered, stays")
    check(#dot.teleports == 1, "the bot arrives by its own hearthstone")
    check(#ann.teleports == 0, "the hearther travels by their own hearthstone, not by this")
    local spots = GH.circle(500, 600, 4)
    local t = bea.teleports[1]
    check(t and t.map == 1 and math.abs(t.x - spots[2].x) < 1e-6 and math.abs(t.y - spots[2].y) < 1e-6,
          "Bea (second in the group) should stand at the second place round the hearther's bind point, not her own")
    check(dot.teleports[1] and math.abs(dot.teleports[1].x - spots[4].x) < 1e-6, "the bot (fourth) should stand at the fourth place")
    check(next(GH.pending) == nil and next(GH.riding) == nil, "the hearth and the rides should be forgotten once done")
    for _, p in ipairs({ ann, bea, cid, dot }) do Toy.logout(p) end
end

do
    local ann, bea, cid, dot = party()
    START(ann)
    Toy.answer(bea, 1)
    bea:InterruptSpell(1)
    advance(2100)
    check(#bea.casts == 2, "an interrupted ride should start Bea's hearthstone again a moment later")
    for _ = 1, 6 do bea:InterruptSpell(1); advance(2100) end
    check(GH.riding[bea:GetGUID()] == nil, "interrupted too often, the ride ends")
    check(bea.messages[#bea.messages]:match("interrupted too often"), "and she is told why")
    for _, p in ipairs({ ann, bea, cid, dot }) do Toy.logout(p) end
end

do
    local ann, bea, cid, dot = party()
    START(ann)
    Toy.answer(bea, 1)
    CANCEL(ann)
    check(cid.window == nil, "a cancelled hearth should close the windows still open")
    check(bea.casting == nil and dot.casting == nil, "a cancelled hearth should stop the riders' own hearthstones")
    check(next(GH.pending) == nil and next(GH.riding) == nil, "a cancelled hearth should be forgotten, rides and all")
    CAST(5, ann, Toy.spell(8690))
    advance(2000)
    check(#bea.teleports == 0 and #dot.teleports == 0, "a completion after the hearth was called off should move nobody")
    for _, p in ipairs({ ann, bea, cid, dot }) do Toy.logout(p) end
end

do
    local ann, bea, cid, dot = party()
    START(ann)
    Toy.answer(bea, 1)
    Toy.logout(bea)
    CAST(5, ann, Toy.spell(8690))
    done(dot)
    local ok, err = pcall(advance, 1600)
    check(ok, "a member logging out before the move should not raise an error (" .. tostring(err) .. ")")
    check(#bea.teleports == 0 and GH.riding[bea:GetGUID()] == nil, "a member who logged out should not be moved, their ride forgotten")
    check(#dot.teleports == 1, "the others should still come")
    for _, p in ipairs({ ann, cid, dot }) do Toy.logout(p) end
end

do
    local ann, bea, cid, dot = party()
    Toy.chardb.ignores[402] = { [401] = true }
    START(ann)
    check(bea.window == nil, "a member ignoring the hearther is never asked")
    check(cid.window ~= nil, "the others still are")
    Toy.chardb.ignores = {}
    for _, p in ipairs({ ann, bea, cid, dot }) do Toy.logout(p) end

    ann, bea, cid, dot = party()
    local real = GH.skip
    GH.skip = function(m) return m == dot end
    START(ann)
    check(#dot.casts == 0 and not GH.pending[ann:GetGUID()].accepted[dot:GetGUID()], "a member the profile skips is neither asked nor brought")
    GH.skip = real
    for _, p in ipairs({ ann, bea, cid, dot }) do Toy.logout(p) end
end

do
    World.events = {}
    GH.lastOpen = {}
    local solo = Toy.new_player("Solo", 410)
    Toy.login(solo)
    local ok = pcall(START, solo)
    check(ok and next(GH.pending) == nil, "a hearthstone used alone should open no group hearth")
    Toy.logout(solo)
    local ann, bea = party()
    START(ann)
    Toy.answer(bea, 1)
    CAST(5, ann, Toy.spell(133))
    advance(1600)
    check(#bea.teleports == 0, "another spell completing should not move the group")
    for _, p in pairs(World.players) do if not p.gone then Toy.logout(p) end end
end

do
    local ann, bea, cid, dot = party()
    START(ann, 556)
    check(bea.window ~= nil, "Astral Recall beginning should ask the group, as a Hearthstone does")
    Toy.answer(bea, 1)
    check(bea.casts[1] == 8690, "a member who says yes rides on their own Hearthstone")
    CAST(5, ann, Toy.spell(556))
    done(bea)
    done(dot)
    advance(1600)
    check(#bea.teleports == 1 and #dot.teleports == 1, "Astral Recall's riders arrive on its circle")
    for _, p in ipairs({ ann, bea, cid, dot }) do Toy.logout(p) end
end

do
    local ann, bea, cid, dot = party()
    START(ann)
    Toy.answer(bea, 1)
    Toy.logout(ann)
    check(next(GH.pending) == nil, "a hearther logging out mid-cast should withdraw their hearth")
    check(cid.window == nil, "and close the windows still open")
    for _, p in ipairs({ bea, cid, dot }) do Toy.logout(p) end

    ann, bea, cid, dot = party()
    START(ann)
    local first = GH.pending[ann:GetGUID()].id
    START(ann)
    check(GH.pending[ann:GetGUID()].id == first, "a cast begun again within 10 seconds asks nobody again")
    check(ann.messages[#ann.messages] and ann.messages[#ann.messages]:match("wait a few seconds"), "and the hearther is told to wait")
    advance(10001)
    START(ann)
    check(GH.pending[ann:GetGUID()].id ~= first, "10 seconds later, a cast begun again opens a new hearth")
    check(bea.window ~= nil and bea.window.items[1].sender ~= first, "and the window should be the new hearth's")
    for _, p in ipairs({ ann, bea, cid, dot }) do Toy.logout(p) end
end

do
    local ann, bea, cid, dot = party()
    local h = GH.open(ann, { question = "%s goes to %s. Visit?", confirm = "Visit with %s in %s?" }, "the glade")
    check(h ~= nil and bea.window.items[1].text == "Ann goes to the glade. Visit?", "another script's kind should bring its own words and place")
    Toy.answer(bea, 1)
    Toy.answer(cid, 2)
    local taken, size = GH.take(ann:GetGUID())
    check(size == 4 and #taken == 2, "take should give those who said yes and the bot, with the group's size (" .. #taken .. ", " .. size .. ")")
    check(taken[1] and taken[1].guid == bea:GetGUID() and taken[1].place == 2, "each with their number in the group")
    check(next(GH.pending) == nil, "take should close the hearth")
    local again = GH.take(ann:GetGUID())
    check(#again == 0, "taking again should give nobody")
    for _, p in ipairs({ ann, bea, cid, dot }) do Toy.logout(p) end
end

do
    local ann, bea, cid, dot = party()
    Toy.chardb.homebind[401] = nil
    local said = {}
    local real = print
    print = function(...) said[#said + 1] = table.concat({ ... }, " ") end
    START(ann)
    print = real
    check(bea.window == nil and next(GH.pending) == nil, "with no bind row, nobody should be invited")
    check(said[1] and said[1]:match("no character_homebind row"), "and the server log should say why")
    for _, p in ipairs({ ann, bea, cid, dot }) do Toy.logout(p) end
end

print(string.format("%d checks, %d failed", checks, fails))
os.exit(fails == 0 and 0 or 1)
