#!/usr/bin/env luajit
-- generate-fish-sandbox-data - the continents, their zones, and the places
-- each kind of monster spawns ("fences"), as data for the fish-school
-- sandbox page (issue 617e16).
--
-- For a general audience: the owner wants to watch a school of bots flow
-- round the place a kind of monster lives ("paint a sub-zone (monster
-- spawning location zone) with a yellow fence, and the bots (green dots)
-- will wander around there"). This gathers what the page draws:
--   the continents: every zone's squares and sub-zones, from the zone data
--     scripts/generate-zone-maps wrote (assets/zone-maps/);
--   the fences: for each zone, each kind of monster's spawns from the world
--     database (monsters: not friendly to either side's players), gathered
--     where they lie within LINK yards of one another
--     (one kind can live in several places); a group of at least MIN_SPAWNS
--     becomes a fence: the outline round its spawns (their convex hull),
--     pushed out SPARE yards, named after the monster.
-- It writes assets/fish-sandbox/sandbox-data.js (a script the page loads
-- inline: window.SANDBOX = {...}); scripts/generate-fish-sandbox-page puts
-- it into the page.
--
-- Usage: scripts/generate-fish-sandbox-data [PROJECT_DIR] [--map M]...
--   --map  default 0 and 1 (Eastern Kingdoms, Kalimdor)

-- {{{ configuration
local DIR, MAPS = "/mnt/kaun/wow-chat-2026", {}
do
    local i = 1
    while i <= #arg do
        if arg[i] == "--map" then i = i + 1; MAPS[#MAPS + 1] = tonumber(arg[i]) else DIR = arg[i] end
        i = i + 1
    end
end
if #MAPS == 0 then MAPS = { 0, 1 } end
local NAMES      = { [0] = "Eastern Kingdoms", [1] = "Kalimdor", [530] = "Outland", [571] = "Northrend" }
local WORLD_DB   = "acore_world_basic"
local MYSQL      = DIR .. "/mysql/installed-files/bin/mysql --defaults-file=" .. DIR .. "/mysql/conf/client.cnf -h127.0.0.1 -P3307 -N -B " .. WORLD_DB
local OUT        = DIR .. "/assets/fish-sandbox/sandbox-data.js"
local G          = 533.3333                    -- yards a map grid
local LINK       = 90                          -- spawns this near are one place (45 at first made fences too small
                                               -- for 36 bots to circle in: 2026-10-28, none of 36 circling)
local MIN_SPAWNS = 4                           -- fewer: not a fence
local SPARE      = 15                          -- yards the outline is pushed out
local MAX_FENCES = 60                          -- per zone, the largest
local CRITTER    = 8                           -- creature_template.type
local PLAYER_TEMPLATES = { 1, 2 }              -- the faction templates of a human and an orc player
-- }}}

-- {{{ monsters: not friendly to either side's players
-- The faction table's own rule (FactionTemplateEntry::IsFriendlyTo): a named
-- enemy faction is never a friend; a named friend faction is; else the
-- friendly masks meet. A spawn friendly to either side (guards, town folk,
-- a camp of Theramore Marines, which the first fences were made of) is not
-- a monster; neutral beasts (Plainstriders) are, as players quest on them.
local friendly_to_a_side = {}
do
    local ffi = require("ffi")
    local path = DIR .. "/data-files/dbc/FactionTemplate.dbc"
    local fh = io.open(path, "rb") or error("generate-fish-sandbox-data: cannot open " .. path)
    local d = fh:read("*a"); fh:close()
    local p = ffi.cast("const uint8_t*", d)
    local h = ffi.cast("const uint32_t*", p)
    local recs, size = h[1], h[3]
    local function u(r, i) return ffi.cast("const uint32_t*", p + 20 + r * size + i * 4)[0] end
    local rows = {}
    for r = 0, recs - 1 do
        rows[u(r, 0)] = { faction = u(r, 1), our = u(r, 3), friendly = u(r, 4),
                          enemies = { u(r, 6), u(r, 7), u(r, 8), u(r, 9) }, friends = { u(r, 10), u(r, 11), u(r, 12), u(r, 13) } }
    end
    local function friendly(e, p)
        for i = 1, 4 do if e.enemies[i] ~= 0 and e.enemies[i] == p.faction then return false end end
        for i = 1, 4 do if e.friends[i] ~= 0 and e.friends[i] == p.faction then return true end end
        return bit.band(e.friendly, p.our) ~= 0 or bit.band(e.our, p.friendly) ~= 0
    end
    for id, e in pairs(rows) do
        for _, t in ipairs(PLAYER_TEMPLATES) do
            if rows[t] and friendly(e, rows[t]) then friendly_to_a_side[id] = true end
        end
    end
end
-- }}}

local function die(m) io.stderr:write("generate-fish-sandbox-data: " .. m .. "\n"); os.exit(1) end

-- {{{ local function query(sql)
local function query(sql)
    local file = os.tmpname()
    local w = io.open(file, "w"); w:write(sql, ";\n"); w:close()
    local h = io.popen(MYSQL .. " < '" .. file .. "' 2>&1")
    local rows = {}
    for line in h:lines() do
        if line:find("^ERROR") then os.remove(file); die("MySQL said: " .. line) end
        local r = {}
        for v in (line .. "\t"):gmatch("([^\t]*)\t") do r[#r + 1] = v end
        rows[#rows + 1] = r
    end
    h:close()
    os.remove(file)
    return rows
end
-- }}}

-- {{{ local function hull(points)
-- The convex hull (Andrew's monotone chain), counter-clockwise.
local function hull(pts)
    table.sort(pts, function(a, b) return a[1] < b[1] or (a[1] == b[1] and a[2] < b[2]) end)
    if #pts < 3 then return pts end
    local function cross(o, a, b) return (a[1] - o[1]) * (b[2] - o[2]) - (a[2] - o[2]) * (b[1] - o[1]) end
    local lower, upper = {}, {}
    for _, p in ipairs(pts) do
        while #lower >= 2 and cross(lower[#lower - 1], lower[#lower], p) <= 0 do lower[#lower] = nil end
        lower[#lower + 1] = p
    end
    for i = #pts, 1, -1 do
        local p = pts[i]
        while #upper >= 2 and cross(upper[#upper - 1], upper[#upper], p) <= 0 do upper[#upper] = nil end
        upper[#upper + 1] = p
    end
    lower[#lower] = nil; upper[#upper] = nil
    for _, p in ipairs(upper) do lower[#lower + 1] = p end
    return lower
end
-- }}}

-- {{{ local function fence_of(points)
-- The hull pushed out SPARE yards from its middle; a group in a line or a
-- point gets a small ring round its middle instead.
local function fence_of(pts)
    local h = hull(pts)
    local cx, cy = 0, 0
    for _, p in ipairs(pts) do cx, cy = cx + p[1], cy + p[2] end
    cx, cy = cx / #pts, cy / #pts
    local out = {}
    if #h < 3 then
        for k = 0, 11 do
            local a = k * math.pi / 6
            out[#out + 1] = { math.floor(cx + math.cos(a) * SPARE * 2 + 0.5), math.floor(cy + math.sin(a) * SPARE * 2 + 0.5) }
        end
        return out, cx, cy
    end
    for _, p in ipairs(h) do
        local dx, dy = p[1] - cx, p[2] - cy
        local d = math.sqrt(dx * dx + dy * dy)
        local k = d > 0 and (d + SPARE) / d or 1
        out[#out + 1] = { math.floor(cx + dx * k + 0.5), math.floor(cy + dy * k + 0.5) }
    end
    return out, cx, cy
end
-- }}}

-- {{{ every continent
local js = { "// assets/fish-sandbox/sandbox-data.js - GENERATED by scripts/generate-fish-sandbox-data from the zone data\n",
             "// (assets/zone-maps/) and " .. WORLD_DB .. "'s creature spawns, for docs/HTML/fish-sandbox.html (issue 617e16).\n",
             "// Don't edit; run it again. Coordinates are the game's (x north, y west, yards); squares are ~33 yards.\n",
             "window.SANDBOX = { continents: [\n" }
local total_fences = 0
for _, map in ipairs(MAPS) do
    -- the zones of this map, from their files
    local zones = {}
    local h = io.popen(("ls '%s/assets/zone-maps/' | grep '^%d-'"):format(DIR, map))
    for name in h:lines() do
        local ok, Z = pcall(dofile, DIR .. "/assets/zone-maps/" .. name)
        if ok and Z.squares >= 40 then zones[#zones + 1] = Z end       -- tiny slivers (stray labels) left out
    end
    h:close()
    if #zones == 0 then die(("no zone data for map %d (scripts/generate-zone-maps writes it)"):format(map)) end
    table.sort(zones, function(a, b) return a.zone < b.zone end)
    local zone_at = {}                                           -- X * 4096 + Y -> zone index
    for zi, Z in ipairs(zones) do
        for r, row in ipairs(Z.rows) do
            local c = 0
            for v, n in row:gmatch("(%d+)%*(%d+)") do
                for _ = 1, tonumber(n) do
                    c = c + 1
                    if v ~= "0" then zone_at[(Z.X0 + r - 1) * 4096 + (Z.Y1 - c + 1)] = zi end
                end
            end
        end
    end
    -- the spawns, by zone and kind
    local spawns = query(("SELECT c.id, ct.name, ROUND(c.position_x), ROUND(c.position_y), ct.faction FROM creature c JOIN creature_template ct ON ct.entry = c.id " ..
        "WHERE c.map = %d AND ct.type <> %d AND ct.npcflag = 0"):format(map, CRITTER))
    local by = {}                                                -- zone index -> entry -> { name, points }
    for _, s in ipairs(spawns) do
        local x, y = tonumber(s[3]), tonumber(s[4])
        local X, Y = math.floor(16 * (32 - x / G)), math.floor(16 * (32 - y / G))
        local zi = zone_at[X * 4096 + Y]
        if zi and not friendly_to_a_side[tonumber(s[5])] then
            by[zi] = by[zi] or {}
            local e = by[zi][s[1]] or { name = s[2], pts = {} }
            by[zi][s[1]] = e
            e.pts[#e.pts + 1] = { x, y }
        end
    end
    js[#js + 1] = ("{ map: %d, name: %q, zones: [\n"):format(map, NAMES[map] or ("map " .. map))
    for zi, Z in ipairs(zones) do
        -- the places: single-link groups within LINK yards
        local fences = {}
        for _, e in pairs(by[zi] or {}) do
            local seen = {}
            for i = 1, #e.pts do
                if not seen[i] then
                    local group, stack = {}, { i }
                    seen[i] = true
                    while #stack > 0 do
                        local k = table.remove(stack)
                        group[#group + 1] = e.pts[k]
                        for j = 1, #e.pts do
                            if not seen[j] and (e.pts[j][1] - e.pts[k][1]) ^ 2 + (e.pts[j][2] - e.pts[k][2]) ^ 2 <= LINK * LINK then
                                seen[j] = true
                                stack[#stack + 1] = j
                            end
                        end
                    end
                    if #group >= MIN_SPAWNS then
                        local poly, cx, cy = fence_of(group)
                        fences[#fences + 1] = { name = e.name, n = #group, poly = poly, cx = cx, cy = cy }
                    end
                end
            end
        end
        table.sort(fences, function(a, b) return a.n > b.n end)
        for k = MAX_FENCES + 1, #fences do fences[k] = nil end
        total_fences = total_fences + #fences
        local fjs = {}
        for _, f in ipairs(fences) do
            local pts = {}
            for _, p in ipairs(f.poly) do pts[#pts + 1] = p[1] .. "," .. p[2] end
            fjs[#fjs + 1] = ("{ name: %q, spawns: %d, poly: [%s] }"):format(f.name, f.n, table.concat(pts, ","))
        end
        local subs = {}
        for _, s in ipairs(Z.subzones) do subs[#subs + 1] = ("{ name: %q, tint: %d }"):format(s.name, s.tint) end
        local rows = {}
        for _, r in ipairs(Z.rows) do rows[#rows + 1] = '"' .. r .. '"' end
        js[#js + 1] = ("  { zone: %d, name: %q, X0: %d, X1: %d, Y0: %d, Y1: %d, subzones: [%s],\n    rows: [%s],\n    fences: [%s] },\n"):format(
            Z.zone, Z.name, Z.X0, Z.X1, Z.Y0, Z.Y1, table.concat(subs, ","), table.concat(rows, ","), table.concat(fjs, ",\n      "))
    end
    js[#js + 1] = "] },\n"
    print(("generate-fish-sandbox-data: %s: %d zones, %d spawns read"):format(NAMES[map] or map, #zones, #spawns))
end
js[#js + 1] = "] };\n"
os.execute("mkdir -p '" .. DIR .. "/assets/fish-sandbox'")
local f = io.open(OUT, "w") or die("cannot write " .. OUT)
f:write(table.concat(js))
f:close()
print(("generate-fish-sandbox-data: %d fences -> %s"):format(total_fences, OUT))
-- }}}
