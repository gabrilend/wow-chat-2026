#!/bin/bash

DIR="${1:-/mnt/kaun/wow-chat-2026}"
MEMORY="${DIR}/scripts/test-memory"
SCRATCH="${DIR}/tmp/tmp/test-test-memory"
FAILS=0
CHECKS=0

check() {
    CHECKS=$((CHECKS + 1))
    if [[ "$2" != "$3" ]]; then echo "  FAIL: $1 (expected \"$3\", got \"$2\")"; FAILS=$((FAILS + 1)); fi
}

verdict() {
    "${MEMORY}" "${SCRATCH}" plan "$@" | awk -F'\t' '{print $3}'
}

rm -rf "${SCRATCH}"
mkdir -p "${SCRATCH}/scripts/lib" "${SCRATCH}/src" "${SCRATCH}/data"
git -C "${SCRATCH}" init --quiet
git -C "${SCRATCH}" config user.email test@example.invalid
git -C "${SCRATCH}" config user.name test
printf 'return 1\n'                                > "${SCRATCH}/scripts/lib/a.lua"
printf 'b\n'                                       > "${SCRATCH}/src/b.txt"
printf 'one\n'                                     > "${SCRATCH}/data/one.txt"
printf '#!/bin/bash\ncat "$1/scripts/lib/a.lua"\n' > "${SCRATCH}/scripts/test-a"
printf '#!/bin/bash\ncat "$1/src/b.txt"\n'         > "${SCRATCH}/scripts/test-b"
printf '#!/bin/bash\n# ==== header: 9 lines, footer: 3 lines ====\n# id:         test-c\n# profiles:   all\n# priority:   10\n# kind:       test\n# about:      lists data\n# quick-test: yes\n# remember:   no\n# ==== end of header ====\nls "$1/data/"\n# ==== footer of test-c ====\n# lines:     14\n# ==== end of footer ====\n' > "${SCRATCH}/scripts/test-c"
printf '#!/bin/bash\nls "$1/data/"\n'              > "${SCRATCH}/scripts/test-d"
mkdir -p "${SCRATCH}/src/data"
printf 'dofile(here .. "data/e2.lua")\n'          > "${SCRATCH}/src/e.lua"
printf 'return 2\n'                               > "${SCRATCH}/src/data/e2.lua"
printf '#!/bin/bash\nluajit "$1/src/e.lua"\n'    > "${SCRATCH}/scripts/test-e"
chmod +x "${SCRATCH}"/scripts/test-*
git -C "${SCRATCH}" add -A
git -C "${SCRATCH}" commit --quiet -m one
ONE="$(git -C "${SCRATCH}" rev-parse HEAD)"

check "test-a reads itself and lib/a.lua" "$("${MEMORY}" "${SCRATCH}" reads test-a | tr '\n' ' ')" "scripts/lib/a.lua scripts/test-a "
check "test-e reads what its script loads from its own folder" "$("${MEMORY}" "${SCRATCH}" reads test-e | tr '\n' ' ')" "scripts/test-e src/data/e2.lua src/e.lua "
check "test-b reads itself and src/b.txt" "$("${MEMORY}" "${SCRATCH}" reads test-b | tr '\n' ' ')" "scripts/test-b src/b.txt "

check "test-a with nothing recorded" "$(verdict test-a)" "run"
check "test-c says remember: no" "$(verdict test-c)" "never"

FP_A="$("${MEMORY}" "${SCRATCH}" plan test-a | cut -f2)"
FP_B="$("${MEMORY}" "${SCRATCH}" plan test-b | cut -f2)"
FP_D="$("${MEMORY}" "${SCRATCH}" plan test-d | cut -f2)"
printf 'pass test-a %s\npass test-b %s\npass test-d %s\n' "${FP_A}" "${FP_B}" "${FP_D}" | "${MEMORY}" "${SCRATCH}" record "${ONE}" commit > /dev/null
check "test-a after its pass" "$(verdict test-a)" "remembered"
check "test-b after its pass" "$(verdict test-b)" "remembered"

printf 'b2\n' > "${SCRATCH}/src/b.txt"
git -C "${SCRATCH}" commit --quiet -am two
TWO="$(git -C "${SCRATCH}" rev-parse HEAD)"
check "test-a, whose file did not change"        "$(verdict test-a)" "remembered"
check "test-b, whose file changed"               "$(verdict test-b)" "run"
check "the commit's own view: test-a untouched"  "$(verdict --commit "${TWO}" --touched-by "${TWO}" test-a)" "untouched"
check "the commit's own view: test-b runs"       "$(verdict --commit "${TWO}" --touched-by "${TWO}" test-b)" "run"
check "the first commit's files: test-b remembered" "$(verdict --commit "${ONE}" test-b)" "remembered"

printf 'return 2\n' > "${SCRATCH}/scripts/lib/a.lua"
check "test-a with its file changed but not committed" "$(verdict test-a)" "run"
printf 'return 1\n' > "${SCRATCH}/scripts/lib/a.lua"
check "test-a with its file changed back"              "$(verdict test-a)" "remembered"

printf 'two\n' > "${SCRATCH}/data/two.txt"
check "test-d with a new, uncommitted file in its folder" "$(verdict test-d)" "run"
rm "${SCRATCH}/data/two.txt"
check "test-d with it gone again"                         "$(verdict test-d)" "remembered"

printf 'fail test-a %s\n' "${FP_A}" | "${MEMORY}" "${SCRATCH}" record "${TWO}" compile > /dev/null
check "test-a after failing on the files it once passed on" "$(verdict test-a)" "run"

rm -rf "${SCRATCH}"
if [[ ${FAILS} -eq 0 ]]; then echo "test-test-memory: all ${CHECKS} checks passed"; exit 0; fi
echo "test-test-memory: ${FAILS} of ${CHECKS} checks failed"
exit 1
