#!/usr/bin/env luajit
--------------------------------------------------------------------------------
-- test-arathi-basin-rules - the Arathi Basin scene's two rules that need no
-- server: where squads go, and how the base bonuses grow
--
-- For a general audience: the cc-test profile's Arathi Basin scene (issue
-- 176a2) sends its stand-ins over the roads by an alternating rule at each
-- crossing, and grows a bonus for each base a side holds. Both rules are
-- plain arithmetic (src/lua-cc-test/lib/arathi-basin-routes.lua and
-- arathi-basin-bonuses.lua), so they are checked here on paper, the way
-- 176a2f's sealed test will check them again in a real match:
--
--   routes   no squad takes the road it just came by; squads arriving at
--            a crossing the same way share its other roads evenly; one
--            that appeared there may take any; the same match played
--            twice goes the same way; each side keeps its own pointers;
--            routes start at the drawn home, or at a base
--   bonuses  the owner's own examples (a Blacksmith taken at 165 steps up
--            at 265; Stables taken at 35 at 135 and 235), the pause while
--            under attack and the return at the same steps, the reset on
--            capture, nothing from an assault on a neutral base, the
--            ceiling of 16 steps, and the three-minute table in 176a2e
--
-- Usage: scripts/test-arathi-basin-rules [PROJECT_DIR]
--------------------------------------------------------------------------------

local DIR = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end
local Routes  = dofile(DIR .. "/src/lua-cc-test/lib/arathi-basin-routes.lua")
local Bonuses = dofile(DIR .. "/src/lua-cc-test/lib/arathi-basin-bonuses.lua")
local DATA    = dofile(DIR .. "/src/lua-cc-test/data/arathi-basin-roads.lua")

local fails, checks = 0, 0
local function check(ok, what)
    checks = checks + 1
    if ok then print("  ok:   " .. what) else print("  FAIL: " .. what); fails = fails + 1 end
end

local NW, SE = "north-west home", "south-east home"

print("routes: the roads")
local g = Routes.graph(DATA.roads)
local places = 0
for _ in pairs(g) do places = places + 1 end
check(places == 7 and #DATA.roads == 15, "7 places and 15 roads (got " .. places .. ", " .. #DATA.roads .. ")")

print("routes: a squad never takes the road it just came by")
local m = Routes.new_match(g, { alliance = NW, horde = SE })
local no_back, ok_len = true, true
for _ = 1, 40 do
    for _, side in ipairs({ "alliance", "horde" }) do
        local route = Routes.walk(m, side, nil, nil, 10)
        if #route < 2 then ok_len = false end
        for k = 3, #route do if route[k] == route[k - 2] and #Routes.choices(m, route[k - 1], route[k - 2]) > 0 then no_back = false end end
    end
end
check(no_back, "80 walks: no step goes back to the place just left")
check(ok_len, "every walk moves")

print("routes: squads arriving one way share the roads on evenly")
m = Routes.new_match(g, { alliance = NW, horde = SE })
local tally, n = {}, 30
for _ = 1, n do
    local nxt = Routes.next_place(m, "alliance", "Stables", NW)   -- arrived at the Stables from home
    tally[nxt] = (tally[nxt] or 0) + 1
end
local counts, lo, hi = {}, math.huge, 0
for place, c in pairs(tally) do counts[#counts + 1] = place .. " " .. c; lo = math.min(lo, c); hi = math.max(hi, c) end
table.sort(counts)
local ways = #Routes.choices(m, "Stables", NW)
check(#counts == ways and hi - lo <= 1 and tally[NW] == nil, string.format("%d squads at the Stables from home, over its %d other roads: %s", n, ways, table.concat(counts, ", ")))
local appeared = Routes.choices(m, "Stables", nil)
check(#appeared == ways + 1, "a squad that appeared at the Stables may take any of its " .. #appeared .. " roads, home included")

print("routes: the same match goes the same way twice")
local function sequence()
    local mm = Routes.new_match(g, { alliance = NW, horde = SE })
    local out = {}
    for _ = 1, 12 do out[#out + 1] = table.concat(Routes.walk(mm, "alliance"), ">"); out[#out + 1] = table.concat(Routes.walk(mm, "horde"), ">") end
    return table.concat(out, "|")
end
check(sequence() == sequence(), "two fresh matches send 24 squads the same ways")

print("routes: each side keeps its own pointers")
local a = Routes.new_match(g, { alliance = NW, horde = SE })
local b = Routes.new_match(g, { alliance = NW, horde = SE })
for _ = 1, 7 do Routes.walk(a, "alliance") end        -- only the alliance walks in match a
check(table.concat(Routes.walk(a, "horde"), ">") == table.concat(Routes.walk(b, "horde"), ">"), "seven alliance squads leave the horde's first route unchanged")

print("routes: homes drawn the other way round, and starting at a base")
local swapped = Routes.new_match(g, { alliance = SE, horde = NW })
local r1 = Routes.walk(swapped, "alliance")
check(r1[1] == SE, "the alliance's routes start at the south-east home")
local r2 = Routes.walk(swapped, "horde", "Gold Mine")
check(r2[1] == "Gold Mine" and #r2 > 1, "a squad appearing at the Gold Mine walks on from there")

print("bonuses: the owner's examples")
local s = Bonuses.new()
local total = { alliance = 0 }
local bs_at, st_at = {}, {}
-- every tick records the side's total whenever a base steps up
local function tick(side, amount)
    local bs, st = Bonuses.steps(s, "Blacksmith"), Bonuses.steps(s, "Stables")
    total[side] = (total[side] or 0) + amount
    Bonuses.income(s, side, amount)
    if Bonuses.steps(s, "Blacksmith") > bs then bs_at[#bs_at + 1] = total[side] end
    if Bonuses.steps(s, "Stables") > st then st_at[#st_at + 1] = total[side] end
end
for _ = 1, 3 do tick("alliance", 10) end; tick("alliance", 5)                  -- 35
Bonuses.captured(s, "Stables", "alliance")                                      -- Stables at 35
while total.alliance < 165 do tick("alliance", 10) end                          -- 165
Bonuses.captured(s, "Blacksmith", "alliance")                                   -- Blacksmith at 165
while total.alliance < 400 do tick("alliance", 10) end
check(bs_at[1] == 265 and bs_at[2] == 365, "the Blacksmith, taken at 165, steps up at 265 and 365 (got " .. table.concat(bs_at, ", ") .. ")")
check(st_at[1] == 135 and st_at[2] == 235 and st_at[3] == 335, "the Stables, taken at 35, step up at 135, 235, 335 (got " .. table.concat(st_at, ", ") .. ")")
local act = Bonuses.active(s, "alliance")
check(act["melee damage"] == 10 and act["movement speed"] == 15, "at 400: melee damage +10%, movement speed +15%")

print("bonuses: under attack, then defended")
Bonuses.assaulted(s, "Blacksmith", "horde")
check(Bonuses.active(s, "alliance")["melee damage"] == nil, "the Blacksmith's bonus is off while the horde takes it")
for _ = 1, 20 do tick("alliance", 10) end                                       -- 200 more, none of it counted
check(Bonuses.steps(s, "Blacksmith") == 2, "200 resources gained under attack don't count (still 2 steps)")
check(Bonuses.active(s, "alliance")["movement speed"] == 25, "the Stables, not under attack, kept counting (600 - 35 = 565: +25%)")
Bonuses.defended(s, "Blacksmith")
check(Bonuses.active(s, "alliance")["melee damage"] == 10, "defended: back at exactly +10%")

print("bonuses: taken by the enemy")
Bonuses.assaulted(s, "Blacksmith", "horde")
Bonuses.captured(s, "Blacksmith", "horde")
check(Bonuses.active(s, "alliance")["melee damage"] == nil and Bonuses.steps(s, "Blacksmith") == 0, "the alliance loses it; the count is back to zero")
Bonuses.income(s, "horde", 100)
check(Bonuses.active(s, "horde")["melee damage"] == 5, "the horde's own count starts from zero: +5% after 100")

print("bonuses: an assault on a neutral base")
Bonuses.assaulted(s, "Farm", "alliance")
Bonuses.income(s, "alliance", 300)
check(Bonuses.steps(s, "Farm") == 0, "nothing counts until the capture completes")

print("bonuses: the ceiling")
s = Bonuses.new()
Bonuses.captured(s, "Gold Mine", "horde")
for _ = 1, 400 do Bonuses.income(s, "horde", 10) end                            -- 4,000: past any match
check(Bonuses.active(s, "horde")["armour"] == 80, "at most 16 steps: +80%")

print("bonuses: three minutes, by bases held (176a2e's table)")
local function steps_in_three_minutes(interval_s, points)
    local t = Bonuses.new()
    Bonuses.captured(t, "Farm", "horde")
    for _ = 1, math.floor(180 / interval_s) do Bonuses.income(t, "horde", points) end
    return Bonuses.steps(t, "Farm")
end
check(steps_in_three_minutes(12, 10) == 1, "one base held (10 every 12 s): 1 step")
check(steps_in_three_minutes(6, 10) == 3, "three bases held (10 every 6 s): 3 steps")
check(steps_in_three_minutes(3, 10) == 6, "four bases held (10 every 3 s): 6 steps")

-- {{{ the owner's crossings, both readings
local Crossings  = dofile(DIR .. "/src/lua-cc-test/lib/arathi-basin-crossings.lua")
local Squads     = dofile(DIR .. "/src/lua-cc-test/lib/arathi-basin-squads.lua")
local Formations = dofile(DIR .. "/src/lua-cc-test/lib/arathi-basin-formations.lua")
local Match      = dofile(DIR .. "/src/lua-cc-test/lib/arathi-basin-match.lua")

-- the owner's table: from each base, the places its exits lead to
local OWNER = {
    ["Stables"]     = { "Gold Mine", "Farm", "Blacksmith", "Lumber Mill" },
    ["Farm"]        = { "Lumber Mill", "Stables", "Blacksmith", "Gold Mine" },
    ["Gold Mine"]   = { "Farm", "Blacksmith", "Stables" },
    ["Lumber Mill"] = { "Stables", "Blacksmith", "Farm" },
    ["Blacksmith"]  = { "Gold Mine", "Stables", "Lumber Mill", "Farm" },
}
local function is_base(p) for _, b in ipairs(Crossings.BASES) do if b == p then return true end end return false end
-- the bases reachable from `from` through crossings only (no other base, no home on the way)
local function next_bases(g, from)
    local seen, found, frontier = { [from] = true }, {}, { from }
    while #frontier > 0 do
        local nxt = {}
        for _, p in ipairs(frontier) do
            for _, e in ipairs(g[p] or {}) do
                if not seen[e.to] then
                    seen[e.to] = true
                    if is_base(e.to) then found[e.to] = true
                    elseif not e.to:find("home") then nxt[#nxt + 1] = e.to end
                end
            end
        end
        frontier = nxt
    end
    return found
end
for _, map in ipairs({ Crossings.shared, Crossings.literal }) do
    print("crossings: the " .. map.name .. " reading")
    local cg = Routes.graph(Crossings.as_roads(map))
    local all = true
    local missing = {}
    for base, wants in pairs(OWNER) do
        local got = next_bases(cg, base)
        for _, w in ipairs(wants) do if not got[w] then all = false; missing[#missing + 1] = base .. " to " .. w end end
    end
    check(all, "every base reaches each place the owner's table names, through crossings only" .. (#missing > 0 and (": missing " .. table.concat(missing, "; ")) or ""))
    local cm = Routes.new_match(cg, { alliance = NW, horde = SE })
    local back = false
    for _ = 1, 30 do
        local r = Routes.walk(cm, "alliance", nil, nil, 20)
        for k = 3, #r do if r[k] == r[k - 2] and #Routes.choices(cm, r[k - 1], r[k - 2]) > 1 then back = true end end
    end
    check(not back, "30 walks of 20 steps never turn back where another road was open")
end
-- }}}

-- {{{ where a route ends
print("routes: stopping at the enemy's home, or walking on")
local stop_g = Routes.graph(Crossings.as_roads(Crossings.literal))
local stop_m = Routes.new_match(stop_g, { alliance = NW, horde = SE }, { route_end = "stop" })
local on_m   = Routes.new_match(stop_g, { alliance = NW, horde = SE }, { route_end = "walk on" })
local stopped, passed = true, false
for _ = 1, 30 do
    local r = Routes.walk(stop_m, "alliance", nil, nil, 30)
    for k = 2, #r - 1 do if r[k] == SE then stopped = false end end
    local r2 = Routes.walk(on_m, "alliance", nil, nil, 30)
    for k = 2, #r2 - 1 do if r2[k] == SE then passed = true end end
end
check(stopped, "\"stop\": no route goes past the enemy's home")
check(passed, "\"walk on\": some route goes on out of the enemy's home")
-- }}}

-- {{{ squads
print("squads: grouping")
local function units(spec)                                   -- "ddh" -> damage, damage, healer
    local out = {}
    for k = 1, #spec do
        local c = spec:sub(k, k)
        out[k] = { id = spec .. k, role = (c == "d" and "damage") or (c == "h" and "healer") or "tank" }
    end
    return out
end
local function shape_of(groups) local t = {} for _, g in ipairs(groups) do t[#t + 1] = #g end return table.concat(t, "+") end
check(shape_of(Squads.group(units("ddhddh"))) == "3+3", "four damage and two healers: two trios")
check(shape_of(Squads.group(units("dddh"))) == "4", "three damage and a healer: one group of four")
check(shape_of(Squads.group(units("dd"))) == "2", "two damage and no healer: one group")
check(shape_of(Squads.merge(units("ddh"), units("ddh"))) == "3+3", "a trio meeting a trio: two trios")
check(shape_of(Squads.merge(units("d"), units("ddh"))) == "4", "one climbing out of the river joins a trio: one group of four")

print("squads: where the dead come back")
local first = function() return 1 end
local last  = function(n) return n end
local side = Squads.new_side(NW)
check(Squads.choose_place(side, { "Farm", "Stables" }, first) == NW, "a draw of 1 is home")
check(Squads.choose_place(side, { "Farm", "Stables" }, last) == "Stables", "a draw of the last is a held base (Stables, in name order)")
side.waiting = { { place = "Stables", units = {} } }
check(Squads.choose_place(side, { "Stables" }, last) == NW, "a base with a group already waiting is skipped: home")
side.waiting = { { place = NW, units = {} } }
check(Squads.choose_place(side, {}, last) == NW, "home takes a second waiting group (they appear together)")
local place, why = Squads.choose_place(Squads.new_side(SE), { "Farm" }, function() return 7 end)
check(place == SE and why ~= nil, "a draw out of range falls back to home, and says so")

for _, claimed in ipairs({ "assault", "capture" }) do
    local sd = Squads.new_side(NW, { claimed = claimed })
    sd.waiting = { { place = "Farm", units = units("ddh") } }
    local moved_on_click = Squads.base_event(sd, "Farm", "assaulted")
    local moved_on_capture = (moved_on_click == 0) and Squads.base_event(sd, "Farm", "captured") or 0
    if claimed == "assault" then
        check(moved_on_click == 1 and sd.waiting[1].place == NW, "claimed = assault: a banner click on their base sends the waiting group home")
    else
        check(moved_on_click == 0 and moved_on_capture == 1 and sd.waiting[1].place == NW, "claimed = capture: only the full capture sends them home")
    end
end

print("squads: departures and tanks")
for _, tanks in ipairs({ "home only", "any group" }) do
    local sd = Squads.new_side(NW, { tanks = tanks })
    Squads.captured(sd, { id = "tank1", role = "tank" })
    for _, u in ipairs(units("ddh")) do Squads.died(sd, u) end
    local placed = Squads.depart(sd, { "Gold Mine" }, last)          -- the trio is drawn to the Gold Mine
    local tank_went = #placed[1].units == 4
    if tanks == "home only" then
        check(placed[1].place == "Gold Mine" and not tank_went and #sd.tanks == 1, "tanks = home only: the trio comes back at the Gold Mine; the tank keeps waiting at home")
        local p2 = Squads.depart(sd, {}, first)                       -- nobody to send: the tank still waits
        check(#p2 == 0 and #sd.tanks == 1, "a departure with no group: the tank does not go alone")
    else
        check(placed[1].place == "Gold Mine" and tank_went and #sd.tanks == 0, "tanks = any group: the tank is placed with the trio at the Gold Mine")
    end
    local appeared = Squads.wave(sd)
    check(#appeared >= 1 and #sd.waiting == 0, "the graveyard wave: every waiting group appears (" .. tanks .. ")")
end

print("squads: players take stand-ins' places")
for _, places in ipairs({ 15, 30 }) do
    local sd = Squads.new_side(SE, { places = places })
    sd.stand_ins = places                                            -- the side full of stand-ins
    Squads.player_joined(sd)
    check(Squads.died(sd, { id = "s1", role = "damage" }) == "held out", "places = " .. places .. ": a player joins; the next stand-in to die is held out")
    check(Squads.died(sd, { id = "s2", role = "damage" }) == "pool", "places = " .. places .. ": the one after goes back to the pool")
    check(Squads.player_left(sd) ~= nil and sd.held_out == 0, "places = " .. places .. ": the player leaves; the held-out stand-in may come back")
end
-- }}}

-- {{{ formations
print("formations")
local tri = units("ddh")
check(Formations.shape_for(tri, false) == "triangle", "a trio walks as a triangle")
local dia = units("tddh")
check(Formations.shape_for(dia, false) == "diamond", "a tank and a trio walk as a diamond")
check(Formations.shape_for(tri, true, { narrow = "line" }) == "line" and Formations.shape_for(tri, true, { narrow = "keep" }) == "triangle", "narrow ground: squeeze into a line, or keep the shape (both built)")
check(Formations.shape_for(units("dh"), false, { small = "follow" }) == "follow", "a squad of two may just follow (small = follow)")
local spots = Formations.slots(dia, "diamond", 0, 0, 0, { spacing = 5 })     -- heading +x
check(math.abs(spots["tddh1"][1] - 5) < 1e-9 and math.abs(spots["tddh4"][1] + 5) < 1e-9, "diamond, spacing 5, heading east: the tank 5 yards ahead, the healer 5 behind")
local turned = Formations.slots(tri, "triangle", 10, 10, math.pi / 2, { spacing = 4 })   -- heading +y
check(turned["ddh3"][2] < 10 and turned["ddh1"][2] > 10, "a triangle turned north: the damage ahead (north), the healer behind")
check(Formations.calm(0, 0, { { 30, 0 } }, { calm_range = 20 }) and not Formations.calm(0, 0, { { 30, 0 } }, { calm_range = 40 }), "an enemy 30 yards off: calm at range 20, not at range 40")
-- }}}

-- {{{ the match
print("the match")
local m1 = Match.new(function() return 1 end)
local m2 = Match.new(function() return 2 end)
check(m1.homes.alliance == NW and m2.homes.alliance == SE, "the draw puts the alliance in either corner")
for t = 1, 200 do if Match.add_score(m1, "horde", 10, t) then break end end
check(m1.winner == "horde" and m1.ended_at == 160, "the horde wins on reaching 1,600 (at the 160th tick of 10)")
check(Match.next(m1, 219) == nil, "59 seconds later: still between matches")
for _, players in ipairs({ "stay", "out" }) do
    local mm = Match.new(first, { interim_players = players })
    Match.add_score(mm, "alliance", 1600, 0)
    local nm, where = Match.next(mm, 60, last)
    check(nm and nm.number == 2 and nm.score.alliance == 0 and where == (players == "out" and "invited back" or "stayed in"),
        "interim_players = " .. players .. ": a fresh match after one minute; players " .. (where or "?"))
end
-- }}}

print("")
print(fails == 0 and ("All " .. checks .. " checks passed") or (fails .. " of " .. checks .. " checks failed"))
os.exit(fails == 0 and 0 or 1)
