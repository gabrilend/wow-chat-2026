#!/bin/bash

DIR="/mnt/kaun/wow-chat-2026"


declare -A PROFILE_REPO=(
    ["alpha"]="https://github.com/azerothcore/azerothcore-wotlk.git"   # upstream, not the fork (issue 134; corrected 2026-10-17)
    ["beta"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["release"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["vanilla"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["basic"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
    ["cc-test"]="https://github.com/liyunfan1223/azerothcore-wotlk.git"
)


if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi


get_profile_paths() {
    case "${PROFILE}" in
        release) AC_CODE_DIR="${DIR}/source-beta"  ;;
        beta)    AC_CODE_DIR="${DIR}/source-beta"  ;;
        vanilla) AC_CODE_DIR="${DIR}/source-beta"  ;;
        basic)   AC_CODE_DIR="${DIR}/source-beta"  ;;
        cc-test) AC_CODE_DIR="${DIR}/source-beta"  ;;
        alpha)   AC_CODE_DIR="${DIR}/source-alpha" ;;
        *)       echo "ERROR: Unknown profile '${PROFILE}'"; exit 1 ;;
    esac
    INSTALL_DIR="${DIR}/installed-files-${PROFILE}"
    BUILD_DIR="${DIR}/build-${PROFILE}"
}

show_help() {
    echo "Usage: ./scripts/switch <profile>"
    echo ""
    echo "Switch to a different profile without recompiling."
    echo ""
    echo "Available profiles:"
    echo "  basic   - Levels 1-60, playerbots + QoL, the development baseline (155)"
    echo "  cc-test - Stock server + playerbots + ALE, for testing the custom client (176)"
    echo "  vanilla - Default WotLK + playerbots, no wow-chat customs"
    echo "  alpha   - wow-chat-1 holiday relic (eluna, pre-playerbots)"
    echo "  release - Guaranteed-working subset (ALE + playerbots)"
    echo "  beta    - Active development (release + experimental)"
    echo ""
    echo "Current profile: ${PROFILE}"
}


if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    show_help
    exit 0
fi

new_profile="${1:-}"

if [[ -z "${new_profile}" ]]; then
    echo "Usage: ./scripts/switch <profile>"
    echo "Available profiles: basic, cc-test, vanilla, alpha, release, beta"
    echo "Current profile: ${PROFILE}"
    exit 1
fi

if [[ ! -v "PROFILE_REPO[${new_profile}]" ]]; then
    echo "Error: Unknown profile '${new_profile}'"
    echo "Available profiles: basic, cc-test, vanilla, alpha, release, beta"
    exit 1
fi

old_profile="${PROFILE}"
PROFILE="${new_profile}"
get_profile_paths

if [[ ! -f "${INSTALL_DIR}/bin/worldserver" ]]; then
    echo "Warning: Profile '${new_profile}' has not been built yet."
    echo "Expected: ${INSTALL_DIR}/bin/worldserver"
    echo "Run './scripts/install --profile ${new_profile}' first."
    echo ""
fi

echo "${new_profile}" > "${DIR}/.profile"

echo "Switched from '${old_profile}' to '${new_profile}'"
echo ""
echo "Directories:"
echo "  Source:    ${AC_CODE_DIR}"
echo "  Build:     ${BUILD_DIR}"
echo "  Installed: ${INSTALL_DIR}"
