#!/bin/bash
# custom-client - the project's own game client (issue 173).
#
# For a general audience: opens the first light of the custom client: a
# night elf on the ground of Ashenvale near Astranaar, read from the same
# map files the game server uses, moved with the game's own controls at
# 120% speed. q quits. Needs LÖVE (the game framework; the client is Lua).
#
# Usage: scripts/custom-client [PROJECT_DIR] [--shot]
#   --shot   draw a few frames, save a picture to
#            tmp/shared-memory/custom-client-shot.png, and quit (a check
#            that it draws; the window shows for a moment). After it:
#            --zoom N (camera N yards off), --front (looking at her face).

# {{{ set_dir
DIR="/mnt/mtwo/games/azeroth-core/wow-chat-2026"
if [[ -n "$1" && "$1" != --* ]]; then
    DIR="$1"
    shift
fi
# }}}

command -v love > /dev/null || { echo "ERROR: LÖVE (the 'love' program) is not installed; the custom client runs on it"; exit 1; }
MAPS="${DIR}/data-files/maps"
[[ -d "${MAPS}" ]] || { echo "ERROR: ${MAPS} missing: the server's extracted maps (scripts/extract-maps)"; exit 1; }

# the original 3.3.5a client's Data folder: her model and its pictures
# come out of its archives (read in place, nothing copied)
CLIENT="${CLIENT:-/mnt/dile/ritz/games/World of Warcraft 3.3.5a/Data}"
[[ -f "${CLIENT}/common.MPQ" ]] || { echo "ERROR: ${CLIENT} has no common.MPQ: set CLIENT to the 3.3.5a client's Data folder"; exit 1; }

ARGS=(--maps "${MAPS}" --client "${CLIENT}")
if [[ "${1:-}" == "--shot" ]]; then
    shift
    mkdir -p "${DIR}/tmp/shared-memory"
    ARGS+=(--shot "${DIR}/tmp/shared-memory/custom-client-shot.png" "$@")   # then any picture options (--zoom N, --front)
fi
exec love "${DIR}/src/custom-client" "${ARGS[@]}"
