    { "bots",  "playerbots_db_store",                   "guid = %d",     "kept"    },
    { "bots",  "playerbots_preferred_mounts",           "guid = %d",     "kept"    },
}
local LEFT_ALONE = {
    arena_team_member = "a team's membership, shared with its other members", arena_team = "a team is shared",
