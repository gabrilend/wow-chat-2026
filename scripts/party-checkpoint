local function die(message)
    io.stderr:write("party-checkpoint: " .. message .. "\n")
    os.exit(1)
end

local function query(db, sql)
    local file = os.tmpname()
    local w = io.open(file, "w"); w:write(sql, ";\n"); w:close()
    local h = io.popen(MYSQL .. " -N -B " .. db .. " < '" .. file .. "' 2>&1")
    local rows = {}
    for line in h:lines() do
        if line:find("^ERROR") then die("MySQL said: " .. line .. "\n  for: " .. sql) end
        local r = {}
        for field in (line .. "\t"):gmatch("([^\t]*)\t") do r[#r + 1] = field end
        rows[#rows + 1] = r
    end
    h:close()
    os.remove(file)
    return rows
end

local function character(name)
    local rows = query(CHARS, ("SELECT guid, online, level, class FROM characters WHERE name = '%s'"):format(name:gsub("[^%a]", "")))
    if #rows == 0 then die("no character named " .. name .. " in " .. CHARS) end
    return tonumber(rows[1][1]), rows[1][2] ~= "0", tonumber(rows[1][3]), tonumber(rows[1][4])
end

local function insert_lines(db, tbl, where)
    local cols = query("information_schema", ("SELECT column_name, data_type FROM columns WHERE table_schema = '%s' AND table_name = '%s' ORDER BY ordinal_position"):format(db, tbl))
    if #cols == 0 then die("no table " .. db .. "." .. tbl) end
    local exprs, names = {}, {}
    for _, c in ipairs(cols) do
        local col, kind = "`" .. c[1] .. "`", c[2]:lower()
        local e
        if kind == "float" or kind == "double" then
            e = ("CAST(%s AS DOUBLE)"):format(col)
        elseif kind:find("int$") or kind == "decimal" then
            e = col
        else
            e = ("IF(LENGTH(%s) = 0,'''''', CONCAT('0x', HEX(%s)))"):format(col, col)
        end
        exprs[#exprs + 1] = ("IF(%s IS NULL, 'NULL', %s)"):format(col, e)
        names[#names + 1] = col
    end
    local rows = query(db, ("SELECT %s FROM `%s` WHERE %s"):format(table.concat(exprs, ", "), tbl, where))
    local out = {}
    for _, r in ipairs(rows) do
        out[#out + 1] = ("INSERT INTO `%s`.`%s` (%s) VALUES (%s);"):format(db, tbl, table.concat(names, ", "), table.concat(r, ", "))
    end
    return out
end

local function refuse_online(names)
    local online = {}
    for _, n in ipairs(names) do
        local _, on = character(n)
        if on then online[#online + 1] = n end
    end
    if #online > 0 then
        die("online now: " .. table.concat(online, ", ") .. ". Log them out first (the server holds an online character in memory" ..
            " and would write over the change); nothing was done")
    end
end

local function save(name, names)
    if not name or not name:find("^[%w%-]+$") then die("a checkpoint's name is letters, digits and dashes") end
    if #names == 0 then die("save: name the characters") end
    refuse_online(names)
    os.execute("mkdir -p '" .. STORE .. name .. "'")
    local manifest = {}
    for _, n in ipairs(names) do
        local guid, _, level, class = character(n)
        local path = STORE .. name .. "/" .. n .. ".sql"
        local f = io.open(path, "w") or die("can't write " .. path)
        f:write("-- " .. n .. " (character " .. guid .. ", level " .. level .. ", class " .. class .. ") in checkpoint " .. name .. ",\n")
        f:write("-- written " .. os.date("%Y-%m-%d %H:%M:%S") .. " by scripts/party-checkpoint save; restore with\n")
        f:write("--   scripts/party-checkpoint restore " .. name .. "\n")
        f:write("-- Deletes what the character holds, then loads what it held when saved.\n")
        f:write("SET autocommit = 0;\nSTART TRANSACTION;\n")
        for _, t in ipairs(TABLES) do
            local db = t[1] == "chars" and CHARS or BOTS
            f:write(("DELETE FROM `%s`.`%s` WHERE %s;\n"):format(db, t[2], t[3]:format(guid)))
        end
        f:close()
        local h = io.open(path, "a")
        for _, t in ipairs(TABLES) do
            if t[4] == "kept" then
                local db = t[1] == "chars" and CHARS or BOTS
                for _, line in ipairs(insert_lines(db, t[2], t[3]:format(guid))) do h:write(line, "\n") end
            end
        end
        h:write("COMMIT;\n")
        h:close()
        manifest[#manifest + 1] = ("%s\t%d\t%d\t%d"):format(n, guid, level, class)
        print(("saved %-12s character %6d, level %2d -> %s"):format(n, guid, level, path))
    end
    local f = io.open(STORE .. name .. "/party", "w")
    f:write("# checkpoint " .. name .. ", saved " .. os.date("%Y-%m-%d %H:%M:%S") .. " by scripts/party-checkpoint (" .. PROFILE .. ")\n")
    f:write("# name\tcharacter\tlevel\tclass\n" .. table.concat(manifest, "\n") .. "\n")
    f:close()
end

local function members(name)
    local f = io.open(STORE .. name .. "/party") or die("no checkpoint named " .. tostring(name) .. " (see: party-checkpoint list)")
    local list = {}
    for line in f:lines() do
        if not line:find("^#") then
            local n, guid, level, class = line:match("^(%S+)\t(%d+)\t(%d+)\t(%d+)$")
            if n then list[#list + 1] = { name = n, guid = tonumber(guid), level = tonumber(level), class = tonumber(class) } end
        end
    end
    f:close()
    return list
end

local function restore(name, dry)
    local list = members(name)
    local names = {}
    for _, m in ipairs(list) do names[#names + 1] = m.name end
    refuse_online(names)
    for _, m in ipairs(list) do
        local guid = character(m.name)
        if guid ~= m.guid then die(m.name .. " is character " .. guid .. " now, " .. m.guid .. " when saved: a different character of the same name; nothing restored for it") end
        local path = STORE .. name .. "/" .. m.name .. ".sql"
        local cmd
        if dry then
            cmd = ("sed '$s/^COMMIT;$/ROLLBACK;/' '%s' | %s 2>&1"):format(path, MYSQL)
        else
            cmd = ("%s < '%s' 2>&1"):format(MYSQL, path)
        end
        local h = io.popen(cmd)
        local out = h:read("*a")
        h:close()
        if out:find("ERROR") then die("restoring " .. m.name .. " failed (its transaction was not committed):\n" .. out) end
        print(("%s %-12s character %6d, level %2d"):format(dry and "would restore (rolled back)" or "restored", m.name, m.guid, m.level))
    end
end

local verb = table.remove(args, 1)
if verb == "save" then
    local name = table.remove(args, 1)
    save(name, args)
elseif verb == "restore" then
    local dry = args[1] == "--dry-run"
    if dry then table.remove(args, 1) end
    restore(args[1], dry)
elseif verb == "list" then
    local h = io.popen("ls -1 '" .. STORE .. "' 2>/dev/null")
    for n in h:lines() do
        local ok, list = pcall(members, n)
        if ok then
            local who = {}
            for _, m in ipairs(list) do who[#who + 1] = m.name end
            print(n .. ": " .. table.concat(who, ", "))
        end
    end
    h:close()
elseif verb == "show" then
    for _, m in ipairs(members(args[1])) do
        print(("%-12s character %6d, level %2d, class %2d"):format(m.name, m.guid, m.level, m.class))
    end
elseif verb == "tables" then
    for _, t in ipairs(TABLES) do print(t[1] .. "\t" .. t[2] .. "\t" .. t[4]) end
    for t, why in pairs(LEFT_ALONE) do print("left\t" .. t .. "\t" .. why) end
else
    die("usage: party-checkpoint [--dir DIR] [--profile P] save NAME CHARACTER... | restore [--dry-run] NAME | list | show NAME | tables")
end
