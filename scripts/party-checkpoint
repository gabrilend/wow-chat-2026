    if args[1] == "--dir" then DIR = args[2] elseif args[1] == "--profile" then PROFILE = args[2] else STORE_AT = args[2] end
    table.remove(args, 1); table.remove(args, 1)
end
if not PROFILE then
    local f = io.open(DIR .. "/.profile")
    PROFILE = f and f:read("*l") or nil
    if f then f:close() end
end
if not PROFILE or PROFILE == "" then io.stderr:write("party-checkpoint: no profile (.profile is missing; give --profile)\n"); os.exit(1) end
local CHARS     = "acore_characters_" .. PROFILE
local BOTS      = "acore_playerbots_" .. PROFILE
local STORE     = STORE_AT and (STORE_AT .. "/") or (DIR .. "/backups/checkpoints/")
local LOGIN     = "--defaults-file=" .. DIR .. "/mysql/conf/client.cnf -h127.0.0.1 -P3307"
local MYSQL     = DIR .. "/mysql/installed-files/bin/mysql " .. LOGIN

local ITEMS = "guid IN (SELECT item FROM " .. CHARS .. ".character_inventory WHERE guid = %d)"
