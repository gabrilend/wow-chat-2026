    item_refund_instance = "a purchase's refund window", item_soulbound_trade_data = "a trade window",
    lag_reports = "a log", lfg_data = "the dungeon finder's queue", log_arena_memberstats = "a log", log_money = "a log",
    mail = "mail is between characters", mail_items = "mail is between characters", mail_server_character = "the server's mail",
    petition = "a charter is shared", petition_sign = "a charter is shared", pvpstats_players = "a log",
    quest_tracker = "a log", recovery_item = "the item restorer's", spam_reports = "a log",
