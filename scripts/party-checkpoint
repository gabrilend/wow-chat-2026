    { "chars", "character_queststatus",                 "guid = %d",     "kept"    },
    { "chars", "character_queststatus_daily",           "guid = %d",     "kept"    },
    { "chars", "character_queststatus_monthly",         "guid = %d",     "kept"    },
    { "chars", "character_queststatus_rewarded",        "guid = %d",     "kept"    },
    { "chars", "character_queststatus_seasonal",        "guid = %d",     "kept"    },
    { "chars", "character_queststatus_weekly",          "guid = %d",     "kept"    },
    { "chars", "character_reputation",                  "guid = %d",     "kept"    },
    { "chars", "character_settings",                    "guid = %d",     "kept"    },
    { "chars", "character_skills",                      "guid = %d",     "kept"    },
    { "chars", "character_social",                      "guid = %d",     "kept"    },
