    gm_survey = "a log", gm_ticket = "a log", group_member = "groups are formed at login", groups = "groups are formed at login",
    guild = "a guild is shared", guild_bank_eventlog = "a log", guild_bank_item = "the guild's", guild_eventlog = "a log",
