#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-moment
# profiles:   all
# priority:   10
# kind:       test
# about:      the moment's economy holds to issue 625d: fast heals for the dying, cheap for the scratched, no overheal below 90% mana, instants saved for moving, cooldowns spent in empowered moments
# quick-test: yes
# ==== end of header ====
# test-buddy-moment - checks choosing an answer by the moment's economy
# (buddies_moment.h, with the resource economy it builds on) against issue
# 625d, with no server.
#
# For a general audience: among the spells that answer one need, a buddy
# should pick fast ones for an ally about to die and cheap ones for an ally
# barely scratched, never waste mana on overhealing unless nearly full, keep
# its instant spells for when it has to move, and spend its big cooldowns
# when Bloodlust or another empowering moment is up. Each of those is a
# number from the buddy's own state; this test builds them alone with the
# system compiler and checks the issue's own cases.
#
# Usage: scripts/test-buddy-moment [PROJECT_DIR] [--help]
# Builds into tmp/tmp/ (the executable tier). Exits non-zero when any
# check fails.

set -uo pipefail

# {{{ configuration
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: scripts/test-buddy-moment [PROJECT_DIR]"
    echo "  Builds and runs the moment's economy's offline check (tests/buddy-moment/moment-check.cpp)."
    exit 0
fi
DIR="/mnt/kaun/wow-chat-2026"
[[ -n "${1:-}" ]] && DIR="$1"
CORE="${DIR}/patches/B036-mod-buddies/mod-buddies/src"
SOURCE="${DIR}/tests/buddy-moment/moment-check.cpp"
EXEC_DIR="${DIR}/tmp/tmp"
BINARY="${EXEC_DIR}/buddy-moment-check"
# }}}

[[ -d "${DIR}/tmp" ]] || { echo "ERROR: ${DIR}/tmp missing (the project's link to /tmp/<project>)"; exit 1; }
mkdir -p "${EXEC_DIR}"

if ! g++ -std=c++17 -O2 -Wall -Wextra -Werror -I"${CORE}" "${SOURCE}" -o "${BINARY}"; then
    echo "test-buddy-moment: the moment's economy did not build alone (above); nothing was checked"
    exit 1
fi
"${BINARY}"
# ==== footer of test-buddy-moment ====
# lines:      52
# ==== end of footer ====
