#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-solo-record
# profiles:   all
# priority:   10
# kind:       test
# about:      the solo record holds to the owner's design: kinds by creature class, replaced only by a fight more in every number, allies multiply, stand-ins brave
# quick-test: yes
# ==== end of header ====
# test-buddy-solo-record - checks a buddy's sense of which foes it can beat
# alone (the solo record, roam/buddy_solo_core.h) against the owner's
# design, with no server (issue 623, question 7).
#
# For a general audience: whenever a buddy wins a fight entirely alone, it
# remembers what the foe asked of it and what it cost, kept per kind of foe;
# a later solo win replaces that only when it was harder in every way. It
# judges a foe it has never fought by that record, braver with allies near.
# The server's version is plain arithmetic, so this test builds it alone
# with the system compiler and puts it through the owner's own rules.
#
# Usage: scripts/test-buddy-solo-record [PROJECT_DIR] [--help]
# Builds into tmp/tmp/ (the executable tier). Exits non-zero when any
# check fails.

set -uo pipefail

# {{{ configuration
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: scripts/test-buddy-solo-record [PROJECT_DIR]"
    echo "  Builds and runs the solo record's offline check (tests/buddy-solo-record/solo-check.cpp)."
    exit 0
fi
DIR="/mnt/kaun/wow-chat-2026"
[[ -n "${1:-}" ]] && DIR="$1"
CORE="${DIR}/patches/B036-mod-buddies/mod-buddies/src/roam"
SOURCE="${DIR}/tests/buddy-solo-record/solo-check.cpp"
EXEC_DIR="${DIR}/tmp/tmp"
BINARY="${EXEC_DIR}/buddy-solo-check"
# }}}

[[ -d "${DIR}/tmp" ]] || { echo "ERROR: ${DIR}/tmp missing (the project's link to /tmp/<project>)"; exit 1; }
mkdir -p "${EXEC_DIR}"

if ! g++ -std=c++17 -O2 -Wall -Wextra -Werror -I"${CORE}" "${SOURCE}" -o "${BINARY}"; then
    echo "test-buddy-solo-record: the solo record core did not build alone (above); nothing was checked"
    exit 1
fi
"${BINARY}"
# ==== footer of test-buddy-solo-record ====
# lines:      51
# ==== end of footer ====
