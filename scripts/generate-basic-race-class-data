#!/usr/bin/env luajit
-- generate-basic-race-class-data - write which races can play which classes,
-- with their names and factions, as a Lua data file for Sargobras's buddy
-- menu (issue 617b).
--
-- For a general audience: when a player asks Sargobras for "a dwarf" he must
-- know which classes a dwarf can be, and when they ask for "a paladin" he
-- must know which races of their faction can be one. The server's world
-- database holds the answer (every race and class a character can be
-- created as), and the game client's files hold the names and which side
-- each race is on. This tool reads both and writes them out as plain data,
-- so the menu never works from a hand-typed list.
--
-- Usage: scripts/generate-basic-race-class-data [PROJECT_DIR] [WORLD_DB]
--   Reads   WORLD_DB (default acore_world_release) on the project MySQL,
--           read-only: playercreateinfo (race, class)
--           data-files/dbc/{ChrRaces,ChrClasses}.dbc (names, team)
--   Writes  src/lua-basic/data/race-class-data.lua (whole file, generated)

local DIR   = arg[1] or "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local DB    = arg[2] or "acore_world_release"
local DBC   = DIR .. "/data-files/dbc/"
local OUT   = DIR .. "/src/lua-basic/data/race-class-data.lua"
local MYSQL = DIR .. "/mysql/installed-files/bin/mysql -h127.0.0.1 -P3307 -uritz -pmenardi -N --batch " .. DB

-- {{{ local function die
local function die(msg)
    io.stderr:write("generate-basic-race-class-data: ", msg, "\n")
    os.exit(1)
end
-- }}}

-- {{{ local function load_dbc
local function u32(d, o) local a, b, c, e = d:byte(o + 1, o + 4); return a + b * 256 + c * 65536 + e * 16777216 end
local function load_dbc(name)
    local f = io.open(DBC .. name, "rb") or die("cannot open " .. DBC .. name)
    local d = f:read("*a")
    f:close()
    if d:sub(1, 4) ~= "WDBC" then die(name .. " is not a WDBC file") end
    local n, rs = u32(d, 4), u32(d, 12)
    local strings = 20 + n * rs
    local function str(o)
        local s = strings + u32(d, o)
        return d:sub(s + 1, (d:find("\0", s + 1, true) or s + 1) - 1)
    end
    return n, rs, function(o) return u32(d, o) end, str
end
-- }}}

-- {{{ local function query
local function query(sql)
    local p = io.popen(MYSQL .. " -e \"" .. sql .. "\" 2>&1")
    local rows = {}
    for line in p:lines() do
        if line:find("^mysql: %[Warning%]") then
            -- the password-on-command-line notice; not an error
        elseif line:find("^ERROR") then
            die("query failed: " .. line)
        else
            local r = {}
            for v in line:gmatch("[^\t]+") do r[#r + 1] = tonumber(v) or v end
            rows[#rows + 1] = r
        end
    end
    p:close()
    return rows
end
-- }}}

-- {{{ main
-- ChrRaces.dbc: 0 id, 13 team (0 Alliance, 1 Horde; anything else is a race
-- players can't be), 14 English name. ChrClasses.dbc: 0 id, 4 English name.
local rn, rrs, ru, rstr = load_dbc("ChrRaces.dbc")
local races = {}
for r = 0, rn - 1 do
    local b = 20 + r * rrs
    races[ru(b)] = { name = rstr(b + 14 * 4), team = ru(b + 13 * 4) }
end
local cn, crs, cu, cstr = load_dbc("ChrClasses.dbc")
local classes = {}
for r = 0, cn - 1 do
    local b = 20 + r * crs
    classes[cu(b)] = cstr(b + 4 * 4)
end

-- The pairs a character can be created as.
local can = {}
for _, row in ipairs(query("SELECT race, class FROM playercreateinfo ORDER BY race, class")) do
    local race, class = row[1], row[2]
    if not races[race]   then die("playercreateinfo names race " .. race .. ", which ChrRaces.dbc lacks") end
    if not classes[class] then die("playercreateinfo names class " .. class .. ", which ChrClasses.dbc lacks") end
    if races[race].team > 1 then die("playable race " .. race .. " has team " .. races[race].team) end
    can[race] = can[race] or {}
    table.insert(can[race], class)
end

local out = {}
local function w(s) out[#out + 1] = s end
w("-- race-class-data.lua - GENERATED by scripts/generate-basic-race-class-data")
w("-- from the world database's playercreateinfo and the client's ChrRaces/ChrClasses.dbc;")
w("-- do not edit by hand (issue 617b).")
w("--")
w("-- races[race id]   = { name, team (\"alliance\"/\"horde\"), classes = { class id, ... } }")
w("-- classes[class id] = { name }")
w("return {")
w("    races = {")
local rids = {}
for id in pairs(can) do rids[#rids + 1] = id end
table.sort(rids)
for _, id in ipairs(rids) do
    w(string.format("        [%d] = { name = %q, team = %q, classes = { %s } },",
        id, races[id].name, races[id].team == 0 and "alliance" or "horde", table.concat(can[id], ", ")))
end
w("    },")
w("    classes = {")
local used = {}
for _, id in ipairs(rids) do for _, c in ipairs(can[id]) do used[c] = true end end
local cids = {}
for id in pairs(used) do cids[#cids + 1] = id end
table.sort(cids)
for _, id in ipairs(cids) do w(string.format("        [%d] = { name = %q },", id, classes[id])) end
w("    },")
w("}")
local f = io.open(OUT, "w") or die("cannot write " .. OUT)
f:write(table.concat(out, "\n"), "\n")
f:close()
print(string.format("generate-basic-race-class-data: %d races, %d classes -> %s", #rids, #cids, OUT))
-- }}}
