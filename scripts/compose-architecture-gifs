#!/usr/bin/env luajit

local DIR = "/mnt/kaun/wow-chat-2026"

local attempt, out, only, list = 1, nil, nil, false
do
    local i = 1
    while i <= #arg do
        local a = arg[i]
        if a == "--help" or a == "-h" then
            for line in io.lines(arg[0]) do
                if not line:match("^%-%-") and not line:match("^#!") then break end
                print((line:gsub("^%-%- ?", "")))
            end
            os.exit(0)
        elseif a == "--attempt" then attempt = tonumber(arg[i + 1]) or error("--attempt takes a number"); i = i + 1
        elseif a == "--out"     then out = arg[i + 1]; i = i + 1
        elseif a == "--only"    then only = arg[i + 1]; i = i + 1
        elseif a == "--list"    then list = true
        elseif a:sub(1, 2) ~= "--" then DIR = a
        else error("unknown option " .. a .. " (see --help)") end
        i = i + 1
    end
end
out = out or (DIR .. "/tmp/shared-memory/gifs/attempt-" .. attempt .. "/scores")

local seed = 1
local function rnd()
    seed = (seed * 1103515245 + 12345) % 2147483648
    return seed / 2147483648
end
local function rr(a, b) return a + (b - a) * rnd() end

local function t1(x) return string.format("%.1f", math.floor(x * 10 + 0.5) / 10) end
local function px(p) return string.format("{%d, %d}", math.floor(p[1] + 0.5), math.floor(p[2] + 0.5)) end

local EMIT = {
    line  = "rate = 900, spread = 2, speed = 18, aim = 0.8, drag = 2.2, jitter = 18, life = 0.7",
    fine  = "rate = 500, spread = 1.2, speed = 10, aim = 0.9, drag = 2.5, jitter = 8, life = 0.5",
    fill  = "rate = 700, spread = 1.5, speed = 4, aim = 0, drag = 2.5, jitter = 8, life = 0.8",
    dim   = "rate = 250, spread = 1.5, speed = 3, aim = 0, drag = 2.5, jitter = 6, life = 0.6",
    flash = "rate = 1600, spread = 2, speed = 45, aim = 0, drag = 3, jitter = 10, life = 0.4",
    spark = "rate = 500, spread = 1.5, speed = 20, aim = 0, drag = 3, jitter = 10, life = 0.35",
    rain  = "rate = 700, spread = 3, speed = 60, aim = 1, drag = 0.5, jitter = 4, life = 0.4",
    snow  = "rate = 400, spread = 4, speed = 6, aim = 0.3, drag = 2, jitter = 40, life = 1.2",
}

local S
local LENGTH
local function begin(length)
    S, LENGTH = {}, length
    S[#S + 1] = string.format("canvas{ size = 256, fps = 25, length = %s, seed = %d }", t1(length), 1000 + attempt)
end
local function stroke(at, lasts, color, fade, shape, emit, ease)
    at = math.max(0, math.min(at, LENGTH - 0.2))
    lasts = math.max(0.1, math.min(lasts, LENGTH - math.floor(at * 10 + 0.5) / 10))
    S[#S + 1] = string.format("stroke{ at = %s, lasts = %s, color = %q, fade = %q, ease = %q,\n        shape = %s,\n        emit = { %s } }",
        t1(at), t1(lasts), color, fade, ease or "linear", shape, EMIT[emit] or emit)
end
local function line(a, b) return "line{ from = " .. px(a) .. ", to = " .. px(b) .. " }" end
local function point(a) return "point{ at = " .. px(a) .. " }" end
local function arc(c, r, from, to, turn)
    return string.format("arc{ center = %s, radius = %d, from = %s, to = %s, turn = %q }",
        px(c), math.floor(r + 0.5), t1(from), t1(to), turn or "clockwise")
end
local function circle(c, r) return arc(c, r, 12, 11.9) end
local function fill(vs, sweep)
    local t = {}
    for i, v in ipairs(vs) do t[i] = px(v) end
    return "fill{ vertices = { " .. table.concat(t, ", ") .. " }, sweep = " .. string.format("%q", sweep or "at-once") .. " }"
end
local function box(x, y, w, h) return { { x, y }, { x + w, y }, { x + w, y + h }, { x, y + h } } end

local IDEAS = {}
local function idea(id, page, text, recipe) IDEAS[#IDEAS + 1] = { id = id, page = page, text = text, recipe = recipe } end

idea("1a", 1, "Question cards falling like leaves onto seven rings, each settling into its own ring.", function()
    begin(5.0)
    for r = 1, 7 do stroke(0, 5.0, "ice", "in", circle({ 128, 128 }, 16 * r + 4), "dim") end
    for k = 1, 14 do
        local ring = math.floor(rr(1, 7.99))
        local ang  = rr(0, 6.283)
        local land = { 128 + math.cos(ang) * (16 * ring + 4), 128 + math.sin(ang) * (16 * ring + 4) }
        local at   = 0.4 + k * 0.25
        stroke(at, 0.8, "gold", "out", line({ land[1] + rr(-30, 30), -10 }, land), "line", "ease-out")
        stroke(at + 0.8, 0.6, "gold", "flash", point(land), "spark")
    end
end)
idea("1b", 1, "A tree of locked issues; answering one question at the root unlocks a chain of them, one after another downward.", function()
    begin(5.0)
    local nodes, edges = { { 128, 30 } }, {}
    local level = { 1 }
    for depth = 1, 3 do
        local next = {}
        for _, n in ipairs(level) do
            for b = 1, 2 do
                local p = nodes[n]
                local q = { p[1] + (b == 1 and -1 or 1) * (60 / depth) + rr(-6, 6), p[2] + 62 }
                nodes[#nodes + 1] = q
                edges[#edges + 1] = { n, #nodes, depth }
                next[#next + 1] = #nodes
            end
        end
        level = next
    end
    for _, e in ipairs(edges) do stroke(0, 5.0, "violet", "in", line(nodes[e[1]], nodes[e[2]]), "dim") end
    stroke(1.0, 0.6, "gold", "flash", point(nodes[1]), "flash")
    for _, e in ipairs(edges) do
        local at = 1.2 + (e[3] - 1) * 0.9 + rr(0, 0.3)
        stroke(at, 0.7, "gold", "hold", line(nodes[e[1]], nodes[e[2]]), "line", "stroke")
        stroke(at + 0.7, 0.5, "jade", "flash", point(nodes[e[2]]), "spark")
    end
end)
idea("1c", 1, "A wall of hundreds of grey tiles turning gold in a ripple as questions get answered.", function()
    begin(5.0)
    local ox, oy = rr(0, 256), rr(0, 256)
    for i = 0, 9 do for j = 0, 9 do
        local x, y = 14 + i * 23, 14 + j * 23
        stroke(0, 5.0, "ice", "in", fill(box(x, y, 17, 17)), "dim")
        local d = math.sqrt((x - ox) ^ 2 + (y - oy) ^ 2)
        stroke(0.6 + d / 90, 1.4, "gold", "in-out", fill(box(x, y, 17, 17)), "fill")
    end end
end)
idea("1d", 1, "An answer typed into a message box folds into a paper plane and flies into a folder labelled \"answers\".", function()
    begin(5.0)
    stroke(0, 5.0, "teal", "in", fill(box(30, 150, 110, 40)), "dim")
    stroke(0.4, 1.4, "gold", "hold", line({ 38, 170 }, { 128, 170 }), "fine")
    local folder = { rr(185, 215), rr(40, 70) }
    stroke(0, 5.0, "jade", "in", fill(box(folder[1] - 22, folder[2] - 14, 44, 30)), "dim")
    stroke(2.0, 1.6, "gold", "hold", arc({ (128 + folder[1]) / 2, 170 }, 70, 9, 2.5), "line", "stroke")
    stroke(3.7, 0.8, "gold", "flash", point(folder), "flash")
end)
idea("1e", 1, "A tower of question cards re-sorting itself, the ones that unblock the most rising to the top.", function()
    begin(5.0)
    local hues = { "ice", "teal", "violet", "rose", "jade", "gold", "ember" }
    local order = {}
    for i = 1, 7 do order[i] = i end
    for i = 7, 2, -1 do local j = math.floor(rr(1, i + 0.99)); order[i], order[j] = order[j], order[i] end
    for slot = 1, 7 do
        local card = order[slot]
        local y0, y1 = 30 + slot * 28, 30 + card * 28
        stroke(0, 2.0, hues[card], "out", line({ 70, y0 }, { 186, y0 }), "fine")
        stroke(2.0, 1.0, hues[card], "in-out", line({ 128 + (card - 4) * 8, y0 }, { 128 + (card - 4) * 8, y1 }), "line", "smoothstep")
        stroke(3.0, 2.0, hues[card], "in", line({ 70, y1 }, { 186, y1 }), "fine")
    end
    stroke(3.2, 1.0, "gold", "flash", point({ 128, 58 }), "flash")
end)

idea("2a", 2, "36 green dots exploring a dark map, painting gold cells as they walk, walls turning orange where they bump.", function()
    begin(5.0)
    for b = 1, 8 do
        local p = { rr(40, 216), rr(40, 216) }
        local at = rr(0, 0.5)
        for step = 1, 6 do
            local q = { math.max(12, math.min(244, p[1] + rr(-40, 40))), math.max(12, math.min(244, p[2] + rr(-40, 40))) }
            stroke(at, 0.7, "jade", "hold", line(p, q), "fine")
            stroke(at + 0.3, 5.0, "gold", "in", fill(box(q[1] - 5, q[2] - 5, 10, 10)), "dim")
            if q[1] <= 14 or q[1] >= 242 or q[2] <= 14 or q[2] >= 242 or rnd() < 0.12 then
                stroke(at + 0.6, 4.0, "ember", "in", line({ q[1] - 8, q[2] - 8 }, { q[1] + 8, q[2] + 8 }), "fine")
            end
            p, at = q, at + 0.7
        end
    end
end)
idea("2b", 2, "One bot's step peeled apart into layers: the cell grid, the planned route, the straightened line, the turning arc.", function()
    begin(5.0)
    for k = 0, 8 do
        stroke(0, 5.0, "ice", "in", line({ 20 + k * 27, 20 }, { 20 + k * 27, 236 }), "dim")
        stroke(0, 5.0, "ice", "in", line({ 20, 20 + k * 27 }, { 236, 20 + k * 27 }), "dim")
    end
    local pts = { { 34, 222 } }
    for k = 1, 6 do pts[#pts + 1] = { 34 + k * 30 + rr(-8, 8), 222 - k * 30 + rr(-14, 14) } end
    for k = 1, #pts - 1 do stroke(0.8 + k * 0.2, 1.0, "violet", "hold", line(pts[k], pts[k + 1]), "fine") end
    stroke(2.4, 1.2, "gold", "hold", line(pts[1], pts[#pts]), "line", "stroke")
    stroke(3.6, 1.2, "jade", "hold", arc({ pts[#pts][1] - 30, pts[#pts][2] }, 30, 3, 12, "counterclockwise"), "line", "smoothstep")
end)
idea("2c", 2, "Six small panels, each walking the same maze a different way: one stuck and jittering, the painted map gliding through.", function()
    begin(5.0)
    local stuck = math.floor(rr(1, 5.99))
    for k = 0, 5 do
        local x, y = 12 + (k % 3) * 80, 40 + math.floor(k / 3) * 100
        stroke(0, 5.0, "ice", "in", fill(box(x, y, 72, 80)), "dim")
        stroke(0, 5.0, "ember", "in", line({ x + 36, y }, { x + 36, y + 50 }), "fine")
        if k == stuck then
            local p = { x + 10, y + 70 }
            for j = 1, 10 do
                local q = { x + 22 + rr(-6, 6), y + 40 + rr(-8, 8) }
                stroke(0.3 + j * 0.4, 0.4, "rose", "hold", line(p, q), "fine")
                p = q
            end
        elseif k == 5 then
            stroke(0.4, 4.0, "gold", "hold", arc({ x + 36, y + 62 }, 26, 9, 3, "clockwise"), "line", "smoothstep")
        else
            local mid = { x + 36 + rr(-4, 4), y + 64 + rr(-6, 6) }
            stroke(0.4, 2.0, "jade", "hold", line({ x + 10, y + 70 }, mid), "fine")
            stroke(2.4, 2.0, "jade", "hold", line(mid, { x + 62, y + 10 }), "fine")
        end
    end
end)
idea("2d", 2, "Bots keeping a gap from a wall, the gap narrowing as they near a doorway they need.", function()
    begin(5.0)
    local door = rr(110, 150)
    stroke(0, 5.0, "ember", "in", line({ 128, 10 }, { 128, door - 14 }), "line")
    stroke(0, 5.0, "ember", "in", line({ 128, door + 14 }, { 128, 246 }), "line")
    for b = 1, 4 do
        local y0 = b < 3 and 20 + b * 10 or 236 - (b - 2) * 10
        local gap = 34 + rr(-4, 4)
        stroke(b * 0.3, 2.4, "jade", "hold", line({ 128 - gap, y0 }, { 112, door }), "fine", "ease-out")
        stroke(b * 0.3 + 2.4, 1.6, "jade", "hold", line({ 112, door }, { 220, door + rr(-20, 20) }), "fine")
    end
    stroke(2.6, 1.0, "gold", "flash", point({ 128, door }), "spark")
end)
idea("2e", 2, "A sun and moon cycling over a map as its paint thickens and the routes grow smoother, day after day.", function()
    begin(6.0)
    for day = 0, 2 do
        stroke(day * 2.0, 1.0, "gold", "hold", arc({ 128, 110 }, 96, 9, 3, "clockwise"), "spark")
        stroke(day * 2.0 + 1.0, 1.0, "ice", "hold", arc({ 128, 110 }, 96, 9, 3, "clockwise"), "spark")
        local p, wob = { 24, 220 }, 26 / (day + 1)
        for k = 1, 6 do
            local q = { 24 + k * 35, 220 - k * 12 + rr(-wob, wob) }
            stroke(day * 2.0 + 0.2, 1.6, day == 2 and "gold" or "jade", "in-out", line(p, q), "fine")
            p = q
        end
        stroke(day * 2.0, 2.0, "gold", "in", fill(box(20, 150 + day * 4, 216, 90 - day * 4)), "dim")
    end
end)

