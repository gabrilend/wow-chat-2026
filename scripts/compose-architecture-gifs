    for lap = 0, 1 do
        stroke(0.2 + lap * 2.8, 2.6, "teal", "hold", arc(c, R, 12, 11.9), "line")
        stroke(2.6 + lap * 2.8, 0.4, "gold", "flash", point({ 128, 128 - lap * 14 }), "spark")
        stroke(2.6 + lap * 2.8, 6.0, "gold", "in", line({ 118, 134 - lap * 14 }, { 138, 134 - lap * 14 }), "fine")
