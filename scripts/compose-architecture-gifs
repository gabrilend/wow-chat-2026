            stroke(0.4 + k * 0.4, 4.0, "jade", "in", fill(box(x, 104, 36, 48)), "fill")
        else
            stroke(2.4 + (k - buddies) * 0.4, 0.8, "violet", "flash", point({ x + 18, 128 }), "flash")
            stroke(2.8 + (k - buddies) * 0.4, 2.0, "violet", "in", fill(box(x, 104, 36, 48)), "fill")
        end
    end
end)

local AV = { { 96, 10 }, { 150, 14 }, { 170, 70 }, { 160, 140 }, { 176, 200 }, { 150, 246 }, { 100, 244 }, { 84, 180 }, { 98, 110 }, { 80, 50 } }
idea("5a", 5, "A deck of weather cards (sun, fog, snow, slush) shuffled and dealt onto a timeline, each swelling and fading in turn.", function()
    begin(6.0)
    local kinds = { "gold", "ice", "teal", "violet", "rose", "jade", "ember" }
    for i = 7, 2, -1 do local j = math.floor(rr(1, i + 0.99)); kinds[i], kinds[j] = kinds[j], kinds[i] end
    stroke(0, 6.0, "ice", "in", line({ 10, 200 }, { 246, 200 }), "fine")
    for k = 1, 7 do
        local x = 12 + (k - 1) * 33
        stroke(0.2 + (k - 1) * 0.8, 0.9, kinds[k], "in-out", fill(box(x, 120, 30, 70), "radial"), "fill", "smoothstep")
    end
end)
idea("5b", 5, "Rain freezing into snow mid-fall over a mountain valley, flickering between the two: slush.", function()
    begin(5.0)
    stroke(0, 5.0, "violet", "in", fill({ { 0, 256 }, { 70, 170 }, { 128, 210 }, { 190, 150 }, { 256, 256 } }), "dim")
    for k = 1, 18 do
        local x, at = rr(10, 246), rr(0, 4.3)
        local frozen = at > 2.5 or (at > 1.4 and rnd() < 0.5)
        if frozen then stroke(at, 1.2, "ice", "hold", line({ x, 0 }, { x + rr(-12, 12), 170 }), "snow")
        else stroke(at, 0.5, "teal", "hold", line({ x, 0 }, { x - 6, 170 }), "rain") end
    end
end)
idea("5c", 5, "A dark storm cloud drifting across the Alterac Valley map, leaving a fading glow where it has been.", function()
    begin(6.0)
    stroke(0, 6.0, "ice", "in", fill(AV), "dim")
    local p, heading = { 128, 30 }, 1.5708
    for k = 1, 10 do
        heading = heading + rr(-0.5, 0.5)
        local q = { math.max(95, math.min(160, p[1] + math.cos(heading) * 22)), math.max(20, math.min(236, p[2] + math.sin(heading) * 22)) }
        if q[2] >= 236 then heading = -1.5708 end
        stroke(k * 0.5, 0.5, "violet", "hold", line(p, q), "line")
        stroke(k * 0.5 + 0.5, 2.5, "gold", "out", point(q), "dim")
        p = q
    end
end)
idea("5d", 5, "Two battleground windows side by side, the same sky changing in both at the same moment.", function()
    begin(5.0)
    local seq = { "gold", "ice", "teal", "violet" }
    for i = 4, 2, -1 do local j = math.floor(rr(1, i + 0.99)); seq[i], seq[j] = seq[j], seq[i] end
    for _, x in ipairs({ 14, 136 }) do
        stroke(0, 5.0, "ice", "in", line({ x, 70 }, { x + 106, 70 }), "fine")
        stroke(0, 5.0, "ice", "in", line({ x, 186 }, { x + 106, 186 }), "fine")
        for k, hue in ipairs(seq) do stroke((k - 1) * 1.2, 1.3, hue, "in-out", fill(box(x, 72, 106, 112)), "fill") end
    end
end)
idea("5e", 5, "A heat map of the valley filling in evenly over a long time-lapse as the storm seeks the corners it has visited least.", function()
    begin(6.0)
    stroke(0, 6.0, "ice", "in", fill(AV), "dim")
    local cells = {}
    for j = 0, 9 do for i = 0, 3 do cells[#cells + 1] = { 92 + i * 18, 14 + j * 23 } end end
    for i = #cells, 2, -1 do local j = math.floor(rr(1, i + 0.99)); cells[i], cells[j] = cells[j], cells[i] end
    for k, c in ipairs(cells) do stroke(0.2 + k * 0.13, 6.0, k % 3 == 0 and "ember" or "gold", "in", fill(box(c[1], c[2], 16, 20)), "dim") end
end)

if list then
    for _, it in ipairs(IDEAS) do print(it.id .. "  " .. it.text) end
    os.exit(0)
end
os.execute("mkdir -p '" .. out .. "'")
local written = 0
for _, it in ipairs(IDEAS) do
    if not only or only == it.id then
        seed = attempt * 7919 + it.id:byte(1) * 131 + it.id:byte(2)
        it.recipe()
        local f = io.open(out .. "/" .. it.id .. ".lua", "w") or error("cannot write " .. out .. "/" .. it.id .. ".lua")
        f:write("-- idea: " .. it.text .. "\n-- page: " .. it.page .. "\n-- attempt: " .. attempt
            .. "\n-- written by scripts/compose-architecture-gifs, for the five architecture pages' pictures\n\n")
        f:write(table.concat(S, "\n\n"), "\n")
        f:close()
        written = written + 1
    end
end
print(string.format("%d scores written to %s (attempt %d)", written, out, attempt))
