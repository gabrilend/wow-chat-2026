        local p = { 24 + (k % 8) * 30, 20 + math.floor(k / 8) * 26 }
        local at = 0.2 + k * 0.07
        stroke(at, 0.5, "gold", "out", line(deck, p), "fine", "ease-out")
        stroke(at + 0.5, 6.0, role(), "in", point(p), "spark")
    end
end)
