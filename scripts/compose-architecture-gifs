idea("3e", 3, "A buddy's action bar where the talented abilities glow brighter and get pressed more often.", function()
    begin(5.0)
    local fav = { [math.floor(rr(1, 6.99))] = true, [math.floor(rr(1, 6.99))] = true }
    for k = 1, 6 do
        local x = 22 + (k - 1) * 37
        stroke(0, 5.0, fav[k] and "gold" or "ice", "in", fill(box(x, 110, 30, 30)), "dim")
        local presses = fav[k] and 6 or 1
        for p = 1, presses do stroke(rr(0.3, 4.5), 0.4, fav[k] and "gold" or "ice", "flash", point({ x + 15, 125 }), "flash") end
    end
end)

local function role()
    local r = rnd() * 310
    if r < 259 then return "ember" elseif r < 277 then return "ice" else return "jade" end
end
idea("4a", 4, "A deck dealing 64 figures onto a field, each flipping to show its class colour and a sword, shield or cross for its role.", function()
    begin(6.0)
