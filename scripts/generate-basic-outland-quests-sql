#!/usr/bin/env luajit
-- generate-basic-outland-quests-sql - list every area id that counts as
-- Outland for quests, and write the list into the basic profile's "Outland
-- without quests" SQL (issue 155l).
--
-- For a general audience: every quest is filed under an area, usually the
-- zone it belongs to, a sub-area of it, or the dungeon it happens in. To
-- switch off "all quests in Outland" the SQL needs the ids of all of those
-- areas. This tool reads them from the game client's area table: Outland's
-- zones, Shattrath, the Isle of Quel'Danas, every named place inside them,
-- and every area on an Outland dungeon or raid map (and Magisters' Terrace),
-- then writes them between two marker lines in the SQL file.
--
-- Usage: scripts/generate-basic-outland-quests-sql [PROJECT_DIR]
--   Reads   data-files/dbc/AreaTable.dbc
--   Writes  sql/basic/db_world.src/13-outland-without-quests.apply.sql
--           (only the GENERATED block)

local DIR = arg[1] or "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local DBC = DIR .. "/data-files/dbc/AreaTable.dbc"
local OUT = DIR .. "/sql/basic/db_world.src/13-outland-without-quests.apply.sql"

-- {{{ configuration
local OUTLAND_ZONES = { 3483, 3518, 3519, 3520, 3521, 3522, 3523, 3703, 4080 }
local INSTANCE_MAPS = { 540, 542, 543, 544, 545, 546, 547, 548, 550, 552, 553, 554,
                        555, 556, 557, 558, 564, 565, 585 }
local BEGIN_MARK = "-- >>> GENERATED by scripts/generate-basic-outland-quests-sql"
local END_MARK   = "-- <<< GENERATED END"
-- }}}

-- {{{ local function die
local function die(msg)
    io.stderr:write("generate-basic-outland-quests-sql: ", msg, "\n")
    os.exit(1)
end
-- }}}

-- {{{ main
local f = io.open(DBC, "rb") or die("cannot open " .. DBC)
local d = f:read("*a")
f:close()
if d:sub(1, 4) ~= "WDBC" then die("AreaTable.dbc is not a WDBC file") end
local function u32(o) local a, b, c, e = d:byte(o + 1, o + 4); return a + b * 256 + c * 65536 + e * 16777216 end
local n, rs = u32(4), u32(12)

-- AreaTable.dbc: 0 id, 1 map, 2 parent area
local parent, map = {}, {}
for i = 0, n - 1 do
    local o = 20 + i * rs
    parent[u32(o)] = u32(o + 8)
    map[u32(o)] = u32(o + 4)
end
local zone, inst = {}, {}
for _, z in ipairs(OUTLAND_ZONES) do zone[z] = true end
for _, m in ipairs(INSTANCE_MAPS) do inst[m] = true end

local ids = {}
for id in pairs(parent) do
    local p, hops, inside = id, 0, zone[id] or inst[map[id]]
    while not inside and p and p ~= 0 and hops < 8 do p = parent[p]; hops = hops + 1; inside = zone[p] end
    if inside then ids[#ids + 1] = id end
end
table.sort(ids)
if #ids == 0 then die("no areas found; the client file may have moved") end

local rows = {}
for _, id in ipairs(ids) do rows[#rows + 1] = "(" .. id .. ")" end
local block = table.concat({
    BEGIN_MARK .. " — do not edit by hand",
    "-- Outland's zones, Shattrath, the Isle, every area inside them, and every area on an Outland instance map: " .. #ids,
    "INSERT INTO `tmp_155l_areas` (`area_id`) VALUES " .. table.concat(rows, ",") .. ";",
    END_MARK }, "\n")

f = io.open(OUT, "r") or die("cannot open " .. OUT)
local sql = f:read("*a")
f:close()
local a = sql:find(BEGIN_MARK, 1, true)
local b = sql:find(END_MARK, 1, true)
if not a or not b or b < a then die("markers not found in " .. OUT) end
sql = sql:sub(1, a - 1) .. block .. sql:sub(b + #END_MARK)
f = assert(io.open(OUT, "w"))
f:write(sql)
f:close()
io.write("wrote ", #ids, " area ids into ", OUT, "\n")
-- }}}
