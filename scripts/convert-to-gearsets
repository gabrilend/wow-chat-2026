#!/usr/bin/env luajit
-- convert-to-gearsets
--
-- What it is: a one-time mover (issue 617r, 2026-10-05). Gear lists used to
-- live in two shapes: the elite outfits as a Lua table keyed by buddy type
-- (race, class, role), and the vanilla level-20 starter kit as a matrix
-- inside a bash generator that stamped SQL rows. Both become gearset
-- profiles: one data file each under src/lua-basic/data/gearsets/, every
-- record found by spec (or by class, for the starter kit) and then race.
-- This writes those two files from what exists now, so nothing is typed
-- in again by hand:
--   elite            from src/lua-basic/data/elite-outfit-profiles.lua,
--                    each buddy type mapped to the spec its checklist names
--   vanilla-starter  from the starter kit's generated SQL rows, each item
--                    put in its slot by the item's own inventory type
--                    (read from the vanilla world database)
-- Item names in the comments come from the world database too.
-- Kept until one commit holds its output, then renamed -done (house rule
-- for one-off scripts).
--
-- Usage: scripts/convert-to-gearsets [PROJECT_DIR]

-- {{{ configuration
local DIR = "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end
local MYSQL   = DIR .. "/mysql/installed-files/bin/mysql"
local OUT     = DIR .. "/src/lua-basic/data/gearsets/"
local ELITES  = DIR .. "/src/lua-basic/data/elite-outfit-profiles.lua"
local STARTER = DIR .. "/sql/vanilla/db_world.src/02-starting-equipment.apply.sql"
-- }}}

-- {{{ names
local RACE  = { [1] = "Human", [2] = "Orc", [3] = "Dwarf", [4] = "Night Elf", [5] = "Undead",
                [6] = "Tauren", [7] = "Gnome", [8] = "Troll", [10] = "Blood Elf", [11] = "Draenei" }
local CLASS = { [1] = "Warrior", [2] = "Paladin", [3] = "Hunter", [4] = "Rogue", [5] = "Priest",
                [6] = "Death Knight", [7] = "Shaman", [8] = "Mage", [9] = "Warlock", [11] = "Druid" }
local SLOT  = { [0] = "head", "neck", "shoulders", "shirt", "chest", "waist", "legs", "feet", "wrists",
                "hands", "finger", "finger", "trinket", "trinket", "back", "main hand", "off hand", "ranged" }
-- the spec (talent tree id, TalentTab) each elite was made for, from the
-- checklist in issue 617r: race, class, role -> tree
local ELITE_SPEC = {
    ["Tauren Warrior (damage)"]    = 161,   -- Pozeta, Arms
    ["Troll Warrior (tank)"]       = 163,   -- Xazian, Protection
    ["Tauren Druid (damage)"]      = 283,   -- Shauzhi, Balance
    ["Troll Mage (damage)"]        = 61,    -- Ecaexo, Frost
    ["Orc Shaman (damage)"]        = 261,   -- Kilta, Elemental
    ["Tauren Shaman (healer)"]     = 262,   -- Muspo, Restoration
    ["Blood Elf Paladin (damage)"] = 381,   -- Talriah, Retribution
}
local SPEC_NAME = { [161] = "Warrior: Arms", [163] = "Warrior: Protection", [283] = "Druid: Balance",
                    [61] = "Mage: Frost", [261] = "Shaman: Elemental", [262] = "Shaman: Restoration",
                    [381] = "Paladin: Retribution" }
-- inventory type -> equipment slot (bags and ammo are handled apart)
local INV_SLOT = { [1] = 0, [2] = 1, [3] = 2, [4] = 3, [5] = 4, [20] = 4, [6] = 5, [7] = 6, [8] = 7, [9] = 8,
                   [10] = 9, [11] = 10, [12] = 12, [16] = 14, [13] = 15, [17] = 15, [21] = 15,
                   [14] = 16, [22] = 16, [23] = 16, [15] = 17, [25] = 17, [26] = 17, [28] = 17 }
local INV_BAG, INV_AMMO, INV_QUIVER = 18, 24, 27
-- }}}

-- {{{ local function query
local function query(db, sql)
    local pipe = assert(io.popen(string.format("MYSQL_PWD=menardi '%s' -h127.0.0.1 -P3307 -uritz -N -B %s -e \"%s\" 2>&1", MYSQL, db, sql)))
    local rows = {}
    for line in pipe:lines() do
        if line:match("^ERROR") then error("MySQL: " .. line .. " (is it running? scripts/start-mysql)") end
        local row = {}
        for field in (line .. "\t"):gmatch("([^\t]*)\t") do row[#row + 1] = field end
        rows[#rows + 1] = row
    end
    pipe:close()
    return rows
end
-- }}}

-- {{{ local function facts_of
-- item id -> { name, inv } for every id in the list
local function facts_of(db, ids)
    local list = {}
    for id in pairs(ids) do list[#list + 1] = id end
    local facts = {}
    for _, r in ipairs(query(db, "SELECT entry, name, InventoryType FROM item_template WHERE entry IN (" .. table.concat(list, ",") .. ")")) do
        facts[tonumber(r[1])] = { name = r[2], inv = tonumber(r[3]) }
    end
    for id in pairs(ids) do if not facts[id] then error("item " .. id .. " is not in " .. db) end end
    return facts
end
-- }}}

-- {{{ local function write_profile
-- profile = { name, keyed_by, about (lines), keys = { key = { label, races = { race = record } } } }
local function write_profile(p, facts)
    local o = {}
    local function w(s) o[#o + 1] = s end
    w("--------------------------------------------------------------------------------")
    w("-- data/gearsets/" .. p.name .. ".lua (issue 617r) - a gearset profile")
    w("--")
    for _, line in ipairs(p.about) do w("-- " .. line) end
    w("--")
    w("-- Made from the earlier lists by scripts/convert-to-gearsets (2026-10-05);")
    w("-- edited by hand from here on. Shape: lib/gearsets.info.md.")
    w("--------------------------------------------------------------------------------")
    w("")
    w("return {")
    w(string.format("    name     = %q,", p.name))
    w(string.format("    keyed_by = %q,", p.keyed_by))
    w("    records  = {")
    local keys = {}
    for k in pairs(p.keys) do keys[#keys + 1] = k end
    table.sort(keys)
    for _, k in ipairs(keys) do
        local entry = p.keys[k]
        w(string.format("        [%d] = {   -- %s", k, entry.label))
        local races = {}
        for r in pairs(entry.races) do races[#races + 1] = r end
        table.sort(races)
        for _, r in ipairs(races) do
            local rec = entry.races[r]
            w(string.format("            [%d] = {   -- %s", r, RACE[r]))
            w("                items = {")
            for slot = 0, 17 do
                local id = rec.items[slot]
                if id then w(string.format("                    [%2d] = %5d,   -- %-9s %s", slot, id, SLOT[slot], facts[id].name)) end
            end
            w("                },")
            if rec.bags and #rec.bags > 0 then
                local names = {}
                for _, id in ipairs(rec.bags) do names[#names + 1] = facts[id].name end
                local ids = {}
                for _, id in ipairs(rec.bags) do ids[#ids + 1] = tostring(id) end
                w(string.format("                bags  = { %s },   -- %s", table.concat(ids, ", "), table.concat(names, ", ")))
            end
            if rec.ammo then
                w(string.format("                ammo  = { item = %d, count = %d },   -- %s", rec.ammo.item, rec.ammo.count, facts[rec.ammo.item].name))
            end
            w("            },")
        end
        w("        },")
    end
    w("    },")
    w("}")
    local f = assert(io.open(OUT .. p.name .. ".lua", "w"))
    f:write(table.concat(o, "\n") .. "\n")
    f:close()
    print("wrote " .. OUT .. p.name .. ".lua")
end
-- }}}

os.execute("mkdir -p '" .. OUT .. "'")

-- {{{ elite
do
    local old = dofile(ELITES)
    local ids, keys = {}, {}
    for name, e in pairs(old) do
        local spec = ELITE_SPEC[name] or error("no spec known for elite " .. name)
        keys[spec] = keys[spec] or { label = SPEC_NAME[spec], races = {} }
        keys[spec].races[e.race] = { items = e.items }
        for _, id in pairs(e.items) do ids[id] = true end
    end
    write_profile({ name = "elite", keyed_by = "spec", keys = keys, about = {
        "The bannermen of the Horde and the Alliance: full Tier 1 and Molten Core",
        "or classic-dungeon outfits, first made for Growth's party (owner,",
        "2026-10-04). Nothing from Onyxia, Zul'Gurub, Blackwing Lair or later, and no",
        "PvP gear: scripts/test-gearsets holds every item to that rule against the",
        "world database. Keyed by spec (talent tree id), then race.",
    } }, facts_of("acore_world_basic", ids))
end
-- }}}

-- {{{ vanilla-starter
do
    local f = assert(io.open(STARTER))
    local sql = f:read("*a")
    f:close()
    local rows, ids = {}, {}
    for race, class, item, amount in sql:gmatch("INSERT INTO playercreateinfo_item %(race, class, itemid, amount, Note%) VALUES %((%d+), (%d+), (%d+), (%d+),") do
        rows[#rows + 1] = { tonumber(race), tonumber(class), tonumber(item), tonumber(amount) }
        ids[tonumber(item)] = true
    end
    local facts = facts_of("acore_world_vanilla", ids)
    local HEARTHSTONE = 6948                     -- every kit has one; the generator adds it, it isn't gear
    local keys = {}
    for _, r in ipairs(rows) do
        local race, class, item, amount = r[1], r[2], r[3], r[4]
        keys[class] = keys[class] or { label = CLASS[class], races = {} }
        local rec = keys[class].races[race] or { items = {}, bags = {} }
        keys[class].races[race] = rec
        local inv = facts[item].inv
        if item == HEARTHSTONE then
            -- left to the generator
        elseif inv == INV_BAG or inv == INV_QUIVER then
            for _ = 1, amount do rec.bags[#rec.bags + 1] = item end
        elseif inv == INV_AMMO then
            rec.ammo = { item = item, count = amount }
        elseif INV_SLOT[inv] then
            local slot = INV_SLOT[inv]
            for _ = 1, amount do
                -- a second of the same one-hander goes in the off hand (dual wield)
                if rec.items[slot] then
                    if slot ~= 15 then error(string.format("race %d class %d: two items for slot %d", race, class, slot)) end
                    slot = 16
                end
                rec.items[slot] = item
            end
        else
            error(string.format("item %d (%s): inventory type %d has no slot", item, facts[item].name, inv))
        end
    end
    write_profile({ name = "vanilla-starter", keyed_by = "class", keys = keys, about = {
        "The vanilla profile's level-20 starter kit (issue 148h): white armour by",
        "class, a cape, the race-and-class weapons, three linen bags, a quiver and",
        "arrows for hunters. Keyed by class (a new character has no spec yet), then",
        "race. scripts/generate-vanilla-starting-equipment-sql turns it into the",
        "rows every new vanilla character is given (adding the hearthstone).",
    } }, facts)
end
-- }}}
