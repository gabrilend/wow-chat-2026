#!/usr/bin/env luajit
--------------------------------------------------------------------------------
-- generate-custom-command-help-sql - the `command` table rows for the game
-- master commands this project compiles into the server
--
-- For a general audience: the server's `.help` text, and the level of game
-- master allowed to run each command, come from the world database's
-- `command` table. A command with no row there has no help, and keeps the
-- level written in its code; for basic's own commands that was a permission
-- number no account reaches, so only the server console could run them.
-- This reads the one written description of the project's commands
-- (config/custom-gm-commands.lua) and writes, per profile, an install step's
-- SQL that adds a row for each compiled command that profile has, and one
-- that takes them away again. Lua-handled commands get no row: the server
-- logs an error for a row naming a command it doesn't know.
--
-- Writes, for each profile with such commands:
--   sql/<profile>/db_world.src/34-custom-command-help.apply.sql
--   sql/<profile>/db_world.src/34-custom-command-help.revert.sql
-- installed by E053 (patches/E-patches.sh).
--
-- Usage: scripts/generate-custom-command-help-sql [PROJECT_DIR]
--------------------------------------------------------------------------------

local DIR = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end

local PROFILES = { "basic", "cc-test" }              -- the profiles that compile project commands
local FILE     = "34-custom-command-help"

local commands = dofile(DIR .. "/config/custom-gm-commands.lua")

-- {{{ local function sql_string
-- A MySQL string literal: backslashes and quotes escaped, line breaks as \n.
local function sql_string(s)
    return "'" .. s:gsub("\\", "\\\\"):gsub("'", "''"):gsub("\n", "\\n") .. "'"
end
-- }}}

-- {{{ local function help_text
-- The help in the stock rows' shape: "Syntax: .name args", a blank line,
-- then what it does (and, here, where it runs and which file has it).
local function help_text(c)
    local syntax = "." .. c.name .. (c.args ~= "" and (" " .. c.args) or "")
    local where  = c.console and "In game or on the server console." or "In game only."
    return "Syntax: " .. syntax .. "\n\n" .. c.help .. "\n" .. where .. " (Everland Ghostsong: " .. c.source .. ")"
end
-- }}}

-- {{{ local function has_profile
local function has_profile(c, profile)
    for _, p in ipairs(c.profiles) do if p == profile then return true end end
    return false
end
-- }}}

local stamp = "-- GENERATED by scripts/generate-custom-command-help-sql from config/custom-gm-commands.lua;\n"
           .. "-- don't edit by hand (edit that file and run the script again). Why: the project's\n"
           .. "-- compiled game master commands need `command` rows for their .help text and for\n"
           .. "-- the GM level that may run them (a row's level overrides the code's).\n"

for _, profile in ipairs(PROFILES) do
    local rows = {}
    for _, c in ipairs(commands) do
        if c.kind == "compiled" and has_profile(c, profile) then rows[#rows + 1] = c end
    end
    table.sort(rows, function(a, b) return a.name < b.name end)
    if #rows == 0 then
        print(profile .. ": no compiled commands; nothing written")
    else
        local names, values = {}, {}
        for _, c in ipairs(rows) do
            names[#names + 1]  = sql_string(c.name)
            values[#values + 1] = string.format("    (%s, %d, %s)", sql_string(c.name), c.level, sql_string(help_text(c)))
        end
        local folder = DIR .. "/sql/" .. profile .. "/db_world.src"
        os.execute("mkdir -p '" .. folder .. "'")
        local apply = assert(io.open(folder .. "/" .. FILE .. ".apply.sql", "w"))
        apply:write(stamp, "-- MARKER_E053_APPLY\n",
            "-- " .. FILE .. " (" .. profile .. "): " .. #rows .. " rows. Deleted first, so applying again changes nothing.\n",
            "DELETE FROM `command` WHERE `name` IN (" .. table.concat(names, ", ") .. ");\n",
            "INSERT INTO `command` (`name`, `security`, `help`) VALUES\n", table.concat(values, ",\n"), ";\n")
        apply:close()
        local revert = assert(io.open(folder .. "/" .. FILE .. ".revert.sql", "w"))
        revert:write(stamp, "-- MARKER_E053_REVERT\n",
            "-- " .. FILE .. " revert (" .. profile .. "): the project's command rows removed.\n",
            "DELETE FROM `command` WHERE `name` IN (" .. table.concat(names, ", ") .. ");\n")
        revert:close()
        print(string.format("%s: %d rows -> sql/%s/db_world.src/%s.{apply,revert}.sql", profile, #rows, profile, FILE))
    end
end
