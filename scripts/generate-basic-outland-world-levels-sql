#!/usr/bin/env luajit
-- generate-basic-outland-world-levels-sql - read which creature factions are
-- the players' enemies (or nobody's friends) out of the game client's data
-- files, and write that list into the basic profile's "Outland world
-- creatures +4" SQL (issue 155k).
--
-- For a general audience: basic raises Outland's monsters by four levels
-- (six on the Isle of Quel'Danas) but leaves its friendly people alone — the
-- guards of Honor Hold and Thrallmar, the vendors, the quest folk. Whether a
-- creature is friendly is not stored in the server's database; it comes from
-- the creature's "faction template", a row in the client's data file
-- FactionTemplate.dbc that says which groups it counts as, befriends and
-- attacks. A template whose faction carries a reputation (the Aldor, the
-- Cenarion Expedition, Netherwing...) is instead as friendly as the player's
-- standing with it, which starts at the faction's base reputation
-- (Faction.dbc). This tool reads both files, sorts every template into
--   h  hostile: attacks Alliance or Horde players (red), or a reputation
--      faction every race starts Hostile or Hated with,
--   n  neutral: neither friend nor enemy of any player (yellow: beasts),
-- (and leaves out the rest: some player faction's friends, and every other
-- reputation faction's people, whom a player can befriend), and writes the h
-- and n lists as plain data between two marker lines in the SQL file.
-- Re-running replaces only that block.
--
-- Usage: scripts/generate-basic-outland-world-levels-sql [PROJECT_DIR]
--   Reads   data-files/dbc/FactionTemplate.dbc, data-files/dbc/Faction.dbc
--   Writes  sql/basic/db_world.src/17-outland-world-levels.apply.sql
--           (only the GENERATED block)

local DIR = arg[1] or "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local DBC = DIR .. "/data-files/dbc/"
local OUT = DIR .. "/sql/basic/db_world.src/17-outland-world-levels.apply.sql"

-- {{{ configuration
-- group bits in FactionTemplate's masks (FACTION_MASK_* in the server's DBCEnums.h)
-- (1 = every player: the common "Monster" template 14 is an enemy of 1;
-- leaving it out first gave only 53 hostile templates)
local MASK_PLAYERS = 1 + 2 + 4                       -- all players, Alliance players, Horde players
-- the player factions a template can name one by one in its enemy/friend
-- lists: the Alliance and Horde groups and every playable race's faction
local PLAYER_FACTIONS = { [469] = true, [67] = true,                         -- Alliance, Horde
    [72] = true, [69] = true, [47] = true, [54] = true, [930] = true,        -- Stormwind, Darnassus, Ironforge, Gnomeregan, Exodar
    [76] = true, [81] = true, [68] = true, [530] = true, [911] = true }      -- Orgrimmar, Thunder Bluff, Undercity, Darkspear, Silvermoon
local RECORD_SIZE = 14 * 4                           -- 3.3.5a FactionTemplate.dbc: 14 uint32 fields
local FACTION_SIZE = 57 * 4                          -- 3.3.5a Faction.dbc: 57 fields
local HOSTILE_BELOW = -3000                          -- standing under this is Hostile or Hated (ReputationMgr)
local BEGIN_MARK  = "-- >>> GENERATED by scripts/generate-basic-outland-world-levels-sql"
local END_MARK    = "-- <<< GENERATED END"
-- }}}

-- {{{ local function die
local function die(msg)
    io.stderr:write("generate-basic-outland-world-levels-sql: ", msg, "\n")
    os.exit(1)
end
-- }}}

-- {{{ local function load_dbc
-- Returns the record count, record size and a uint32 reader.
local function load_dbc(name)
    local f = io.open(DBC .. name, "rb") or die("cannot open " .. DBC .. name)
    local d = f:read("*a")
    f:close()
    if d:sub(1, 4) ~= "WDBC" then die(name .. " is not a WDBC file") end
    local function u32(o) local a, b, c, e = d:byte(o + 1, o + 4); return a + b * 256 + c * 65536 + e * 16777216 end
    return u32(4), u32(12), u32
end
-- }}}

-- {{{ local function reputation_factions
-- Faction.dbc: 0 id, 1 reputation index (-1 = none), 2..5 race masks,
-- 6..9 class masks, 10..13 base standing for those masks. Returns, for each
-- faction with a reputation, whether every race that has a base standing
-- starts Hostile or Hated (true) or not (false). A faction with a
-- reputation but no base standing starts everyone at 0 (neutral).
local function reputation_factions()
    local n, rs, u32 = load_dbc("Faction.dbc")
    if rs ~= FACTION_SIZE then die("Faction.dbc records are " .. rs .. " bytes, expected " .. FACTION_SIZE .. " (another client version?)") end
    local hated = {}
    for r = 0, n - 1 do
        local base = 20 + r * rs
        if u32(base + 4) ~= 4294967295 then
            local all_hostile, any = true, false
            for i = 0, 3 do
                if u32(base + (2 + i) * 4) ~= 0 then
                    any = true
                    local v = u32(base + (10 + i) * 4)
                    if v >= 2147483648 then v = v - 4294967296 end
                    if v >= HOSTILE_BELOW then all_hostile = false end
                end
            end
            hated[u32(base)] = any and all_hostile
        end
    end
    return hated
end
-- }}}

-- {{{ local function classify_templates
-- FactionTemplate.dbc: 0 id, 1 faction, 2 flags, 3 our group mask, 4 friend
-- group mask, 5 enemy group mask, 6..9 enemy factions, 10..13 friend
-- factions. A friend of any player faction is left out (not raised) even if
-- it is the other side's enemy: a Honor Hold guard attacks Horde players but
-- is still a townsperson.
local function classify_templates()
    local n, rs, u32 = load_dbc("FactionTemplate.dbc")
    if rs ~= RECORD_SIZE then die("FactionTemplate.dbc records are " .. rs .. " bytes, expected " .. RECORD_SIZE .. " (another client version?)") end
    local hated = reputation_factions()
    local hostile, neutral = {}, {}
    for r = 0, n - 1 do
        local base = 20 + r * rs
        local function field(i) return u32(base + i * 4) end
        local ours, friends, enemies = field(3), field(4), field(5)
        local rep = hated[field(1)]                  -- nil: no reputation; true / false: see above
        local friend_listed, enemy_listed = false, false
        for i = 6, 9   do if PLAYER_FACTIONS[field(i)] then enemy_listed  = true end end
        for i = 10, 13 do if PLAYER_FACTIONS[field(i)] then friend_listed = true end end
        local friendly = bit.band(ours, MASK_PLAYERS) ~= 0 or bit.band(friends, MASK_PLAYERS) ~= 0 or friend_listed
        local attacks  = bit.band(enemies, MASK_PLAYERS) ~= 0 or enemy_listed
        if rep ~= nil then
            -- reputation decides: raise only a faction everyone starts hating
            if rep then hostile[#hostile + 1] = field(0) end
        elseif not friendly then
            if attacks then hostile[#hostile + 1] = field(0) else neutral[#neutral + 1] = field(0) end
        end
    end
    return hostile, neutral
end
-- }}}

-- {{{ main
local hostile, neutral = classify_templates()
if #hostile == 0 or #neutral == 0 then die("an empty list (hostile " .. #hostile .. ", neutral " .. #neutral .. "); the client file may have moved") end
local rows = {}
for _, id in ipairs(hostile) do rows[#rows + 1] = "(" .. id .. ",'h')" end
for _, id in ipairs(neutral) do rows[#rows + 1] = "(" .. id .. ",'n')" end
local block = table.concat({
    BEGIN_MARK .. " — do not edit by hand",
    string.format("-- faction templates no player befriends (FactionTemplate.dbc): %d hostile (h), %d neutral (n)", #hostile, #neutral),
    "INSERT INTO `tmp_155k_factions` (`faction`, `kind`) VALUES " .. table.concat(rows, ",") .. ";",
    END_MARK }, "\n")
local f = io.open(OUT, "r") or die("cannot open " .. OUT)
local sql = f:read("*a")
f:close()
local a = sql:find(BEGIN_MARK, 1, true)
local b = sql:find(END_MARK, 1, true)
if not a or not b or b < a then die("markers not found in " .. OUT) end
sql = sql:sub(1, a - 1) .. block .. sql:sub(b + #END_MARK)
f = assert(io.open(OUT, "w"))
f:write(sql)
f:close()
io.write(string.format("wrote %d hostile and %d neutral faction templates into %s\n", #hostile, #neutral, OUT))
-- }}}
