#!/bin/bash
# scripts/dbimport - Run the dbimport tool with proper library paths
# Wraps the dbimport binary from the active profile's install dir,
# setting LD_LIBRARY_PATH so it finds the project's libmysqlclient
# instead of the system version. Without this wrapper the binary
# aborts on launch with ACE00046 because mysql_get_client_version()
# at runtime (system 8.4.0) differs from MYSQL_VERSION_ID at compile
# (bundled 9.6.0). The authserver / worldserver scripts already
# export LD_LIBRARY_PATH the same way; this is the missing peer.

DIR="/home/ritz/games/azeroth-core/wow-chat-2026"

# {{{ Load active profile (falls back to release if no .profile file)
if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi
# DEFAULT_PROFILE snapshots the no-argument default so --help reports the
# true default even when a --profile flag precedes --help on the command
# line (that flag mutates PROFILE, not the default a bare run would use).
DEFAULT_PROFILE="${PROFILE}"
# }}}

# {{{ parse_args
# Accept --profile <name> or --profile=<name> as a leading override,
# matching the pattern in scripts/authserver and scripts/worldserver.
# Any further arguments are forwarded to dbimport unchanged.
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    PROFILE="${2}"
                    shift 2
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                if [[ -z "${PROFILE}" ]]; then
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                # Stop consuming; remaining args are dbimport's.
                break
                ;;
        esac
    done
    REMAINING_ARGS=("$@")
}
# }}}

# {{{ show_help
show_help() {
    echo "Usage: ./scripts/dbimport [--profile <name>] [dbimport options...]"
    echo ""
    echo "Run the bundled dbimport binary against the active profile's"
    echo "install directory, with LD_LIBRARY_PATH set so it finds the"
    echo "project's libmysqlclient (the system one is the wrong version)."
    echo ""
    echo "Options:"
    echo "  --profile <name>   Use specific profile (default: ${DEFAULT_PROFILE})"
    echo "  --help             Show this help message"
    echo ""
    echo "Anything after these options is passed through to dbimport."
    echo ""
    echo "Current profile: ${PROFILE}"
}
# }}}

# {{{ resolve_paths
resolve_paths() {
    INSTALL_DIR="${DIR}/installed-files-${PROFILE}"
    MYSQL_DIR="${DIR}/mysql/installed-files"
}
# }}}

# =============================================================================
# Main
# =============================================================================

REMAINING_ARGS=()
parse_args "$@"
resolve_paths

if [[ ! -x "${INSTALL_DIR}/bin/dbimport" ]]; then
    echo "Error: dbimport not found for profile '${PROFILE}'"
    echo "Expected: ${INSTALL_DIR}/bin/dbimport"
    echo "Run './scripts/install --profile ${PROFILE}' first."
    exit 1
fi

if [[ ! -d "${MYSQL_DIR}/lib" ]]; then
    echo "Error: project MySQL libs not found at ${MYSQL_DIR}/lib"
    echo "Run './scripts/mysql-install' first."
    exit 1
fi

echo "Running dbimport (profile: ${PROFILE})"
export LD_LIBRARY_PATH="${MYSQL_DIR}/lib:${LD_LIBRARY_PATH}"
cd "${INSTALL_DIR}/bin"
exec ./dbimport "${REMAINING_ARGS[@]}"
