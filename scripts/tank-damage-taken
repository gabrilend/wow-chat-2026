#!/usr/bin/env luajit
--------------------------------------------------------------------------------
-- tank-damage-taken - how hard bosses' melee hits a tank, and how much of it
-- spirit heals back (issue 167).
--
-- For a general audience: to choose how strong spirit's healing should be,
-- we need to know what it is up against. This reads each boss's numbers
-- from the world database (its level, its damage multiplier, its swing
-- time, and the server's damage table for its level and expansion) and
-- works out, with the server's own formulas, what its melee does to a
-- tank: the average and biggest hit after armour, the damage per second,
-- how long the tank lasts with no healing, and what spirit heals while
-- being hit (half rate) as a share of it. Spells are not counted (a
-- caster boss's danger is mostly spells, which live in its script), nor
-- are healers.
--
-- The formulas, from the server's source:
--   hit       = (weapon damage + attack power / 14) x damage multiplier
--               x swing seconds; weapon damage is the level's base damage
--               for the creature's expansion, rolled between x1 and x1.5
--               (Creature::CalculateMinMaxDamage, Creature::SelectLevel)
--   armour    = armour / (armour + 467.5 x boss level - 22167.5), at most
--               75% (attackers above level 59)
--   crushing  = x1.5 damage. The stock chance is 2% per point the boss's
--               weapon skill (level x 5) beats the tank's defence, minus
--               15%, from 4 levels above the tank. Basic (patch B031)
--               starts it at 8 levels above, at 1/5 of the stock chance,
--               ramping to the full chance at 12 (--crushing stock for the
--               stock rule). Defence above the tank's level cap (300 at 60)
--               counts for nothing (Unit::RollMeleeOutcomeAgainst), so a
--               level-60 tank cannot gear it down. Blocks come before
--               crushes in the table and are not modelled (a shield would
--               lower this).
--   world bosses (the boss flag in their type flags) fight as 3 levels
--               above their target for crushing and hit chances
--               (Creature::getLevelForTarget, WorldBossLevelDiff = 3), so a
--               level-73 Kazzak crushes a level-60 tank as a level 63
--               would: never. Their damage and the armour formula still
--               use their real level.
--   spirit    = spirit x stamina / DIVISOR health per 5 seconds, half for
--               5 seconds after damage (patch B049)
--
-- Usage: scripts/tank-damage-taken [PROJECT_DIR] [options]
--   --divisor N    spirit's divisor (B049; default 200)
--   --health N     the tank's health (default 4509: a level-60 warrior
--                  with 300 stamina)
--   --stamina N    (default 200)  --spirit N  (default 145): the spirit
--                  build healing is worked out for
--   --armour N     (default 10000)
--   --avoid F      share of swings missed, dodged or parried (default 0.25)
--   --database D   (default acore_world_basic)
--   --crushing R   basic (default, patch B031) or stock
--------------------------------------------------------------------------------

local DIR = "/mnt/kaun/wow-chat-2026"
local O   = { divisor = 200, health = 4509, stamina = 200, spirit = 145, armour = 10000, avoid = 0.25, database = "acore_world_basic", crushing = "basic" }
do
    local i = 1
    if arg[1] and not arg[1]:match("^%-%-") then DIR = arg[1]; i = 2 end
    while i <= #arg do
        local k = arg[i]:match("^%-%-(.+)$")
        if not k or O[k] == nil or arg[i + 1] == nil then
            io.stderr:write("tank-damage-taken: unknown or incomplete option " .. arg[i] .. " (see the usage at the top)\n"); os.exit(1)
        end
        O[k] = (k == "database" or k == "crushing") and arg[i + 1] or tonumber(arg[i + 1])
        i = i + 2
    end
end
if O.crushing ~= "basic" and O.crushing ~= "stock" then io.stderr:write("tank-damage-taken: --crushing is basic or stock\n"); os.exit(1) end
local DEFENCE    = 300                           -- a level-60 tank's defence cap: more counts for nothing
local TANK_LEVEL = 60
local BOSS_DIFF  = 3                             -- WorldBossLevelDiff in worldserver.conf
local MYSQL   = DIR .. "/mysql/installed-files/bin/mysql -h127.0.0.1 -P3307 -uritz -pmenardi -N -B " .. O.database

-- {{{ the bosses: groups of world database entries, or a dungeon's encounters
-- The vanilla raid bosses and world bosses are named; the Outland dungeon
-- bosses are every creature a dungeon's encounter list credits, spawned in
-- one of the sixteen dungeons basic opens at 60 (E024), at basic's levels.
local GROUPS = {
    { "Level-60 raid bosses",  "t.entry IN (11502, 11988, 15509, 14020, 11583)" },
    { "World bosses",          "t.entry IN (12397, 18728)" },
    { "Outland dungeon bosses (basic's levels)",
      "t.entry IN (SELECT i.creditEntry FROM instance_encounters i JOIN creature c ON c.id = i.creditEntry"
        .. " WHERE i.creditType = 0 AND c.map IN (540,542,543,545,546,547,552,553,554,555,556,557,558,560,269,585))" },
}
-- }}}

-- {{{ local function query
local function query(where)
    local sql = "SELECT t.name, t.minlevel, t.DamageModifier, t.BaseAttackTime, s.attackpower, t.type_flags & 4,"
        .. " CASE t.exp WHEN 0 THEN s.damage_base WHEN 1 THEN s.damage_exp1 ELSE s.damage_exp2 END"
        .. " FROM creature_template t JOIN creature_classlevelstats s ON s.level = t.minlevel AND s.class = t.unit_class"
        .. " WHERE " .. where .. " ORDER BY t.minlevel, t.name"
    local p = io.popen(MYSQL .. ' -e "' .. sql .. '" 2>&1')
    local rows = {}
    for l in p:lines() do
        if not l:match("^mysql: %[Warning%]") then
            local m = {}
            for v in l:gmatch("[^\t]+") do m[#m + 1] = v end
            if #m ~= 7 then io.stderr:write("tank-damage-taken: MySQL said: " .. l .. "\n"); os.exit(1) end
            rows[#rows + 1] = m
        end
    end
    p:close()
    return rows
end
-- }}}

local heal_hit = O.spirit * O.stamina / O.divisor / 5 * 0.5   -- health per second while being hit
print(string.format("tank: %d health, %d armour, %d%% of swings avoided, defence %d; spirit build %d stamina / %d spirit at divisor %d heals %.1f per second while hit (%.1f standing)",
    O.health, O.armour, O.avoid * 100, DEFENCE, O.stamina, O.spirit, O.divisor, heal_hit, heal_hit * 2))
for _, g in ipairs(GROUPS) do
    print("\n" .. g[1])
    print(string.format("%-28s %5s %7s %6s %7s %7s %6s %6s %8s %7s", "boss", "level", "armour", "crush", "avg hit", "big hit", "dps", "dead", "big/hp", "spirit"))
    local rows = query(g[2])
    if #rows == 0 then io.stderr:write("tank-damage-taken: no bosses found for " .. g[1] .. "\n"); os.exit(1) end
    for _, m in ipairs(rows) do
        local lvl, mod, att, ap, dmg = tonumber(m[2]), tonumber(m[3]), tonumber(m[4]) / 1000, tonumber(m[5]), tonumber(m[7])
        local fights_as = tonumber(m[6]) > 0 and (TANK_LEVEL + BOSS_DIFF) or lvl   -- world bosses: 3 above the tank
        local avg   = (dmg * 1.25 + ap / 14) * mod * att
        local big   = (dmg * 1.50 + ap / 14) * mod * att
        local dr    = math.min(0.75, O.armour / (O.armour + 467.5 * lvl - 22167.5))
        local land  = 1 - O.avoid
        local lgap  = fights_as - TANK_LEVEL
        local skill = fights_as * 5 - DEFENCE
        -- crushing: the stock chance is 2% a skill point minus 15%, from 4 levels up and
        -- 15 skill up; basic opens it at 8 levels up at 1/5, full at 12; never more
        -- than the swings that land
        local crush = 0
        if skill >= 15 and lgap >= (O.crushing == "basic" and 8 or 4) then
            crush = (skill * 2 - 15) / 100
            if O.crushing == "basic" and lgap < 12 then crush = crush * (lgap - 7) / 5 end
            crush = math.min(land, crush)
        end
        local dps   = avg * (1 - dr) * ((land - crush) + 1.5 * crush) / att
        local bigh  = big * (1 - dr) * (crush > 0 and 1.5 or 1)
        print(string.format("%-28s %5d %6.1f%% %5.0f%% %7.0f %7.0f %6.0f %5.1fs %7.0f%% %6.1f%%",
            m[1]:sub(1, 28), lvl, dr * 100, crush * 100, avg * (1 - dr), bigh, dps, O.health / dps, bigh / O.health * 100, heal_hit / dps * 100))
    end
end
