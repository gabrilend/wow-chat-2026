#!/bin/bash
# ==== header: 8 lines, footer: 3 lines ====
# id:         test-buddy-pace
# profiles:   all
# priority:   10
# kind:       test
# about:      the tank's pace holds to the owner's design: fast by default, slowed by words, stopped by oom until ready, pulls by the healer's mana, clears by confidence
# quick-test: yes
# ==== end of header ====
# test-buddy-pace - checks the tank's pace in a dungeon (roam/buddy_pace_core.h)
# against the owner's design, with no server (issue 617z).
#
# For a general audience: before each pull a tank asks whether the healer
# could carry it through, from the healer's mana, how recent fights went
# and how heavy the next pack looks. It starts confident, slows when anyone
# says "wait" or "slow down", stops on a healer's "oom" until "ready", and
# grows bolder again with time and with fights that went well. The rule is
# plain arithmetic, so this test builds it alone with the system compiler.
#
# Usage: scripts/test-buddy-pace [PROJECT_DIR] [--help]
# Builds into tmp/tmp/ (the executable tier). Exits non-zero when any
# check fails.

set -uo pipefail

# {{{ configuration
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: scripts/test-buddy-pace [PROJECT_DIR]"
    echo "  Builds and runs the pace core's offline check (tests/buddy-pace/pace-check.cpp)."
    exit 0
fi
DIR="/mnt/kaun/wow-chat-2026"
[[ -n "${1:-}" ]] && DIR="$1"
CORE="${DIR}/patches/B036-mod-buddies/mod-buddies/src/roam"
SOURCE="${DIR}/tests/buddy-pace/pace-check.cpp"
EXEC_DIR="${DIR}/tmp/tmp"
BINARY="${EXEC_DIR}/buddy-pace-check"
# }}}

[[ -d "${DIR}/tmp" ]] || { echo "ERROR: ${DIR}/tmp missing (the project's link to /tmp/<project>)"; exit 1; }
mkdir -p "${EXEC_DIR}"

if ! g++ -std=c++17 -O2 -Wall -Wextra -Werror -I"${CORE}" "${SOURCE}" -o "${BINARY}"; then
    echo "test-buddy-pace: the pace core did not build alone (above); nothing was checked"
    exit 1
fi
"${BINARY}"
# ==== footer of test-buddy-pace ====
# lines:      50
# ==== end of footer ====
