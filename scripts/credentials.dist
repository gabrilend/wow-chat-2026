#!/bin/bash

# credentials - Self-modifying credential manager for wow-chat-2
# Stores credentials within itself and provides functions to read/write them.
# Before any modification, creates a backup at scripts/credentials.bak
#
# SETUP: Copy this file to scripts/credentials and fill in your values:
#   cp scripts/credentials.dist scripts/credentials
#   chmod 600 scripts/credentials
#   # Then edit the CREDENTIALS DATA section below
#
# Usage:
#   source scripts/credentials
#   cred_get "mysql_user"           # Returns: your_user
#   cred_set "mysql_user" "newuser" # Modifies this script, creates backup
#   cred_list                       # Lists all credential keys
#   cred_backup                     # Creates manual backup

# {{{ set_dir
DIR="/home/ritz/games/azeroth-core/wow-chat-2026"
if [[ -n "${1:-}" && -d "${1:-}" ]]; then
    DIR="$1"
fi
CRED_SCRIPT="${DIR}/scripts/credentials"
CRED_BACKUP="${DIR}/scripts/credentials.bak"
# }}}

# {{{ cred_get
# Retrieves a credential value by key
# Usage: cred_get "key_name"
# Returns: value or empty string if not found
function cred_get() {
    local key="$1"
    if [[ -z "${key}" ]]; then
        echo "Error: cred_get requires a key argument" >&2
        return 1
    fi

    # Parse the DATA section of this script for the key
    # Format: # @CRED key=value
    grep "^# @CRED ${key}=" "${CRED_SCRIPT}" 2>/dev/null | sed "s/^# @CRED ${key}=//"
}
# }}}

# {{{ cred_set
# Sets a credential value, modifying this script
# Creates backup before modification
# Usage: cred_set "key_name" "value"
function cred_set() {
    local key="$1"
    local value="$2"

    if [[ -z "${key}" ]]; then
        echo "Error: cred_set requires a key argument" >&2
        return 1
    fi

    # Create backup before any modification
    # Why: Self-modifying scripts are dangerous; always preserve rollback option
    cp "${CRED_SCRIPT}" "${CRED_BACKUP}"
    chmod 600 "${CRED_BACKUP}"
    echo "Backup created: ${CRED_BACKUP}"

    # Check if key exists
    if grep -q "^# @CRED ${key}=" "${CRED_SCRIPT}"; then
        # Update existing key
        # Why: Use | as sed delimiter since values might contain /
        sed -i "s|^# @CRED ${key}=.*|# @CRED ${key}=${value}|" "${CRED_SCRIPT}"
        echo "Updated: ${key}"
    else
        # Add new key before END marker
        sed -i "/^# --- END CREDENTIALS DATA ---/i # @CRED ${key}=${value}" "${CRED_SCRIPT}"
        echo "Added: ${key}"
    fi
}
# }}}

# {{{ cred_delete
# Removes a credential key from the script
# Creates backup before modification
# Usage: cred_delete "key_name"
function cred_delete() {
    local key="$1"

    if [[ -z "${key}" ]]; then
        echo "Error: cred_delete requires a key argument" >&2
        return 1
    fi

    # Create backup before modification
    cp "${CRED_SCRIPT}" "${CRED_BACKUP}"
    chmod 600 "${CRED_BACKUP}"
    echo "Backup created: ${CRED_BACKUP}"

    # Remove the line with this key
    sed -i "/^# @CRED ${key}=/d" "${CRED_SCRIPT}"
    echo "Deleted: ${key}"
}
# }}}

# {{{ cred_list
# Lists all credential keys (not values, for security)
# Usage: cred_list
function cred_list() {
    grep "^# @CRED " "${CRED_SCRIPT}" 2>/dev/null | sed 's/^# @CRED //' | cut -d= -f1
}
# }}}

# {{{ cred_show
# Shows all credentials with values (use carefully)
# Usage: cred_show
function cred_show() {
    echo "=== Credentials ==="
    grep "^# @CRED " "${CRED_SCRIPT}" 2>/dev/null | sed 's/^# @CRED //'
    echo "==================="
}
# }}}

# {{{ cred_backup
# Creates a manual backup
# Usage: cred_backup [optional_suffix]
function cred_backup() {
    local suffix="${1:-bak}"
    local backup_path="${CRED_SCRIPT}.${suffix}"
    cp "${CRED_SCRIPT}" "${backup_path}"
    chmod 600 "${backup_path}"
    echo "Backup created: ${backup_path}"
}
# }}}

# {{{ cred_restore
# Restores from backup
# Usage: cred_restore [optional_suffix]
function cred_restore() {
    local suffix="${1:-bak}"
    local backup_path="${CRED_SCRIPT}.${suffix}"

    if [[ ! -f "${backup_path}" ]]; then
        echo "Error: Backup not found at ${backup_path}" >&2
        return 1
    fi

    cp "${backup_path}" "${CRED_SCRIPT}"
    chmod 600 "${CRED_SCRIPT}"
    echo "Restored from: ${backup_path}"
}
# }}}

# --- CREDENTIALS DATA (DO NOT EDIT MANUALLY) ---
# @CRED mysql_user=YOUR_MYSQL_USER
# @CRED mysql_pass=YOUR_MYSQL_PASSWORD
# @CRED mysql_port=3307
# @CRED mysql_socket=/home/ritz/games/azeroth-core/wow-chat-2026/mysql/databases/mysql.sock
# @CRED db_auth=acore_auth
# @CRED db_world=acore_world
# @CRED db_characters=acore_characters
# soap_user/soap_pass: governor SOAP console account — written automatically
# by `scripts/bot-governor setup` (issue 151), listed here so fresh clones
# know the keys exist. Leave the placeholders; setup replaces them.
# @CRED soap_user=GOVERNOR
# @CRED soap_pass=RUN_BOT_GOVERNOR_SETUP
# --- END CREDENTIALS DATA ---
