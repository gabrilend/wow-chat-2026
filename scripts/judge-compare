#!/usr/bin/env luajit

local DIR, FILE = "/mnt/kaun/wow-chat-2026", nil
do
    local i = 1
    while i <= #arg do
        if arg[i] == "--file" then i = i + 1; FILE = arg[i] else DIR = arg[i] end
        i = i + 1
    end
end
FILE = FILE or (DIR .. "/docs/judgements.tsv")

local f = io.open(FILE)
if not f then print("judge-compare: no judgements yet (" .. FILE .. "); scripts/judge-run VARIANT --ask makes the first"); os.exit(0) end
local scores, judges = {}, {}
for line in f:lines() do
    if not line:find("^#") then
        local _, run, judge, _, score = line:match("^([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)")
        score = tonumber(score)
        if run and score then
            scores[run] = scores[run] or {}
            local s = scores[run][judge] or { n = 0, sum = 0 }
            s.n, s.sum = s.n + 1, s.sum + score
            scores[run][judge] = s
            judges[judge] = true
        end
    end
end
f:close()

local function mean(run, judge) local s = scores[run][judge]; return s and s.sum / s.n or nil end
local runs = {}
for run in pairs(scores) do runs[#runs + 1] = run end
table.sort(runs, function(a, b) return (mean(a, "owner") or -1) > (mean(b, "owner") or -1) end)
local names = {}
for j in pairs(judges) do names[#names + 1] = j end
table.sort(names, function(a, b) return a == "owner" or (b ~= "owner" and a < b) end)
io.write(("%-50s"):format("run"))
for _, j in ipairs(names) do io.write(("%10s"):format(j)) end
print()
for _, run in ipairs(runs) do
    io.write(("%-50s"):format(run))
    for _, j in ipairs(names) do
        local m = mean(run, j)
        io.write(m and ("%10.1f"):format(m) or ("%10s"):format("-"))
    end
    print()
end

local function ranks(values)
    local idx = {}
    for i = 1, #values do idx[i] = i end
    table.sort(idx, function(a, b) return values[a] < values[b] end)
    local r, i = {}, 1
    while i <= #idx do
        local k = i
        while k < #idx and values[idx[k + 1]] == values[idx[i]] do k = k + 1 end
        for m = i, k do r[idx[m]] = (i + k) / 2 end
        i = k + 1
    end
    return r
end
for _, j in ipairs(names) do
    if j ~= "owner" then
        local a, b = {}, {}
        for _, run in ipairs(runs) do
            if mean(run, "owner") and mean(run, j) then a[#a + 1], b[#b + 1] = mean(run, "owner"), mean(run, j) end
        end
        if #a < 3 then
            print(("%s: %d runs judged by both; 3 are needed to compare orders"):format(j, #a))
        else
            local ra, rb = ranks(a), ranks(b)
            local ma, mb = 0, 0
            for i = 1, #a do ma, mb = ma + ra[i], mb + rb[i] end
            ma, mb = ma / #a, mb / #a
            local num, da, db = 0, 0, 0
            for i = 1, #a do num = num + (ra[i] - ma) * (rb[i] - mb); da = da + (ra[i] - ma) ^ 2; db = db + (rb[i] - mb) ^ 2 end
            local rho = (da > 0 and db > 0) and num / math.sqrt(da * db) or 0
            print(("%s: agrees with the owner's order at %.2f over %d runs (1 the same order, 0 none, -1 reversed)"):format(j, rho, #a))
        end
    end
end
