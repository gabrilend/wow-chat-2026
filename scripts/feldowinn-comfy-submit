#!/usr/bin/env luajit
-- feldowinn-comfy-submit - send one Feldowinn design profile through ComfyUI
-- and keep what comes back (issues 506b, 506c). UNTESTED as of 2026-09-27:
-- ComfyUI could not run yet; the steps to test it are in those issues.
--
-- For a general audience: ComfyUI is the picture (and 3D) generator being
-- installed on this machine. It runs "workflows": graphs of steps, saved as
-- files in assets/feldowinn/comfyui/. This tool fills a workflow's blanks
-- from one design profile (its prompt, a seed, where to save), hands the
-- graph to ComfyUI over its web interface, waits for it to finish, and
-- writes down exactly how the result was made (prompt, seed, workflow
-- fingerprint), so any result can be made again or explained. A result
-- without that record would be refused by the asset forge's rules
-- (world-edit-to-execute W05).
--
-- Where results go: ComfyUI's own output folder (the installation's config:
-- output-directory = output, so /mnt/kaun/stable-diffusion/output), one
-- folder per profile: feldowinn/<profile id>/view_NNNNN_.png for concept
-- views, feldowinn/<profile id>/model_NNNNN_.glb for 3D models. The folder
-- name ties every file to its profile (the gallery reads it: issue 506d),
-- and later stages (more views, meshes, animation, the game's model format)
-- add their files to the same folder. When ComfyUI runs on another machine
-- the files are fetched into the same layout here.
--
-- Usage: scripts/feldowinn-comfy-submit [PROJECT_DIR] --profile ID [options]
--   --workflow concept|concept-scribble|to-3d|multiview|to-3d-multiview   (default concept)
--                     multiview: eight views round the design's concept view,
--                     one ring of assets/feldowinn/camera-plan.lua per run (506e);
--                     to-3d-multiview: a mesh from four of the middle ring's
--                     views (front, left, back, right) through Hunyuan3D-2's
--                     multi-view input (506f)
--   --ring NAME       multiview: which ring (middle, above, below, higher, lower;
--                     default middle). For the 3- or 5-ring level run it once
--                     per ring.
--   Remote GPU host: --server http://HOST:8188 works as is; ComfyUI saves on
--   its machine and each output is fetched through its /view endpoint into
--   the same per-design folder here (the fetch below).
--   --seed N          (default: from the profile id, so reruns match)
--   --server URL      (default http://127.0.0.1:8188, the installation's config)
--   --image PATH      to-3d: the concept image (default the profile's newest view_*.png)
--   --control PATH    concept-scribble: the silhouette sketch
--   --ckpt NAME       to-3d / multiview / to-3d-multiview: the checkpoint file name in ComfyUI's
--                     checkpoints folder (default hunyuan3d-dit-v2-mini.safetensors)
--   --timeout SECONDS (default 600; to-3d 3600)
--   --libs DIR        where dkjson.lua lives (default /home/ritz/programming/ai-stuff/libs/lua)
--   --sd-dir DIR      the ComfyUI installation (default /mnt/kaun/stable-diffusion)
-- Reads   assets/feldowinn/profiles/round-*.lua, assets/feldowinn/comfyui/WORKFLOW.json
-- Writes  SD-DIR/output/feldowinn/ID/view_*.png (concept) or .../model_*.glb (to-3d)
--         (ComfyUI writes them; fetched here only if missing) and one line per
--         file appended to assets/feldowinn/generated.tsv

-- {{{ arguments
local DIR = "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local opt = { workflow = "concept", server = "http://127.0.0.1:8188",
              libs = "/home/ritz/programming/ai-stuff/libs/lua", ["sd-dir"] = "/mnt/kaun/stable-diffusion" }
do
    local i = 1
    local takes = { profile = 1, workflow = 1, seed = 1, server = 1, image = 1, control = 1, ckpt = 1, timeout = 1, libs = 1, ["sd-dir"] = 1, ring = 1 }
    while i <= #arg do
        local a = arg[i]
        local key = a:match("^%-%-(.+)$")
        if key then
            if not takes[key] then error("feldowinn-comfy-submit: unknown option --" .. key) end
            opt[key] = arg[i + 1]
            i = i + 2
        else
            DIR = a
            i = i + 1
        end
    end
end
assert(opt.profile, "feldowinn-comfy-submit: --profile ID is required (an id from assets/feldowinn/profiles/round-*.lua)")
package.path = opt.libs .. "/?.lua;" .. package.path
local json = require("dkjson")
local HERE = DIR .. "/assets/feldowinn"
local P = dofile(DIR .. "/src/tools/feldowinn/profiles.lua")
-- Each workflow's defaults: the checkpoint it loads (the file name in
-- ComfyUI's checkpoints folder), how long it may take, and the file name
-- prefix its outputs get in the design's folder. Weights are the one thing
-- downloaded from others (the owner, 2026-09-27: built-in nodes only, "I
-- can do a model though, because models do not determine behavior");
-- safetensors files are preferred, and ComfyUI loads any other kind in
-- PyTorch's weights-only mode, which refuses to run code stored in it.
local WORKFLOW = {
    ["concept"]          = { timeout = 600,  kind = "view" },
    ["concept-scribble"] = { timeout = 600,  kind = "view" },
    ["to-3d"]            = { timeout = 3600, kind = "model", ckpt = "hunyuan3d-dit-v2-mini.safetensors" },
    ["multiview"]        = { timeout = 1200, kind = "mv",    ckpt = "stable_zero123.ckpt" },
    ["to-3d-multiview"]  = { timeout = 3600, kind = "model", ckpt = "hunyuan3d-dit-v2-mv.safetensors" },
}
local WF = WORKFLOW[opt.workflow] or error("feldowinn-comfy-submit: unknown workflow " .. opt.workflow)
opt.ckpt = opt.ckpt or WF.ckpt
local TIMEOUT = tonumber(opt.timeout) or WF.timeout
local SD_OUT  = opt["sd-dir"] .. "/output"                   -- the installation's output-directory
local CAMERAS = dofile(DIR .. "/assets/feldowinn/camera-plan.lua")
-- }}}

-- {{{ local function sh
-- Run a command, return its output; fail loudly with what was run.
local function sh(cmd)
    local p = io.popen(cmd .. " 2>&1; echo \"__exit=$?\"")
    local out = p:read("*a")
    p:close()
    local code = tonumber(out:match("__exit=(%d+)%s*$"))
    out = out:gsub("__exit=%d+%s*$", "")
    if code ~= 0 then error(string.format("feldowinn-comfy-submit: command failed (exit %d):\n  %s\n%s", code, cmd, out)) end
    return out
end
local function q(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end
-- }}}

-- {{{ find the profile
local profile
do
    local ls = io.popen("ls -1 " .. q(HERE .. "/profiles") .. " 2>/dev/null")
    for name in ls:lines() do
        if name:match("^round%-%d+%.lua$") then
            for _, pr in ipairs(dofile(HERE .. "/profiles/" .. name).profiles) do
                if pr.id == opt.profile then profile = pr end
            end
        end
    end
    ls:close()
    assert(profile, "feldowinn-comfy-submit: no profile " .. opt.profile .. " in " .. HERE .. "/profiles (made by scripts/generate-feldowinn-profiles)")
end
-- }}}

-- {{{ local function upload
-- Upload a local image into ComfyUI's input folder; returns the name
-- ComfyUI gave it (the /upload/image endpoint answers {name, subfolder, type}).
local function upload(path)
    local f = io.open(path, "rb")
    assert(f, "feldowinn-comfy-submit: no image at " .. path)
    f:close()
    local answer = json.decode(sh("curl -sS -f -F " .. q("image=@" .. path) .. " " .. q(opt.server .. "/upload/image")))
    assert(answer and answer.name, "feldowinn-comfy-submit: upload of " .. path .. " gave no name")
    return answer.name
end
-- }}}

-- {{{ fill the workflow
-- Placeholders are quoted strings in the workflow file ("__PROMPT__"); each
-- is replaced by a JSON value: text as a JSON string, the seed as a bare
-- number. A placeholder left unfilled is an error (ComfyUI would take the
-- literal text).
local wf_path = HERE .. "/comfyui/" .. opt.workflow .. ".json"
local wf_file = assert(io.open(wf_path), "feldowinn-comfy-submit: no workflow " .. wf_path)
local graph_text = wf_file:read("*a")
wf_file:close()
local seed = tonumber(opt.seed) or tonumber(profile.id, 16)
-- multiview: one run makes one ring of the camera plan (--ring NAME,
-- default middle): eight views, saved as mv_<ring>_NNNNN_.png
local ring
if opt.workflow == "multiview" then
    for _, r in ipairs(CAMERAS.rings) do if r.name == (opt.ring or "middle") then ring = r end end
    assert(ring, "feldowinn-comfy-submit: no ring " .. tostring(opt.ring) .. " in assets/feldowinn/camera-plan.lua")
end
local prefix = "feldowinn/" .. profile.id .. "/" .. WF.kind .. (ring and ("_" .. ring.name) or "")
local fill = {
    __PROMPT__    = json.encode(profile.prompt),
    __NEGATIVE__  = json.encode(P.NEGATIVE),
    __SEED__      = tostring(seed),
    __PREFIX__    = json.encode(prefix),
    __CKPT__      = opt.ckpt and json.encode(opt.ckpt) or nil,
    __ELEVATION__ = ring and tostring(ring.elevation) or nil,
}
-- to-3d-multiview: the four views Hunyuan3D-2's multi-view input takes,
-- from the design's middle ring (made by the multiview workflow first)
if graph_text:find("__IMAGE_FRONT__", 1, true) then
    local list = sh("ls -1 " .. q(SD_OUT .. "/feldowinn/" .. profile.id) .. "/" .. CAMERAS.view_prefix .. "_middle_*.png 2>/dev/null || true")
    local views = {}
    for path in list:gmatch("[^\n]+") do views[#views + 1] = path end
    table.sort(views)
    assert(#views >= 8, "feldowinn-comfy-submit: profile " .. profile.id .. " has " .. #views .. " middle-ring views; run --workflow multiview --ring middle first")
    -- the newest run's eight: the last eight in name order
    local base = #views - 8
    for key, index in pairs(CAMERAS.mesh_inputs) do
        fill["__IMAGE_" .. key:upper() .. "__"] = json.encode(upload(views[base + index + 1]))
    end
end
if graph_text:find("__IMAGE__", 1, true) then
    -- default: the profile's newest concept view in its output folder
    local image = opt.image
    if not image then
        local newest = sh("ls -1t " .. q(SD_OUT .. "/feldowinn/" .. profile.id) .. "/view_*.png 2>/dev/null | head -1 || true")
        image = newest:match("^(%S+)")
        assert(image, "feldowinn-comfy-submit: profile " .. profile.id .. " has no concept view in " .. SD_OUT .. "/feldowinn/" .. profile.id .. " (run the concept workflow first, or pass --image)")
    end
    fill.__IMAGE__ = json.encode(upload(image))
end
if graph_text:find("__CONTROL_IMAGE__", 1, true) then
    assert(opt.control, "feldowinn-comfy-submit: workflow " .. opt.workflow .. " needs --control PATH (a silhouette sketch)")
    fill.__CONTROL_IMAGE__ = json.encode(upload(opt.control))
end
graph_text = graph_text:gsub('"(__[%u_]+__)"', function(name)
    return fill[name] or error("feldowinn-comfy-submit: workflow " .. wf_path .. " has " .. name .. ", which nothing fills")
end)
local graph = assert(json.decode(graph_text), "feldowinn-comfy-submit: the filled workflow is not valid JSON")
-- }}}

-- {{{ submit and wait
local body = os.tmpname()
do
    local f = assert(io.open(body, "w"))
    f:write(json.encode({ prompt = graph, client_id = "feldowinn-" .. profile.id }))
    f:close()
end
local queued = json.decode(sh("curl -sS -f -H 'Content-Type: application/json' --data-binary @" .. q(body) .. " " .. q(opt.server .. "/prompt")))
os.remove(body)
assert(queued and queued.prompt_id, "feldowinn-comfy-submit: ComfyUI didn't queue the workflow (no prompt_id in its answer)")
print("queued " .. queued.prompt_id .. " (" .. opt.workflow .. ", profile " .. profile.id .. ", seed " .. seed .. ")")

-- ComfyUI's history holds a prompt once it has finished (or failed); poll
-- every 2 seconds. Running out of time is a failure, never a result.
local record
local waited = 0
while waited <= TIMEOUT do
    local h = json.decode(sh("curl -sS -f " .. q(opt.server .. "/history/" .. queued.prompt_id)))
    record = h and h[queued.prompt_id]
    if record then break end
    sh("sleep 2")
    waited = waited + 2
end
if not record then error(string.format("feldowinn-comfy-submit: no result after %d seconds (prompt %s is still queued or running; nothing was saved)", TIMEOUT, queued.prompt_id)) end
if record.status and record.status.status_str == "error" then
    error("feldowinn-comfy-submit: ComfyUI reported an error for " .. queued.prompt_id .. ": " .. json.encode(record.status.messages or {}))
end
-- }}}

-- {{{ fetch the outputs
-- Every output node lists the files it saved ({filename, subfolder, type})
-- under some key ("images" for pictures; the 3D saver uses its own key):
-- take every such list.
local files = {}
for _, out in pairs(record.outputs or {}) do
    for _, list in pairs(out) do
        if type(list) == "table" then
            for _, it in ipairs(list) do
                if type(it) == "table" and it.filename then files[#files + 1] = it end
            end
        end
    end
end
assert(#files > 0, "feldowinn-comfy-submit: " .. queued.prompt_id .. " finished but saved no files")
local wf_hash = sh("sha256sum " .. q(wf_path)):match("^(%x+)")
local log = assert(io.open(HERE .. "/generated.tsv", "a"))
for _, it in ipairs(files) do
    -- where ComfyUI put it: output/<subfolder>/<filename>; fetched through
    -- its /view endpoint only when not already on this machine
    local dest = SD_OUT .. "/" .. ((it.subfolder or "") ~= "" and (it.subfolder .. "/") or "") .. it.filename
    local present = io.open(dest, "rb")
    if present then
        present:close()
    else
        sh("mkdir -p " .. q(dest:match("^(.*)/")))
        local url = string.format("%s/view?filename=%s&subfolder=%s&type=%s", opt.server, it.filename, it.subfolder or "", it.type or "output")
        sh("curl -sS -f -o " .. q(dest) .. " " .. q(url))
    end
    -- id, workflow, seed, workflow sha256, file, time, prompt
    log:write(table.concat({ profile.id, opt.workflow, tostring(seed), wf_hash, dest, os.date("!%Y-%m-%dT%H:%M:%SZ"), profile.prompt }, "\t"), "\n")
    print("saved " .. dest)
end
log:close()
-- }}}
