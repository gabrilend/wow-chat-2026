#!/usr/bin/env luajit
-- generate-buddy-kit-tiers - the buddies' gear tiers (issue 617a4), as a
-- table the buddy module compiles in.
--
-- For a general audience: a new buddy of level 20 or more wears the same
-- hand-chosen white kit a vanilla-profile character starts with (issue
-- 148h: one kit per race and class, chosen by theme). The owner
-- (2026-09-28): "for the level 20 list, can you use the one we made for the
-- starting gear in a different profile? Eventually we'll manually create
-- each of the tiers." This reads that kit from the vanilla profile's
-- generated SQL (its own generator is the source of truth) and writes
-- modules/mod-buddies/src/buddies_kit_tiers.h. More tiers are added as more
-- kit files, one per level, listed in TIERS below.
--
-- It also writes basic's install step E048 (sql/basic/db_world.src/
-- 30-buddy-kit-required-level.{apply,revert}.sql): a tier's items whose
-- required level is above the tier's level come down to it, so a buddy of
-- that level can wear its kit (the owner: "they also might require some
-- item edits for the required level changes [...] Make sure we get the
-- required level changes too"). The same edit vanilla makes (its E018
-- step 2); vanilla's damage normalising is not taken. The original values
-- are saved first and the revert restores them exactly.
--
-- Usage: scripts/generate-buddy-kit-tiers [PROJECT_DIR]

local DIR = arg[1] or "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
-- each tier: the lowest level it is for, and the SQL file holding its kit
-- rows (playercreateinfo_item inserts, with a Note naming the kit)
local TIERS = {
    { level = 20, file = DIR .. "/sql/vanilla/db_world.src/02-starting-equipment.apply.sql", note = "vanilla-148h" },
}
local OUT = DIR .. "/modules/mod-buddies/src/buddies_kit_tiers.h"
local SQL_APPLY  = DIR .. "/sql/basic/db_world.src/30-buddy-kit-required-level.apply.sql"
local SQL_REVERT = DIR .. "/sql/basic/db_world.src/30-buddy-kit-required-level.revert.sql"
local tier_items = {}   -- tier level -> { item = true }

local rows = {}
for _, tier in ipairs(TIERS) do
    local f = assert(io.open(tier.file), "generate-buddy-kit-tiers: can't read " .. tier.file)
    local n = 0
    for line in f:lines() do
        local race, cls, item, amount, note = line:match(
            "^INSERT INTO playercreateinfo_item %(race, class, itemid, amount, Note%) VALUES %((%d+), (%d+), (%d+), (%d+), '([^']*)'%);")
        if race and note:sub(1, #tier.note) == tier.note then
            tier_items[tier.level] = tier_items[tier.level] or {}
            tier_items[tier.level][tonumber(item)] = true
            rows[#rows + 1] = string.format("    { %3d, %2d, %2d, %6d, %2d },   // %s", tier.level, race, cls, item, amount, note)
            n = n + 1
        end
    end
    f:close()
    assert(n > 0, "generate-buddy-kit-tiers: no kit rows found in " .. tier.file .. " (the vanilla kit generator's format may have changed)")
    print(string.format("generate-buddy-kit-tiers: tier %d: %d rows from %s", tier.level, n, tier.file))
end

local out = assert(io.open(OUT, "w"))
out:write([[/*
 * buddies_kit_tiers.h - GENERATED by scripts/generate-buddy-kit-tiers; don't
 * edit by hand. The buddies' gear tiers (issue 617a4): for each tier (the
 * lowest level it is for), each race and class's kit items. A buddy wears
 * the highest tier at or below its level; slots a tier leaves empty are
 * filled from what vendors sell (buddies_kit.cpp).
 */

#ifndef MOD_BUDDIES_KIT_TIERS_H
#define MOD_BUDDIES_KIT_TIERS_H

#include <cstdint>

struct BuddyKitTierItem
{
    uint8_t  level;    // the tier: the lowest buddy level it is for
    uint8_t  race;
    uint8_t  cls;
    uint32_t item;
    uint8_t  amount;
};

static BuddyKitTierItem const sBuddyKitTiers[] = {
]] .. table.concat(rows, "\n") .. [[

};

#endif
]])
out:close()
print("generate-buddy-kit-tiers: wrote " .. OUT .. " (" .. #rows .. " rows)")

-- {{{ basic's E048: the tiers' required levels
local apply, revert = {}, {}
apply[#apply + 1] = [[-- MARKER_E048_APPLY basic-buddy-kit-required-level
-- GENERATED by scripts/generate-buddy-kit-tiers; don't edit by hand.
-- Issue 617a4. A buddy's gear tier is worn from the tier's level, so a
-- tier item whose required level is above that level comes down to it.
-- Only those items move; the originals are saved first (INSERT IGNORE: a
-- re-apply never overwrites them) and the revert restores them exactly.
-- These are ordinary world items: players on basic can wear them from the
-- same level too.
CREATE TABLE IF NOT EXISTS `basic_617a4_kit_originals` (
    `entry`         INT UNSIGNED     NOT NULL PRIMARY KEY,
    `RequiredLevel` TINYINT UNSIGNED NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='617a4: required levels before the buddy kit tiers lowered them';
]]
revert[#revert + 1] = [[-- MARKER_E048_REVERT basic-buddy-kit-required-level
-- GENERATED by scripts/generate-buddy-kit-tiers; don't edit by hand.
-- Restores the saved required levels, then drops the saved copy.
UPDATE item_template it JOIN basic_617a4_kit_originals o ON o.entry = it.entry SET it.RequiredLevel = o.RequiredLevel;
DROP TABLE IF EXISTS basic_617a4_kit_originals;
]]
local levels = {}
for level in pairs(tier_items) do levels[#levels + 1] = level end
table.sort(levels)
for _, level in ipairs(levels) do
    local ids = {}
    for id in pairs(tier_items[level]) do ids[#ids + 1] = id end
    table.sort(ids)
    local list = table.concat(ids, ", ")
    apply[#apply + 1] = string.format(
        "\n-- tier %d: %d items\nINSERT IGNORE INTO basic_617a4_kit_originals (entry, RequiredLevel)\n  SELECT entry, RequiredLevel FROM item_template WHERE RequiredLevel > %d AND entry IN (%s);\n"
        .. "UPDATE item_template SET RequiredLevel = %d WHERE RequiredLevel > %d AND entry IN (%s);\n",
        level, #ids, level, list, level, level, list)
end
for path, lines in pairs({ [SQL_APPLY] = apply, [SQL_REVERT] = revert }) do
    local o = assert(io.open(path, "w")); o:write(table.concat(lines)); o:close()
    print("generate-buddy-kit-tiers: wrote " .. path)
end
-- }}}
