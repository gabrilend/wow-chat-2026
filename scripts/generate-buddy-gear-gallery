#!/usr/bin/env luajit
-- generate-buddy-gear-gallery - build the page showing what new buddies wear
-- (issue 617r5).
--
-- For a general audience: buddies are made wearing the "buddy-white" gear
-- lists (src/lua-basic/data/gearsets/buddy-white-*.lua, written by
-- scripts/translate-buddy-kit-to-gearset). This gathers them onto one page:
-- a card for each class at each ten-level tier (10 classes x levels 10, 20,
-- 30, 40, 50, 60 = 60 cards), each with a picker for the class's ten talent
-- shapes, the gear laid out like the game's character pane (left column,
-- right column, weapons below), and a tooltip on every item read from the
-- world database (quality, slot and kind, armour, damage, stats, sockets,
-- required level). The middle of each card sums the outfit's numbers; the
-- turning 3D figure there waits on the custom client drawing items on a
-- character (617r5, 173d).
--
-- Data and view are apart: this script writes the data (one JSON block);
-- scripts/templates/buddy-gear-gallery.html is the page that draws it.
-- Run by scripts/compile before every build, so the page follows the lists.
--
-- Usage: scripts/generate-buddy-gear-gallery [PROJECT_DIR]
--   Reads   src/lua-basic/data/gearsets/buddy-white-{10..60}.lua,
--           src/lua-basic/data/buddy-talent-data.lua, the world database
--           (acore_world_basic: item_template), scripts/templates/buddy-gear-gallery.html
--   Writes  docs/HTML/buddy-gear-gallery.html
-- Needs MySQL running (scripts/start-mysql); says so and stops otherwise.

-- {{{ configuration
local DIR = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end
local MYSQL    = DIR .. "/mysql/installed-files/bin/mysql"
local WORLD    = "acore_world_basic"
local TEMPLATE = DIR .. "/scripts/templates/buddy-gear-gallery.html"
local OUT      = DIR .. "/docs/HTML/buddy-gear-gallery.html"
local TIERS    = { 10, 20, 30, 40, 50, 60 }     -- a card's level: the record at exactly that level
package.path = "/home/ritz/programming/ai-stuff/libs/lua/?.lua;" .. package.path
local json = require("dkjson")
local TD   = dofile(DIR .. "/src/lua-basic/data/buddy-talent-data.lua")
-- }}}

-- {{{ local function query
local function query(sql)
    local pipe = assert(io.popen(string.format("MYSQL_PWD=menardi '%s' -h127.0.0.1 -P3307 -uritz -N -B %s -e \"%s\" 2>&1", MYSQL, WORLD, sql)))
    local rows = {}
    for line in pipe:lines() do
        if line:match("^ERROR") then error("MySQL: " .. line .. " (is it running? scripts/start-mysql)") end
        local row = {}
        for field in (line .. "\t"):gmatch("([^\t]*)\t") do row[#row + 1] = field end
        rows[#rows + 1] = row
    end
    pipe:close()
    return rows
end
-- }}}

-- {{{ the records: class -> tier -> shape -> { slot = item }
local classes, wanted = {}, {}
local class_ids = {}
for id in pairs(TD.classes) do class_ids[#class_ids + 1] = id end
table.sort(class_ids)
local profiles = {}
for _, tier in ipairs(TIERS) do
    profiles[tier] = assert(dofile(string.format("%s/src/lua-basic/data/gearsets/buddy-white-%d.lua", DIR, tier)))
end
for _, cid in ipairs(class_ids) do
    local c = TD.classes[cid]
    if c.shapes then
        local entry = { id = cid, name = c.name, shapes = {}, tiers = {} }
        for i, shape in ipairs(c.shapes) do entry.shapes[i] = shape.label end
        for _, tier in ipairs(TIERS) do
            local per = {}
            for i = 1, #c.shapes do
                local levels = profiles[tier].records[cid * 100 + i]
                local rec = levels and levels[tier]
                if not rec then error(string.format("buddy-white-%d has no level-%d record for %s shape %d (re-run scripts/translate-buddy-kit-to-gearset)", tier, tier, c.name, i)) end
                local items = {}
                for slot, item in pairs(rec.items) do items[tostring(slot)] = item; wanted[item] = true end
                per[i] = items
            end
            entry.tiers[tostring(tier)] = per
        end
        classes[#classes + 1] = entry
    end
end
-- }}}

-- {{{ the items, from the world database
local ids = {}
for id in pairs(wanted) do ids[#ids + 1] = tostring(id) end
local cols = { "entry", "name", "Quality", "InventoryType", "class", "subclass", "RequiredLevel", "ItemLevel", "armor",
               "dmg_min1", "dmg_max1", "delay", "socketColor_1", "socketColor_2", "socketColor_3" }
for i = 1, 10 do cols[#cols + 1] = "stat_type" .. i; cols[#cols + 1] = "stat_value" .. i end
local items = {}
for _, r in ipairs(query("SELECT " .. table.concat(cols, ", ") .. " FROM item_template WHERE entry IN (" .. table.concat(ids, ",") .. ")")) do
    local it = { n = r[2], q = tonumber(r[3]), inv = tonumber(r[4]), cls = tonumber(r[5]), sub = tonumber(r[6]),
                 rl = tonumber(r[7]), il = tonumber(r[8]), armor = tonumber(r[9]), stats = {}, sockets = {} }
    local dmin, dmax, delay = tonumber(r[10]), tonumber(r[11]), tonumber(r[12])
    if delay > 0 and dmax > 0 then it.dmg = { dmin, dmax }; it.speed = delay / 1000 end
    for i = 13, 15 do local s = tonumber(r[i]); if s ~= 0 then it.sockets[#it.sockets + 1] = s end end
    for i = 0, 9 do
        local t, v = tonumber(r[16 + i * 2]), tonumber(r[17 + i * 2])
        if v ~= 0 then it.stats[#it.stats + 1] = { t, v } end
    end
    items[r[1]] = it
end
for id in pairs(wanted) do
    if not items[tostring(id)] then error("item " .. id .. " named by a gear list is not in " .. WORLD .. ".item_template") end
end
-- }}}

-- {{{ write the page
local data = { generated = os.date("%Y-%m-%d %H:%M"), tiers = TIERS, classes = classes, items = items }
local f = assert(io.open(TEMPLATE, "r"), "cannot read " .. TEMPLATE)
local page = f:read("*a")
f:close()
local blob = json.encode(data):gsub("</", "<\\/")
local stamp = string.format("<!-- generated %s by scripts/generate-buddy-gear-gallery from the buddy-white gear lists and %s; "
    .. "regenerated by scripts/compile; edit the template (scripts/templates/buddy-gear-gallery.html), not this file -->",
    data.generated, WORLD)
local count
page, count = page:gsub("/%*BUDDY_GEAR_DATA%*/", function() return blob end)
if count ~= 1 then error("the template must hold /*BUDDY_GEAR_DATA*/ exactly once (found " .. count .. ")") end
page = page:gsub("<!%-%- GENERATED_STAMP %-%->", function() return stamp end)
local o = assert(io.open(OUT, "w"), "cannot write " .. OUT)
o:write(page)
o:close()
print(string.format("buddy gear gallery: %d classes x %d tiers, %d items -> %s", #classes, #TIERS, #ids, OUT))
-- }}}
