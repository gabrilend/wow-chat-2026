#!/usr/bin/env luajit

local DIR = "/mnt/kaun/wow-chat-2026"
local opt = { workflow = "concept", server = "http://127.0.0.1:8188",
              libs = "/home/ritz/programming/ai-stuff/libs/lua", ["sd-dir"] = "/mnt/kaun/stable-diffusion" }
do
    local i = 1
    local takes = { profile = 1, workflow = 1, seed = 1, server = 1, image = 1, control = 1, ckpt = 1, timeout = 1, libs = 1, ["sd-dir"] = 1, ring = 1 }
    while i <= #arg do
        local a = arg[i]
        local key = a:match("^%-%-(.+)$")
        if key then
            if not takes[key] then error("gear-comfy-submit: unknown option --" .. key) end
            opt[key] = arg[i + 1]
            i = i + 2
        else
            DIR = a
            i = i + 1
        end
    end
end
assert(opt.profile, "gear-comfy-submit: --profile ID is required (an id from assets/gear-designs/profiles/round-*.lua)")
package.path = opt.libs .. "/?.lua;" .. package.path
local json = require("dkjson")
local HERE = DIR .. "/assets/gear-designs"
local P = dofile(DIR .. "/src/tools/gear-designs/profiles.lua")
local WORKFLOW = {
    ["concept"]          = { timeout = 600,  kind = "view" },
    ["concept-scribble"] = { timeout = 600,  kind = "view" },
    ["to-3d"]            = { timeout = 3600, kind = "model", ckpt = "hunyuan3d-dit-v2-mini.safetensors" },
    ["multiview"]        = { timeout = 1200, kind = "mv",    ckpt = "stable_zero123.ckpt" },
    ["to-3d-multiview"]  = { timeout = 3600, kind = "model", ckpt = "hunyuan3d-dit-v2-mv.safetensors" },
}
local WF = WORKFLOW[opt.workflow] or error("gear-comfy-submit: unknown workflow " .. opt.workflow)
opt.ckpt = opt.ckpt or WF.ckpt
local TIMEOUT = tonumber(opt.timeout) or WF.timeout
local SD_OUT  = opt["sd-dir"] .. "/output"
local CAMERAS = dofile(DIR .. "/assets/gear-designs/camera-plan.lua")

local function sh(cmd)
    local p = io.popen(cmd .. " 2>&1; echo \"__exit=$?\"")
    local out = p:read("*a")
    p:close()
    local code = tonumber(out:match("__exit=(%d+)%s*$"))
    out = out:gsub("__exit=%d+%s*$", "")
    if code ~= 0 then error(string.format("gear-comfy-submit: command failed (exit %d):\n  %s\n%s", code, cmd, out)) end
    return out
end
local function q(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end

local profile
do
    local ls = io.popen("ls -1 " .. q(HERE .. "/profiles") .. " 2>/dev/null")
    for name in ls:lines() do
        if name:match("^round%-%d+%.lua$") then
            for _, pr in ipairs(dofile(HERE .. "/profiles/" .. name).profiles) do
                if pr.id == opt.profile then profile = pr end
            end
        end
    end
    ls:close()
    assert(profile, "gear-comfy-submit: no profile " .. opt.profile .. " in " .. HERE .. "/profiles (made by scripts/generate-gear-profiles)")
end

local function upload(path)
    local f = io.open(path, "rb")
    assert(f, "gear-comfy-submit: no image at " .. path)
    f:close()
    local answer = json.decode(sh("curl -sS -f -F " .. q("image=@" .. path) .. " " .. q(opt.server .. "/upload/image")))
    assert(answer and answer.name, "gear-comfy-submit: upload of " .. path .. " gave no name")
    return answer.name
end

local wf_path = HERE .. "/comfyui/" .. opt.workflow .. ".json"
local wf_file = assert(io.open(wf_path), "gear-comfy-submit: no workflow " .. wf_path)
local graph_text = wf_file:read("*a")
wf_file:close()
local seed = tonumber(opt.seed) or tonumber(profile.id, 16)
local ring
if opt.workflow == "multiview" then
    for _, r in ipairs(CAMERAS.rings) do if r.name == (opt.ring or "middle") then ring = r end end
    assert(ring, "gear-comfy-submit: no ring " .. tostring(opt.ring) .. " in assets/gear-designs/camera-plan.lua")
end
local prefix = "gear-designs/" .. profile.id .. "/" .. WF.kind .. (ring and ("_" .. ring.name) or "")
local fill = {
    __PROMPT__    = json.encode(profile.prompt),
    __NEGATIVE__  = json.encode(P.NEGATIVE),
    __SEED__      = tostring(seed),
    __PREFIX__    = json.encode(prefix),
    __CKPT__      = opt.ckpt and json.encode(opt.ckpt) or nil,
    __ELEVATION__ = ring and tostring(ring.elevation) or nil,
}
if graph_text:find("__IMAGE_FRONT__", 1, true) then
    local list = sh("ls -1 " .. q(SD_OUT .. "/gear-designs/" .. profile.id) .. "/" .. CAMERAS.view_prefix .. "_middle_*.png 2>/dev/null || true")
    local views = {}
    for path in list:gmatch("[^\n]+") do views[#views + 1] = path end
    table.sort(views)
    assert(#views >= 8, "gear-comfy-submit: profile " .. profile.id .. " has " .. #views .. " middle-ring views; run --workflow multiview --ring middle first")
    local base = #views - 8
    for key, index in pairs(CAMERAS.mesh_inputs) do
        fill["__IMAGE_" .. key:upper() .. "__"] = json.encode(upload(views[base + index + 1]))
    end
end
if graph_text:find("__IMAGE__", 1, true) then
    local image = opt.image
    if not image then
        local newest = sh("ls -1t " .. q(SD_OUT .. "/gear-designs/" .. profile.id) .. "/view_*.png 2>/dev/null | head -1 || true")
        image = newest:match("^(%S+)")
        assert(image, "gear-comfy-submit: profile " .. profile.id .. " has no concept view in " .. SD_OUT .. "/gear-designs/" .. profile.id .. " (run the concept workflow first, or pass --image)")
    end
    fill.__IMAGE__ = json.encode(upload(image))
end
if graph_text:find("__CONTROL_IMAGE__", 1, true) then
    assert(opt.control, "gear-comfy-submit: workflow " .. opt.workflow .. " needs --control PATH (a silhouette sketch)")
    fill.__CONTROL_IMAGE__ = json.encode(upload(opt.control))
end
graph_text = graph_text:gsub('"(__[%u_]+__)"', function(name)
    return fill[name] or error("gear-comfy-submit: workflow " .. wf_path .. " has " .. name .. ", which nothing fills")
end)
local graph = assert(json.decode(graph_text), "gear-comfy-submit: the filled workflow is not valid JSON")

local body = os.tmpname()
do
    local f = assert(io.open(body, "w"))
    f:write(json.encode({ prompt = graph, client_id = "gear-" .. profile.id }))
    f:close()
end
local queued = json.decode(sh("curl -sS -f -H 'Content-Type: application/json' --data-binary @" .. q(body) .. " " .. q(opt.server .. "/prompt")))
os.remove(body)
assert(queued and queued.prompt_id, "gear-comfy-submit: ComfyUI didn't queue the workflow (no prompt_id in its answer)")
print("queued " .. queued.prompt_id .. " (" .. opt.workflow .. ", profile " .. profile.id .. ", seed " .. seed .. ")")

local record
local waited = 0
while waited <= TIMEOUT do
    local h = json.decode(sh("curl -sS -f " .. q(opt.server .. "/history/" .. queued.prompt_id)))
    record = h and h[queued.prompt_id]
    if record then break end
    sh("sleep 2")
    waited = waited + 2
end
if not record then error(string.format("gear-comfy-submit: no result after %d seconds (prompt %s is still queued or running; nothing was saved)", TIMEOUT, queued.prompt_id)) end
if record.status and record.status.status_str == "error" then
    error("gear-comfy-submit: ComfyUI reported an error for " .. queued.prompt_id .. ": " .. json.encode(record.status.messages or {}))
end

local files = {}
for _, out in pairs(record.outputs or {}) do
    for _, list in pairs(out) do
        if type(list) == "table" then
            for _, it in ipairs(list) do
                if type(it) == "table" and it.filename then files[#files + 1] = it end
            end
        end
    end
end
assert(#files > 0, "gear-comfy-submit: " .. queued.prompt_id .. " finished but saved no files")
local wf_hash = sh("sha256sum " .. q(wf_path)):match("^(%x+)")
local log = assert(io.open(HERE .. "/generated.tsv", "a"))
for _, it in ipairs(files) do
    local dest = SD_OUT .. "/" .. ((it.subfolder or "") ~= "" and (it.subfolder .. "/") or "") .. it.filename
    local present = io.open(dest, "rb")
    if present then
        present:close()
    else
        sh("mkdir -p " .. q(dest:match("^(.*)/")))
        local url = string.format("%s/view?filename=%s&subfolder=%s&type=%s", opt.server, it.filename, it.subfolder or "", it.type or "output")
        sh("curl -sS -f -o " .. q(dest) .. " " .. q(url))
    end
    log:write(table.concat({ profile.id, opt.workflow, tostring(seed), wf_hash, dest, os.date("!%Y-%m-%dT%H:%M:%SZ"), profile.prompt }, "\t"), "\n")
    print("saved " .. dest)
end
log:close()
