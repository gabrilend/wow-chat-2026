#!/usr/bin/env bash
# install-intuition-push-hook - remake the comment-free copy on every push
#
# For a general audience: the project keeps a second copy of itself with
# the comments and explanations taken out (issue 190), on GitHub as
# gabrilend/wow-chat-2026-intuition. This installs a step git runs before
# each push of main to GitHub ("origin"): it updates that copy with only
# the files that changed, commits it and pushes it. If the copy fails, the
# push stops and says why (git push --no-verify pushes without it).
#
# Git keeps hooks outside version control (in .git/hooks/, shared by every
# folder of the repository), so after a fresh clone this script is run
# again. A pre-push hook already there is kept: it is moved aside to
# pre-push.before-intuition and run first, with the same input, exactly as
# before. Running this twice changes nothing.
#
# Usage: scripts/install-intuition-push-hook [PROJECT_DIR] [COPY_DIR]

DIR="/mnt/kaun/wow-chat-2026"
[[ -n "${1:-}" ]] && DIR="$1"
COPY="${2:-${DIR}-intuition}"
MARK="# installed by install-intuition-push-hook"

hooks="$(git -C "${DIR}" rev-parse --git-common-dir)/hooks"
[[ "${hooks}" == /* ]] || hooks="${DIR}/${hooks}"
hook="${hooks}/pre-push"
before="${hooks}/pre-push.before-intuition"

# {{{ the hook already there
#   ours already:      rewritten (settings may have changed), the kept one stays
#   another's:         moved aside, run first by ours
#   none:              ours alone
if [[ -f "${hook}" ]] && ! grep -qF "${MARK}" "${hook}"; then
    if [[ -e "${before}" ]]; then
        echo "ERROR: ${hook} is not ours and ${before} already exists; not overwriting either."
        echo "       to debug: compare the two and keep the one in use as ${before}"
        exit 1
    fi
    mv "${hook}" "${before}"
    echo "kept the hook that was there: ${before} (run first)"
fi
# }}}

cat > "${hook}" <<EOF
#!/usr/bin/env bash
${MARK} (issue 190)
# Before a push: any hook that was here before (pre-push.before-intuition)
# runs first with the same input; then, for a push of main to origin, the
# comment-free copy is updated from the commit being pushed, committed and
# pushed to its own repository. Remade by scripts/install-intuition-push-hook.
input="\$(cat)"
if [[ -x "${before}" ]]; then
    printf '%s\n' "\${input}" | "${before}" "\$@" || exit \$?
fi
[[ "\$1" == "origin" ]] || exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "\${local_ref}" == "refs/heads/main" ]] || continue
    [[ "\${local_sha}" =~ ^0+\$ ]] && continue          # a deletion of main: nothing to copy
    echo "intuition copy: updating ${COPY} from \${local_sha:0:9}"
    if ! "${DIR}/scripts/make-intuition-copy" "${DIR}" "${COPY}" --rev "\${local_sha}" --push; then
        echo "ERROR: the comment-free copy was not updated, so the push is stopped."
        echo "       to debug: run ${DIR}/scripts/make-intuition-copy ${DIR} ${COPY} --rev \${local_sha} --push"
        echo "       to push without it this once: git push --no-verify"
        exit 1
    fi
done <<< "\${input}"
exit 0
EOF
chmod +x "${hook}"
echo "installed: ${hook}"
