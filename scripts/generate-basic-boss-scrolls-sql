#!/usr/bin/env luajit
--------------------------------------------------------------------------------
-- generate-basic-boss-scrolls-sql - every boss of the classic five-player
-- dungeons drops one enchanting scroll of about its own level (issue 812).
--
-- For a general audience: an enchanter can write an enchantment onto
-- vellum and sell the scroll; anyone can use one. On basic, the bosses of
-- the old dungeons (up to the level-60 ones, never raids) also drop one
-- such scroll each kill, on top of their own loot, drawn at random among
-- the scrolls near the boss's level. This program reads which bosses there
-- are (the server's own list of dungeon encounters, kept to the maps the
-- game client calls five-player dungeons, and to bosses of level 63 or
-- less), which scrolls there are and their levels (a scroll's item level
-- is its enchantment's skill divided by five, plus one: Crusader, skill
-- 300, is 61), and writes the install step's SQL: one shared loot list per
-- boss level holding the scrolls near it, each boss's loot pointing at the
-- list for its level, and the revert that removes exactly that. It also
-- prints a table per boss for the owner.
--
-- Usage: scripts/generate-basic-boss-scrolls-sql [PROJECT_DIR] [WORLD_DATABASE]
--   writes patches/E067-basic-boss-enchant-scrolls/38-boss-enchant-scrolls.{apply,revert}.sql
--------------------------------------------------------------------------------

local DIR   = arg[1] and arg[1] ~= "" and arg[1] or "/mnt/kaun/wow-chat-2026"
local WORLD = arg[2] or "acore_world_basic"
local OUT   = DIR .. "/patches/E067-basic-boss-enchant-scrolls/38-boss-enchant-scrolls"
local MYSQL = DIR .. "/mysql/installed-files/bin/mysql"
local DBC   = DIR .. "/data-files/dbc/"

-- {{{ the knobs
local MAX_BOSS_LEVEL   = 63          -- the level-60 dungeons' bosses reach 62; Outland's (basic's 64+) stay out
local MAX_SCROLL_LEVEL = 61          -- professions stop at 300 on basic (155n): skill 300 is item level 61
local WINDOW           = 3           -- scrolls within this many levels of the boss ...
local MIN_CHOICES      = 6           -- ... widened a level at a time until it has at least this many
local REF_BASE         = 1558000     -- shared loot list for boss level L is REF_BASE + L (1558000-1558099, checked free 2026-10-22)
local MAP_DUNGEON      = 1           -- Map.dbc field 2: 1 five-player dungeon, 2 raid
-- }}}

-- {{{ local function die
local function die(msg)
    io.stderr:write("generate-basic-boss-scrolls-sql: " .. msg .. "\n")
    os.exit(1)
end
-- }}}

-- {{{ local function query
-- One query against the world database; tab-separated rows, numbers as
-- numbers. A refusal stops the program with MySQL's words.
local function query(sql)
    local p = io.popen(string.format("MYSQL_PWD=menardi '%s' -h127.0.0.1 -P3307 -uritz -N -B %s -e \"%s\" 2>&1", MYSQL, WORLD, sql))
    local rows = {}
    for line in p:lines() do
        if line:match("^ERROR") then
            die("MySQL refused a query on " .. WORLD .. ": " .. line .. "\n  to debug: is MySQL running (scripts/start-mysql)?")
        end
        local r = {}
        for v in (line .. "\t"):gmatch("([^\t]*)\t") do r[#r + 1] = tonumber(v) or v end
        rows[#rows + 1] = r
    end
    p:close()
    return rows
end
-- }}}

-- {{{ local function dungeon_maps
-- Map.dbc: 0 id, 2 instance type. The five-player dungeons, any expansion
-- (the boss level limit keeps Outland's and Northrend's out).
local function dungeon_maps()
    local f = io.open(DBC .. "Map.dbc", "rb") or die("cannot open " .. DBC .. "Map.dbc (are the client's data files extracted?)")
    local d = f:read("*a")
    f:close()
    local function u32(o) local a, b, c, e = d:byte(o + 1, o + 4) return a + b * 256 + c * 65536 + e * 16777216 end
    if d:sub(1, 4) ~= "WDBC" then die("Map.dbc is not a WDBC file") end
    local n, rs, maps = u32(4), u32(12), {}
    for r = 0, n - 1 do
        local b = 20 + r * rs
        if u32(b + 2 * 4) == MAP_DUNGEON then maps[#maps + 1] = u32(b) end
    end
    return maps
end
-- }}}

-- the scrolls, by level
local scrolls = query("SELECT entry, ItemLevel, name FROM item_template WHERE name LIKE 'Scroll of Enchant%' AND ItemLevel <= " .. MAX_SCROLL_LEVEL .. " ORDER BY ItemLevel, entry")
if #scrolls == 0 then die("no enchanting scrolls of item level " .. MAX_SCROLL_LEVEL .. " or less in " .. WORLD) end

-- the bosses: the server's encounter list, on five-player dungeon maps,
-- level MAX_BOSS_LEVEL or less; one row per boss (its highest level)
local maps = dungeon_maps()
local bosses = query("SELECT t.entry, t.name, t.maxlevel, t.lootid, MIN(c.map) " ..
    "FROM instance_encounters e JOIN creature_template t ON t.entry = e.creditEntry JOIN creature c ON c.id = t.entry " ..
    "WHERE e.creditType = 0 AND t.maxlevel <= " .. MAX_BOSS_LEVEL .. " AND c.map IN (" .. table.concat(maps, ",") .. ") " ..
    "GROUP BY t.entry ORDER BY t.maxlevel, t.entry")
if #bosses == 0 then die("no dungeon bosses found (instance_encounters on maps " .. table.concat(maps, ",") .. ")") end

-- {{{ local function choices
-- The scrolls near a level: within WINDOW, widened until MIN_CHOICES.
local function choices(level)
    local w = WINDOW
    while true do
        local got = {}
        for _, s in ipairs(scrolls) do
            if math.abs(s[2] - level) <= w then got[#got + 1] = s end
        end
        if #got >= MIN_CHOICES or w > 60 then return got, w end
        w = w + 1
    end
end
-- }}}

-- one shared loot list per boss level used; a loot table shared by two
-- bosses takes the higher one's level (it can hold only one scroll row)
local levels, by_loot, skipped = {}, {}, {}
for _, b in ipairs(bosses) do
    local entry, name, level, lootid = b[1], b[2], b[3], b[4]
    if lootid == 0 then
        skipped[#skipped + 1] = string.format("%s (%d): no loot table", name, entry)
    else
        if not by_loot[lootid] or by_loot[lootid].level < level then
            by_loot[lootid] = { level = level, name = name, entry = entry }
        end
        levels[level] = true
    end
end

local apply, revert = {}, {}
local function a(s) apply[#apply + 1] = s end
local stamp = "-- GENERATED by scripts/generate-basic-boss-scrolls-sql from " .. WORLD .. " and the client's Map.dbc;\n" ..
              "-- don't edit by hand (re-run the generator). Issue 812: one enchanting scroll per dungeon boss kill.\n"
a("-- MARKER_E067_APPLY basic-boss-enchant-scrolls\n" .. stamp)
a("-- Undo any earlier copy first, so the step can run twice.")
a(string.format("DELETE FROM creature_loot_template WHERE Reference BETWEEN %d AND %d;", REF_BASE, REF_BASE + 99))
a(string.format("DELETE FROM reference_loot_template WHERE Entry BETWEEN %d AND %d;", REF_BASE, REF_BASE + 99))
a("")
a("-- The shared lists: boss level L's is " .. REF_BASE .. " + L; all in group 1 at")
a("-- equal chances (Chance 0), so exactly one scroll comes out of a list.")

local sorted = {}
for level in pairs(levels) do sorted[#sorted + 1] = level end
table.sort(sorted)
local list_sizes = {}
for _, level in ipairs(sorted) do
    local got, w = choices(level)
    list_sizes[level] = { #got, w }
    local rows = {}
    for _, s in ipairs(got) do
        rows[#rows + 1] = string.format("(%d, %d, 0, 0, 0, 1, 1, 1, 1, '812: %s')", REF_BASE + level, s[1], s[3]:gsub("'", "''"))
    end
    a(string.format("-- boss level %d: %d scrolls of item level %d to %d", level, #got, level - w, level + w))
    a("INSERT INTO reference_loot_template (Entry, Item, Reference, Chance, QuestRequired, LootMode, GroupId, MinCount, MaxCount, Comment) VALUES\n  " ..
      table.concat(rows, ",\n  ") .. ";")
end
a("")
a("-- Each boss's own loot gains one always-dropping row pointing at its level's")
a("-- list: extra, never in place of an item.")
local loot_rows, loot_ids = {}, {}
for lootid in pairs(by_loot) do loot_ids[#loot_ids + 1] = lootid end
table.sort(loot_ids)
for _, lootid in ipairs(loot_ids) do
    local b = by_loot[lootid]
    loot_rows[#loot_rows + 1] = string.format("(%d, %d, %d, 100, 0, 1, 0, 1, 1, '812: an enchanting scroll (%s, level %d)')",
        lootid, REF_BASE + b.level, REF_BASE + b.level, b.name:gsub("'", "''"), b.level)
end
a("INSERT INTO creature_loot_template (Entry, Item, Reference, Chance, QuestRequired, LootMode, GroupId, MinCount, MaxCount, Comment) VALUES\n  " ..
  table.concat(loot_rows, ",\n  ") .. ";")

revert[#revert + 1] = "-- MARKER_E067_REVERT basic-boss-enchant-scrolls\n" .. stamp
revert[#revert + 1] = "-- Remove exactly what the apply added: nothing stock uses these ids."
revert[#revert + 1] = string.format("DELETE FROM creature_loot_template WHERE Reference BETWEEN %d AND %d;", REF_BASE, REF_BASE + 99)
revert[#revert + 1] = string.format("DELETE FROM reference_loot_template WHERE Entry BETWEEN %d AND %d;", REF_BASE, REF_BASE + 99)

-- {{{ write
local function write(path, lines)
    local f = io.open(path, "w") or die("cannot write " .. path)
    f:write(table.concat(lines, "\n") .. "\n")
    f:close()
end
write(OUT .. ".apply.sql", apply)
write(OUT .. ".revert.sql", revert)
-- }}}

-- the owner's table: per boss, its level and how many scrolls it can drop
print(string.format("%-34s %5s %7s %8s", "Boss", "Level", "Scrolls", "Window"))
for _, b in ipairs(bosses) do
    if b[4] ~= 0 then
        local lv = by_loot[b[4]].level
        print(string.format("%-34s %5d %7d %6s%-2d", b[2]:sub(1, 34), b[3], list_sizes[lv][1], "+/-", list_sizes[lv][2]))
    end
end
for _, s in ipairs(skipped) do print("skipped: " .. s) end
print(string.format("%d bosses, %d loot tables, %d shared lists, %d scrolls in all; wrote %s.{apply,revert}.sql",
    #bosses, #loot_ids, #sorted, #scrolls, OUT))
