#!/usr/bin/env luajit
-- test-druid-moonglade - plays the druids' Moonglade return (issue 211a) in
-- the pretend world, with beta's real script.
--
-- For a general audience: on beta a druid's way home is the spell Teleport:
-- Moonglade. Every druid knows it from the start; cast out in the world it
-- takes them to the glade, to a random spot on its open ground, and
-- remembers where they were; cast in the glade it sends them back there.
-- Their group may come along as visitors, who go back when the druid
-- leaves. This loads src/lua-beta/druid-moonglade.lua and hearthstone.lua
-- (whose invitation it uses) unchanged into the pretend world of
-- scripts/lib/toy-world.lua and plays each promise as a scene: a new druid
-- learning the spell, out and back, back with nothing to go to, a cast
-- from a dungeon going back to its entrance, the spot kept through a logout
-- and a restart, the arrival spots spread over the glade and never in the
-- lake, on a mountainside or on a cliff, visitors invited, placed, sent
-- back (when the druid goes back, logs out, or while they were offline),
-- a visitor leaving on their own, a cancelled cast, and other spells and
-- classes left alone. No server or database is needed.
--
-- Usage: scripts/test-druid-moonglade [PROJECT_DIR]
-- Exit status: 0 if every check passes, 1 otherwise.

local DIR = "/mnt/kaun/wow-chat-2026"
if arg[1] and arg[1] ~= "" then DIR = arg[1] end

local here = (arg[0]:match("^(.*[/\\])") or "./")
local Toy = dofile(here .. "lib/toy-world.lua")
local quiet = print
print = function() end                   -- the scripts' log lines
dofile(DIR .. "/src/lua-beta/druid-moonglade.lua")   -- in the engine's order: by name
dofile(DIR .. "/src/lua-beta/hearthstone.lua")
-- the scripts' log lines go on being kept, not printed: a scene that leaves
-- a druid in a dungeon makes the arrival give up and say so, as it should
local logged = {}
print = function(...) logged[#logged + 1] = table.concat({ ... }, " ") end

local checks, fails = 0, 0
-- {{{ local function check
local function check(ok, what)
    checks = checks + 1
    if not ok then fails = fails + 1; quiet("  FAIL " .. what) end
end
-- }}}

local CAST = Moonglade.onCast              -- the cast completing (one of two handlers for it)
local function BEGIN(p)  Toy.spellEvent(1, p, 18960) end         -- the cast begins
local function CANCEL(p) Toy.spellEvent(3, p, 18960, true) end   -- the cast is cancelled
local G = Moonglade.GLADE

-- {{{ the glade: a pretend Kalimdor
-- Ground: the valley floor at 512 inside a ring round the glade's middle;
-- a lake (area 656) in the middle; mountains (ground at 700) beyond the
-- ring; a cliff at x 7600-7620, rising 2 yards for every yard (steeper
-- than the script's 45-degree rule), then back down. Flat ground right
-- beside it is fine to stand on.
local MID_X, MID_Y = 7850, -2400
local function height(x, y)
    local d = math.sqrt((x - MID_X) ^ 2 + (y - MID_Y) ^ 2)
    if d > 500 then return 700 end
    if x > 7600 and x < 7620 then return 512 + 2 * math.min(x - 7600, 7620 - x) end
    return 512
end
local function area(x, y)
    local d = math.sqrt((x - MID_X) ^ 2 + (y - MID_Y) ^ 2)
    if d < 120 then return 656 end                      -- Lake Elune'ara
    if x > 7950 and y < -2600 then return 2361 end      -- Nighthaven
    return 493
end
local KALIMDOR = Toy.new_map(1, height, nil, area)
local EK = Toy.new_map(0, function() return 40 end)
local DUNGEON = Toy.new_map(36, function() return 0 end) -- the Deadmines: not the open world
Toy.maps[1], Toy.maps[0], Toy.maps[36] = KALIMDOR, EK, DUNGEON
-- }}}

-- {{{ local function druid
-- A druid standing somewhere: map, x, y, zone.
local function druid(name, low, map, x, y, zone)
    local p = Toy.new_player(name, low)
    p.class, p.map, p.x, p.y, p.z, p.zone = 11, map, x, y, map.height(x, y), zone
    return p
end
-- }}}
-- {{{ local function land_in_nighthaven
-- What the spell itself does between the cast and our move: the druid is in
-- Nighthaven (map 1, zone 493).
local function land_in_nighthaven(p)
    p.map, p.x, p.y, p.z, p.zone = KALIMDOR, 7991.88, -2679.84, 512.1, 493
end
-- }}}
-- {{{ local function arrive_as_moved
-- The pretend world records a teleport without moving anyone; this carries
-- out a player's last teleport, and tells the scripts of the zone change
-- as the game would (zone 493 inside the glade, `zone` elsewhere).
local function arrive_as_moved(p, zone)
    local t = p.teleports[#p.teleports]
    p.map, p.x, p.y, p.z = Toy.maps[t.map], t.x, t.y, t.z
    p.zone = (t.map == 1 and t.x > 7000 and t.x < 8700 and t.y > -3300 and t.y < -1500) and 493 or zone
    Moonglade.onZone(27, p, p.zone, 0)
end
-- }}}

-- {{{ 1. learning the spell
local ann = druid("Ann", 501, EK, -8900, 500, 12)
Toy.login(ann)
check(ann:HasSpell(18960), "a druid without Teleport: Moonglade learns it at login")
local warrior = Toy.new_player("Wat", 502)
warrior.class = 1
Toy.login(warrior)
check(not warrior:HasSpell(18960), "a warrior is not taught Teleport: Moonglade")
local taught = 0
local bea = druid("Bea", 503, EK, 0, 0, 12)
bea.spells[18960] = true
function bea:LearnSpell(id) taught = taught + 1; self.spells[id] = true end
Toy.login(bea)
check(taught == 0, "a druid who knows it is not taught it again")
-- }}}

-- {{{ 2. out and back
CAST(5, ann, Toy.spell(18960))
check(Toy.chardb.moonglade[501] ~= nil, "casting from the world remembers the spot in the database")
local row = Toy.chardb.moonglade[501] or {}
check(row[1] == 0 and math.abs(row[2] - -8900) < 0.01 and math.abs(row[3] - 500) < 0.01, "the remembered spot is where the druid stood (map 0, -8900, 500)")
land_in_nighthaven(ann)
Toy.advance(Moonglade and 1500 or 0)
check(#ann.teleports == 1 and ann.teleports[1].map == 1, "a moment after landing, the druid is moved within Kalimdor")
local t = ann.teleports[1] or {}
check(t.x and t.x >= G.x_min and t.x <= G.x_max and t.y >= G.y_min and t.y <= G.y_max, "the arrival lies in the glade's box")
-- now in the glade, cast again: back to the remembered spot
ann.x, ann.y, ann.z = t.x or ann.x, t.y or ann.y, t.z or ann.z
CAST(5, ann, Toy.spell(18960))
land_in_nighthaven(ann)
Toy.advance(1500)
local back = ann.teleports[2] or {}
check(back.map == 0 and math.abs((back.x or 0) - -8900) < 0.01 and math.abs((back.y or 0) - 500) < 0.01, "casting in the glade sends the druid back to where they cast it from")
check(Toy.chardb.moonglade[501] == nil, "going back forgets the spot in the database")
check(#ann.teleports == 2, "going back is one move, not also a random arrival")
-- }}}

-- {{{ 3. back with nothing remembered
local cid = druid("Cid", 504, KALIMDOR, 7900, -2700, 493)
Toy.login(cid)
CAST(5, cid, Toy.spell(18960))
Toy.advance(1500)
check(#cid.teleports == 0, "in the glade with nothing remembered, the druid is not moved (the spell's own Nighthaven)")
check(#cid.messages == 1 and cid.messages[1]:match("nowhere to return"), "and is told there is nowhere to return to")
-- }}}

-- {{{ 4. a cast from a dungeon goes back to where they entered it
local dot = druid("Dot", 505, DUNGEON, -16, -383, 1581)  -- deep inside the Deadmines
Toy.login(dot)
CAST(5, dot, Toy.spell(18960))
local d = Toy.chardb.moonglade[505] or {}
check(d[1] == 0 and math.abs((d[2] or 0) - -11208.3) < 0.01 and math.abs((d[3] or 0) - 1672.52) < 0.01,
      "a cast from the Deadmines remembers its entrance, from the generated table (map 0, -11208.3, 1672.52)")
check(Moonglade.ENTRANCES[36] and Moonglade.ENTRANCES[489] == nil, "the table has the Deadmines and no battleground (Warsong Gulch)")
-- a battleground: no entrance of its own, so no way back yet
local WARSONG = Toy.new_map(489, function() return 0 end)
Toy.maps[489] = WARSONG
local gus = druid("Gus", 508, WARSONG, 0, 0, 3277)
Toy.login(gus)
CAST(5, gus, Toy.spell(18960))
check(Toy.chardb.moonglade[508] == nil and Moonglade.spots[508] == false, "from a battleground, nothing is remembered yet")
check(gus.messages[#gus.messages] and gus.messages[#gus.messages]:match("not known"), "and the druid is told so")
Toy.advance(1500)                                          -- (Gus's booked arrival: he never reached the glade)
Toy.advance(3000)
-- }}}

-- {{{ 5. kept through a logout and a restart
local eli = druid("Eli", 506, EK, 300, 300, 12)
Toy.login(eli)
CAST(5, eli, Toy.spell(18960))
Toy.logout(eli)
Moonglade.spots = {}                                       -- a server restart: the script's memory is empty
Toy.login(eli)
check(type(Moonglade.spots[506]) == "table" and math.abs(Moonglade.spots[506].x - 300) < 0.01, "after a logout and a restart the spot is read back from the database")
eli.map, eli.x, eli.y, eli.zone = KALIMDOR, 7900, -2700, 493
CAST(5, eli, Toy.spell(18960))
Toy.advance(1500)
local e = eli.teleports[#eli.teleports] or {}
check(e.map == 0 and math.abs((e.x or 0) - 300) < 0.01, "and the return still goes there")
-- }}}

-- {{{ 6. the arrivals: spread over the glade, never in the lake, on the mountains or the cliff
local seen, bad, cells = 0, 0, {}
math.randomseed(211)
for i = 1, 400 do
    local x, y, z = Moonglade.drawArrival(KALIMDOR)
    if x then
        seen = seen + 1
        local a = area(x, y, z)
        if a == 656 or height(x, y) ~= 512 or (x > 7600 and x < 7620) then bad = bad + 1 end
        cells[math.floor(x / 150) .. ":" .. math.floor(y / 150)] = true
    end
end
local spread = 0
for _ in pairs(cells) do spread = spread + 1 end
check(seen == 400, "every arrival draw finds a spot in this glade (" .. seen .. " of 400)")
check(bad == 0, "no arrival in the lake, on a mountain, or on or beside the cliff (" .. bad .. " bad)")
check(spread >= 12, "arrivals are spread over the glade, not one spot (" .. spread .. " of the 150-yard squares)")
-- a glade with no open ground: nothing drawn, so the druid stays in Nighthaven
local all_lake = Toy.new_map(1, function() return 512 end, nil, function() return 656 end)
check(Moonglade.drawArrival(all_lake) == nil, "with no open ground at all, no arrival is drawn")
-- }}}

-- {{{ 8. visitors
-- Hal, a druid, with Ivy (a player), Jon (a player who stays) and Kit (a
-- bot), in Elwynn (map 0, zone 12).
local function visit_party(base)
    World = Toy.World
    local hal = druid("Hal", base, EK, 500, 500, 12)
    local ivy, jon, kit = Toy.new_player("Ivy", base + 1), Toy.new_player("Jon", base + 2), Toy.new_player("Kit", base + 3)
    for i, p in ipairs({ ivy, jon, kit }) do p.map, p.x, p.y, p.z, p.zone = EK, 500 + 10 * i, 500, 40, 12 end
    kit.bot = true
    for _, p in ipairs({ hal, ivy, jon, kit }) do Toy.login(p) end
    Toy.group({ hal, ivy, jon, kit })
    return hal, ivy, jon, kit
end
local function go_out(hal)
    CAST(5, hal, Toy.spell(18960))
    Toy.spellEvent(2, hal, 18960)                         -- (the engine's own completion event: nothing listens)
    land_in_nighthaven(hal)
    Toy.advance(1500)
end
local function near(t, x, y, r) return t and math.sqrt((t.x - x) ^ 2 + (t.y - y) ^ 2) <= r end

-- invited, placed round the druid, sent back when the druid goes back
do
    local hal, ivy, jon, kit = visit_party(600)
    BEGIN(hal)
    check(ivy.window ~= nil and jon.window ~= nil and kit.window == nil, "the cast beginning asks the players in the group (not the bot)")
    check(ivy.window and ivy.window.items[1].text:match("Moonglade"), "with the glade's own words")
    Toy.answer(ivy, 1)
    Toy.answer(jon, 2)
    go_out(hal)
    local spot = hal.teleports[1]
    check(spot ~= nil, "the druid is moved to a spot in the glade")
    check(#ivy.teleports == 1 and #kit.teleports == 1 and #jon.teleports == 0, "Ivy (yes) and the bot come; Jon (no) stays")
    check(spot and near(ivy.teleports[1], spot.x, spot.y, 6) and near(kit.teleports[1], spot.x, spot.y, 6), "the visitors stand round the druid's spot")
    check(spot and ivy.teleports[1].map == 1, "in Kalimdor")
    arrive_as_moved(hal, 12); arrive_as_moved(ivy, 12); arrive_as_moved(kit, 12)
    check(Moonglade.visiting[ivy:GetGUIDLow()] ~= nil, "Ivy is a visitor while in the glade")
    -- Hal goes back: Ivy and the bot are sent to where they came from
    CAST(5, hal, Toy.spell(18960))
    land_in_nighthaven(hal)
    Toy.advance(1500)
    arrive_as_moved(hal, 12)
    local ib = ivy.teleports[2]
    check(ib and ib.map == 0 and math.abs(ib.x - 510) < 0.01 and math.abs(ib.y - 500) < 0.01, "when the druid leaves, Ivy goes back to where she came from (map 0, 510, 500)")
    check(kit.teleports[2] and math.abs(kit.teleports[2].x - 530) < 0.01, "and so does the bot, to its own spot")
    check(Moonglade.visiting[ivy:GetGUIDLow()] == nil, "and she is a visitor no more")
    for _, p in ipairs({ hal, ivy, jon, kit }) do Toy.logout(p) end
end

-- the druid logs out; a visitor offline; a visitor who leaves on her own
do
    local hal, ivy, jon, kit = visit_party(610)
    BEGIN(hal); Toy.answer(ivy, 1); Toy.answer(jon, 1)
    go_out(hal)
    arrive_as_moved(hal, 12); arrive_as_moved(ivy, 12); arrive_as_moved(jon, 12); arrive_as_moved(kit, 12)
    Toy.logout(jon)                                        -- Jon logs out in the glade
    ivy.teleports = {}
    ivy.map, ivy.x, ivy.y, ivy.zone = KALIMDOR, 6800, -4500, 361 -- Ivy walks out to Felwood on her own
    Moonglade.onZone(27, ivy, 361, 0)
    check(Moonglade.visiting[ivy:GetGUIDLow()] == nil, "a visitor who leaves the glade on her own is a visitor no more")
    Toy.logout(hal)                                        -- the druid logs out: no longer in the glade
    check(#kit.teleports == 2, "the druid logging out sends the visitors back")
    check(#ivy.teleports == 0, "but not one who had already left")
    Toy.login(jon)
    check(jon.teleports[2] and jon.teleports[2].map == 0 and math.abs(jon.teleports[2].x - 520) < 0.01, "a visitor offline when the druid left goes back at their next login")
    for _, p in ipairs({ ivy, jon, kit }) do Toy.logout(p) end
end

-- a cancelled cast moves no visitor; the way back from the glade invites nobody
do
    local hal, ivy, jon, kit = visit_party(620)
    BEGIN(hal); Toy.answer(ivy, 1)
    CANCEL(hal)
    check(jon.window == nil and next(GroupHearth.pending) == nil, "a cancelled cast withdraws the invitation")
    Toy.advance(3000)
    check(#ivy.teleports == 0 and #kit.teleports == 0, "and moves nobody")
    hal.map, hal.x, hal.y, hal.zone = KALIMDOR, 7900, -2700, 493
    BEGIN(hal)
    check(ivy.window == nil and next(GroupHearth.pending) == nil, "casting the way back from the glade invites nobody")
    for _, p in ipairs({ hal, ivy, jon, kit }) do Toy.logout(p) end
end

-- a visitor in a dungeon comes back to its entrance; one in a battleground stays
do
    local hal, ivy, jon, kit = visit_party(630)
    ivy.map, ivy.x, ivy.y, ivy.zone = DUNGEON, -16, -383, 1581   -- in the Deadmines
    jon.map, jon.zone = Toy.maps[489], 3277                      -- in Warsong Gulch
    BEGIN(hal); Toy.answer(ivy, 1); Toy.answer(jon, 1)
    go_out(hal)
    check(#ivy.teleports == 1 and #jon.teleports == 0, "a visitor whose entrance is known comes; one whose is not stays")
    check(jon.messages[#jon.messages] and jon.messages[#jon.messages]:match("not known"), "and is told why")
    arrive_as_moved(hal, 12); arrive_as_moved(ivy, 12)
    Toy.logout(hal)
    local ib = ivy.teleports[2]
    check(ib and ib.map == 0 and math.abs(ib.x - -11208.3) < 0.01, "Ivy goes back to the dungeon's entrance, where she went in")
    for _, p in ipairs({ ivy, jon, kit }) do Toy.logout(p) end
end
-- }}}

-- {{{ 9. the dead visit too, raised by the glade; a restart keeps the visitors
do
    local hal, ivy, jon, kit = visit_party(640)
    ivy.dead, kit.dead = true, true
    BEGIN(hal)
    check(ivy.window ~= nil, "a dead group member is asked too")
    Toy.answer(ivy, 1)
    go_out(hal)
    check(#ivy.teleports == 1 and #kit.teleports == 1, "the dead who said yes (and the dead bot) come")
    check(not ivy.dead and ivy.raised == 1 and not kit.dead, "and are raised on arriving in the glade")
    for _, p in ipairs({ hal, ivy, jon, kit }) do Toy.logout(p) end
end

local function restart()
    Moonglade.spots, Moonglade.visiting, Moonglade.hosting, Moonglade.trips = {}, {}, {}, {}
end

-- the visitor logs in first, the druid not yet back: she goes back
do
    local hal, ivy, jon, kit = visit_party(650)
    BEGIN(hal); Toy.answer(ivy, 1)
    go_out(hal)
    arrive_as_moved(hal, 12); arrive_as_moved(ivy, 12)
    check(Toy.chardb.visitors[651] and Toy.chardb.visitors[651][1] == 650, "the visitor is kept in the database, with her druid")
    -- the server goes down: nobody logs out cleanly, the script's memory is gone
    for _, p in ipairs({ hal, ivy, jon, kit }) do p.gone = true end
    restart()
    ivy.teleports = {}
    Toy.login(ivy)
    check(#ivy.teleports == 1 and ivy.teleports[1].map == 0 and math.abs(ivy.teleports[1].x - 510) < 0.01,
          "after a restart, a visitor whose druid is not back goes back at login")
    check(Toy.chardb.visitors[651] == nil, "and is no longer kept")
    Toy.logout(ivy)
end

-- the druid logs in first, outside the glade: the visitor, offline, goes back at her login
do
    local hal, ivy, jon, kit = visit_party(660)
    BEGIN(hal); Toy.answer(ivy, 1)
    go_out(hal)
    arrive_as_moved(hal, 12); arrive_as_moved(ivy, 12)
    for _, p in ipairs({ hal, ivy, jon, kit }) do p.gone = true end
    restart()
    hal.map, hal.x, hal.y, hal.zone = EK, 500, 500, 12   -- the druid comes back in Elwynn
    Toy.login(hal)
    check(Toy.chardb.visitors[661] and Toy.chardb.visitors[661][7] == 1, "a druid logging in outside the glade marks their offline visitors as left")
    ivy.teleports = {}
    Toy.login(ivy)
    check(#ivy.teleports == 1 and ivy.teleports[1].map == 0, "and the visitor goes back at her login")
    for _, p in ipairs({ hal, ivy }) do Toy.logout(p) end
end

-- the druid logs in first, still in the glade: the visitor stays a visitor
do
    local hal, ivy, jon, kit = visit_party(670)
    BEGIN(hal); Toy.answer(ivy, 1)
    go_out(hal)
    arrive_as_moved(hal, 12); arrive_as_moved(ivy, 12)
    for _, p in ipairs({ hal, ivy, jon, kit }) do p.gone = true end
    restart()
    Toy.login(hal)
    ivy.teleports = {}
    Toy.login(ivy)
    check(#ivy.teleports == 0 and Moonglade.visiting[671] ~= nil, "a visitor whose druid is back in the glade stays")
    Toy.logout(hal)
    check(#ivy.teleports == 1, "and goes back when the druid leaves")
    Toy.logout(ivy)
end
-- }}}

-- {{{ 7. other spells and classes
local fay = druid("Fay", 507, EK, 0, 0, 12)
Toy.login(fay)
CAST(5, fay, Toy.spell(8690))                              -- a Hearthstone
Toy.advance(1500)
check(Toy.chardb.moonglade[507] == nil and #fay.teleports == 0, "another spell is left alone")
-- }}}

-- the arrival that could not happen said so in the log
local gave_up = 0
for _, l in ipairs(logged) do if l:match("not in Moonglade") then gave_up = gave_up + 1 end end
check(gave_up == 2, "an arrival that never reaches the glade says so in the server log (" .. gave_up .. " of 2)")

quiet(string.format("%d checks, %d failed", checks, fails))
os.exit(fails == 0 and 0 or 1)
