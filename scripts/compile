#!/bin/bash
# scripts/compile - Compile the server from source
# Skips git checks, goes straight to cmake/make
# Builds into shadow directory for atomic promotion

set -e
set -o pipefail

# Where the script stopped, if a failing command ended it through set -e
# rather than through one of its own error messages. Recorded here and
# reported at exit (report_how_compile_ended). -E carries the recorder
# into functions, including those sourced from patches/patches.sh, so the
# file and line point at the command that actually failed. Commands whose
# failure is expected (in an if, or before || / &&) never trigger it.
# Added 2026-10-12: a module missing from the cmake cache ended a build
# right after "Cache: ..." with no message at all, and the output looked
# like a finished build.
set -E
trap 'STOPPED_AT="${BASH_SOURCE[0]}:${LINENO}"; STOPPED_COMMAND="${BASH_COMMAND}"' ERR

# {{{ set_dir
# The project directory: --dir when given, otherwise the parent of the
# directory this script lives in.
#
# Scanned out of the arguments here rather than in parse_args further
# down, because the profile is read from ${DIR}/.profile a few lines
# below and parse_args does not run until long after that. Reading the
# profile from one project and then working on another is the failure
# this ordering avoids.
#
# No hard-coded path. This departs from the house convention on purpose,
# so the project can be worked on from a machine that has never seen it.
# The derivation is safe here in a way it is not for the three
# dependency scripts: this one is useless without a full checkout around
# it, so if it is running at all, it is sitting in that checkout's
# scripts directory. See issue 154.
SELF_DIR="${BASH_SOURCE[0]%/*}"
[[ "${SELF_DIR}" == "${BASH_SOURCE[0]}" ]] && SELF_DIR="."

EXPLICIT_DIR=""
DIR_SCAN_ARGS=("$@")
for (( dir_scan_index = 0; dir_scan_index < ${#DIR_SCAN_ARGS[@]}; dir_scan_index++ )); do
    case "${DIR_SCAN_ARGS[dir_scan_index]}" in
        --dir)   EXPLICIT_DIR="${DIR_SCAN_ARGS[dir_scan_index + 1]:-}" ;;
        --dir=*) EXPLICIT_DIR="${DIR_SCAN_ARGS[dir_scan_index]#*=}"    ;;
    esac
done

if [[ -n "${EXPLICIT_DIR}" ]]; then
    DIR_CANDIDATE="${EXPLICIT_DIR}"
    DIR_SOURCE="the --dir argument"
else
    DIR_CANDIDATE="${SELF_DIR}/.."
    DIR_SOURCE="where this script lives, ${BASH_SOURCE[0]}"
fi

if [[ ! -d "${DIR_CANDIDATE}" ]]; then
    echo "Project directory does not exist: ${DIR_CANDIDATE}"
    echo "  This came from ${DIR_SOURCE}."
    echo "  Nothing has been changed."
    exit 1
fi

# Resolved rather than kept as written, so every path built from it is
# valid regardless of the working directory this was invoked from, and
# so a project reachable through a symlink compares equal to itself.
DIR="$( builtin cd -P -- "${DIR_CANDIDATE}" && pwd )"
# }}}

# =============================================================================
# Load Profile
# =============================================================================

if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi
# DEFAULT_PROFILE snapshots the no-argument default so --help reports the
# true default even when a --profile flag precedes --help on the command
# line (that flag mutates PROFILE, not the default a bare run would use).
DEFAULT_PROFILE="${PROFILE}"

# =============================================================================
# Configuration
# =============================================================================

THREADS="${THREADS:-4}"
AUTO_VALIDATE=true
RUN_TESTS=true

# No Boost version is named here. cmake is pointed at the directory
# scripts/boost installed into and reads the version out of the headers
# it finds there, so a version stated in this file would only be a
# second copy of the truth, free to disagree with it. Two such
# constants used to sit here saying 1.74.0 while the installed library
# was 1.81.0; nothing read them. See issue 154.

# =============================================================================
# Profile Definitions
# =============================================================================

# {{{ Modules per profile
declare -A PROFILE_MODULES=(
    ["alpha"]="mod-eluna mod-transmog"
    ["beta"]="mod-ale mod-aoe-loot mod-grownup mod-playerbots"
    ["release"]="mod-ale mod-playerbots"
    ["vanilla"]="mod-playerbots mod-solo-lfg mod-aoe-loot mod-fireworks-on-level mod-ale"
    ["basic"]="mod-playerbots mod-solo-lfg mod-aoe-loot mod-fireworks-on-level mod-ale"
    ["cc-test"]="mod-playerbots mod-ale"
)
# }}}

# =============================================================================
# Argument Parsing
# =============================================================================

FORCE_REBUILD=false
# --debug builds at -O0 -g (CMAKE_BUILD_TYPE=Debug) so crash backtraces resolve
# to exact file:line, and stamps the install so the server auto-runs its crash
# catcher (no runtime --debug needed). Default builds RelWithDebInfo.
DEBUG_BUILD=false

# {{{ parse_args
# Each option supports both --opt value and --opt=value forms. The
# catch-all errors instead of silently dropping unknown args.
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    PROFILE="${2}"
                    shift 2
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                if [[ -z "${PROFILE}" ]]; then
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                shift
                ;;
            --dir)
                # Already resolved by the scan at the top of the file;
                # consumed here only so the catch-all does not reject it.
                if [[ -n "${2:-}" ]]; then
                    shift 2
                else
                    echo "Error: --dir requires a path"
                    exit 1
                fi
                ;;
            --dir=*)
                shift
                ;;
            --threads)
                if [[ -n "${2:-}" && "${2}" =~ ^[0-9]+$ ]]; then
                    THREADS="${2}"
                    shift 2
                else
                    echo "Error: --threads requires a numeric argument"
                    exit 1
                fi
                ;;
            --threads=*)
                THREADS="${1#*=}"
                if [[ ! "${THREADS}" =~ ^[0-9]+$ ]]; then
                    echo "Error: --threads requires a numeric argument"
                    exit 1
                fi
                shift
                ;;
            --force)
                FORCE_REBUILD=true
                shift
                ;;
            --debug)
                # Debug build: -O0 -g everywhere for precise crash traces, and
                # the server auto-enables its crash catcher. Implies --force
                # because switching CMAKE_BUILD_TYPE needs a reconfigure.
                DEBUG_BUILD=true
                FORCE_REBUILD=true
                shift
                ;;
            --no-validate)
                AUTO_VALIDATE=false
                shift
                ;;
            --skip-tests)
                RUN_TESTS=false
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                echo "Error: unrecognized argument '${1}'"
                echo "Run with --help to see available options."
                exit 1
                ;;
        esac
    done
}
# }}}

# {{{ show_help
show_help() {
    echo "Usage: ./scripts/compile [options]"
    echo ""
    echo "Compile the server from source (skips git checks)."
    echo "Builds into shadow directory, then auto-validates and promotes."
    echo ""
    echo "Options:"
    echo "  --dir <path>       Project directory"
    echo "                     (default: the parent of this script's directory)"
    echo "  --profile <name>   Use specific profile (default: ${DEFAULT_PROFILE})"
    echo "  --threads <n>      Number of threads (default: ${THREADS})"
    echo "  --force            Force cmake reconfiguration"
    echo "  --debug            Build -O0 -g (Debug); the server then auto-runs the"
    echo "                     crash catcher, giving exact file:line in tmp/ traces"
    echo "  --no-validate      Skip auto-validation and promotion"
    echo "  --skip-tests       Skip the quick tests run before building"
    echo "                     (they need the project's MySQL running)"
    echo "  --help             Show this help message"
    echo ""
    echo "Pipeline (automatic):"
    echo "  compile -> validate -> promote"
    echo ""
    echo "Manual workflow (with --no-validate):"
    echo "  1. ./scripts/compile --no-validate  - Build to shadow only"
    echo "  2. ./scripts/validate               - Test and promote"
}
# }}}

# =============================================================================
# Functions
# =============================================================================

# {{{ get_profile_paths
get_profile_paths() {
    # vanilla shares source-beta with release/beta — see issue 148.
    case "${PROFILE}" in
        release) AC_CODE_DIR="${DIR}/source-beta"  ;;
        beta)    AC_CODE_DIR="${DIR}/source-beta"  ;;
        vanilla) AC_CODE_DIR="${DIR}/source-beta"  ;;
        basic)   AC_CODE_DIR="${DIR}/source-beta"  ;;
        cc-test) AC_CODE_DIR="${DIR}/source-beta"  ;;
        alpha)   AC_CODE_DIR="${DIR}/source-alpha" ;;
        *)       echo "ERROR: Unknown profile '${PROFILE}'"; exit 1 ;;
    esac
    INSTALL_DIR="${DIR}/installed-files-${PROFILE}"
    BUILD_DIR="${DIR}/build-${PROFILE}"
    MYSQL_DIR="${DIR}/mysql/installed-files"
    BOOST_DIR="${DIR}/libs/boost"
    CCACHE_BIN="${DIR}/libs/ccache/bin/ccache"
    CCACHE_CACHE_DIR="${DIR}/build-cache"
    BUILD_DIR_SHADOW="${DIR}/build-shadow"
    INSTALL_DIR_SHADOW="${DIR}/installed-files-shadow"
}
# }}}

# {{{ setup_log_symlinks
setup_log_symlinks() {
    local TMP_BASE="/tmp/wow-chat-2"
    local TMP_LOGS="${TMP_BASE}/logs-${PROFILE}"
    mkdir -p "${TMP_BASE}"
    mkdir -p "${TMP_LOGS}"
    [[ -L "${DIR}/tmp" ]] || ln -s "${TMP_BASE}" "${DIR}/tmp"
    [[ -L "${DIR}/logs-${PROFILE}" ]] || ln -s "${TMP_LOGS}" "${DIR}/logs-${PROFILE}"
}
# }}}

# {{{ PATCH_PROVIDED_MODULES
# Modules that are not cloned from upstream but copied into the source
# tree by one of the project's source patches. A profile wants such a
# module exactly when that patch is in its source-patch list.
declare -A PATCH_PROVIDED_MODULES=(
    ["mod-buddies"]="B036"   # the project's buddy module (modules/mod-buddies/, issue 617a1)
)
# }}}

# {{{ module_wanted
# Does the current profile build this module? Yes when it is in the
# profile's module list (PROFILE_MODULES), or when a source patch in the
# profile's list provides it (PATCH_PROVIDED_MODULES). Every other module
# folder in the shared source tree is a neighbour's: basic's mod-aoe-loot,
# a mod-buddies a basic build copied in. The source tree is shared by five
# profiles and only install prunes it, so without this a cc-test build
# (issue 176: stock + playerbots + ALE) would link basic's whole module set.
# Needs patches.sh loaded (PHASE_BEGIN_PATCHES).
module_wanted() {
    local mod_name="${1}"
    # yes: named in the profile's module list
    [[ " ${PROFILE_MODULES[${PROFILE}]} " == *" ${mod_name} "* ]] && return 0
    # yes: brought in by a source patch this profile applies
    local providing_patch="${PATCH_PROVIDED_MODULES[${mod_name}]:-}"
    [[ -n "${providing_patch}" && " ${PHASE_BEGIN_PATCHES[${PROFILE}]} " == *" ${providing_patch} "* ]] && return 0
    # no: some other profile's module
    return 1
}
# }}}

# {{{ module_cmake_settings
# One cmake setting per module folder in the source tree: MODULE_<NAME>
# (upper case, hyphens kept; AzerothCore's ModuleNameToVariable) is
# "default" for a wanted module (linked as -DMODULES says, static) and
# "disabled" for every other. Echoes "NAME=VALUE" lines, sorted.
# Project modules copied in by a patch (mod-buddies) are listed from the
# project's own modules/ folder too, because the copy happens after the
# module check.
module_cmake_settings() {
    local -A seen=()
    local mod_dir mod_name
    # one group, sorted as a whole: the folders in the trees, then the
    # cached modules no tree holds any more
    {
    for mod_dir in "${AC_CODE_DIR}"/modules/*/ "${DIR}"/modules/*/; do
        [[ -d "${mod_dir}src" ]] || continue
        mod_name=$(basename "${mod_dir}")
        [[ -n "${seen[${mod_name}]:-}" ]] && continue
        seen[${mod_name}]=1
        local variable="MODULE_${mod_name^^}"
        if module_wanted "${mod_name}"; then
            echo "${variable}=default"
        else
            echo "${variable}=disabled"
        fi
    done
    # Modules the last configure knew that have since left the tree (install
    # deletes another profile's modules): switched off, so the cached build
    # stops compiling files that are gone. Without this, a module removed
    # from the tree changed no setting, cmake didn't re-run, and the build
    # failed on its missing sources (cc-test's first install, 2026-10-08:
    # "no such file or directory: .../mod-aoe-loot/src/aoe_loot.cpp").
    local cache="${BUILD_DIR_SHADOW}/CMakeCache.txt"
    if [[ -f "${cache}" ]]; then
        local cached_var cached_dir
        while IFS= read -r cached_var; do
            cached_dir="${cached_var#MODULE_}"
            cached_dir="${cached_dir,,}"
            # still in a tree: already listed above
            [[ -n "${seen[${cached_dir}]:-}" ]] && continue
            echo "${cached_var}=disabled"
        done < <(sed -n 's/^\(MODULE_MOD-[A-Z0-9-]*\):STRING=.*/\1/p' "${cache}")
    fi
    } | sort
}
# }}}

# {{{ steady_patched_mtimes
# Gives each file the patch steps rewrote back the timestamp it had at the
# last build in this build folder, when its content is the same as then.
#
# Why: make rebuilds by timestamp. Every build applies the source patches
# (rewriting the patched files) and reverts them after (rewriting them
# again), and B036/B030 copy the buddy module and basic's rules in afresh,
# so every patched or copied file looked new on every build, with everything
# that includes it: Player.h alone is in most of the server. ccache then
# turned most compiles into cache hits, but make still walked them all and
# every link ran again (owner, 2026-10-08: "something tells me we're not
# properly utilizing incremental builds").
#
# How, safely: a ledger (build-shadow/.steady-mtimes) holds, per file, the
# content hash and timestamp it had when this build folder last compiled.
#   same hash  -> the timestamp from the ledger goes back on: the objects in
#                 this folder were compiled from exactly this content
#   new hash   -> the file keeps its new timestamp, so it and everything
#                 that depends on it rebuild, and the ledger takes the new
#                 hash and timestamp
# Only "the content at the last build here" is ever restored, never an older
# one, so switching profiles (basic's patched Player.h, cc-test's) can't
# leave an object compiled from other content looking up to date.
#
# Which files: those differing from their git commit in the source tree and
# each module (tracked and untracked, ignored left out), the patch-copied
# module folders and src/server/scripts/Custom/ (ignored by git, so listed
# by hand), and every file the ledger already holds. Only those are read.
steady_patched_mtimes() {
    local ledger="${BUILD_DIR_SHADOW}/.steady-mtimes"
    local -A old_hash=() old_time=()
    local path hash mtime
    if [[ -f "${ledger}" ]]; then
        while IFS=$'\t' read -r path hash mtime; do
            [[ -n "${path}" ]] || continue
            old_hash["${path}"]="${hash}"
            old_time["${path}"]="${mtime}"
        done < "${ledger}"
    fi

    # the files to look at
    local -A wanted=()
    local repo rel
    for repo in "${AC_CODE_DIR}" "${AC_CODE_DIR}"/modules/*/; do
        [[ -d "${repo}/.git" ]] || continue
        repo="${repo%/}"
        while IFS= read -r rel; do
            [[ -n "${rel}" ]] && wanted["${repo}/${rel}"]=1
        done < <(git -C "${repo}" diff --name-only HEAD; git -C "${repo}" ls-files --others --exclude-standard)
    done
    local copied
    for copied in "${!PATCH_PROVIDED_MODULES[@]}"; do
        [[ -d "${AC_CODE_DIR}/modules/${copied}" ]] || continue
        while IFS= read -r path; do wanted["${path}"]=1; done < <(find "${AC_CODE_DIR}/modules/${copied}" -type f)
    done
    if [[ -d "${AC_CODE_DIR}/src/server/scripts/Custom" ]]; then
        while IFS= read -r path; do wanted["${path}"]=1; done < <(find "${AC_CODE_DIR}/src/server/scripts/Custom" -type f)
    fi
    for path in "${!old_hash[@]}"; do wanted["${path}"]=1; done

    # put back, or record
    local restored=0 changed=0 new_ledger=""
    for path in "${!wanted[@]}"; do
        [[ -f "${path}" ]] || continue               # gone (a copied module removed): nothing to keep
        hash=$(sha1sum "${path}" | cut -d' ' -f1)
        if [[ "${old_hash[${path}]:-}" == "${hash}" ]]; then
            # same content as the last build here: its timestamp then
            touch -m -d "@${old_time[${path}]}" "${path}"
            mtime="${old_time[${path}]}"
            restored=$((restored + 1))
        else
            # new content (or first seen): keeps its new timestamp, rebuilds
            mtime=$(stat -c %Y "${path}")
            changed=$((changed + 1))
        fi
        new_ledger+="${path}"$'\t'"${hash}"$'\t'"${mtime}"$'\n'
    done
    mkdir -p "${BUILD_DIR_SHADOW}"
    printf '%s' "${new_ledger}" > "${ledger}"
    echo "Patched and copied files: ${restored} unchanged since the last build (timestamps kept), ${changed} new or changed (will rebuild)"
}
# }}}

# {{{ check_modules_configured
# Checks if all modules in source are present in the cmake-generated loader.
# If any module is missing, sets FORCE_REBUILD=true to trigger reconfiguration.
# Modules this profile does not want (module_wanted) are skipped: they are
# switched off on purpose, so their absence from the loader is correct.
check_modules_configured() {
    local MODULES_DIR="${AC_CODE_DIR}/modules"
    local LOADER_FILE="${BUILD_DIR_SHADOW}/modules/gen_scriptloader/static/ModulesLoader.cpp"

    # Skip check if no CMakeCache (cmake will run anyway)
    if [[ ! -f "${BUILD_DIR_SHADOW}/CMakeCache.txt" ]]; then
        return 0
    fi

    # Skip check if loader file doesn't exist (cmake will run anyway)
    if [[ ! -f "${LOADER_FILE}" ]]; then
        return 0
    fi

    # Get list of modules in source (directories with src/ subdirectory)
    local source_modules=()
    for mod_dir in "${MODULES_DIR}"/*/; do
        local mod_name=$(basename "${mod_dir}")
        # Skip non-module directories (files, hidden dirs, etc)
        [[ -d "${mod_dir}/src" ]] || continue
        # Skip .gitkeep and other non-module items
        [[ "${mod_name}" == "." || "${mod_name}" == ".." ]] && continue
        # Another profile's module, switched off for this build: not missing
        module_wanted "${mod_name}" || continue
        source_modules+=("${mod_name}")
    done

    # Check each module is in the generated loader
    local missing_modules=()
    for mod_name in "${source_modules[@]}"; do
        # Module loader function: Addmod_aleScripts -> search for "Addmod_ale"
        # Convert mod-ale to mod_ale for function name matching
        local func_pattern="Add${mod_name//-/_}Scripts"
        if ! grep -q "${func_pattern}" "${LOADER_FILE}" 2>/dev/null; then
            missing_modules+=("${mod_name}")
        fi
    done

    # If any modules missing, force reconfigure
    if [[ ${#missing_modules[@]} -gt 0 ]]; then
        echo ""
        echo "Detected unconfigured modules:"
        for mod in "${missing_modules[@]}"; do
            echo "  - ${mod}"
        done
        echo "Forcing cmake reconfiguration to include new modules."
        FORCE_REBUILD=true
    fi

    # A new .cpp inside a module that is already configured is also unseen:
    # the module build collects its sources by a file glob, read only when
    # cmake runs, so the build compiles the old file list and the link then
    # fails on whatever the new file defines. compile_commands.json is that
    # file list as last configured. Project-owned modules (modules/ at the
    # project root) are checked from their project copy, because B036-style
    # patches copy them into the source tree only after this check.
    local COMMANDS_FILE="${BUILD_DIR_SHADOW}/compile_commands.json"
    [[ -f "${COMMANDS_FILE}" ]] || return 0      # no list yet: cmake runs anyway

    local unseen_sources=()
    local source_file
    while IFS= read -r source_file; do
        # a project module this profile doesn't build: its files are meant to be unseen
        local project_module="${source_file#"${DIR}/modules/"}"
        project_module="${project_module%%/*}"
        module_wanted "${project_module}" || continue
        # path as the build sees it: project modules/ becomes the tree's modules/
        local built_path="${AC_CODE_DIR}/modules/${source_file#"${DIR}/modules/"}"
        if ! grep -qF "\"${built_path}\"" "${COMMANDS_FILE}"; then
            unseen_sources+=("${built_path#"${AC_CODE_DIR}/"}")
        fi
    done < <(find "${DIR}/modules" -path '*/src/*' -name '*.cpp')

    # Any unseen file: reconfigure so the glob picks it up. None: nothing to do.
    if [[ ${#unseen_sources[@]} -gt 0 ]]; then
        echo ""
        echo "Detected module source files the last configure did not see:"
        for source_file in "${unseen_sources[@]}"; do
            echo "  - ${source_file}"
        done
        echo "Forcing cmake reconfiguration to include them."
        FORCE_REBUILD=true
    fi
}
# }}}

# {{{ print_build_failure
print_build_failure() {
    FAILURE_ALREADY_EXPLAINED=true
    local ERROR_LOG="${BUILD_DIR_SHADOW}/compile-errors.log"
    echo ""
    echo "==============================================================================="
    echo "BUILD FAILED"
    echo "==============================================================================="
    echo ""
    echo "Debug information preserved at:"
    echo "  ${ERROR_LOG}"
    echo ""
    if [[ -d "${INSTALL_DIR}" && -f "${INSTALL_DIR}/bin/worldserver" ]]; then
        echo "Your current working binaries are UNCHANGED:"
        echo "  ${INSTALL_DIR}/bin/worldserver"
        echo "  ${INSTALL_DIR}/bin/authserver"
    else
        echo "No previous working binaries exist."
        echo "This appears to be a first-time build."
    fi
    echo ""
    echo "To retry after fixing:"
    echo "  ./scripts/compile"
    echo "==============================================================================="
}
# }}}

# {{{ run_quick_tests
# The project's quick tests (scripts/test-*), run before anything is
# patched or built: the owner, 2026-10-09, asked whether the compile ran
# them, expecting it did ("this is part of the compile, right?"); it did
# not. They run in parallel, each with its log in
# tmp/shared-memory/compile-tests/<test>.log; any failure stops the build
# before it starts, naming the test and its log. Several need the
# project's MySQL (they apply and revert SQL inside rolled-back
# transactions or the _smoke_test database): with MySQL down the step
# stops and says so, rather than reporting those as broken.
#
# Left out, and why:
#   test-basic-legendaries, test-buddy-subareas: read summaries their
#       generators write into RAM (tmp/shared-memory), gone after a reboot
#   test-exploration-engine, test-model-formats: read inputs extracted
#       into RAM by separate steps (exploration floors, reference models)
#   test-mysql-start: needs MySQL stopped
#   test-source-patches, test-patched-syntax: this compile applies and
#       compiles the patches for real
#   test-basic-sql-in-ram: builds a whole database in RAM (minutes); run it
#       by hand after changing basic's SQL
QUICK_TESTS=(
    test-acherus-vendors test-ambush test-arathi-basin-rules test-beta-lua-load test-buddy-arc test-buddy-choice test-check-issue-references test-hearthstone test-travel
    test-buddy-gems test-buddy-gm test-buddy-hearth test-buddy-kit test-buddy-roam-core
    test-buddy-stand-ins test-buddy-talents test-compile-module-set test-dk-buddies-by-level test-dk-buddy-gear test-dk-skip-story
    test-dk-soul-trade test-gear-designs test-gearsets test-gm-command-reference
    test-line-edits test-lua-unique-names test-movement test-navmesh-caves test-profile-config-gates test-profile-tables-agree test-redirect-listener test-roam-pattern
    test-sargobras-follow test-sql-mirror test-steady-mtimes test-valley-deal test-world-boss-countdown
    test-treasure test-info-files-match-source test-lua-globals
)
run_quick_tests() {
    local out="${DIR}/tmp/shared-memory/compile-tests"
    mkdir -p "${out}" || { echo "ERROR: can't make ${out} (is tmp/shared-memory linked?)"; exit 1; }
    rm -f "${out}"/*.log "${out}"/*.ok

    if ! "${DIR}/mysql/installed-files/bin/mysqladmin" --no-defaults --socket="${DIR}/mysql/databases/mysql.sock" \
            -uritz -pmenardi ping > /dev/null 2>&1; then
        echo "ERROR: the quick tests need the project's MySQL, and it isn't answering."
        echo "       start it (./scripts/start-mysql) and compile again, or pass --skip-tests"
        exit 1
    fi

    echo "Running ${#QUICK_TESTS[@]} quick tests..."
    local t
    for t in "${QUICK_TESTS[@]}"; do
        [[ -x "${DIR}/scripts/${t}" ]] || { echo "ERROR: scripts/${t} is missing or not executable (the compile's test list names it)"; exit 1; }
    done
    printf '%s\n' "${QUICK_TESTS[@]}" | xargs -P "$(nproc)" -I{} bash -c \
        'timeout 600 "$1/scripts/$2" "$1" > "$3/$2.log" 2>&1 && touch "$3/$2.ok"' _ "${DIR}" {} "${out}"

    local failed=()
    for t in "${QUICK_TESTS[@]}"; do
        [[ -f "${out}/${t}.ok" ]] || failed+=("${t}")
    done
    if [[ ${#failed[@]} -gt 0 ]]; then
        echo "ERROR: ${#failed[@]} of ${#QUICK_TESTS[@]} quick tests failed; nothing was patched or built:"
        for t in "${failed[@]}"; do
            echo "  ${t}: tmp/shared-memory/compile-tests/${t}.log"
            tail -n 3 "${out}/${t}.log" | sed 's/^/      /'
        done
        echo "       (--skip-tests builds anyway)"
        exit 1
    fi
    echo "All ${#QUICK_TESTS[@]} quick tests passed (logs: tmp/shared-memory/compile-tests/)"
}
# }}}

# {{{ do_build
do_build() {
    echo ""
    echo "Building into shadow directories..."
    echo "  Shadow build:   ${BUILD_DIR_SHADOW}"
    echo "  Shadow install: ${INSTALL_DIR_SHADOW}"

    local CLANGPP_DIR="/usr/bin/clang++"
    local CLANG_DIR="/usr/bin/clang"
    local LUAJIT_INC="/usr/include/luajit-2.1"
    local LUAJIT_LIB="/usr/lib/libluajit-5.1.so"

    setup_log_symlinks
    local BUILD_LOG="${DIR}/tmp/build-${PROFILE}.log"

    mkdir -p "${BUILD_DIR_SHADOW}"
    cd "${BUILD_DIR_SHADOW}"

    local ERROR_LOG="${BUILD_DIR_SHADOW}/compile-errors.log"
    echo "Build started: $(date)" > "${ERROR_LOG}"
    echo "Profile: ${PROFILE}" >> "${ERROR_LOG}"
    echo "Source: ${AC_CODE_DIR}" >> "${ERROR_LOG}"
    echo "---" >> "${ERROR_LOG}"

    cp "${ERROR_LOG}" "${BUILD_LOG}"
    echo "Build log: ${BUILD_LOG}"
    echo "Error log: ${ERROR_LOG}"

    # Build Boost if needed
    if [[ ! -d "${BOOST_DIR}/lib" ]]; then
        echo "Local Boost not found - run ./scripts/boost first"
        exit 1
    fi
    echo "Using local Boost from ${BOOST_DIR}"

    # ccache check. Cache content lives at ${CCACHE_CACHE_DIR} (project-
    # local, visible) rather than the per-user default at ~/.ccache so
    # the cache lifecycle ties to this project, not the operator's
    # home. See issue 149 for the design rationale (TLDR: the patch-
    # and-unpatch flow walks file mtimes forward each build, which
    # would force unnecessary make rebuilds; ccache hashes content
    # rather than trusting mtimes, so identical-content rebuilds are
    # cache hits).
    # Self-bootstrap ccache if missing. scripts/ccache is idempotent
    # — present binary → instant exit, missing → ~30s first-time build
    # from libs/ccache-src. Either way the operator never has to
    # remember to invoke ccache manually before compile.
    # The project directory is passed through explicitly. scripts/ccache
    # works out its own location when told nothing, and that answer is
    # usually the same one — but "usually" is not good enough when this
    # script already knows the answer for certain. See issue 154.
    if [[ ! -x "${CCACHE_BIN}" ]]; then
        echo "Local ccache not found, building it now..."
        "${DIR}/scripts/ccache" --dir "${DIR}"
    fi
    mkdir -p "${CCACHE_CACHE_DIR}"
    export CCACHE_DIR="${CCACHE_CACHE_DIR}"
    # Precompiled headers: without these, ccache turns away every compile
    # that uses one ("Could not use precompiled header": 10,711 of 18,782
    # calls, 2026-09-29, i.e. every game and script file). The build uses
    # them, and the source patches' apply/revert re-dates headers inside
    # them, so make rebuilds nearly everything each time; ccache, which
    # compares content, is what turns that back into a short build. Clang
    # also needs its precompiled headers built without a timestamp
    # (-fno-pch-timestamp, in the cmake flags below). ccache's own manual,
    # "Precompiled headers".
    export CCACHE_SLOPPINESS="pch_defines,time_macros,include_file_mtime,include_file_ctime"
    echo "Using local ccache from ${CCACHE_BIN}"
    echo "  Cache: ${CCACHE_CACHE_DIR}"

    # Only run cmake if not already configured, or if forced, or if the
    # configuration predates the timestamp-free precompiled headers ccache
    # needs (then once more, to add that flag; that build compiles
    # everything afresh, after which the cache carries the builds)
    local PCH_FLAG="-Xclang -fno-pch-timestamp"

    # Which modules this profile links (module_cmake_settings), as cmake
    # settings, and which of them the last configure (the shared
    # build-shadow cache, used by every profile) had otherwise. A profile
    # switch that changes the module set has to reconfigure, or the build
    # keeps the previous profile's modules.
    local -a MODULE_FLAGS=()
    local module_changes=()
    local setting
    while IFS= read -r setting; do
        [[ -n "${setting}" ]] || continue
        MODULE_FLAGS+=("-D${setting%%=*}=${setting#*=}")
        if [[ -f "${BUILD_DIR_SHADOW}/CMakeCache.txt" ]]; then
            # Any entry type: cmake records a setting it was handed on the
            # command line but no module declared as ":UNINITIALIZED="
            # (seen for every disabled module), the rest as ":STRING=".
            # sed, not grep: a setting absent from the cache is normal (a
            # new module), and grep's "no match" exit would end the script
            # here under set -e with nothing printed (2026-10-12).
            local cached
            cached=$(sed -n "s/^${setting%%=*}:[A-Z]*=//p" "${BUILD_DIR_SHADOW}/CMakeCache.txt" | head -n 1)
            # unset in the cache counts as "default" (cmake's own default)
            [[ "${cached:-default}" == "${setting#*=}" ]] || module_changes+=("${setting%%=*} ${cached:-unset} -> ${setting#*=}")
        fi
    done < <(module_cmake_settings)
    echo ""
    echo "Modules for ${PROFILE}:"
    for setting in "${MODULE_FLAGS[@]}"; do echo "  ${setting#-D}"; done

    local RECONFIGURE_WHY=""
    if [[ ! -f "${BUILD_DIR_SHADOW}/CMakeCache.txt" ]]; then
        RECONFIGURE_WHY="not configured yet"
    elif [[ "${FORCE_REBUILD}" == "true" ]]; then
        RECONFIGURE_WHY="--force"
    elif ! grep -q -- "-fno-pch-timestamp" "${BUILD_DIR_SHADOW}/CMakeCache.txt"; then
        RECONFIGURE_WHY="adding ${PCH_FLAG} so ccache can cache precompiled-header compiles (this build compiles everything once)"
    elif [[ ${#module_changes[@]} -gt 0 ]]; then
        RECONFIGURE_WHY="the module set differs from the last configure: ${module_changes[*]}"
    elif ! grep -q "^CMAKE_BUILD_TYPE:[A-Z]*=$([[ "${DEBUG_BUILD}" == "true" ]] && echo Debug || echo RelWithDebInfo)\$" "${BUILD_DIR_SHADOW}/CMakeCache.txt"; then
        # a plain compile after a --debug one: back to the optimized build
        RECONFIGURE_WHY="the build type changes back to RelWithDebInfo (the last setup was for a different type)"
    fi
    if [[ -n "${RECONFIGURE_WHY}" ]]; then
        echo ""
        echo "Running cmake (${RECONFIGURE_WHY})..."
        if ! cmake "${AC_CODE_DIR}" \
          -DCMAKE_BUILD_TYPE="$([[ "${DEBUG_BUILD}" == "true" ]] && echo Debug || echo RelWithDebInfo)" \
          -DBOOST_ROOT="${BOOST_DIR}" \
          -DLUA_VERSION=luajit \
          -DLUAJIT_INCLUDE_DIR="${LUAJIT_INC}" \
          -DLUAJIT_LIBRARIES="${LUAJIT_LIB}" \
          -DCMAKE_INSTALL_PREFIX="${INSTALL_DIR_SHADOW}" \
          -DCONF_DIR="${INSTALL_DIR}/etc" \
          -DCMAKE_C_COMPILER="${CLANG_DIR}" \
          -DCMAKE_CXX_COMPILER="${CLANGPP_DIR}" \
          -DCMAKE_C_COMPILER_LAUNCHER="${CCACHE_BIN}" \
          -DCMAKE_CXX_COMPILER_LAUNCHER="${CCACHE_BIN}" \
          -DCMAKE_CXX_FLAGS="-I${AC_CODE_DIR}/src/common -I${LUAJIT_INC} -Wno-enum-constexpr-conversion -fcolor-diagnostics ${PCH_FLAG}" \
          -DCMAKE_BINARY_DIR="${BUILD_DIR_SHADOW}" \
          -DCMAKE_SOURCE_DIR="${AC_CODE_DIR}" \
          -DCMAKE_COLOR_DIAGNOSTICS=ON \
          -DWITH_WARNINGS=1 \
          -DTOOLS_BUILD=all \
          -DSCRIPTS=static \
          -DMODULES=static \
          "${MODULE_FLAGS[@]}" \
          -DMYSQL_EXECUTABLE="${MYSQL_DIR}/bin/mysql" \
          -DMYSQL_INCLUDE_DIR="${MYSQL_DIR}/include" \
          -DMYSQL_LIBRARY="${MYSQL_DIR}/lib/libmysqlclient.so" \
          2>&1 | tee -a "${BUILD_LOG}" "${ERROR_LOG}"; then
            echo "" >> "${ERROR_LOG}"
            echo "CMAKE FAILED at $(date)" >> "${ERROR_LOG}"
            print_build_failure
            return 1
        fi
    else
        echo ""
        echo "Skipping cmake (already configured, use --force to reconfigure)"
    fi

    # The build type actually configured, checked against the one asked for.
    # The reconfigure reasons above should make these always agree; this is
    # the guard if they ever don't, because the stamp written below (and so
    # whether the worldserver runs its crash catcher) trusts DEBUG_BUILD, not
    # what cmake really used.
    local wanted_type configured_type
    wanted_type="$([[ "${DEBUG_BUILD}" == "true" ]] && echo Debug || echo RelWithDebInfo)"
    configured_type="$(sed -n 's/^CMAKE_BUILD_TYPE:[A-Z]*=//p' "${BUILD_DIR_SHADOW}/CMakeCache.txt" | head -n 1)"
    if [[ "${configured_type}" != "${wanted_type}" ]]; then
        echo ""
        echo "ERROR: the build is set up as '${configured_type:-unset}', but this run asked for '${wanted_type}'."
        echo "  Setup was skipped, so the earlier build type would be used and the install mislabelled."
        echo "  To fix: add --force to re-run setup with ${wanted_type}."
        FAILURE_ALREADY_EXPLAINED=true
        return 1
    fi
    echo "Configured build type: ${configured_type}"

    echo ""
    echo "Building with ${THREADS} threads..."
    local make_result=0
    make -j${THREADS} 2>&1 | tee -a "${BUILD_LOG}" "${ERROR_LOG}" || make_result=$?

    if [[ ${make_result} -ne 0 ]]; then
        echo "" >> "${ERROR_LOG}"
        echo "MAKE FAILED with exit code ${make_result} at $(date)" >> "${ERROR_LOG}"
        print_build_failure
        return 1
    fi

    # Pre-install cleanup. cmake's
    #   install(DIRECTORY .../LuaEngine/extensions DESTINATION lua_scripts/)
    # in source-beta/modules/CMakeLists.txt fails with "File exists" if
    # anything (broken symlink included) already squats
    # installed-files-shadow/bin/lua_scripts/extensions/ — its
    # file(INSTALL TYPE DIRECTORY) refuses to clobber a non-directory.
    # Strip any leftover E001 symlinks from previous builds before
    # install runs; the post-install patch_E001 call below re-creates
    # them fresh against the current profile's source tree.
    echo ""
    echo "Clearing prior Lua script symlinks (so cmake --install can write extensions/)..."
    TARGET_INSTALL_DIR="${INSTALL_DIR_SHADOW}"
    unpatch_E001_lua_script_symlinks
    unset TARGET_INSTALL_DIR

    echo ""
    echo "Installing to shadow directory..."
    local install_result=0
    cmake --install . 2>&1 | tee -a "${BUILD_LOG}" "${ERROR_LOG}" || install_result=$?

    if [[ ${install_result} -ne 0 ]]; then
        echo "" >> "${ERROR_LOG}"
        echo "MAKE INSTALL FAILED with exit code ${install_result} at $(date)" >> "${ERROR_LOG}"
        print_build_failure
        return 1
    fi

    # Post-install Lua script symlinks for the shadow install. Delegates
    # to E001's patch fn so the rm-then-link teardown logic lives in one
    # place (handles cmake's just-installed real extensions/ directory
    # as well as stale symlinks). Run unconditionally — release/alpha
    # don't carry E001 in PHASE_END_PATCHES but still benefit from at
    # least a lua_scripts/custom path for mod-ale to look at.
    TARGET_INSTALL_DIR="${INSTALL_DIR_SHADOW}"
    patch_E001_lua_script_symlinks

    # Apply PHASE_END patches to shadow directory. For beta/vanilla this
    # re-runs E001 idempotently (no-op after the call above); for
    # release/alpha it does the rest of their PHASE_END (E004 logs,
    # E006 configs, etc.) without touching lua_scripts/.
    apply_patches_end
    unset TARGET_INSTALL_DIR

    # Stamp the shadow install with the build type. promote carries this file to
    # main, and scripts/worldserver reads it: a "Debug" stamp makes the server
    # auto-run its crash catcher, so a debug build always captures backtraces
    # without anyone remembering the runtime --debug flag.
    if [[ "${DEBUG_BUILD}" == "true" ]]; then
        echo "Debug" > "${INSTALL_DIR_SHADOW}/bin/.build-type"
    else
        echo "RelWithDebInfo" > "${INSTALL_DIR_SHADOW}/bin/.build-type"
    fi

    echo ""
    echo "Build complete! Shadow install at: ${INSTALL_DIR_SHADOW}"
    echo "Log: ${BUILD_LOG}"
    echo ""
    echo "NOTE: Binaries are in shadow directory and have NOT been promoted yet."
    echo "Run validation before promoting to main installation."
}
# }}}

# {{{ report_how_compile_ended
# The last thing printed on any failed exit, so the end of the output always
# says whether the compile worked. Three ways a run can stop early:
#   - an explicit error (quick tests, wrong pinned commit, ...): that message
#     is already above, and this adds the verdict line under it
#   - a build step failed (print_build_failure already printed BUILD FAILED):
#     the verdict line only
#   - a command failed with no message of its own, and set -e ended the
#     script: this names the file, line and command, since nothing else will
# A successful run never comes here; it prints COMPILE SUCCEEDED itself.
report_how_compile_ended() {
    local status=$1
    [[ ${status} -ne 0 ]] || return 0
    echo ""
    echo "==============================================================================="
    echo "COMPILE FAILED (exit status ${status}). Nothing was promoted; the installed"
    echo "server in installed-files-${PROFILE:-<profile>}/ is unchanged."
    if [[ -n "${STOPPED_AT:-}" && "${FAILURE_ALREADY_EXPLAINED:-false}" != "true" ]]; then
        echo ""
        echo "It stopped without an error message of its own, at:"
        echo "  ${STOPPED_AT#${DIR}/}"
        echo "  running: ${STOPPED_COMMAND}"
        echo "That command failed, and the script's stop-on-any-failure rule (set -e)"
        echo "ended the run there. The script should explain this failure itself; the"
        echo "line above is where to add that."
    fi
    echo "==============================================================================="
}
# }}}

# =============================================================================
# Main
# =============================================================================

# Armed before anything else, so even an early stop ends with a verdict.
# Replaced further down by the trap that also reverts the source patches.
trap 'report_how_compile_ended $?' EXIT

parse_args "$@"
get_profile_paths

echo "Compiling profile: ${PROFILE}"
echo "  (skipping git checks)"
# What --debug changes, said up front, because nothing in cmake's or make's
# own output makes it obvious (cmake prints "buildtype : Debug" once, deep
# in its option summary). It changes the program that comes out, not just
# the messages: the compiler leaves the code unoptimized, and the
# installed folder is marked so the worldserver runs under the crash
# catcher. It does NOT turn on the core's own debug code (packet counters,
# slow-query warnings); that is a separate cmake option, WITH_COREDEBUG,
# which this script never sets.
if [[ "${DEBUG_BUILD}" == "true" ]]; then
    echo "Build type: Debug (--debug)"
    echo "  - compiled without optimization (-O0 -g): a crash report shows the true"
    echo "    line and every variable's value, but the server runs several times slower"
    echo "  - standard assertions stay switched on (no -DNDEBUG)"
    echo "  - the install is marked Debug, so ./scripts/worldserver runs it under the"
    echo "    crash catcher automatically"
    echo "  - cmake's setup re-runs (--debug implies --force). The first Debug build"
    echo "    compiles nearly everything; the cache makes later ones short"
else
    echo "Build type: RelWithDebInfo (optimized, with debug symbols; --debug for Debug)"
fi
echo ""

# Check source exists
if [[ ! -d "${AC_CODE_DIR}/.git" ]]; then
    echo "Error: Source not found. Run './scripts/install' first."
    exit 1
fi

# Source patch functions. Loaded before the module check, because which
# modules this profile wants depends on its source-patch list (a patch can
# bring a module in, see PATCH_PROVIDED_MODULES). Loading only defines
# functions and the per-profile lists; nothing is applied here.
source "${DIR}/patches/patches.sh"

# The quick tests, before anything is touched (run_quick_tests)
[[ "${RUN_TESTS}" == "true" ]] && run_quick_tests

# Check if any modules were added since last cmake configure
check_modules_configured

# Hard-reset source-beta and every module to HEAD before re-applying
# patches. Source trees are build artifacts (issue 136); anything in the
# working tree is discardable. See patches.sh:reset_source_trees.
reset_source_trees

# The source tree must be at the profile's pinned commit: the patches are
# written against it, and compile builds whatever commit the tree is on
# (only scripts/update and scripts/install move it). On 2026-10-12 the pin
# had moved (to 2a2211cd8f3d, 2026-10-09) but the tree was still at the
# old one, so the build stopped at the first patch retargeted for the new
# pin (B043, "anchors found ... 0") with nothing saying why. The pin is
# read from scripts/update's table, the one that checks it out.
PIN="$(sed -n '/^declare -A PROFILE_COMMIT=(/,/^)/p' "${DIR}/scripts/update" \
    | sed -n "s/^ *\[\"${PROFILE}\"\]=\"\([0-9a-f]*\)\".*/\1/p")"
if [[ -n "${PIN}" ]]; then
    TREE_COMMIT="$(git -C "${AC_CODE_DIR}" rev-parse HEAD)"
    if [[ "${TREE_COMMIT}" != "${PIN}"* ]]; then
        echo "ERROR: ${AC_CODE_DIR} is at ${TREE_COMMIT:0:12}, but the ${PROFILE} profile is pinned to ${PIN}."
        echo "  The patches are written for the pinned commit, so they would not apply here."
        echo "  To fix: ./scripts/update   (checks out the pinned commits of the core and modules, then compiles)"
        echo "  Nothing was changed."
        exit 1
    fi
fi

# Ensure patches are reverted even on build failure. Armed BEFORE applying:
# apply_patches_begin now stops on the first failing patch, and under
# set -e that exits here, so a trap set afterward would never fire and the
# patches applied before the failure would stay in the tree.
# The exit status is caught first: the reverts would overwrite it. A
# failed revert (unapply_patches_begin returns failure, naming the patch)
# fails a run that had succeeded so far, and must not stop the trap before
# the trees are reset, hence its "|| compile_status=1".
trap 'compile_status=$?; unapply_patches_begin || compile_status=1; leave_source_trees_clean; report_how_compile_ended ${compile_status}' EXIT
# {{{ generate_buddy_gear
# The buddies' gear lists and the page that shows them, made again from
# the world database before every build (owner, 2026-10-15: "Make sure
# it's dynamically updated whenever we compile ... just call the generator
# in the compilation script, and write some output about it's location in
# the logs"). Three steps, each a script of its own:
#   scripts/translate-buddy-kit-to-gearset  the rules -> src/lua-basic/data/gearsets/buddy-white-*.lua
#   scripts/generate-gearset-sql            those lists -> sql/basic/db_world.src/33-gearsets.apply.sql
#                                           (loaded by install step E052)
#   scripts/generate-buddy-gear-gallery     the lists + item data -> docs/HTML/buddy-gear-gallery.html
# Only for the profiles that have buddies (basic, cc-test). They read the
# world database, so MySQL must be answering; a failure stops the compile
# with the step's own words (a stale list would dress buddies wrongly).
generate_buddy_gear() {
    case "${PROFILE}" in basic|cc-test) ;; *) return 0 ;; esac
    if ! "${DIR}/mysql/installed-files/bin/mysqladmin" --no-defaults --socket="${DIR}/mysql/databases/mysql.sock" \
            -uritz -pmenardi ping > /dev/null 2>&1; then
        echo "ERROR: making the buddy gear lists needs the project's MySQL, and it isn't answering."
        echo "       start it (./scripts/start-mysql) and compile again"
        exit 1
    fi
    echo "Making the buddy gear lists and their gallery..."
    "${DIR}/scripts/translate-buddy-kit-to-gearset" "${DIR}" || { echo "ERROR: scripts/translate-buddy-kit-to-gearset failed (above)"; exit 1; }
    "${DIR}/scripts/generate-gearset-sql" "${DIR}" || { echo "ERROR: scripts/generate-gearset-sql failed (above)"; exit 1; }
    "${DIR}/scripts/generate-buddy-gear-gallery" "${DIR}" || { echo "ERROR: scripts/generate-buddy-gear-gallery failed (above)"; exit 1; }
    echo "  gear lists:   ${DIR}/src/lua-basic/data/gearsets/buddy-white-*.lua (into the database at the next install)"
    echo "  gear gallery: ${DIR}/docs/HTML/buddy-gear-gallery.html"
}
# }}}
generate_buddy_gear

# Apply pre-compile patches (idempotent)
apply_patches_begin

# Patched and copied files whose content is what the last build here
# compiled get that build's timestamps back, so make skips them
steady_patched_mtimes

# Build
do_build

# Clear trap and revert patches after successful build; then the trees are
# reset to their commits whatever the reverts did (leave_source_trees_clean)
# The verdict trap stays: a failing revert here would otherwise end the run
# with no word at all after the build itself succeeded (2026-10-13: a
# compile at 23:22 the night before installed its build and then never
# reached validation, and nothing on record says why).
# A failed revert is an error in that patch (owner, 2026-10-13): it ends
# the run here, failed; the trap still resets the trees to their commits
# first, then gives the verdict.
trap 'compile_status=$?; leave_source_trees_clean; report_how_compile_ended ${compile_status}' EXIT
unapply_patches_begin
leave_source_trees_clean

echo ""
echo "==============================================================================="
echo "COMPILE SUCCEEDED ($(cat "${INSTALL_DIR_SHADOW}/bin/.build-type") build). The new build is in the"
echo "shadow install, not yet promoted."
echo "==============================================================================="

# Auto-validate and promote unless disabled
if [[ "${AUTO_VALIDATE}" == "true" ]]; then
    echo ""
    echo "Starting validation..."
    exec "${DIR}/scripts/validate" --profile "${PROFILE}"
else
    echo ""
    echo "Auto-validation disabled. To validate and promote manually:"
    echo "  ./scripts/validate --profile ${PROFILE}"
fi
