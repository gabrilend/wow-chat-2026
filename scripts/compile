#!/bin/bash
# scripts/compile - Compile the server from source
# Skips git checks, goes straight to cmake/make
# Builds into shadow directory for atomic promotion

set -e
set -o pipefail

# {{{ set_dir
# The project directory: --dir when given, otherwise the parent of the
# directory this script lives in.
#
# Scanned out of the arguments here rather than in parse_args further
# down, because the profile is read from ${DIR}/.profile a few lines
# below and parse_args does not run until long after that. Reading the
# profile from one project and then working on another is the failure
# this ordering avoids.
#
# No hard-coded path. This departs from the house convention on purpose,
# so the project can be worked on from a machine that has never seen it.
# The derivation is safe here in a way it is not for the three
# dependency scripts: this one is useless without a full checkout around
# it, so if it is running at all, it is sitting in that checkout's
# scripts directory. See issue 154.
SELF_DIR="${BASH_SOURCE[0]%/*}"
[[ "${SELF_DIR}" == "${BASH_SOURCE[0]}" ]] && SELF_DIR="."

EXPLICIT_DIR=""
DIR_SCAN_ARGS=("$@")
for (( dir_scan_index = 0; dir_scan_index < ${#DIR_SCAN_ARGS[@]}; dir_scan_index++ )); do
    case "${DIR_SCAN_ARGS[dir_scan_index]}" in
        --dir)   EXPLICIT_DIR="${DIR_SCAN_ARGS[dir_scan_index + 1]:-}" ;;
        --dir=*) EXPLICIT_DIR="${DIR_SCAN_ARGS[dir_scan_index]#*=}"    ;;
    esac
done

if [[ -n "${EXPLICIT_DIR}" ]]; then
    DIR_CANDIDATE="${EXPLICIT_DIR}"
    DIR_SOURCE="the --dir argument"
else
    DIR_CANDIDATE="${SELF_DIR}/.."
    DIR_SOURCE="where this script lives, ${BASH_SOURCE[0]}"
fi

if [[ ! -d "${DIR_CANDIDATE}" ]]; then
    echo "Project directory does not exist: ${DIR_CANDIDATE}"
    echo "  This came from ${DIR_SOURCE}."
    echo "  Nothing has been changed."
    exit 1
fi

# Resolved rather than kept as written, so every path built from it is
# valid regardless of the working directory this was invoked from, and
# so a project reachable through a symlink compares equal to itself.
DIR="$( builtin cd -P -- "${DIR_CANDIDATE}" && pwd )"
# }}}

# =============================================================================
# Load Profile
# =============================================================================

if [[ -f "${DIR}/.profile" ]]; then
    PROFILE="$(cat "${DIR}/.profile")"
else
    PROFILE="release"
fi
# DEFAULT_PROFILE snapshots the no-argument default so --help reports the
# true default even when a --profile flag precedes --help on the command
# line (that flag mutates PROFILE, not the default a bare run would use).
DEFAULT_PROFILE="${PROFILE}"

# =============================================================================
# Configuration
# =============================================================================

THREADS="${THREADS:-4}"
AUTO_VALIDATE=true

# No Boost version is named here. cmake is pointed at the directory
# scripts/boost installed into and reads the version out of the headers
# it finds there, so a version stated in this file would only be a
# second copy of the truth, free to disagree with it. Two such
# constants used to sit here saying 1.74.0 while the installed library
# was 1.81.0; nothing read them. See issue 154.

# =============================================================================
# Profile Definitions
# =============================================================================

# {{{ Modules per profile
declare -A PROFILE_MODULES=(
    ["alpha"]="mod-eluna mod-transmog"
    ["beta"]="mod-ale mod-aoe-loot mod-grownup mod-playerbots"
    ["release"]="mod-ale mod-playerbots"
    ["vanilla"]="mod-playerbots mod-solo-lfg mod-aoe-loot mod-fireworks-on-level mod-ale"
    ["basic"]="mod-playerbots mod-solo-lfg mod-aoe-loot mod-fireworks-on-level mod-ale"
)
# }}}

# =============================================================================
# Argument Parsing
# =============================================================================

FORCE_REBUILD=false
# --debug builds at -O0 -g (CMAKE_BUILD_TYPE=Debug) so crash backtraces resolve
# to exact file:line, and stamps the install so the server auto-runs its crash
# catcher (no runtime --debug needed). Default builds RelWithDebInfo.
DEBUG_BUILD=false

# {{{ parse_args
# Each option supports both --opt value and --opt=value forms. The
# catch-all errors instead of silently dropping unknown args.
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --profile)
                if [[ -n "${2:-}" ]]; then
                    PROFILE="${2}"
                    shift 2
                else
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                if [[ -z "${PROFILE}" ]]; then
                    echo "Error: --profile requires a profile name"
                    exit 1
                fi
                shift
                ;;
            --dir)
                # Already resolved by the scan at the top of the file;
                # consumed here only so the catch-all does not reject it.
                if [[ -n "${2:-}" ]]; then
                    shift 2
                else
                    echo "Error: --dir requires a path"
                    exit 1
                fi
                ;;
            --dir=*)
                shift
                ;;
            --threads)
                if [[ -n "${2:-}" && "${2}" =~ ^[0-9]+$ ]]; then
                    THREADS="${2}"
                    shift 2
                else
                    echo "Error: --threads requires a numeric argument"
                    exit 1
                fi
                ;;
            --threads=*)
                THREADS="${1#*=}"
                if [[ ! "${THREADS}" =~ ^[0-9]+$ ]]; then
                    echo "Error: --threads requires a numeric argument"
                    exit 1
                fi
                shift
                ;;
            --force)
                FORCE_REBUILD=true
                shift
                ;;
            --debug)
                # Debug build: -O0 -g everywhere for precise crash traces, and
                # the server auto-enables its crash catcher. Implies --force
                # because switching CMAKE_BUILD_TYPE needs a reconfigure.
                DEBUG_BUILD=true
                FORCE_REBUILD=true
                shift
                ;;
            --no-validate)
                AUTO_VALIDATE=false
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                echo "Error: unrecognized argument '${1}'"
                echo "Run with --help to see available options."
                exit 1
                ;;
        esac
    done
}
# }}}

# {{{ show_help
show_help() {
    echo "Usage: ./scripts/compile [options]"
    echo ""
    echo "Compile the server from source (skips git checks)."
    echo "Builds into shadow directory, then auto-validates and promotes."
    echo ""
    echo "Options:"
    echo "  --dir <path>       Project directory"
    echo "                     (default: the parent of this script's directory)"
    echo "  --profile <name>   Use specific profile (default: ${DEFAULT_PROFILE})"
    echo "  --threads <n>      Number of threads (default: ${THREADS})"
    echo "  --force            Force cmake reconfiguration"
    echo "  --debug            Build -O0 -g (Debug); the server then auto-runs the"
    echo "                     crash catcher, giving exact file:line in tmp/ traces"
    echo "  --no-validate      Skip auto-validation and promotion"
    echo "  --help             Show this help message"
    echo ""
    echo "Pipeline (automatic):"
    echo "  compile -> validate -> promote"
    echo ""
    echo "Manual workflow (with --no-validate):"
    echo "  1. ./scripts/compile --no-validate  - Build to shadow only"
    echo "  2. ./scripts/validate               - Test and promote"
}
# }}}

# =============================================================================
# Functions
# =============================================================================

# {{{ get_profile_paths
get_profile_paths() {
    # vanilla shares source-beta with release/beta — see issue 148.
    case "${PROFILE}" in
        release) AC_CODE_DIR="${DIR}/source-beta"  ;;
        beta)    AC_CODE_DIR="${DIR}/source-beta"  ;;
        vanilla) AC_CODE_DIR="${DIR}/source-beta"  ;;
        basic)   AC_CODE_DIR="${DIR}/source-beta"  ;;
        alpha)   AC_CODE_DIR="${DIR}/source-alpha" ;;
        *)       echo "ERROR: Unknown profile '${PROFILE}'"; exit 1 ;;
    esac
    INSTALL_DIR="${DIR}/installed-files-${PROFILE}"
    BUILD_DIR="${DIR}/build-${PROFILE}"
    MYSQL_DIR="${DIR}/mysql/installed-files"
    BOOST_DIR="${DIR}/libs/boost"
    CCACHE_BIN="${DIR}/libs/ccache/bin/ccache"
    CCACHE_CACHE_DIR="${DIR}/build-cache"
    BUILD_DIR_SHADOW="${DIR}/build-shadow"
    INSTALL_DIR_SHADOW="${DIR}/installed-files-shadow"
}
# }}}

# {{{ setup_log_symlinks
setup_log_symlinks() {
    local TMP_BASE="/tmp/wow-chat-2"
    local TMP_LOGS="${TMP_BASE}/logs-${PROFILE}"
    mkdir -p "${TMP_BASE}"
    mkdir -p "${TMP_LOGS}"
    [[ -L "${DIR}/tmp" ]] || ln -s "${TMP_BASE}" "${DIR}/tmp"
    [[ -L "${DIR}/logs-${PROFILE}" ]] || ln -s "${TMP_LOGS}" "${DIR}/logs-${PROFILE}"
}
# }}}

# {{{ check_modules_configured
# Checks if all modules in source are present in the cmake-generated loader.
# If any module is missing, sets FORCE_REBUILD=true to trigger reconfiguration.
check_modules_configured() {
    local MODULES_DIR="${AC_CODE_DIR}/modules"
    local LOADER_FILE="${BUILD_DIR_SHADOW}/modules/gen_scriptloader/static/ModulesLoader.cpp"

    # Skip check if no CMakeCache (cmake will run anyway)
    if [[ ! -f "${BUILD_DIR_SHADOW}/CMakeCache.txt" ]]; then
        return 0
    fi

    # Skip check if loader file doesn't exist (cmake will run anyway)
    if [[ ! -f "${LOADER_FILE}" ]]; then
        return 0
    fi

    # Get list of modules in source (directories with src/ subdirectory)
    local source_modules=()
    for mod_dir in "${MODULES_DIR}"/*/; do
        local mod_name=$(basename "${mod_dir}")
        # Skip non-module directories (files, hidden dirs, etc)
        [[ -d "${mod_dir}/src" ]] || continue
        # Skip .gitkeep and other non-module items
        [[ "${mod_name}" == "." || "${mod_name}" == ".." ]] && continue
        source_modules+=("${mod_name}")
    done

    # Check each module is in the generated loader
    local missing_modules=()
    for mod_name in "${source_modules[@]}"; do
        # Module loader function: Addmod_aleScripts -> search for "Addmod_ale"
        # Convert mod-ale to mod_ale for function name matching
        local func_pattern="Add${mod_name//-/_}Scripts"
        if ! grep -q "${func_pattern}" "${LOADER_FILE}" 2>/dev/null; then
            missing_modules+=("${mod_name}")
        fi
    done

    # If any modules missing, force reconfigure
    if [[ ${#missing_modules[@]} -gt 0 ]]; then
        echo ""
        echo "Detected unconfigured modules:"
        for mod in "${missing_modules[@]}"; do
            echo "  - ${mod}"
        done
        echo "Forcing cmake reconfiguration to include new modules."
        FORCE_REBUILD=true
    fi
}
# }}}

# {{{ print_build_failure
print_build_failure() {
    local ERROR_LOG="${BUILD_DIR_SHADOW}/compile-errors.log"
    echo ""
    echo "==============================================================================="
    echo "BUILD FAILED"
    echo "==============================================================================="
    echo ""
    echo "Debug information preserved at:"
    echo "  ${ERROR_LOG}"
    echo ""
    if [[ -d "${INSTALL_DIR}" && -f "${INSTALL_DIR}/bin/worldserver" ]]; then
        echo "Your current working binaries are UNCHANGED:"
        echo "  ${INSTALL_DIR}/bin/worldserver"
        echo "  ${INSTALL_DIR}/bin/authserver"
    else
        echo "No previous working binaries exist."
        echo "This appears to be a first-time build."
    fi
    echo ""
    echo "To retry after fixing:"
    echo "  ./scripts/compile"
    echo "==============================================================================="
}
# }}}

# {{{ do_build
do_build() {
    echo ""
    echo "Building into shadow directories..."
    echo "  Shadow build:   ${BUILD_DIR_SHADOW}"
    echo "  Shadow install: ${INSTALL_DIR_SHADOW}"

    local CLANGPP_DIR="/usr/bin/clang++"
    local CLANG_DIR="/usr/bin/clang"
    local LUAJIT_INC="/usr/include/luajit-2.1"
    local LUAJIT_LIB="/usr/lib/libluajit-5.1.so"

    setup_log_symlinks
    local BUILD_LOG="${DIR}/tmp/build-${PROFILE}.log"

    mkdir -p "${BUILD_DIR_SHADOW}"
    cd "${BUILD_DIR_SHADOW}"

    local ERROR_LOG="${BUILD_DIR_SHADOW}/compile-errors.log"
    echo "Build started: $(date)" > "${ERROR_LOG}"
    echo "Profile: ${PROFILE}" >> "${ERROR_LOG}"
    echo "Source: ${AC_CODE_DIR}" >> "${ERROR_LOG}"
    echo "---" >> "${ERROR_LOG}"

    cp "${ERROR_LOG}" "${BUILD_LOG}"
    echo "Build log: ${BUILD_LOG}"
    echo "Error log: ${ERROR_LOG}"

    # Build Boost if needed
    if [[ ! -d "${BOOST_DIR}/lib" ]]; then
        echo "Local Boost not found - run ./scripts/boost first"
        exit 1
    fi
    echo "Using local Boost from ${BOOST_DIR}"

    # ccache check. Cache content lives at ${CCACHE_CACHE_DIR} (project-
    # local, visible) rather than the per-user default at ~/.ccache so
    # the cache lifecycle ties to this project, not the operator's
    # home. See issue 149 for the design rationale (TLDR: the patch-
    # and-unpatch flow walks file mtimes forward each build, which
    # would force unnecessary make rebuilds; ccache hashes content
    # rather than trusting mtimes, so identical-content rebuilds are
    # cache hits).
    # Self-bootstrap ccache if missing. scripts/ccache is idempotent
    # — present binary → instant exit, missing → ~30s first-time build
    # from libs/ccache-src. Either way the operator never has to
    # remember to invoke ccache manually before compile.
    # The project directory is passed through explicitly. scripts/ccache
    # works out its own location when told nothing, and that answer is
    # usually the same one — but "usually" is not good enough when this
    # script already knows the answer for certain. See issue 154.
    if [[ ! -x "${CCACHE_BIN}" ]]; then
        echo "Local ccache not found, building it now..."
        "${DIR}/scripts/ccache" --dir "${DIR}"
    fi
    mkdir -p "${CCACHE_CACHE_DIR}"
    export CCACHE_DIR="${CCACHE_CACHE_DIR}"
    echo "Using local ccache from ${CCACHE_BIN}"
    echo "  Cache: ${CCACHE_CACHE_DIR}"

    # Only run cmake if not already configured, or if forced
    if [[ ! -f "${BUILD_DIR_SHADOW}/CMakeCache.txt" || "${FORCE_REBUILD}" == "true" ]]; then
        echo ""
        echo "Running cmake..."
        if ! cmake "${AC_CODE_DIR}" \
          -DCMAKE_BUILD_TYPE="$([[ "${DEBUG_BUILD}" == "true" ]] && echo Debug || echo RelWithDebInfo)" \
          -DBOOST_ROOT="${BOOST_DIR}" \
          -DLUA_VERSION=luajit \
          -DLUAJIT_INCLUDE_DIR="${LUAJIT_INC}" \
          -DLUAJIT_LIBRARIES="${LUAJIT_LIB}" \
          -DCMAKE_INSTALL_PREFIX="${INSTALL_DIR_SHADOW}" \
          -DCONF_DIR="${INSTALL_DIR}/etc" \
          -DCMAKE_C_COMPILER="${CLANG_DIR}" \
          -DCMAKE_CXX_COMPILER="${CLANGPP_DIR}" \
          -DCMAKE_C_COMPILER_LAUNCHER="${CCACHE_BIN}" \
          -DCMAKE_CXX_COMPILER_LAUNCHER="${CCACHE_BIN}" \
          -DCMAKE_CXX_FLAGS="-I${AC_CODE_DIR}/src/common -I${LUAJIT_INC} -Wno-enum-constexpr-conversion -fcolor-diagnostics" \
          -DCMAKE_BINARY_DIR="${BUILD_DIR_SHADOW}" \
          -DCMAKE_SOURCE_DIR="${AC_CODE_DIR}" \
          -DCMAKE_COLOR_DIAGNOSTICS=ON \
          -DWITH_WARNINGS=1 \
          -DTOOLS_BUILD=all \
          -DSCRIPTS=static \
          -DMODULES=static \
          -DMYSQL_EXECUTABLE="${MYSQL_DIR}/bin/mysql" \
          -DMYSQL_INCLUDE_DIR="${MYSQL_DIR}/include" \
          -DMYSQL_LIBRARY="${MYSQL_DIR}/lib/libmysqlclient.so" \
          2>&1 | tee -a "${BUILD_LOG}" "${ERROR_LOG}"; then
            echo "" >> "${ERROR_LOG}"
            echo "CMAKE FAILED at $(date)" >> "${ERROR_LOG}"
            print_build_failure
            return 1
        fi
    else
        echo ""
        echo "Skipping cmake (already configured, use --force to reconfigure)"
    fi

    echo ""
    echo "Building with ${THREADS} threads..."
    local make_result=0
    make -j${THREADS} 2>&1 | tee -a "${BUILD_LOG}" "${ERROR_LOG}" || make_result=$?

    if [[ ${make_result} -ne 0 ]]; then
        echo "" >> "${ERROR_LOG}"
        echo "MAKE FAILED with exit code ${make_result} at $(date)" >> "${ERROR_LOG}"
        print_build_failure
        return 1
    fi

    # Pre-install cleanup. cmake's
    #   install(DIRECTORY .../LuaEngine/extensions DESTINATION lua_scripts/)
    # in source-beta/modules/CMakeLists.txt fails with "File exists" if
    # anything (broken symlink included) already squats
    # installed-files-shadow/bin/lua_scripts/extensions/ — its
    # file(INSTALL TYPE DIRECTORY) refuses to clobber a non-directory.
    # Strip any leftover E001 symlinks from previous builds before
    # install runs; the post-install patch_E001 call below re-creates
    # them fresh against the current profile's source tree.
    echo ""
    echo "Clearing prior Lua script symlinks (so cmake --install can write extensions/)..."
    TARGET_INSTALL_DIR="${INSTALL_DIR_SHADOW}"
    unpatch_E001_lua_script_symlinks
    unset TARGET_INSTALL_DIR

    echo ""
    echo "Installing to shadow directory..."
    local install_result=0
    cmake --install . 2>&1 | tee -a "${BUILD_LOG}" "${ERROR_LOG}" || install_result=$?

    if [[ ${install_result} -ne 0 ]]; then
        echo "" >> "${ERROR_LOG}"
        echo "MAKE INSTALL FAILED with exit code ${install_result} at $(date)" >> "${ERROR_LOG}"
        print_build_failure
        return 1
    fi

    # Post-install Lua script symlinks for the shadow install. Delegates
    # to E001's patch fn so the rm-then-link teardown logic lives in one
    # place (handles cmake's just-installed real extensions/ directory
    # as well as stale symlinks). Run unconditionally — release/alpha
    # don't carry E001 in PHASE_END_PATCHES but still benefit from at
    # least a lua_scripts/custom path for mod-ale to look at.
    TARGET_INSTALL_DIR="${INSTALL_DIR_SHADOW}"
    patch_E001_lua_script_symlinks

    # Apply PHASE_END patches to shadow directory. For beta/vanilla this
    # re-runs E001 idempotently (no-op after the call above); for
    # release/alpha it does the rest of their PHASE_END (E004 logs,
    # E006 configs, etc.) without touching lua_scripts/.
    apply_patches_end
    unset TARGET_INSTALL_DIR

    # Stamp the shadow install with the build type. promote carries this file to
    # main, and scripts/worldserver reads it: a "Debug" stamp makes the server
    # auto-run its crash catcher, so a debug build always captures backtraces
    # without anyone remembering the runtime --debug flag.
    if [[ "${DEBUG_BUILD}" == "true" ]]; then
        echo "Debug" > "${INSTALL_DIR_SHADOW}/bin/.build-type"
    else
        echo "RelWithDebInfo" > "${INSTALL_DIR_SHADOW}/bin/.build-type"
    fi

    echo ""
    echo "Build complete! Shadow install at: ${INSTALL_DIR_SHADOW}"
    echo "Log: ${BUILD_LOG}"
    echo ""
    echo "NOTE: Binaries are in shadow directory and have NOT been promoted yet."
    echo "Run validation before promoting to main installation."
}
# }}}

# =============================================================================
# Main
# =============================================================================

parse_args "$@"
get_profile_paths

echo "Compiling profile: ${PROFILE}"
echo "  (skipping git checks)"
echo ""

# Check source exists
if [[ ! -d "${AC_CODE_DIR}/.git" ]]; then
    echo "Error: Source not found. Run './scripts/install' first."
    exit 1
fi

# Check if any modules were added since last cmake configure
check_modules_configured

# Source patch functions
source "${DIR}/patches/patches.sh"

# Hard-reset source-beta and every module to HEAD before re-applying
# patches. Source trees are build artifacts (issue 136); anything in the
# working tree is discardable. See patches.sh:reset_source_trees.
reset_source_trees

# Ensure patches are reverted even on build failure. Armed BEFORE applying:
# apply_patches_begin now stops on the first failing patch, and under
# set -e that exits here, so a trap set afterward would never fire and the
# patches applied before the failure would stay in the tree.
trap 'unapply_patches_begin' EXIT
# Apply pre-compile patches (idempotent)
apply_patches_begin

# Build
do_build

# Clear trap and revert patches after successful build
trap - EXIT
unapply_patches_begin

echo ""
echo "Compile complete! Shadow build ready."

# Auto-validate and promote unless disabled
if [[ "${AUTO_VALIDATE}" == "true" ]]; then
    echo ""
    echo "Starting validation..."
    exec "${DIR}/scripts/validate" --profile "${PROFILE}"
else
    echo ""
    echo "Auto-validation disabled. To validate and promote manually:"
    echo "  ./scripts/validate --profile ${PROFILE}"
fi
