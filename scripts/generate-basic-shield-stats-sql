#!/usr/bin/env luajit

if arg[1] == "--help" or arg[1] == "-h" then
    print("Usage: scripts/generate-basic-shield-stats-sql [PROJECT_DIR] [WORLD_DATABASE]")
    print("  Writes E075's SQL: every shield's stamina traded for armour, spirit or mana per 5 (issue 155z18).")
    os.exit(0)
end
local DIR   = arg[1] and arg[1] ~= "" and arg[1] or "/mnt/kaun/wow-chat-2026"
local WORLD = arg[2] or "acore_world_basic"
local HERE  = DIR .. "/patches/E075-basic-shields-without-stamina/"
local MYSQL = DIR .. "/mysql/installed-files/bin/mysql --defaults-file=" .. DIR .. "/mysql/conf/client.cnf -h127.0.0.1 -P3307 -N -B " .. WORLD

local STAMINA_PER_MP5    = 2.5
local ARMOUR_PER_STAMINA = 10

local STAMINA, SPIRIT, INTELLECT = 7, 6, 5
local HEALING, SPELL_DAMAGE, MP5, SPELL_POWER = 41, 42, 43, 45

local function query(sql)
    local p = io.popen(MYSQL .. ' -e "' .. sql .. '" 2>&1')
    local rows = {}
    for l in p:lines() do
        if l:match("^ERROR") then io.stderr:write("generate-basic-shield-stats-sql: MySQL said: " .. l .. "\n"); os.exit(1) end
        if not l:match("^mysql: %[Warning%]") then
            local m = {}
            for v in (l .. "\t"):gmatch("([^\t]*)\t") do m[#m + 1] = v end
            rows[#rows + 1] = m
        end
    end
    p:close()
    return rows
end

local HOLY_MARK  = { [SPIRIT] = true, [HEALING] = true }
local MAGIC_MARK = { [INTELLECT] = true, [SPELL_POWER] = true, [SPELL_DAMAGE] = true, [MP5] = true }
local function kind_of(stats)
    local holy, magic = false, false
    for _, s in ipairs(stats) do
        if s.value ~= 0 and HOLY_MARK[s.type]  then holy  = true end
        if s.value ~= 0 and MAGIC_MARK[s.type] then magic = true end
    end
    return holy and "holy" or (magic and "magic" or "plain")
end

local NEW_STAT = { holy = SPIRIT, magic = MP5 }
local function trade(stats, armour)
    local kind, sta, slot = kind_of(stats), 0, nil
    for k, s in ipairs(stats) do
        if s.type == STAMINA and s.value > 0 then sta = sta + s.value; slot = slot or k end
    end
    if sta == 0 then return stats, armour, kind, 0 end
    local out = {}
    for k, s in ipairs(stats) do
        out[k] = (s.type == STAMINA and s.value > 0) and { type = 0, value = 0 } or { type = s.type, value = s.value }
    end
    if kind == "plain" then
        return out, armour + math.floor(sta * ARMOUR_PER_STAMINA + 0.5), kind, sta
    end
    local stat  = NEW_STAT[kind]
    local worth = kind == "holy" and sta or math.max(1, math.floor(sta / STAMINA_PER_MP5 + 0.5))
    for _, s in ipairs(out) do
        if s.type == stat then s.value = s.value + worth; return out, armour, kind, sta end
    end
    out[slot] = { type = stat, value = worth }
    return out, armour, kind, sta
end

local cols = "entry, armor"
for k = 1, 10 do cols = cols .. ", stat_type" .. k .. ", stat_value" .. k end
local rows = query("SELECT " .. cols .. " FROM item_template WHERE class = 4 AND subclass = 6")
local saved = {}
if #query("SHOW TABLES LIKE 'basic_155z18_backup'") > 0 then
    for _, r in ipairs(query("SELECT " .. cols .. " FROM basic_155z18_backup")) do saved[tonumber(r[1])] = r end
end

local apply, revert, report = {}, {}, {}
local HEAD = "-- GENERATED by scripts/generate-basic-shield-stats-sql (issue 155z18); don't edit by hand (re-run the generator).\n"
    .. "-- Every shield's stamina traded for armour (plain), spirit (holy) or mana every 5 seconds (magic)."
apply[#apply + 1] = HEAD .. [[

-- The changed shields' stats and armour are saved once (INSERT IGNORE keeps
-- the first copy); each UPDATE sets the new numbers outright, so installing
-- again changes nothing more and the revert is exact.
CREATE TABLE IF NOT EXISTS `basic_155z18_backup` (
  `entry` int unsigned NOT NULL, `armor` int unsigned NOT NULL,
  `stat_type1` tinyint unsigned NOT NULL, `stat_value1` int NOT NULL, `stat_type2` tinyint unsigned NOT NULL, `stat_value2` int NOT NULL,
  `stat_type3` tinyint unsigned NOT NULL, `stat_value3` int NOT NULL, `stat_type4` tinyint unsigned NOT NULL, `stat_value4` int NOT NULL,
  `stat_type5` tinyint unsigned NOT NULL, `stat_value5` int NOT NULL, `stat_type6` tinyint unsigned NOT NULL, `stat_value6` int NOT NULL,
  `stat_type7` tinyint unsigned NOT NULL, `stat_value7` int NOT NULL, `stat_type8` tinyint unsigned NOT NULL, `stat_value8` int NOT NULL,
  `stat_type9` tinyint unsigned NOT NULL, `stat_value9` int NOT NULL, `stat_type10` tinyint unsigned NOT NULL, `stat_value10` int NOT NULL,
  PRIMARY KEY (`entry`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='155z18: stats and armour of the shields that lose their stamina, as they were';]]
revert[#revert + 1] = "-- MARKER_E075_REVERT basic-shields-without-stamina\n" .. HEAD
    .. "\n\n-- Each changed shield's stats and armour put back from the saved copy, then the copy dropped."

local count = { plain = 0, holy = 0, magic = 0 }
local taken, entries = 0, {}
for _, m in ipairs(rows) do
    local entry = tonumber(m[1])
    local src = saved[entry] or m
    local stats = {}
    for k = 1, 10 do stats[k] = { type = tonumber(src[1 + k * 2]), value = tonumber(src[2 + k * 2]) } end
    local out, armour, kind, sta = trade(stats, tonumber(src[2]))
    if sta > 0 then
        count[kind] = count[kind] + 1
        taken = taken + sta
        entries[#entries + 1] = entry
        local set = { string.format("`armor` = %d", armour) }
        for k = 1, 10 do set[#set + 1] = string.format("`stat_type%d` = %d, `stat_value%d` = %d", k, out[k].type, k, out[k].value) end
        apply[#apply + 1] = string.format("UPDATE `item_template` SET %s WHERE `entry` = %d; -- %s, %d stamina", table.concat(set, ", "), entry, kind, sta)
    end
end
table.insert(apply, 2, #entries == 0 and "-- (no shield carries stamina: nothing to save)"
    or ("INSERT IGNORE INTO `basic_155z18_backup` SELECT " .. cols .. " FROM `item_template` WHERE `entry` IN ("
        .. table.concat(entries, ",") .. ");"))
local back = { "i.`armor` = b.`armor`" }
for k = 1, 10 do back[#back + 1] = string.format("i.`stat_type%d` = b.`stat_type%d`, i.`stat_value%d` = b.`stat_value%d`", k, k, k, k) end
revert[#revert + 1] = "UPDATE `item_template` i JOIN `basic_155z18_backup` b ON b.`entry` = i.`entry` SET " .. table.concat(back, ", ") .. ";"
revert[#revert + 1] = "DROP TABLE IF EXISTS `basic_155z18_backup`;"

report[#report + 1] = string.format("%d shields read, %d carried stamina (%d points in all): %d plain (armour), %d holy (spirit), %d magic (mana every 5 s)",
    #rows, #entries, taken, count.plain, count.holy, count.magic)

os.execute('mkdir -p "' .. HERE .. '"')
for name, lines in pairs({ ["44-shields-without-stamina.apply.sql"] = apply, ["44-shields-without-stamina.revert.sql"] = revert }) do
    local f = io.open(HERE .. name, "w")
    if not f then io.stderr:write("generate-basic-shield-stats-sql: cannot write " .. HERE .. name .. "\n"); os.exit(1) end
    f:write(table.concat(lines, "\n\n"), "\n")
    f:close()
end
print("wrote " .. HERE .. "44-shields-without-stamina.{apply,revert}.sql")
for _, l in ipairs(report) do print("  " .. l) end
