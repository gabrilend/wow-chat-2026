# MySQL Configuration for wow-chat-2
# Local installation with project-specific paths

[mysqld]
# Directories
basedir = /mnt/mtwo/programming/ai-stuff/games/wow-chat-2/mysql/installed-files
datadir = /mnt/mtwo/programming/ai-stuff/games/wow-chat-2/mysql/databases
tmpdir  = /mnt/mtwo/programming/ai-stuff/games/wow-chat-2/tmp

# Socket and port (different from system MySQL to avoid conflicts)
socket  = /mnt/mtwo/programming/ai-stuff/games/wow-chat-2/mysql/databases/mysql.sock
port    = 3307

# Networking
bind-address = 127.0.0.1
skip-networking = 0

# Character set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# InnoDB settings
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
innodb_flush_log_at_trx_commit = 2

# Performance
max_connections = 50
table_open_cache = 256

# Logging
log_error = /mnt/mtwo/programming/ai-stuff/games/wow-chat-2/mysql/databases/error.log
slow_query_log = 1
slow_query_log_file = /mnt/mtwo/programming/ai-stuff/games/wow-chat-2/mysql/databases/slow.log
long_query_time = 2

[client]
socket = /mnt/mtwo/programming/ai-stuff/games/wow-chat-2/mysql/databases/mysql.sock
port = 3307
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
