# MySQL Configuration for wow-chat-2026
# Local installation with project-specific paths

[mysqld]
# Directories
basedir = /mnt/kaun/wow-chat-2026/mysql/installed-files
datadir = /mnt/kaun/wow-chat-2026/mysql/databases
tmpdir  = /mnt/kaun/wow-chat-2026/tmp

# Socket and port (different from system MySQL to avoid conflicts)
socket  = /mnt/kaun/wow-chat-2026/mysql/databases/mysql.sock
port    = 3307

# Networking
bind-address = 127.0.0.1
skip-networking = 0

# Character set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# InnoDB settings
# NOTE: innodb_log_file_size removed in MySQL 9.x, use innodb_redo_log_capacity instead
# The data MySQL keeps in memory. 1G (the owner, 2026-10-18: one realm runs
# on this computer at a time) holds one profile's world database (about
# 0.8-1 GB: du -sh mysql/databases/acore_world_*) with its characters and
# the shared accounts; it was 256M, smaller than one world. More realms at
# once want more (CLAUDE.md, "Data on more than one disk").
innodb_buffer_pool_size = 1G
innodb_redo_log_capacity = 128M
innodb_flush_log_at_trx_commit = 2

# Performance
max_connections = 50
table_open_cache = 256

# Logging
log_error = /mnt/kaun/wow-chat-2026/mysql/databases/error.log
slow_query_log = 1
slow_query_log_file = /mnt/kaun/wow-chat-2026/mysql/databases/slow.log
long_query_time = 2

# No binary log (the owner, 2026-10-18). MySQL keeps one by default, a
# second record of every change, for copying a database to another server
# (replication) or replaying it to a point in time. Nothing here does
# either, so it only doubled every write. Takes effect at the next MySQL
# start; the old binlog.* files and binlog.index can then be deleted while
# MySQL is stopped. (CLAUDE.md, "Data on more than one disk".)
disable_log_bin

# Allow non-SUPER users (ritz) to create triggers/functions. Required so
# per-profile E-patches that ship triggers (e.g. tr_no_intro_cinematic in
# acore_characters_vanilla — 148m) install via the ritz creds the patches
# already use. Project-local MySQL, single-trust environment, so the
# "less safe" caveat in MySQL's docs doesn't bite here.
log_bin_trust_function_creators = 1

[client]
socket = /mnt/kaun/wow-chat-2026/mysql/databases/mysql.sock
port = 3307
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
