# Secrets (credentials)
secrets.conf
!secrets.conf.example
scripts/credentials
scripts/credentials.bak
!scripts/credentials.dist

# Build artifacts (profile-suffixed: build-release, source-beta, etc.)
build*/
installed-files*/bin/
installed-files*/lib/
installed-files*/include/
installed-files*/share/
source*/
libs/

# Generated config files (contain credentials)
installed-files*/etc/*.conf
installed-files*/etc/modules/*.conf
!installed-files*/etc/*.conf.dist
!installed-files*/etc/modules/*.conf.dist

# Runtime files (profile-suffixed: logs-release, logs-beta, etc.)
logs*/
tmp/

# Game data (extracted from client, too large for git)
data-files/

# Editor files
*.swp
*.swo
*~

# OS files
.DS_Store

# =============================================================================
# MySQL - Local Installation
# =============================================================================
# Binaries, build artifacts, and boost are ignored (can be rebuilt)
mysql/build/
mysql/source/
mysql/boost/
mysql/installed-files/

# TRACKED: Database files containing custom world/character data
# Per-profile databases (acore_world_release, acore_characters_beta, etc.)
# Auth database (acore_auth) is shared across all profiles
#   mysql/databases/acore_auth/
#   mysql/databases/acore_world_*/
#   mysql/databases/acore_characters_*/
#
# Large binary files (ibdata, ib_logfile) should use git-lfs if needed

# MySQL runtime files (regenerated on startup)
mysql/databases/*.pid
mysql/databases/*.sock
mysql/databases/*.sock.lock
mysql/databases/auto.cnf
mysql/databases/binlog.*
mysql/databases/undo_*
mysql/databases/*.pem
mysql/databases/*.log
mysql/databases/ibtmp*
mysql/databases/mysql_upgrade_history

# InnoDB internal files (regenerated)
mysql/databases/#ib_*
mysql/databases/#innodb_redo/
mysql/databases/#innodb_temp/
mysql/databases/ib_buffer_pool

# MySQL system databases (not project-specific)
mysql/databases/mysql/
mysql/databases/performance_schema/
mysql/databases/sys/

# InnoDB shared tablespace - large binary, use git-lfs if needed
# Uncomment to track: mysql/databases/ibdata1
mysql/databases/ibdata1
mysql/databases/mysql.ibd

# AzerothCore database table files (too large for git - use data/sql/custom/ for changes)
mysql/databases/acore_*/

# =============================================================================
# Eluna Scripts - TRACKED
# =============================================================================
# src/lua/ is fully tracked - this is the game's soul
*.tar.gz
.current-profile
