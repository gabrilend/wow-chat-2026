### Pattern Matching for Rumors

```lua
function checkRumorMatch(narrator, playerSpeech)
    local keywords = extractKeywords(playerSpeech)
    for _, rumor in ipairs(narrator.rumors) do
        local matches = countMatches(keywords, rumor.associations)
        if matches / #rumor.associations > 0.2 then  -- 20% threshold
            return rumor
        end
    end
    return nil
end
```

