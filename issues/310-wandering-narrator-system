## Hook Architecture

The narrator subscription system requires:
- **Inbound**: rmail subscribe/unsubscribe requests
- **Outbound**: Narrator speech forwarded to subscribers
- **TTS Generation**: Optional audio generation daemon

### Inbound Hook: narrator-subscribe.lua

Triggered when player sends rmail to `wow.ritzmenardi.com/narrator`:

```lua
#!/usr/bin/env lua
-- {{{ narrator-subscribe.lua
-- on_receive hook for narrator subscription management

local sender   = arg[1]
local subject  = arg[2]
local filepath = arg[3]

local DIR = "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local NARRATOR_DIR = DIR .. "/game-mail/narrator"
local SUBSCRIPTIONS_FILE = NARRATOR_DIR .. "/subscriptions.txt"

-- Read message body
local f = io.open(filepath, "r")
if not f then os.exit(1) end
local content = f:read("*a")
f:close()

-- Parse body (after headers)
local body = content:match("\n\n(.+)$") or ""
local narratorName = body:match("^%s*(.-)%s*$")

-- Parse subject for options
local subjectLower = (subject or ""):lower()
local wantsTTS = subjectLower:match("tts") ~= nil
local isUnsubscribe = subjectLower:match("unsubscribe") ~= nil

if not narratorName or #narratorName == 0 then
    sendError(sender, "No narrator name provided")
    os.exit(0)
end

if isUnsubscribe then
    removeSubscription(sender, narratorName)
    sendConfirmation(sender, "Unsubscribed from narrator: " .. narratorName)
else
    addSubscription(sender, narratorName, wantsTTS)
    local ttsNote = wantsTTS and " (with TTS)" or ""
    sendConfirmation(sender, "Subscribed to narrator: " .. narratorName .. ttsNote)
end
-- }}}
```

### Subscription Storage

```
# subscriptions.txt
# Format: rmail_contact:narrator_name:tts_flag
alice:McGee:0
alice:Storyteller:1
bob:McGee:1
```

### Outbound: on_send Hook Architecture

Instead of a polling daemon, use rmail's `on_send` hook. This hook fires only when
a message is successfully delivered. If the subscriber is offline, speech queues
naturally until they come online.

**Key insight:** When one message sends, check if there are more queued.

### Queue Storage

Narrator speech pending delivery:

```
# .pending-speech.txt
# Format: id:subscriber:narrator:text:timestamp:wants_tts
1:alice:McGee:Once upon a time...:1712345678:1
2:alice:McGee:There was a dragon.:1712345680:1
3:bob:McGee:Once upon a time...:1712345678:0
```

### ALE Integration: Queue on Narrator Speech

When a narrator speaks, ALE queues it for subscribers:

```lua
-- {{{ onNarratorSpeech (ALE)
-- Queue narrator speech for rmail forwarding

local PENDING_FILE = "/mnt/mtwo/games/azeroth-core/wow-chat-2026/game-mail/narrator/.pending-speech.txt"
local SUBSCRIPTIONS_FILE = "/mnt/mtwo/games/azeroth-core/wow-chat-2026/game-mail/narrator/subscriptions.txt"

local speechId = 0

local function onNarratorSpeech(narrator, text)
    local narratorName = narrator:GetName()
    local subscribers = getSubscribersForNarrator(narratorName)

    if #subscribers == 0 then return end

    speechId = speechId + 1
    local timestamp = os.time()

    -- Queue for each subscriber
    local f = io.open(PENDING_FILE, "a")
    if f then
        for _, sub in ipairs(subscribers) do
            local ttsFlag = sub.wantsTTS and "1" or "0"
            f:write(string.format("%d:%s:%s:%s:%d:%s\n",
                speechId, sub.contact, narratorName,
                text:gsub(":", "::"), timestamp, ttsFlag))  -- escape colons in text
        end
        f:close()
    end

    -- Trigger first send attempt for each subscriber
    for _, sub in ipairs(subscribers) do
        attemptNextSpeech(sub.contact)
    end
end
-- }}}
```

### on_send Hook: Check for More

When a message successfully sends, check if there are more pending:

```lua
#!/usr/bin/env lua
-- {{{ narrator-onsend.lua
-- on_send hook - fires after successful message delivery
-- Checks if more speech is queued for this subscriber

local recipient = arg[1]
local subject   = arg[2]
local filepath  = arg[3]

local DIR = "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local PENDING_FILE = DIR .. "/game-mail/narrator/.pending-speech.txt"
local OUTBOX_PATH = DIR .. "/game-mail/narrator/outbox/"
local TTS_CACHE_PATH = DIR .. "/game-mail/narrator/.tts-cache/"

-- Only process narrator messages (subject format: [NarratorName] says)
if not subject or not subject:match("^%[.+%] says$") then
    os.exit(0)
end

-- {{{ checkAndSendNext
function checkAndSendNext(recipient)
    local pending = readPendingFile()
    local toSend = nil

    for i, entry in ipairs(pending) do
        if entry.subscriber == recipient then
            toSend = entry
            table.remove(pending, i)
            writePendingFile(pending)
            break
        end
    end

    if toSend then
        writeSpeechToOutbox(toSend)
        -- rmail will attempt send, triggering on_send again if successful
    end
end
-- }}}

-- {{{ writeSpeechToOutbox
function writeSpeechToOutbox(entry)
    local filename = entry.timestamp .. "-" .. entry.subscriber .. ".txt"

    local f = io.open(OUTBOX_PATH .. filename, "w")
    if f then
        f:write("to: " .. entry.subscriber .. "\n")
        f:write("subject: [" .. entry.narrator .. "] says\n\n")
        f:write(entry.text .. "\n")
        f:write("\n---\n")
        f:write("Timestamp: " .. os.date("%Y-%m-%d %H:%M:%S", entry.timestamp) .. "\n")

        if entry.wantsTTS then
            local audioPath = generateTTS(entry.narrator, entry.text, entry.timestamp)
            if audioPath then
                f:write("\n[Audio: " .. audioPath .. "]\n")
            end
        end

        f:close()
    end
end
-- }}}

-- {{{ generateTTS
function generateTTS(narratorName, text, timestamp)
    local outputPath = TTS_CACHE_PATH .. timestamp .. "-" .. narratorName .. ".mp3"

    -- Example using espeak + ffmpeg
    local escaped = text:gsub("'", "'\\''")
    local cmd = string.format(
        "espeak '%s' --stdout | ffmpeg -i - -y '%s' 2>/dev/null",
        escaped, outputPath
    )

    if os.execute(cmd) == 0 then
        return outputPath
    end
    return nil
end
-- }}}

checkAndSendNext(recipient)
-- }}}
```

### on_login Hook: Flush Queue

Triggered by ALE when a player logs in:

```lua
#!/usr/bin/env lua
-- {{{ narrator-onlogin.lua
-- Flush pending narrator speech on player login

local DIR = "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local PENDING_FILE = DIR .. "/game-mail/narrator/.pending-speech.txt"

-- {{{ flushPendingSpeech
function flushPendingSpeech()
    local pending = readPendingFile()
    local attemptedSubscribers = {}

    for _, entry in ipairs(pending) do
        if not attemptedSubscribers[entry.subscriber] then
            writeSpeechToOutbox(entry)
            attemptedSubscribers[entry.subscriber] = true
        end
    end
end
-- }}}

flushPendingSpeech()
-- }}}
```

