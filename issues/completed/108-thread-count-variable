### Final Implementation

```bash
# Thread count for parallel builds
# Defaults to (nproc - 1) to leave one core free for multitasking
# Can be overridden: MAKE_JOBS=4 source scripts/azerothcore && azerothcore install
if [[ -z "${MAKE_JOBS:-}" ]]; then
    MAKE_JOBS=$(( $(nproc) - 1 ))
    # Minimum of 1 thread
    if [[ "${MAKE_JOBS}" -lt 1 ]]; then
        MAKE_JOBS=1
    fi
fi
```

