## Hook Architecture

The mail bridge requires two-way communication:
- **Inbound**: rmail messages → in-game mail
- **Outbound**: in-game mail → rmail (subscription-based)

### Inbound Hook: mail-receive.lua

Triggered when player sends rmail to `wow.ritzmenardi.com/mail`:

```lua
#!/usr/bin/env lua
-- {{{ mail-receive.lua
-- on_receive hook for in-game mail bridge
-- Handles: subscribe, unsubscribe, send mail to character

local sender   = arg[1]
local subject  = arg[2]
local filepath = arg[3]

local DIR = "/mnt/mtwo/games/azeroth-core/wow-chat-2026"
local MAIL_DIR = DIR .. "/game-mail/mail"
local SUBSCRIPTIONS_FILE = MAIL_DIR .. "/subscriptions.txt"

-- Read message body
local f = io.open(filepath, "r")
if not f then os.exit(1) end
local content = f:read("*a")
f:close()

-- Parse body (after headers)
local body = content:match("\n\n(.+)$") or ""
local firstLine = body:match("^([^\n]+)")

-- Route based on subject
local subjectLower = (subject or ""):lower()

if subjectLower == "subscribe" then
    -- Add subscription: sender subscribes to character on firstLine
    local charName = firstLine and firstLine:match("^%s*(.-)%s*$")
    if charName and #charName > 0 then
        appendSubscription(sender, charName)
        sendConfirmation(sender, "Subscribed to " .. charName)
    end

elseif subjectLower == "unsubscribe" then
    -- Remove subscription
    local charName = firstLine and firstLine:match("^%s*(.-)%s*$")
    if charName and #charName > 0 then
        removeSubscription(sender, charName)
        sendConfirmation(sender, "Unsubscribed from " .. charName)
    end

else
    -- Treat as outgoing mail to character
    -- First line = recipient character name
    -- Rest of body = mail content
    local charName = firstLine
    local mailBody = body:match("\n(.+)$") or ""
    if charName and #charName > 0 then
        createIngameMail(sender, charName, subject, mailBody)
    end
end
-- }}}
```

