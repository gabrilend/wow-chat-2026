## Glyph Effects (Always-Active)

For glyphs that should always be active for a custom class:

```lua
CustomClasses.definitions[1004] = {
    -- ... abilities and talents ...

    -- Glyphs that are always active (no inscription needed)
    permanentGlyphs = {
        [54857] = true,  -- Glyph of Renew (reduces duration, more healing per tick)
        [58375] = true,  -- Glyph of Vigilance (increases threat transfer)
    },
}

-- On login, apply glyph auras/effects
function CustomClasses.applyPermanentGlyphs(player)
    local def = CustomClasses.getDefinition(CustomClasses.getCustomClass(player))
    if not def or not def.permanentGlyphs then return end

    for glyphId, _ in pairs(def.permanentGlyphs) do
        -- Apply glyph effect (may need to learn the glyph spell or apply aura)
        ApplyGlyphEffect(player, glyphId)
    end
end
```

## Validation Rules

### On Definition Load
1. All spell IDs must be valid (exist in spell database)
2. Tree indices must be 1, 2, or 3
3. Tier indices must be 1, 2, or 3
4. Prerequisites must reference defined talents
5. No more than 3 talent families per tier per tree (would overflow columns)
6. No circular prerequisites

### Validation Function
```lua
-- {{{ validateDefinition
function CustomClasses.validateDefinition(classId, def)
    local errors = {}

    -- Check required fields
    if not def.name then
        table.insert(errors, "Missing name")
    end
    if not def.baseClass or def.baseClass < 1 or def.baseClass > 11 then
        table.insert(errors, "Invalid baseClass")
    end

    -- Check abilities
    for spellId, config in pairs(def.abilities or {}) do
        if not IsValidSpell(spellId) then
            table.insert(errors, "Invalid ability spell ID: " .. spellId)
        end
        if not config.level or config.level < 1 or config.level > 20 then
            table.insert(errors, "Invalid level for ability " .. spellId)
        end
        if not config.cost or config.cost < 0 then
            table.insert(errors, "Invalid cost for ability " .. spellId)
        end
    end

    -- Check talents
    local talentsPerTier = {}  -- [tree][tier] = count
    for spellId, config in pairs(def.talents or {}) do
        if not IsValidSpell(spellId) then
            table.insert(errors, "Invalid talent spell ID: " .. spellId)
        end
        if not config.tree or config.tree < 1 or config.tree > 3 then
            table.insert(errors, "Invalid tree for talent " .. spellId)
        end
        if not config.tier or config.tier < 1 or config.tier > 3 then
            table.insert(errors, "Invalid tier for talent " .. spellId)
        end
        if config.prerequisite and not def.talents[config.prerequisite] then
            table.insert(errors, "Prerequisite " .. config.prerequisite .. " not defined")
        end
    end

    -- Check tier overflow after grouping
    local families = CustomClasses.groupTalentRanks(def.talents or {})
    for _, family in pairs(families) do
        local key = family.tree .. "_" .. family.tier
        talentsPerTier[key] = (talentsPerTier[key] or 0) + 1
        if talentsPerTier[key] > 3 then
            table.insert(errors, "Too many talents in tree " .. family.tree .. " tier " .. family.tier)
        end
    end

    return #errors == 0, errors
end -- }}}
```

## Migration from Current Format

### Current Format (issue 159)
```lua
spells = {
    { id = 19750, level = 20, sourceClass = 2 },  -- Flash of Light
    { id = 12974, level = 12, sourceClass = 1 },  -- Flurry R5
}
```

### New Format
```lua
abilities = {
    [19750] = { level = 20, cost = 5000 },  -- Flash of Light
},
talents = {
    [12974] = { tree = 3, tier = 1 },  -- Flurry R5
},
```

### Migration Script
```lua
-- {{{ migrateOldFormat
function CustomClasses.migrateOldFormat(oldDef)
    local newDef = {
        name = oldDef.name,
        baseClass = oldDef.baseClass,
        abilities = {},
        talents = {},
        treeNames = { "Protection", "Holy", "Combat" },  -- Knight default
    }

    for _, spell in ipairs(oldDef.spells) do
        -- Heuristic: passives/talents go to talents, actives go to abilities
        -- This would need manual review
        newDef.abilities[spell.id] = {
            level = spell.level,
            cost = spell.level * 500,  -- Default cost scaling
        }
    end

    return newDef
end -- }}}
```

