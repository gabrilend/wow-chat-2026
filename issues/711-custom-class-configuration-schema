## Prerequisite Arrows and Tier Blocking

### Arrow Rendering
When talent B requires talent A:
1. Draw arrow from A to B
2. Arrow passes through intermediate tiers
3. Blocked positions cannot have other talents

### Layout Algorithm
```lua
-- {{{ calculateTalentPositions
-- Assigns columns to talents, respecting prerequisite arrows
function CustomClasses.calculateTalentPositions(tree, families)
    local positions = {}  -- [tier][column] = family
    local blocked = {}    -- [tier][column] = true if arrow passes through

    -- First pass: place talents with prerequisites (need specific columns)
    for _, family in pairs(families) do
        if family.tree == tree and family.prerequisite then
            -- Find prerequisite's position
            local prereqFamily = findFamilyBySpellId(families, family.prerequisite)
            local prereqCol = prereqFamily.column or 2  -- Default to middle

            -- Block intermediate tiers in that column
            for tier = prereqFamily.tier + 1, family.tier - 1 do
                blocked[tier] = blocked[tier] or {}
                blocked[tier][prereqCol] = true
            end

            -- Place this talent in same column as prerequisite
            family.column = prereqCol
            positions[family.tier] = positions[family.tier] or {}
            positions[family.tier][prereqCol] = family
        end
    end

    -- Second pass: place remaining talents in available columns
    for _, family in pairs(families) do
        if family.tree == tree and not family.column then
            local tier = family.tier
            positions[tier] = positions[tier] or {}
            blocked[tier] = blocked[tier] or {}

            -- Find first available column
            for col = 1, 3 do
                if not positions[tier][col] and not blocked[tier][col] then
                    family.column = col
                    positions[tier][col] = family
                    break
                end
            end
        end
    end

    return positions
end -- }}}
```

