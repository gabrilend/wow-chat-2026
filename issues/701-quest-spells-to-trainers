### SQL Template
```sql
-- Add quest ability to trainer
INSERT INTO npc_trainer (ID, SpellID, MoneyCost, ReqSkillLine, ReqSkillRank, ReqLevel, ReqSpell)
VALUES (TRAINER_ID, SPELL_ID, COST, 0, 0, LEVEL, 0);
```

