```bash
# -- {{{ cmd_rmail
# Install rmail and set up game server mailbox
cmd_rmail() {
    set -e
    local force=false
    for arg in "$@"; do
        [[ "${arg}" == "--force" ]] && force=true
    done

    echo "Setting up rmail for custom class submissions..."

    # Clone rmail if not present
    local RMAIL_DIR="${DIR}/libs/r-mail"
    if [[ ! -d "${RMAIL_DIR}/.git" ]]; then
        echo "Cloning rmail..."
        git clone https://github.com/gabrilend/r-mail.git "${RMAIL_DIR}"
    elif [[ "${force}" == true ]]; then
        echo "Updating rmail..."
        cd "${RMAIL_DIR}" && git pull --rebase && cd -
    fi

    # Load credentials for port
    source "${DIR}/scripts/credentials" 2>/dev/null || true
    RMAIL_PORT="${RMAIL_PORT:-8025}"
    RMAIL_NAME="${RMAIL_NAME:-ghostsong}"

    # Create mailbox directories
    local MAIL_DIR="${DIR}/game-mail"
    mkdir -p "${MAIL_DIR}/inbox"
    mkdir -p "${MAIL_DIR}/outbox"
    mkdir -p "${MAIL_DIR}/attachments"
    mkdir -p "${MAIL_DIR}/.state"

    # Create config if not exists
    if [[ ! -f "${MAIL_DIR}/config" ]]; then
        cat > "${MAIL_DIR}/config" << EOF
# rmail configuration for game server
name = ${RMAIL_NAME}
port = ${RMAIL_PORT}

# Custom class validation hook
on_receive = ${DIR}/scripts/validate-custom-class.lua
EOF
        echo "Created ${MAIL_DIR}/config"
    fi

    # Create contacts.dist if not exists
    if [[ ! -f "${MAIL_DIR}/contacts.dist" ]]; then
        cat > "${MAIL_DIR}/contacts.dist" << 'EOF'
// Game server contacts - add custom class authors here
//
// Example:
//   alice.ip    = 203.0.113.1
//   alice.port  = 54321
//   alice.token = "shared-secret-exchange-out-of-band"
//
// Both sides must use the same token.
// Token should be random, e.g.: openssl rand -hex 32
EOF
        echo "Created ${MAIL_DIR}/contacts.dist"
    fi

    # Create contacts from dist if not exists
    if [[ ! -f "${MAIL_DIR}/contacts" ]]; then
        cp "${MAIL_DIR}/contacts.dist" "${MAIL_DIR}/contacts"
        echo "Created ${MAIL_DIR}/contacts (add authors here)"
    fi

    # Compile rmail dependencies (non-interactive)
    echo "Compiling rmail dependencies..."
    cd "${RMAIL_DIR}"

    # Check if already compiled
    if [[ -f "libs/rmail_crypto.so" && -f "libs/socket/core.so" ]] && ! $force; then
        echo "rmail dependencies already compiled"
    else
        # Run install.sh components manually (avoiding interactive prompts)
        # This mirrors what install.sh does but non-interactively

        # 1. dkjson
        if [[ ! -f "libs/dkjson.lua" ]]; then
            echo "  Downloading dkjson..."
            mkdir -p libs
            curl -sL -o libs/dkjson.lua "http://dkolf.de/dkjson-lua/dkjson-2.8.lua"
        fi

        # 2. luasocket (compile from source)
        if [[ ! -f "libs/socket/core.so" ]]; then
            echo "  Compiling luasocket..."
            # Use system lua headers
            local LUA_INC=""
            for dir in /usr/include/lua5.4 /usr/include/luajit-2.1 /usr/include; do
                [[ -f "$dir/lua.h" ]] && LUA_INC="-I$dir" && break
            done

            mkdir -p .build-tmp libs/socket libs/mime
            cd .build-tmp
            curl -sL -o luasocket.tar.gz \
                "https://github.com/lunarmodules/luasocket/archive/refs/tags/v3.1.0.tar.gz"
            tar xzf luasocket.tar.gz
            cd luasocket-3.1.0/src

            # Compile socket/core.so
            for src in luasocket.c timeout.c buffer.c io.c auxiliar.c compat.c \
                       options.c inet.c usocket.c except.c select.c tcp.c udp.c; do
                cc $LUA_INC -DLUASOCKET_NODEBUG -Wall -O2 -fPIC -c -o "${src%.c}.o" "$src"
            done
            cc -shared -fPIC -O -o socket-core.so *.o

            # Compile mime/core.so
            cc $LUA_INC -DLUASOCKET_NODEBUG -Wall -O2 -fPIC -c -o mime.o mime.c
            cc -shared -fPIC -O -o mime-core.so mime.o compat.o

            # Install
            cp socket-core.so "${RMAIL_DIR}/libs/socket/core.so"
            cp mime-core.so "${RMAIL_DIR}/libs/mime/core.so"
            cp socket.lua mime.lua ltn12.lua "${RMAIL_DIR}/libs/"
            cp http.lua url.lua tp.lua ftp.lua smtp.lua headers.lua "${RMAIL_DIR}/libs/socket/"

            cd "${RMAIL_DIR}"
            rm -rf .build-tmp
        fi

        # 3. rmail_crypto.so
        if [[ ! -f "libs/rmail_crypto.so" ]]; then
            echo "  Compiling rmail_crypto.so..."
            local LUA_INC=""
            for dir in /usr/include/lua5.4 /usr/include/luajit-2.1 /usr/include; do
                [[ -f "$dir/lua.h" ]] && LUA_INC="-I$dir" && break
            done
            cc -shared -fPIC -O2 -Wall $LUA_INC \
                -o libs/rmail_crypto.so rmail_crypto.c -lcrypto
        fi
    fi

    cd "${DIR}"

    echo ""
    echo "rmail setup complete!"
    echo "  Mailbox: ${MAIL_DIR}"
    echo "  Port: ${RMAIL_PORT}"
    echo "  Config: ${MAIL_DIR}/config"
    echo ""
    echo "Next steps:"
    echo "  1. Add authors to ${MAIL_DIR}/contacts"
    echo "  2. Forward port ${RMAIL_PORT} on your router"
    echo "  3. Start rmail: ./scripts/azerothcore rmail-start"
}
# -- }}}

# -- {{{ cmd_rmail_start
# Start the rmail daemon for the game server mailbox
cmd_rmail_start() {
    local RMAIL_DIR="${DIR}/libs/r-mail"
    local MAIL_DIR="${DIR}/game-mail"

    if [[ ! -f "${RMAIL_DIR}/rmail.lua" ]]; then
        echo "Error: rmail not installed. Run './scripts/azerothcore rmail' first."
        exit 1
    fi

    if [[ ! -d "${MAIL_DIR}" ]]; then
        echo "Error: game-mail directory not found. Run './scripts/azerothcore rmail' first."
        exit 1
    fi

    echo "Starting rmail daemon..."
    echo "  Mailbox: ${MAIL_DIR}"
    echo "  Logs: /tmp/rmail-game.log"
    echo ""

    # Find lua interpreter
    local LUA_BIN=""
    if [[ -f "${RMAIL_DIR}/deps/lua/bin/lua" ]]; then
        LUA_BIN="${RMAIL_DIR}/deps/lua/bin/lua"
    else
        for cmd in lua5.4 luajit lua5.3 lua; do
            command -v "$cmd" >/dev/null 2>&1 && LUA_BIN="$cmd" && break
        done
    fi

    if [[ -z "${LUA_BIN}" ]]; then
        echo "Error: no lua interpreter found"
        exit 1
    fi

    # Run in foreground (or add & for background)
    cd "${RMAIL_DIR}"
    exec "${LUA_BIN}" rmail.lua "${MAIL_DIR}"
}
# -- }}}
```

### Hook Script: scripts/validate-custom-class.lua

```lua
#!/usr/bin/env lua
-- {{{ validate-custom-class.lua
-- rmail on_receive hook for custom class validation
-- Receives: $1=sender, $2=subject, $3=filepath
-- Runs in background (on_receive), stdout ignored

local sender   = arg[1]
local subject  = arg[2]
local filepath = arg[3]

-- Only process CLASS: messages
local className = subject and subject:match("^CLASS:%s*(%S+)$")
if not className then
    os.exit(0)  -- Not a class submission, ignore
end

-- Configuration
local DIR = "/home/ritz/games/azeroth-core/wow-chat-2026"
local MAIL_DIR = DIR .. "/game-mail"

-- Read inbox file
local f = io.open(filepath, "r")
if not f then os.exit(1) end
local content = f:read("*a")
f:close()

-- Strip rmail headers (to:, subject:, blank line, then body)
local body = content:match("\n\n(.+)$") or content

-- For now, just accept everything (validation TBD in Phase A)
-- TODO: require("custom-classes-validator") and validate

-- Send acceptance response
local outbox = MAIL_DIR .. "/outbox"
local responseFile = outbox .. "/" .. os.time() .. "-" .. sender .. ".txt"
local out = io.open(responseFile, "w")
if out then
    out:write("to: " .. sender .. "\n")
    out:write("subject: ACCEPTED: " .. className .. "\n\n")
    out:write("Your class '" .. className .. "' has been received.\n")
    out:write("(Validation not yet implemented - this is a placeholder)\n")
    out:close()
end

-- Log
local log = io.open("/tmp/rmail-game.log", "a")
if log then
    log:write(os.date("%Y-%m-%d %H:%M:%S") .. " CLASS received: " ..
              className .. " from " .. sender .. "\n")
    log:close()
end
-- }}}
```

### IP Address Handling

rmail automatically detects the public IP on startup using multiple services.
The game server admin shares their IP with authors out-of-band (email, Discord, etc.).

For dynamic IP:
- rmail has `notify_ip_change = true` which notifies contacts when IP changes
- Or use a dynamic DNS service and share the hostname

### Port Configuration

Port is set in:
1. `scripts/credentials` → `RMAIL_PORT=8025`
2. `game-mail/config` → `port = 8025`

The install script reads from credentials and writes to config.

### Adding a New Author

1. Author runs `./scripts/install.sh` on their machine
2. Author generates a token: `openssl rand -hex 32`
3. Author shares their IP, port, and token with game admin (out-of-band)
4. Game admin adds to `game-mail/contacts`:
   ```
   alice.ip    = 203.0.113.1
   alice.port  = 54321
   alice.token = "their-shared-token"
   ```
5. Author adds game server to their contacts:
   ```
   ghostsong.ip    = <game-server-ip>
   ghostsong.port  = 8025
   ghostsong.token = "same-shared-token"
   ```
6. Author can now send `CLASS: myclass` messages

