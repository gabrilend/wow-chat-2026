### Weighted Selection
```lua
function selectTrainerClass(player, customClassDef)
    local playerLevel = player:GetLevel()
    local minLevel = playerLevel - 3
    local maxLevel = playerLevel + 3

    local weights = {}
    local totalWeight = 0

    for _, baseClass in ipairs(customClassDef.tomeClasses) do
        local count = countLearnableSpells(player, customClassDef, baseClass, minLevel, maxLevel)
        if count > 0 then
            weights[baseClass] = count
            totalWeight = totalWeight + count
        end
    end

    if totalWeight == 0 then return nil end

    -- Weighted random selection
    local roll = math.random(1, totalWeight)
    local cumulative = 0
    for baseClass, weight in pairs(weights) do
        cumulative = cumulative + weight
        if roll <= cumulative then
            return baseClass
        end
    end
end
```

### Trainer Gossip
```lua
function onTrainerGossip(event, player, trainer)
    local customClassId = CustomClasses.getCustomClass(player)
    if not customClassId then return false end  -- use default

    local def = CustomClasses.getDefinition(customClassId)
    local trainerClass = trainer:GetData("trainer-class")

    player:GossipClearMenu()

    for _, spellData in ipairs(def.spells) do
        if spellData.baseClass == trainerClass then
            if not player:HasSpell(spellData.id) then
                if isInLevelRange(player, spellData.level) then
                    local spellInfo = GetSpellInfo(spellData.id)
                    local cost = calculateTrainingCost(spellData.level)
                    player:GossipMenuAddItem(3, spellInfo:GetName() .. " - " .. cost .. "g", 0, spellData.id)
                end
            end
        end
    end

    player:GossipSendMenu(1, trainer)
    return true  -- override default
end
```

